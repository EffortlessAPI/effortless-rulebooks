    rdfs:label "InstanceDataVersionId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:governedModel a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:GovernedModels ;
    rdfs:label "GovernedModel" ;
    rdfs:comment "Model." .

effortless-ntwf:dataVersionLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InstanceDataVersions ;
    rdfs:range xsd:string ;
    rdfs:label "DataVersionLabel" ;
    rdfs:comment "Data version." .

effortless-ntwf:snapshotAt a owl:DatatypeProperty ;
