    rdfs:range xsd:string ;
    rdfs:label "KnowledgeFlow" ;
    rdfs:comment "Producer, Consumer or Both." .

effortless-ntwf:processStake a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationParticipants ;
    rdfs:range xsd:string ;
    rdfs:label "ProcessStake" ;
    rdfs:comment "Initiates, Executes or DependsOnResults; blank for a facilitator with no stake." .

effortless-ntwf:isUsuallyInvited a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationParticipants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUsuallyInvited" ;
    rdfs:comment "FALSE for a participant whose position is normally left out of such sessions." .

effortless-ntwf:isPractitioner a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationParticipants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPractitioner" ;
    rdfs:comment "TRUE for a practitioner who holds process knowledge." .
    # calculated: calculated

effortless-ntwf:isSubjectMatterExpert a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationParticipants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSubjectMatterExpert" ;
    rdfs:comment "TRUE for a subject matter expert." .
    # calculated: calculated

effortless-ntwf:isKnowledgeEngineer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationParticipants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKnowledgeEngineer" ;
    rdfs:comment "TRUE for the knowledge engineer collecting the knowledge." .
    # calculated: calculated

effortless-ntwf:isKnowledgeProducer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationParticipants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKnowledgeProducer" ;
    rdfs:comment "TRUE for a participant who produces the knowledge." .
    # calculated: calculated

effortless-ntwf:isKnowledgeConsumer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationParticipants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKnowledgeConsumer" ;
    rdfs:comment "TRUE for a participant who consumes the knowledge." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ElicitationSessions ===
effortless-ntwf:ElicitationSessions a owl:Class ;
    rdfs:label "ElicitationSessions" ;
    rdfs:comment "Structured knowledge-elicitation events involving practitioners and knowledge engineers. Explicit ERB-PKO extension, modeled as prov:Activity." .

effortless-ntwf:elicitationSessionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "ElicitationSessionId" ;
    rdfs:comment "Stored logical identifier for one ElicitationSessions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the ElicitationSessions row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version whose knowledge was elicited." .

effortless-ntwf:method a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:KnowledgeMethods ;
    rdfs:label "Method" ;
    rdfs:comment "The knowledge method this session used." .

effortless-ntwf:startedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "StartedAt" ;
    rdfs:comment "Start time; maps to prov:startedAtTime." .

effortless-ntwf:endedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "EndedAt" ;
    rdfs:comment "End time; maps to prov:endedAtTime." .

effortless-ntwf:practitionerAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "PractitionerAgent" ;
    rdfs:comment "Domain practitioner providing knowledge." .

effortless-ntwf:facilitatorAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "FacilitatorAgent" ;
    rdfs:comment "Person facilitating elicitation." .

effortless-ntwf:summary a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Summary" ;
    rdfs:comment "What was learned and captured." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Draft, Reviewed, Approved, or Rejected." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:daysSinceElicited a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceElicited" ;
    rdfs:comment "Days elapsed since this elicitation session concluded." .
    # calculated: calculated

effortless-ntwf:isSingleWitnessMethod a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSingleWitnessMethod" ;
    rdfs:comment "TRUE when this session captured one practitioner's account rather than a group's." .
    # calculated: calculated

effortless-ntwf:practitionerIsStillEngaged a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "PractitionerIsStillEngaged" ;
    rdfs:comment "Whether the practitioner whose knowledge this session captured still holds a role here." .
    # calculated: lookup

effortless-ntwf:validFragmentsProduced a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "ValidFragmentsProduced" ;
    rdfs:comment "How many currently-valid knowledge fragments this one session produced." .
    # calculated: aggregation

effortless-ntwf:isHighYieldSession a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHighYieldSession" ;
    rdfs:comment "A session that alone underwrites three or more currently-valid claims." .
    # calculated: calculated

effortless-ntwf:isConcentratedSingleWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConcentratedSingleWitness" ;
    rdfs:comment "One unrepeated session with one witness that underwrites three or more live claims." .
    # calculated: calculated

effortless-ntwf:isStaleConcentratedWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStaleConcentratedWitness" ;
    rdfs:comment "A concentrated single-witness session more than 180 days old — matching the single-witness expiry horizon loop 1 already established." .
    # calculated: calculated

effortless-ntwf:concentratedSessionVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "ConcentratedSessionVersionKey" ;
    rdfs:comment "Composite-key echo: this session's procedure version when the session is a concentrated single witness, blank otherwise." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Class IRI used in semantic projection." .

effortless-ntwf:observerStance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "ObserverStance" ;
    rdfs:comment "For observation: NonParticipantObservation, Shadowing or LegitimatePeripheralParticipation." .

effortless-ntwf:setting a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "Setting" ;
    rdfs:comment "InSitu (where the work is done), Office or Remote." .

effortless-ntwf:recordingReference a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "RecordingReference" ;
    rdfs:comment "The recording of the practitioner's work made during the session, when one was made." .

effortless-ntwf:practitionerReviewedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "PractitionerReviewedAt" ;
    rdfs:comment "When the practitioner reviewed the recording afterward to explain their reasoning." .

effortless-ntwf:elicitationMode a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "ElicitationMode" ;
    rdfs:comment "The family of elicitation the session's method belongs to." .
    # calculated: calculated

effortless-ntwf:isInterview a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInterview" ;
    rdfs:comment "TRUE for an interview session." .
    # calculated: calculated

effortless-ntwf:isWorkshop a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWorkshop" ;
    rdfs:comment "TRUE for a workshop session." .
    # calculated: calculated

effortless-ntwf:whyProbeCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:integer ;
    rdfs:label "WhyProbeCount" ;
    rdfs:comment "Probes asking why a choice is made." .
    # calculated: aggregation

effortless-ntwf:shortfallProbeCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:integer ;
    rdfs:label "ShortfallProbeCount" ;
    rdfs:comment "Probes asking what happens when the procedure falls short." .
    # calculated: aggregation

effortless-ntwf:isInterviewWithoutWhyProbe a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInterviewWithoutWhyProbe" ;
    rdfs:comment "TRUE for an interview that never asked why a choice is made." .
    # calculated: calculated

effortless-ntwf:isInterviewWithoutShortfallProbe a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInterviewWithoutShortfallProbe" ;
    rdfs:comment "TRUE for an interview that never asked what happens when the procedure falls short." .
    # calculated: calculated

effortless-ntwf:initiatorCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:integer ;
    rdfs:label "InitiatorCount" ;
    rdfs:comment "Participants who start the process." .
    # calculated: aggregation

effortless-ntwf:executorCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:integer ;
    rdfs:label "ExecutorCount" ;
    rdfs:comment "Participants who carry the process out." .
    # calculated: aggregation

effortless-ntwf:dependentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:integer ;
    rdfs:label "DependentCount" ;
    rdfs:comment "Participants who depend on the process's results." .
    # calculated: aggregation

effortless-ntwf:uninvitedParticipantCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:integer ;
    rdfs:label "UninvitedParticipantCount" ;
    rdfs:comment "Participants whose position is normally not invited." .
    # calculated: aggregation

effortless-ntwf:gathersWholeProcessChain a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "GathersWholeProcessChain" ;
    rdfs:comment "TRUE for a workshop that gathered people who start, carry out and depend on the process." .
    # calculated: calculated

effortless-ntwf:isWorkshopWithoutUsualOutsiders a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWorkshopWithoutUsualOutsiders" ;
    rdfs:comment "TRUE for a workshop in which nobody normally left out took part." .
    # calculated: calculated

effortless-ntwf:methodFamily a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "MethodFamily" ;
    rdfs:comment "The family of the session's method." .
    # calculated: lookup

effortless-ntwf:facilitatorKnowledgeEngineerRoleCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:integer ;
    rdfs:label "FacilitatorKnowledgeEngineerRoleCount" ;
    rdfs:comment "Knowledge engineer roles the facilitator currently holds." .
    # calculated: aggregation

effortless-ntwf:facilitatorIsKnowledgeEngineer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "FacilitatorIsKnowledgeEngineer" ;
    rdfs:comment "TRUE when the session was run by the organization's knowledge engineer." .
    # calculated: calculated

effortless-ntwf:isGenericOrUnskilledCapture a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGenericOrUnskilledCapture" ;
    rdfs:comment "TRUE when a session captured knowledge with a method outside the elicitation family or without a skilled elicitor running it." .
    # calculated: calculated

effortless-ntwf:isKeFieldSession a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKeFieldSession" ;
    rdfs:comment "TRUE for a session the knowledge engineer ran where the work is done." .
    # calculated: calculated

effortless-ntwf:isReviewedRecording a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReviewedRecording" ;
    rdfs:comment "TRUE when the practitioner reviewed a recording of their own work afterward to explain it." .
    # calculated: calculated

# === Class: EmbeddingProbes ===
effortless-ntwf:EmbeddingProbes a owl:Class ;
    rdfs:label "EmbeddingProbes" ;
    rdfs:comment "Recorded similarity of process-vocabulary term pairs under an embedding model." .

effortless-ntwf:embeddingProbeId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EmbeddingProbes ;
    rdfs:range xsd:string ;
    rdfs:label "EmbeddingProbeId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:termA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EmbeddingProbes ;
    rdfs:range xsd:string ;
    rdfs:label "TermA" ;
    rdfs:comment "First term." .

effortless-ntwf:termB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EmbeddingProbes ;
    rdfs:range xsd:string ;
    rdfs:label "TermB" ;
    rdfs:comment "Second term." .

effortless-ntwf:expectedRelation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EmbeddingProbes ;
    rdfs:range xsd:string ;
    rdfs:label "ExpectedRelation" ;
    rdfs:comment "NearSynonym or Opposite in the process domain." .

effortless-ntwf:embeddingModel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EmbeddingProbes ;
    rdfs:range xsd:string ;
    rdfs:label "EmbeddingModel" ;
    rdfs:comment "Embedding model probed." .

effortless-ntwf:cosineSimilarity a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EmbeddingProbes ;
    rdfs:range xsd:string ;
    rdfs:label "CosineSimilarity" ;
    rdfs:comment "Measured cosine similarity." .

effortless-ntwf:probedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EmbeddingProbes ;
    rdfs:range xsd:string ;
    rdfs:label "ProbedAt" ;
    rdfs:comment "When." .

effortless-ntwf:synonymsNotSimilar a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EmbeddingProbes ;
    rdfs:range xsd:boolean ;
    rdfs:label "SynonymsNotSimilar" ;
    rdfs:comment "TRUE when the model places near-synonyms of the process domain below 0.7 similarity." .
    # calculated: calculated

effortless-ntwf:oppositesNotOpposed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EmbeddingProbes ;
    rdfs:range xsd:boolean ;
    rdfs:label "OppositesNotOpposed" ;
    rdfs:comment "TRUE when the model places opposites of the process domain above 0.3 similarity." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: EncodingLifecycleStages ===
effortless-ntwf:EncodingLifecycleStages a owl:Class ;
    rdfs:label "EncodingLifecycleStages" ;
    rdfs:comment "The stages that carry process knowledge to AI and reuse: collect, store, document, codify, encode, operationalize." .

effortless-ntwf:encodingLifecycleStageId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EncodingLifecycleStages ;
    rdfs:range xsd:string ;
    rdfs:label "EncodingLifecycleStageId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Stage name." .

effortless-ntwf:stageOrder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EncodingLifecycleStages ;
    rdfs:range xsd:integer ;
    rdfs:label "StageOrder" ;
    rdfs:comment "Position in the lifecycle." .

effortless-ntwf:activity a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EncodingLifecycleStages ;
    rdfs:range xsd:string ;
    rdfs:label "Activity" ;
    rdfs:comment "What happens to knowledge at this stage." .

effortless-ntwf:annotationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EncodingLifecycleStages ;
    rdfs:range xsd:integer ;
    rdfs:label "AnnotationCount" ;
    rdfs:comment "Practitioner annotations and feedback recorded against this stage." .
    # calculated: aggregation

effortless-ntwf:isStageWithoutFeedback a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EncodingLifecycleStages ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStageWithoutFeedback" ;
    rdfs:comment "TRUE for a lifecycle stage from which no feedback at all has come back." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: EnergySources ===
effortless-ntwf:EnergySources a owl:Class ;
    rdfs:label "EnergySources" ;
    rdfs:comment "Hazardous energy sources a machine carries (pko-ind:EnergySource individuals)." .

effortless-ntwf:energySourceId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EnergySources ;
    rdfs:range xsd:string ;
    rdfs:label "EnergySourceId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Energy source." .

effortless-ntwf:pkoIndividualIri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EnergySources ;
    rdfs:range xsd:string ;
    rdfs:label "PkoIndividualIri" ;
    rdfs:comment "The PKO industry individual." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: Errors ===
effortless-ntwf:Errors a owl:Class ;
    rdfs:label "Errors" ;
    rdfs:comment "Reusable error definitions encountered during execution. Maps to pko:Error, errorCode, and errorCause." .

effortless-ntwf:errorId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Errors ;
    rdfs:range xsd:string ;
    rdfs:label "ErrorId" ;
    rdfs:comment "Stored logical identifier for one Errors row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Errors row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Error label." .

effortless-ntwf:errorCode a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Errors ;
    rdfs:range xsd:string ;
    rdfs:label "ErrorCode" ;
    rdfs:comment "Error code; maps to pko:errorCode." .

effortless-ntwf:errorCause a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Errors ;
    rdfs:range xsd:string ;
    rdfs:label "ErrorCause" ;
    rdfs:comment "Known or suspected cause; maps to pko:errorCause." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

effortless-ntwf:description a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Description" ;
    rdfs:comment "Error description (dct:description)." .

effortless-ntwf:remedyStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Errors ;
    rdfs:range xsd:integer ;
    rdfs:label "RemedyStepCount" ;
    rdfs:comment "Steps that remedy this error." .
    # calculated: aggregation

effortless-ntwf:occurrenceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Errors ;
    rdfs:range xsd:integer ;
    rdfs:label "OccurrenceCount" ;
    rdfs:comment "Times the error was encountered." .
    # calculated: aggregation

effortless-ntwf:hasNoRemedyStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Errors ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoRemedyStep" ;
    rdfs:comment "TRUE when an error has been encountered and no step of any procedure remedies it." .
    # calculated: calculated

# === Class: EvaluationContexts ===
effortless-ntwf:EvaluationContexts a owl:Class ;
    rdfs:label "EvaluationContexts" ;
    rdfs:comment "The instant this rulebook's time-dependent witnesses are evaluated against. Modeled as data rather than wall-clock so every freshness, overdue, and validity answer is reproducible and auditable: asking the same question tomorrow yields the same answer. Exactly one row carries IsCurrent." .

effortless-ntwf:evaluationContextId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:string ;
    rdfs:label "EvaluationContextId" ;
    rdfs:comment "Stored logical identifier for one EvaluationContexts row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the EvaluationContexts row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "What this evaluation instant represents." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The instant all time-dependent witnesses are evaluated against." .

effortless-ntwf:isCurrent a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrent" ;
    rdfs:comment "TRUE for the single active evaluation context." .

effortless-ntwf:rationale a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Rationale" ;
    rdfs:comment "Why this instant was chosen." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

effortless-ntwf:explicitFragmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:integer ;
    rdfs:label "ExplicitFragmentCount" ;
    rdfs:comment "Pieces of knowledge on record, judged at this instant, that are written down." .
    # calculated: aggregation

effortless-ntwf:tacitFragmentCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "TacitFragmentCount" ;
    rdfs:comment "Pieces of knowledge on record that live in practiced hands and were drawn out of a person." .
    # calculated: aggregation

effortless-ntwf:implicitFragmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:integer ;
    rdfs:label "ImplicitFragmentCount" ;
    rdfs:comment "Pieces of knowledge on record that everybody acts on and nobody had ever stated." .
    # calculated: aggregation

effortless-ntwf:situatedJudgmentFragmentCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "SituatedJudgmentFragmentCount" ;
    rdfs:comment "Pieces of knowledge on record that are a judgment call for one situation." .
    # calculated: aggregation

effortless-ntwf:modelReasonedAnswerCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:integer ;
    rdfs:label "ModelReasonedAnswerCount" ;
    rdfs:comment "Assistant answers on record where the language model did the reasoning itself." .
    # calculated: aggregation

effortless-ntwf:otherwiseReasonedAnswerCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:integer ;
    rdfs:label "OtherwiseReasonedAnswerCount" ;
    rdfs:comment "Assistant answers on record where the reasoning was done by a query or a reasoner, or none was needed." .
    # calculated: aggregation

effortless-ntwf:assistantAnswerCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:integer ;
    rdfs:label "AssistantAnswerCount" ;
    rdfs:comment "Every assistant answer on record." .
    # calculated: calculated

effortless-ntwf:modelReasonedFailedAnswerCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:integer ;
    rdfs:label "ModelReasonedFailedAnswerCount" ;
    rdfs:comment "Of the answers the language model reasoned out itself, how many of the tasks failed." .
    # calculated: aggregation

effortless-ntwf:outOfOrderStepExecutionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:integer ;
    rdfs:label "OutOfOrderStepExecutionCount" ;
    rdfs:comment "Step executions on record that were carried out of the order the procedure specifies." .
    # calculated: aggregation

effortless-ntwf:inOrderStepExecutionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:integer ;
    rdfs:label "InOrderStepExecutionCount" ;
    rdfs:comment "Step executions on record that followed the order the procedure specifies." .
    # calculated: aggregation

effortless-ntwf:stepExecutionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:integer ;
    rdfs:label "StepExecutionCount" ;
    rdfs:comment "Every step execution on record." .
    # calculated: calculated

effortless-ntwf:earlyStartStepExecutionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:integer ;
    rdfs:label "EarlyStartStepExecutionCount" ;
    rdfs:comment "Step executions on record that began before the step they depend on had finished." .
    # calculated: aggregation

effortless-ntwf:exactMappingCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "ExactMappingCount" ;
    rdfs:comment "Concepts of this book that map exactly onto a term PKO itself defines." .
    # calculated: aggregation

effortless-ntwf:alignedMappingCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "AlignedMappingCount" ;
    rdfs:comment "Concepts of this book that map onto one of the older standards PKO reuses." .
    # calculated: aggregation

effortless-ntwf:extensionMappingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:integer ;
    rdfs:label "ExtensionMappingCount" ;
    rdfs:comment "Concepts of this book that PKO does not define: the book's own extensions, labelled as such." .
    # calculated: aggregation

# === Class: ExceptionInvocations ===
effortless-ntwf:ExceptionInvocations a owl:Class ;
    rdfs:label "ExceptionInvocations" ;
    rdfs:comment "ExceptionInvocations (added by witness loop 1)." .

effortless-ntwf:exceptionInvocationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "ExceptionInvocationId" ;
    rdfs:comment "Stored logical identifier for one ExceptionInvocations row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "The execution during which the exception was invoked." .

effortless-ntwf:exception a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range effortless-ntwf:Exceptions ;
    rdfs:label "Exception" ;
    rdfs:comment "The specified exception that was invoked." .

effortless-ntwf:invokedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "InvokedByAgent" ;
    rdfs:comment "Agent who invoked the exception." .

effortless-ntwf:approvedByAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ApprovedByAgent" ;
    rdfs:comment "Agent who approved the invocation. Must satisfy the exception's ApprovalRole." .

effortless-ntwf:invokedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "InvokedAt" ;
    rdfs:comment "When the exception was invoked." .

effortless-ntwf:handlingApplied a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "HandlingApplied" ;
    rdfs:comment "What was actually done, in the invoker's words." .

effortless-ntwf:expectedHandling a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "ExpectedHandling" ;
    rdfs:comment "The handling the specification prescribes." .
    # calculated: lookup

effortless-ntwf:requiredApprovalRole a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RequiredApprovalRole" ;
    rdfs:comment "The role the specification requires to approve this exception." .
    # calculated: lookup

effortless-ntwf:requiredApprovalRoleHolder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "RequiredApprovalRoleHolder" ;
    rdfs:comment "The agent who currently holds the role that must approve this exception." .
    # calculated: lookup

effortless-ntwf:approvalRoleMatches a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:boolean ;
    rdfs:label "ApprovalRoleMatches" ;
    rdfs:comment "TRUE when the agent who approved is the holder of the role the exception requires." .
    # calculated: calculated

effortless-ntwf:isApproved a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApproved" ;
    rdfs:comment "TRUE when an approver was recorded at all." .
    # calculated: calculated

effortless-ntwf:isImproperlyApproved a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsImproperlyApproved" ;
    rdfs:comment "TRUE when an exception was invoked without an approver, or approved by an agent who does not hold the required role." .
    # calculated: calculated

effortless-ntwf:invokerAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "InvokerAgentKind" ;
    rdfs:comment "What kind of agent invoked the exception." .
    # calculated: lookup

effortless-ntwf:invokerAlsoPreparedKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "InvokerAlsoPreparedKey" ;
    rdfs:comment "Composite execution+approver key, in the same key space as StepExecutions.PreparerAgentKey." .
    # calculated: calculated

effortless-ntwf:parentProcedureExecution a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ParentProcedureExecution" ;
    rdfs:comment "The procedure execution this invocation belongs to." .
    # calculated: lookup

effortless-ntwf:approverPreparedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "ApproverPreparedCount" ;
    rdfs:comment "How many preparation steps in the same execution were run by the agent who approved this exception." .
    # calculated: aggregation

effortless-ntwf:delegatedToPreparer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:boolean ;
    rdfs:label "DelegatedToPreparer" ;
    rdfs:comment "TRUE when an exception routed approval authority to an agent who prepared work in the same execution." .
    # calculated: calculated

effortless-ntwf:isUngovernedInvocation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngovernedInvocation" ;
    rdfs:comment "TRUE when an exception was invoked without proper role authority, or routed authority to the preparer." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension IRI — PKO does not define exception invocation." .

# === Class: Exceptions ===
effortless-ntwf:Exceptions a owl:Class ;
    rdfs:label "Exceptions" ;
    rdfs:comment "Documented exceptions, fallbacks, and alternative handling. Aligns structurally with PKO fallback/alternative steps and requirements; the exception record itself is an ERB-PKO extension." .

effortless-ntwf:exceptionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Exceptions ;
    rdfs:range xsd:string ;
    rdfs:label "ExceptionId" ;
    rdfs:comment "Stored logical identifier for one Exceptions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Exceptions row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version containing the exception." .

effortless-ntwf:triggerStep a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Exceptions ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "TriggerStep" ;
    rdfs:comment "Step at which the exception becomes relevant." .

effortless-ntwf:condition a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Condition" ;
    rdfs:comment "Exception condition." .

effortless-ntwf:handling a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Exceptions ;
    rdfs:range xsd:string ;
    rdfs:label "Handling" ;
    rdfs:comment "Required handling and guardrails." .

effortless-ntwf:approvalRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "ApprovalRole" ;
    rdfs:comment "Role that approves use of the exception." .

effortless-ntwf:fallbackRole a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Exceptions ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "FallbackRole" ;
    rdfs:comment "Role or function that executes fallback handling." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Active, Draft, Retired, or Superseded." .

effortless-ntwf:activeExceptionStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Exceptions ;
    rdfs:range xsd:string ;
    rdfs:label "ActiveExceptionStepKey" ;
    rdfs:comment "Echoes the TriggerStep id only for exceptions currently in Active status." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: ExecutionEntities ===
effortless-ntwf:ExecutionEntities a owl:Class ;
    rdfs:label "ExecutionEntities" ;
    rdfs:comment "Entities a step execution used or generated (prov:used, prov:wasGeneratedBy, pplan:correspondsToVariable)." .

effortless-ntwf:executionEntityId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "ExecutionEntityId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "Step execution." .

effortless-ntwf:stepVariable a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepVariables ;
    rdfs:label "StepVariable" ;
    rdfs:comment "Declared variable the entity corresponds to." .

effortless-ntwf:usage a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "Usage" ;
    rdfs:comment "Used or Generated." .

effortless-ntwf:entityLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "EntityLabel" ;
    rdfs:comment "The entity." .

effortless-ntwf:entityUri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "EntityUri" ;
    rdfs:comment "Where the entity lives." .

effortless-ntwf:variableDirection a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "VariableDirection" ;
    rdfs:comment "Direction of the declared variable." .
    # calculated: lookup

effortless-ntwf:variableStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "VariableStep" ;
    rdfs:comment "Step that declares the variable." .
    # calculated: lookup

effortless-ntwf:executedStep a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ExecutedStep" ;
    rdfs:comment "Step the execution executed." .
    # calculated: lookup

effortless-ntwf:isUsageDirectionMismatch a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUsageDirectionMismatch" ;
    rdfs:comment "TRUE when a used entity maps to an output or a generated entity maps to an input." .
    # calculated: calculated

effortless-ntwf:isForeignVariable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsForeignVariable" ;
    rdfs:comment "TRUE when the entity corresponds to a variable another step declares." .
    # calculated: calculated

effortless-ntwf:usedExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "UsedExecutionKey" ;
    rdfs:comment "Step execution key for a used entity." .
    # calculated: calculated

effortless-ntwf:generatedExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "GeneratedExecutionKey" ;
    rdfs:comment "Step execution key for a generated entity." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

effortless-ntwf:recordedDatatype a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "RecordedDatatype" ;
    rdfs:comment "Datatype of the entity actually recorded." .

effortless-ntwf:recordedFormat a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "RecordedFormat" ;
    rdfs:comment "Media type of the entity actually recorded." .

effortless-ntwf:variableDatatype a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "VariableDatatype" ;
    rdfs:comment "Datatype the variable declares." .
    # calculated: lookup

effortless-ntwf:variableExpectedFormat a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "VariableExpectedFormat" ;
    rdfs:comment "Format the variable declares." .
    # calculated: lookup

effortless-ntwf:violatesDeclaredDatatypeOrFormat a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:boolean ;
    rdfs:label "ViolatesDeclaredDatatypeOrFormat" ;
    rdfs:comment "TRUE when a recorded value's datatype or format differs from what its variable declares." .
    # calculated: calculated

effortless-ntwf:generatingAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "GeneratingAgent" ;
    rdfs:comment "Agent that executed the step execution." .
    # calculated: lookup

effortless-ntwf:attributedToAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionEntities ;
    rdfs:range xsd:string ;
    rdfs:label "AttributedToAgent" ;
    rdfs:comment "For a generated entity, the agent it is attributed to (prov:wasAttributedTo)." .
    # calculated: calculated

