# === Class: KnowledgeProjections ===
effortless-ntwf:KnowledgeProjections a owl:Class ;
    rdfs:label "KnowledgeProjections" ;
    rdfs:comment "Diagrams and narrative documents that present a procedure version to people, and whether they were generated from the model." .

effortless-ntwf:knowledgeProjectionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeProjections ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeProjectionId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

