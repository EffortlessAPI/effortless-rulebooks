pko-native-procedural-knowledge-rulebook:withholdingMotive a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourceRelationship ;
    rdfs:range xsd:string ;
    rdfs:label "WithholdingMotive" ;
    rdfs:comment "Why the source holds information back (status, job security)." .

pko-native-procedural-knowledge-rulebook:withholdingObserved a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourceRelationship ;
    rdfs:range xsd:boolean ;
    rdfs:label "WithholdingObserved" ;
    rdfs:comment "TRUE when the source was seen to hold information back." .

pko-native-procedural-knowledge-rulebook:witnessClaimIsUnverified a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "WitnessClaimIsUnverified" ;
    rdfs:comment "TRUE when the hand-typed HasComputedWitness flag disagrees with what the field catalog says." .

pko-native-procedural-knowledge-rulebook:witnessFieldName a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessFieldName" ;
    rdfs:comment "The fully-qualified Table.Field of the predicate that computes this requirement, when one exists." .

pko-native-procedural-knowledge-rulebook:witnessFireCount a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:decimal ;
    rdfs:label "WitnessFireCount" ;
    rdfs:comment "How many times this requirement's evaluation has returned a non-Satisfied result." .

pko-native-procedural-knowledge-rulebook:witnessHasNeverFired a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "WitnessHasNeverFired" ;
    rdfs:comment "TRUE for a requirement that has a computed witness which has never once returned a negative result." .

pko-native-procedural-knowledge-rulebook:witnessIsPartiallyScoped a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "WitnessIsPartiallyScoped" ;
    rdfs:comment "TRUE when a control has a computed witness but at least one of its step bindings has never been exercised by it." .

pko-native-procedural-knowledge-rulebook:witnessLoop a owl:ObjectProperty ;
    rdfs:domain pko-extension:RoleQuestion ;
    rdfs:range pko-extension:WitnessLoop ;
    rdfs:label "WitnessLoop" ;
    rdfs:comment "The expansion loop in which this question was posed." .

pko-native-procedural-knowledge-rulebook:witnessLoopId a owl:DatatypeProperty ;
    rdfs:domain pko-extension:WitnessLoop ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessLoopId" ;
    rdfs:comment "Stored logical identifier for one WitnessLoops row." .

pko-native-procedural-knowledge-rulebook:witnessedAfter a owl:DatatypeProperty ;
    rdfs:domain pko-extension:WitnessLoop ;
    rdfs:range xsd:decimal ;
    rdfs:label "WitnessedAfter" ;
    rdfs:comment "Fields invented for a role question after this loop completed." .

pko-native-procedural-knowledge-rulebook:witnessedAnswer a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RoleQuestion ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessedAnswer" ;
    rdfs:comment "The current reading of this question's predicates, extracted from the substrate after the loop ran: which witness columns fire, on how many rows out of how many. Written by tools/extract_computed_answers.py from values Postgres computed — never recomputed in Python. This is what lets a later loop plan against materialized answers instead of imagined ones." .

pko-native-procedural-knowledge-rulebook:wording a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Wording" .

pko-native-procedural-knowledge-rulebook:wordingKey a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "WordingKey" .

pko-native-procedural-knowledge-rulebook:workMedium a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:string ;
    rdfs:label "WorkMedium" ;
    rdfs:comment "Physical or Digital work." .

pko-native-procedural-knowledge-rulebook:workNature a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourcingFunction ;
    rdfs:range xsd:string ;
    rdfs:label "WorkNature" ;
    rdfs:comment "Transactional (routine) or ExpertiseHeavy (analytical, design or engineering judgment)." .

pko-native-procedural-knowledge-rulebook:workflowDescription a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelExpansionRequest ;
    rdfs:range xsd:string ;
    rdfs:label "WorkflowDescription" ;
    rdfs:comment "Workflows to model." .

pko-native-procedural-knowledge-rulebook:workflowStatusConcept a owl:ObjectProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:LifecycleStatuses ;
    rdfs:range pko-extension:VocabularyTerm ;
    rdfs:label "WorkflowStatusConcept" ;
    rdfs:comment "Concept of the controlled workflow-status scheme this status maps to." .

pko-native-procedural-knowledge-rulebook:workflowViewDivergenceId a owl:DatatypeProperty ;
    rdfs:domain pko-extension:WorkflowViewDivergence ;
    rdfs:range xsd:string ;
    rdfs:label "WorkflowViewDivergenceId" ;
    rdfs:comment "Stored identifier." .

pko-native-procedural-knowledge-rulebook:workshopSessionCount a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "WorkshopSessionCount" ;
    rdfs:comment "Workshop sessions for the version." .

pko-native-procedural-knowledge-rulebook:wouldAlterInferences a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "WouldAlterInferences" ;
    rdfs:comment "TRUE when the assessment found inferences the change would alter." .

pko-native-procedural-knowledge-rulebook:wouldAlterQueryResults a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "WouldAlterQueryResults" ;
    rdfs:comment "TRUE when the assessment found query results the change would alter." .

pko-native-procedural-knowledge-rulebook:wouldLeaveCoverageIncomplete a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "WouldLeaveCoverageIncomplete" ;
    rdfs:comment "TRUE when the assessment found the change would leave the vocabulary layer or coverage model incomplete." .

pko-native-procedural-knowledge-rulebook:wouldMakeInstancesInconsistent a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "WouldMakeInstancesInconsistent" ;
    rdfs:comment "TRUE when the assessment found existing instance data the change would make inconsistent." .

pko-native-procedural-knowledge-rulebook:wouldNotSurviveRestatement a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Attestations ;
    rdfs:range xsd:boolean ;
    rdfs:label "WouldNotSurviveRestatement" ;
    rdfs:comment "TRUE when re-deriving this attestation today would not reproduce what the model said when it was signed." .

pko-native-procedural-knowledge-rulebook:writesDerivedField a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AppActionField ;
    rdfs:range xsd:boolean ;
    rdfs:label "WritesDerivedField" ;
    rdfs:comment "The action tries to write a value the model works out for itself. That is never allowed." .

pko-native-procedural-knowledge-rulebook:writtenForAudience a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeRepositoryEntry ;
    rdfs:range xsd:string ;
    rdfs:label "WrittenForAudience" ;
    rdfs:comment "LaterColleagues (written as part of the craft) or ComplianceAudit." .

pko-native-procedural-knowledge-rulebook:wrongBecauseGraphWasStale a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AssistantAnswer ;
    rdfs:range xsd:boolean ;
    rdfs:label "WrongBecauseGraphWasStale" ;
    rdfs:comment "TRUE when a graph-grounded answer was wrong and rested on a stale or deprecated assertion." .

pko:addressesError a owl:ObjectProperty .

pko:feedbackOnProcedure a owl:DatatypeProperty .

pko:feedbackOnProcedureExecution a owl:DatatypeProperty .

pko:fromStep a owl:ObjectProperty ;
    rdfs:seeAlso <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .

pko:hasFallbackStep a owl:DatatypeProperty .

pko:hasFirstStep a owl:ObjectProperty .

pko:hasTemplate a owl:ObjectProperty .

pko:isChangeOfStatusOf a owl:ObjectProperty .

pko:isStepOfMultiStep a owl:ObjectProperty .

pko:isStepVerificationOf a owl:ObjectProperty .

pko:maxRepetitions a owl:DatatypeProperty .

pko:minRepetitions a owl:DatatypeProperty .

pko:previousStepExecution a owl:ObjectProperty .

pko:toStep a owl:ObjectProperty .

pko:versionNumber a owl:DatatypeProperty .

pko:wasConfirmedBy a owl:ObjectProperty .

pko:wasExtractedFrom a owl:ObjectProperty .

pko:wasModifiedBy a owl:ObjectProperty .

# every row of ProcedureAdoptions is one pko:isAdoptedBy edge, from its Procedure to its Organization
pko:isAdoptedBy a owl:ObjectProperty .

# every row of ProcedureTargets is one pko:hasProcedureTarget edge, from its Procedure to its Machine
pko:hasProcedureTarget a owl:ObjectProperty .

# every row of StepLockRequirements is one pko-industry:requiresLock edge, from its Step to its LockDevice
pko-industry:requiresLock a owl:ObjectProperty .

# every row of StepProtectiveEquipment is one pko-industry:requiresPPE edge, from its Step to its ProtectiveEquipment
pko-industry:requiresPPE a owl:ObjectProperty .

# === What the schema says about each table's rows ===
