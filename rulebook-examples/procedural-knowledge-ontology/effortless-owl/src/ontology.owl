# === Class: KnowledgeTraces ===
effortless-ntwf:KnowledgeTraces a owl:Class ;
    rdfs:label "KnowledgeTraces" ;
    rdfs:comment "One trace from a piece of organized knowledge (a process model, an activity definition or a constraint) to the collected material it rests on, with the role the material plays (origin, validation, extension, contradiction), how the knowledge was derived, and who confirmed it." .

effortless-ntwf:knowledgeTraceId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeTraceId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:targetKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "TargetKind" ;
    rdfs:comment "ProcessModel, ActivityDefinition or Constraint." .

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "The process model the traced knowledge belongs to." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "The activity definition traced, when the target is a step." .

effortless-ntwf:requirement a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Requirements ;
    rdfs:label "Requirement" ;
    rdfs:comment "The constraint traced, when the target is a requirement." .

effortless-ntwf:sourceMaterial a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:CollectedSourceMaterials ;
    rdfs:label "SourceMaterial" ;
    rdfs:comment "The collected material the knowledge traces to." .

effortless-ntwf:traceRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:string ;
    rdfs:label "TraceRole" ;
    rdfs:comment "Origin (knowledge was taken from it), Validates, Extends, or Contradicts." .

effortless-ntwf:tracedAspect a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:string ;
    rdfs:label "TracedAspect" ;
    rdfs:comment "What the source is cited for: Sequence, StepDescription, Workaround, ActualExecution or Constraint." .

effortless-ntwf:sourceStatement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:string ;
    rdfs:label "SourceStatement" ;
    rdfs:comment "Paraphrase of what the source says about the target." .

effortless-ntwf:derivationRoute a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:string ;
    rdfs:label "DerivationRoute" ;
    rdfs:comment "How the knowledge was produced from the source." .

effortless-ntwf:derivedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "DerivedByAgent" ;
    rdfs:comment "Who (or what) derived the knowledge from the source." .

effortless-ntwf:validatedByAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ValidatedByAgent" ;
    rdfs:comment "Who confirmed the derived knowledge." .

effortless-ntwf:validatedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:string ;
    rdfs:label "ValidatedAt" ;
    rdfs:comment "When it was confirmed." .

effortless-ntwf:sourceStatedDurationMinutes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:integer ;
    rdfs:label "SourceStatedDurationMinutes" ;
    rdfs:comment "Duration the source states for the traced step, when it states one." .

effortless-ntwf:contradictedDocument a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range effortless-ntwf:Resources ;
    rdfs:label "ContradictedDocument" ;
    rdfs:comment "For a contradiction: the document whose prescription practice departs from." .

effortless-ntwf:sourceMaterialKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SourceMaterialKind" ;
    rdfs:comment "Kind of the source material." .
    # calculated: lookup

effortless-ntwf:sourceCollectedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:string ;
    rdfs:label "SourceCollectedAt" ;
    rdfs:comment "When the knowledge was taken: the material's collection instant." .
    # calculated: lookup

effortless-ntwf:sourceRevisedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:string ;
    rdfs:label "SourceRevisedAt" ;
    rdfs:comment "Last revision of the document the material was excerpted from." .
    # calculated: lookup

effortless-ntwf:sourceIsDocument a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "SourceIsDocument" ;
    rdfs:comment "TRUE when the source is an excerpt of an existing document." .
    # calculated: lookup

effortless-ntwf:sourceIsPeopleCapture a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "SourceIsPeopleCapture" ;
    rdfs:comment "TRUE when the source was captured from people (transcript or field notes)." .
    # calculated: lookup

effortless-ntwf:sourceIsPracticeEvidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "SourceIsPracticeEvidence" ;
    rdfs:comment "TRUE when the source records work as performed (field notes or an event trace)." .
    # calculated: lookup

effortless-ntwf:isSourceChangedSinceTaken a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSourceChangedSinceTaken" ;
    rdfs:comment "TRUE when the source document was revised after the knowledge was taken from it." .
    # calculated: calculated

effortless-ntwf:modeledDurationMinutes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:integer ;
    rdfs:label "ModeledDurationMinutes" ;
    rdfs:comment "Duration the modeled step carries." .
    # calculated: lookup

effortless-ntwf:isUnfaithfulToSource a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnfaithfulToSource" ;
    rdfs:comment "TRUE when the modeled step's duration differs from the duration its source states." .
    # calculated: calculated

effortless-ntwf:derivedByAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:string ;
    rdfs:label "DerivedByAgentKind" ;
    rdfs:comment "Kind of the deriving agent." .
    # calculated: lookup

effortless-ntwf:isMachineDerived a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMachineDerived" ;
    rdfs:comment "TRUE when a software or AI agent derived the knowledge from its source." .
    # calculated: calculated

effortless-ntwf:isSelfValidated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSelfValidated" ;
    rdfs:comment "TRUE when the agent who derived the knowledge is the one who confirmed it." .
    # calculated: calculated

effortless-ntwf:hasIncompleteProvenance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasIncompleteProvenance" ;
    rdfs:comment "TRUE when the origin, the derivation route or the confirmation is missing." .
    # calculated: calculated

effortless-ntwf:provenanceStatement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:string ;
    rdfs:label "ProvenanceStatement" ;
    rdfs:comment "Origin, route and confirmation in one line." .
    # calculated: calculated

effortless-ntwf:isAspectUnsupportedBySourceKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAspectUnsupportedBySourceKind" ;
    rdfs:comment "TRUE when a workaround is cited to something other than observation notes, or actual execution to something other than an event trace." .
    # calculated: calculated

effortless-ntwf:isDocumentOrigin a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDocumentOrigin" ;
    rdfs:comment "TRUE when the knowledge was first taken from a document." .
    # calculated: calculated

effortless-ntwf:stepElicitedValidationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:integer ;
    rdfs:label "StepElicitedValidationCount" ;
    rdfs:comment "Validations of the traced step captured from people." .
    # calculated: lookup

effortless-ntwf:stepElicitedExtensionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:integer ;
    rdfs:label "StepElicitedExtensionCount" ;
    rdfs:comment "Extensions of the traced step captured from people." .
    # calculated: lookup

effortless-ntwf:isDocumentStartNeverValidated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDocumentStartNeverValidated" ;
    rdfs:comment "TRUE when a step taken from a document has never been confirmed by capture from people." .
    # calculated: calculated

effortless-ntwf:isDocumentStartNeverExtended a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDocumentStartNeverExtended" ;
    rdfs:comment "TRUE when a step taken from a document has never been extended by capture from people." .
    # calculated: calculated

effortless-ntwf:contradictedDocumentRevisedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:string ;
    rdfs:label "ContradictedDocumentRevisedAt" ;
    rdfs:comment "Last revision of the contradicted document." .
    # calculated: lookup

effortless-ntwf:isDocumentTrailingPractice a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDocumentTrailingPractice" ;
    rdfs:comment "TRUE when practice evidence collected after the document's last revision contradicts it." .
    # calculated: calculated

effortless-ntwf:prescribedVersusEnacted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTraces ;
    rdfs:range xsd:string ;
    rdfs:label "PrescribedVersusEnacted" ;
    rdfs:comment "For a contradiction: what the document prescribes against what practice evidence shows." .
