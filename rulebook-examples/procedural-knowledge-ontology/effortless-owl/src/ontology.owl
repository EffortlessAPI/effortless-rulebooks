effortless-ntwf:agentIntendedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "AgentIntendedCount" ;
    rdfs:comment "Agentic AI initiatives aimed at the procedure." .
    # calculated: aggregation

effortless-ntwf:isTacitOnlyAgentTarget a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTacitOnlyAgentTarget" ;
