    rdfs:label "CapabilityDeclineId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:organization a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "Organization" ;
    rdfs:comment "The organization." .

effortless-ntwf:stage a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Stage" ;
    rdfs:comment "FacilityInvestment, EngineerTraining or KnowHowUpkeep." .

effortless-ntwf:declineStartedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CapabilityDeclines ;
    rdfs:range xsd:string ;
    rdfs:label "DeclineStartedAt" ;
    rdfs:comment "When the decline started." .

effortless-ntwf:precedingStageDecline a owl:ObjectProperty ;
