effortless-ntwf:latestCellsPassed a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "LatestCellsPassed" ;
    rdfs:comment "CellsPassed when in the latest run, else 0." .
    # calculated: calculated

effortless-ntwf:latestErrorFlag a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "LatestErrorFlag" ;
    rdfs:comment "1 when this is the latest run and the harness could not run the substrate." .
