effortless-ntwf:reliedDependencyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:integer ;
    rdfs:label "ReliedDependencyCount" ;
    rdfs:comment "Audit findings where the client relies on this provider's knowledge." .
    # calculated: aggregation

effortless-ntwf:isUnplannedKnowledgeReturn a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnplannedKnowledgeReturn" ;
    rdfs:comment "TRUE when the client relies on a provider's knowledge, the provider keeps the documentation as its property, and nobody planned how the knowledge comes back." .
    # calculated: calculated

effortless-ntwf:isKnowledgeAccessUnsecured a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKnowledgeAccessUnsecured" ;
    rdfs:comment "TRUE when a running engagement is a knowledge dependency and the client has no contractual access to that knowledge." .
    # calculated: calculated

effortless-ntwf:requiredDeliverableCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:integer ;
    rdfs:label "RequiredDeliverableCount" ;
    rdfs:comment "Knowledge deliverables the engagement requires." .
    # calculated: aggregation

effortless-ntwf:toClientRequiredCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:integer ;
    rdfs:label "ToClientRequiredCount" ;
    rdfs:comment "Deliverables that move knowledge from the provider to the client." .
