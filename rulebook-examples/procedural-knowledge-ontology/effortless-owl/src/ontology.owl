effortless-ntwf:toClientDeliveredCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:integer ;
    rdfs:label "ToClientDeliveredCount" ;
    rdfs:comment "Delivered knowledge moving from provider to client." .
    # calculated: aggregation

effortless-ntwf:toProviderDeliveredCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:integer ;
    rdfs:label "ToProviderDeliveredCount" ;
    rdfs:comment "Delivered knowledge moving from client to provider." .
    # calculated: aggregation

effortless-ntwf:jointDeliverableCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:integer ;
    rdfs:label "JointDeliverableCount" ;
    rdfs:comment "Knowledge assets the client and provider build jointly." .
    # calculated: aggregation

effortless-ntwf:lacksKnowledgeDeliverables a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:boolean ;
    rdfs:label "LacksKnowledgeDeliverables" ;
    rdfs:comment "TRUE when a running engagement requires no knowledge deliverable at all." .
    # calculated: calculated

effortless-ntwf:isOneWayLearning a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOneWayLearning" ;
    rdfs:comment "TRUE when a running engagement has knowledge deliverables but knowledge has actually moved in only one direction." .
    # calculated: calculated

effortless-ntwf:isShortTermWithoutJointKnowledge a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsShortTermWithoutJointKnowledge" ;
    rdfs:comment "TRUE when a running engagement is contracted for under three years and builds no knowledge jointly." .
    # calculated: calculated

effortless-ntwf:obligesKnowledgeFlowBack a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:boolean ;
    rdfs:label "ObligesKnowledgeFlowBack" ;
