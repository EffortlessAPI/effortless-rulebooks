pko-native-procedural-knowledge-rulebook:isIndexed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RetrievalSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsIndexed" ;
    rdfs:comment "TRUE when retrieval serves the segment." .

pko-native-procedural-knowledge-rulebook:isIndustryFocused a owl:DatatypeProperty ;
    rdfs:domain pko-extension:OntologySupportProgramme ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsIndustryFocused" ;
    rdfs:comment "Whether the programme's purpose is ontology development for industry." .

pko-native-procedural-knowledge-rulebook:isInferred a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInferred" ;
    rdfs:comment "TRUE when the reasoner inferred the assertion." .

pko-native-procedural-knowledge-rulebook:isInoperativeControl a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInoperativeControl" ;
