    rdfs:range xsd:string ;
    rdfs:label "ExpansionConceptFitId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:modelExpansionRequest a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ExpansionConceptFits ;
    rdfs:range effortless-ntwf:ModelExpansionRequests ;
    rdfs:label "ModelExpansionRequest" ;
    rdfs:comment "Expansion." .

effortless-ntwf:conceptLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExpansionConceptFits ;
    rdfs:range xsd:string ;
    rdfs:label "ConceptLabel" ;
