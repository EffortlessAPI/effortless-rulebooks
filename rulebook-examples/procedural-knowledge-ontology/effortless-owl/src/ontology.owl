    rdfs:comment "TRUE when software actually performed this step." .

pko-native-procedural-knowledge-rulebook:wasModifiedSinceLastReview a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
