effortless-ntwf:migrationPlan a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:string ;
    rdfs:label "MigrationPlan" ;
    rdfs:comment "Migration plan for a breaking release." .

effortless-ntwf:versionDecisionRationale a owl:DatatypeProperty ;
