    rdfs:range xsd:integer ;
    rdfs:label "ExpectedMajor" ;
    rdfs:comment "Major number the declared scale calls for." .
    # calculated: calculated

effortless-ntwf:expectedMinor a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:integer ;
    rdfs:label "ExpectedMinor" ;
