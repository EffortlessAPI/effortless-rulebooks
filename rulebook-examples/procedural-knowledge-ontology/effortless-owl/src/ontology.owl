effortless-ntwf:changeKindContradictsTarget a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureStatusChanges ;
    rdfs:range xsd:boolean ;
    rdfs:label "ChangeKindContradictsTarget" ;
    rdfs:comment "TRUE when the kind of change does not match the status it moved to." .
