effortless-ntwf:modelChangeLogEntryId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:string ;
    rdfs:label "ModelChangeLogEntryId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
