    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureResources ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ResourceModifiedAt" ;
    rdfs:comment "When the referenced resource last changed." .

pko-native-procedural-knowledge-rulebook:response a owl:DatatypeProperty ;
    rdfs:domain pko-extension:FailureMode ;
    rdfs:range xsd:string ;
    rdfs:label "Response" ;
    rdfs:comment "What to do." .

pko-native-procedural-knowledge-rulebook:responsibility a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:string ;
    rdfs:label "Responsibility" ;
