effortless-ntwf:toProcedure a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ProcessInterdependencies ;
    rdfs:range effortless-ntwf:Procedures ;
    rdfs:label "ToProcedure" ;
    rdfs:comment "Operation affected." .

effortless-ntwf:effect a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessInterdependencies ;
    rdfs:range xsd:string ;
    rdfs:label "Effect" ;
    rdfs:comment "Helps, Hinders or Requires." .

effortless-ntwf:mechanism a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessInterdependencies ;
    rdfs:range xsd:string ;
    rdfs:label "Mechanism" ;
    rdfs:comment "How the effect arises." .

effortless-ntwf:evidenceNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessInterdependencies ;
    rdfs:range xsd:string ;
    rdfs:label "EvidenceNote" ;
    rdfs:comment "Where the effect was observed." .

effortless-ntwf:isHinderingDependency a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessInterdependencies ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHinderingDependency" ;
    rdfs:comment "TRUE when one operation works against another." .
