effortless-ntwf:currentAuthorityAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentAuthorityAgent" ;
    rdfs:comment "Person holding the authority role now." .
