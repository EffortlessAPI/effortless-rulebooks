@prefix pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#> .
@prefix erb: <https://effortlessapi.com/ns/erb#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pko: <https://w3id.org/pko#> .
@prefix pko-industry: <https://w3id.org/pko/industry#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix pro: <http://purl.org/spar/pro/> .
@prefix nfdi4ing-metadata4ing: <http://w3id.org/nfdi4ing/metadata4ing#> .
@prefix pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix vann: <http://purl.org/vocab/vann/> .

<https://example.org/pko-native-procedural-knowledge-rulebook> a owl:Ontology ;
    rdfs:label "PKO-Native Procedural Knowledge Rulebook" ;
    dcterms:title "PKO-Native Procedural Knowledge Rulebook" ;
    dcterms:description "A canonical Effortless Rulebook profile aligned to the Procedural Knowledge Ontology (PKO) 2.0.0. It represents procedure specifications separately from executions and includes versioning, status changes, steps, transitions, actions, software functions, tools, requirements, verifications, resources, agents, roles in time, issues, errors, questions, feedback, FAQs, explanations, governance, tacit/implicit/explicit knowledge capture, operational data bindings, learning, and communication policy projections. PKO-native terms are mapped exactly; enterprise knowledge-governance additions are explicitly identified as ERB-PKO extensions." ;
    rdfs:comment "Generated by Effortless (rulebook-to-owl) from pko-native-procedural-knowledge-rulebook-rulebook.json. The rulebook is the source: change it there, not here." ;
    rdfs:comment "This namespace is a placeholder derived from the rulebook's name. To publish under your own, add a row to the rulebook's __meta__ table: MetaKey ontology_iri, StringValue your IRI." ;
    rdfs:comment "ERB build parameters: erbBlankLogic=coerce, erbDateDiff=calendar, erbDateTimeText=iso8601, erbTimezone=UTC, erbWholeNumber=by-field-type" .

dcterms:description a owl:AnnotationProperty .
dcterms:title a owl:AnnotationProperty .

# The key of the row an individual was made from, verbatim (its IRI is only a slug of it).
erb:key a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "key" .

# === Class: AbundantKnowledgeGaps ===
pko-extension:AbundantKnowledgeGap a owl:Class ;
    rdfs:label "AbundantKnowledgeGaps" ;
    rdfs:comment "The kinds of knowledge that an abundance of information does not supply, each pointing at the table in this model that represents it. One row per kind named in the source material's 'paradox of abundant knowledge'." .

# === Class: AccessDenialTests ===
pko-extension:AccessDenialTest a owl:Class ;
    rdfs:label "AccessDenialTests" ;
    rdfs:comment "Denial witnesses. A policy with no failing case seeded against it is an assertion, not evidence -- the same acceptance bar the rest of this rulebook holds. Each row names a principal, a query, and the row that MUST NOT come back, so a policy that silently stops enforcing is caught by a red test rather than by an incident." .

# === Class: AccessPolicies ===
pko-extension:AccessPolicy a owl:Class ;
    rdfs:label "AccessPolicies" ;
    rdfs:comment "Row-level security policies: the VERTICAL cut. One row per principal x table x command, carrying the predicate that decides which rows are visible. RowPredicate is emitted verbatim into a Postgres USING clause, so it may call any SECURITY DEFINER calc_* function and therefore reference inference fields many hops down the DAG." .

# === Class: AccessPrincipals ===
pko-extension:AccessPrincipal a owl:Class ;
    rdfs:label "AccessPrincipals" ;
    rdfs:comment "Security principals -- the identities policies attach to. A principal is the console persona a person logs in as; it maps many-to-one onto a domain Role, so 'who may see this row' is expressed once against the domain vocabulary while the UI keeps its own persona names. Each principal owns exactly one Postgres role and one Postgres schema." .

# === Class: Actions ===
pko:Action a owl:Class .

# === Class: ActivityRelations ===
pko-extension:ActivityRelation a owl:Class ;
    rdfs:label "ActivityRelations" ;
    rdfs:comment "Temporal and causal relations between steps beyond simple sequence." .

# === Class: AgentDecisionRecords ===
pko-extension:AgentDecisionRecord a owl:Class ;
    rdfs:label "AgentDecisionRecords" ;
    rdfs:comment "AgentDecisionRecords (added by witness loop 1)." .

# === Class: AgentIntegrations ===
pko-extension:AgentIntegration a owl:Class ;
    rdfs:label "AgentIntegrations" ;
    rdfs:comment "The central registry of AI agent integrations: which agent reads which knowledge system, over which pathway, served which graph." .

# === Class: AgentUpgradeAssessments ===
pko-extension:AgentUpgradeAssessment a owl:Class ;
    rdfs:label "AgentUpgradeAssessments" ;
    rdfs:comment "Impact assessments of moving an agent to a newer model version, as listed by whoever assessed it and as traversed in the graph." .

# === Class: Agents ===
prov:Agent a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#Organization> ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#SoftwareAgent> .

# === Class: AiAdoptionInitiatives ===
pko-extension:AiAdoptionInitiative a owl:Class ;
    rdfs:label "AiAdoptionInitiatives" ;
    rdfs:comment "AI initiatives: the agent, the process and procedure it works on, the automation level, and what came of it." .

# === Class: AiAgentAccountabilities ===
pko-extension:AiAgentAccountability a owl:Class ;
    rdfs:label "AiAgentAccountabilities" ;
    rdfs:comment "The human person accountable for an AI agent, with a validity period." .

# === Class: AiInsightProposals ===
pko-extension:AiInsightProposal a owl:Class ;
    rdfs:label "AiInsightProposals" ;
    rdfs:comment "Insight an AI produced about a process, and whether it was validated and folded back into the knowledge base." .

# === Class: AiLabelingRuns ===
pko-extension:AiLabelingRun a owl:Class ;
    rdfs:label "AiLabelingRuns" ;
    rdfs:comment "A run in which an AI model assigned controlled values, with or without a grounding scheme." .

# === Class: AiModelDeployments ===
pko-extension:AiModelDeployment a owl:Class ;
    rdfs:label "AiModelDeployments" ;
    rdfs:comment "Deployment records for AI system versions, from the registry feed." .

# === Class: AiModelEvaluations ===
pko-extension:AiModelEvaluation a owl:Class ;
    rdfs:label "AiModelEvaluations" ;
    rdfs:comment "Evaluation results for AI system versions, from the registry feed." .

# === Class: AiRegistryModelVersions ===
pko-extension:AiRegistryModelVersion a owl:Class ;
    rdfs:label "AiRegistryModelVersions" ;
    rdfs:comment "Model versions supplied by the external AI system registry feed, described in Dublin Core terms." .

# === Class: AiToolInvocations ===
pko-extension:AiToolInvocation a owl:Class ;
    rdfs:label "AiToolInvocations" ;
    rdfs:comment "A tool or function an AI agent invoked during a step execution, with the inputs it supplied." .

# === Class: AnswerGroundings ===
pko-native-procedural-knowledge-rulebook:AnswerGroundings a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#Derivation> ;
    rdfs:label "AnswerGroundings" ;
    rdfs:comment "Which served assertion, segment or external source grounded an assistant answer, and whether it was cited." .

# === Class: AnswerRequirementChecks ===
pko-extension:AnswerRequirementCheck a owl:Class ;
    rdfs:label "AnswerRequirementChecks" ;
    rdfs:comment "A check of an AI recommendation against a requirement, and its verdict." .

# === Class: AppActionFields ===
pko-extension:AppActionField a owl:Class ;
    rdfs:label "AppActionFields" ;
    rdfs:comment "The fields one action writes, one row each, and where each value comes from: typed by the person, picked from a list, fixed by the action, or stamped by the server." .

# === Class: AppActions ===
pko-extension:AppAction a owl:Class ;
    rdfs:label "AppActions" ;
    rdfs:comment "One row per thing a role may DO in the app: the base table it writes, the operation, the access policy that permits it, and the derived value the page highlights afterwards. The app has no per-action endpoint; it executes these rows." .

# === Class: AppNavGroups ===
pko-extension:AppNavGroup a owl:Class ;
    rdfs:label "AppNavGroups" ;
    rdfs:comment "The left-navigation section headers. A route names the group it appears under; the nav renders the groups its active role actually uses." .

# === Class: AppRoleProfiles ===
pko-extension:AppRoleProfile a owl:Class ;
    rdfs:label "AppRoleProfiles" ;
    rdfs:comment "One row per role, carrying how that role is presented: its accent colour, its 128x128 icon, and the login-card copy. Presentation is data, so the app never hardcodes a colour or a label per role." .

# === Class: AppRouteQuestions ===
pko-extension:AppRouteQuestion a owl:Class ;
    rdfs:label "AppRouteQuestions" ;
    rdfs:comment "Junction: which RoleQuestions each route helps answer. Deliberately many-to-many — a question is answered across several routes and a route serves several questions. It is not, and should not become, 1:1." .

# === Class: AppRouteReferences ===
pko-extension:AppRouteReference a owl:Class ;
    rdfs:label "AppRouteReferences" ;
    rdfs:comment "Junction: which other routes a route links to. This is the navigation graph between screens, kept as rows rather than embedded lists so the canonical model stays a DAG." .

# === Class: AppRoutes ===
pko-extension:AppRoute a owl:Class ;
    rdfs:label "AppRoutes" ;
    rdfs:comment "One row per screen in the role-navigated application, as /{role}/{dashboard}/{entity...}. Each carries its purpose in the owning role's voice and brief layout hints, so a later build session has the brief without re-deriving it. Shared detail routes have no owning role." .

# === Class: AppUsers ===
pko-extension:AppUser a owl:Class ;
    rdfs:label "AppUsers" ;
    rdfs:comment "Sign-in identities. One row per person or automation that can authenticate. EmailAddress is what a verified token asserts; everything else about the caller is resolved from here inside the database, never trusted from the token." .

# === Class: ApplicabilityScopes ===
pko-extension:ApplicabilityScope a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/ns/sparql-service-description#NamedGraph> ;
    rdfs:label "ApplicabilityScopes" ;
    rdfs:comment "Where a piece of process knowledge applies: business unit, geography, customer segment, regulatory regime, conditions, and the named graph holding it." .

# === Class: ArticleClaims ===
pko-extension:ArticleClaim a owl:Class ;
    rdfs:label "ArticleClaims" ;
    rdfs:comment "One row per thing a source article says a process-knowledge system must represent, do, answer or use. Paraphrased with a section reference; never quoted." .

# === Class: ArtifactHandoffs ===
pko-extension:ArtifactHandoff a owl:Class ;
    rdfs:label "ArtifactHandoffs" ;
    rdfs:comment "One artifact passing from the step that produces it to a step that consumes it, asserted per declared input variable. The edge table the upgrade blast radius is traversed over." .

# === Class: AssignmentInstantChecks ===
pko-extension:AssignmentInstantCheck a owl:Class ;
    rdfs:label "AssignmentInstantChecks" ;
    rdfs:comment "Point-in-time audit of which role assignment, and which agent version, held a step at a past instant." .

# === Class: AssignmentRoutedNotices ===
pko-extension:AssignmentRoutedNotice a owl:Class ;
    rdfs:label "AssignmentRoutedNotices" ;
    rdfs:comment "Approval and verification notices a deployment pipeline sent for a run, where it read the recipient from, and who received it." .

# === Class: AssignmentUpdatePolicies ===
pko-extension:AssignmentUpdatePolicy a owl:Class ;
    rdfs:label "AssignmentUpdatePolicies" ;
    rdfs:comment "Governance for updating role assignments once operational systems read them: who triggers the update and the service level for completing it." .

# === Class: AssistantAnswers ===
pko-extension:AssistantAnswer a owl:Class ;
    rdfs:label "AssistantAnswers" ;
    rdfs:comment "One answer, guidance or recommendation an AI assistant delivered, recorded with its context and review. The model does not run the AI; it records what it said." .

# === Class: AssistantBenchmarks ===
pko-extension:AssistantBenchmark a owl:Class ;
    rdfs:label "AssistantBenchmarks" ;
    rdfs:comment "Recorded accuracy of an AI assistant on a task family with and without graph grounding." .

# === Class: Attestations ===
pko-native-procedural-knowledge-rulebook:Attestations a owl:Class ;
    rdfs:label "Attestations" ;
    rdfs:comment "Attestations (added by witness loop 2)." .

# === Class: AuthoringSubmissions ===
pko-extension:AuthoringSubmission a owl:Class ;
    rdfs:label "AuthoringSubmissions" ;
    rdfs:comment "Procedures submitted through the no-code capture form, validated against the PKO profile." .

# === Class: AuthorityBoundaries ===
pko-extension:AuthorityBoundary a owl:Class ;
    rdfs:label "AuthorityBoundaries" ;
    rdfs:comment "AuthorityBoundaries (added by witness loop 1)." .

# === Class: BindingObservations ===
pko-native-procedural-knowledge-rulebook:BindingObservations a owl:Class ;
    rdfs:label "BindingObservations" ;
    rdfs:comment "BindingObservations (added by witness loop 2)." .

# === Class: BusinessOutcomes ===
pko-extension:BusinessOutcome a owl:Class ;
    rdfs:label "BusinessOutcomes" ;
    rdfs:comment "Results the business cares about, owned by an executive or manager." .

# === Class: CapabilityDeclines ===
pko-extension:CapabilityDecline a owl:Class ;
    rdfs:label "CapabilityDeclines" ;
    rdfs:comment "When an organization's training-and-retention cycle began to decline at one stage (facility investment, engineer training, upkeep of how-to-make knowledge) and the decline of the stage before it." .

# === Class: CellDisagreements ===
pko-extension:CellDisagreement a owl:Class ;
    rdfs:label "CellDisagreements" ;
    rdfs:comment "Latest run only: one cell a substrate computed differently from the answer key, with both values verbatim. Sampled per field; see FieldDisagreements.IsFullySampled." .

# === Class: ChangeAuthorityRules ===
pko-extension:ChangeAuthorityRule a owl:Class ;
    rdfs:label "ChangeAuthorityRules" ;
    rdfs:comment "Which role may change which layer of a model, who approves, through which process, and the response when a change breaks the model." .

# === Class: ChangeImpactFindings ===
pko-extension:ChangeImpactFinding a owl:Class ;
    rdfs:label "ChangeImpactFindings" ;
    rdfs:comment "What an impact assessment (or, too late, deployment) found a change does to instance data, inferences, query results and coverage." .

# === Class: ChangeIntegrityChecks ===
pko-extension:ChangeIntegrityCheck a owl:Class ;
    rdfs:label "ChangeIntegrityChecks" ;
    rdfs:comment "Integrity review of a schema change: disjointness, domain inference and range consistency." .

# === Class: ChangeObjections ===
pko-extension:ChangeObjection a owl:Class ;
    rdfs:label "ChangeObjections" ;
    rdfs:comment "Stakeholder objections to a change and how they were resolved." .

# === Class: ChangeRequests ===
pko-extension:ChangeRequest a owl:Class ;
    rdfs:label "ChangeRequests" ;
    rdfs:comment "Governed requests for semantic or operational change, anchored to a procedure version and authority. Explicit ERB-PKO extension." .

# === Class: ChangeValidationRuns ===
pko-extension:ChangeValidationRun a owl:Class ;
    rdfs:label "ChangeValidationRuns" ;
    rdfs:comment "The validation suite run with a proposed change applied." .

# === Class: ClaimEvidence ===
pko-extension:ClaimEvidence a owl:Class ;
    rdfs:label "ClaimEvidence" ;
    rdfs:comment "A proposed piece of evidence that the model covers a claim, with the justification a skeptic can audit. Whether it counts is computed in IsValid from measured facts, never asserted." .

# === Class: ClassificationFacets ===
pko-extension:ClassificationFacet a owl:Class ;
    rdfs:label "ClassificationFacets" ;
    rdfs:comment "Independent dimensions along which procedures are classified." .

# === Class: CollectedSourceMaterials ===
pko-extension:CollectedSourceMaterial a owl:Class ;
    rdfs:label "CollectedSourceMaterials" ;
    rdfs:comment "Raw material collection produced, and when it was organized into a scheme and encoded into a procedure version." .

# === Class: CollectionOccasions ===
pko-extension:CollectionOccasion a owl:Class ;
    rdfs:label "CollectionOccasions" ;
    rdfs:comment "Recurring occasions at which process knowledge is collected: retrospectives, process reviews and improvement initiatives." .

# === Class: CommunicationPolicies ===
pko-native-procedural-knowledge-rulebook:CommunicationPolicies a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/ns/odrl/2/Policy> ;
    rdfs:label "CommunicationPolicies" ;
    rdfs:comment "Channel-specific communication policy projected from the same canonical procedure. Uses ODRL-style policy semantics plus ERB-PKO channel constraints." .

# === Class: CommunitiesOfPractice ===
pko-extension:CommunityOfPractice a owl:Class ;
    rdfs:label "CommunitiesOfPractice" ;
    rdfs:comment "Socio-technical communities that transmit and maintain procedural knowledge. Explicit ERB-PKO extension." .

# === Class: CommunityMemberships ===
pko-extension:CommunityMembership a owl:Class ;
    rdfs:label "CommunityMemberships" ;
    rdfs:comment "A person's membership of a community of practice, whether they belong to a different organization, and whether they are a specialist others consult." .

# === Class: CompetencyQuestionReviews ===
pko-extension:CompetencyQuestionReview a owl:Class ;
    rdfs:label "CompetencyQuestionReviews" ;
    rdfs:comment "Periodic reviews of a model's competency question set." .

# === Class: CompetencyQuestionRuns ===
pko-extension:CompetencyQuestionRun a owl:Class ;
    rdfs:label "CompetencyQuestionRuns" ;
    rdfs:comment "Each competency question run as a task against a release: answerable, and answered correctly." .

# === Class: CompetencyQuestionSetEntries ===
pko-extension:CompetencyQuestionSetEntry a owl:Class ;
    rdfs:label "CompetencyQuestionSetEntries" ;
    rdfs:comment "The competency question set of each governed model, with the original baseline kept apart from later additions." .

# === Class: ConceptLadderRungs ===
pko-extension:ConceptLadderRung a owl:Class ;
    rdfs:label "ConceptLadderRungs" ;
    rdfs:comment "Rungs of a concept ladder built around a concrete action: positive levels climb by asking why to the goals and values it serves, negative levels descend by asking how to its subprocesses and conditions." .

# === Class: ConditionChecks ===
pko-extension:ConditionCheck a owl:Class ;
    rdfs:label "ConditionChecks" ;
    rdfs:comment "A step condition checked during a step execution." .

# === Class: ConformanceRuns ===
pko-extension:ConformanceRun a owl:Class ;
    rdfs:label "ConformanceRuns" ;
    rdfs:comment "One execution of the conformance harness over every graded substrate. Kept as history; exactly one run is marked IsLatest, and the per-table, per-field and per-cell detail tables describe that run." .

# === Class: ConformanceSubstrates ===
pko-extension:ConformanceSubstrate a owl:Class ;
    rdfs:label "ConformanceSubstrates" ;
    rdfs:comment "Every tool that compiles this rulebook into something that computes. One is the answer-key author (compile-rulebook bakes derived values into the rulebook's own rows); the rest are graded substrates that re-derive those values natively and are scored cell by cell against them." .

# === Class: ConsumerRevalidations ===
pko-extension:ConsumerRevalidation a owl:Class ;
    rdfs:label "ConsumerRevalidations" ;
    rdfs:comment "Per release and consumer: was the consumer told, and re-validated against the release." .

# === Class: ConsumerSystemSyncs ===
pko-extension:ConsumerSystemSync a owl:Class ;
    rdfs:label "ConsumerSystemSyncs" ;
    rdfs:comment "Which procedure version a consuming system currently holds, from what source, and when it was synced." .

# === Class: CorporateGovernancePrograms ===
pko-extension:CorporateGovernanceProgram a owl:Class ;
    rdfs:label "CorporateGovernancePrograms" ;
    rdfs:comment "Governance programmes an organization runs, who sponsors them, and what their scope covers." .

# === Class: CriticalIncidents ===
pko-extension:CriticalIncident a owl:Class ;
    rdfs:label "CriticalIncidents" ;
    rdfs:comment "Specific past episodes of a procedure that went well, went badly or needed improvising, collected with the critical incident technique, each linked to the judgment call it brought out." .

# === Class: CueObservations ===
pko-extension:CueObservation a owl:Class ;
    rdfs:label "CueObservations" ;
    rdfs:comment "A cue observed during a step execution." .

# === Class: DecisionPoints ===
pko-native-procedural-knowledge-rulebook:DecisionPoints a owl:Class ;
    rdfs:seeAlso <https://www.omg.org/spec/DMN/20191111/MODEL/Decision> ;
    rdfs:label "DecisionPoints" ;
    rdfs:comment "Choice points and the factors that decide them (dmn:Decision)." .

# === Class: DeliveredCommunications ===
pko-extension:DeliveredCommunication a owl:Class ;
    rdfs:label "DeliveredCommunications" ;
    rdfs:comment "Everything above is a proxy for the real question, which is instance-level: THIS message, to THIS recipient, rendered from THIS template, authorized by THIS approval. The model has MessageTemplates and CommunicationPolicies as specifications and no record of a single thing ever sent. Without an instance table, 'can I show that what was sent matched what I approved' is permanently unanswerable rather than merely unanswered — and it is the question a disputing employee actually asks. Extension term (https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#DeliveredCommunication); PKO has no native class for a delivered artifact instance." .

# === Class: DepartmentProcessAccounts ===
pko-extension:DepartmentProcessAccount a owl:Class ;
    rdfs:label "DepartmentProcessAccounts" ;
    rdfs:comment "The account a stakeholder department gives of a process, the interest shaping it, any conflicting account from another department, and the practice used to resolve the disagreement." .

# === Class: DomainCoverageAreas ===
pko-extension:DomainCoverageArea a owl:Class ;
    rdfs:label "DomainCoverageAreas" ;
    rdfs:comment "The domain coverage model: areas a model must cover and the table that covers each." .

# === Class: DriftObservations ===
pko-extension:DriftObservation a owl:Class ;
    rdfs:label "DriftObservations" ;
    rdfs:comment "Observed drift: places where a model no longer matches the organization it describes, how each was detected, and what drove it." .

# === Class: ERBCustomizations ===
pko-native-procedural-knowledge-rulebook:ERBCustomizations a owl:Class ;
    rdfs:label "ERBCustomizations" ;
    rdfs:comment "Explicit customization seams; empty because the canonical model is expressed in the rulebook." .

# === Class: ERBVersions ===
pko-native-procedural-knowledge-rulebook:ERBVersions a owl:Class ;
    rdfs:label "ERBVersions" ;
    rdfs:comment "Standard ERB semantic version history." .

# === Class: ElicitationParticipants ===
pko-extension:ElicitationParticipant a owl:Class ;
    rdfs:label "ElicitationParticipants" ;
    rdfs:comment "Who took part in an elicitation session: their part in the session, whether they produce or consume the knowledge, their stake in the process, and whether people in their position are normally invited." .

# === Class: ElicitationSessions ===
pko-extension:ElicitationSession a owl:Class ;
    rdfs:label "ElicitationSessions" ;
    rdfs:comment "Structured knowledge-elicitation events involving practitioners and knowledge engineers. Explicit ERB-PKO extension, modeled as prov:Activity." .

# === Class: EmbeddingProbes ===
pko-extension:EmbeddingProbe a owl:Class ;
    rdfs:label "EmbeddingProbes" ;
    rdfs:comment "Recorded similarity of process-vocabulary term pairs under an embedding model." .

# === Class: EncodingLifecycleStages ===
pko-extension:EncodingLifecycleStage a owl:Class ;
    rdfs:label "EncodingLifecycleStages" ;
    rdfs:comment "The stages that carry process knowledge to AI and reuse: collect, store, document, codify, encode, operationalize." .

# === Class: EnergySources ===
pko-industry:EnergySource a owl:Class .

# === Class: Errors ===
pko:Error a owl:Class .

# === Class: EvaluationContexts ===
pko-extension:EvaluationContext a owl:Class ;
    rdfs:label "EvaluationContexts" ;
    rdfs:comment "The instant this rulebook's time-dependent witnesses are evaluated against. Modeled as data rather than wall-clock so every freshness, overdue, and validity answer is reproducible and auditable: asking the same question tomorrow yields the same answer. Exactly one row carries IsCurrent." .

# === Class: ExceptionInvocations ===
pko-extension:ExceptionInvocation a owl:Class ;
    rdfs:label "ExceptionInvocations" ;
    rdfs:comment "ExceptionInvocations (added by witness loop 1)." .

# === Class: Exceptions ===
pko-extension:Exception a owl:Class ;
    rdfs:label "Exceptions" ;
    rdfs:comment "Documented exceptions, fallbacks, and alternative handling. Aligns structurally with PKO fallback/alternative steps and requirements; the exception record itself is an ERB-PKO extension." .

# === Class: ExecutionEntities ===
pko-native-procedural-knowledge-rulebook:ExecutionEntities a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#Entity> ;
    rdfs:label "ExecutionEntities" ;
    rdfs:comment "Entities a step execution used or generated (prov:used, prov:wasGeneratedBy, pplan:correspondsToVariable)." .

# === Class: ExecutionParticipants ===
pko-native-procedural-knowledge-rulebook:ExecutionParticipants a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#Association> ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#wasAssociatedWith> ;
    rdfs:label "ExecutionParticipants" ;
    rdfs:comment "Agents associated with a procedure execution besides its executor (prov:wasAssociatedWith)." .

# === Class: ExpansionConceptFits ===
pko-extension:ExpansionConceptFit a owl:Class ;
    rdfs:label "ExpansionConceptFits" ;
    rdfs:comment "Each concept a proposed workflow needs, and the existing table that covers it." .

# === Class: ExpectedInferenceChecks ===
pko-extension:ExpectedInferenceCheck a owl:Class ;
    rdfs:label "ExpectedInferenceChecks" ;
    rdfs:comment "Expected logical consequences the validation suite checks: an inference chain and the value it must land." .

# === Class: ExpertCognitions ===
pko-extension:ExpertCognition a owl:Class ;
    rdfs:label "ExpertCognitions" ;
    rdfs:comment "Mental models and decision heuristics experts apply, drawn out by protocols and incident interviews, with any exceptions the expert stated and whether the capture kept them." .

# === Class: Explanations ===
pko:Explanation a owl:Class .

# === Class: ExternalDependencyRevisions ===
pko-extension:ExternalDependencyRevision a owl:Class ;
    rdfs:label "ExternalDependencyRevisions" ;
    rdfs:comment "Revisions and deprecations published by external standards the model reuses." .

# === Class: ExternalStandardTerms ===
pko-extension:ExternalStandardTerm a owl:Class ;
    rdfs:label "ExternalStandardTerms" ;
    rdfs:comment "Terms the model reuses from external standards, whether the source deprecated them, and how the model responded." .

# === Class: FAQs ===
pko:FrequentlyAskedQuestion a owl:Class .

# === Class: Facilities ===
pko-industry:Site a owl:Class .

# === Class: FailureModes ===
pko-extension:FailureMode a owl:Class ;
    rdfs:label "FailureModes" ;
    rdfs:comment "Ways a step can fail and the response to each." .

# === Class: FaqCategories ===
pko:FAQCategory a owl:Class .

# === Class: FaqTargets ===
pko:FAQTarget a owl:Class .

# === Class: FieldDisagreements ===
pko-extension:FieldDisagreement a owl:Class ;
    rdfs:label "FieldDisagreements" ;
    rdfs:comment "Latest run only: a derived field on which one substrate got at least one cell wrong. A field with no row here agreed everywhere. CellsFailed is the true count; CellDisagreements holds a sample of the cells." .

# === Class: FieldGrants ===
pko-extension:FieldGrant a owl:Class ;
    rdfs:label "FieldGrants" ;
    rdfs:comment "Field-level grants: the HORIZONTAL cut. One row per principal x field. A field with no grant row is not filtered from the principal's view -- it is absent from it, so the column does not exist as far as that principal's SQL is concerned." .

# === Class: FragmentCorroborations ===
pko-extension:FragmentCorroboration a owl:Class ;
    rdfs:label "FragmentCorroborations" ;
    rdfs:comment "Independent data points (another session or another practitioner) that bear on a knowledge fragment." .

# === Class: Functions ===
pko:Function a owl:Class .

# === Class: GovernanceStageControls ===
pko-extension:GovernanceStageControl a owl:Class ;
    rdfs:label "GovernanceStageControls" ;
    rdfs:comment "The governance control over each stage of a procedure family's knowledge lifecycle." .

# === Class: GovernedModels ===
pko-extension:GovernedModel a owl:Class ;
    rdfs:label "GovernedModels" ;
    rdfs:comment "Everything under governance: this rulebook as an ontology, each procedure family, and each governed vocabulary." .

# === Class: GroundingSnapshots ===
pko-extension:GroundingSnapshot a owl:Class ;
    rdfs:label "GroundingSnapshots" ;
    rdfs:comment "A snapshot of the knowledge graph as it is served to retrieval and AI context, with its reasoning and governance record." .

# === Class: InstanceDataVersions ===
pko-extension:InstanceDataVersion a owl:Class ;
    rdfs:label "InstanceDataVersions" ;
    rdfs:comment "Versions of a model's instance data, kept separately from schema releases." .

# === Class: IntegrationPathways ===
pko-extension:IntegrationPathway a owl:Class ;
    rdfs:label "IntegrationPathways" ;
    rdfs:comment "Shared pathways agents reach knowledge through (a Model Context Protocol server, an agent-to-agent gateway) versus one-off connections." .

# === Class: InterviewProbes ===
pko-extension:InterviewProbe a owl:Class ;
    rdfs:label "InterviewProbes" ;
    rdfs:comment "Questions put in an elicitation interview, typed by what they probe: why a choice is made, what the practitioner would do if a condition changed, or what happens when the procedure falls short." .

# === Class: IssueOccurrences ===
pko:IssueOccurrence a owl:Class .

# === Class: IssuedTokens ===
pko-native-procedural-knowledge-rulebook:IssuedTokens a owl:Class ;
    rdfs:label "IssuedTokens" ;
    rdfs:comment "Audit trail of every token minted. A token records which user signed in, which principal they chose, and the claims that were joined from the database at mint time -- so a later question of 'what could this session see' is answerable from data rather than reconstruction." .

# === Class: JwtClaimMappings ===
pko-extension:JwtClaimMapping a owl:Class ;
    rdfs:label "JwtClaimMappings" ;
    rdfs:comment "Maps verified JWT claims onto the SQL accessors row predicates call. Magic-links is the notary: it asserts only that the bearer controls an email address. This table records how that verified email, and any additional claims, become values a policy can test." .

# === Class: KnowHowCarriers ===
pko-extension:KnowHowCarrier a owl:Class ;
    rdfs:label "KnowHowCarriers" ;
    rdfs:comment "One piece of an organization's process know-how and what carries it: a person, a facility or a system, with the community it belongs to, the forms it is held in, and how long it took to build." .

# === Class: KnowledgeAuditItems ===
pko-extension:KnowledgeAuditItem a owl:Class ;
    rdfs:label "KnowledgeAuditItems" ;
    rdfs:comment "One knowledge area an audit assessed: the level needed, the level the client holds, and any provider that holds it." .

# === Class: KnowledgeAudits ===
pko-extension:KnowledgeAudit a owl:Class ;
    rdfs:label "KnowledgeAudits" ;
    rdfs:comment "Audits of the procedural knowledge an organization holds against what it needs." .

# === Class: KnowledgeBrokerLinks ===
pko-extension:KnowledgeBrokerLink a owl:Class ;
    rdfs:label "KnowledgeBrokerLinks" ;
    rdfs:comment "An informal expertise-network edge: one agent naming another as who they actually go to for a topic, independent of any formal Role or RoleAssignment. RoleAssignments and CommunitiesOfPractice record who is SUPPOSED to know something; this records who people ACTUALLY rely on." .

# === Class: KnowledgeCaptureInitiatives ===
pko-extension:KnowledgeCaptureInitiative a owl:Class ;
    rdfs:label "KnowledgeCaptureInitiatives" ;
    rdfs:comment "Deliberate efforts to capture the knowledge of a function, with the method used." .

# === Class: KnowledgeConsumerSystems ===
pko-extension:KnowledgeConsumerSystem a owl:Class ;
    rdfs:label "KnowledgeConsumerSystems" ;
    rdfs:comment "Systems that hold or consume process knowledge: content management, process modeling tools, semantic repositories, knowledge graph platforms, AI platforms and field apps." .

# === Class: KnowledgeConversions ===
pko-extension:KnowledgeConversion a owl:Class ;
    rdfs:label "KnowledgeConversions" ;
    rdfs:comment "Recorded shifts of process knowledge between tacit and explicit form, typed by SECI conversion mode." .

# === Class: KnowledgeDeliverables ===
pko-extension:KnowledgeDeliverable a owl:Class ;
    rdfs:label "KnowledgeDeliverables" ;
    rdfs:comment "Explicit knowledge management deliverables an engagement requires, and the direction knowledge moves." .

# === Class: KnowledgeFragments ===
pko-extension:KnowledgeFragment a owl:Class ;
    rdfs:label "KnowledgeFragments" ;
    rdfs:comment "Explicit records of tacit, implicit, explicit, and situated procedural knowledge. This is an ERB-PKO extension represented as provenance-bearing dcat:Resource instances." .

# === Class: KnowledgeGaps ===
pko-extension:KnowledgeGap a owl:Class ;
    rdfs:label "KnowledgeGaps" ;
    rdfs:comment "Known unknowns and missing procedural coverage. Explicit ERB-PKO extension used to govern scope and prevent silent incompleteness." .

# === Class: KnowledgeHoldings ===
pko-extension:KnowledgeHolding a owl:Class ;
    rdfs:label "KnowledgeHoldings" ;
    rdfs:comment "Where a piece of a procedure's knowledge lives at one point in time (before and after encoding): operators' memory, formal documents, notes in outdated manuals, the memory of staff who may leave, unspoken crew agreements, or the procedure rulebook." .

# === Class: KnowledgeMethods ===
pko-extension:KnowledgeMethod a owl:Class ;
    rdfs:label "KnowledgeMethods" ;
    rdfs:comment "Named methods, techniques and methodologies for eliciting, analysing, modeling and governing process knowledge. A method is only evidence that the model uses it when a seeded row applies it." .

# === Class: KnowledgeOutcomeMeasurements ===
pko-extension:KnowledgeOutcomeMeasurement a owl:Class ;
    rdfs:label "KnowledgeOutcomeMeasurements" ;
    rdfs:comment "Operational outcomes measured for a team or AI initiative, alongside how well it can reach the process knowledge." .

# === Class: KnowledgeProjections ===
pko-extension:KnowledgeProjection a owl:Class ;
    rdfs:label "KnowledgeProjections" ;
    rdfs:comment "Diagrams and narrative documents that present a procedure version to people, and whether they were generated from the model." .

# === Class: KnowledgeQueryDefinitions ===
pko-extension:KnowledgeQueryDefinition a owl:Class ;
    rdfs:label "KnowledgeQueryDefinitions" ;
    rdfs:comment "Structured queries (SPARQL or SQL) run over the knowledge, with the layers and sources they touch." .

# === Class: KnowledgeQuerySources ===
pko-extension:KnowledgeQuerySource a owl:Class ;
    rdfs:label "KnowledgeQuerySources" ;
    rdfs:comment "The knowledge systems one structured query reads." .

# === Class: KnowledgeRepositoryEntries ===
pko-extension:KnowledgeRepositoryEntry a owl:Class ;
    rdfs:label "KnowledgeRepositoryEntries" ;
    rdfs:comment "Captured procedural knowledge kept in a repository: who wrote it, whose know-how it records, for whom, whether it came back from executing the work, and whether it is kept current." .

# === Class: KnowledgeSearchEvents ===
pko-extension:KnowledgeSearchEvent a owl:Class ;
    rdfs:label "KnowledgeSearchEvents" ;
    rdfs:comment "Searches and retrievals against the knowledge, by people and AI, with what they found and when they gave up." .

# === Class: KnowledgeTestOutcomes ===
pko-extension:KnowledgeTestOutcome a owl:Class ;
    rdfs:label "KnowledgeTestOutcomes" ;
    rdfs:comment "Outcomes a process knowledge test programme is expected to improve, measured before and after testing." .

# === Class: KnowledgeTraces ===
pko-native-procedural-knowledge-rulebook:KnowledgeTraces a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#Derivation> ;
    rdfs:label "KnowledgeTraces" ;
    rdfs:comment "One trace from a piece of organized knowledge (a process model, an activity definition or a constraint) to the collected material it rests on, with the role the material plays (origin, validation, extension, contradiction), how the knowledge was derived, and who confirmed it." .

# === Class: KnowledgeTransfers ===
pko-extension:KnowledgeTransfer a owl:Class ;
    rdfs:label "KnowledgeTransfers" ;
    rdfs:comment "One occasion on which know-how passed from one person to another, and the channel it travelled through." .

# === Class: KnowledgeWorkforcePositions ===
pko-extension:KnowledgeWorkforcePosition a owl:Class ;
    rdfs:label "KnowledgeWorkforcePositions" ;
    rdfs:comment "Dedicated knowledge engineering, information architecture and ontology positions an organization budgets." .

# === Class: LearningActivities ===
pko-native-procedural-knowledge-rulebook:LearningActivities a owl:Class ;
    rdfs:label "LearningActivities" ;
    rdfs:comment "Learning, retrospective, tabletop, and onboarding activities that convert execution experience into maintained knowledge. Explicit ERB-PKO extension represented as prov:Activity." .

# === Class: LevelCaptureStrategies ===
pko-extension:LevelCaptureStrategy a owl:Class ;
    rdfs:label "LevelCaptureStrategies" ;
    rdfs:comment "How the tacit or explicit knowledge of one level is captured and passed on." .

# === Class: LevelPyramidQuestions ===
pko-extension:LevelPyramidQuestion a owl:Class ;
    rdfs:label "LevelPyramidQuestions" ;
    rdfs:comment "The planning pyramid: which questions each level answers (strategic who and why, tactical what, operational how and where)." .

# === Class: LifecycleStatuses ===
pko-native-procedural-knowledge-rulebook:LifecycleStatuses a owl:Class ;
    rdfs:subClassOf pko:Status ;
    rdfs:subClassOf pko-extension:LegacyStatus ;
    rdfs:subClassOf pko:ProcedureExecutionStatus ;
    rdfs:subClassOf pko:ProcedureStatus ;
    rdfs:label "LifecycleStatuses" ;
    rdfs:comment "Every status a procedure version or an execution can hold, as one controlled scheme. PKO 2.0.0 types procedure statuses and execution statuses as specializations of one general status." .

pko:Status a owl:Class .

pko-extension:LegacyStatus a owl:Class .

pko:ProcedureExecutionStatus a owl:Class .

pko:ProcedureStatus a owl:Class .

# === Class: LockDevices ===
pko-industry:Lock a owl:Class .

# === Class: MachineEnergySources ===
pko-extension:MachineEnergySource a owl:Class ;
    rdfs:label "MachineEnergySources" ;
    rdfs:comment "Which energy sources each machine carries." .

# === Class: MachineTypes ===
pko-industry:MachineType a owl:Class .

# === Class: Machines ===
pko-industry:Machine a owl:Class .

# === Class: Mentorships ===
pko-extension:Mentorship a owl:Class ;
    rdfs:label "Mentorships" ;
    rdfs:comment "Time-bounded apprenticeship relationships that intentionally transfer situated procedural knowledge. Explicit ERB-PKO extension." .

# === Class: MessageDeliveries ===
pko-extension:MessageDelivery a owl:Class ;
    rdfs:label "MessageDeliveries" ;
    rdfs:comment "MessageDeliveries (added by witness loop 1)." .

# === Class: MessageTemplates ===
pko-native-procedural-knowledge-rulebook:MessageTemplates a owl:Class ;
    rdfs:label "MessageTemplates" ;
    rdfs:comment "Approved channel templates projected from the canonical rulebook without becoming a second source of policy meaning." .

# === Class: MethodApplications ===
pko-extension:MethodApplication a owl:Class ;
    rdfs:label "MethodApplications" ;
    rdfs:comment "One recorded application of a knowledge method to a concrete artifact of this model. Themes add a relationship column here for the artifact table they apply a method to." .

# === Class: MinedFlowEdges ===
pko-extension:MinedFlowEdge a owl:Class ;
    rdfs:label "MinedFlowEdges" ;
    rdfs:comment "One step-to-step hand-off reconstructed from a system event log by a process-mining run: how many cases took it, how long cases waited before the next step, and whether it is kept as observed behavior or recorded as intended logic." .

# === Class: ModelActivityExperts ===
pko-extension:ModelActivityExpert a owl:Class ;
    rdfs:label "ModelActivityExperts" ;
    rdfs:comment "Domain experts taking part in one LOT activity of a governed model." .

# === Class: ModelAnnotations ===
pko-extension:ModelAnnotation a owl:Class ;
    rdfs:label "ModelAnnotations" ;
    rdfs:comment "Comments, questions, suggestions, alternative interpretations, outdated flags and new or missing knowledge practitioners attach to the model." .

# === Class: ModelChangeLogEntries ===
pko-native-procedural-knowledge-rulebook:ModelChangeLogEntries a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#Activity> ;
    rdfs:label "ModelChangeLogEntries" ;
    rdfs:comment "The change log: every schema and instance modification, its rationale, motivating question, terms affected, version and date." .

# === Class: ModelChangeRequests ===
pko-extension:ModelChangeRequest a owl:Class ;
    rdfs:label "ModelChangeRequests" ;
    rdfs:comment "Requests to change a governed model, each begun from a stated need and tied to the competency question that motivates it." .

# === Class: ModelCharters ===
pko-extension:ModelCharter a owl:Class ;
    rdfs:label "ModelCharters" ;
    rdfs:comment "Ownership charters: who stewards a governed model and who holds authority over it, with written responsibilities, for a period." .

# === Class: ModelConsumers ===
pko-extension:ModelConsumer a owl:Class ;
    rdfs:label "ModelConsumers" ;
    rdfs:comment "Systems and agents that consume a governed model and must be updated when it changes." .

# === Class: ModelDataMappingRuns ===
pko-extension:ModelDataMappingRun a owl:Class ;
    rdfs:label "ModelDataMappingRuns" ;
    rdfs:comment "Runs that map instance data into RDF for a governed model." .

# === Class: ModelDocuments ===
pko-extension:ModelDocument a owl:Class ;
    rdfs:label "ModelDocuments" ;
    rdfs:comment "The model's development materials: requirements, version notes, documentation and evaluation materials." .

# === Class: ModelExpansionRequests ===
pko-extension:ModelExpansionRequest a owl:Class ;
    rdfs:label "ModelExpansionRequests" ;
    rdfs:comment "Requests to model new workflows with an existing model, and the governance decision on whether they fit." .

# === Class: ModelPilots ===
pko-extension:ModelPilot a owl:Class ;
    rdfs:label "ModelPilots" ;
    rdfs:comment "Pilot implementations a governed model was tried out in before or while it was adopted." .

# === Class: ModelProposals ===
pko-extension:ModelProposal a owl:Class ;
    rdfs:label "ModelProposals" ;
    rdfs:comment "Candidate contributions to a model (questions, labels, alignments, axioms, instance data) and the human review and commitment behind each." .

# === Class: ObservedActions ===
pko-extension:ObservedAction a owl:Class ;
    rdfs:label "ObservedActions" ;
    rdfs:comment "Actions an observer saw during shadowing or observation, typed as small choices, unofficial workarounds, steps omitted from the practitioner's own account, or documented steps, with the reason given when the observer asked." .

# === Class: ObservedTransitions ===
pko-extension:ObservedTransition a owl:Class ;
    rdfs:label "ObservedTransitions" ;
    rdfs:comment "The proxy above cannot tell a walked fallback from a happy-path step that happens to share an endpoint. PKO models Transition as a first-class thing; its execution counterpart is missing. Without a table that records WHICH transition a step execution arrived by, 'has this fallback ever been walked' is permanently unanswerable rather than merely unanswered. This is an extension (https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#ObservedTransition), not a native PKO term." .

# === Class: OnboardingRecords ===
pko-extension:OnboardingRecord a owl:Class ;
    rdfs:label "OnboardingRecords" ;
    rdfs:comment "A new starter learning a procedure: when they started, when they reached proficiency, and whether they learned from captured, formalized knowledge." .

# === Class: OntologyProfiles ===
pko-native-procedural-knowledge-rulebook:OntologyProfiles a owl:Class ;
    rdfs:label "OntologyProfiles" ;
    rdfs:comment "Versioned ontology and vocabulary dependencies. PKO mappings always identify the exact profile and version." .

# === Class: OntologySupportProgrammes ===
pko-extension:OntologySupportProgramme a owl:Class ;
    rdfs:label "OntologySupportProgrammes" ;
    rdfs:comment "Funded research programmes that produced or supported the ontologies this model reuses. Recorded so the ontology authority can see what happens to a reused vocabulary when the programme behind it ends." .

# === Class: OperationalBindings ===
pko-extension:OperationalBinding a owl:Class ;
    rdfs:label "OperationalBindings" ;
    rdfs:comment "Live bindings between procedural semantics and operational data/resources. Explicit ERB-PKO extension using DCAT/DCMI/PROV identifiers." .

# === Class: Organizations ===
pko-industry:Department a owl:Class .

# === Class: PractitionerExpertise ===
pko-extension:PractitionerExpertise a owl:Class ;
    rdfs:label "PractitionerExpertise" ;
    rdfs:comment "Expertise a practitioner demonstrably holds, with the basis they could not put into words recorded as a property of that knowledge source." .

# === Class: PrincipalAssignments ===
pko-extension:PrincipalAssignment a owl:Class ;
    rdfs:label "PrincipalAssignments" ;
    rdfs:comment "Which principals a user may act as. The authorization half of sign-in: a verified email proves who you are, this table decides what you may become. A user with two assignments picks one at sign-in, and the choice is verified here rather than accepted from the client." .

# === Class: ProblemOccurrences ===
pko-extension:ProblemOccurrence a owl:Class ;
    rdfs:label "ProblemOccurrences" ;
    rdfs:comment "One occurrence of a recurring work problem: who solved it, whether the solution was recorded, and the earlier occurrence of the same problem." .

# === Class: ProcedureAdoptions ===
pko-extension:ProcedureAdoption a owl:Class ;
    rdfs:label "ProcedureAdoptions" ;
    rdfs:comment "Organizations that adopt a procedure, and how (pko:isAdoptedBy)." .

# === Class: ProcedureExecutions ===
pko:ProcedureExecution a owl:Class .

# === Class: ProcedureFacetAssignments ===
pko-extension:ProcedureFacetAssignment a owl:Class ;
    rdfs:label "ProcedureFacetAssignments" ;
    rdfs:comment "A procedure's value along one classification facet." .

# === Class: ProcedureLensViews ===
pko-extension:ProcedureLensView a owl:Class ;
    rdfs:seeAlso <https://schema.org/HowTo> ;
    rdfs:label "ProcedureLensViews" ;
    rdfs:comment "A view of one procedure for one stakeholder lens, projected from a procedure version." .

# === Class: ProcedureOutcomeCriteria ===
pko-extension:OutcomeCriterion a owl:Class ;
    rdfs:label "ProcedureOutcomeCriteria" ;
    rdfs:comment "Criteria by which a procedure's outcome counts as success or failure." .

# === Class: ProcedureResources ===
pko-native-procedural-knowledge-rulebook:ProcedureResources a owl:Class ;
    rdfs:label "ProcedureResources" ;
    rdfs:comment "Links versioned procedures to supporting resources using PKO/dcterms provenance relations." .

# === Class: ProcedureStatusChanges ===
pko:ChangeOfStatus a owl:Class .

# === Class: ProcedureTargets ===
pko:ProcedureTarget a owl:Class .

# === Class: ProcedureTypes ===
pko:ProcedureType a owl:Class .

# === Class: ProcedureVersionLinks ===
pko-native-procedural-knowledge-rulebook:ProcedureVersionLinks a owl:Class ;
    rdfs:label "ProcedureVersionLinks" ;
    rdfs:comment "Directed links between versioned procedures. Maps to dcat:previousVersion/dcat:hasVersion and pko:nextVersion." .

# === Class: ProcedureVersions ===
pko-native-procedural-knowledge-rulebook:ProcedureVersions a owl:Class ;
    rdfs:subClassOf pko:Procedure ;
    rdfs:label "ProcedureVersions" ;
    rdfs:comment "Versioned procedure specifications. Maps to pko:Procedure plus DCAT version relations and PKO versionNumber/newVersionMotivation/changelogDescription." .

pko:Procedure a owl:Class .

# === Class: Procedures ===
pko-native-procedural-knowledge-rulebook:Procedures a owl:Class ;
    rdfs:subClassOf pko:Procedure ;
    rdfs:seeAlso <http://schema.org/HowTo> ;
    rdfs:label "Procedures" ;
    rdfs:comment "Abstract, discoverable procedures. Each version is represented separately in ProcedureVersions. Maps to pko:Procedure and dcat:Resource." .

# === Class: ProcessDesignDecisions ===
pko-extension:ProcessDesignDecision a owl:Class ;
    rdfs:label "ProcessDesignDecisions" ;
    rdfs:comment "Design decisions behind a procedure's commitments, recorded alongside the procedure with their rationale." .

# === Class: ProcessInterdependencies ===
pko-extension:ProcessInterdependency a owl:Class ;
    rdfs:label "ProcessInterdependencies" ;
    rdfs:comment "How one operation helps, hinders or requires another." .

# === Class: ProcessKnowledgeLevels ===
pko-extension:ProcessKnowledgeLevel a owl:Class ;
    rdfs:label "ProcessKnowledgeLevels" ;
    rdfs:comment "The operational, tactical and strategic levels at which process knowledge is held." .

# === Class: ProcessLevelStatements ===
pko-extension:ProcessLevelStatement a owl:Class ;
    rdfs:label "ProcessLevelStatements" ;
    rdfs:comment "Statements about a procedure, filed at a level of the planning pyramid." .

# === Class: ProcessMiningRuns ===
pko-extension:ProcessMiningRun a owl:Class ;
    rdfs:label "ProcessMiningRuns" ;
    rdfs:comment "One conformance-checking run of a mined event log against a documented procedure version — a third kind of evidence, distinct from an elicitation session (someone's account) or a knowledge fragment (a claim): what the system of record actually did, discovered by process mining rather than told to us." .

# === Class: ProcessOutcomeMeasures ===
pko-extension:ProcessOutcomeMeasure a owl:Class ;
    rdfs:label "ProcessOutcomeMeasures" ;
    rdfs:comment "Measured outcomes of a procedure, and the business outcome each links to." .

# === Class: ProcessStages ===
pko-extension:ProcessStage a owl:Class ;
    rdfs:seeAlso <http://purl.org/net/p-plan#MultiStep> ;
    rdfs:label "ProcessStages" ;
    rdfs:comment "Stages that group a procedure version's steps, each with an owning role." .

# === Class: ProcessStrategicAlignments ===
pko-extension:ProcessStrategicAlignment a owl:Class ;
    rdfs:label "ProcessStrategicAlignments" ;
    rdfs:comment "Strategic knowledge: why a procedure exists, the mission it serves, the value it creates and the trade-offs it makes." .

# === Class: PromptTemplates ===
pko-extension:PromptTemplate a owl:Class ;
    rdfs:label "PromptTemplates" ;
    rdfs:comment "Prompts and system instructions that carry process knowledge to AI, layered and kept in a library." .

# === Class: ProtectiveEquipment ===
pko-industry:PersonalProtectiveEquipment a owl:Class .

# === Class: ProviderEngagements ===
pko-extension:ProviderEngagement a owl:Class ;
    rdfs:label "ProviderEngagements" ;
    rdfs:comment "A client's relationship with a provider for one function, with the knowledge terms it carries." .

# === Class: QualityAssessments ===
pko-extension:QualityAssessment a owl:Class ;
    rdfs:label "QualityAssessments" ;
    rdfs:comment "A release scored against one quality criterion." .

# === Class: QualityCriteria ===
pko-extension:QualityCriterion a owl:Class ;
    rdfs:label "QualityCriteria" ;
    rdfs:comment "Stated quality criteria an ontology release is scored against." .

# === Class: Rationales ===
pko-extension:Rationale a owl:Class ;
    rdfs:label "Rationales" ;
    rdfs:comment "First-class rationale statements explaining why procedural commitments and design decisions exist. Explicit ERB-PKO extension, represented as prov:Entity/dcat:Resource in projections." .

# === Class: ReasonerRuns ===
pko-extension:ReasonerRun a owl:Class ;
    rdfs:label "ReasonerRuns" ;
    rdfs:comment "One reasoner run over a grounding snapshot: consistency, materialization, budget and dropped axioms." .

# === Class: Recipients ===
pko-extension:Recipient a owl:Class ;
    rdfs:label "Recipients" ;
    rdfs:comment "Recipients (added by witness loop 1)." .

# === Class: RecordsRetentionPolicies ===
pko-extension:RecordsRetentionPolicy a owl:Class ;
    rdfs:label "RecordsRetentionPolicies" ;
    rdfs:comment "Retention rules for classes of records, with what drives the retention period." .

# === Class: RegulatoryFrameworks ===
pko-extension:RegulatoryFramework a owl:Class ;
    rdfs:label "RegulatoryFrameworks" ;
    rdfs:comment "Regulatory frameworks that require procedures or controls (industry module)." .

# === Class: RelationTypes ===
pko-extension:RelationType a owl:Class ;
    rdfs:label "RelationTypes" ;
    rdfs:comment "The defined relationship types process elements may be linked by." .

# === Class: RepertoryGridConstructs ===
pko-extension:RepertoryGridConstruct a owl:Class ;
    rdfs:label "RepertoryGridConstructs" ;
    rdfs:comment "Constructs elicited with a repertory grid: the bipolar dimensions an expert uses to tell compared situations apart." .

# === Class: RepresentationReviews ===
pko-extension:RepresentationReview a owl:Class ;
    rdfs:label "RepresentationReviews" ;
    rdfs:comment "Expert reviews of a procedure version: approval of the process representation itself, or evaluation of AI output built on it, with whether the reviewer is a subject matter expert whose work the procedure affects." .

# === Class: RequirementSatisfactions ===
pko:RequirementSatisfaction a owl:Class .

# === Class: Requirements ===
pko:Requirement a owl:Class .

# === Class: Resources ===
pko-native-procedural-knowledge-rulebook:Resources a owl:Class ;
    rdfs:subClassOf dcat:Resource ;
    rdfs:subClassOf pko:Resource ;
    rdfs:label "Resources" ;
    rdfs:comment "Documents, datasets, APIs, templates, images, manuals, and operational records referenced by procedures. Maps to dcat:Resource." .

dcat:Resource a owl:Class .

pko:Resource a owl:Class .

# === Class: RetrievalSegments ===
pko-extension:RetrievalSegment a owl:Class ;
    rdfs:label "RetrievalSegments" ;
    rdfs:comment "Retrieval segments of process knowledge, with their boundary, position, applicability and links." .

# === Class: ReviewEvents ===
pko:ReviewEvent a owl:Class .

# === Class: RoleAssignmentUpdateTasks ===
pko-extension:RoleAssignmentUpdateTask a owl:Class ;
    rdfs:label "RoleAssignmentUpdateTasks" ;
    rdfs:comment "The audit record of one change to who fills a role: what triggered it, who triggered it, when it was completed, and the run that depended on it." .

# === Class: RoleAssignments ===
pro:RoleInTime a owl:Class .

# === Class: RoleCapabilityTags ===
pko-extension:RoleCapabilityTag a owl:Class ;
    rdfs:label "RoleCapabilityTags" ;
    rdfs:comment "Capability tags a role carries, drawn from a controlled capability scheme." .

# === Class: RoleQuestions ===
pko-extension:RoleQuestion a owl:Class ;
    rdfs:label "RoleQuestions" ;
    rdfs:comment "One row per question a named role wants answered. Every invented predicate in this rulebook traces back to one of these." .

# === Class: RoleSchemaViews ===
pko-extension:RoleSchemaView a owl:Class ;
    rdfs:label "RoleSchemaViews" ;
    rdfs:comment "The emitted views: one per principal x table. ColumnList is DERIVED from FieldGrants, so toggling a single grant changes the emitted DDL with no second edit anywhere. This is what makes an admin's save reshape the database without touching UI code." .

# === Class: RoleSchemas ===
pko-extension:RoleSchema a owl:Class ;
    rdfs:label "RoleSchemas" ;
    rdfs:comment "One Postgres schema per principal -- the principal's entire visible world. The schema is the only entry on that principal's search_path, so a table absent from it cannot be named at all." .

# === Class: Roles ===
pro:Role a owl:Class .

# === Class: RulebookFields ===
pko-extension:RulebookField a owl:Class ;
    rdfs:label "RulebookFields" ;
    rdfs:comment "A complete census of every field in this rulebook. Reconciled from the real schemas by tools/reconcile_field_catalog.py — never hand-maintained. Fields invented by a witness loop carry an InventedForQuestion FK." .

# === Class: RulebookReleases ===
pko-native-procedural-knowledge-rulebook:RulebookReleases a owl:Class ;
    rdfs:label "RulebookReleases" ;
    rdfs:comment "Version ledger for the canonical ERB-PKO rulebook itself. This is distinct from PKO Procedure versioning." .

# === Class: RulebookTables ===
pko-extension:RulebookTable a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/2000/01/rdf-schema#Class> ;
    rdfs:label "RulebookTables" ;
    rdfs:comment "Census of every table in this rulebook. The table-level counterpart to RulebookFields, and the anchor every access policy points at. Derived by tools/reconcile_field_catalog.py -- never hand-maintained." .

# === Class: SchemeRefinements ===
pko-extension:SchemeRefinement a owl:Class ;
    rdfs:label "SchemeRefinements" ;
    rdfs:comment "A change to an organizing scheme made because collection showed how practitioners think about the work." .

# === Class: SemanticMappings ===
pko-native-procedural-knowledge-rulebook:SemanticMappings a owl:Class ;
    rdfs:label "SemanticMappings" ;
    rdfs:comment "Machine-readable alignment from ERB table/field paths to exact PKO or reused ontology terms. Extension mappings are never presented as native PKO." .

# === Class: SendIntents ===
pko-extension:SendIntent a owl:Class ;
    rdfs:label "SendIntents" ;
    rdfs:comment "SendIntents (added by witness loop 1)." .

# === Class: SharingRecognitions ===
pko-extension:SharingRecognition a owl:Class ;
    rdfs:label "SharingRecognitions" ;
    rdfs:comment "Incentives and credit an organization gives people for sharing process knowledge." .

# === Class: SituationalVariants ===
pko-extension:SituationalVariant a owl:Class ;
    rdfs:label "SituationalVariants" ;
    rdfs:comment "How experts adapt a standard procedure to the situation in front of them." .

# === Class: SnapshotAssertions ===
pko-native-procedural-knowledge-rulebook:SnapshotAssertions a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement> ;
    rdfs:label "SnapshotAssertions" ;
    rdfs:comment "One typed assertion served to retrieval in a snapshot, with its provenance and Dublin Core labels." .

# === Class: SourceArticles ===
pko-extension:SourceArticle a owl:Class ;
    rdfs:label "SourceArticles" ;
    rdfs:comment "The articles this rulebook was bootstrapped from. Coverage of each is computed from its claims; the article text itself is never stored." .

# === Class: SourceRelationships ===
pko-extension:SourceRelationship a owl:Class ;
    rdfs:label "SourceRelationships" ;
    rdfs:comment "The standing relationship between a knowledge engineer and a knowledge source on one procedure: the power dynamic, what was negotiated, the state of trust, and what the source withholds and why." .

# === Class: SourceTermMentions ===
pko-extension:SourceTermMention a owl:Class ;
    rdfs:label "SourceTermMentions" ;
    rdfs:comment "A wording found in collected material or produced by an AI run, and the concept a knowledge engineer judged it to mean." .

# === Class: SourcingFunctions ===
pko-extension:SourcingFunction a owl:Class ;
    rdfs:label "SourcingFunctions" ;
    rdfs:comment "Business functions an organization classifies as retained core or sends out for execution, with who executes them and who holds the knowledge of what is built and of how it is built." .

# === Class: StakeholderLenses ===
pko-extension:StakeholderLens a owl:Class ;
    rdfs:seeAlso <https://schema.org/serviceAudience> ;
    rdfs:label "StakeholderLenses" ;
    rdfs:comment "The perspectives from which one procedure is read, what each needs, and at what granularity and form." .

# === Class: StakeholderPerspectives ===
pko-extension:StakeholderPerspective a owl:Class ;
    rdfs:label "StakeholderPerspectives" ;
    rdfs:comment "One stakeholder's view of how a step should be performed, kept with the collected material it comes from and the perspective it conflicts with, rather than merged into a single agreed version." .

# === Class: StakeholderQuestions ===
pko-extension:StakeholderQuestion a owl:Class ;
    rdfs:label "StakeholderQuestions" ;
    rdfs:comment "Questions users and stakeholders bring to a model through its issue channel, whether the model answers them, and how the unanswerable ones were triaged." .

# === Class: StalenessQueryRuns ===
pko-extension:StalenessQueryRun a owl:Class ;
    rdfs:label "StalenessQueryRuns" ;
    rdfs:comment "Periodic runs of the staleness query over workflow last-modified dates, and whether the results reached the steward." .

# === Class: StepActions ===
pko-native-procedural-knowledge-rulebook:StepActions a owl:Class ;
    rdfs:label "StepActions" ;
    rdfs:comment "Many-to-many Step/Action semantics normalized into a first-class ERB junction table." .

# === Class: StepConditions ===
pko-extension:StepCondition a owl:Class ;
    rdfs:label "StepConditions" ;
    rdfs:comment "Pre-conditions, post-conditions and invariants of a step." .

# === Class: StepContextSensitivities ===
pko-extension:StepContextSensitivity a owl:Class ;
    rdfs:label "StepContextSensitivities" ;
    rdfs:comment "How a step's significance changes with the performer, the resources on hand or outside circumstances." .

# === Class: StepCues ===
pko-extension:StepCue a owl:Class ;
    rdfs:label "StepCues" ;
    rdfs:comment "Indicators, sounds and confirmations a practitioner reads during a step; some are danger cues." .

# === Class: StepExecutions ===
pko:StepExecution a owl:Class .

# === Class: StepFunctions ===
pko-native-procedural-knowledge-rulebook:StepFunctions a owl:Class ;
    rdfs:label "StepFunctions" ;
    rdfs:comment "Many-to-many Step/Function semantics normalized into an ERB junction table." .

# === Class: StepLockRequirements ===
pko-extension:StepLockRequirement a owl:Class ;
    rdfs:label "StepLockRequirements" ;
    rdfs:comment "Locks a step requires (pko-ind:requiresLock)." .

# === Class: StepProtectiveEquipment ===
pko-extension:StepProtectiveEquipment a owl:Class ;
    rdfs:label "StepProtectiveEquipment" ;
    rdfs:comment "Protective equipment a step requires (pko-ind:requiresPPE)." .

# === Class: StepRequirements ===
pko-native-procedural-knowledge-rulebook:StepRequirements a owl:Class ;
    rdfs:label "StepRequirements" ;
    rdfs:comment "Many-to-many Step/Requirement semantics normalized into an ERB junction table." .

# === Class: StepResources ===
pko-extension:StepResource a owl:Class ;
    rdfs:seeAlso <http://purl.org/dc/terms/references> ;
    rdfs:label "StepResources" ;
    rdfs:comment "Resources a step relies on (dct:references)." .

# === Class: StepTools ===
pko-native-procedural-knowledge-rulebook:StepTools a owl:Class ;
    rdfs:label "StepTools" ;
    rdfs:comment "Many-to-many Step/Tool semantics normalized into an ERB junction table." .

# === Class: StepTransitions ===
pko:Transition a owl:Class ;
    rdfs:seeAlso <http://www.omg.org/spec/BPMN/20100524/MODEL#SequenceFlow> .

# === Class: StepVariables ===
pko-native-procedural-knowledge-rulebook:StepVariables a owl:Class ;
    rdfs:seeAlso <http://purl.org/net/p-plan#Variable> ;
    rdfs:label "StepVariables" ;
    rdfs:comment "Input and output variables a step declares (pplan:Variable, pplan:hasInputVar / hasOutputVar)." .

# === Class: StepVerifications ===
pko-native-procedural-knowledge-rulebook:StepVerifications a owl:Class ;
    rdfs:subClassOf pko:StepVerification ;
    rdfs:subClassOf pko:SignalVerification ;
    rdfs:label "StepVerifications" ;
    rdfs:comment "Verification definitions attached to steps. Maps to pko:StepVerification and pko:SignalVerification." .

pko:StepVerification a owl:Class .

pko:SignalVerification a owl:Class .

# === Class: Steps ===
p-plan:Step a owl:Class ;
    rdfs:seeAlso <http://www.omg.org/spec/BPMN/20100524/MODEL#Task> ;
    rdfs:seeAlso <http://www.w3.org/2002/07/owl#Class> ;
    rdfs:seeAlso <https://schema.org/HowToStep> .

# === Class: StewardActivities ===
pko-extension:StewardActivity a owl:Class ;
    rdfs:label "StewardActivities" ;
    rdfs:comment "Recorded steward duties: drift watches, dependency tracking, documentation and validation-suite upkeep." .

# === Class: StewardshipAssignments ===
pko-extension:StewardshipAssignment a owl:Class ;
    rdfs:label "StewardshipAssignments" ;
    rdfs:comment "Separates ongoing stewardship from authority to approve semantic commitments. Explicit ERB-PKO governance extension." .

# === Class: SubstrateRunScores ===
pko-extension:SubstrateRunScore a owl:Class ;
    rdfs:label "SubstrateRunScores" ;
    rdfs:comment "One substrate's grade in one conformance run, split by field class so a substrate that does scalar math natively but not cross-table joins reads as exactly that." .

# === Class: TableConformance ===
pko-extension:TableConformance a owl:Class ;
    rdfs:label "TableConformance" ;
    rdfs:comment "Latest run only: how one substrate did on one table. The grid of these rows is the substrate-by-table heatmap." .

# === Class: TacticalResourceAllocations ===
pko-extension:TacticalResourceAllocation a owl:Class ;
    rdfs:label "TacticalResourceAllocations" ;
    rdfs:comment "Tactical knowledge: resources allocated to a step, the demand on them, and the adjustment decided." .

# === Class: TemplateApprovals ===
pko-extension:TemplateApproval a owl:Class ;
    rdfs:label "TemplateApprovals" ;
    rdfs:comment "TemplateApprovals (added by witness loop 1)." .

# === Class: TermDefinitions ===
pko-extension:TermDefinition a owl:Class ;
    rdfs:label "TermDefinitions" ;
    rdfs:comment "Class definitions: what a class includes, excludes, and where it sits among neighboring terms, with who drafted and revised them." .

# === Class: TermLabelVariants ===
pko-native-procedural-knowledge-rulebook:TermLabelVariants a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/2008/05/skos-xl#Label> ;
    rdfs:label "TermLabelVariants" ;
    rdfs:comment "Preferred and alternative labels of a controlled concept, one row per wording, so variant wordings can be matched." .

# === Class: TermMeaningChanges ===
pko-extension:TermMeaningChange a owl:Class ;
    rdfs:label "TermMeaningChanges" ;
    rdfs:comment "A change in what the organization means by a controlled term." .

# === Class: TermRelations ===
pko-extension:TermRelation a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/2004/02/skos/core#related> ;
    rdfs:label "TermRelations" ;
    rdfs:comment "SKOS semantic relations between concepts beyond the primary broader link: associative (related) and additional broader links." .

# === Class: TestCases ===
pko-extension:TestCase a owl:Class ;
    rdfs:label "TestCases" ;
    rdfs:comment "The conformance suite, as data. One row per check, naming what it checks and — where applicable — the role question whose answer it defends. tools/run_test_suite.py executes these rows and writes the outcome back; it invents no checks of its own." .

# === Class: TestSuites ===
pko-extension:TestSuite a owl:Class ;
    rdfs:label "TestSuites" ;
    rdfs:comment "Groups of conformance checks. Rollups here are computed from TestCases, so the board's headline is itself a derived field." .

# === Class: Tools ===
nfdi4ing-metadata4ing:Tool a owl:Class .

# === Class: UserFeedback ===
pko:UserFeedbackOccurrence a owl:Class .

# === Class: UserQuestions ===
pko:UserQuestionOccurrence a owl:Class .

# === Class: VerificationOutcomes ===
pko-extension:VerificationOutcome a owl:Class ;
    rdfs:label "VerificationOutcomes" ;
    rdfs:comment "VerificationOutcomes (added by witness loop 1)." .

# === Class: Vocabularies ===
pko-extension:Vocabulary a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
    rdfs:label "Vocabularies" ;
    rdfs:comment "A controlled vocabulary / SKOS-style concept scheme — one facet of standardized terminology (e.g. a family of control categories) that Requirements and other rows can point at instead of restating the concept in free text each time." .

# === Class: VocabularyTerms ===
pko-extension:VocabularyTerm a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/2004/02/skos/core#Concept> ;
    rdfs:label "VocabularyTerms" ;
    rdfs:comment "One controlled, defined term (a SKOS Concept) within a Vocabulary. Requirements point at a VocabularyTerm instead of free-texting the same concept in a new Statement every time." .

# === Class: WitnessLoops ===
pko-extension:WitnessLoop a owl:Class ;
    rdfs:label "WitnessLoops" ;
    rdfs:comment "One row per role-question expansion loop. Each loop poses questions that only became askable because of the previous loop's predicates." .

# === Class: WorkflowViewDivergences ===
pko-extension:WorkflowViewDivergence a owl:Class ;
    rdfs:label "WorkflowViewDivergences" ;
    rdfs:comment "Differing views of how work flows, brought into the open in an elicitation session, and the reconciled account when one was reached." .

pko-extension:validatedBy a owl:ObjectProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:KnowledgeTraces ;
    rdfs:range prov:Agent ;
    rdfs:label "ValidatedByAgent" ;
    rdfs:comment "Who confirmed the derived knowledge." .

pko-industry:hasMachineType a owl:ObjectProperty .

pko-industry:hasSite a owl:ObjectProperty .

pko-industry:isExecutedOnMachine a owl:ObjectProperty .

pko-industry:wasManufacturedBy a owl:ObjectProperty .

pko-native-procedural-knowledge-rulebook:abandonedFailureCount a owl:DatatypeProperty ;
    rdfs:domain pko:ProcedureExecution ;
    rdfs:range xsd:decimal ;
    rdfs:label "AbandonedFailureCount" ;
    rdfs:comment "Number of failed deliveries in this run that nobody picked up." .

pko-native-procedural-knowledge-rulebook:abandonedFailureExecutionKey a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:string ;
    rdfs:label "AbandonedFailureExecutionKey" ;
    rdfs:comment "Carries the execution id on abandoned failures; empty string otherwise." .

pko-native-procedural-knowledge-rulebook:aboutAgent a owl:ObjectProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    rdfs:range prov:Agent ;
    rdfs:label "AboutAgent" ;
    rdfs:comment "Agent the assertion is about, for accountability and category assertions." .

pko-native-procedural-knowledge-rulebook:abundantKnowledgeGapId a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AbundantKnowledgeGap ;
    rdfs:range xsd:string ;
    rdfs:label "AbundantKnowledgeGapId" ;
    rdfs:comment "Readable key for the kind of knowledge." .

pko-native-procedural-knowledge-rulebook:accentColor a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AppRoleProfile ;
    rdfs:range xsd:string ;
    rdfs:label "AccentColor" ;
    rdfs:comment "Hex accent colour. Distinctive per role; used for chrome, the left-nav active state, and the icon plate." .

pko-native-procedural-knowledge-rulebook:acceptanceFailureTotal a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:integer ;
    rdfs:label "AcceptanceFailureTotal" ;
    rdfs:comment "Failures in acceptance runs of the full suite with the change applied." .

pko-native-procedural-knowledge-rulebook:acceptedWithFailingSuite a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "AcceptedWithFailingSuite" ;
    rdfs:comment "TRUE when a change was accepted although the full suite failed with it applied." .

pko-native-procedural-knowledge-rulebook:acceptedWithoutStructuralCheck a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "AcceptedWithoutStructuralCheck" ;
    rdfs:comment "TRUE when a modeling change was accepted with no passing automated structural consistency check." .

pko-native-procedural-knowledge-rulebook:acceptedWithoutTestRun a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "AcceptedWithoutTestRun" ;
    rdfs:comment "TRUE when a modeling change was accepted without ever running the validation suite with it applied." .

pko-native-procedural-knowledge-rulebook:acceptedWithoutVocabularyCheck a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "AcceptedWithoutVocabularyCheck" ;
    rdfs:comment "TRUE when a modeling change was accepted with no passing automated check that it uses only approved vocabulary." .

pko-native-procedural-knowledge-rulebook:accessDenialTestId a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AccessDenialTest ;
    rdfs:range xsd:string ;
    rdfs:label "AccessDenialTestId" ;
    rdfs:comment "Stored logical identifier, e.g. 'deny-analyst-other-org-procedures'." .

pko-native-procedural-knowledge-rulebook:accessMode a owl:DatatypeProperty ;
    rdfs:domain pko-extension:OperationalBinding ;
    rdfs:range xsd:string ;
    rdfs:label "AccessMode" ;
    rdfs:comment "Read, Write, ReadWrite, Subscribe, or Publish." .

pko-native-procedural-knowledge-rulebook:accessPolicyId a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AccessPolicy ;
    rdfs:range xsd:string ;
    rdfs:label "AccessPolicyId" ;
    rdfs:comment "Stored logical identifier, e.g. 'pol-controller-procedures-select'." .

pko-native-procedural-knowledge-rulebook:accessPrincipalId a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AccessPrincipal ;
    rdfs:range xsd:string ;
    rdfs:label "AccessPrincipalId" ;
    rdfs:comment "Stored logical identifier, e.g. 'principal-controller'." .

pko-native-procedural-knowledge-rulebook:account a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CriticalIncident ;
    rdfs:range xsd:string ;
    rdfs:label "Account" ;
    rdfs:comment "The practitioner's account of the episode." .

pko-native-procedural-knowledge-rulebook:accountSummary a owl:DatatypeProperty ;
    rdfs:domain pko-extension:DepartmentProcessAccount ;
    rdfs:range xsd:string ;
    rdfs:label "AccountSummary" ;
    rdfs:comment "The department's account of the process." .

pko-native-procedural-knowledge-rulebook:accountabilityAssertionCount a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:integer ;
    rdfs:label "AccountabilityAssertionCount" ;
    rdfs:comment "Served, explicitly stated assertions about this agent." .

pko-native-procedural-knowledge-rulebook:accountableAgent a owl:ObjectProperty ;
    rdfs:range prov:Agent ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#actedOnBehalfOf> ;
    rdfs:label "AccountableAgent" .

pko-native-procedural-knowledge-rulebook:accountableAgentKind a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AiAgentAccountability ;
    rdfs:range xsd:string ;
    rdfs:label "AccountableAgentKind" ;
    rdfs:comment "Kind of the accountable agent." .

pko-native-procedural-knowledge-rulebook:accountableRole a owl:ObjectProperty ;
    rdfs:range pro:Role ;
    rdfs:label "AccountableRole" .

pko-native-procedural-knowledge-rulebook:accuracyLiftPoints a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AssistantBenchmark ;
    rdfs:range xsd:decimal ;
    rdfs:label "AccuracyLiftPoints" ;
    rdfs:comment "Accuracy points gained by grounding." .

pko-native-procedural-knowledge-rulebook:acknowledgedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AcknowledgedAt" .

pko-native-procedural-knowledge-rulebook:acknowledgementIsOutstanding a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "AcknowledgementIsOutstanding" ;
    rdfs:comment "TRUE when a message actually reached someone, carried an acknowledgement obligation, and has not been acknowledged." .

pko-native-procedural-knowledge-rulebook:acronym a owl:DatatypeProperty ;
    rdfs:domain pko-extension:OntologySupportProgramme ;
    rdfs:range xsd:string ;
    rdfs:label "Acronym" ;
    rdfs:comment "Programme acronym." .

pko-native-procedural-knowledge-rulebook:actedOnWithoutHumanJudgment a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AssistantAnswer ;
    rdfs:range xsd:boolean ;
    rdfs:label "ActedOnWithoutHumanJudgment" ;
    rdfs:comment "TRUE when an AI recommendation on a step that requires human judgment was acted on with no expert review." .

pko-native-procedural-knowledge-rulebook:actedWithoutDeclaredContext a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AiToolInvocation ;
    rdfs:range xsd:boolean ;
    rdfs:label "ActedWithoutDeclaredContext" ;
    rdfs:comment "TRUE when the agent acted with fewer of the step's declared inputs than the step needs." .

pko-native-procedural-knowledge-rulebook:action a owl:ObjectProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:StepActions ;
    rdfs:range pko:Action ;
    rdfs:label "Action" ;
    rdfs:comment "Action side of the relationship." .

pko-native-procedural-knowledge-rulebook:actionDescription a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ObservedAction ;
    rdfs:range xsd:string ;
    rdfs:label "ActionDescription" ;
    rdfs:comment "What the observer saw." .

pko-native-procedural-knowledge-rulebook:actionId a owl:DatatypeProperty ;
    rdfs:domain pko:Action ;
    rdfs:range xsd:string ;
    rdfs:label "ActionId" ;
    rdfs:comment "Stored logical identifier for one Actions row." .

pko-native-procedural-knowledge-rulebook:actionKind a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ObservedAction ;
    rdfs:range xsd:string ;
    rdfs:label "ActionKind" ;
    rdfs:comment "SmallChoice, Workaround, OmittedObviousStep or DocumentedStep." .

pko-native-procedural-knowledge-rulebook:activeAssignmentCount a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:decimal ;
    rdfs:label "ActiveAssignmentCount" ;
    rdfs:comment "Total number of assignment rows ever recorded against this role." .

pko-native-procedural-knowledge-rulebook:activeExceptionStepKey a owl:DatatypeProperty ;
    rdfs:domain pko-extension:Exception ;
    rdfs:range xsd:string ;
    rdfs:label "ActiveExceptionStepKey" ;
    rdfs:comment "Echoes the TriggerStep id only for exceptions currently in Active status." .

pko-native-procedural-knowledge-rulebook:activeRelianceBrokerKey a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeBrokerLink ;
    rdfs:range xsd:string ;
    rdfs:label "ActiveRelianceBrokerKey" ;
    rdfs:comment "Composite-key echo: the broker this link names when the reliance is active, else blank." .

pko-native-procedural-knowledge-rulebook:activity a owl:DatatypeProperty ;
    rdfs:domain pko-extension:EncodingLifecycleStage ;
    rdfs:range xsd:string ;
    rdfs:label "Activity" ;
    rdfs:comment "What happens to knowledge at this stage." .

pko-native-procedural-knowledge-rulebook:activityKind a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:LearningActivities ;
    rdfs:range xsd:string ;
    rdfs:label "ActivityKind" ;
    rdfs:comment "Retrospective, TabletopExercise, Onboarding, Drill, or Apprenticeship." .

pko-native-procedural-knowledge-rulebook:activityModel a owl:DatatypeProperty ;
    rdfs:domain pko-extension:StewardActivity ;
    rdfs:range xsd:string ;
    rdfs:label "ActivityModel" ;
    rdfs:comment "Model the charter governs." .

pko-native-procedural-knowledge-rulebook:activityOriginTraceCount a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:integer ;
    rdfs:label "ActivityOriginTraceCount" ;
    rdfs:comment "Origin traces of this step as an activity definition." .

pko-native-procedural-knowledge-rulebook:activityRelationId a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ActivityRelation ;
    rdfs:range xsd:string ;
