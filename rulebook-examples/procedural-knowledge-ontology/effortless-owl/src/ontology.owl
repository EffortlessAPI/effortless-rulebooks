    rdfs:label "Description" ;
    rdfs:comment "Execution description (dct:description)." .

effortless-ntwf:confirmedByAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ConfirmedByAgent" ;
    rdfs:comment "Who confirmed the execution (pko:wasConfirmedBy)." .

effortless-ntwf:facility a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Facilities ;
    rdfs:label "Facility" ;
    rdfs:comment "Where it ran." .

effortless-ntwf:shift a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "Shift" ;
    rdfs:comment "Day or Night, where the work runs in shifts." .

effortless-ntwf:executedOnMachine a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range effortless-ntwf:Machines ;
    rdfs:label "ExecutedOnMachine" ;
    rdfs:comment "Machine the procedure was executed on (pko-ind:isExecutedOnMachine)." .

effortless-ntwf:observations a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "Observations" ;
    rdfs:comment "What the executor noticed." .

effortless-ntwf:outcome a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Outcome" ;
    rdfs:comment "How it turned out." .

effortless-ntwf:participantCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:integer ;
    rdfs:label "ParticipantCount" ;
    rdfs:comment "Associated agents besides the executor." .
