pko-native-procedural-knowledge-rulebook:isHinderingDependency a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcessInterdependency ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHinderingDependency" ;
    rdfs:comment "TRUE when one operation works against another." .

pko-native-procedural-knowledge-rulebook:isHolderLeavingSoon a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHolderLeavingSoon" ;
