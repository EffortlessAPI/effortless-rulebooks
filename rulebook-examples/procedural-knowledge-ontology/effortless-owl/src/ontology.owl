effortless-ntwf:isOpenPracticeMismatch a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DriftObservations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOpenPracticeMismatch" ;
