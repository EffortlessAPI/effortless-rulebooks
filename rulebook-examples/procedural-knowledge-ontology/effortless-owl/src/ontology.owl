    rdfs:domain effortless-ntwf:AppActionFields ;
    rdfs:range xsd:string ;
    rdfs:label "FieldLabel" ;
    rdfs:comment "The label shown beside the input." .

effortless-ntwf:inputKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActionFields ;
    rdfs:range xsd:string ;
    rdfs:label "InputKind" ;
    rdfs:comment "text, longtext, note (a long text that may be left empty), choice, toggle, date, fixed, or server." .

effortless-ntwf:fixedValue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActionFields ;
    rdfs:range xsd:string ;
    rdfs:label "FixedValue" ;
    rdfs:comment "For fixed: the value. For server: what is stamped (agent, instant, id, iri)." .

effortless-ntwf:choicesFrom a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActionFields ;
    rdfs:range xsd:string ;
    rdfs:label "ChoicesFrom" ;
    rdfs:comment "For choice: the table whose rows are offered." .

effortless-ntwf:sortOrder a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "SortOrder" ;
    rdfs:comment "Position in the form." .

effortless-ntwf:targetFieldType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActionFields ;
    rdfs:range xsd:string ;
    rdfs:label "TargetFieldType" ;
    rdfs:comment "raw, relationship, calculated, lookup or aggregation." .
    # calculated: lookup

effortless-ntwf:writesDerivedField a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActionFields ;
    rdfs:range xsd:boolean ;
    rdfs:label "WritesDerivedField" ;
    rdfs:comment "The action tries to write a value the model works out for itself. That is never allowed." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension IRI." .

# === Class: AppActions ===
effortless-ntwf:AppActions a owl:Class ;
    rdfs:label "AppActions" ;
    rdfs:comment "One row per thing a role may DO in the app: the base table it writes, the operation, the access policy that permits it, and the derived value the page highlights afterwards. The app has no per-action endpoint; it executes these rows." .

effortless-ntwf:appActionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActions ;
    rdfs:range xsd:string ;
    rdfs:label "AppActionId" ;
    rdfs:comment "Stable key, e.g. act-tech-start-lockout." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "The button's words." .

effortless-ntwf:owningRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "OwningRole" ;
    rdfs:comment "The role that performs this action." .

effortless-ntwf:routePath a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RoutePath" ;
    rdfs:comment "The app route the action appears on." .

effortless-ntwf:targetTable a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RulebookTables ;
    rdfs:label "TargetTable" ;
    rdfs:comment "The base table written." .

effortless-ntwf:operation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActions ;
    rdfs:range xsd:string ;
    rdfs:label "Operation" ;
    rdfs:comment "INSERT or UPDATE, spelled as the policy's Command is." .

effortless-ntwf:policy a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AppActions ;
    rdfs:range effortless-ntwf:AccessPolicies ;
    rdfs:label "Policy" ;
    rdfs:comment "The write policy that permits it. Blank means nothing permits it." .

effortless-ntwf:watchedField a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AppActions ;
    rdfs:range effortless-ntwf:RulebookFields ;
    rdfs:label "WatchedField" ;
    rdfs:comment "The derived value the page highlights after the write." .

effortless-ntwf:storyEpisode a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActions ;
    rdfs:range xsd:integer ;
    rdfs:label "StoryEpisode" ;
    rdfs:comment "The episode of the video series that performs this action on camera." .

effortless-ntwf:description a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Description" ;
    rdfs:comment "What the action means, in the role's words." .

effortless-ntwf:policyCommand a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActions ;
    rdfs:range xsd:string ;
    rdfs:label "PolicyCommand" ;
    rdfs:comment "The permitting policy's SQL command." .
    # calculated: lookup

effortless-ntwf:policyDenialTestCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActions ;
    rdfs:range xsd:integer ;
    rdfs:label "PolicyDenialTestCount" ;
    rdfs:comment "Denial tests that exercise the permitting policy." .
    # calculated: lookup

effortless-ntwf:watchedFieldIsWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActions ;
    rdfs:range xsd:boolean ;
    rdfs:label "WatchedFieldIsWitness" ;
    rdfs:comment "Whether the highlighted value is a boolean witness." .
    # calculated: lookup

effortless-ntwf:inputFieldCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActions ;
    rdfs:range xsd:integer ;
    rdfs:label "InputFieldCount" ;
    rdfs:comment "Fields this action writes." .
    # calculated: aggregation

effortless-ntwf:isUnpermitted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnpermitted" ;
    rdfs:comment "No access policy permits this action, so the database would refuse it." .
    # calculated: calculated

effortless-ntwf:policyCommandDisagrees a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActions ;
    rdfs:range xsd:boolean ;
    rdfs:label "PolicyCommandDisagrees" ;
    rdfs:comment "The permitting policy is for a different SQL command than the action performs." .
    # calculated: calculated

effortless-ntwf:isUnprovenWrite a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppActions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnprovenWrite" ;
    rdfs:comment "Permitted, but no denial test proves the policy refuses anyone else." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension IRI." .

# === Class: AppNavGroups ===
effortless-ntwf:AppNavGroups a owl:Class ;
    rdfs:label "AppNavGroups" ;
    rdfs:comment "The left-navigation section headers. A route names the group it appears under; the nav renders the groups its active role actually uses." .

effortless-ntwf:appNavGroupId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppNavGroups ;
    rdfs:range xsd:string ;
    rdfs:label "AppNavGroupId" ;
    rdfs:comment "Stored logical identifier for one AppNavGroups row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AppNavGroups row." .
    # calculated: calculated

effortless-ntwf:groupLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppNavGroups ;
    rdfs:range xsd:string ;
    rdfs:label "GroupLabel" ;
    rdfs:comment "Section header text rendered in the left navigation." .

effortless-ntwf:routeCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RouteCount" ;
    rdfs:comment "How many routes sit under this nav group across all roles." .
    # calculated: aggregation

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI for this row. An extension: PKO does not model navigation." .

# === Class: AppRoleProfiles ===
effortless-ntwf:AppRoleProfiles a owl:Class ;
    rdfs:label "AppRoleProfiles" ;
    rdfs:comment "One row per role, carrying how that role is presented: its accent colour, its 128x128 icon, and the login-card copy. Presentation is data, so the app never hardcodes a colour or a label per role." .

effortless-ntwf:appRoleProfileId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "AppRoleProfileId" ;
    rdfs:comment "Stored logical identifier for one AppRoleProfiles row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AppRoleProfiles row." .
    # calculated: calculated

effortless-ntwf:role a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "Role" ;
    rdfs:comment "The role this presentation profile describes." .

effortless-ntwf:displayLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "DisplayLabel" ;
    rdfs:comment "Label shown on the login card and in the app chrome." .

effortless-ntwf:roleKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "RoleKind" ;
    rdfs:comment "human or software. Drives the login-card silhouette and the icon plate shape." .

effortless-ntwf:accentColor a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "AccentColor" ;
    rdfs:comment "Hex accent colour. Distinctive per role; used for chrome, the left-nav active state, and the icon plate." .

effortless-ntwf:iconMark a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "IconMark" ;
    rdfs:comment "Name of the geometric mark drawn on this role's icon. Colour is never the only signal — the mark discriminates in greyscale." .

effortless-ntwf:iconPngBase64 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "IconPngBase64" ;
    rdfs:comment "128x128 PNG icon for this role, base64-encoded, no data: prefix. Rendered on the login card and beside the role name throughout the app." .

effortless-ntwf:pitch a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "Pitch" ;
    rdfs:comment "One line of login-card copy: what this role opens the app to do, in that role's own terms." .

effortless-ntwf:sortOrder a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SortOrder" ;
    rdfs:comment "Display order on the login screen. Human roles first, then software roles." .

effortless-ntwf:routeCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RouteCount" ;
    rdfs:comment "How many routes this role has." .
    # calculated: aggregation

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI for this row. An extension: PKO does not model application presentation." .

effortless-ntwf:device a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "Device" ;
    rdfs:comment "The device this role's experience is designed for: phone or tablet." .

effortless-ntwf:homeRoute a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "HomeRoute" ;
    rdfs:comment "The route this role lands on after signing in." .

effortless-ntwf:homeTitle a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "HomeTitle" ;
    rdfs:comment "The title of that home page, as the role would say it." .

# === Class: AppRouteQuestions ===
effortless-ntwf:AppRouteQuestions a owl:Class ;
    rdfs:label "AppRouteQuestions" ;
    rdfs:comment "Junction: which RoleQuestions each route helps answer. Deliberately many-to-many — a question is answered across several routes and a route serves several questions. It is not, and should not become, 1:1." .

effortless-ntwf:appRouteQuestionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRouteQuestions ;
    rdfs:range xsd:string ;
    rdfs:label "AppRouteQuestionId" ;
    rdfs:comment "Stored logical identifier for one AppRouteQuestions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AppRouteQuestions row." .
    # calculated: calculated

effortless-ntwf:route a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:AppRoutes ;
    rdfs:label "Route" ;
    rdfs:comment "The route that helps answer the question." .

effortless-ntwf:question a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RoleQuestions ;
    rdfs:label "Question" ;
    rdfs:comment "The role question this route helps answer." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI for this row. An extension." .

# === Class: AppRouteReferences ===
effortless-ntwf:AppRouteReferences a owl:Class ;
    rdfs:label "AppRouteReferences" ;
    rdfs:comment "Junction: which other routes a route links to. This is the navigation graph between screens, kept as rows rather than embedded lists so the canonical model stays a DAG." .

effortless-ntwf:appRouteReferenceId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRouteReferences ;
    rdfs:range xsd:string ;
    rdfs:label "AppRouteReferenceId" ;
    rdfs:comment "Stored logical identifier for one AppRouteReferences row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AppRouteReferences row." .
    # calculated: calculated

effortless-ntwf:fromRoute a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AppRouteReferences ;
    rdfs:range effortless-ntwf:AppRoutes ;
    rdfs:label "FromRoute" ;
    rdfs:comment "The route that links out." .

effortless-ntwf:toRoute a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AppRouteReferences ;
    rdfs:range effortless-ntwf:AppRoutes ;
    rdfs:label "ToRoute" ;
    rdfs:comment "The route being linked to." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI for this row. An extension." .

# === Class: AppRoutes ===
effortless-ntwf:AppRoutes a owl:Class ;
    rdfs:label "AppRoutes" ;
    rdfs:comment "One row per screen in the role-navigated application, as /{role}/{dashboard}/{entity...}. Each carries its purpose in the owning role's voice and brief layout hints, so a later build session has the brief without re-deriving it. Shared detail routes have no owning role." .

effortless-ntwf:appRouteId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "AppRouteId" ;
    rdfs:comment "Stored logical identifier for one AppRoutes row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AppRoutes row." .
    # calculated: calculated

effortless-ntwf:routePath a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RoutePath" ;
    rdfs:comment "The URL path, /{role}/{dashboard}/{entity...}. Shared detail routes live under /shared/ because the same entity serves every role." .

effortless-ntwf:routeName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "RouteName" ;
    rdfs:comment "Short label. This is the left-nav text." .

effortless-ntwf:surface a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "Surface" ;
    rdfs:comment "domain | maintainer. Domain routes belong to the twelve accountable Roles. Maintainer routes are the model's own instrumentation (Admin, Explorer) and deliberately have no owning role — 'admin' is not a role anyone is accountable in." .

effortless-ntwf:owningRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "OwningRole" ;
    rdfs:comment "The role whose navigation contains this route. Null for shared routes reachable from several roles." .

effortless-ntwf:navGroup a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range effortless-ntwf:AppNavGroups ;
    rdfs:label "NavGroup" ;
    rdfs:comment "Left-nav section this route appears under. Null for detail routes reached by drill-down rather than from the nav." .

effortless-ntwf:navOrder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "NavOrder" ;
    rdfs:comment "Sort order within the nav group." .

effortless-ntwf:routeKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "RouteKind" ;
    rdfs:comment "dashboard | workspace | detail | index | action. Detail routes carry path parameters and are not in the nav." .

effortless-ntwf:purpose a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Purpose" ;
    rdfs:comment "What the role does here, in that role's own voice. This is the brief for the build session." .

effortless-ntwf:layoutHints a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "LayoutHints" ;
    rdfs:comment "Brief layout direction: the shape of the screen, what leads, and what must not be collapsed or implied." .

effortless-ntwf:isInNav a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInNav" ;
    rdfs:comment "Whether this route appears in the left navigation. Detail routes do not." .
    # calculated: calculated

effortless-ntwf:isShared a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsShared" ;
    rdfs:comment "Whether this route is shared across domain roles rather than owned by one. A maintainer route is not shared — it belongs to a different surface entirely." .
    # calculated: calculated

effortless-ntwf:isMaintainer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMaintainer" ;
    rdfs:comment "Whether this route is model instrumentation rather than a domain workspace. Maintainer routes are reached from the login page's maintainer section, not from a role card." .
    # calculated: calculated

effortless-ntwf:questionCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "QuestionCount" ;
    rdfs:comment "How many role questions this route helps answer." .
    # calculated: aggregation

effortless-ntwf:referenceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "ReferenceCount" ;
    rdfs:comment "How many other routes this route links to." .
    # calculated: aggregation

effortless-ntwf:answersNoQuestion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:boolean ;
    rdfs:label "AnswersNoQuestion" ;
    rdfs:comment "A domain route owned by a role that answers no role question. Not automatically wrong, but it should be justified. Maintainer routes are excluded: they answer questions about the model itself, which are not RoleQuestions and must not be fabricated as such." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI for this row. An extension: PKO models procedures, not the applications that display them." .

# === Class: AppUsers ===
effortless-ntwf:AppUsers a owl:Class ;
    rdfs:label "AppUsers" ;
    rdfs:comment "Sign-in identities. One row per person or automation that can authenticate. EmailAddress is what a verified token asserts; everything else about the caller is resolved from here inside the database, never trusted from the token." .

effortless-ntwf:appUserId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range xsd:string ;
    rdfs:label "AppUserId" ;
    rdfs:comment "Stored logical identifier, e.g. 'user-maria-chen'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:emailAddress a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "EmailAddress" ;
    rdfs:comment "Verified email. The one claim magic-links vouches for, and the join key from a token back to this row." .

effortless-ntwf:displayName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DisplayName" ;
    rdfs:comment "Name shown in the console." .

effortless-ntwf:linkedAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "LinkedAgent" ;
    rdfs:comment "Domain agent this sign-in identity corresponds to." .

effortless-ntwf:isEnabled a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEnabled" ;
    rdfs:comment "False disables sign-in without deleting the identity or its history." .

effortless-ntwf:agentKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AgentKind" ;
    rdfs:comment "Whether the linked agent is Human, AIAgent or AutomatedPipeline." .
    # calculated: lookup

effortless-ntwf:organization a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Organization" ;
    rdfs:comment "Organization inherited from the linked agent; the tenancy claim baked into issued tokens." .
    # calculated: lookup

effortless-ntwf:assignmentCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AssignmentCount" ;
    rdfs:comment "Number of principals this user may act as." .
    # calculated: aggregation

effortless-ntwf:hasNoPrincipal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoPrincipal" ;
    rdfs:comment "True when the user may act as no principal at all, so a successfully verified token still grants nothing. Authentication without authorization." .
    # calculated: calculated

effortless-ntwf:holdsMultiplePrincipals a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range xsd:boolean ;
    rdfs:label "HoldsMultiplePrincipals" ;
    rdfs:comment "True when the user may act as more than one principal, so the principal cannot be inferred from the email alone and must be chosen explicitly at sign-in." .
    # calculated: calculated

effortless-ntwf:isNonHumanSignIn a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonHumanSignIn" ;
    rdfs:comment "True when a non-human agent has a sign-in identity. Pipelines and AI agents authenticate too, and their tokens are scoped exactly like a person's." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ApplicabilityScopes ===
effortless-ntwf:ApplicabilityScopes a owl:Class ;
    rdfs:label "ApplicabilityScopes" ;
    rdfs:comment "Where a piece of process knowledge applies: business unit, geography, customer segment, regulatory regime, conditions, and the named graph holding it." .

effortless-ntwf:applicabilityScopeId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ApplicabilityScopes ;
    rdfs:range xsd:string ;
    rdfs:label "ApplicabilityScopeId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Scope." .

effortless-ntwf:businessUnit a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ApplicabilityScopes ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "BusinessUnit" ;
    rdfs:comment "Business unit." .

effortless-ntwf:geography a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ApplicabilityScopes ;
    rdfs:range xsd:string ;
    rdfs:label "Geography" ;
    rdfs:comment "Geography (ISO region code)." .

effortless-ntwf:customerSegment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ApplicabilityScopes ;
    rdfs:range xsd:string ;
    rdfs:label "CustomerSegment" ;
    rdfs:comment "Customer segment." .

effortless-ntwf:regulatoryRegime a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ApplicabilityScopes ;
    rdfs:range effortless-ntwf:RegulatoryFrameworks ;
    rdfs:label "RegulatoryRegime" ;
    rdfs:comment "Regulatory regime." .

effortless-ntwf:appliesWhen a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ApplicabilityScopes ;
    rdfs:range xsd:string ;
    rdfs:label "AppliesWhen" ;
    rdfs:comment "Condition under which the knowledge holds." .

effortless-ntwf:exclusionCondition a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ApplicabilityScopes ;
    rdfs:range xsd:string ;
    rdfs:label "ExclusionCondition" ;
    rdfs:comment "Scoping annotation: where the knowledge stops applying." .

effortless-ntwf:namedGraphIri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ApplicabilityScopes ;
    rdfs:range xsd:string ;
    rdfs:label "NamedGraphIri" ;
    rdfs:comment "Named graph that holds the knowledge scoped here." .

effortless-ntwf:dimensionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ApplicabilityScopes ;
    rdfs:range xsd:integer ;
    rdfs:label "DimensionCount" ;
    rdfs:comment "Context dimensions the scope names." .
    # calculated: calculated

effortless-ntwf:statesConditions a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ApplicabilityScopes ;
    rdfs:range xsd:boolean ;
    rdfs:label "StatesConditions" ;
    rdfs:comment "TRUE when the scope says when the knowledge applies or where it stops." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ArticleClaims ===
effortless-ntwf:ArticleClaims a owl:Class ;
    rdfs:label "ArticleClaims" ;
    rdfs:comment "One row per thing a source article says a process-knowledge system must represent, do, answer or use. Paraphrased with a section reference; never quoted." .

effortless-ntwf:articleClaimId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArticleClaims ;
    rdfs:range xsd:string ;
    rdfs:label "ArticleClaimId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:sourceArticle a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ArticleClaims ;
    rdfs:range effortless-ntwf:SourceArticles ;
    rdfs:label "SourceArticle" ;
    rdfs:comment "Article the claim comes from." .

effortless-ntwf:claimKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ClaimKind" ;
    rdfs:comment "Concept | Prescription | CompetencyQuestion | Standard | Scenario | Illustration." .

effortless-ntwf:sectionRef a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArticleClaims ;
    rdfs:range xsd:string ;
    rdfs:label "SectionRef" ;
    rdfs:comment "Section of the article where the claim is made." .

effortless-ntwf:claimText a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArticleClaims ;
    rdfs:range xsd:string ;
    rdfs:label "ClaimText" ;
    rdfs:comment "The claim, paraphrased." .

effortless-ntwf:requiredEvidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArticleClaims ;
    rdfs:range xsd:string ;
    rdfs:label "RequiredEvidence" ;
    rdfs:comment "The evidence this kind of claim demands, stated in words." .
    # calculated: calculated

effortless-ntwf:evidenceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArticleClaims ;
    rdfs:range xsd:integer ;
    rdfs:label "EvidenceCount" ;
    rdfs:comment "Evidence rows offered for this claim." .
    # calculated: aggregation

effortless-ntwf:validEvidenceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArticleClaims ;
    rdfs:range xsd:integer ;
    rdfs:label "ValidEvidenceCount" ;
    rdfs:comment "Evidence rows that meet the bar for this claim's kind." .
    # calculated: aggregation

effortless-ntwf:agreedEvidenceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArticleClaims ;
    rdfs:range xsd:integer ;
    rdfs:label "AgreedEvidenceCount" ;
    rdfs:comment "Valid evidence rows no graded substrate disputes." .
    # calculated: aggregation

effortless-ntwf:isCovered a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArticleClaims ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCovered" ;
    rdfs:comment "TRUE when at least one evidence row meets the bar." .
    # calculated: calculated

effortless-ntwf:isAgreed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArticleClaims ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAgreed" ;
    rdfs:comment "TRUE when at least one valid evidence row is undisputed by every graded substrate." .
    # calculated: calculated

effortless-ntwf:hasRejectedEvidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArticleClaims ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRejectedEvidence" ;
    rdfs:comment "TRUE when evidence was offered and none of it meets the bar." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ArtifactHandoffs ===
effortless-ntwf:ArtifactHandoffs a owl:Class ;
    rdfs:label "ArtifactHandoffs" ;
    rdfs:comment "One artifact passing from the step that produces it to a step that consumes it, asserted per declared input variable. The edge table the upgrade blast radius is traversed over." .

effortless-ntwf:artifactHandoffId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArtifactHandoffs ;
    rdfs:range xsd:string ;
    rdfs:label "ArtifactHandoffId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:stepVariable a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepVariables ;
    rdfs:label "StepVariable" ;
    rdfs:comment "The consuming step's input variable this hand-off feeds." .

effortless-ntwf:fromStep a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "FromStep" ;
    rdfs:comment "Step that produces the artifact." .

effortless-ntwf:toStep a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "ToStep" ;
    rdfs:comment "Step that consumes it." .

effortless-ntwf:declaredSourceStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArtifactHandoffs ;
    rdfs:range xsd:string ;
    rdfs:label "DeclaredSourceStep" ;
    rdfs:comment "Producing step the input variable itself declares." .
    # calculated: lookup

effortless-ntwf:declaredConsumerStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArtifactHandoffs ;
    rdfs:range xsd:string ;
    rdfs:label "DeclaredConsumerStep" ;
    rdfs:comment "Step that declares the input variable." .
    # calculated: lookup

effortless-ntwf:disagreesWithDeclaredVariable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ArtifactHandoffs ;
    rdfs:range xsd:boolean ;
    rdfs:label "DisagreesWithDeclaredVariable" ;
    rdfs:comment "TRUE when a recorded hand-off names different steps than the input variable it feeds declares, so traversal and declaration have drifted apart." .
    # calculated: calculated

# effortless-ntwf:handoffClosure is the transitive closure of effortless-ntwf:handoff
effortless-ntwf:handoff a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "Handoff" .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: AssignmentInstantChecks ===
effortless-ntwf:AssignmentInstantChecks a owl:Class ;
    rdfs:label "AssignmentInstantChecks" ;
    rdfs:comment "Point-in-time audit of which role assignment, and which agent version, held a step at a past instant." .

effortless-ntwf:assignmentInstantCheckId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentInstantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "AssignmentInstantCheckId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:auditQuestion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentInstantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "AuditQuestion" ;
    rdfs:comment "What the auditor asked." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Step." .

effortless-ntwf:auditInstant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentInstantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "AuditInstant" ;
    rdfs:comment "Past instant." .

effortless-ntwf:roleAssignment a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AssignmentInstantChecks ;
    rdfs:range effortless-ntwf:RoleAssignments ;
    rdfs:label "RoleAssignment" ;
    rdfs:comment "Candidate assignment." .

effortless-ntwf:stepRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentInstantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "StepRole" ;
    rdfs:comment "Role accountable for the step." .
    # calculated: lookup

effortless-ntwf:assignmentRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentInstantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "AssignmentRole" ;
    rdfs:comment "Role of the assignment." .
    # calculated: lookup

effortless-ntwf:assignmentValidFrom a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentInstantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "AssignmentValidFrom" ;
    rdfs:comment "Assignment start." .
    # calculated: lookup

effortless-ntwf:assignmentValidTo a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentInstantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "AssignmentValidTo" ;
    rdfs:comment "Assignment end." .
    # calculated: lookup

effortless-ntwf:assignmentAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentInstantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "AssignmentAgent" ;
    rdfs:comment "Agent assigned." .
    # calculated: lookup

effortless-ntwf:assignmentAgentVersion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentInstantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "AssignmentAgentVersion" ;
    rdfs:comment "Model version of that agent." .
    # calculated: lookup

effortless-ntwf:heldStepAtInstant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentInstantChecks ;
    rdfs:range xsd:boolean ;
    rdfs:label "HeldStepAtInstant" ;
    rdfs:comment "TRUE when this assignment held the step's role at the audited instant." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: AssignmentRoutedNotices ===
effortless-ntwf:AssignmentRoutedNotices a owl:Class ;
    rdfs:label "AssignmentRoutedNotices" ;
    rdfs:comment "Approval and verification notices a deployment pipeline sent for a run, where it read the recipient from, and who received it." .

effortless-ntwf:assignmentRoutedNoticeId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range xsd:string ;
    rdfs:label "AssignmentRoutedNoticeId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:procedureExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "ProcedureExecution" ;
    rdfs:comment "Run the notice belongs to." .

effortless-ntwf:noticeStep a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "NoticeStep" ;
    rdfs:comment "Step the notice asks someone to act on." .

effortless-ntwf:noticeKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range xsd:string ;
    rdfs:label "NoticeKind" ;
    rdfs:comment "ReleaseApproval or HealthVerification." .

effortless-ntwf:sentAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SentAt" ;
    rdfs:comment "When sent." .

effortless-ntwf:routingSource a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range xsd:string ;
    rdfs:label "RoutingSource" ;
    rdfs:comment "RoleAssignments (read from the model) or OpsSpreadsheet (a separately maintained list)." .

effortless-ntwf:routedToAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "RoutedToAgent" ;
    rdfs:comment "Who received it; blank when nobody did." .

effortless-ntwf:noticeRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range xsd:string ;
    rdfs:label "NoticeRole" ;
    rdfs:comment "Role assigned to the step." .
    # calculated: lookup

effortless-ntwf:recipientRoleKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range xsd:string ;
    rdfs:label "RecipientRoleKey" ;
    rdfs:comment "Recipient and role, as one key." .
    # calculated: calculated

effortless-ntwf:recipientPairAssignmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range xsd:integer ;
    rdfs:label "RecipientPairAssignmentCount" ;
    rdfs:comment "Assignments of the recipient to the role, at any time." .
    # calculated: aggregation

effortless-ntwf:recipientValidFrom a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range xsd:string ;
    rdfs:label "RecipientValidFrom" ;
    rdfs:comment "Start of the recipient's assignment to the role." .
    # calculated: aggregation

effortless-ntwf:recipientLatestValidTo a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range xsd:string ;
    rdfs:label "RecipientLatestValidTo" ;
    rdfs:comment "End of the recipient's assignment to the role." .
    # calculated: aggregation

effortless-ntwf:recipientOpenEndedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range xsd:integer ;
    rdfs:label "RecipientOpenEndedCount" ;
    rdfs:comment "Open-ended assignments of the recipient to the role." .
    # calculated: aggregation

effortless-ntwf:recipientHeldRoleWhenSent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range xsd:boolean ;
    rdfs:label "RecipientHeldRoleWhenSent" ;
    rdfs:comment "TRUE when the recipient's assignment to the step's role was valid at the moment the notice was sent." .
    # calculated: calculated

effortless-ntwf:reachedWrongPersonOrNobody a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range xsd:boolean ;
    rdfs:label "ReachedWrongPersonOrNobody" ;
    rdfs:comment "TRUE when a notice went to someone who did not hold the step's role when it was sent, or to nobody." .
    # calculated: calculated

effortless-ntwf:routedAroundModel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentRoutedNotices ;
    rdfs:range xsd:boolean ;
    rdfs:label "RoutedAroundModel" ;
    rdfs:comment "TRUE when a notice was routed from a separately maintained list and reached someone the model's assignments did not name for the role." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: AssignmentUpdatePolicies ===
effortless-ntwf:AssignmentUpdatePolicies a owl:Class ;
    rdfs:label "AssignmentUpdatePolicies" ;
    rdfs:comment "Governance for updating role assignments once operational systems read them: who triggers the update and the service level for completing it." .

effortless-ntwf:assignmentUpdatePolicyId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentUpdatePolicies ;
    rdfs:range xsd:string ;
    rdfs:label "AssignmentUpdatePolicyId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Policy." .

effortless-ntwf:triggerOwnerRole a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AssignmentUpdatePolicies ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "TriggerOwnerRole" ;
    rdfs:comment "Role responsible for triggering an assignment update; blank when governance names nobody." .

effortless-ntwf:updateSlaHours a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentUpdatePolicies ;
    rdfs:range xsd:integer ;
    rdfs:label "UpdateSlaHours" ;
    rdfs:comment "Hours within which an update must be completed; 0 when no service level is defined." .

effortless-ntwf:modelDrivesRouting a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssignmentUpdatePolicies ;
    rdfs:range xsd:boolean ;
    rdfs:label "ModelDrivesRouting" ;
    rdfs:comment "TRUE when operational systems route work from the assignments this policy covers." .

effortless-ntwf:adoptedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AdoptedAt" ;
    rdfs:comment "When adopted." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: AssistantAnswers ===
effortless-ntwf:AssistantAnswers a owl:Class ;
    rdfs:label "AssistantAnswers" ;
    rdfs:comment "One answer, guidance or recommendation an AI assistant delivered, recorded with its context and review. The model does not run the AI; it records what it said." .

effortless-ntwf:assistantAnswerId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:string ;
    rdfs:label "AssistantAnswerId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:answeringAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "AnsweringAgent" ;
    rdfs:comment "AI agent that answered." .

effortless-ntwf:askedByAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "AskedByAgent" ;
    rdfs:comment "Who asked." .

effortless-ntwf:viaIntegration a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range effortless-ntwf:AgentIntegrations ;
    rdfs:label "ViaIntegration" ;
    rdfs:comment "Integration the answer came through." .

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "Step execution under way when the question was asked." .

effortless-ntwf:askedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AskedAt" ;
    rdfs:comment "When asked." .

effortless-ntwf:answeredAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AnsweredAt" ;
    rdfs:comment "When answered." .

effortless-ntwf:answerKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:string ;
    rdfs:label "AnswerKind" ;
    rdfs:comment "Guidance, Recommendation or Lookup." .

effortless-ntwf:questionTopic a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:string ;
    rdfs:label "QuestionTopic" ;
    rdfs:comment "Authority, Safety, Sequence, Scheduling or General." .

effortless-ntwf:questionText a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "QuestionText" ;
    rdfs:comment "The question." .

effortless-ntwf:answerText a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:string ;
    rdfs:label "AnswerText" ;
    rdfs:comment "The answer." .

effortless-ntwf:retrievalMode a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:string ;
    rdfs:label "RetrievalMode" ;
    rdfs:comment "StructuredQuery, DocumentPassage or None." .

effortless-ntwf:derivationPerformedBy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:string ;
    rdfs:label "DerivationPerformedBy" ;
    rdfs:comment "Reasoner, StructuredQuery or LanguageModel: what produced the logic of the answer." .

effortless-ntwf:needsInference a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "NeedsInference" ;
    rdfs:comment "TRUE when the answer requires deriving something not stated outright." .

effortless-ntwf:assumedCurrentStep a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "AssumedCurrentStep" ;
    rdfs:comment "Step the assistant believed the execution was at." .

effortless-ntwf:assertedNextStep a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "AssertedNextStep" ;
    rdfs:comment "Step the assistant said comes next." .

effortless-ntwf:recommendedStep a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "RecommendedStep" ;
    rdfs:comment "Step a recommendation acts on." .

effortless-ntwf:raisedSafetyConcern a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "RaisedSafetyConcern" ;
    rdfs:comment "TRUE when the answer raised a possible safety problem." .

effortless-ntwf:deliveryDisposition a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:string ;
    rdfs:label "DeliveryDisposition" ;
    rdfs:comment "Delivered or Withheld." .

effortless-ntwf:wasActedOn a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasActedOn" ;
    rdfs:comment "TRUE when someone acted on the answer." .

effortless-ntwf:humanReviewedBy a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "HumanReviewedBy" ;
    rdfs:comment "Expert who reviewed the answer before it was used." .

effortless-ntwf:reviewedForInitiative a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:label "ReviewedForInitiative" ;
    rdfs:comment "Automation pilot whose output this expert review belongs to." .

effortless-ntwf:wasCorrect a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasCorrect" ;
    rdfs:comment "Expert verdict on the answer." .

effortless-ntwf:documentedInaccuracy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:string ;
    rdfs:label "DocumentedInaccuracy" ;
    rdfs:comment "What was wrong, as documented." .

effortless-ntwf:taskOutcome a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:string ;
    rdfs:label "TaskOutcome" ;
    rdfs:comment "Completed, Failed or Abandoned." .

effortless-ntwf:groundingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:integer ;
    rdfs:label "GroundingCount" ;
    rdfs:comment "Groundings of the answer." .
    # calculated: aggregation

effortless-ntwf:ownKnowledgeGroundingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:integer ;
    rdfs:label "OwnKnowledgeGroundingCount" ;
    rdfs:comment "Groundings in the organization's own assertions or segments." .
    # calculated: aggregation

effortless-ntwf:citedGroundingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:integer ;
    rdfs:label "CitedGroundingCount" ;
    rdfs:comment "Groundings shown to the person as citations." .
    # calculated: aggregation

effortless-ntwf:staleGroundingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:integer ;
    rdfs:label "StaleGroundingCount" ;
    rdfs:comment "Groundings on stale or deprecated assertions." .
    # calculated: aggregation

effortless-ntwf:isNotFromOwnKnowledge a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNotFromOwnKnowledge" ;
    rdfs:comment "TRUE when a delivered answer rests on nothing from the organization's own procedural knowledge." .
    # calculated: calculated

effortless-ntwf:isUntraceableToSource a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntraceableToSource" ;
    rdfs:comment "TRUE when a delivered answer was grounded but showed the person none of its sources." .
    # calculated: calculated

effortless-ntwf:contextUnescalatedDangerCueCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:integer ;
    rdfs:label "ContextUnescalatedDangerCueCount" ;
    rdfs:comment "Danger cues seen and not escalated on the step under way." .
    # calculated: lookup

effortless-ntwf:stayedSilentOnSafetyProblem a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "StayedSilentOnSafetyProblem" ;
    rdfs:comment "TRUE when an unescalated danger cue was on record for the step and the answer raised no safety concern." .
    # calculated: calculated

effortless-ntwf:contextStepEndedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:string ;
    rdfs:label "ContextStepEndedAt" ;
    rdfs:comment "When the step under way ended." .
    # calculated: lookup

effortless-ntwf:arrivedAfterStepEnded a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "ArrivedAfterStepEnded" ;
    rdfs:comment "TRUE when guidance for a step arrived after the step had already ended." .
    # calculated: calculated

effortless-ntwf:executionOfContext a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:string ;
    rdfs:label "ExecutionOfContext" ;
    rdfs:comment "Procedure execution under way." .
    # calculated: lookup

effortless-ntwf:contextStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:string ;
    rdfs:label "ContextStep" ;
    rdfs:comment "Step under way." .
    # calculated: lookup

effortless-ntwf:assumedStepCompletedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:integer ;
    rdfs:label "AssumedStepCompletedCount" ;
    rdfs:comment "Completed runs, in the same execution, of the step the assistant believed it was at." .
    # calculated: aggregation

effortless-ntwf:lostTrackOfState a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "LostTrackOfState" ;
    rdfs:comment "TRUE when the assistant acted as if a step were done that the execution record shows never completed." .
    # calculated: calculated

effortless-ntwf:specifiedTransitionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:integer ;
    rdfs:label "SpecifiedTransitionCount" ;
    rdfs:comment "Transitions the model allows from the assumed step to the asserted next step." .
    # calculated: aggregation

effortless-ntwf:contradictsSharedModel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "ContradictsSharedModel" ;
    rdfs:comment "TRUE when the assistant asserted a next step the procedure's transition graph does not allow." .
    # calculated: calculated

effortless-ntwf:isExplicitlyGroundedRecommendation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExplicitlyGroundedRecommendation" ;
    rdfs:comment "TRUE for a recommendation that names at least one piece of the organization's explicit process knowledge." .
    # calculated: calculated

effortless-ntwf:recommendationRestsOnNothingExplicit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "RecommendationRestsOnNothingExplicit" ;
    rdfs:comment "TRUE for a recommendation traceable to no explicit process knowledge." .
    # calculated: calculated

effortless-ntwf:recommendedStepRegulatoryCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:integer ;
    rdfs:label "RecommendedStepRegulatoryCount" ;
    rdfs:comment "Regulatory requirements on the recommended step." .
    # calculated: lookup

effortless-ntwf:requirementCheckCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:integer ;
    rdfs:label "RequirementCheckCount" ;
    rdfs:comment "Requirement checks run on the answer." .
    # calculated: aggregation

effortless-ntwf:conflictCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:integer ;
    rdfs:label "ConflictCount" ;
    rdfs:comment "Checks that found a conflict." .
    # calculated: aggregation

effortless-ntwf:conflictsWithRegulation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "ConflictsWithRegulation" ;
    rdfs:comment "TRUE when a check found the recommended action conflicts with an applicable requirement." .
    # calculated: calculated

effortless-ntwf:isUncheckedRegulatedRecommendation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUncheckedRegulatedRecommendation" ;
    rdfs:comment "TRUE for a recommendation on a regulated step that was never checked against its requirements." .
    # calculated: calculated

effortless-ntwf:deliveredDespiteConflict a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "DeliveredDespiteConflict" ;
    rdfs:comment "TRUE when the check found a regulatory conflict and the recommendation was delivered anyway." .
    # calculated: calculated

effortless-ntwf:recommendedStepNeedsHuman a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "RecommendedStepNeedsHuman" ;
    rdfs:comment "Whether the recommended step requires human confirmation." .
    # calculated: lookup

effortless-ntwf:actedOnWithoutHumanJudgment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "ActedOnWithoutHumanJudgment" ;
    rdfs:comment "TRUE when an AI recommendation on a step that requires human judgment was acted on with no expert review." .
    # calculated: calculated

effortless-ntwf:answeredComplianceQuestionFromDocuments a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "AnsweredComplianceQuestionFromDocuments" ;
    rdfs:comment "TRUE when an authority or safety question was answered from document passages rather than a structured query." .
    # calculated: calculated

effortless-ntwf:documentInterpretationErred a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "DocumentInterpretationErred" ;
    rdfs:comment "TRUE when an authority question answered by interpreting a document passage came back wrong." .
    # calculated: calculated

effortless-ntwf:modelDidTheReasoning a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "ModelDidTheReasoning" ;
    rdfs:comment "TRUE when an answer that needed inference had its logic produced by the language model, not a reasoner or query." .
    # calculated: calculated

effortless-ntwf:wrongBecauseGraphWasStale a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "WrongBecauseGraphWasStale" ;
    rdfs:comment "TRUE when a graph-grounded answer was wrong and rested on a stale or deprecated assertion." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

effortless-ntwf:ownerOrganization a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OwnerOrganization" ;
    rdfs:comment "The organization that owns the procedure this row belongs to, one hop at a time from Procedures.OwnerOrganization. A row policy compares it to the caller's organization, so a plant sign-in never sees the finance close." .
    # calculated: lookup

effortless-ntwf:modelReasonedAndTaskFailed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantAnswers ;
    rdfs:range xsd:boolean ;
    rdfs:label "ModelReasonedAndTaskFailed" ;
    rdfs:comment "The language model did the reasoning for this answer itself, and the task it was asked about ended in failure." .
    # calculated: calculated

# === Class: AssistantBenchmarks ===
effortless-ntwf:AssistantBenchmarks a owl:Class ;
    rdfs:label "AssistantBenchmarks" ;
    rdfs:comment "Recorded accuracy of an AI assistant on a task family with and without graph grounding." .

effortless-ntwf:assistantBenchmarkId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantBenchmarks ;
    rdfs:range xsd:string ;
    rdfs:label "AssistantBenchmarkId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Benchmark." .

effortless-ntwf:taskFamily a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantBenchmarks ;
    rdfs:range xsd:string ;
    rdfs:label "TaskFamily" ;
    rdfs:comment "Spatial, Geospatial or Procedural." .

effortless-ntwf:agent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "Agent" ;
    rdfs:comment "Assistant." .

effortless-ntwf:groundingSnapshot a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AssistantBenchmarks ;
    rdfs:range effortless-ntwf:GroundingSnapshots ;
    rdfs:label "GroundingSnapshot" ;
    rdfs:comment "Graph used by the grounded arm." .

effortless-ntwf:generatesDatabaseQueries a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantBenchmarks ;
    rdfs:range xsd:boolean ;
    rdfs:label "GeneratesDatabaseQueries" ;
    rdfs:comment "TRUE when the grounded arm writes structured queries against the graph." .

effortless-ntwf:ungroundedAccuracyPercent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantBenchmarks ;
    rdfs:range xsd:string ;
    rdfs:label "UngroundedAccuracyPercent" ;
    rdfs:comment "Accuracy without the graph." .

effortless-ntwf:graphGroundedAccuracyPercent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantBenchmarks ;
    rdfs:range xsd:string ;
    rdfs:label "GraphGroundedAccuracyPercent" ;
    rdfs:comment "Accuracy with the graph." .

effortless-ntwf:ranAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RanAt" ;
    rdfs:comment "When." .

effortless-ntwf:accuracyLiftPoints a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantBenchmarks ;
    rdfs:range xsd:string ;
    rdfs:label "AccuracyLiftPoints" ;
    rdfs:comment "Accuracy points gained by grounding." .
    # calculated: calculated

effortless-ntwf:showsSpatialLiftFromGraphQueries a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantBenchmarks ;
    rdfs:range xsd:boolean ;
    rdfs:label "ShowsSpatialLiftFromGraphQueries" ;
    rdfs:comment "TRUE when a spatial task gained 20 or more points once the assistant queried the graph." .
    # calculated: calculated

effortless-ntwf:showsGeospatialRetrievalLift a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AssistantBenchmarks ;
    rdfs:range xsd:boolean ;
    rdfs:label "ShowsGeospatialRetrievalLift" ;
    rdfs:comment "TRUE when geospatial retrieval gained 20 or more points once linked to the graph." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: Attestations ===
effortless-ntwf:Attestations a owl:Class ;
    rdfs:label "Attestations" ;
    rdfs:comment "Attestations (added by witness loop 2)." .

effortless-ntwf:attestationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:string ;
    rdfs:label "AttestationId" ;
    rdfs:comment "Primary key of a signature event: one person, one execution, one instant." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Attestations row." .
    # calculated: calculated

effortless-ntwf:procedureExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "ProcedureExecution" ;
    rdfs:comment "The execution being attested to." .

effortless-ntwf:signedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "SignedByAgent" ;
    rdfs:comment "The human who signed." .

effortless-ntwf:signedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:string ;
    rdfs:label "SignedAt" ;
    rdfs:comment "The instant of signature." .

effortless-ntwf:assuranceGradeAtSigning a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:string ;
    rdfs:label "AssuranceGradeAtSigning" ;
    rdfs:comment "The AssuranceGrade string as the model reported it at the moment of signature, captured then and never recomputed." .

effortless-ntwf:versionWasFitAtSigning a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:boolean ;
    rdfs:label "VersionWasFitAtSigning" ;
    rdfs:comment "Whether the executed procedure version was fit to execute at the moment of signature." .

effortless-ntwf:versionIsFitNow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:boolean ;
    rdfs:label "VersionIsFitNow" ;
    rdfs:comment "Whether the executed version reads as fit today." .
    # calculated: lookup

effortless-ntwf:fitnessVerdictHasDrifted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:boolean ;
    rdfs:label "FitnessVerdictHasDrifted" ;
    rdfs:comment "TRUE when the fitness of the signed version reads differently today than it did at signature." .
    # calculated: calculated

effortless-ntwf:assuranceGradeNow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:string ;
    rdfs:label "AssuranceGradeNow" ;
    rdfs:comment "The AssuranceGrade the model reports for this execution today." .
    # calculated: lookup

effortless-ntwf:assuranceGradeHasDrifted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:boolean ;
    rdfs:label "AssuranceGradeHasDrifted" ;
    rdfs:comment "TRUE when the assurance behind this signature is described differently now than it was at signature." .
    # calculated: calculated

effortless-ntwf:wouldNotSurviveRestatement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:boolean ;
    rdfs:label "WouldNotSurviveRestatement" ;
    rdfs:comment "TRUE when re-deriving this attestation today would not reproduce what the model said when it was signed." .
    # calculated: calculated

# === Class: AuthoringSubmissions ===
effortless-ntwf:AuthoringSubmissions a owl:Class ;
    rdfs:label "AuthoringSubmissions" ;
    rdfs:comment "Procedures submitted through the no-code capture form, validated against the PKO profile." .

effortless-ntwf:authoringSubmissionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthoringSubmissions ;
    rdfs:range xsd:string ;
    rdfs:label "AuthoringSubmissionId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Version the submission authors." .

effortless-ntwf:submittedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AuthoringSubmissions ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "SubmittedByAgent" ;
    rdfs:comment "Who submitted it." .

effortless-ntwf:submittedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthoringSubmissions ;
    rdfs:range xsd:string ;
    rdfs:label "SubmittedAt" ;
    rdfs:comment "When." .

effortless-ntwf:authoringTool a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AuthoringSubmissions ;
    rdfs:range effortless-ntwf:Tools ;
    rdfs:label "AuthoringTool" ;
    rdfs:comment "Tool used." .

effortless-ntwf:submitterExpertise a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthoringSubmissions ;
    rdfs:range xsd:string ;
    rdfs:label "SubmitterExpertise" ;
    rdfs:comment "DomainExpert or KnowledgeEngineer." .

effortless-ntwf:stepCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "StepCount" ;
    rdfs:comment "Steps authored." .

effortless-ntwf:profileValidationPassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthoringSubmissions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ProfileValidationPassed" ;
    rdfs:comment "Whether it validated against the PKO profile." .

effortless-ntwf:validationErrorCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthoringSubmissions ;
    rdfs:range xsd:integer ;
    rdfs:label "ValidationErrorCount" ;
    rdfs:comment "Profile violations found." .

effortless-ntwf:wasAccepted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthoringSubmissions ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasAccepted" ;
    rdfs:comment "Whether it was accepted into the rulebook." .

effortless-ntwf:isExpertAuthoredConforming a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthoringSubmissions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExpertAuthoredConforming" ;
    rdfs:comment "TRUE when a domain expert with no ontology training produced a submission that conforms to the profile." .
    # calculated: calculated

effortless-ntwf:isNonConformingAccepted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthoringSubmissions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonConformingAccepted" ;
    rdfs:comment "TRUE when a submission that failed profile validation was accepted anyway." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: AuthorityBoundaries ===
effortless-ntwf:AuthorityBoundaries a owl:Class ;
    rdfs:label "AuthorityBoundaries" ;
    rdfs:comment "AuthorityBoundaries (added by witness loop 1)." .

effortless-ntwf:authorityBoundaryId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "AuthorityBoundaryId" ;
    rdfs:comment "Stored logical identifier for one AuthorityBoundaries row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AuthorityBoundaries row." .
    # calculated: calculated

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Step at which the boundary applies." .

effortless-ntwf:forbiddenAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "ForbiddenAgentKind" ;
    rdfs:comment "Agent kind that may not perform the forbidden decision kind: Human, AIAgent, or AutomatedPipeline." .

effortless-ntwf:forbiddenDecisionKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "ForbiddenDecisionKind" ;
    rdfs:comment "Decision kind forbidden to that agent kind at this step." .

effortless-ntwf:ratifiedByKnowledgeFragment a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range effortless-ntwf:KnowledgeFragments ;
    rdfs:label "RatifiedByKnowledgeFragment" ;
    rdfs:comment "Knowledge fragment that states the boundary." .

effortless-ntwf:enforcingRequirement a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range effortless-ntwf:Requirements ;
    rdfs:label "EnforcingRequirement" ;
    rdfs:comment "Requirement under which the boundary is enforced, if any." .

effortless-ntwf:authorityRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "AuthorityRole" ;
    rdfs:comment "Role accountable for the boundary." .

effortless-ntwf:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ValidFrom" ;
    rdfs:comment "Start of the boundary's valid-time interval." .

effortless-ntwf:validTo a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ValidTo" ;
    rdfs:comment "End of the boundary's valid-time interval; null means open-ended." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Approved, Proposed, or Retired." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this boundary's currency is judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this boundary is judged against." .
    # calculated: lookup

effortless-ntwf:isCurrentlyBinding a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrentlyBinding" ;
    rdfs:comment "TRUE when this boundary is approved and inside its valid-time window right now." .
    # calculated: calculated

effortless-ntwf:ratifyingFragmentIsValid a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "RatifyingFragmentIsValid" ;
    rdfs:comment "Whether the knowledge fragment that ratified this boundary is still valid." .
    # calculated: lookup

effortless-ntwf:stepWhenBinding a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "StepWhenBinding" ;
    rdfs:comment "Echoes the step id when this boundary is currently binding, blank otherwise." .
    # calculated: calculated

effortless-ntwf:boundaryMatchKey a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "BoundaryMatchKey" ;
    rdfs:comment "Composite key of step, forbidden agent kind, and forbidden decision kind." .
    # calculated: calculated

effortless-ntwf:violationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "ViolationCount" ;
    rdfs:comment "Number of recorded decisions that this boundary forbids." .
    # calculated: aggregation

effortless-ntwf:isUntested a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntested" ;
    rdfs:comment "TRUE when a binding boundary has never been triggered by any recorded decision." .
    # calculated: calculated

effortless-ntwf:hasRatifyingFragment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRatifyingFragment" ;
    rdfs:comment "TRUE when this boundary names a knowledge fragment as its justification. FALSE means the rule constrains behaviour on nobody's recorded authority — strictly worse than resting on an expired claim, and previously invisible because the ratification lookup returned NULL." .
    # calculated: calculated

effortless-ntwf:isUnwarranted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwarranted" ;
    rdfs:comment "TRUE when a binding constraint on authority rests on no ratifying claim at all, or on one that is no longer valid. Either way the rule is being enforced without a live justification." .
    # calculated: calculated

effortless-ntwf:ratifyingFragmentIsOverdue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "RatifyingFragmentIsOverdue" ;
    rdfs:comment "Whether the fragment ratifying this boundary is past its review date." .
    # calculated: lookup

effortless-ntwf:ratifyingFragmentIsSingleWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "RatifyingFragmentIsSingleWitness" ;
    rdfs:comment "Whether the fragment ratifying this boundary rests on a single witness." .
    # calculated: lookup

effortless-ntwf:warrantIsThin a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "WarrantIsThin" ;
    rdfs:comment "A binding boundary whose ratifying knowledge is either overdue for review or single-sourced — still valid, but weakly warranted." .
    # calculated: calculated

effortless-ntwf:isUnwarrantedAndUntested a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwarrantedAndUntested" ;
    rdfs:comment "A boundary whose ratification has lapsed and which no agent decision has ever been evaluated against — we cannot show it works and we cannot show why it exists." .
    # calculated: calculated

effortless-ntwf:unwarrantedBoundaryStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "UnwarrantedBoundaryStepKey" ;
    rdfs:comment "Composite-key echo: the step this boundary governs when the boundary is unwarranted, blank otherwise." .
    # calculated: calculated

effortless-ntwf:ratifyingFragmentKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "RatifyingFragmentKey" ;
    rdfs:comment "Composite-key echo: the fragment ratifying this boundary when the boundary is currently binding, blank otherwise." .
    # calculated: calculated

effortless-ntwf:ratifyingFragmentStatus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "RatifyingFragmentStatus" ;
    rdfs:comment "The status string of the knowledge fragment that ratifies this boundary: Approved, Reviewed, Draft, or empty." .
    # calculated: lookup

effortless-ntwf:ratificationLapsed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "RatificationLapsed" ;
    rdfs:comment "TRUE when this boundary names a ratifying fragment and that fragment is no longer valid." .
    # calculated: calculated

effortless-ntwf:bindsDespiteLapsedRatification a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "BindsDespiteLapsedRatification" ;
    rdfs:comment "TRUE when a boundary is still enforced against agents while the knowledge that authorized it has lapsed." .
    # calculated: calculated

effortless-ntwf:isUngroundedAndUntested a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngroundedAndUntested" ;
    rdfs:comment "TRUE when a boundary has lapsed ratification AND has never once been exercised -- so neither its authority nor its operation has ever been demonstrated." .
    # calculated: calculated

effortless-ntwf:constrainedRoleAssignmentKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "ConstrainedRoleAssignmentKey" ;
    rdfs:comment "The role id this boundary constrains, emitted only when the boundary is ungrounded." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI for an authority boundary." .

# === Class: BindingObservations ===
effortless-ntwf:BindingObservations a owl:Class ;
    rdfs:label "BindingObservations" ;
    rdfs:comment "BindingObservations (added by witness loop 2)." .

effortless-ntwf:bindingObservationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:string ;
    rdfs:label "BindingObservationId" ;
    rdfs:comment "Primary key of an execution-side observation of one operational binding, frozen at the moment a step actually ran." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the BindingObservations row." .
    # calculated: calculated

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "The step execution during which this binding was read." .

effortless-ntwf:operationalBinding a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range effortless-ntwf:OperationalBindings ;
    rdfs:label "OperationalBinding" ;
    rdfs:comment "The spec-side binding this observation instantiates." .

effortless-ntwf:observedSourceTimestamp a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:string ;
    rdfs:label "ObservedSourceTimestamp" ;
    rdfs:comment "The LastObservedAt value the source actually carried at run time, captured then and never recomputed." .

effortless-ntwf:readAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:string ;
    rdfs:label "ReadAt" ;
    rdfs:comment "When the step execution actually read this binding." .

effortless-ntwf:slaMinutesAtRun a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:integer ;
    rdfs:label "SlaMinutesAtRun" ;
    rdfs:comment "The freshness SLA declared for this binding." .
    # calculated: lookup

effortless-ntwf:ageAtRunMinutes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:integer ;
    rdfs:label "AgeAtRunMinutes" ;
    rdfs:comment "How old the source data was at the instant the step read it." .
    # calculated: calculated

effortless-ntwf:wasStaleAtRun a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasStaleAtRun" ;
    rdfs:comment "TRUE when an authoritative source was already outside its SLA at the moment the step consumed it." .
    # calculated: calculated

effortless-ntwf:isAuthoritativeBinding a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAuthoritativeBinding" ;
    rdfs:comment "Whether the binding observed is the authoritative source for its record key." .
    # calculated: lookup

effortless-ntwf:staleAtRunStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:string ;
    rdfs:label "StaleAtRunStepKey" ;
    rdfs:comment "Echoes the step execution id when the source was stale at run time." .
    # calculated: calculated

# === Class: BusinessOutcomes ===
