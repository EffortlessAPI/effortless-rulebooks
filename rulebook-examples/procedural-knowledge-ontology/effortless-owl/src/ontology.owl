    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:elicitationSession a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ElicitationSessions ;
    rdfs:label "ElicitationSession" ;
    rdfs:comment "The observation session." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "The step the action belongs to." .

effortless-ntwf:practitioner a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "Practitioner" ;
    rdfs:comment "The practitioner observed." .

effortless-ntwf:actionDescription a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:string ;
    rdfs:label "ActionDescription" ;
    rdfs:comment "What the observer saw." .

effortless-ntwf:actionKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:string ;
    rdfs:label "ActionKind" ;
    rdfs:comment "SmallChoice, Workaround, OmittedObviousStep or DocumentedStep." .

effortless-ntwf:mentionedInOwnAccount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:boolean ;
    rdfs:label "MentionedInOwnAccount" ;
    rdfs:comment "TRUE when the practitioner's own interview account included the action." .

effortless-ntwf:statedReason a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:string ;
    rdfs:label "StatedReason" ;
    rdfs:comment "The reason the practitioner gave when the observer asked; blank when nobody asked." .

effortless-ntwf:counterfactualCondition a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:string ;
    rdfs:label "CounterfactualCondition" ;
    rdfs:comment "The different condition the observer asked about." .

effortless-ntwf:counterfactualAnswer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:string ;
    rdfs:label "CounterfactualAnswer" ;
    rdfs:comment "What the practitioner said they would do under that condition." .

effortless-ntwf:capturedAsFragment a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range effortless-ntwf:KnowledgeFragments ;
    rdfs:label "CapturedAsFragment" ;
    rdfs:comment "The knowledge fragment the action was captured as." .

effortless-ntwf:isSmallChoice a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSmallChoice" ;
    rdfs:comment "TRUE for a small choice made during actual practice." .
    # calculated: calculated

effortless-ntwf:isUnofficialWorkaround a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnofficialWorkaround" ;
    rdfs:comment "TRUE for an unofficial workaround." .
    # calculated: calculated

effortless-ntwf:isOmittedFromOwnAccount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOmittedFromOwnAccount" ;
    rdfs:comment "TRUE when observation saw an action the practitioner's own account left out." .
    # calculated: calculated

effortless-ntwf:isMissedStepLeftUncaptured a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMissedStepLeftUncaptured" ;
    rdfs:comment "TRUE when an action the interview missed was observed but never captured as knowledge." .
    # calculated: calculated

effortless-ntwf:isWatchedNotQuestioned a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWatchedNotQuestioned" ;
    rdfs:comment "TRUE when a small choice or workaround was watched but no reason was asked for and recorded." .
    # calculated: calculated

effortless-ntwf:hasRecordedReason a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRecordedReason" ;
    rdfs:comment "TRUE when a reason is recorded against the observed action." .
    # calculated: calculated

effortless-ntwf:hasCounterfactualAnswer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedActions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasCounterfactualAnswer" ;
    rdfs:comment "TRUE when the practitioner said what they would do if a condition were different." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ObservedTransitions ===
effortless-ntwf:ObservedTransitions a owl:Class ;
    rdfs:label "ObservedTransitions" ;
    rdfs:comment "The proxy above cannot tell a walked fallback from a happy-path step that happens to share an endpoint. PKO models Transition as a first-class thing; its execution counterpart is missing. Without a table that records WHICH transition a step execution arrived by, 'has this fallback ever been walked' is permanently unanswerable rather than merely unanswered. This is an extension (https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#ObservedTransition), not a native PKO term." .

effortless-ntwf:observedTransitionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedTransitions ;
    rdfs:range xsd:string ;
    rdfs:label "ObservedTransitionId" ;
    rdfs:comment "Stored logical identifier for one ObservedTransitions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:procedureExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "ProcedureExecution" ;
    rdfs:comment "The procedure execution during which this transition was traversed." .

effortless-ntwf:stepTransition a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ObservedTransitions ;
    rdfs:range effortless-ntwf:StepTransitions ;
    rdfs:label "StepTransition" ;
    rdfs:comment "The specification-level transition that was actually taken." .

effortless-ntwf:arrivingStepExecution a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ObservedTransitions ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "ArrivingStepExecution" ;
    rdfs:comment "The step execution that this traversal produced." .

effortless-ntwf:observedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ObservedAt" ;
    rdfs:comment "When the traversal occurred." .

effortless-ntwf:triggerReason a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedTransitions ;
    rdfs:range xsd:string ;
    rdfs:label "TriggerReason" ;
    rdfs:comment "Why this path rather than the default was taken." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: OnboardingRecords ===
effortless-ntwf:OnboardingRecords a owl:Class ;
    rdfs:label "OnboardingRecords" ;
    rdfs:comment "A new starter learning a procedure: when they started, when they reached proficiency, and whether they learned from captured, formalized knowledge." .

effortless-ntwf:onboardingRecordId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OnboardingRecords ;
    rdfs:range xsd:string ;
    rdfs:label "OnboardingRecordId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:newStarter a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:OnboardingRecords ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "NewStarter" ;
    rdfs:comment "The new starter." .

effortless-ntwf:procedure a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Procedures ;
    rdfs:label "Procedure" ;
    rdfs:comment "The procedure being learned." .

effortless-ntwf:startedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "StartedAt" ;
    rdfs:comment "When onboarding started." .

effortless-ntwf:proficientAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OnboardingRecords ;
    rdfs:range xsd:string ;
    rdfs:label "ProficientAt" ;
    rdfs:comment "When the starter was signed off as proficient; blank while learning." .

effortless-ntwf:usedCapturedKnowledge a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OnboardingRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "UsedCapturedKnowledge" ;
    rdfs:comment "TRUE when the starter learned from formalized repository knowledge." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The instant the row is judged against." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The modeled evaluation instant." .
    # calculated: lookup

effortless-ntwf:isProficient a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OnboardingRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsProficient" ;
    rdfs:comment "TRUE once signed off." .
    # calculated: calculated

effortless-ntwf:daysToProficiency a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OnboardingRecords ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysToProficiency" ;
    rdfs:comment "Days from start to proficiency." .
    # calculated: calculated

effortless-ntwf:daysSinceStart a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OnboardingRecords ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceStart" ;
    rdfs:comment "Days from start to the evaluation instant." .
    # calculated: calculated

effortless-ntwf:isRecentStart a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OnboardingRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRecentStart" ;
    rdfs:comment "TRUE when the starter began within 180 days of the evaluation instant." .
    # calculated: calculated

effortless-ntwf:procedureRepositoryEntryCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OnboardingRecords ;
    rdfs:range xsd:integer ;
    rdfs:label "ProcedureRepositoryEntryCount" ;
    rdfs:comment "Repository entries for the procedure." .
    # calculated: lookup

effortless-ntwf:procedureDepartedOnlyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OnboardingRecords ;
    rdfs:range xsd:integer ;
    rdfs:label "ProcedureDepartedOnlyCount" ;
    rdfs:comment "Know-how of the procedure held only by people who left." .
    # calculated: lookup

effortless-ntwf:isStartingFromNothing a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OnboardingRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStartingFromNothing" ;
    rdfs:comment "TRUE when a newcomer joins a procedure whose previous holders left and nothing was captured." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: OntologyProfiles ===
effortless-ntwf:OntologyProfiles a owl:Class ;
    rdfs:label "OntologyProfiles" ;
    rdfs:comment "Versioned ontology and vocabulary dependencies. PKO mappings always identify the exact profile and version." .

effortless-ntwf:ontologyProfileId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OntologyProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "OntologyProfileId" ;
    rdfs:comment "Stored logical identifier for one OntologyProfiles row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the OntologyProfiles row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Human-readable ontology or vocabulary name." .

effortless-ntwf:version a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OntologyProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "Version" ;
