effortless-ntwf:processKnowledgeLevelId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessKnowledgeLevels ;
    rdfs:range xsd:string ;
    rdfs:label "ProcessKnowledgeLevelId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Level name." .

effortless-ntwf:planningHorizon a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessKnowledgeLevels ;
    rdfs:range xsd:string ;
    rdfs:label "PlanningHorizon" ;
    rdfs:comment "The horizon the level plans over." .

effortless-ntwf:tacitStrategyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessKnowledgeLevels ;
    rdfs:range xsd:integer ;
    rdfs:label "TacitStrategyCount" ;
    rdfs:comment "Capture strategies for tacit knowledge at this level." .
