effortless-ntwf:unescalatedExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CueObservations ;
    rdfs:range xsd:string ;
    rdfs:label "UnescalatedExecutionKey" ;
    rdfs:comment "Step execution key when unescalated." .
