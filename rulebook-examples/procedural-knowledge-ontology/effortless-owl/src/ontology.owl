    rdfs:comment "Value expected." .

effortless-ntwf:producedValue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExpectedInferenceChecks ;
    rdfs:range xsd:string ;
    rdfs:label "ProducedValue" ;
    rdfs:comment "Value produced." .

effortless-ntwf:isUnproduced a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExpectedInferenceChecks ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnproduced" ;
