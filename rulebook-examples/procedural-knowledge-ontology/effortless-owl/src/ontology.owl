effortless-ntwf:isOwnerless a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOwnerless" ;
    rdfs:comment "TRUE when no ownership charter is in force." .
