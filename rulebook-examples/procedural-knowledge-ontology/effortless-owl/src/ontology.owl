# === Class: KnowledgeConsumerSystems ===
effortless-ntwf:KnowledgeConsumerSystems a owl:Class ;
    rdfs:label "KnowledgeConsumerSystems" ;
    rdfs:comment "Systems that hold or consume process knowledge: content management, process modeling tools, semantic repositories, knowledge graph platforms, AI platforms and field apps." .

effortless-ntwf:knowledgeConsumerSystemId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeConsumerSystemId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "System name." .

effortless-ntwf:systemKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:string ;
    rdfs:label "SystemKind" ;
    rdfs:comment "ContentManagement, ProcessModelingTool, SemanticRepository, KnowledgeGraphPlatform, AIPlatform or FieldApp." .

effortless-ntwf:organization a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "Organization" ;
    rdfs:comment "Operating organization." .

effortless-ntwf:audience a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:string ;
    rdfs:label "Audience" ;
    rdfs:comment "Human, AI or Both: who reads knowledge through this system." .

effortless-ntwf:holdsProcedureKnowledge a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "HoldsProcedureKnowledge" ;
    rdfs:comment "TRUE when procedures live in this system." .

effortless-ntwf:exportsStandardFormat a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExportsStandardFormat" ;
    rdfs:comment "TRUE when the system can export its knowledge in an open standard." .

effortless-ntwf:exportFormat a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:string ;
    rdfs:label "ExportFormat" ;
    rdfs:comment "The export format." .

effortless-ntwf:hasReasoner a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasReasoner" ;
    rdfs:comment "Has a reasoner." .

effortless-ntwf:hasSemanticStorage a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSemanticStorage" ;
    rdfs:comment "Has semantic (triple) storage." .

effortless-ntwf:hasGraphAlgorithms a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasGraphAlgorithms" ;
    rdfs:comment "Has graph algorithms." .

effortless-ntwf:hasMachineLearning a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasMachineLearning" ;
    rdfs:comment "Has machine learning." .

effortless-ntwf:hasTaxonomy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasTaxonomy" ;
    rdfs:comment "Holds a taxonomy." .

effortless-ntwf:hasThesaurus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasThesaurus" ;
    rdfs:comment "Holds a thesaurus." .

effortless-ntwf:hasOntology a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOntology" ;
    rdfs:comment "Holds an ontology." .

effortless-ntwf:hasMetadataSchema a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasMetadataSchema" ;
    rdfs:comment "Holds metadata schemas." .

effortless-ntwf:modelSyncCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:integer ;
    rdfs:label "ModelSyncCount" ;
    rdfs:comment "Procedure versions this system holds, synced from the shared model." .
    # calculated: aggregation

effortless-ntwf:integrationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:integer ;
    rdfs:label "IntegrationCount" ;
    rdfs:comment "AI agent integrations that read knowledge through this system." .
    # calculated: aggregation

effortless-ntwf:isKnowledgeSilo a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKnowledgeSilo" ;
    rdfs:comment "TRUE for a system holding procedures that exports no open format and receives nothing from the shared model." .
    # calculated: calculated

effortless-ntwf:isUnlinkedToolchainComponent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnlinkedToolchainComponent" ;
    rdfs:comment "TRUE for a process modeling tool, semantic repository or AI platform linked to neither the model nor any AI integration." .
    # calculated: calculated

effortless-ntwf:semanticLayerComponentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:integer ;
    rdfs:label "SemanticLayerComponentCount" ;
    rdfs:comment "How many of taxonomy, thesaurus, ontology, metadata schemas and reasoner the system combines." .
    # calculated: calculated

effortless-ntwf:platformCapabilityCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:integer ;
    rdfs:label "PlatformCapabilityCount" ;
    rdfs:comment "How many of reasoner, semantic storage, graph algorithms and machine learning the system has." .
    # calculated: calculated

effortless-ntwf:isImmatureGraphPlatform a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsImmatureGraphPlatform" ;
    rdfs:comment "TRUE for a knowledge graph platform that lacks one of reasoner, semantic storage, graph algorithms or machine learning." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

effortless-ntwf:isComputationallyQueryable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsComputationallyQueryable" ;
    rdfs:comment "Whether the procedure knowledge this system holds can be queried structurally, rather than only opened and read by a person." .

effortless-ntwf:isComputationallyValidatable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsComputationallyValidatable" ;
    rdfs:comment "Whether the procedure knowledge this system holds can be checked automatically against rules." .

effortless-ntwf:holdsComputationallyEncodedProcedureKnowledge a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "HoldsComputationallyEncodedProcedureKnowledge" ;
    rdfs:comment "The system holds procedure knowledge in a form that can be queried, validated and reasoned over computationally -- the shift that encoded representations made possible." .
    # calculated: calculated

effortless-ntwf:storesProcedureKnowledgeWithoutComputationalAccess a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:range xsd:boolean ;
    rdfs:label "StoresProcedureKnowledgeWithoutComputationalAccess" ;
    rdfs:comment "The system holds procedure knowledge that no machine can query, validate or reason over: storage without encoding." .
    # calculated: calculated

# === Class: KnowledgeConversions ===
effortless-ntwf:KnowledgeConversions a owl:Class ;
    rdfs:label "KnowledgeConversions" ;
    rdfs:comment "Recorded shifts of process knowledge between tacit and explicit form, typed by SECI conversion mode." .

effortless-ntwf:knowledgeConversionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConversions ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeConversionId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:elicitationSession a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ElicitationSessions ;
    rdfs:label "ElicitationSession" ;
    rdfs:comment "The session in which the conversion happened, when there was one." .

effortless-ntwf:resultFragment a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConversions ;
    rdfs:range effortless-ntwf:KnowledgeFragments ;
    rdfs:label "ResultFragment" ;
    rdfs:comment "The fragment the conversion produced or used." .

effortless-ntwf:conversionMode a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConversions ;
    rdfs:range xsd:string ;
    rdfs:label "ConversionMode" ;
    rdfs:comment "Socialization, Externalization, Combination or Internalization." .

effortless-ntwf:fromForm a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConversions ;
    rdfs:range xsd:string ;
    rdfs:label "FromForm" ;
    rdfs:comment "Tacit or Explicit." .

effortless-ntwf:toForm a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConversions ;
    rdfs:range xsd:string ;
    rdfs:label "ToForm" ;
    rdfs:comment "Tacit or Explicit." .

effortless-ntwf:description a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Description" ;
    rdfs:comment "What moved and how." .

effortless-ntwf:occurredAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OccurredAt" ;
    rdfs:comment "When." .

effortless-ntwf:isModeInconsistentWithForms a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeConversions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsModeInconsistentWithForms" ;
    rdfs:comment "TRUE when the recorded SECI mode does not match the forms it converts between (socialization tacit to tacit, externalization tacit to explicit, combination explicit to explicit, internalization explicit to tacit)." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

