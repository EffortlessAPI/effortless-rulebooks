    rdfs:comment "TRUE when a breaking release left consumers that were never updated and re-validated." .
    # calculated: calculated

effortless-ntwf:breakingReleaseWithoutMigrationPlan a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:boolean ;
