pko-native-procedural-knowledge-rulebook:contradictedDocumentRevisedAt a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:KnowledgeTraces ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ContradictedDocumentRevisedAt" ;
    rdfs:comment "Last revision of the contradicted document." .

pko-native-procedural-knowledge-rulebook:contradictedIsIndexed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RetrievalSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "ContradictedIsIndexed" ;
    rdfs:comment "Whether the contradicted segment is served too." .

pko-native-procedural-knowledge-rulebook:contradictsKnowledgeForm a owl:DatatypeProperty ;
    rdfs:domain pko-extension:LevelCaptureStrategy ;
    rdfs:range xsd:boolean ;
    rdfs:label "ContradictsKnowledgeForm" ;
    rdfs:comment "TRUE when tacit knowledge is to be passed on only as a stored document, or explicit knowledge only in person." .

pko-native-procedural-knowledge-rulebook:contradictsSegment a owl:ObjectProperty ;
    rdfs:domain pko-extension:RetrievalSegment ;
    rdfs:range pko-extension:RetrievalSegment ;
    rdfs:label "ContradictsSegment" ;
    rdfs:comment "A segment this one logically contradicts, as found by the consistency check." .

pko-native-procedural-knowledge-rulebook:contradictsSharedModel a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AssistantAnswer ;
    rdfs:range xsd:boolean ;
    rdfs:label "ContradictsSharedModel" ;
    rdfs:comment "TRUE when the assistant asserted a next step the procedure's transition graph does not allow." .

pko-native-procedural-knowledge-rulebook:contributingExpert a owl:ObjectProperty ;
    rdfs:domain pko-extension:CollectedSourceMaterial ;
    rdfs:range prov:Agent ;
    rdfs:label "ContributingExpert" ;
    rdfs:comment "The domain expert whose time the capture consumed." .

pko-native-procedural-knowledge-rulebook:control a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernanceStageControl ;
    rdfs:range xsd:string ;
    rdfs:label "Control" ;
    rdfs:comment "The control." .

pko-native-procedural-knowledge-rulebook:controlAssuranceState a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:string ;
    rdfs:label "ControlAssuranceState" ;
    rdfs:comment "One of Decorative, Inoperative, Asserted, Demonstrated, Holding, or Untested — the single control-health verdict for this requirement." .

pko-native-procedural-knowledge-rulebook:controlBreachCount a owl:DatatypeProperty ;
    rdfs:domain pko:ProcedureExecution ;
    rdfs:range xsd:decimal ;
    rdfs:label "ControlBreachCount" ;
    rdfs:comment "Total step executions in this run that carry at least one control breach." .

pko-native-procedural-knowledge-rulebook:controlBreachExecutionKey a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:string ;
    rdfs:label "ControlBreachExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this step execution carries ANY control breach." .

pko-native-procedural-knowledge-rulebook:controlKind a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:string ;
    rdfs:label "ControlKind" ;
    rdfs:comment "What kind of control this step is: Preparation, Approval, LegalReview, Verification, Extraction, Publication, Retrospective, or None. That policy-04 is a legal review is a property OF policy-04, not of a formula that happens to name it; storing it as data makes downstream predicates portable to procedures that do not exist yet." .

pko-native-procedural-knowledge-rulebook:controlTaxonomyIsIncomplete a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ControlTaxonomyIsIncomplete" ;
    rdfs:comment "Whether this version contains any step whose control kind is unstated — meaning role-based and id-based control predicates cannot be trusted to cover it." .

pko-native-procedural-knowledge-rulebook:controlledTerm a owl:ObjectProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range pko-extension:VocabularyTerm ;
    rdfs:label "ControlledTerm" ;
    rdfs:comment "Controlled vocabulary term this requirement's concept maps to, if any." .

pko-native-procedural-knowledge-rulebook:controlsPrecedeOwnership a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelCharter ;
    rdfs:range xsd:boolean ;
    rdfs:label "ControlsPrecedeOwnership" ;
    rdfs:comment "TRUE when governance controls were adopted before the model's first owner was named." .

pko-native-procedural-knowledge-rulebook:conversionMode a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeConversion ;
    rdfs:range xsd:string ;
    rdfs:label "ConversionMode" ;
    rdfs:comment "Socialization, Externalization, Combination or Internalization." .

pko-native-procedural-knowledge-rulebook:coordinator a owl:DatatypeProperty ;
    rdfs:domain pko-extension:OntologySupportProgramme ;
    rdfs:range xsd:string ;
    rdfs:label "Coordinator" ;
    rdfs:comment "Organization coordinating the programme." .

pko-native-procedural-knowledge-rulebook:corporateGovernanceProgramId a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CorporateGovernanceProgram ;
    rdfs:range xsd:string ;
    rdfs:label "CorporateGovernanceProgramId" ;
    rdfs:comment "Stored identifier." .

pko-native-procedural-knowledge-rulebook:corroborationCount a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:integer ;
    rdfs:label "CorroborationCount" ;
    rdfs:comment "Independent supporting data points." .

pko-native-procedural-knowledge-rulebook:cosineSimilarity a owl:DatatypeProperty ;
    rdfs:domain pko-extension:EmbeddingProbe ;
    rdfs:range xsd:decimal ;
    rdfs:label "CosineSimilarity" ;
    rdfs:comment "Measured cosine similarity." .

pko-native-procedural-knowledge-rulebook:countOfApprovalExecutions a owl:DatatypeProperty ;
    rdfs:domain pko:ProcedureExecution ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfApprovalExecutions" ;
    rdfs:comment "How many human approval gates were executed in this run." .

pko-native-procedural-knowledge-rulebook:countOfAwaitedDecisions a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfAwaitedDecisions" ;
    rdfs:comment "How many change requests name this role as the deciding authority." .

pko-native-procedural-knowledge-rulebook:countOfChangeRequests a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfChangeRequests" ;
    rdfs:comment "How many change requests have ever been raised against this version." .

pko-native-procedural-knowledge-rulebook:countOfCurrentRoleAssignments a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfCurrentRoleAssignments" ;
    rdfs:comment "How many role assignments this agent currently holds. Counts only CURRENT assignments via the CurrentAgentKey echo — counting all assignments would report a departed agent as engaged forever." .

pko-native-procedural-knowledge-rulebook:countOfDeliveryExecutions a owl:DatatypeProperty ;
    rdfs:domain pko:ProcedureExecution ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfDeliveryExecutions" ;
    rdfs:comment "How many times the send step ran in this execution." .

pko-native-procedural-knowledge-rulebook:countOfFromStepExecutions a owl:DatatypeProperty ;
    rdfs:domain pko:Transition ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfFromStepExecutions" ;
    rdfs:comment "How many times the step this transition leaves from has actually been executed." .

pko-native-procedural-knowledge-rulebook:countOfObservedTraversals a owl:DatatypeProperty ;
    rdfs:domain pko:Transition ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfObservedTraversals" ;
    rdfs:comment "How many times this exact transition has actually been traversed." .

pko-native-procedural-knowledge-rulebook:countOfOpenBlockingGaps a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfOpenBlockingGaps" ;
    rdfs:comment "How many open blocking gaps stand against this version." .

pko-native-procedural-knowledge-rulebook:countOfOpenKnowledgeGaps a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfOpenKnowledgeGaps" ;
    rdfs:comment "Open knowledge gaps for this version." .

pko-native-procedural-knowledge-rulebook:countOfOverdueGaps a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfOverdueGaps" ;
    rdfs:comment "How many acknowledged unknowns against this version have outlived their tolerance." .

pko-native-procedural-knowledge-rulebook:countOfReviewEvents a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfReviewEvents" .

pko-native-procedural-knowledge-rulebook:countOfStaleFragments a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfStaleFragments" ;
    rdfs:comment "How many supporting claims have outlived this version's review cadence." .

pko-native-procedural-knowledge-rulebook:countOfSteps a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfSteps" ;
    rdfs:comment "Number of steps in this version." .

pko-native-procedural-knowledge-rulebook:countOfStewardshipAssignments a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfStewardshipAssignments" ;
    rdfs:comment "How many stewardship assignments of any vintage point at this version." .

pko-native-procedural-knowledge-rulebook:countOfToStepExecutions a owl:DatatypeProperty ;
    rdfs:domain pko:Transition ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfToStepExecutions" ;
    rdfs:comment "How many times the step this transition arrives at has actually been executed." .

pko-native-procedural-knowledge-rulebook:countOfUnapprovedRelianceFragments a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfUnapprovedRelianceFragments" ;
    rdfs:comment "How many unapproved claims this version is relying on." .

