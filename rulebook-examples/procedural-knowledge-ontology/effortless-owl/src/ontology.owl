    rdfs:range xsd:boolean ;
    rdfs:label "IsInsideQuietWindow" ;
    rdfs:comment "TRUE when the recipient-local send hour falls inside the declared quiet window, handling the midnight wrap correctly." .

pko-native-procedural-knowledge-rulebook:isInstanceChangeInSchemaRelease a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInstanceChangeInSchemaRelease" ;
    rdfs:comment "TRUE when an instance data change was versioned as a schema release instead of a data version." .

pko-native-procedural-knowledge-rulebook:isInterestedPartyAssertion a owl:DatatypeProperty ;
