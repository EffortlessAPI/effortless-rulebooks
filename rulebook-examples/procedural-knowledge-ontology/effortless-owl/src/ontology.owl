effortless-ntwf:specificationShortfallCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SourcingFunctions ;
    rdfs:range xsd:integer ;
    rdfs:label "SpecificationShortfallCount" ;
    rdfs:comment "Specification items where the client holds less than it needs." .
