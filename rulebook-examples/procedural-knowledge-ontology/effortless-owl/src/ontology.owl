pko-native-procedural-knowledge-rulebook:hasUnreachableExceptionInvoked a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnreachableExceptionInvoked" ;
    rdfs:comment "TRUE when the documented unreachable-recipient exception was formally invoked on this delivery." .

pko-native-procedural-knowledge-rulebook:hasUnreconciledVariantPhrasings a owl:DatatypeProperty ;
    rdfs:domain pko-extension:VocabularyTerm ;
    rdfs:range xsd:boolean ;
