effortless-ntwf:sourcingFunction a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:SourcingFunctions ;
    rdfs:label "SourcingFunction" ;
    rdfs:comment "Function the provider performs." .

effortless-ntwf:startedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "StartedAt" ;
    rdfs:comment "When the engagement started." .

effortless-ntwf:termMonths a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:integer ;
    rdfs:label "TermMonths" ;
    rdfs:comment "Contract term in months." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Active or Ended." .

effortless-ntwf:documentationOwnership a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:string ;
    rdfs:label "DocumentationOwnership" ;
    rdfs:comment "ProviderIP when the documentation the provider produces stays its intellectual property; ClientOwned or Joint otherwise." .

effortless-ntwf:knowledgeDutyTerms a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeDutyTerms" ;
    rdfs:comment "Any duty the provider carries to build up the client's knowledge; blank when there is none." .

effortless-ntwf:providerTreatsKnowHowAsDifferentiator a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:boolean ;
    rdfs:label "ProviderTreatsKnowHowAsDifferentiator" ;
    rdfs:comment "TRUE when the provider positions its procedural know-how as its competitive differentiator." .

effortless-ntwf:hasKnowledgeAccessClause a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasKnowledgeAccessClause" ;
    rdfs:comment "TRUE when the contract gives the client access to the process knowledge needed to run the operation." .

effortless-ntwf:knowledgeReturnPlan a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProviderEngagements ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeReturnPlan" ;
    rdfs:comment "How the knowledge comes back to the client; blank when nobody planned it." .

effortless-ntwf:isActive a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsActive" ;
    rdfs:comment "TRUE for a running engagement." .
