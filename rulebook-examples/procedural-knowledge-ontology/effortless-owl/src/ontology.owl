    rdfs:range xsd:boolean ;
    rdfs:label "RestsOnNotationOnly" ;
    rdfs:comment "TRUE when some steps of the version carry no ontology type, so they mean nothing outside the diagram they came from." .

pko-native-procedural-knowledge-rulebook:restsOnSingleDataPoint a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
