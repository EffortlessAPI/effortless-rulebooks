effortless-ntwf:AiInsightProposals a owl:Class ;
    rdfs:label "AiInsightProposals" ;
    rdfs:comment "Insight an AI produced about a process, and whether it was validated and folded back into the knowledge base." .

effortless-ntwf:aiInsightProposalId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiInsightProposals ;
    rdfs:range xsd:string ;
    rdfs:label "AiInsightProposalId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:proposingAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AiInsightProposals ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ProposingAgent" ;
    rdfs:comment "AI agent." .

effortless-ntwf:sourceInitiative a owl:ObjectProperty ;
