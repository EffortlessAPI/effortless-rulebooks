effortless-ntwf:capturedMaterialCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectionOccasions ;
    rdfs:range xsd:integer ;
    rdfs:label "CapturedMaterialCount" ;
    rdfs:comment "Collected materials captured at the occasion." .
