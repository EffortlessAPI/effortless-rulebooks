    # calculated: aggregation

effortless-ntwf:coverageGapCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SourcingFunctions ;
    rdfs:range xsd:integer ;
    rdfs:label "CoverageGapCount" ;
    rdfs:comment "Audit items that found knowledge nobody available to the client holds." .
    # calculated: aggregation

effortless-ntwf:specificationAuditCount a owl:DatatypeProperty ;
