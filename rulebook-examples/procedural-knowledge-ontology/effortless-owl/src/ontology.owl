effortless-ntwf:currentAuthorityRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentAuthorityRole" ;
    rdfs:comment "Authority role of the charter in force." .
