effortless-ntwf:inconsistentDisjointnessCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:integer ;
    rdfs:label "InconsistentDisjointnessCount" ;
    rdfs:comment "Disjointness axioms making individuals inconsistent." .
