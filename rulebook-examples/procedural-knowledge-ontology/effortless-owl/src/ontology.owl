effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: TableConformance ===
effortless-ntwf:TableConformance a owl:Class ;
    rdfs:label "TableConformance" ;
    rdfs:comment "Latest run only: how one substrate did on one table. The grid of these rows is the substrate-by-table heatmap." .

effortless-ntwf:tableConformanceId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TableConformance ;
    rdfs:range xsd:string ;
    rdfs:label "TableConformanceId" ;
    rdfs:comment "Stored logical identifier: '<substrate>|<Table>'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:run a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ConformanceRuns ;
    rdfs:label "Run" ;
    rdfs:comment "The run this row describes." .

effortless-ntwf:substrate a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ConformanceSubstrates ;
    rdfs:label "Substrate" ;
    rdfs:comment "The substrate graded." .

effortless-ntwf:rulebookTable a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RulebookTables ;
    rdfs:label "RulebookTable" ;
    rdfs:comment "The table graded." .

effortless-ntwf:recordCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TableConformance ;
    rdfs:range xsd:string ;
    rdfs:label "RecordCount" ;
    rdfs:comment "Rows in the answer key for this table." .

effortless-ntwf:derivedFieldCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TableConformance ;
    rdfs:range xsd:string ;
    rdfs:label "DerivedFieldCount" ;
    rdfs:comment "Derived fields graded on this table." .

effortless-ntwf:cellsTested a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CellsTested" ;
    rdfs:comment "RecordCount x DerivedFieldCount." .

effortless-ntwf:cellsPassed a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CellsPassed" ;
    rdfs:comment "Cells matching the answer key." .

effortless-ntwf:isMissingAnswerFile a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TableConformance ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMissingAnswerFile" ;
    rdfs:comment "True when the substrate produced no answers for this table at all; every cell then counts as failed." .

effortless-ntwf:cellsFailed a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CellsFailed" ;
    rdfs:comment "Cells that did not match." .
    # calculated: calculated

effortless-ntwf:score a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Score" ;
    rdfs:comment "Percent of cells matching." .
    # calculated: calculated

effortless-ntwf:isPerfect a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPerfect" ;
    rdfs:comment "True when every cell matched." .
    # calculated: calculated

effortless-ntwf:imperfectSubstrateKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TableConformance ;
    rdfs:range xsd:string ;
    rdfs:label "ImperfectSubstrateKey" ;
    rdfs:comment "The substrate id when this table is imperfect, else blank." .
    # calculated: calculated

effortless-ntwf:imperfectTableKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TableConformance ;
    rdfs:range xsd:string ;
    rdfs:label "ImperfectTableKey" ;
    rdfs:comment "The table id when this table is imperfect, else blank." .
    # calculated: calculated

effortless-ntwf:disagreeingFieldCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DisagreeingFieldCount" ;
    rdfs:comment "Fields on this table the substrate got at least one cell wrong." .
    # calculated: aggregation

effortless-ntwf:substrateLabel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SubstrateLabel" ;
    rdfs:comment "The substrate's short label." .
    # calculated: lookup

effortless-ntwf:subjectArea a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SubjectArea" ;
    rdfs:comment "The table's subject area." .
    # calculated: lookup

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

