effortless-ntwf:requestedByAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "RequestedByAgent" ;
    rdfs:comment "Requester." .

effortless-ntwf:requestedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RequestedAt" ;
    rdfs:comment "When requested." .

effortless-ntwf:motivatingQuestion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RoleQuestions ;
    rdfs:label "MotivatingQuestion" ;
    rdfs:comment "Competency question that motivates the change." .

effortless-ntwf:motivationKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "MotivationKind" ;
    rdfs:comment "ExistingQuestionNowFails or NewQuestionNeeded." .

effortless-ntwf:changeLayer a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeLayer" ;
    rdfs:comment "Schema, Instance, Vocabulary or Documentation." .

effortless-ntwf:changeOperation a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeOperation" ;
    rdfs:comment "AddClass, AddProperty, RenameClass, RemoveClass, ChangeDomainRange, AddDisjointness, AddVocabularyTerm, AddInstances, ReassignAgent, MoveStepToHuman, CreateDefinition, RetireDefinition." .

effortless-ntwf:classification a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "Classification" ;
    rdfs:comment "DataOperation or ModelingChange." .

effortless-ntwf:route a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Route" ;
    rdfs:comment "DataOperations or Governance: the process the request actually went through." .

effortless-ntwf:declaredScale a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DeclaredScale" ;
    rdfs:comment "Patch, Minor or Major as the proposer declared it." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Submitted, ReturnedForClarification, UnderImpactAssessment, Approved, Rejected or Deployed." .

effortless-ntwf:impactAssessment a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ImpactAssessment" ;
