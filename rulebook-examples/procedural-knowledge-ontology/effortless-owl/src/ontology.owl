effortless-ntwf:deviatingDayVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "DeviatingDayVersionKey" ;
    rdfs:comment "Version key for a deviating day-shift run." .
    # calculated: calculated

effortless-ntwf:deviatingNightVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "DeviatingNightVersionKey" ;
    rdfs:comment "Version key for a deviating night-shift run." .
    # calculated: calculated

effortless-ntwf:statusChangeCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:integer ;
    rdfs:label "StatusChangeCount" ;
    rdfs:comment "Status changes recorded against the execution itself." .
    # calculated: aggregation

effortless-ntwf:claimsCompletionWithoutAllSteps a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ClaimsCompletionWithoutAllSteps" ;
    rdfs:comment "TRUE when an execution is marked completed but not every specified step completed." .
    # calculated: calculated

effortless-ntwf:isUnconfirmedCompletion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnconfirmedCompletion" ;
    rdfs:comment "TRUE when an execution completed with nobody recorded as confirming it." .
    # calculated: calculated

effortless-ntwf:hasNoRecordedOutcome a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoRecordedOutcome" ;
    rdfs:comment "TRUE when an execution records no outcome." .
    # calculated: calculated

effortless-ntwf:feedbackCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:integer ;
    rdfs:label "FeedbackCount" ;
    rdfs:comment "Feedback filed about the execution." .
    # calculated: aggregation

effortless-ntwf:isUnreportedMistake a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnreportedMistake" ;
    rdfs:comment "TRUE when an execution deviated from its steps and nobody filed any feedback about it." .
    # calculated: calculated

effortless-ntwf:ownerOrganization a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OwnerOrganization" ;
    rdfs:comment "The organization that owns the procedure this row belongs to, one hop at a time from Procedures.OwnerOrganization. A row policy compares it to the caller's organization, so a plant sign-in never sees the finance close." .
    # calculated: lookup

effortless-ntwf:stoppedAtKnowledgeGap a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range effortless-ntwf:KnowledgeGaps ;
    rdfs:label "StoppedAtKnowledgeGap" ;
    rdfs:comment "The knowledge gap this run stopped at: the procedure had no answer, so the run ended instead of someone guessing." .

effortless-ntwf:stoppedAtGapStatement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "StoppedAtGapStatement" ;
    rdfs:comment "What nobody knows, in the gap this run stopped at." .
    # calculated: lookup

effortless-ntwf:stoppedAtGapStatus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "StoppedAtGapStatus" ;
    rdfs:comment "Whether the gap this run stopped at is still open." .
    # calculated: lookup

effortless-ntwf:stoppedAtGapChangeTitle a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "StoppedAtGapChangeTitle" ;
    rdfs:comment "The change to the book that answers the gap this run stopped at." .
    # calculated: lookup

effortless-ntwf:stoppedAtGapChangeStatus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "StoppedAtGapChangeStatus" ;
    rdfs:comment "Where the change that answers this run's gap has got to." .
    # calculated: lookup

