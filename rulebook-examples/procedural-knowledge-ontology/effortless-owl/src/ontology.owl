pko-native-procedural-knowledge-rulebook:coveringTable a owl:ObjectProperty ;
    rdfs:range pko-extension:RulebookTable ;
    rdfs:label "CoveringTable" .

pko-native-procedural-knowledge-rulebook:coversCompliance a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CorporateGovernanceProgram ;
    rdfs:range xsd:boolean ;
    rdfs:label "CoversCompliance" ;
    rdfs:comment "Scope includes regulatory compliance and legal risk." .

pko-native-procedural-knowledge-rulebook:coversDataQuality a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CorporateGovernanceProgram ;
    rdfs:range xsd:boolean ;
    rdfs:label "CoversDataQuality" ;
    rdfs:comment "Scope includes data quality." .

pko-native-procedural-knowledge-rulebook:coversInformationManagement a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CorporateGovernanceProgram ;
    rdfs:range xsd:boolean ;
    rdfs:label "CoversInformationManagement" ;
    rdfs:comment "Scope includes information management." .

pko-native-procedural-knowledge-rulebook:coversKnowledgeManagement a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CorporateGovernanceProgram ;
    rdfs:range xsd:boolean ;
    rdfs:label "CoversKnowledgeManagement" ;
    rdfs:comment "Scope includes knowledge management." .

pko-native-procedural-knowledge-rulebook:coversNow a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
    rdfs:label "CoversNow" ;
    rdfs:comment "TRUE when this assignment is both status-Active and inside its valid-time window right now." .

pko-native-procedural-knowledge-rulebook:cqCoverageDeclined a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    rdfs:range xsd:boolean ;
    rdfs:label "CqCoverageDeclined" ;
    rdfs:comment "TRUE when the release answers a smaller share of its questions than the previous release did." .

pko-native-procedural-knowledge-rulebook:cqCoveragePercent a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    rdfs:range xsd:decimal ;
    rdfs:label "CqCoveragePercent" ;
    rdfs:comment "Share of the question runs the release could answer." .

pko-native-procedural-knowledge-rulebook:cqReviewCount a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:integer ;
    rdfs:label "CqReviewCount" ;
    rdfs:comment "Competency question set reviews held." .

pko-native-procedural-knowledge-rulebook:cqReviewOverdue a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "CqReviewOverdue" ;
    rdfs:comment "TRUE when the competency question set has gone more than a quarter (92 days) without review." .

pko-native-procedural-knowledge-rulebook:cqRunCount a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    rdfs:range xsd:integer ;
    rdfs:label "CqRunCount" ;
    rdfs:comment "Competency questions run as tasks against the release." .

pko-native-procedural-knowledge-rulebook:cqSetEntry a owl:ObjectProperty ;
    rdfs:domain pko-extension:CompetencyQuestionRun ;
    rdfs:range pko-extension:CompetencyQuestionSetEntry ;
    rdfs:label "CqSetEntry" ;
    rdfs:comment "Question." .

pko-native-procedural-knowledge-rulebook:createdAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "CreatedAt" .

pko-native-procedural-knowledge-rulebook:createdByAgent a owl:ObjectProperty ;
    rdfs:range prov:Agent ;
    rdfs:seeAlso <http://purl.org/dc/terms/creator> ;
    rdfs:label "CreatedByAgent" .

pko-native-procedural-knowledge-rulebook:createdByAgentKind a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "CreatedByAgentKind" ;
    rdfs:comment "Kind of agent that created the version." .

pko-native-procedural-knowledge-rulebook:creditsSourceExpert a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeRepositoryEntry ;
    rdfs:range xsd:boolean ;
    rdfs:label "CreditsSourceExpert" ;
    rdfs:comment "TRUE when the entry names and credits the source expert." .

pko-native-procedural-knowledge-rulebook:criticalIncidentCount a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CriticalIncidentCount" ;
    rdfs:comment "Critical incidents collected for the version." .

pko-native-procedural-knowledge-rulebook:criticalIncidentId a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CriticalIncident ;
    rdfs:range xsd:string ;
    rdfs:label "CriticalIncidentId" ;
    rdfs:comment "Stored identifier." .

pko-native-procedural-knowledge-rulebook:cue a owl:DatatypeProperty ;
    rdfs:domain pko-extension:PractitionerExpertise ;
    rdfs:range xsd:string ;
    rdfs:label "Cue" ;
    rdfs:comment "What the practitioner senses or judges." .

pko-native-procedural-knowledge-rulebook:cueCount a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:integer ;
