effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: IntegrationPathways ===
effortless-ntwf:IntegrationPathways a owl:Class ;
    rdfs:label "IntegrationPathways" ;
    rdfs:comment "Shared pathways agents reach knowledge through (a Model Context Protocol server, an agent-to-agent gateway) versus one-off connections." .

effortless-ntwf:integrationPathwayId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IntegrationPathways ;
    rdfs:range xsd:string ;
    rdfs:label "IntegrationPathwayId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Pathway." .

effortless-ntwf:protocol a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IntegrationPathways ;
    rdfs:range xsd:string ;
    rdfs:label "Protocol" ;
    rdfs:comment "MCP, A2A, custom or none." .

effortless-ntwf:integrationCountOnPathway a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IntegrationPathways ;
    rdfs:range xsd:integer ;
