pko-native-procedural-knowledge-rulebook:lastReviewedAt a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastReviewedAt" ;
    rdfs:comment "When this fragment was last actually reviewed and reaffirmed by its owning role. Null when it has never been reviewed since authoring. IsOverdueForReview infers recency from ValidFrom, which records when the claim became TRUE, not when anyone last looked at it. Those are different events, and the inference is deliberately left in place under its own name rather than silently rewritten to fall back on this column." .

pko-native-procedural-knowledge-rulebook:lastRevisedAt a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:OntologyProfiles ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastRevisedAt" ;
    rdfs:comment "When the standard last published any revision." .

pko-native-procedural-knowledge-rulebook:lastRunAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastRunAt" .

pko-native-procedural-knowledge-rulebook:lastStewardActivityAt a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastStewardActivityAt" ;
    rdfs:comment "Most recent recorded steward activity on the model." .

pko-native-procedural-knowledge-rulebook:lastUpdatedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastUpdatedAt" .

pko-native-procedural-knowledge-rulebook:lastValidApproval a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "LastValidApproval" ;
    rdfs:comment "The TemplateApprovals id of the approval this template is currently sendable under. Deliberately a raw identifier, not a relationship: TemplateApprovals already points at MessageTemplates, so declaring an FK back would make the two tables mutually dependent and the rulebook is required to stay acyclic. The value is still resolved by INDEX/MATCH in LastApprovedBodyHash." .

