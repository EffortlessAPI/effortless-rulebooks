pko-native-procedural-knowledge-rulebook:lastApprovedBodyHash a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "LastApprovedBodyHash" ;
    rdfs:comment "Digest of the body text as it stood at the most recent valid approval." .

pko-native-procedural-knowledge-rulebook:lastConsultedAt a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeBrokerLink ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastConsultedAt" ;
    rdfs:comment "When the seeker last actually consulted the broker on this topic." .

pko-native-procedural-knowledge-rulebook:lastCqReviewAt a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:dateTime ;
