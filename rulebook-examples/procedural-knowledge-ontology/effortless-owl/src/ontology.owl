effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "Step execution." .

effortless-ntwf:stepCue a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:CueObservations ;
    rdfs:range effortless-ntwf:StepCues ;
    rdfs:label "StepCue" ;
    rdfs:comment "Cue observed." .

effortless-ntwf:observedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ObservedAt" ;
