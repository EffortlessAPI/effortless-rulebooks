pko-native-procedural-knowledge-rulebook:hinderedByCount a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "HinderedByCount" ;
    rdfs:comment "Operations that work against this one." .

pko-native-procedural-knowledge-rulebook:hinderedProcedureKey a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcessInterdependency ;
    rdfs:range xsd:string ;
    rdfs:label "HinderedProcedureKey" ;
