effortless-ntwf:hinderedProcedureKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessInterdependencies ;
    rdfs:range xsd:string ;
    rdfs:label "HinderedProcedureKey" ;
    rdfs:comment "Procedure key when hindered." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ProcessKnowledgeLevels ===
effortless-ntwf:ProcessKnowledgeLevels a owl:Class ;
