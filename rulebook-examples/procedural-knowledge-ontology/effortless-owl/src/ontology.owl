    rdfs:range xsd:string ;
    rdfs:label "KnowledgeAccessScore" ;
    rdfs:comment "Access to process knowledge, 0 to 100." .

effortless-ntwf:errorRatePercent a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ErrorRatePercent" ;
    rdfs:comment "Error rate." .

effortless-ntwf:minutesPerRun a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeOutcomeMeasurements ;
    rdfs:range xsd:string ;
    rdfs:label "MinutesPerRun" ;
    rdfs:comment "Efficiency: minutes per run." .

effortless-ntwf:satisfactionScore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeOutcomeMeasurements ;
    rdfs:range xsd:string ;
    rdfs:label "SatisfactionScore" ;
    rdfs:comment "Customer satisfaction, 1 to 5." .

effortless-ntwf:efficiencyGainPercent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeOutcomeMeasurements ;
    rdfs:range xsd:string ;
