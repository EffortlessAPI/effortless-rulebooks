effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: InterviewProbes ===
effortless-ntwf:InterviewProbes a owl:Class ;
    rdfs:label "InterviewProbes" ;
    rdfs:comment "Questions put in an elicitation interview, typed by what they probe: why a choice is made, what the practitioner would do if a condition changed, or what happens when the procedure falls short." .

effortless-ntwf:interviewProbeId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InterviewProbes ;
    rdfs:range xsd:string ;
    rdfs:label "InterviewProbeId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:elicitationSession a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ElicitationSessions ;
    rdfs:label "ElicitationSession" ;
    rdfs:comment "The interview the probe was asked in." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "The step the probe is about." .

effortless-ntwf:probeKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InterviewProbes ;
    rdfs:range xsd:string ;
    rdfs:label "ProbeKind" ;
    rdfs:comment "Why, WhatIf or ProcedureFallsShort." .

effortless-ntwf:prompt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InterviewProbes ;
    rdfs:range xsd:string ;
    rdfs:label "Prompt" ;
    rdfs:comment "The question asked." .

effortless-ntwf:answer a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Answer" ;
    rdfs:comment "The practitioner's answer." .

effortless-ntwf:whyAnswer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InterviewProbes ;
    rdfs:range xsd:string ;
    rdfs:label "WhyAnswer" ;
    rdfs:comment "The reason a practitioner gave for a choice." .
    # calculated: calculated

effortless-ntwf:shortfallAnswer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InterviewProbes ;
    rdfs:range xsd:string ;
    rdfs:label "ShortfallAnswer" ;
    rdfs:comment "What the practitioner does when the standard procedure proves insufficient." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: IssueOccurrences ===
effortless-ntwf:IssueOccurrences a owl:Class ;
    rdfs:label "IssueOccurrences" ;
    rdfs:comment "Concrete issue events during execution. Maps to pko:IssueOccurrence, hasEncounteredError, wasEncounteredBy, issueCause, and issueSolution." .

effortless-ntwf:issueOccurrenceId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range xsd:string ;
    rdfs:label "IssueOccurrenceId" ;
    rdfs:comment "Stored logical identifier for one IssueOccurrences row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the IssueOccurrences row." .
    # calculated: calculated

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "Step execution during which the issue occurred." .

effortless-ntwf:error a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range effortless-ntwf:Errors ;
    rdfs:label "Error" ;
    rdfs:comment "Error encountered." .

effortless-ntwf:encounteredByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "EncounteredByAgent" ;
    rdfs:comment "Agent that encountered or reported the issue." .

effortless-ntwf:occurredAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OccurredAt" ;
    rdfs:comment "Occurrence time." .

effortless-ntwf:issueCause a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range xsd:string ;
    rdfs:label "IssueCause" ;
    rdfs:comment "Execution-specific cause; maps to pko:issueCause." .

effortless-ntwf:issueSolution a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range xsd:string ;
    rdfs:label "IssueSolution" ;
    rdfs:comment "Applied solution; maps to pko:issueSolution." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Open, Monitoring, Resolved, or Closed." .

effortless-ntwf:isUnresolved a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnresolved" ;
    rdfs:comment "TRUE when this issue occurrence has not been closed out." .
    # calculated: calculated

effortless-ntwf:stepExecutionWhenUnresolved a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range xsd:string ;
    rdfs:label "StepExecutionWhenUnresolved" ;
    rdfs:comment "Echoes the step-execution id when the issue is unresolved, blank otherwise." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

effortless-ntwf:executedStep a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ExecutedStep" ;
    rdfs:comment "Step the issue occurred on." .
    # calculated: lookup

effortless-ntwf:failedConditionCountOnRun a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range xsd:integer ;
    rdfs:label "FailedConditionCountOnRun" ;
    rdfs:comment "Conditions that did not hold on the same step execution." .
    # calculated: aggregation

effortless-ntwf:coincidedWithFailedCondition a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range xsd:boolean ;
    rdfs:label "CoincidedWithFailedCondition" ;
    rdfs:comment "TRUE when the issue occurred on a step execution where a checked condition did not hold." .
    # calculated: calculated

effortless-ntwf:hasNoRecordedSolution a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoRecordedSolution" ;
    rdfs:comment "TRUE when an issue records no solution." .
    # calculated: calculated

effortless-ntwf:redesignChangeRequest a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range effortless-ntwf:ChangeRequests ;
    rdfs:label "RedesignChangeRequest" ;
    rdfs:comment "The change request that redesigned the procedure in response to the failure." .

effortless-ntwf:redesignImplementedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range xsd:string ;
    rdfs:label "RedesignImplementedAt" ;
    rdfs:comment "When that redesign was implemented." .
    # calculated: lookup

effortless-ntwf:isFailureWithoutLandedRedesign a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFailureWithoutLandedRedesign" ;
    rdfs:comment "TRUE when a recorded failure has no redesign, or its redesign never landed." .
    # calculated: calculated

effortless-ntwf:improvementCyclePath a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range xsd:string ;
    rdfs:label "ImprovementCyclePath" ;
    rdfs:comment "Failure observed, how it was recorded, and the redesign that followed." .
    # calculated: calculated

# === Class: IssuedTokens ===
effortless-ntwf:IssuedTokens a owl:Class ;
    rdfs:label "IssuedTokens" ;
    rdfs:comment "Audit trail of every token minted. A token records which user signed in, which principal they chose, and the claims that were joined from the database at mint time -- so a later question of 'what could this session see' is answerable from data rather than reconstruction." .

effortless-ntwf:issuedTokenId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssuedTokens ;
    rdfs:range xsd:string ;
    rdfs:label "IssuedTokenId" ;
    rdfs:comment "Stored logical identifier for one mint event." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:appUser a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:AppUsers ;
    rdfs:label "AppUser" ;
    rdfs:comment "Identity that signed in." .

effortless-ntwf:principal a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:AccessPrincipals ;
    rdfs:label "Principal" ;
    rdfs:comment "Principal the token authorises." .

effortless-ntwf:issuedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "IssuedAt" ;
    rdfs:comment "When the token was minted." .

effortless-ntwf:expiresAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssuedTokens ;
    rdfs:range xsd:string ;
    rdfs:label "ExpiresAt" ;
    rdfs:comment "When the token stops being accepted." .

effortless-ntwf:issuer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssuedTokens ;
    rdfs:range xsd:string ;
    rdfs:label "Issuer" ;
    rdfs:comment "Who minted it: 'dev-mint' locally, or the magic-links tenant URL in production." .

effortless-ntwf:subjectClaim a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssuedTokens ;
    rdfs:range xsd:string ;
    rdfs:label "SubjectClaim" ;
    rdfs:comment "The 'sub' claim: the AppUserId the bearer is asserted to be." .

effortless-ntwf:claimsSnapshot a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssuedTokens ;
    rdfs:range xsd:string ;
    rdfs:label "ClaimsSnapshot" ;
    rdfs:comment "JSON of the additional claims joined from the database at mint time." .

effortless-ntwf:isDevMinted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssuedTokens ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDevMinted" ;
    rdfs:comment "True when issued by the local dev minter rather than a real magic-links tenant. Dev tokens are genuine RS256 tokens with a genuine keypair; they simply skip the email round-trip." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: JwtClaimMappings ===
effortless-ntwf:JwtClaimMappings a owl:Class ;
    rdfs:label "JwtClaimMappings" ;
    rdfs:comment "Maps verified JWT claims onto the SQL accessors row predicates call. Magic-links is the notary: it asserts only that the bearer controls an email address. This table records how that verified email, and any additional claims, become values a policy can test." .

effortless-ntwf:jwtClaimMappingId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:JwtClaimMappings ;
    rdfs:range xsd:string ;
    rdfs:label "JwtClaimMappingId" ;
    rdfs:comment "Stored logical identifier, e.g. 'claim-email'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:claimName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:JwtClaimMappings ;
    rdfs:range xsd:string ;
    rdfs:label "ClaimName" ;
    rdfs:comment "Claim key as it appears in the verified JWT payload, e.g. 'email'." .

effortless-ntwf:sqlAccessor a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:JwtClaimMappings ;
    rdfs:range xsd:string ;
    rdfs:label "SqlAccessor" ;
    rdfs:comment "SQL function a policy calls to read the claim, e.g. 'app.jwt_email()'." .

effortless-ntwf:isReservedClaim a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:JwtClaimMappings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReservedClaim" ;
    rdfs:comment "True for claims magic-links controls and an app cannot override: email, iss, iat, nbf, exp, sub, tenant_id." .

effortless-ntwf:mapsToPrincipal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:JwtClaimMappings ;
    rdfs:range xsd:boolean ;
    rdfs:label "MapsToPrincipal" ;
    rdfs:comment "True when this claim is what resolves the caller to an AccessPrincipals row." .

effortless-ntwf:description2 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:JwtClaimMappings ;
    rdfs:range xsd:string ;
    rdfs:label "Description2" ;
    rdfs:comment "What the claim asserts and who vouches for it." .

effortless-ntwf:usageCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "UsageCount" ;
    rdfs:comment "Number of policies whose predicate calls this accessor." .
    # calculated: aggregation

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: KnowHowCarriers ===
effortless-ntwf:KnowHowCarriers a owl:Class ;
    rdfs:label "KnowHowCarriers" ;
    rdfs:comment "One piece of an organization's process know-how and what carries it: a person, a facility or a system, with the community it belongs to, the forms it is held in, and how long it took to build." .

effortless-ntwf:knowHowCarrierId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:string ;
    rdfs:label "KnowHowCarrierId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:topic a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Topic" ;
    rdfs:comment "What the know-how is about." .

effortless-ntwf:organization a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "Organization" ;
    rdfs:comment "The organization whose know-how this is." .

effortless-ntwf:procedure a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Procedures ;
    rdfs:label "Procedure" ;
    rdfs:comment "The procedure the know-how serves." .

effortless-ntwf:communityOfPractice a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:CommunitiesOfPractice ;
    rdfs:label "CommunityOfPractice" ;
    rdfs:comment "The community in which the know-how circulates." .

effortless-ntwf:carrierKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:string ;
    rdfs:label "CarrierKind" ;
    rdfs:comment "Person, Facility or System." .

effortless-ntwf:holderAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "HolderAgent" ;
    rdfs:comment "The person who carries it, when the carrier is a person." .

effortless-ntwf:holderFacility a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range effortless-ntwf:Facilities ;
    rdfs:label "HolderFacility" ;
    rdfs:comment "The plant that carries it in its layout and equipment, when the carrier is a facility." .

effortless-ntwf:knowHowKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:string ;
    rdfs:label "KnowHowKind" ;
    rdfs:comment "WhatFails, Diagnosis, Improvisation or Refinement: the kind of practitioner know-how." .

effortless-ntwf:isInWrittenProcedure a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInWrittenProcedure" ;
    rdfs:comment "TRUE when the know-how is written into a procedure." .

effortless-ntwf:isTrainedSkill a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTrainedSkill" ;
    rdfs:comment "TRUE when the know-how is carried as trained skill of seasoned workers." .

effortless-ntwf:workMedium a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:string ;
    rdfs:label "WorkMedium" ;
    rdfs:comment "Physical or Digital work." .

effortless-ntwf:heldSince a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:string ;
    rdfs:label "HeldSince" ;
    rdfs:comment "When the carrier began to hold the know-how." .

effortless-ntwf:buildsOnKnowHow a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range effortless-ntwf:KnowHowCarriers ;
    rdfs:label "BuildsOnKnowHow" ;
    rdfs:comment "Know-how about a related component or system this know-how depends on." .

effortless-ntwf:isInPublicReferences a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInPublicReferences" ;
    rdfs:comment "TRUE when the know-how can be found in public references." .

effortless-ntwf:replacementPlan a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:string ;
    rdfs:label "ReplacementPlan" ;
    rdfs:comment "How the organization plans to replace the know-how if lost: PublicReference, AiGeneration, Apprenticeship, or blank." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The instant the row is judged against." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The modeled evaluation instant." .
    # calculated: lookup

effortless-ntwf:holderIsStillEngaged a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "HolderIsStillEngaged" ;
    rdfs:comment "Whether the holding person still holds a current role." .
    # calculated: lookup

effortless-ntwf:holderServiceStartedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:string ;
    rdfs:label "HolderServiceStartedAt" ;
    rdfs:comment "When the holder began service." .
    # calculated: lookup

effortless-ntwf:holderDepartureAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:string ;
    rdfs:label "HolderDepartureAt" ;
    rdfs:comment "The holder's planned or actual departure." .
    # calculated: lookup

effortless-ntwf:daysUntilHolderDeparture a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysUntilHolderDeparture" ;
    rdfs:comment "Days from the evaluation instant to the holder's departure; negative once gone." .
    # calculated: calculated

effortless-ntwf:daysServedToAsOf a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysServedToAsOf" ;
    rdfs:comment "Days of service up to the evaluation instant." .
    # calculated: calculated

effortless-ntwf:daysServedToDeparture a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysServedToDeparture" ;
    rdfs:comment "Days of service up to departure." .
    # calculated: calculated

effortless-ntwf:holderTenureYears a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:string ;
    rdfs:label "HolderTenureYears" ;
    rdfs:comment "Years the holder practised: to departure when gone, else to the evaluation instant." .
    # calculated: calculated

effortless-ntwf:isVeteranHeld a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsVeteranHeld" ;
    rdfs:comment "TRUE when a person with ten or more years of practice carries the know-how." .
    # calculated: calculated

effortless-ntwf:isHolderLeavingSoon a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHolderLeavingSoon" ;
    rdfs:comment "TRUE when the holder leaves within 120 days of the evaluation instant." .
    # calculated: calculated

effortless-ntwf:transferCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:integer ;
    rdfs:label "TransferCount" ;
    rdfs:comment "Recorded transfers of this know-how to someone else." .
    # calculated: aggregation

effortless-ntwf:repositoryEntryCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "RepositoryEntryCount" ;
    rdfs:comment "Repository entries that capture this know-how." .
    # calculated: aggregation

effortless-ntwf:sourceRelationshipCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:integer ;
    rdfs:label "SourceRelationshipCount" ;
    rdfs:comment "Collection relationships with this holder on this procedure." .
    # calculated: aggregation

effortless-ntwf:isHeldInBothForms a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHeldInBothForms" ;
    rdfs:comment "TRUE when the know-how is at once a written procedure and trained skill." .
    # calculated: calculated

effortless-ntwf:isHeldByCurrentPractitioner a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHeldByCurrentPractitioner" ;
    rdfs:comment "TRUE when a person who still holds a role carries the know-how." .
    # calculated: calculated

effortless-ntwf:isUntransferredVeteranKnowHow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntransferredVeteranKnowHow" ;
    rdfs:comment "TRUE when a serving veteran carries know-how never transferred or captured." .
    # calculated: calculated

effortless-ntwf:isAtRiskOfImminentLoss a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAtRiskOfImminentLoss" ;
    rdfs:comment "TRUE when untransferred veteran know-how belongs to someone leaving within 120 days." .
    # calculated: calculated

effortless-ntwf:isHeldOnlyByDeparted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHeldOnlyByDeparted" ;
    rdfs:comment "TRUE when the only carrier has left and the know-how was neither transferred nor captured." .
    # calculated: calculated

effortless-ntwf:isHeldByDepartedHolder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHeldByDepartedHolder" ;
    rdfs:comment "TRUE when the person who carried the know-how has left." .
    # calculated: calculated

effortless-ntwf:isCaptured a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCaptured" ;
    rdfs:comment "TRUE when a repository entry captures the know-how." .
    # calculated: calculated

effortless-ntwf:mustBeRelearnedIfHolderLeaves a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "MustBeRelearnedIfHolderLeaves" ;
    rdfs:comment "TRUE when a serving holder's know-how has nothing captured for a successor." .
    # calculated: calculated

effortless-ntwf:isOverlookedLivingHolder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverlookedLivingHolder" ;
    rdfs:comment "TRUE when uncaptured know-how has a serving holder no collection relationship has approached." .
    # calculated: calculated

effortless-ntwf:transferStopsWithoutVeteran a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "TransferStopsWithoutVeteran" ;
    rdfs:comment "TRUE when veteran know-how has only been passed person to person with nothing captured, so the next newcomer still needs the veteran." .
    # calculated: calculated

effortless-ntwf:dependencyCommunity a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:string ;
    rdfs:label "DependencyCommunity" ;
    rdfs:comment "The community of the know-how this builds on." .
    # calculated: lookup

effortless-ntwf:buildsOnSameCommunityKnowHow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "BuildsOnSameCommunityKnowHow" ;
    rdfs:comment "TRUE when the know-how depends on related know-how concentrated in the same community." .
    # calculated: calculated

effortless-ntwf:lostAccumulationYears a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:string ;
    rdfs:label "LostAccumulationYears" ;
    rdfs:comment "Years of practice lost with a departed sole carrier; zero otherwise." .
    # calculated: calculated

effortless-ntwf:isDelegatedToUnfitSource a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowHowCarriers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDelegatedToUnfitSource" ;
    rdfs:comment "TRUE when the plan is to replace the know-how from public references or AI generation although it is not in public references." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: KnowledgeAuditItems ===
effortless-ntwf:KnowledgeAuditItems a owl:Class ;
    rdfs:label "KnowledgeAuditItems" ;
    rdfs:comment "One knowledge area an audit assessed: the level needed, the level the client holds, and any provider that holds it." .

effortless-ntwf:knowledgeAuditItemId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeAuditItemId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:knowledgeAudit a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range effortless-ntwf:KnowledgeAudits ;
    rdfs:label "KnowledgeAudit" ;
    rdfs:comment "Audit." .

effortless-ntwf:sourcingFunction a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:SourcingFunctions ;
    rdfs:label "SourcingFunction" ;
    rdfs:comment "Function the knowledge belongs to." .

effortless-ntwf:knowledgeArea a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeArea" ;
    rdfs:comment "What must be known." .

effortless-ntwf:knowledgeKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeKind" ;
    rdfs:comment "Specification (what is built) or Method (how it is built)." .

effortless-ntwf:neededLevel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range xsd:integer ;
    rdfs:label "NeededLevel" ;
    rdfs:comment "Level needed: 0 none, 1 aware, 2 can perform with help, 3 can perform and teach." .

effortless-ntwf:heldInternalLevel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range xsd:integer ;
    rdfs:label "HeldInternalLevel" ;
    rdfs:comment "Level the client's own people hold, on the same scale." .

effortless-ntwf:providerHoldingKnowledge a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "ProviderHoldingKnowledge" ;
    rdfs:comment "Provider that holds the knowledge, when one does." .

effortless-ntwf:providerHeldLevel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range xsd:integer ;
    rdfs:label "ProviderHeldLevel" ;
    rdfs:comment "Level the provider holds." .

effortless-ntwf:internalHoldingTeamCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range xsd:integer ;
    rdfs:label "InternalHoldingTeamCount" ;
    rdfs:comment "Internal teams that hold the knowledge at the needed level." .

effortless-ntwf:namedKnowledgeGap a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range effortless-ntwf:KnowledgeGaps ;
    rdfs:label "NamedKnowledgeGap" ;
    rdfs:comment "The knowledge gap row that names this finding." .

effortless-ntwf:clientOrganization a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ClientOrganization" ;
    rdfs:comment "The audited organization." .
    # calculated: lookup

effortless-ntwf:hasInternalShortfall a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasInternalShortfall" ;
    rdfs:comment "TRUE when the client holds less than it needs." .
    # calculated: calculated

effortless-ntwf:isKnowledgeDependency a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKnowledgeDependency" ;
    rdfs:comment "TRUE when the client falls short and relies on a provider that holds the knowledge at the needed level." .
    # calculated: calculated

effortless-ntwf:isCoverageGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCoverageGap" ;
    rdfs:comment "TRUE when the client falls short and no provider available to it holds the knowledge either." .
    # calculated: calculated

effortless-ntwf:isUnnamedFinding a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnnamedFinding" ;
    rdfs:comment "TRUE when an audit found a gap or dependency and nobody recorded it as a named knowledge gap." .
    # calculated: calculated

effortless-ntwf:isSingleTeamSilo a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAuditItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSingleTeamSilo" ;
    rdfs:comment "TRUE when knowledge the client does hold sits with exactly one internal team." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: KnowledgeAudits ===
effortless-ntwf:KnowledgeAudits a owl:Class ;
    rdfs:label "KnowledgeAudits" ;
    rdfs:comment "Audits of the procedural knowledge an organization holds against what it needs." .

effortless-ntwf:knowledgeAuditId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAudits ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeAuditId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:organization a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "Organization" ;
    rdfs:comment "Audited organization." .

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Audit title." .

effortless-ntwf:conductedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAudits ;
    rdfs:range xsd:string ;
    rdfs:label "ConductedAt" ;
    rdfs:comment "When the audit was concluded." .

effortless-ntwf:conductedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAudits ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ConductedByAgent" ;
    rdfs:comment "Who led it." .

effortless-ntwf:problemFraming a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAudits ;
    rdfs:range xsd:string ;
    rdfs:label "ProblemFraming" ;
    rdfs:comment "How the audit states its problem: KnowledgeDeficit, or CostEfficiency." .

effortless-ntwf:findingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAudits ;
    rdfs:range xsd:integer ;
    rdfs:label "FindingCount" ;
    rdfs:comment "Items where held knowledge falls short of what is needed." .
    # calculated: aggregation

effortless-ntwf:treatsDeficitAsCostProblem a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeAudits ;
    rdfs:range xsd:boolean ;
    rdfs:label "TreatsDeficitAsCostProblem" ;
    rdfs:comment "TRUE when an audit finds knowledge shortfalls but frames them as a cost or efficiency problem instead of acknowledging a knowledge deficit." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: KnowledgeBrokerLinks ===
effortless-ntwf:KnowledgeBrokerLinks a owl:Class ;
    rdfs:label "KnowledgeBrokerLinks" ;
    rdfs:comment "An informal expertise-network edge: one agent naming another as who they actually go to for a topic, independent of any formal Role or RoleAssignment. RoleAssignments and CommunitiesOfPractice record who is SUPPOSED to know something; this records who people ACTUALLY rely on." .

effortless-ntwf:knowledgeBrokerLinkId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeBrokerLinkId" ;
    rdfs:comment "Stored logical identifier for one KnowledgeBrokerLinks row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the KnowledgeBrokerLinks row." .
    # calculated: calculated

effortless-ntwf:seeker a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "Seeker" ;
    rdfs:comment "The agent who goes to someone else for this topic." .

effortless-ntwf:broker a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "Broker" ;
    rdfs:comment "The agent who is actually consulted, whether or not they hold a formal role for it." .

effortless-ntwf:topic a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:VocabularyTerms ;
    rdfs:label "Topic" ;
    rdfs:comment "The controlled topic this reliance is about." .

effortless-ntwf:frequency a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "Frequency" ;
    rdfs:comment "Rarely, Sometimes, or Often." .

effortless-ntwf:lastConsultedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "LastConsultedAt" ;
    rdfs:comment "When the seeker last actually consulted the broker on this topic." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged under." .
    # calculated: lookup

effortless-ntwf:daysSinceConsulted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceConsulted" ;
    rdfs:comment "Days elapsed since the seeker last consulted the broker." .
    # calculated: calculated

effortless-ntwf:isActiveReliance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsActiveReliance" ;
    rdfs:comment "TRUE when this is a live, ongoing informal dependency rather than a one-off or stale contact." .
    # calculated: calculated

effortless-ntwf:brokerIsStillEngaged a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:boolean ;
    rdfs:label "BrokerIsStillEngaged" ;
    rdfs:comment "Whether the broker being relied on still holds any current role at all." .
    # calculated: lookup

effortless-ntwf:isAtRiskReliance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAtRiskReliance" ;
    rdfs:comment "TRUE when someone is actively relying on a broker who has already left every role they held." .
    # calculated: calculated

effortless-ntwf:activeRelianceBrokerKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "ActiveRelianceBrokerKey" ;
    rdfs:comment "Composite-key echo: the broker this link names when the reliance is active, else blank." .
    # calculated: calculated

effortless-ntwf:atRiskBrokerKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "AtRiskBrokerKey" ;
    rdfs:comment "Composite-key echo: the broker this link names when the reliance is at risk, else blank." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

effortless-ntwf:pointsToKnowHow a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range effortless-ntwf:KnowHowCarriers ;
    rdfs:label "PointsToKnowHow" ;
    rdfs:comment "The know-how the broker points the seeker to." .

effortless-ntwf:pointedHolder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "PointedHolder" ;
    rdfs:comment "Who carries that know-how." .
    # calculated: lookup

effortless-ntwf:locatesOtherHolder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:boolean ;
    rdfs:label "LocatesOtherHolder" ;
    rdfs:comment "TRUE when the broker knows where know-how is held by someone other than themselves." .
    # calculated: calculated

effortless-ntwf:seekerVocabulary a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range effortless-ntwf:Vocabularies ;
    rdfs:label "SeekerVocabulary" ;
    rdfs:comment "The vocabulary the seeker's community speaks." .

effortless-ntwf:seekerWording a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "SeekerWording" ;
    rdfs:comment "The seeker's word for the topic." .

effortless-ntwf:holderVocabulary a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range effortless-ntwf:Vocabularies ;
    rdfs:label "HolderVocabulary" ;
    rdfs:comment "The vocabulary of the community holding the know-how." .

effortless-ntwf:holderWording a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "HolderWording" ;
    rdfs:comment "The holding community's word for the topic." .

effortless-ntwf:translationBetweenVocabularies a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "TranslationBetweenVocabularies" ;
    rdfs:comment "The broker's translation between the two communities' words; blank when none was needed." .
    # calculated: calculated

# === Class: KnowledgeCaptureInitiatives ===
effortless-ntwf:KnowledgeCaptureInitiatives a owl:Class ;
