pko-native-procedural-knowledge-rulebook:isInconsistentDisjointness a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInconsistentDisjointness" ;
