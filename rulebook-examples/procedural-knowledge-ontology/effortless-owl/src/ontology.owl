effortless-ntwf:providerIpDocumentationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SourcingFunctions ;
    rdfs:range xsd:integer ;
    rdfs:label "ProviderIpDocumentationCount" ;
