pko-native-procedural-knowledge-rulebook:isInLatestRun a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SubstrateRunScore ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInLatestRun" ;
    rdfs:comment "Whether this grade belongs to the latest run." .

pko-native-procedural-knowledge-rulebook:isInNav a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AppRoute ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInNav" ;
    rdfs:comment "Whether this route appears in the left navigation. Detail routes do not." .

pko-native-procedural-knowledge-rulebook:isInPublicReferences a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInPublicReferences" ;
    rdfs:comment "TRUE when the know-how can be found in public references." .

pko-native-procedural-knowledge-rulebook:isInWrittenProcedure a owl:DatatypeProperty ;
