effortless-ntwf:deviatingStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:integer ;
    rdfs:label "DeviatingStepCount" ;
    rdfs:comment "Step executions that recorded a deviation." .
