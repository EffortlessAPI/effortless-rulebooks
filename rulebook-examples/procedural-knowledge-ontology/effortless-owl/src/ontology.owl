pko-native-procedural-knowledge-rulebook:isLegalReviewStep a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLegalReviewStep" ;
    rdfs:comment "TRUE for executions of the legal and privacy review step." .

pko-native-procedural-knowledge-rulebook:isLive a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLive" ;
    rdfs:comment "TRUE when this version is in a state where somebody could execute it." .

pko-native-procedural-knowledge-rulebook:isLiveAndUnstewarded a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveAndUnstewarded" ;
    rdfs:comment "TRUE when an executable version has nobody accountable for keeping it healthy." .

pko-native-procedural-knowledge-rulebook:isLiveButUnregisteredInGraph a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AiRegistryModelVersion ;
    rdfs:range xsd:boolean ;
