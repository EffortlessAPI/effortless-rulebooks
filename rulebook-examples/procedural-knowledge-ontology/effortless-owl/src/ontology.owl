# === Class: ExternalStandardTerms ===
effortless-ntwf:ExternalStandardTerms a owl:Class ;
    rdfs:label "ExternalStandardTerms" ;
    rdfs:comment "Terms the model reuses from external standards, whether the source deprecated them, and how the model responded." .

effortless-ntwf:externalStandardTermId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:string ;
    rdfs:label "ExternalStandardTermId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:ontologyProfile a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:OntologyProfiles ;
    rdfs:label "OntologyProfile" ;
    rdfs:comment "Standard the term comes from." .

effortless-ntwf:termIri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:string ;
    rdfs:label "TermIri" ;
    rdfs:comment "The term's current IRI." .

effortless-ntwf:previousTermIri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:string ;
    rdfs:label "PreviousTermIri" ;
    rdfs:comment "The IRI before the standard changed its prefix or identifier." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "Instant the model is judged against." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "Judgment instant." .
    # calculated: lookup

effortless-ntwf:deprecatedBySource a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "DeprecatedBySource" ;
    rdfs:comment "TRUE when the source standard marks the term deprecated." .

effortless-ntwf:deprecatedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:string ;
    rdfs:label "DeprecatedAt" ;
    rdfs:comment "When the source deprecated it." .

effortless-ntwf:stillResolves a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "StillResolves" ;
    rdfs:comment "TRUE when the deprecated IRI still dereferences." .

effortless-ntwf:alignmentUpdatedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:string ;
    rdfs:label "AlignmentUpdatedAt" ;
    rdfs:comment "When our mappings and documentation for the term were last updated." .

effortless-ntwf:modelStillNeedsTerm a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "ModelStillNeedsTerm" ;
    rdfs:comment "TRUE when the model still needs the concept." .

effortless-ntwf:rehomedAsTerm a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range effortless-ntwf:VocabularyTerms ;
    rdfs:label "RehomedAsTerm" ;
    rdfs:comment "Local concept the term was taken into." .

effortless-ntwf:rehomedTermSameAs a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:string ;
    rdfs:label "RehomedTermSameAs" ;
    rdfs:comment "Identity link the local concept carries." .
    # calculated: lookup

effortless-ntwf:rehomedTermNamespace a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:string ;
    rdfs:label "RehomedTermNamespace" ;
    rdfs:comment "Namespace of the local concept." .
    # calculated: lookup

effortless-ntwf:rehomedTermReleaseIssuedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:string ;
    rdfs:label "RehomedTermReleaseIssuedAt" ;
    rdfs:comment "When the model release introducing the local concept was issued." .
    # calculated: lookup

effortless-ntwf:profileNamespaceIri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:string ;
    rdfs:label "ProfileNamespaceIri" ;
    rdfs:comment "Namespace of the external standard." .
    # calculated: lookup

effortless-ntwf:daysSinceDeprecated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceDeprecated" ;
    rdfs:comment "Days since the source deprecated the term." .
    # calculated: calculated

effortless-ntwf:isRecentDeprecation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRecentDeprecation" ;
    rdfs:comment "TRUE when the source deprecated the term within the last two years." .
    # calculated: calculated

effortless-ntwf:usingMappingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:integer ;
    rdfs:label "UsingMappingCount" ;
    rdfs:comment "Semantic mappings that target the term's current IRI." .
    # calculated: aggregation

effortless-ntwf:staleIdentifierMappingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:integer ;
    rdfs:label "StaleIdentifierMappingCount" ;
    rdfs:comment "Semantic mappings still targeting the term's previous IRI." .
    # calculated: aggregation

effortless-ntwf:isAdoptedButDeprecated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAdoptedButDeprecated" ;
    rdfs:comment "TRUE when a term the model adopted (mapped or re-homed) has been deprecated by its source." .
    # calculated: calculated

effortless-ntwf:isAlignmentStaleAfterDeprecation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAlignmentStaleAfterDeprecation" ;
    rdfs:comment "TRUE when the source deprecated the term and our alignment and documentation were not updated afterwards." .
    # calculated: calculated

effortless-ntwf:isNeededDeprecatedTermNotRehomed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNeededDeprecatedTermNotRehomed" ;
    rdfs:comment "TRUE when the model still needs a deprecated external term and has not taken it into the local namespace." .
    # calculated: calculated

effortless-ntwf:isRehomedWithoutIdentityLink a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRehomedWithoutIdentityLink" ;
    rdfs:comment "TRUE when a re-homed local concept does not assert identity with the external original." .
    # calculated: calculated

effortless-ntwf:isRehomedWithoutNewRelease a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRehomedWithoutNewRelease" ;
    rdfs:comment "TRUE when a term was re-homed without a model release issued after the deprecation that introduced it." .
    # calculated: calculated

effortless-ntwf:hasUnpropagatedIdentifierChange a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnpropagatedIdentifierChange" ;
    rdfs:comment "TRUE when a standard changed the term's prefix or identifier and some mapping still uses the old one." .
    # calculated: calculated

effortless-ntwf:rehomingKeptExternalNamespace a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExternalStandardTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "RehomingKeptExternalNamespace" ;
    rdfs:comment "TRUE when a term said to be re-homed still sits in the external standard's namespace." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

