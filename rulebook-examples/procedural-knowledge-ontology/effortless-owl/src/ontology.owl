    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty pko-native-procedural-knowledge-rulebook:representedByTable ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    owl:hasKey ( erb:key ) .

