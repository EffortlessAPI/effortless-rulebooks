    rdfs:comment "TRUE when fewer requirements were scored than the step has blocking requirements." .

pko-native-procedural-knowledge-rulebook:hasUnfilledEscalationBackup a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnfilledEscalationBackup" ;
    rdfs:comment "TRUE when the escalation backup role has nobody in it." .

pko-native-procedural-knowledge-rulebook:hasUngroundedGoverningBoundary a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
