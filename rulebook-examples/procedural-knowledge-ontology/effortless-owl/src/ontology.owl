effortless-ntwf:methodShortfallCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SourcingFunctions ;
    rdfs:range xsd:integer ;
    rdfs:label "MethodShortfallCount" ;
    rdfs:comment "Method items where the client holds less than it needs." .
