pko-native-procedural-knowledge-rulebook:isInterview a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationSession ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInterview" ;
    rdfs:comment "TRUE for an interview session." .

pko-native-procedural-knowledge-rulebook:isInterviewWithoutShortfallProbe a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationSession ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInterviewWithoutShortfallProbe" ;
    rdfs:comment "TRUE for an interview that never asked what happens when the procedure falls short." .

pko-native-procedural-knowledge-rulebook:isInterviewWithoutWhyProbe a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationSession ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInterviewWithoutWhyProbe" ;
    rdfs:comment "TRUE for an interview that never asked why a choice is made." .

pko-native-procedural-knowledge-rulebook:isInvalidApproval a owl:DatatypeProperty ;
