    rdfs:domain pko-extension:KnowledgeHolding ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsJudgmentOutsideDocument" ;
    rdfs:comment "TRUE for unformalized knowledge the written SOP says nothing about." .

pko-native-procedural-knowledge-rulebook:isKeFieldSession a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationSession ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKeFieldSession" ;
    rdfs:comment "TRUE for a session the knowledge engineer ran where the work is done." .

pko-native-procedural-knowledge-rulebook:isKnowledgeAccessUnsecured a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProviderEngagement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKnowledgeAccessUnsecured" ;
