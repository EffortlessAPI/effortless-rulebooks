pko-native-procedural-knowledge-rulebook:isImplementedWithoutRealData a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsImplementedWithoutRealData" ;
