# === Class: CollectedSourceMaterials ===
effortless-ntwf:CollectedSourceMaterials a owl:Class ;
    rdfs:label "CollectedSourceMaterials" ;
    rdfs:comment "Raw material collection produced, and when it was organized into a scheme and encoded into a procedure version." .

effortless-ntwf:collectedSourceMaterialId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:string ;
    rdfs:label "CollectedSourceMaterialId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Material." .

effortless-ntwf:materialKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:string ;
    rdfs:label "MaterialKind" ;
    rdfs:comment "Transcript, FieldNotes, ProcessMap, MinedEventTrace or DocumentExcerpt." .

effortless-ntwf:procedure a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Procedures ;
    rdfs:label "Procedure" ;
    rdfs:comment "Procedure the material is about." .

effortless-ntwf:collectedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:string ;
    rdfs:label "CollectedAt" ;
    rdfs:comment "When collected." .

effortless-ntwf:organizedIntoScheme a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range effortless-ntwf:Vocabularies ;
