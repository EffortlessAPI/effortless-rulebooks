pko-native-procedural-knowledge-rulebook:hasStaleDefinition a owl:DatatypeProperty ;
    rdfs:domain pko-extension:VocabularyTerm ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasStaleDefinition" ;
    rdfs:comment "TRUE when the organization's meaning changed after the definition was last revised." .

pko-native-procedural-knowledge-rulebook:hasStepAndCategoryResolutions a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasStepAndCategoryResolutions" ;
    rdfs:comment "TRUE when the procedure can be shown both at step level and at its process-type category." .

pko-native-procedural-knowledge-rulebook:hasStepDeviation a owl:DatatypeProperty ;
    rdfs:domain pko:ProcedureExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasStepDeviation" ;
    rdfs:comment "TRUE when any step deviated." .

pko-native-procedural-knowledge-rulebook:hasStructuralSenseShiftAcrossYears a owl:DatatypeProperty ;
    rdfs:domain pko-extension:VocabularyTerm ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasStructuralSenseShiftAcrossYears" ;
    rdfs:comment "TRUE when what the term refers to changed shape after holding for years." .

pko-native-procedural-knowledge-rulebook:hasSufficientSample a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSufficientSample" ;
    rdfs:comment "TRUE when this assignment has produced enough decisions for its override rate to mean anything." .

pko-native-procedural-knowledge-rulebook:hasSurfacedJudgment a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CriticalIncident ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSurfacedJudgment" ;
    rdfs:comment "TRUE when the episode revealed a judgment call." .

pko-native-procedural-knowledge-rulebook:hasTaxonomy a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeConsumerSystem ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasTaxonomy" ;
    rdfs:comment "Holds a taxonomy." .

pko-native-procedural-knowledge-rulebook:hasThesaurus a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeConsumerSystem ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasThesaurus" ;
    rdfs:comment "Holds a thesaurus." .

pko-native-procedural-knowledge-rulebook:hasTransferShortfallExposure a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasTransferShortfallExposure" ;
    rdfs:comment "TRUE when a wave of three or more new starters meets untransferred veteran know-how, or a departing veteran leaves know-how untransferred." .

pko-native-procedural-knowledge-rulebook:hasUndocumentedEnactedPath a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcessMiningRun ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUndocumentedEnactedPath" ;
    rdfs:comment "TRUE when the enacted flow the run reconstructed contains a path the documentation lacks." .

pko-native-procedural-knowledge-rulebook:hasUnengagedStakeholder a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnengagedStakeholder" ;
    rdfs:comment "TRUE when a stakeholder department of the procedure has not been engaged." .

