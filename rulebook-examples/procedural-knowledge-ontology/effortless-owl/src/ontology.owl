    rdfs:label "ChangeLayer" ;
    rdfs:comment "Schema, Instance, Vocabulary or Documentation." .

effortless-ntwf:changeOperation a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeOperation" ;
    rdfs:comment "Operation." .

effortless-ntwf:changeSummary a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeSummary" ;
    rdfs:comment "The change." .

effortless-ntwf:rationale a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Rationale" ;
    rdfs:comment "Why." .

effortless-ntwf:termsAffected a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:string ;
    rdfs:label "TermsAffected" ;
    rdfs:comment "Terms affected." .

effortless-ntwf:affectedTable a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RulebookTables ;
    rdfs:label "AffectedTable" ;
    rdfs:comment "Table affected." .

effortless-ntwf:invalidatesInstances a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "InvalidatesInstances" ;
    rdfs:comment "Whether existing instance assertions become invalid or inconsistent." .

effortless-ntwf:loggedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:string ;
    rdfs:label "LoggedAt" ;
    rdfs:comment "When." .

effortless-ntwf:changedByAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ChangedByAgent" ;
    rdfs:comment "Who." .

effortless-ntwf:priorStateCommit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:string ;
    rdfs:label "PriorStateCommit" ;
    rdfs:comment "Version-control commit of the state before the change." .

effortless-ntwf:revertsEntry a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range effortless-ntwf:ModelChangeLogEntries ;
    rdfs:label "RevertsEntry" ;
    rdfs:comment "Entry this one rolls back." .

effortless-ntwf:motivatingQuestion a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "MotivatingQuestion" ;
    rdfs:comment "Question motivating the change." .
    # calculated: lookup

effortless-ntwf:releaseVersion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:string ;
    rdfs:label "ReleaseVersion" ;
    rdfs:comment "Version number shipped in." .
    # calculated: lookup

effortless-ntwf:releaseDecisionUndocumented a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "ReleaseDecisionUndocumented" ;
    rdfs:comment "Whether the release's versioning decision was left undocumented." .
    # calculated: lookup

effortless-ntwf:altersLogicalModel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "AltersLogicalModel" ;
    rdfs:comment "TRUE for a schema or vocabulary change, as opposed to documentation or instance data." .
    # calculated: calculated

effortless-ntwf:isClassRemovalOrRename a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsClassRemovalOrRename" ;
    rdfs:comment "TRUE when a class is removed or renamed." .
    # calculated: calculated

effortless-ntwf:isInvalidatingDomainRangeChange a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInvalidatingDomainRangeChange" ;
    rdfs:comment "TRUE for a domain or range change that invalidates existing assertions." .
    # calculated: calculated

effortless-ntwf:isInconsistentDisjointness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInconsistentDisjointness" ;
    rdfs:comment "TRUE for a disjointness axiom that makes existing individuals inconsistent." .
    # calculated: calculated

effortless-ntwf:isBackwardIncompatible a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBackwardIncompatible" ;
    rdfs:comment "TRUE when the change breaks existing data or queries." .
    # calculated: calculated

effortless-ntwf:isAdditiveSchemaChange a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAdditiveSchemaChange" ;
    rdfs:comment "TRUE for a purely additive schema change." .
    # calculated: calculated

effortless-ntwf:isUnexplainedModification a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnexplainedModification" ;
    rdfs:comment "TRUE when a schema or instance modification is logged with no rationale." .
    # calculated: calculated

effortless-ntwf:rationaleWithoutQuestion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "RationaleWithoutQuestion" ;
    rdfs:comment "TRUE when a rationale was recorded but no competency question stands behind it." .
    # calculated: calculated

effortless-ntwf:isSchemaChangeWithoutIncrement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSchemaChangeWithoutIncrement" ;
    rdfs:comment "TRUE when a schema change shipped in no versioned release." .
    # calculated: calculated

effortless-ntwf:isInstanceChangeInSchemaRelease a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInstanceChangeInSchemaRelease" ;
    rdfs:comment "TRUE when an instance data change was versioned as a schema release instead of a data version." .
    # calculated: calculated

effortless-ntwf:schemaChangeWithoutRequest a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "SchemaChangeWithoutRequest" ;
    rdfs:comment "TRUE when a schema change was made outside the change process, with no change request." .
    # calculated: calculated

effortless-ntwf:cannotBeAudited a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "CannotBeAudited" ;
    rdfs:comment "TRUE when a change names nobody who made it or no version it belongs to." .
    # calculated: calculated

effortless-ntwf:cannotBeRolledBack a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "CannotBeRolledBack" ;
    rdfs:comment "TRUE when no prior-state commit is recorded, so the change cannot be rolled back." .
    # calculated: calculated

effortless-ntwf:isUntraceableBreakingChange a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntraceableBreakingChange" ;
    rdfs:comment "TRUE when a breaking change cannot be traced to a documented versioning decision." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ModelChangeRequests ===
effortless-ntwf:ModelChangeRequests a owl:Class ;
    rdfs:label "ModelChangeRequests" ;
    rdfs:comment "Requests to change a governed model, each begun from a stated need and tied to the competency question that motivates it." .

effortless-ntwf:modelChangeRequestId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "ModelChangeRequestId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:governedModel a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:GovernedModels ;
    rdfs:label "GovernedModel" ;
    rdfs:comment "Model to change." .

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Change." .

effortless-ntwf:statedNeed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "StatedNeed" ;
