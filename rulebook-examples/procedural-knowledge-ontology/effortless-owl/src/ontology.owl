effortless-ntwf:isUnanswerableToday a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StakeholderQuestions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnanswerableToday" ;
