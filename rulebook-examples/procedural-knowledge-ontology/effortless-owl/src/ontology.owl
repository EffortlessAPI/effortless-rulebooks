    rdfs:range xsd:boolean ;
    rdfs:label "IsMachineAccessible" ;
    rdfs:comment "TRUE when the scheme has an IRI and is published as SKOS." .

pko-native-procedural-knowledge-rulebook:isMachineAuthored a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeRepositoryEntry ;
    rdfs:range xsd:boolean ;
