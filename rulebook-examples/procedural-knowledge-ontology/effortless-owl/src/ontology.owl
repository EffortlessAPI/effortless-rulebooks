# === Class: StewardActivities ===
effortless-ntwf:StewardActivities a owl:Class ;
    rdfs:label "StewardActivities" ;
    rdfs:comment "Recorded steward duties: drift watches, dependency tracking, documentation and validation-suite upkeep." .

effortless-ntwf:stewardActivityId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StewardActivities ;
    rdfs:range xsd:string ;
    rdfs:label "StewardActivityId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:modelCharter a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:StewardActivities ;
    rdfs:range effortless-ntwf:ModelCharters ;
    rdfs:label "ModelCharter" ;
    rdfs:comment "Charter the duty was performed under." .

effortless-ntwf:dutyKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StewardActivities ;
    rdfs:range xsd:string ;
    rdfs:label "DutyKind" ;
    rdfs:comment "DriftWatch, DependencyTracking, UserQuestion, DocumentationUpdate or ValidationSuiteUpdate." .

effortless-ntwf:performedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StewardActivities ;
    rdfs:range xsd:string ;
    rdfs:label "PerformedAt" ;
    rdfs:comment "When." .

effortless-ntwf:performedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:StewardActivities ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "PerformedByAgent" ;
    rdfs:comment "Who." .

effortless-ntwf:subject a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Subject" ;
    rdfs:comment "What was looked at or changed." .

effortless-ntwf:release a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RulebookReleases ;
    rdfs:label "Release" ;
    rdfs:comment "Release the activity kept in step, when there is one." .

effortless-ntwf:activityModel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StewardActivities ;
    rdfs:range xsd:string ;
    rdfs:label "ActivityModel" ;
    rdfs:comment "Model the charter governs." .
    # calculated: lookup

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: StewardshipAssignments ===
effortless-ntwf:StewardshipAssignments a owl:Class ;
    rdfs:label "StewardshipAssignments" ;
    rdfs:comment "Separates ongoing stewardship from authority to approve semantic commitments. Explicit ERB-PKO governance extension." .

effortless-ntwf:stewardshipAssignmentId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StewardshipAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "StewardshipAssignmentId" ;
    rdfs:comment "Stored logical identifier for one StewardshipAssignments row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the StewardshipAssignments row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Governed procedure version." .

effortless-ntwf:stewardRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "StewardRole" ;
    rdfs:comment "Role responsible for health, review, and maintenance." .

effortless-ntwf:authorityRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "AuthorityRole" ;
    rdfs:comment "Role authorized to approve semantic changes." .

effortless-ntwf:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ValidFrom" ;
    rdfs:comment "Start of stewardship interval." .

effortless-ntwf:validTo a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ValidTo" ;
    rdfs:comment "End of stewardship interval." .

effortless-ntwf:reviewCadenceDays a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "ReviewCadenceDays" ;
    rdfs:comment "Required review cadence." .

effortless-ntwf:countOfReviewEvents a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfReviewEvents" ;
    rdfs:comment "How many review events have ever been recorded for the procedure version this assignment stewards." .
    # calculated: aggregation

effortless-ntwf:hasEverBeenReviewed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StewardshipAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasEverBeenReviewed" ;
    rdfs:comment "TRUE if at least one review event exists for the stewarded procedure version." .
    # calculated: calculated

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:isCurrentAssignment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StewardshipAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrentAssignment" ;
    rdfs:comment "TRUE when this stewardship assignment is in force right now." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: SubstrateRunScores ===
effortless-ntwf:SubstrateRunScores a owl:Class ;
    rdfs:label "SubstrateRunScores" ;
    rdfs:comment "One substrate's grade in one conformance run, split by field class so a substrate that does scalar math natively but not cross-table joins reads as exactly that." .

effortless-ntwf:substrateRunScoreId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "SubstrateRunScoreId" ;
    rdfs:comment "Stored logical identifier: '<run>|<substrate>'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:run a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ConformanceRuns ;
    rdfs:label "Run" ;
    rdfs:comment "The run that produced this grade." .

effortless-ntwf:substrate a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ConformanceSubstrates ;
    rdfs:label "Substrate" ;
    rdfs:comment "The substrate graded." .

effortless-ntwf:harnessError a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "HarnessError" ;
    rdfs:comment "Why the substrate could not be run, verbatim from the harness. Blank when it ran." .

effortless-ntwf:durationSeconds a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DurationSeconds" ;
    rdfs:comment "Wall-clock seconds to produce answers." .

effortless-ntwf:cellsTested a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CellsTested" ;
    rdfs:comment "Every (record x derived field) pair in the answer keys." .

effortless-ntwf:cellsPassed a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CellsPassed" ;
    rdfs:comment "Cells matching the answer key." .

effortless-ntwf:calculatedTested a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "CalculatedTested" ;
    rdfs:comment "Cells of calculated (same-row formula) fields." .

effortless-ntwf:calculatedPassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "CalculatedPassed" ;
    rdfs:comment "Calculated cells that matched." .

effortless-ntwf:lookupTested a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "LookupTested" ;
    rdfs:comment "Cells of lookup (cross-table INDEX/MATCH) fields." .

effortless-ntwf:lookupPassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "LookupPassed" ;
    rdfs:comment "Lookup cells that matched." .

effortless-ntwf:aggregationTested a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "AggregationTested" ;
    rdfs:comment "Cells of aggregation (COUNTIFS/SUMIFS rollup) fields." .

effortless-ntwf:aggregationPassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "AggregationPassed" ;
    rdfs:comment "Aggregation cells that matched." .

effortless-ntwf:cellsFailed a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CellsFailed" ;
    rdfs:comment "Cells that did not match." .
    # calculated: calculated

effortless-ntwf:score a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Score" ;
    rdfs:comment "Percent of cells matching." .
    # calculated: calculated

effortless-ntwf:calculatedScore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "CalculatedScore" ;
    rdfs:comment "Percent of calculated cells matching." .
    # calculated: calculated

effortless-ntwf:lookupScore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "LookupScore" ;
    rdfs:comment "Percent of lookup cells matching." .
    # calculated: calculated

effortless-ntwf:aggregationScore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "AggregationScore" ;
    rdfs:comment "Percent of aggregation cells matching." .
    # calculated: calculated

effortless-ntwf:isPerfect a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPerfect" ;
    rdfs:comment "True when the substrate ran and matched every cell." .
    # calculated: calculated

effortless-ntwf:perfectRunKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
    rdfs:range xsd:string ;
    rdfs:label "PerfectRunKey" ;
    rdfs:comment "The run id when this grade is perfect, else blank; lets the run count its perfect substrates with a single-criterion COUNTIFS." .
    # calculated: calculated

effortless-ntwf:isInLatestRun a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateRunScores ;
