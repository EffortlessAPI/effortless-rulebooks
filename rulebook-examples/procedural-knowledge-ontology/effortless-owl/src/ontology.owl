effortless-ntwf:isVitalExpertiseProcess a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SourcingFunctions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsVitalExpertiseProcess" ;
    rdfs:comment "TRUE for a strategically vital, expertise-heavy function." .
    # calculated: calculated

effortless-ntwf:isOutsourcedVitalExpertiseProcess a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SourcingFunctions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOutsourcedVitalExpertiseProcess" ;
    rdfs:comment "TRUE for a strategically vital, expertise-heavy function a provider performs." .
    # calculated: calculated

effortless-ntwf:auditItemCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SourcingFunctions ;
    rdfs:range xsd:integer ;
    rdfs:label "AuditItemCount" ;
    rdfs:comment "Audit items comparing held and needed knowledge for this function." .
    # calculated: aggregation

effortless-ntwf:dependencyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SourcingFunctions ;
    rdfs:range xsd:integer ;
    rdfs:label "DependencyCount" ;
