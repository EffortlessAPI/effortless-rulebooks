    rdfs:range xsd:boolean ;
    rdfs:label "HasUnrehearsedControlEntry" ;
    rdfs:comment "Whether this live version has at least one blocking control that is only reachable by a path nobody has ever walked." .

pko-native-procedural-knowledge-rulebook:hasUnresolvedMiningDrift a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnresolvedMiningDrift" ;
    rdfs:comment "TRUE when mined operational evidence contradicts this live version's documented path." .

pko-native-procedural-knowledge-rulebook:hasUnwitnessedChange a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnwitnessedChange" ;
    rdfs:comment "TRUE when a live version's current content postdates every review it has had." .

pko-native-procedural-knowledge-rulebook:hasValidApproval a owl:DatatypeProperty ;
