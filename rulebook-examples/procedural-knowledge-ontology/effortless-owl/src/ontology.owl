# === Class: ConformanceRuns ===
effortless-ntwf:ConformanceRuns a owl:Class ;
    rdfs:label "ConformanceRuns" ;
    rdfs:comment "One execution of the conformance harness over every graded substrate. Kept as history; exactly one run is marked IsLatest, and the per-table, per-field and per-cell detail tables describe that run." .

effortless-ntwf:conformanceRunId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceRuns ;
    rdfs:range xsd:string ;
    rdfs:label "ConformanceRunId" ;
    rdfs:comment "Stored logical identifier, e.g. 'run-20260913-171500'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:ranOn a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceRuns ;
    rdfs:range xsd:string ;
    rdfs:label "RanOn" ;
    rdfs:comment "When the harness graded the substrates." .

effortless-ntwf:rulebookCommit a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RulebookCommit" ;
    rdfs:comment "git HEAD of the repository when the run was recorded; the rulebook may also carry uncommitted edits, noted in Notes." .

effortless-ntwf:answerKeyAuthor a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ConformanceRuns ;
    rdfs:range effortless-ntwf:ConformanceSubstrates ;
    rdfs:label "AnswerKeyAuthor" ;
    rdfs:comment "The substrate whose stored values were the answer keys for this run." .

effortless-ntwf:isLatest a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceRuns ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLatest" ;
    rdfs:comment "True for the most recent recorded run only. The recorder moves it." .

effortless-ntwf:notes a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Notes" ;
    rdfs:comment "Anything a reader needs to interpret the run." .

effortless-ntwf:substrateCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceRuns ;
    rdfs:range xsd:string ;
    rdfs:label "SubstrateCount" ;
    rdfs:comment "Substrates graded in this run." .
    # calculated: aggregation

effortless-ntwf:perfectSubstrateCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceRuns ;
    rdfs:range xsd:string ;
    rdfs:label "PerfectSubstrateCount" ;
    rdfs:comment "Substrates that ran and agreed on every cell." .
    # calculated: aggregation

effortless-ntwf:cellsTested a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CellsTested" ;
    rdfs:comment "Cells graded across all substrates." .
    # calculated: aggregation

effortless-ntwf:cellsPassed a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CellsPassed" ;
    rdfs:comment "Cells that agreed across all substrates." .
    # calculated: aggregation

effortless-ntwf:cellsFailed a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CellsFailed" ;
    rdfs:comment "Cells that disagreed across all substrates." .
    # calculated: calculated

effortless-ntwf:overallScore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceRuns ;
    rdfs:range xsd:string ;
    rdfs:label "OverallScore" ;
    rdfs:comment "Percent of all graded cells, across all substrates, that agreed." .
    # calculated: calculated

effortless-ntwf:imperfectSubstrateCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceRuns ;
    rdfs:range xsd:string ;
    rdfs:label "ImperfectSubstrateCount" ;
    rdfs:comment "Substrates with at least one disagreeing cell or a harness error." .
    # calculated: calculated

effortless-ntwf:isFullyConformant a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFullyConformant" ;
    rdfs:comment "True when every substrate graded in this run agreed on every cell: the 100% bar." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ConformanceSubstrates ===
effortless-ntwf:ConformanceSubstrates a owl:Class ;
    rdfs:label "ConformanceSubstrates" ;
    rdfs:comment "Every tool that compiles this rulebook into something that computes. One is the answer-key author (compile-rulebook bakes derived values into the rulebook's own rows); the rest are graded substrates that re-derive those values natively and are scored cell by cell against them." .

effortless-ntwf:conformanceSubstrateId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceSubstrates ;
    rdfs:range xsd:string ;
    rdfs:label "ConformanceSubstrateId" ;
    rdfs:comment "Substrate name as the conformance harness knows it, e.g. 'effortless-python'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Short human label, e.g. 'Python'." .

effortless-ntwf:transpiler a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceSubstrates ;
    rdfs:range xsd:string ;
    rdfs:label "Transpiler" ;
    rdfs:comment "The effortless.json tool that produces this substrate, e.g. 'rulebook-to-python'." .

effortless-ntwf:outputFolder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceSubstrates ;
    rdfs:range xsd:string ;
    rdfs:label "OutputFolder" ;
    rdfs:comment "Project folder the tool writes into, e.g. '/effortless-python'." .

effortless-ntwf:engine a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceSubstrates ;
    rdfs:range xsd:string ;
    rdfs:label "Engine" ;
    rdfs:comment "What actually evaluates the formulas: a database, a language runtime, a spreadsheet engine or a reasoner." .

effortless-ntwf:howItComputes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceSubstrates ;
    rdfs:range xsd:string ;
    rdfs:label "HowItComputes" ;
    rdfs:comment "One paragraph a curious reader can follow: what the tool emits and how the harness makes it produce answers." .

effortless-ntwf:role a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Role" ;
    rdfs:comment "'answer-key' for the tool whose stored values every other substrate is graded against; 'graded' for everything else." .

effortless-ntwf:sortOrder a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SortOrder" ;
    rdfs:comment "Display order." .

effortless-ntwf:isGraded a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceSubstrates ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGraded" ;
    rdfs:comment "True for substrates the harness scores." .
    # calculated: calculated

effortless-ntwf:runCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceSubstrates ;
    rdfs:range xsd:string ;
    rdfs:label "RunCount" ;
    rdfs:comment "How many recorded conformance runs graded this substrate." .
    # calculated: aggregation

effortless-ntwf:latestCellsTested a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "LatestCellsTested" ;
    rdfs:comment "Cells graded in the latest run: every (record x derived field) pair in the answer keys." .
    # calculated: aggregation

effortless-ntwf:latestCellsPassed a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "LatestCellsPassed" ;
    rdfs:comment "Cells this substrate computed identically to the answer key in the latest run." .
    # calculated: aggregation

effortless-ntwf:latestHarnessErrors a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceSubstrates ;
    rdfs:range xsd:string ;
    rdfs:label "LatestHarnessErrors" ;
    rdfs:comment "1 when the latest run could not execute this substrate at all." .
    # calculated: aggregation

effortless-ntwf:latestCellsFailed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceSubstrates ;
    rdfs:range xsd:string ;
    rdfs:label "LatestCellsFailed" ;
    rdfs:comment "Cells this substrate got wrong, or did not produce, in the latest run." .
    # calculated: calculated

effortless-ntwf:latestScore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceSubstrates ;
    rdfs:range xsd:string ;
    rdfs:label "LatestScore" ;
    rdfs:comment "Percent of cells agreeing with the answer key in the latest run." .
    # calculated: calculated

effortless-ntwf:disagreeingFieldCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DisagreeingFieldCount" ;
    rdfs:comment "Derived fields on which this substrate got at least one cell wrong in the latest run." .
    # calculated: aggregation

effortless-ntwf:disagreeingTableCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConformanceSubstrates ;
    rdfs:range xsd:string ;
    rdfs:label "DisagreeingTableCount" ;
    rdfs:comment "Tables on which this substrate got at least one cell wrong in the latest run." .
    # calculated: aggregation

effortless-ntwf:isFullyConformant a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFullyConformant" ;
    rdfs:comment "True when the latest run graded this substrate, it ran, and every cell agreed. A substrate never graded is not conformant." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ConsumerRevalidations ===
effortless-ntwf:ConsumerRevalidations a owl:Class ;
    rdfs:label "ConsumerRevalidations" ;
    rdfs:comment "Per release and consumer: was the consumer told, and re-validated against the release." .

effortless-ntwf:consumerRevalidationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerRevalidations ;
    rdfs:range xsd:string ;
    rdfs:label "ConsumerRevalidationId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:rulebookRelease a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RulebookReleases ;
    rdfs:label "RulebookRelease" ;
    rdfs:comment "Release." .

effortless-ntwf:modelConsumer a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ConsumerRevalidations ;
    rdfs:range effortless-ntwf:ModelConsumers ;
    rdfs:label "ModelConsumer" ;
    rdfs:comment "Consumer." .

effortless-ntwf:wasNotified a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerRevalidations ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasNotified" ;
    rdfs:comment "Whether the consumer's owner was told of the release." .

effortless-ntwf:notifiedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerRevalidations ;
    rdfs:range xsd:string ;
    rdfs:label "NotifiedAt" ;
    rdfs:comment "When." .

effortless-ntwf:passedRevalidation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerRevalidations ;
    rdfs:range xsd:boolean ;
    rdfs:label "PassedRevalidation" ;
    rdfs:comment "Whether the consumer was updated and re-validated against the release." .

effortless-ntwf:revalidatedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerRevalidations ;
    rdfs:range xsd:string ;
    rdfs:label "RevalidatedAt" ;
    rdfs:comment "When." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ConsumerSystemSyncs ===
effortless-ntwf:ConsumerSystemSyncs a owl:Class ;
    rdfs:label "ConsumerSystemSyncs" ;
    rdfs:comment "Which procedure version a consuming system currently holds, from what source, and when it was synced." .

effortless-ntwf:consumerSystemSyncId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:string ;
    rdfs:label "ConsumerSystemSyncId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:consumerSystem a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:KnowledgeConsumerSystems ;
    rdfs:label "ConsumerSystem" ;
    rdfs:comment "Consuming system." .

effortless-ntwf:loadedVersion a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "LoadedVersion" ;
    rdfs:comment "Procedure version the system holds." .

effortless-ntwf:syncedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:string ;
    rdfs:label "SyncedAt" ;
    rdfs:comment "When the system last took the version." .

effortless-ntwf:sourceResource a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Resources ;
    rdfs:label "SourceResource" ;
    rdfs:comment "A document the system was fed from instead of the shared model; blank when fed from the model." .

effortless-ntwf:carriesProvenance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:boolean ;
    rdfs:label "CarriesProvenance" ;
    rdfs:comment "TRUE when the system's copy kept who authored the knowledge and where it came from." .

effortless-ntwf:systemAudience a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:string ;
    rdfs:label "SystemAudience" ;
    rdfs:comment "Who reads through the system." .
    # calculated: lookup

effortless-ntwf:loadedProcedure a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:string ;
    rdfs:label "LoadedProcedure" ;
    rdfs:comment "Procedure of the loaded version." .
    # calculated: lookup

effortless-ntwf:canonicalVersion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:string ;
    rdfs:label "CanonicalVersion" ;
    rdfs:comment "The procedure's current version in the model." .
    # calculated: lookup

effortless-ntwf:canonicalVersionModifiedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:string ;
    rdfs:label "CanonicalVersionModifiedAt" ;
    rdfs:comment "When the current version last changed." .
    # calculated: lookup

effortless-ntwf:loadedVersionCreator a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:string ;
    rdfs:label "LoadedVersionCreator" ;
    rdfs:comment "Who authored the loaded version." .
    # calculated: lookup

effortless-ntwf:isBehindCanonicalVersion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBehindCanonicalVersion" ;
    rdfs:comment "TRUE when a consuming system holds a different version from the one the model says is current." .
    # calculated: calculated

effortless-ntwf:predatesVersionChange a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:boolean ;
    rdfs:label "PredatesVersionChange" ;
    rdfs:comment "TRUE when the system holds the current version but took it before that version last changed." .
    # calculated: calculated

effortless-ntwf:isAiFedFromForkedCopy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAiFedFromForkedCopy" ;
    rdfs:comment "TRUE when a system read by AI is fed from a separate document rather than the shared model humans use." .
    # calculated: calculated

effortless-ntwf:dropsProvenanceInTransit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:boolean ;
    rdfs:label "DropsProvenanceInTransit" ;
    rdfs:comment "TRUE when the version had an author on record and the system's copy dropped the provenance." .
    # calculated: calculated

effortless-ntwf:reachesHumans a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:boolean ;
    rdfs:label "ReachesHumans" ;
    rdfs:comment "TRUE when the system is read by people." .
    # calculated: calculated

effortless-ntwf:reachesMachines a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConsumerSystemSyncs ;
    rdfs:range xsd:boolean ;
    rdfs:label "ReachesMachines" ;
    rdfs:comment "TRUE when the system is read by AI." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: CorporateGovernancePrograms ===
effortless-ntwf:CorporateGovernancePrograms a owl:Class ;
    rdfs:label "CorporateGovernancePrograms" ;
    rdfs:comment "Governance programmes an organization runs, who sponsors them, and what their scope covers." .

effortless-ntwf:corporateGovernanceProgramId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorporateGovernancePrograms ;
    rdfs:range xsd:string ;
    rdfs:label "CorporateGovernanceProgramId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:organization a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "Organization" ;
    rdfs:comment "Organization." .

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Programme." .

effortless-ntwf:sponsorDiscipline a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorporateGovernancePrograms ;
    rdfs:range xsd:string ;
    rdfs:label "SponsorDiscipline" ;
    rdfs:comment "The leadership discipline sponsoring it: Engineering or Legal." .

effortless-ntwf:launchedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorporateGovernancePrograms ;
    rdfs:range xsd:string ;
    rdfs:label "LaunchedAt" ;
    rdfs:comment "When launched." .

effortless-ntwf:coversCompliance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorporateGovernancePrograms ;
    rdfs:range xsd:boolean ;
    rdfs:label "CoversCompliance" ;
    rdfs:comment "Scope includes regulatory compliance and legal risk." .

effortless-ntwf:coversDataQuality a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorporateGovernancePrograms ;
    rdfs:range xsd:boolean ;
    rdfs:label "CoversDataQuality" ;
    rdfs:comment "Scope includes data quality." .

effortless-ntwf:coversInformationManagement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorporateGovernancePrograms ;
    rdfs:range xsd:boolean ;
    rdfs:label "CoversInformationManagement" ;
    rdfs:comment "Scope includes information management." .

effortless-ntwf:coversKnowledgeManagement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorporateGovernancePrograms ;
    rdfs:range xsd:boolean ;
    rdfs:label "CoversKnowledgeManagement" ;
    rdfs:comment "Scope includes knowledge management." .

effortless-ntwf:isComplianceOnly a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorporateGovernancePrograms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsComplianceOnly" ;
    rdfs:comment "TRUE when a programme's scope is compliance and nothing else." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: CriticalIncidents ===
effortless-ntwf:CriticalIncidents a owl:Class ;
    rdfs:label "CriticalIncidents" ;
    rdfs:comment "Specific past episodes of a procedure that went well, went badly or needed improvising, collected with the critical incident technique, each linked to the judgment call it brought out." .

effortless-ntwf:criticalIncidentId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CriticalIncidents ;
    rdfs:range xsd:string ;
    rdfs:label "CriticalIncidentId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "The version the episode is elicited for." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "The step where the episode turned." .

effortless-ntwf:elicitationSession a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ElicitationSessions ;
    rdfs:label "ElicitationSession" ;
    rdfs:comment "The critical incident session that collected it." .

effortless-ntwf:narrator a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:CriticalIncidents ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "Narrator" ;
    rdfs:comment "The practitioner who recounted the episode." .

effortless-ntwf:occurredAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OccurredAt" ;
    rdfs:comment "When the episode happened." .

effortless-ntwf:outcome a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Outcome" ;
    rdfs:comment "WentWell, WentBadly or Improvised." .

effortless-ntwf:account a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CriticalIncidents ;
    rdfs:range xsd:string ;
    rdfs:label "Account" ;
    rdfs:comment "The practitioner's account of the episode." .

effortless-ntwf:revealedJudgment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CriticalIncidents ;
    rdfs:range xsd:string ;
    rdfs:label "RevealedJudgment" ;
    rdfs:comment "The judgment call the episode brought out that the written procedure hides; blank when none." .

effortless-ntwf:judgmentFragment a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:CriticalIncidents ;
    rdfs:range effortless-ntwf:KnowledgeFragments ;
    rdfs:label "JudgmentFragment" ;
    rdfs:comment "The knowledge fragment the revealed judgment was recorded as." .

effortless-ntwf:isAdverseOrImprovised a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CriticalIncidents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAdverseOrImprovised" ;
    rdfs:comment "TRUE for an episode that went badly or had to be improvised." .
    # calculated: calculated

effortless-ntwf:hasSurfacedJudgment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CriticalIncidents ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSurfacedJudgment" ;
    rdfs:comment "TRUE when the episode revealed a judgment call." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: CueObservations ===
effortless-ntwf:CueObservations a owl:Class ;
    rdfs:label "CueObservations" ;
    rdfs:comment "A cue observed during a step execution." .

effortless-ntwf:cueObservationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CueObservations ;
    rdfs:range xsd:string ;
    rdfs:label "CueObservationId" ;
