pko-native-procedural-knowledge-rulebook:isKnowledgeEngineer a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationParticipant ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKnowledgeEngineer" ;
    rdfs:comment "TRUE for the knowledge engineer collecting the knowledge." .

pko-native-procedural-knowledge-rulebook:isKnowledgeProcessOutsourcing a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourcingFunction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKnowledgeProcessOutsourcing" ;
