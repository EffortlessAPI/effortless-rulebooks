    rdfs:range xsd:string ;
    rdfs:label "LastOutcome" ;
    rdfs:comment "PASS, WARN, FAIL, or SKIP from the most recent run. Written by tools/run_test_suite.py from the substrate — never hand-edited." .

pko-native-procedural-knowledge-rulebook:lastOutcomeMeasuredAt a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AiAdoptionInitiative ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastOutcomeMeasuredAt" ;
