effortless-ntwf:higherAccessMoreEfficient a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeOutcomeMeasurements ;
    rdfs:range xsd:boolean ;
    rdfs:label "HigherAccessMoreEfficient" ;
