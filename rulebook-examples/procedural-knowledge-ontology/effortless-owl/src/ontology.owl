    rdfs:range xsd:boolean ;
    rdfs:label "IsInWrittenProcedure" ;
    rdfs:comment "TRUE when the know-how is written into a procedure." .

pko-native-procedural-knowledge-rulebook:isInadequateForUse a owl:DatatypeProperty ;
