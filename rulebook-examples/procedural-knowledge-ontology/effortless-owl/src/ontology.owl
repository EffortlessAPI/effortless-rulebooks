    rdfs:range xsd:boolean ;
    rdfs:label "IsMachineParseable" ;
    rdfs:comment "TRUE when the condition is stored as an expression, not only prose." .

pko-native-procedural-knowledge-rulebook:isMaintainer a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AppRoute ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMaintainer" ;
    rdfs:comment "Whether this route is model instrumentation rather than a domain workspace. Maintainer routes are reached from the login page's maintainer section, not from a role card." .

pko-native-procedural-knowledge-rulebook:isManagedCadenceBreach a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsManagedCadenceBreach" ;
    rdfs:comment "A cadence breach where a change request is at least open against the version." .

pko-native-procedural-knowledge-rulebook:isMandatedWithoutSharingNorm a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CommunityOfPractice ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMandatedWithoutSharingNorm" ;
    rdfs:comment "TRUE when a community was mandated or bought and no sharing happens in it." .

pko-native-procedural-knowledge-rulebook:isMasked a owl:DatatypeProperty ;
    rdfs:domain pko-extension:FieldGrant ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMasked" ;
    rdfs:comment "True when the value is transformed rather than shown verbatim." .

pko-native-procedural-knowledge-rulebook:isMentalModel a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ExpertCognition ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMentalModel" ;
    rdfs:comment "TRUE for a mental model an expert applies." .

pko-native-procedural-knowledge-rulebook:isMethodKnowledgeHeldOutside a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourcingFunction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMethodKnowledgeHeldOutside" ;
    rdfs:comment "TRUE when the knowledge of how the work is really performed is held by a party other than the client." .

pko-native-procedural-knowledge-rulebook:isMinedPathRecordedAsIntentWithoutDecision a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MinedFlowEdge ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMinedPathRecordedAsIntentWithoutDecision" ;
    rdfs:comment "TRUE when a mined hand-off is recorded as intended logic and nobody decided it should be." .

pko-native-procedural-knowledge-rulebook:isMinorScope a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMinorScope" ;
    rdfs:comment "TRUE for a change the steward may approve and deploy alone." .

pko-native-procedural-knowledge-rulebook:isMisclassifiedAgentSwap a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMisclassifiedAgentSwap" ;
    rdfs:comment "TRUE when swapping which agent fills a role was handled as a modeling change." .

pko-native-procedural-knowledge-rulebook:isMisrouted a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMisrouted" ;
    rdfs:comment "TRUE when a change went through a different process than the rule for its layer requires." .

pko-native-procedural-knowledge-rulebook:isMisroutedAfterTriage a owl:DatatypeProperty ;
    rdfs:domain pko-extension:StakeholderQuestion ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMisroutedAfterTriage" ;
    rdfs:comment "TRUE when the change raised from triage went through a different process than the triage outcome calls for." .

pko-native-procedural-knowledge-rulebook:isMissedByPhraseQuery a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMissedByPhraseQuery" ;
    rdfs:comment "TRUE when a query for this role through the role vocabulary misses a process that mentions it in other words." .

pko-native-procedural-knowledge-rulebook:isMissedStepLeftUncaptured a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ObservedAction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMissedStepLeftUncaptured" ;
    rdfs:comment "TRUE when an action the interview missed was observed but never captured as knowledge." .

pko-native-procedural-knowledge-rulebook:isMissingAnswerFile a owl:DatatypeProperty ;
    rdfs:domain pko-extension:TableConformance ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMissingAnswerFile" ;
    rdfs:comment "True when the substrate produced no answers for this table at all; every cell then counts as failed." .

pko-native-procedural-knowledge-rulebook:isMissingDemandedResolution a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMissingDemandedResolution" ;
    rdfs:comment "TRUE when a lens needs step-level detail the procedure does not have, or a category the procedure is not classified into." .

pko-native-procedural-knowledge-rulebook:isMissingRequiredOptOut a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMissingRequiredOptOut" ;
    rdfs:comment "TRUE when a transmitted message on an opt-out-required channel did not contain the phrase at all. The hard witness." .

pko-native-procedural-knowledge-rulebook:isMiswiredSource a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:StepVariables ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMiswiredSource" ;
    rdfs:comment "TRUE when an input is fed from a variable that is not an output." .

pko-native-procedural-knowledge-rulebook:isModeInconsistentWithForms a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeConversion ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsModeInconsistentWithForms" ;
    rdfs:comment "TRUE when the recorded SECI mode does not match the forms it converts between (socialization tacit to tacit, externalization tacit to explicit, combination explicit to explicit, internalization explicit to tacit)." .

pko-native-procedural-knowledge-rulebook:isModeledBeforeOrganized a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CollectedSourceMaterial ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsModeledBeforeOrganized" ;
    rdfs:comment "TRUE when material was encoded into a procedure version before it was organized, or without ever being organized." .

pko-native-procedural-knowledge-rulebook:isModelingChange a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsModelingChange" ;
    rdfs:comment "TRUE for a modeling change rather than a data operation." .

pko-native-procedural-knowledge-rulebook:isMyBlockingBacklog a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyBlockingBacklog" ;
    rdfs:comment "A decision waiting on me that is holding an open gap on a live procedure." .

pko-native-procedural-knowledge-rulebook:isMyDecidedButUnlanded a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyDecidedButUnlanded" ;
    rdfs:comment "A decision I have made that has not yet been applied — still counted against me by the loop-1 open-request measure." .

pko-native-procedural-knowledge-rulebook:isMyDecidedRequest a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyDecidedRequest" ;
    rdfs:comment "A change request I have personally ruled on." .

pko-native-procedural-knowledge-rulebook:isMyOverdueBacklog a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyOverdueBacklog" ;
    rdfs:comment "A blocking decision that has waited on me for more than two weeks." .

pko-native-procedural-knowledge-rulebook:isMyPendingDecision a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyPendingDecision" ;
    rdfs:comment "A change request awaiting a decision that is mine personally to make." .

pko-native-procedural-knowledge-rulebook:isMyUnfinishedApproval a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyUnfinishedApproval" ;
    rdfs:comment "TRUE when a claim I own has been reviewed and is waiting on my approval." .

pko-native-procedural-knowledge-rulebook:isNamedButUnexercised a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelCharter ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNamedButUnexercised" ;
    rdfs:comment "TRUE when a charter in force names a steward who has done nothing or an authority that has decided nothing." .

pko-native-procedural-knowledge-rulebook:isNeededDeprecatedTermNotRehomed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ExternalStandardTerm ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNeededDeprecatedTermNotRehomed" ;
    rdfs:comment "TRUE when the model still needs a deprecated external term and has not taken it into the local namespace." .

pko-native-procedural-knowledge-rulebook:isNeglectedAndDrifting a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNeglectedAndDrifting" ;
    rdfs:comment "TRUE when an unmaintained model carries open drift from practice: a representation degrading into something nobody can rely on." .

pko-native-procedural-knowledge-rulebook:isNestedProcedure a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNestedProcedure" ;
    rdfs:comment "TRUE when the procedure runs inside a larger procedure." .

pko-native-procedural-knowledge-rulebook:isNeverChecked a owl:DatatypeProperty ;
    rdfs:domain pko-extension:StepCondition ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNeverChecked" ;
    rdfs:comment "TRUE for a condition no execution has ever checked." .

pko-native-procedural-knowledge-rulebook:isNeverExercised a owl:DatatypeProperty ;
    rdfs:domain pko:Transition ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNeverExercised" ;
    rdfs:comment "TRUE when at least one end of this transition has never appeared in any step execution." .

pko-native-procedural-knowledge-rulebook:isNeverStatedDimension a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RepertoryGridConstruct ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNeverStatedDimension" ;
    rdfs:comment "TRUE for a dimension the expert uses but only the grid comparison brought out." .

pko-native-procedural-knowledge-rulebook:isNonCanonicalGeneratedValue a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourceTermMention ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonCanonicalGeneratedValue" ;
    rdfs:comment "TRUE when an AI-generated value is not a preferred label of the governed scheme." .

pko-native-procedural-knowledge-rulebook:isNonConformingAccepted a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AuthoringSubmission ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonConformingAccepted" ;
    rdfs:comment "TRUE when a submission that failed profile validation was accepted anyway." .

pko-native-procedural-knowledge-rulebook:isNonHuman a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonHuman" ;
    rdfs:comment "TRUE when this agent is an AI agent or an automated pipeline." .

pko-native-procedural-knowledge-rulebook:isNonHumanAssignment a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonHumanAssignment" ;
    rdfs:comment "TRUE when this assignment places a non-human agent into the role." .

pko-native-procedural-knowledge-rulebook:isNonHumanHeld a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonHumanHeld" ;
    rdfs:comment "TRUE when the role's current agent is an AI agent or automated pipeline." .

pko-native-procedural-knowledge-rulebook:isNonHumanSignIn a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AppUser ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonHumanSignIn" ;
    rdfs:comment "True when a non-human agent has a sign-in identity. Pipelines and AI agents authenticate too, and their tokens are scoped exactly like a person's." .

pko-native-procedural-knowledge-rulebook:isNonPkoStatusInUse a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:LifecycleStatuses ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonPkoStatusInUse" ;
    rdfs:comment "TRUE when a status PKO does not define is held by some version or execution." .

pko-native-procedural-knowledge-rulebook:isNonResolvableTermIri a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:SemanticMappings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonResolvableTermIri" ;
    rdfs:comment "The term cannot be looked up: either its IRI is not an HTTP URI, or the namespace it lives in did not answer when it was last fetched. Measured, not inferred from the IRI's spelling." .

pko-native-procedural-knowledge-rulebook:isNonStandardConfiguration a owl:DatatypeProperty ;
    rdfs:domain pko-industry:Machine ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonStandardConfiguration" ;
    rdfs:comment "TRUE for an unusually configured machine." .

pko-native-procedural-knowledge-rulebook:isNotFromOwnKnowledge a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AssistantAnswer ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNotFromOwnKnowledge" ;
    rdfs:comment "TRUE when a delivered answer rests on nothing from the organization's own procedural knowledge." .

pko-native-procedural-knowledge-rulebook:isNotHousedInDepartment a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNotHousedInDepartment" ;
    rdfs:comment "TRUE when the role sits directly in a company or division rather than a department." .

pko-native-procedural-knowledge-rulebook:isNotKeptCurrent a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNotKeptCurrent" ;
    rdfs:comment "TRUE when the model is unmaintained or its documentation describes a release it is no longer at." .

pko-native-procedural-knowledge-rulebook:isNotQueryValidateReasonReady a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNotQueryValidateReasonReady" ;
    rdfs:comment "TRUE for a current version that no structured query reads, no profile validation passed, or no reasoner has checked." .

pko-native-procedural-knowledge-rulebook:isNotScoredAgainstCriteria a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNotScoredAgainstCriteria" ;
    rdfs:comment "TRUE when a governed release was not scored against every stated quality criterion." .

pko-native-procedural-knowledge-rulebook:isOmittedFromOwnAccount a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ObservedAction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOmittedFromOwnAccount" ;
    rdfs:comment "TRUE when observation saw an action the practitioner's own account left out." .

pko-native-procedural-knowledge-rulebook:isOnReworkLoop a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOnReworkLoop" ;
    rdfs:comment "The procedure can send work back to this step after it has run: the step lies on a cycle of the step graph." .

pko-native-procedural-knowledge-rulebook:isOneOffConnection a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AgentIntegration ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOneOffConnection" ;
    rdfs:comment "TRUE when no other integration shares the pathway this one uses." .

pko-native-procedural-knowledge-rulebook:isOneWayLearning a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProviderEngagement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOneWayLearning" ;
    rdfs:comment "TRUE when a running engagement has knowledge deliverables but knowledge has actually moved in only one direction." .

pko-native-procedural-knowledge-rulebook:isOnlyProposed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelProposal ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOnlyProposed" ;
    rdfs:comment "TRUE for knowledge that is proposed but not yet approved into the model." .

pko-native-procedural-knowledge-rulebook:isOpen a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOpen" .

pko-native-procedural-knowledge-rulebook:isOpenAndBlocking a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeGap ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOpenAndBlocking" ;
    rdfs:comment "TRUE when this gap is both unresolved and declared blocking." .

pko-native-procedural-knowledge-rulebook:isOpenEnded a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOpenEnded" ;
    rdfs:comment "TRUE when the assignment has no end." .

pko-native-procedural-knowledge-rulebook:isOpenOutdatedFlag a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelAnnotation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOpenOutdatedFlag" ;
    rdfs:comment "TRUE for guidance a practitioner flagged as outdated that is still open." .

pko-native-procedural-knowledge-rulebook:isOpenPracticeMismatch a owl:DatatypeProperty ;
    rdfs:domain pko-extension:DriftObservation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOpenPracticeMismatch" ;
    rdfs:comment "TRUE for an unresolved observation that a representation no longer matches how the process runs." .

pko-native-procedural-knowledge-rulebook:isOperatingOutsideBoundary a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOperatingOutsideBoundary" ;
    rdfs:comment "TRUE when this agent has made at least one decision an authority boundary forbids." .

pko-native-procedural-knowledge-rulebook:isOperatingUnderMetSuspensionCondition a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOperatingUnderMetSuspensionCondition" ;
    rdfs:comment "TRUE when a suspension condition has been met and the assignment is nonetheless still active and still deciding." .

pko-native-procedural-knowledge-rulebook:isOptOutAtRiskOfTruncation a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOptOutAtRiskOfTruncation" ;
    rdfs:comment "TRUE when the opt-out phrase is present but sits beyond the first segment, where carrier truncation or out-of-order delivery can hide it. The soft witness." .

pko-native-procedural-knowledge-rulebook:isOptOutInFirstSegment a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOptOutInFirstSegment" ;
    rdfs:comment "TRUE when the opt-out phrase falls inside the first segment, where it is guaranteed to be read." .

pko-native-procedural-knowledge-rulebook:isOrganizationAgent a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOrganizationAgent" ;
    rdfs:comment "TRUE for an organization acting as an agent." .

pko-native-procedural-knowledge-rulebook:isOrganizedAroundOfficialTerm a owl:DatatypeProperty ;
    rdfs:domain pko-extension:VocabularyTerm ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOrganizedAroundOfficialTerm" ;
    rdfs:comment "TRUE when practitioners repeatedly use an alternative wording more than the preferred label the scheme is organized around." .

pko-native-procedural-knowledge-rulebook:isOriginalBaseline a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CompetencyQuestionSetEntry ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOriginalBaseline" ;
    rdfs:comment "TRUE for a question in the original set the model was built against." .

pko-native-procedural-knowledge-rulebook:isOrphanTerm a owl:DatatypeProperty ;
    rdfs:domain pko-extension:VocabularyTerm ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOrphanTerm" ;
    rdfs:comment "TRUE when this term has been defined but nothing in the model actually uses it yet." .

pko-native-procedural-knowledge-rulebook:isOrphanedBlockingControl a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOrphanedBlockingControl" ;
    rdfs:comment "TRUE for a blocking control with nobody named as accountable for it." .

pko-native-procedural-knowledge-rulebook:isOrphanedByRole a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOrphanedByRole" ;
    rdfs:comment "A currently-valid claim whose owning role nobody holds — accountable to a vacancy." .

pko-native-procedural-knowledge-rulebook:isOutOfSpecifiedOrder a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOutOfSpecifiedOrder" ;
    rdfs:comment "TRUE when a step ran straight after a step the specification does not let lead to it." .

pko-native-procedural-knowledge-rulebook:isOutgrownBaselineQuestion a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CompetencyQuestionSetEntry ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOutgrownBaselineQuestion" ;
    rdfs:comment "TRUE for an original question that after more than a year of operation no longer fits what the organization needs." .

pko-native-procedural-knowledge-rulebook:isOutsourced a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourcingFunction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOutsourced" ;
    rdfs:comment "TRUE when an organization other than the client performs the work." .

pko-native-procedural-knowledge-rulebook:isOutsourcedVitalExpertiseProcess a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourcingFunction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOutsourcedVitalExpertiseProcess" ;
    rdfs:comment "TRUE for a strategically vital, expertise-heavy function a provider performs." .

pko-native-procedural-knowledge-rulebook:isOverPrivileged a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AccessPrincipal ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverPrivileged" ;
    rdfs:comment "True when a non-administrator principal can reach every table in the rulebook -- an admin-equivalent principal that was never declared as one." .

pko-native-procedural-knowledge-rulebook:isOverSegmentLimit a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverSegmentLimit" ;
    rdfs:comment "TRUE when a transmitted message split into more segments than the policy permits. The oversize witness." .

pko-native-procedural-knowledge-rulebook:isOverdue a owl:DatatypeProperty ;
    rdfs:domain pko:ReviewEvent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverdue" ;
    rdfs:comment "TRUE when review is overdue." .

pko-native-procedural-knowledge-rulebook:isOverdueForReview a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverdueForReview" ;
    rdfs:comment "TRUE when a currently-valid fragment has gone longer than its stewardship cadence without review." .

pko-native-procedural-knowledge-rulebook:isOverdueGap a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeGap ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverdueGap" ;
    rdfs:comment "TRUE when this acknowledged unknown has outlived the tolerance for its severity." .

pko-native-procedural-knowledge-rulebook:isOverlookedLivingHolder a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverlookedLivingHolder" ;
    rdfs:comment "TRUE when uncaptured know-how has a serving holder no collection relationship has approached." .

pko-native-procedural-knowledge-rulebook:isOverriddenRefusal a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverriddenRefusal" ;
    rdfs:comment "TRUE when a gate refused and the message was transmitted regardless. The override witness." .

pko-native-procedural-knowledge-rulebook:isOwnerless a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOwnerless" ;
    rdfs:comment "TRUE when no ownership charter is in force." .

pko-native-procedural-knowledge-rulebook:isOwnerlessOpenGap a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeGap ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOwnerlessOpenGap" ;
    rdfs:comment "An open gap whose owning role nobody currently holds — an acknowledged unknown with nobody accountable for closing it." .

pko-native-procedural-knowledge-rulebook:isOwnerlessPastAYear a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOwnerlessPastAYear" ;
    rdfs:comment "TRUE for a model that has been under management for more than a year with nobody owning it." .

pko-native-procedural-knowledge-rulebook:isPassedButNeverEvaluated a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPassedButNeverEvaluated" ;
    rdfs:comment "TRUE for a blocking control whose steps carry PASS marks while the control itself has never once been evaluated. The green on those steps says nothing about the control." .

pko-native-procedural-knowledge-rulebook:isPassing a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPassing" .

pko-native-procedural-knowledge-rulebook:isPendingAlignmentDecision a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelProposal ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPendingAlignmentDecision" ;
    rdfs:comment "TRUE for a suggested alignment waiting on a person's modeling decision." .

pko-native-procedural-knowledge-rulebook:isPeopleCapture a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CollectedSourceMaterial ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPeopleCapture" ;
    rdfs:comment "TRUE for material captured from people: a transcript or field notes." .

pko-native-procedural-knowledge-rulebook:isPerfect a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPerfect" .

pko-native-procedural-knowledge-rulebook:isPkoStatus a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:LifecycleStatuses ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPkoStatus" ;
    rdfs:comment "TRUE when PKO 2.0.0 defines this individual." .

pko-native-procedural-knowledge-rulebook:isPoorlyTimedUnanswered a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPoorlyTimedUnanswered" ;
    rdfs:comment "TRUE when an unanswered message was delivered outside business hours -- a timing hypothesis for the silence." .

pko-native-procedural-knowledge-rulebook:isPositiveControl a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AccessDenialTest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPositiveControl" ;
    rdfs:comment "True when this test asserts a row the principal IS entitled to. A denial suite with no positive controls cannot distinguish a working policy from one that denies everything." .

pko-native-procedural-knowledge-rulebook:isPracticeEvidence a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CollectedSourceMaterial ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPracticeEvidence" ;
    rdfs:comment "TRUE for material that records the work as performed: field notes or a mined event trace." .

pko-native-procedural-knowledge-rulebook:isPractitioner a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationParticipant ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPractitioner" ;
    rdfs:comment "TRUE for a practitioner who holds process knowledge." .

pko-native-procedural-knowledge-rulebook:isPreparationStep a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPreparationStep" ;
    rdfs:comment "TRUE for steps whose assigned role produces the work product rather than reviewing it." .

pko-native-procedural-knowledge-rulebook:isProceduralKnowledge a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeHolding ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsProceduralKnowledge" ;
    rdfs:comment "TRUE once the knowledge is formalized as a typed fragment of the procedure ontology." .

pko-native-procedural-knowledge-rulebook:isProcedureWithoutChangeAuthority a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsProcedureWithoutChangeAuthority" ;
    rdfs:comment "TRUE for a procedure family where nobody currently holds authority to create, change or retire its definition." .

pko-native-procedural-knowledge-rulebook:isProductionReleaseApprover a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsProductionReleaseApprover" ;
    rdfs:comment "TRUE for the role that approves production releases." .

pko-native-procedural-knowledge-rulebook:isProficient a owl:DatatypeProperty ;
    rdfs:domain pko-extension:OnboardingRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsProficient" ;
    rdfs:comment "TRUE once signed off." .

pko-native-procedural-knowledge-rulebook:isProperlyHandledRefusal a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsProperlyHandledRefusal" ;
    rdfs:comment "TRUE when a refusal correctly resulted in a non-transmitted delivery record citing a documented exception. The positive witness." .

pko-native-procedural-knowledge-rulebook:isPublished a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPublished" .

pko-native-procedural-knowledge-rulebook:isQuestionProof a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsQuestionProof" ;
    rdfs:comment "Evidence is an answered role question with a computed answer." .

pko-native-procedural-knowledge-rulebook:isQuietHoursViolation a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsQuietHoursViolation" ;
    rdfs:comment "TRUE when a message was actually transmitted inside a declared quiet-hours window. The quiet-hours witness." .

pko-native-procedural-knowledge-rulebook:isReachableFromEntryWithoutHumanGate a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReachableFromEntryWithoutHumanGate" ;
    rdfs:comment "Work can arrive at this step from the start of the procedure without passing any human approval gate." .

pko-native-procedural-knowledge-rulebook:isReadableInFullByNonAdmin a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RulebookTable ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReadableInFullByNonAdmin" ;
    rdfs:comment "Some principal who is not an administrator can read every row of this table: a policy exists, so the table is secured, but it controls nothing. This is the violation an access review looks for, and it is the reason 'has a policy' is not the test." .

pko-native-procedural-knowledge-rulebook:isReadyForExecution a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReadyForExecution" ;
    rdfs:comment "TRUE when approved, populated, and free of blocking knowledge gaps." .

pko-native-procedural-knowledge-rulebook:isRecentApprenticeship a owl:DatatypeProperty ;
    rdfs:domain pko-extension:Mentorship ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRecentApprenticeship" ;
    rdfs:comment "TRUE for an apprenticeship started within three years." .

pko-native-procedural-knowledge-rulebook:isRecentDeprecation a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ExternalStandardTerm ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRecentDeprecation" ;
    rdfs:comment "TRUE when the source deprecated the term within the last two years." .

pko-native-procedural-knowledge-rulebook:isRecentStart a owl:DatatypeProperty ;
    rdfs:domain pko-extension:OnboardingRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRecentStart" ;
    rdfs:comment "TRUE when the starter began within 180 days of the evaluation instant." .

pko-native-procedural-knowledge-rulebook:isRecognizedBroker a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRecognizedBroker" ;
    rdfs:comment "TRUE when at least three people actively rely on this agent as an informal knowledge broker." .

pko-native-procedural-knowledge-rulebook:isReconciled a owl:DatatypeProperty ;
    rdfs:domain pko-extension:WorkflowViewDivergence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReconciled" ;
    rdfs:comment "TRUE when a settled account is recorded." .

pko-native-procedural-knowledge-rulebook:isRecordedAfterTheFact a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcessDesignDecision ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRecordedAfterTheFact" ;
    rdfs:comment "TRUE when a decision was written down more than thirty days after it was made, so its why was reconstructed from memory." .

pko-native-procedural-knowledge-rulebook:isRecordedDiscriminatingDimension a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RepertoryGridConstruct ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRecordedDiscriminatingDimension" ;
    rdfs:comment "TRUE for a recorded dimension that tells the compared situations apart." .

pko-native-procedural-knowledge-rulebook:isRecoveryPath a owl:DatatypeProperty ;
    rdfs:domain pko:Transition ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRecoveryPath" ;
    rdfs:comment "TRUE when this transition is a non-default path taken because something went wrong." .

pko-native-procedural-knowledge-rulebook:isRefusedWithNoAlternative a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRefusedWithNoAlternative" ;
    rdfs:comment "TRUE when a send was refused and no attempt was ever made on any other channel." .

pko-native-procedural-knowledge-rulebook:isRegulatedButUnformalized a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRegulatedButUnformalized" ;
    rdfs:comment "TRUE for a procedure a regulation requires that exists only as a title and documents." .

pko-native-procedural-knowledge-rulebook:isRegulatoryRequirement a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRegulatoryRequirement" ;
    rdfs:comment "TRUE when a regulation imposes the requirement." .

pko-native-procedural-knowledge-rulebook:isRehomedWithoutIdentityLink a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ExternalStandardTerm ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRehomedWithoutIdentityLink" ;
    rdfs:comment "TRUE when a re-homed local concept does not assert identity with the external original." .

pko-native-procedural-knowledge-rulebook:isRehomedWithoutNewRelease a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ExternalStandardTerm ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRehomedWithoutNewRelease" ;
    rdfs:comment "TRUE when a term was re-homed without a model release issued after the deprecation that introduced it." .

pko-native-procedural-knowledge-rulebook:isRelearnedSolvedProblem a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProblemOccurrence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRelearnedSolvedProblem" ;
    rdfs:comment "TRUE when a problem solved before came back and its earlier fix had not been recorded." .

pko-native-procedural-knowledge-rulebook:isReleaseApprovalGate a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReleaseApprovalGate" ;
    rdfs:comment "TRUE for an approval gate in a software release procedure." .

pko-native-procedural-knowledge-rulebook:isReleaseWithoutRecordedChanges a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReleaseWithoutRecordedChanges" ;
    rdfs:comment "TRUE when a release after the first records no change log entries, so what changed is not on record." .

pko-native-procedural-knowledge-rulebook:isReleasedWithoutLicenceOrPermanentId a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReleasedWithoutLicenceOrPermanentId" ;
    rdfs:comment "TRUE when a governed release carries no licence or no permanent identifier." .

pko-native-procedural-knowledge-rulebook:isReliedUpon a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReliedUpon" ;
    rdfs:comment "TRUE when this claim is attached to a specific step and is inside its validity window — i.e. it is operationally in play." .

pko-native-procedural-knowledge-rulebook:isRequiredGatekeptUncodified a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeGap ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRequiredGatekeptUncodified" ;
    rdfs:comment "TRUE for blocking gatekept or sabotaged knowledge never drawn out and codified." .

pko-native-procedural-knowledge-rulebook:isReservedClaim a owl:DatatypeProperty ;
    rdfs:domain pko-extension:JwtClaimMapping ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReservedClaim" ;
    rdfs:comment "True for claims magic-links controls and an app cannot override: email, iss, iat, nbf, exp, sub, tenant_id." .

pko-native-procedural-knowledge-rulebook:isReservedJudgmentOverride a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AgentDecisionRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReservedJudgmentOverride" ;
    rdfs:comment "TRUE when the override was a human exercising authority the procedure always reserved to them." .

pko-native-procedural-knowledge-rulebook:isRetentionBreach a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRetentionBreach" ;
    rdfs:comment "TRUE when we are obliged to hold the message text and do not. The evidentiary-gap witness." .

pko-native-procedural-knowledge-rulebook:isReviewOverdueForChangeRate a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:OntologyProfiles ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReviewOverdueForChangeRate" ;
    rdfs:comment "TRUE when a fast-changing standard has not had its dependency reviewed in 180 days." .

pko-native-procedural-knowledge-rulebook:isReviewedRecording a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationSession ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReviewedRecording" ;
    rdfs:comment "TRUE when the practitioner reviewed a recording of their own work afterward to explain it." .

pko-native-procedural-knowledge-rulebook:isRichnessTractabilityFailure a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ReasonerRun ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRichnessTractabilityFailure" ;
    rdfs:comment "TRUE when a run either blew its reasoning budget or kept to budget only by dropping axioms." .

pko-native-procedural-knowledge-rulebook:isRuleBypassed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ChangeAuthorityRule ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRuleBypassed" ;
    rdfs:comment "TRUE when at least one change went around this rule's required process." .

pko-native-procedural-knowledge-rulebook:isSafetyCritical a owl:DatatypeProperty ;
    rdfs:domain pko-extension:StepCondition ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSafetyCritical" ;
    rdfs:comment "TRUE when breaking it endangers people." .

pko-native-procedural-knowledge-rulebook:isSanctionedDualHolding a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelCharter ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSanctionedDualHolding" ;
    rdfs:comment "TRUE when one person holds two distinct steward and authority roles in an organization of fifty or fewer, which needs no committee." .

pko-native-procedural-knowledge-rulebook:isScenarioProof a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsScenarioProof" ;
    rdfs:comment "Evidence is a procedure with recorded executions." .

pko-native-procedural-knowledge-rulebook:isSchemaChange a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSchemaChange" ;
    rdfs:comment "TRUE for a change to the schema layer." .

pko-native-procedural-knowledge-rulebook:isSchemaChangeWithoutIncrement a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSchemaChangeWithoutIncrement" ;
    rdfs:comment "TRUE when a schema change shipped in no versioned release." .

pko-native-procedural-knowledge-rulebook:isScopedToRetiredVersion a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsScopedToRetiredVersion" ;
    rdfs:comment "TRUE when a current assignment is held for a version that is deprecated or archived." .

pko-native-procedural-knowledge-rulebook:isScoredBreach a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ConditionCheck ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsScoredBreach" ;
    rdfs:comment "This check recorded that the condition did not hold, and the rule it enforces is computed by the register: a breach counted by the register itself, not by a person looking." .

pko-native-procedural-knowledge-rulebook:isSealed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RoleSchema ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSealed" ;
    rdfs:comment "True when the principal may not create objects in its own schema." .

pko-native-procedural-knowledge-rulebook:isSelfValidated a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSelfValidated" ;
    rdfs:comment "TRUE when the agent who derived the knowledge is the one who confirmed it." .

pko-native-procedural-knowledge-rulebook:isSelfWitnessed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:VerificationOutcome ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSelfWitnessed" ;
    rdfs:comment "TRUE when the agent who observed the verification signal is the same agent who executed the step being verified." .

pko-native-procedural-knowledge-rulebook:isSelfWitnessedAndUnbacked a owl:DatatypeProperty ;
    rdfs:domain pko-extension:VerificationOutcome ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSelfWitnessedAndUnbacked" ;
    rdfs:comment "TRUE when the executor observed their own passing signal and attached no evidence." .

pko-native-procedural-knowledge-rulebook:isSelfWitnessedDecision a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSelfWitnessedDecision" ;
    rdfs:comment "TRUE when the entire decision to send or refuse rests solely on my own computation, unconfirmed by anything else." .

pko-native-procedural-knowledge-rulebook:isSendableUnderApproval a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSendableUnderApproval" ;
    rdfs:comment "TRUE only when the template is marked Approved, has a properly-authorized approval, AND its body still matches what was approved." .

pko-native-procedural-knowledge-rulebook:isSeniorVariantNotSpecialization a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSeniorVariantNotSpecialization" ;
    rdfs:comment "TRUE when a senior version of a role is not recorded as a specialization of a role in its own family." .

pko-native-procedural-knowledge-rulebook:isShadowIntegration a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AgentIntegration ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsShadowIntegration" ;
    rdfs:comment "TRUE when an integration is in live use but has no entry in the central registry." .

pko-native-procedural-knowledge-rulebook:isShared a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AppRoute ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsShared" ;
    rdfs:comment "Whether this route is shared across domain roles rather than owned by one. A maintainer route is not shared — it belongs to a different surface entirely." .

pko-native-procedural-knowledge-rulebook:isShortTermWithoutJointKnowledge a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProviderEngagement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsShortTermWithoutJointKnowledge" ;
    rdfs:comment "TRUE when a running engagement is contracted for under three years and builds no knowledge jointly." .

pko-native-procedural-knowledge-rulebook:isSilentlyDropped a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSilentlyDropped" ;
    rdfs:comment "TRUE when a gate refused and no delivery record of any kind was produced -- the recipient vanished from the run." .

pko-native-procedural-knowledge-rulebook:isSingleKindFrame a owl:DatatypeProperty ;
    rdfs:domain pko-extension:Vocabulary ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSingleKindFrame" ;
    rdfs:comment "TRUE when a scheme organizes several materials but only one kind of knowledge." .

pko-native-procedural-knowledge-rulebook:isSinglePointOfFailure a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSinglePointOfFailure" ;
    rdfs:comment "A claim that rests on exactly one person's word and that an active exception handler actually routes cases against." .

pko-native-procedural-knowledge-rulebook:isSingleTeamSilo a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeAuditItem ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSingleTeamSilo" ;
    rdfs:comment "TRUE when knowledge the client does hold sits with exactly one internal team." .

pko-native-procedural-knowledge-rulebook:isSingleWitnessMethod a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationSession ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSingleWitnessMethod" ;
    rdfs:comment "TRUE when this session captured one practitioner's account rather than a group's." .

pko-native-procedural-knowledge-rulebook:isSmallChoice a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ObservedAction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSmallChoice" ;
    rdfs:comment "TRUE for a small choice made during actual practice." .

pko-native-procedural-knowledge-rulebook:isSmsReachable a owl:DatatypeProperty ;
    rdfs:domain pko-extension:Recipient ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSmsReachable" ;
    rdfs:comment "TRUE when a mobile number is on file for this recipient." .

pko-native-procedural-knowledge-rulebook:isSocialNetworkChannel a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeTransfer ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSocialNetworkChannel" ;
    rdfs:comment "TRUE for relationships, collaboration, design-production iteration and people changing employers." .

pko-native-procedural-knowledge-rulebook:isSoftwareAssigned a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSoftwareAssigned" ;
    rdfs:comment "TRUE when this step is specified to be performed by software rather than a person." .

pko-native-procedural-knowledge-rulebook:isSolved a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProblemOccurrence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSolved" ;
    rdfs:comment "TRUE once the occurrence was solved." .

pko-native-procedural-knowledge-rulebook:isSolvedWithoutRecordedSolution a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProblemOccurrence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSolvedWithoutRecordedSolution" ;
    rdfs:comment "TRUE when the problem was solved and the solution was not recorded." .

pko-native-procedural-knowledge-rulebook:isSourceChangedSinceTaken a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSourceChangedSinceTaken" ;
    rdfs:comment "TRUE when the source document was revised after the knowledge was taken from it." .

pko-native-procedural-knowledge-rulebook:isSpecialist a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CommunityMembership ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSpecialist" ;
    rdfs:comment "TRUE when the member is a specialist others in the community consult." .

pko-native-procedural-knowledge-rulebook:isStageWithoutFeedback a owl:DatatypeProperty ;
    rdfs:domain pko-extension:EncodingLifecycleStage ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStageWithoutFeedback" ;
    rdfs:comment "TRUE for a lifecycle stage from which no feedback at all has come back." .

pko-native-procedural-knowledge-rulebook:isStale a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeRepositoryEntry ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStale" ;
    rdfs:comment "TRUE when the entry has gone longer than its review interval without revision." .

pko-native-procedural-knowledge-rulebook:isStaleAndAuthoritative a owl:DatatypeProperty ;
    rdfs:domain pko-extension:OperationalBinding ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStaleAndAuthoritative" ;
    rdfs:comment "TRUE when an authoritative binding has aged past its freshness SLA." .

pko-native-procedural-knowledge-rulebook:isStaleConcentratedWitness a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationSession ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStaleConcentratedWitness" ;
    rdfs:comment "A concentrated single-witness session more than 180 days old — matching the single-witness expiry horizon loop 1 already established." .

pko-native-procedural-knowledge-rulebook:isStaleDeferral a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStaleDeferral" ;
    rdfs:comment "TRUE when a deferred send has been waiting more than 24 hours -- longer than any quiet window can justify." .

pko-native-procedural-knowledge-rulebook:isStaleExtraction a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Resources ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStaleExtraction" ;
    rdfs:comment "TRUE when the source a resource was extracted from changed after the extraction was last updated." .

pko-native-procedural-knowledge-rulebook:isStaleMiningEvidence a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcessMiningRun ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStaleMiningEvidence" ;
    rdfs:comment "TRUE when this mining evidence is more than 180 days old." .

pko-native-procedural-knowledge-rulebook:isStaleRoleAssertion a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStaleRoleAssertion" ;
    rdfs:comment "TRUE when the assertion rests on a role assignment that is no longer current." .

pko-native-procedural-knowledge-rulebook:isStalled a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStalled" ;
    rdfs:comment "TRUE when an undecided change request has been pending more than fourteen days." .

pko-native-procedural-knowledge-rulebook:isStalledImplementation a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStalledImplementation" ;
    rdfs:comment "An approved change request that has sat unimplemented for more than two weeks." .

pko-native-procedural-knowledge-rulebook:isStandardProof a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStandardProof" ;
    rdfs:comment "Evidence is a mapped ontology profile or an applied knowledge method." .

pko-native-procedural-knowledge-rulebook:isStandardizedWithoutTacitCapture a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStandardizedWithoutTacitCapture" ;
    rdfs:comment "TRUE when a version standardized for compliance has no tacit knowledge captured behind it." .

pko-native-procedural-knowledge-rulebook:isStandingUnreviewedAutomation a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStandingUnreviewedAutomation" ;
    rdfs:comment "TRUE when a currently-active non-human assignment has been running past its authorization review date." .

pko-native-procedural-knowledge-rulebook:isStartingFromNothing a owl:DatatypeProperty ;
    rdfs:domain pko-extension:OnboardingRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStartingFromNothing" ;
    rdfs:comment "TRUE when a newcomer joins a procedure whose previous holders left and nothing was captured." .

pko-native-procedural-knowledge-rulebook:isStated a owl:DatatypeProperty ;
    rdfs:domain pko-extension:QualityCriterion ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStated" ;
    rdfs:comment "Part of the stated criteria." .

pko-native-procedural-knowledge-rulebook:isStewardUnwritten a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelCharter ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStewardUnwritten" ;
    rdfs:comment "TRUE when no steward is named or the steward has no written responsibilities." .

pko-native-procedural-knowledge-rulebook:isStillEngaged a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStillEngaged" ;
    rdfs:comment "TRUE when this agent currently holds at least one role in the organization." .

pko-native-procedural-knowledge-rulebook:isStillPending a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStillPending" ;
    rdfs:comment "TRUE when the request is in an open status and has no decision recorded." .

pko-native-procedural-knowledge-rulebook:isStillReferenced a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStillReferenced" ;
    rdfs:comment "Whether any other version points at this one through a supersession link." .

pko-native-procedural-knowledge-rulebook:isStrategicallyVital a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourcingFunction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStrategicallyVital" ;
    rdfs:comment "TRUE when the organization cannot deliver its strategy without the function." .

pko-native-procedural-knowledge-rulebook:isStructuralChange a owl:DatatypeProperty ;
    rdfs:domain pko-extension:TermMeaningChange ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStructuralChange" ;
    rdfs:comment "TRUE when the thing referred to changed shape, not just wording." .

pko-native-procedural-knowledge-rulebook:isStructuralProof a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStructuralProof" ;
    rdfs:comment "Evidence is a table with rows or a field with data." .

pko-native-procedural-knowledge-rulebook:isStructurallyComplete a owl:DatatypeProperty ;
    rdfs:domain pko:ProcedureExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStructurallyComplete" ;
    rdfs:comment "TRUE when every specified step of the procedure version reached Completed in this execution." .

pko-native-procedural-knowledge-rulebook:isStudiedOnlyFromTheDesk a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStudiedOnlyFromTheDesk" ;
    rdfs:comment "TRUE when the knowledge engineer elicited the version but never went where the work happens." .

pko-native-procedural-knowledge-rulebook:isSubjectMatterExpert a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationParticipant ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSubjectMatterExpert" ;
    rdfs:comment "TRUE for a subject matter expert." .

pko-native-procedural-knowledge-rulebook:isSubstantivelyClean a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSubstantivelyClean" ;
    rdfs:comment "TRUE when this execution is clean AND every declared check was actually performed." .

pko-native-procedural-knowledge-rulebook:isSubstrateContested a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RulebookField ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSubstrateContested" ;
    rdfs:comment "True when at least one substrate disagrees about this field's values." .

pko-native-procedural-knowledge-rulebook:isSuppressed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSuppressed" ;
    rdfs:comment "TRUE when we deliberately chose not to transmit." .

pko-native-procedural-knowledge-rulebook:isSuppressionWithoutRemedy a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSuppressionWithoutRemedy" ;
    rdfs:comment "TRUE when we cited an exception that prescribed an alternate channel and then never performed it." .

pko-native-procedural-knowledge-rulebook:isSurfacedButUnreconciled a owl:DatatypeProperty ;
    rdfs:domain pko-extension:WorkflowViewDivergence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSurfacedButUnreconciled" ;
    rdfs:comment "TRUE when two differing views were brought into the open but never reconciled." .

pko-native-procedural-knowledge-rulebook:isTacitOnlyAgentTarget a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTacitOnlyAgentTarget" ;
    rdfs:comment "TRUE for a procedure intended for agent execution that exists only as tacit knowledge." .

pko-native-procedural-knowledge-rulebook:isTacitSignalNotFedIntoCollection a owl:DatatypeProperty ;
    rdfs:domain pko:UserFeedbackOccurrence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTacitSignalNotFedIntoCollection" ;
    rdfs:comment "TRUE when feedback that surfaces tacit know-how prompted no collection." .

pko-native-procedural-knowledge-rulebook:isTagOutsideCapabilityScheme a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RoleCapabilityTag ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTagOutsideCapabilityScheme" ;
    rdfs:comment "TRUE when a capability tag is drawn from a scheme that does not govern agent capabilities." .

pko-native-procedural-knowledge-rulebook:isTemplate a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTemplate" ;
    rdfs:comment "TRUE when the procedure is a reusable template; maps to pko:isTemplate." .

pko-native-procedural-knowledge-rulebook:isTemplateInstance a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTemplateInstance" ;
    rdfs:comment "TRUE when the procedure instantiates a template." .

pko-native-procedural-knowledge-rulebook:isTemplateOverLength a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTemplateOverLength" ;
    rdfs:comment "TRUE when the template body alone already exceeds the single-segment limit before any variables are substituted in." .

pko-native-procedural-knowledge-rulebook:isTraditionalChannel a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeTransfer ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTraditionalChannel" ;
    rdfs:comment "TRUE for the traditional channels: documents, training programs and mentoring." .

pko-native-procedural-knowledge-rulebook:isTrainedSkill a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTrainedSkill" ;
    rdfs:comment "TRUE when the know-how is carried as trained skill of seasoned workers." .

pko-native-procedural-knowledge-rulebook:isTriaged a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTriaged" ;
    rdfs:comment "TRUE when some documented exception was formally invoked on this delivery -- i.e. a human or a rule picked it up." .

pko-native-procedural-knowledge-rulebook:isTurnoverRegression a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProblemOccurrence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTurnoverRegression" ;
    rdfs:comment "TRUE when an unrecorded fix came back after the person who made it left." .

pko-native-procedural-knowledge-rulebook:isUltimateGoal a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ConceptLadderRung ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUltimateGoal" ;
    rdfs:comment "TRUE for the top rung above an action: the goal or value it ultimately serves." .

pko-native-procedural-knowledge-rulebook:isUnactedAdverseOutcome a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeOutcomeMeasurement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnactedAdverseOutcome" ;
    rdfs:comment "TRUE when an outcome worse than tolerated fed no change request and no investment decision." .

pko-native-procedural-knowledge-rulebook:isUnactionedProcedureCritique a owl:DatatypeProperty ;
    rdfs:domain pko:UserFeedbackOccurrence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnactionedProcedureCritique" ;
    rdfs:comment "TRUE when feedback criticizes the procedure and no change request carries it forward." .

pko-native-procedural-knowledge-rulebook:isUnaddressedQuestion a owl:DatatypeProperty ;
    rdfs:domain pko:UserQuestionOccurrence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnaddressedQuestion" ;
    rdfs:comment "TRUE when a question asked during execution has no resource or FAQ addressing it." .

pko-native-procedural-knowledge-rulebook:isUnalignedToStandard a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RulebookTable ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnalignedToStandard" ;
    rdfs:comment "TRUE when a table maps to no term of any external standard, so outside systems cannot interpret it." .

pko-native-procedural-knowledge-rulebook:isUnannouncedToDependents a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnannouncedToDependents" ;
    rdfs:comment "TRUE when some consumer that depends on the model was not told of the release." .

pko-native-procedural-knowledge-rulebook:isUnanswerableSign a owl:DatatypeProperty ;
    rdfs:domain pko-extension:StepCue ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnanswerableSign" ;
    rdfs:comment "A sign that means 'not finished' but points at no failure mode, so neither the runner nor the assistant can say what to do about it." .

pko-native-procedural-knowledge-rulebook:isUnanswerableToday a owl:DatatypeProperty ;
    rdfs:domain pko-extension:StakeholderQuestion ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnanswerableToday" ;
    rdfs:comment "TRUE when no competency question of the model answers the stakeholder's question." .

pko-native-procedural-knowledge-rulebook:isUnansweredPastDue a owl:DatatypeProperty ;
    rdfs:domain pko-extension:StakeholderQuestion ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnansweredPastDue" ;
    rdfs:comment "TRUE when a user's question has gone more than fourteen days with no response." .

pko-native-procedural-knowledge-rulebook:isUnapprovedAndHumanConsumed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnapprovedAndHumanConsumed" ;
    rdfs:comment "An unapproved claim relied on by a human-assigned step — a reviewable risk rather than a silent one." .

pko-native-procedural-knowledge-rulebook:isUnapprovedAndMachineConsumed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnapprovedAndMachineConsumed" ;
    rdfs:comment "An unapproved claim that a software-assigned step actually relies on — executed literally, with no human in position to notice it is wrong." .

pko-native-procedural-knowledge-rulebook:isUnapprovedAndOperationallyLive a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnapprovedAndOperationallyLive" ;
    rdfs:comment "TRUE when a claim awaiting my approval is already being acted on through a documented exception path." .

pko-native-procedural-knowledge-rulebook:isUnapprovedButReliedOn a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnapprovedButReliedOn" ;
    rdfs:comment "TRUE when a live procedure is acting on a claim that has not been approved by the knowledge authority." .

pko-native-procedural-knowledge-rulebook:isUnapprovedSend a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnapprovedSend" ;
    rdfs:comment "TRUE when a message was transmitted using a template with no valid approval behind it." .

pko-native-procedural-knowledge-rulebook:isUnattributedChange a owl:DatatypeProperty ;
    rdfs:domain pko:ChangeOfStatus ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnattributedChange" ;
    rdfs:comment "TRUE when nobody is recorded as making the change." .

pko-native-procedural-knowledge-rulebook:isUnattributedGatekeeping a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeGap ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnattributedGatekeeping" ;
    rdfs:comment "TRUE when a holder was recorded declining to share but the gap is not identified as gatekeeping or sabotage." .

pko-native-procedural-knowledge-rulebook:isUnauditedFunction a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourcingFunction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnauditedFunction" ;
    rdfs:comment "TRUE when an outsourced or strategically vital function has never been audited for held against needed knowledge." .

pko-native-procedural-knowledge-rulebook:isUnauthorizedApproval a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnauthorizedApproval" ;
    rdfs:comment "TRUE when an approval step was executed by an agent who does not hold the required approving role." .

pko-native-procedural-knowledge-rulebook:isUnauthorizedEnforcementAgent a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnauthorizedEnforcementAgent" ;
    rdfs:comment "TRUE when a non-human agent enforces controls on others while holding no recorded authorization of its own." .

pko-native-procedural-knowledge-rulebook:isUnauthorizedNonHumanAssignment a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnauthorizedNonHumanAssignment" ;
    rdfs:comment "TRUE when a non-human agent holds this role with no approving authority recorded at all. An authority named without a change request is still an authority; the separate WasAuthorizedByChangeRequest column carries that weaker distinction." .

pko-native-procedural-knowledge-rulebook:isUnbackedObservation a owl:DatatypeProperty ;
    rdfs:domain pko-extension:VerificationOutcome ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnbackedObservation" ;
    rdfs:comment "TRUE when a verification was recorded as matching but no evidence artifact was retained." .

pko-native-procedural-knowledge-rulebook:isUncapturedPriorityProcess a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourcingFunction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUncapturedPriorityProcess" ;
    rdfs:comment "TRUE for a vital, expertise-heavy function that is outsourced or has a coverage gap and has no deliberate capture initiative." .

pko-native-procedural-knowledge-rulebook:isUnchasedAcknowledgement a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnchasedAcknowledgement" ;
    rdfs:comment "TRUE when an acknowledgement has been outstanding for more than 7 days and I have never sent a reminder." .

pko-native-procedural-knowledge-rulebook:isUncheckedByDesign a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUncheckedByDesign" ;
    rdfs:comment "TRUE when the specification asked for no verification and no blocking control on this step at all." .

pko-native-procedural-knowledge-rulebook:isUncheckedRegulatedRecommendation a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AssistantAnswer ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUncheckedRegulatedRecommendation" ;
    rdfs:comment "TRUE for a recommendation on a regulated step that was never checked against its requirements." .

pko-native-procedural-knowledge-rulebook:isUnclassifiedAgent a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnclassifiedAgent" ;
    rdfs:comment "TRUE when an agent is not classified as a person, AI agent, automated pipeline or organization." .

pko-native-procedural-knowledge-rulebook:isUnconditionedAutomationHandover a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnconditionedAutomationHandover" ;
    rdfs:comment "TRUE when a human-to-machine handover was authorized with no promised review cadence at all -- granted once, permanently." .

pko-native-procedural-knowledge-rulebook:isUnconfirmedCompletion a owl:DatatypeProperty ;
    rdfs:domain pko:ProcedureExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnconfirmedCompletion" ;
    rdfs:comment "TRUE when an execution completed with nobody recorded as confirming it." .

pko-native-procedural-knowledge-rulebook:isUnconfirmedConsistency a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ChangeValidationRun ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnconfirmedConsistency" ;
    rdfs:comment "TRUE when a run did not confirm the model free of logical inconsistency." .

pko-native-procedural-knowledge-rulebook:isUnconfirmedNonHumanDecision a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AgentDecisionRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnconfirmedNonHumanDecision" ;
    rdfs:comment "TRUE when a material non-human decision was never confirmed by a human." .

pko-native-procedural-knowledge-rulebook:isUncontrolledWording a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourceTermMention ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUncontrolledWording" ;
    rdfs:comment "TRUE when a wording resolves to no concept label in its scheme." .

pko-native-procedural-knowledge-rulebook:isUncorroboratedPass a owl:DatatypeProperty ;
    rdfs:domain pko-extension:VerificationOutcome ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUncorroboratedPass" ;
    rdfs:comment "TRUE when a PASSING signal was self-observed with no evidence behind it." .

pko-native-procedural-knowledge-rulebook:isUncovered a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ExpansionConceptFit ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUncovered" ;
    rdfs:comment "TRUE when no existing table covers the concept." .

pko-native-procedural-knowledge-rulebook:isUncoveredArea a owl:DatatypeProperty ;
    rdfs:domain pko-extension:DomainCoverageArea ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUncoveredArea" ;
    rdfs:comment "TRUE when no table covers a required area." .

pko-native-procedural-knowledge-rulebook:isUncreditedExpertKnowHow a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeRepositoryEntry ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUncreditedExpertKnowHow" ;
    rdfs:comment "TRUE when an entry records another person's expertise without crediting them." .

pko-native-procedural-knowledge-rulebook:isUndeclaredToolUse a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AiToolInvocation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUndeclaredToolUse" ;
    rdfs:comment "TRUE when an AI agent used a tool the process graph does not declare on that step." .

pko-native-procedural-knowledge-rulebook:isUndefendableTacitClaim a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUndefendableTacitClaim" ;
    rdfs:comment "TRUE when an orphaned claim is of a kind that lives in a person's head rather than in a document." .

pko-native-procedural-knowledge-rulebook:isUnderSpecifiedForExecution a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnderSpecifiedForExecution" ;
    rdfs:comment "TRUE when a version cannot tell an executor what must hold, or what to do when things go wrong: no steps, no step with a precondition, or no exception handling." .

pko-native-procedural-knowledge-rulebook:isUndocumentedBranch a owl:DatatypeProperty ;
    rdfs:domain pko:Transition ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUndocumentedBranch" ;
    rdfs:comment "TRUE for an alternative or fallback branch no decision point explains." .

pko-native-procedural-knowledge-rulebook:isUndocumentedPath a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MinedFlowEdge ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUndocumentedPath" ;
    rdfs:comment "TRUE when cases took a hand-off the documented model does not contain." .

pko-native-procedural-knowledge-rulebook:isUndocumentedVersionDecision a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUndocumentedVersionDecision" ;
    rdfs:comment "TRUE when a governed release records no rationale or no decider for its version increment." .

pko-native-procedural-knowledge-rulebook:isUnescalatedDangerCue a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CueObservation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnescalatedDangerCue" ;
    rdfs:comment "TRUE when a danger cue was seen and nobody escalated it." .

pko-native-procedural-knowledge-rulebook:isUnescalatedRefusal a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnescalatedRefusal" ;
    rdfs:comment "TRUE when a refusal was recorded but no human role was ever told." .

pko-native-procedural-knowledge-rulebook:isUnevaluableRefusal a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnevaluableRefusal" ;
    rdfs:comment "TRUE when I refused a send but at least one gate input could not be resolved -- so I do not actually know whether the rule was violated or merely unreadable." .

pko-native-procedural-knowledge-rulebook:isUnexercisedBlockingBinding a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:StepRequirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnexercisedBlockingBinding" ;
    rdfs:comment "TRUE for a blocking control bound to a step where it has never actually been evaluated." .

pko-native-procedural-knowledge-rulebook:isUnexercisedHumanGate a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnexercisedHumanGate" ;
    rdfs:comment "A human-only approval gate that no software agent has ever attempted — the control is asserted, not demonstrated." .

pko-native-procedural-knowledge-rulebook:isUnexplainedForesight a owl:DatatypeProperty ;
    rdfs:domain pko-extension:PractitionerExpertise ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnexplainedForesight" ;
    rdfs:comment "TRUE when a design judgment later proved right although its holder could not say why." .

pko-native-procedural-knowledge-rulebook:isUnexplainedModification a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnexplainedModification" ;
    rdfs:comment "TRUE when a schema or instance modification is logged with no rationale." .

pko-native-procedural-knowledge-rulebook:isUnexplainedOverride a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AgentDecisionRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnexplainedOverride" ;
    rdfs:comment "TRUE when my output was changed and nobody recorded why." .

pko-native-procedural-knowledge-rulebook:isUnfaithfulToSource a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnfaithfulToSource" ;
    rdfs:comment "TRUE when the modeled step's duration differs from the duration its source states." .

pko-native-procedural-knowledge-rulebook:isUnfalsifiedControl a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnfalsifiedControl" ;
    rdfs:comment "TRUE for a blocking control that HAS been evaluated at least once and has never returned a negative result." .

pko-native-procedural-knowledge-rulebook:isUnfixedWrongAnswer a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CompetencyQuestionRun ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnfixedWrongAnswer" ;
    rdfs:comment "TRUE when a question the model should answer came back wrong and no defect was raised to fix it." .

pko-native-procedural-knowledge-rulebook:isUnformalizedProcessKnowledge a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeHolding ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnformalizedProcessKnowledge" ;
    rdfs:comment "TRUE for lived, unformalized knowledge of how the work gets done." .

pko-native-procedural-knowledge-rulebook:isUngovernedDivergence a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngovernedDivergence" ;
    rdfs:comment "TRUE when this step departed from specification and no exception or approved change covers it." .

pko-native-procedural-knowledge-rulebook:isUngovernedEnforcementRole a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngovernedEnforcementRole" ;
    rdfs:comment "TRUE when a role that enforces controls on others is held with no recorded authorization." .

pko-native-procedural-knowledge-rulebook:isUngovernedInvocation a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ExceptionInvocation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngovernedInvocation" ;
    rdfs:comment "TRUE when an exception was invoked without proper role authority, or routed authority to the preparer." .

pko-native-procedural-knowledge-rulebook:isUngovernedNonHumanRole a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngovernedNonHumanRole" ;
    rdfs:comment "TRUE when a role is pointed at a non-human agent but has no assignment row granting it." .

pko-native-procedural-knowledge-rulebook:isUngroundedAndUntested a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AuthorityBoundary ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngroundedAndUntested" ;
    rdfs:comment "TRUE when a boundary has lapsed ratification AND has never once been exercised -- so neither its authority nor its operation has ever been demonstrated." .

pko-native-procedural-knowledge-rulebook:isUngroundedSynonymSprawl a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AiLabelingRun ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngroundedSynonymSprawl" ;
    rdfs:comment "TRUE when an ungrounded run produced values outside the canonical scheme." .

pko-native-procedural-knowledge-rulebook:isUnhandledNonStandardTarget a owl:DatatypeProperty ;
    rdfs:domain pko:ProcedureTarget ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnhandledNonStandardTarget" ;
    rdfs:comment "TRUE for an unusually configured machine target with no documented handling." .

pko-native-procedural-knowledge-rulebook:isUnhandledUnreachable a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnhandledUnreachable" ;
    rdfs:comment "TRUE when a recipient was unreachable but no documented exception was invoked -- the case fell on the floor silently." .

pko-native-procedural-knowledge-rulebook:isUnidentifiedBoundarySpanner a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnidentifiedBoundarySpanner" ;
    rdfs:comment "TRUE when a person connecting communities was never found by a network analysis." .

pko-native-procedural-knowledge-rulebook:isUnisolatedEnergySource a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MachineEnergySource ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnisolatedEnergySource" ;
    rdfs:comment "TRUE when no step of the governing procedure isolates this energy source." .

pko-native-procedural-knowledge-rulebook:isUnlinkedFailedSearch a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeSearchEvent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnlinkedFailedSearch" ;
    rdfs:comment "TRUE when a search that found nothing useful is linked to no knowledge gap and no usability barrier." .

pko-native-procedural-knowledge-rulebook:isUnlinkedToBusinessOutcome a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcessOutcomeMeasure ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnlinkedToBusinessOutcome" ;
    rdfs:comment "TRUE when a process measure is tied to no business outcome." .

pko-native-procedural-knowledge-rulebook:isUnlinkedToolchainComponent a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeConsumerSystem ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnlinkedToolchainComponent" ;
    rdfs:comment "TRUE for a process modeling tool, semantic repository or AI platform linked to neither the model nor any AI integration." .

pko-native-procedural-knowledge-rulebook:isUnmaintained a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnmaintained" ;
    rdfs:comment "TRUE when no maintenance activity touched the model for more than ninety days." .

pko-native-procedural-knowledge-rulebook:isUnmanageableUndocumentedWork a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnmanageableUndocumentedWork" ;
    rdfs:comment "TRUE for a procedure family whose work was never documented into the knowledge system, so it cannot be managed." .

pko-native-procedural-knowledge-rulebook:isUnmanagedPromptInUse a owl:DatatypeProperty ;
    rdfs:domain pko-extension:PromptTemplate ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnmanagedPromptInUse" ;
    rdfs:comment "TRUE when an agent uses a prompt nobody maintains in the library." .

pko-native-procedural-knowledge-rulebook:isUnmeasuredAutomationHandover a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnmeasuredAutomationHandover" ;
    rdfs:comment "TRUE when a human-to-machine handover is operating without a statistically meaningful quality comparison behind it." .

pko-native-procedural-knowledge-rulebook:isUnmodifiedForTwelveMonths a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnmodifiedForTwelveMonths" ;
    rdfs:comment "TRUE for a current workflow not modified in more than twelve months." .

pko-native-procedural-knowledge-rulebook:isUnnamedFinding a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeAuditItem ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnnamedFinding" ;
    rdfs:comment "TRUE when an audit found a gap or dependency and nobody recorded it as a named knowledge gap." .

pko-native-procedural-knowledge-rulebook:isUnnegotiatedPowerGap a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourceRelationship ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnnegotiatedPowerGap" ;
    rdfs:comment "TRUE when a power imbalance shapes the relationship and nothing was negotiated." .

pko-native-procedural-knowledge-rulebook:isUnofficialWorkaround a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ObservedAction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnofficialWorkaround" ;
    rdfs:comment "TRUE for an unofficial workaround." .

pko-native-procedural-knowledge-rulebook:isUnownedOrEmptyStage a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcessStage ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnownedOrEmptyStage" ;
    rdfs:comment "TRUE when a stage has no owner, an owner role nobody holds, or no steps." .

pko-native-procedural-knowledge-rulebook:isUnpermitted a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AppAction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnpermitted" ;
    rdfs:comment "No access policy permits this action, so the database would refuse it." .

pko-native-procedural-knowledge-rulebook:isUnplannedKnowledgeReturn a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProviderEngagement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnplannedKnowledgeReturn" ;
    rdfs:comment "TRUE when the client relies on a provider's knowledge, the provider keeps the documentation as its property, and nobody planned how the knowledge comes back." .

pko-native-procedural-knowledge-rulebook:isUnproduced a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ExpectedInferenceCheck ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnproduced" ;
    rdfs:comment "TRUE when the produced value is not the expected one." .

pko-native-procedural-knowledge-rulebook:isUnprovableApprovalClaim a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnprovableApprovalClaim" ;
    rdfs:comment "TRUE when we assert this send was approved, hold no frozen evidence, and the template has been re-approved since. The claim cannot be substantiated from the record." .

pko-native-procedural-knowledge-rulebook:isUnproven a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AccessDenialTest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnproven" ;
    rdfs:comment "True when the test has never run, so it proves nothing regardless of how it is written." .

pko-native-procedural-knowledge-rulebook:isUnprovenWrite a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AppAction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnprovenWrite" ;
    rdfs:comment "Permitted, but no denial test proves the policy refuses anyone else." .

pko-native-procedural-knowledge-rulebook:isUnreachable a owl:DatatypeProperty ;
    rdfs:domain pko-extension:Recipient ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnreachable" ;
    rdfs:comment "TRUE when the recipient has neither an email address nor a mobile number -- the exc-unreachable trigger condition." .

pko-native-procedural-knowledge-rulebook:isUnreachableByNavigation a owl:DatatypeProperty ;
    rdfs:domain pko:ProcedureType ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnreachableByNavigation" ;
    rdfs:comment "TRUE when navigating down from the functional domains never reaches this node." .

pko-native-procedural-knowledge-rulebook:isUnreachableKnowledge a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnreachableKnowledge" ;
    rdfs:comment "TRUE for a current version nobody can reach: no published projection and no consuming system." .

pko-native-procedural-knowledge-rulebook:isUnrecordedRefusal a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnrecordedRefusal" ;
    rdfs:comment "TRUE when I refused a send and produced no delivery record, no refusal record, and no exception. The refusal left no trace of any kind." .

pko-native-procedural-knowledge-rulebook:isUnrehearsedControlEntry a owl:DatatypeProperty ;
    rdfs:domain pko:Transition ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnrehearsedControlEntry" ;
    rdfs:comment "A recovery path that has never been traversed and that leads into a step carrying a blocking control." .

pko-native-procedural-knowledge-rulebook:isUnremediatedCadenceBreach a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnremediatedCadenceBreach" ;
    rdfs:comment "A cadence breach with no open change request against the version — a broken promise with no response in motion." .

pko-native-procedural-knowledge-rulebook:isUnreportedMistake a owl:DatatypeProperty ;
    rdfs:domain pko:ProcedureExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnreportedMistake" ;
    rdfs:comment "TRUE when an execution deviated from its steps and nobody filed any feedback about it." .

pko-native-procedural-knowledge-rulebook:isUnreportedRefusalOnMyRules a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnreportedRefusalOnMyRules" ;
    rdfs:comment "TRUE when a refusal I own and could have fixed was never surfaced to me." .

pko-native-procedural-knowledge-rulebook:isUnresolved a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnresolved" .

pko-native-procedural-knowledge-rulebook:isUnresolvedDisagreement a owl:DatatypeProperty ;
    rdfs:domain pko-extension:DepartmentProcessAccount ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnresolvedDisagreement" ;
    rdfs:comment "TRUE when a cross-department conflict has no resolution practice." .

pko-native-procedural-knowledge-rulebook:isUnrestricted a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AccessPolicy ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnrestricted" ;
    rdfs:comment "True when the policy carries no predicate, exposing every row of the target table to the principal." .

pko-native-procedural-knowledge-rulebook:isUnrestrictedNonAdminGrant a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AccessPolicy ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnrestrictedNonAdminGrant" ;
    rdfs:comment "True when a non-administrator principal is granted an unrestricted policy -- a whole-table exposure that no row predicate narrows. The single highest-signal privilege-escalation witness in the model." .

pko-native-procedural-knowledge-rulebook:isUnreviewedSend a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnreviewedSend" ;
    rdfs:comment "TRUE when a message was transmitted under an execution whose legal review had not passed. The ungated-send witness." .

pko-native-procedural-knowledge-rulebook:isUnreviewedSinceAuthoring a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnreviewedSinceAuthoring" ;
    rdfs:comment "A currently-valid claim that nobody has ever reviewed since it was written." .

pko-native-procedural-knowledge-rulebook:isUnrewardedSharer a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnrewardedSharer" ;
    rdfs:comment "TRUE when someone who repeatedly passes know-how on has never been recognized for it." .

pko-native-procedural-knowledge-rulebook:isUnsaidInSop a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeHolding ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnsaidInSop" ;
    rdfs:comment "TRUE when the written SOP says nothing about it." .

pko-native-procedural-knowledge-rulebook:isUnsecured a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RulebookTable ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnsecured" ;
    rdfs:comment "True when RLS is enabled but no policy targets the table, so every principal sees zero rows. A fail-closed table nobody has granted access to." .

pko-native-procedural-knowledge-rulebook:isUnsecuredGovernanceRecord a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RulebookTable ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnsecuredGovernanceRecord" ;
    rdfs:comment "TRUE for a governance table no access policy controls." .

pko-native-procedural-knowledge-rulebook:isUnstewarded a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnstewarded" ;
    rdfs:comment "TRUE when no stewardship assignment names this version." .

pko-native-procedural-knowledge-rulebook:isUntaggedRelease a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntaggedRelease" ;
    rdfs:comment "TRUE when a governed release has no version-control tag or commit." .

pko-native-procedural-knowledge-rulebook:isUntested a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AuthorityBoundary ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntested" ;
    rdfs:comment "TRUE when a binding boundary has never been triggered by any recorded decision." .

pko-native-procedural-knowledge-rulebook:isUntestedRecoveryPath a owl:DatatypeProperty ;
    rdfs:domain pko:Transition ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntestedRecoveryPath" ;
    rdfs:comment "TRUE for a Fallback or Alternative transition whose endpoints show no execution evidence." .

pko-native-procedural-knowledge-rulebook:isUntestedWitness a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntestedWitness" ;
    rdfs:comment "TRUE for a witness that has never fired and has not been exercised enough for that silence to mean anything." .

pko-native-procedural-knowledge-rulebook:isUntraceableBreakingChange a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntraceableBreakingChange" ;
    rdfs:comment "TRUE when a breaking change cannot be traced to a documented versioning decision." .

pko-native-procedural-knowledge-rulebook:isUntraceableToSource a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AssistantAnswer ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntraceableToSource" ;
    rdfs:comment "TRUE when a delivered answer was grounded but showed the person none of its sources." .

pko-native-procedural-knowledge-rulebook:isUntracedActivityInTracedModel a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntracedActivityInTracedModel" ;
    rdfs:comment "TRUE when the step belongs to a traced process model but its own definition traces to no collection." .

pko-native-procedural-knowledge-rulebook:isUntracedBoundConstraint a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntracedBoundConstraint" ;
    rdfs:comment "TRUE when a constraint bound to a step traces to no collection activity." .

pko-native-procedural-knowledge-rulebook:isUntrackedAiConsumer a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntrackedAiConsumer" ;
    rdfs:comment "TRUE for an AI agent that consumes knowledge but whose retrievals are never logged." .

pko-native-procedural-knowledge-rulebook:isUntrackedRevision a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ExternalDependencyRevision ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntrackedRevision" ;
    rdfs:comment "TRUE when a revision to a standard the model maps to has gone untracked for more than thirty days." .

pko-native-procedural-knowledge-rulebook:isUntransferredVeteranKnowHow a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntransferredVeteranKnowHow" ;
    rdfs:comment "TRUE when a serving veteran carries know-how never transferred or captured." .

pko-native-procedural-knowledge-rulebook:isUntriagedUnanswerable a owl:DatatypeProperty ;
    rdfs:domain pko-extension:StakeholderQuestion ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntriagedUnanswerable" ;
    rdfs:comment "TRUE for an unanswerable question nobody has triaged." .

pko-native-procedural-knowledge-rulebook:isUnusedFaq a owl:DatatypeProperty ;
    rdfs:domain pko:FrequentlyAskedQuestion ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnusedFaq" ;
    rdfs:comment "TRUE when no question asked during execution was ever resolved by this FAQ." .

pko-native-procedural-knowledge-rulebook:isUnusedResource a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Resources ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnusedResource" ;
    rdfs:comment "TRUE when no procedure or step uses the resource." .

pko-native-procedural-knowledge-rulebook:isUnvalidatedOrStrandedInsight a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AiInsightProposal ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnvalidatedOrStrandedInsight" ;
    rdfs:comment "TRUE when an AI insight was folded in without validation, or validated and never folded back." .

pko-native-procedural-knowledge-rulebook:isUnwalkedRecoveryPath a owl:DatatypeProperty ;
    rdfs:domain pko:Transition ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwalkedRecoveryPath" ;
    rdfs:comment "TRUE for a Fallback/Alternative transition with zero recorded traversals." .

pko-native-procedural-knowledge-rulebook:isUnwarranted a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AuthorityBoundary ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwarranted" ;
    rdfs:comment "TRUE when a binding constraint on authority rests on no ratifying claim at all, or on one that is no longer valid. Either way the rule is being enforced without a live justification." .

pko-native-procedural-knowledge-rulebook:isUnwarrantedAndUntested a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AuthorityBoundary ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwarrantedAndUntested" ;
    rdfs:comment "A boundary whose ratification has lapsed and which no agent decision has ever been evaluated against — we cannot show it works and we cannot show why it exists." .

pko-native-procedural-knowledge-rulebook:isUnwatchedAndUnowned a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwatchedAndUnowned" ;
    rdfs:comment "TRUE for a blocking control that nothing computes and nobody owns." .

pko-native-procedural-knowledge-rulebook:isUnwitnessedBlockingControl a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwitnessedBlockingControl" ;
    rdfs:comment "TRUE for a blocking control with no verified computed witness behind it." .

pko-native-procedural-knowledge-rulebook:isUnwitnessedWrite a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AccessPolicy ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwitnessedWrite" ;
    rdfs:comment "True when a write policy has no denial test proving it refuses out-of-scope rows. An untested write grant is an assertion, not evidence." .

pko-native-procedural-knowledge-rulebook:isUsableForDrafting a owl:DatatypeProperty ;
    rdfs:domain pko-extension:OperationalBinding ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUsableForDrafting" ;
    rdfs:comment "TRUE when this binding points at an approved source that is still inside its freshness SLA." .

pko-native-procedural-knowledge-rulebook:isUsageDirectionMismatch a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ExecutionEntities ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUsageDirectionMismatch" ;
    rdfs:comment "TRUE when a used entity maps to an output or a generated entity maps to an input." .

pko-native-procedural-knowledge-rulebook:isUsuallyInvited a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationParticipant ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUsuallyInvited" ;
    rdfs:comment "FALSE for a participant whose position is normally left out of such sessions." .

pko-native-procedural-knowledge-rulebook:isVacatedRole a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsVacatedRole" ;
    rdfs:comment "A role somebody departed and that nobody currently covers." .

pko-native-procedural-knowledge-rulebook:isVacuouslyClean a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsVacuouslyClean" ;
    rdfs:comment "TRUE when this execution reads clean and nothing was ever declared that could have made it read otherwise." .

pko-native-procedural-knowledge-rulebook:isValid a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsValid" ;
