pko-native-procedural-knowledge-rulebook:isKnowledgeProducer a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationParticipant ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKnowledgeProducer" ;
    rdfs:comment "TRUE for a participant who produces the knowledge." .

pko-native-procedural-knowledge-rulebook:isKnowledgeSilo a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeConsumerSystem ;
    rdfs:range xsd:boolean ;
