effortless-ntwf:isVitalExpertiseClassedNonCore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SourcingFunctions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsVitalExpertiseClassedNonCore" ;
