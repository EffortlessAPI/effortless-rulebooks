# === Class: KnowledgeRepositoryEntries ===
effortless-ntwf:KnowledgeRepositoryEntries a owl:Class ;
    rdfs:label "KnowledgeRepositoryEntries" ;
    rdfs:comment "Captured procedural knowledge kept in a repository: who wrote it, whose know-how it records, for whom, whether it came back from executing the work, and whether it is kept current." .

effortless-ntwf:knowledgeRepositoryEntryId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeRepositoryEntryId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Entry title." .

effortless-ntwf:procedure a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Procedures ;
    rdfs:label "Procedure" ;
    rdfs:comment "The procedure the entry documents." .

effortless-ntwf:knowHow a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:KnowHowCarriers ;
    rdfs:label "KnowHow" ;
    rdfs:comment "The know-how the entry captures, when it captures a recorded carrier's know-how." .

effortless-ntwf:authorAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "AuthorAgent" ;
    rdfs:comment "Who wrote the entry." .

effortless-ntwf:sourceExpert a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "SourceExpert" ;
    rdfs:comment "Whose expertise the entry records." .

effortless-ntwf:creditsSourceExpert a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "CreditsSourceExpert" ;
    rdfs:comment "TRUE when the entry names and credits the source expert." .

effortless-ntwf:writtenForAudience a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range xsd:string ;
    rdfs:label "WrittenForAudience" ;
    rdfs:comment "LaterColleagues (written as part of the craft) or ComplianceAudit." .

effortless-ntwf:authoredOnAllocatedTime a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "AuthoredOnAllocatedTime" ;
    rdfs:comment "TRUE when the writing was done on time the organization allotted for it." .

effortless-ntwf:fedFromExecution a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "FedFromExecution" ;
    rdfs:comment "The execution whose experience the entry wrote back." .

effortless-ntwf:createdAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CreatedAt" ;
    rdfs:comment "When the entry was created." .

effortless-ntwf:lastUpdatedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "LastUpdatedAt" ;
    rdfs:comment "When the entry was last revised." .

effortless-ntwf:reviewIntervalDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range xsd:integer ;
    rdfs:label "ReviewIntervalDays" ;
    rdfs:comment "How often the entry must be revised to stay current." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The instant the row is judged against." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The modeled evaluation instant." .
    # calculated: lookup

effortless-ntwf:authorIsStillEngaged a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "AuthorIsStillEngaged" ;
    rdfs:comment "Whether the author still holds a role." .
    # calculated: lookup

effortless-ntwf:authorAgentKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AuthorAgentKind" ;
    rdfs:comment "The author's kind." .
    # calculated: lookup

effortless-ntwf:ownerOrganization a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OwnerOrganization" ;
    rdfs:comment "The organization that owns the procedure." .
    # calculated: lookup

effortless-ntwf:daysSinceUpdated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceUpdated" ;
    rdfs:comment "Days since the last revision." .
    # calculated: calculated

effortless-ntwf:isStale a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStale" ;
    rdfs:comment "TRUE when the entry has gone longer than its review interval without revision." .
    # calculated: calculated

effortless-ntwf:isExecutionFeedback a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExecutionFeedback" ;
    rdfs:comment "TRUE when the entry wrote back what an execution taught." .
    # calculated: calculated

effortless-ntwf:isMachineAuthored a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMachineAuthored" ;
    rdfs:comment "TRUE when an AI agent or pipeline wrote the entry." .
    # calculated: calculated

effortless-ntwf:outlivesAuthorTenure a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "OutlivesAuthorTenure" ;
    rdfs:comment "TRUE when the entry is still current although its author has left." .
    # calculated: calculated

effortless-ntwf:isUncreditedExpertKnowHow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeRepositoryEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUncreditedExpertKnowHow" ;
    rdfs:comment "TRUE when an entry records another person's expertise without crediting them." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: KnowledgeSearchEvents ===
effortless-ntwf:KnowledgeSearchEvents a owl:Class ;
    rdfs:label "KnowledgeSearchEvents" ;
    rdfs:comment "Searches and retrievals against the knowledge, by people and AI, with what they found and when they gave up." .

effortless-ntwf:knowledgeSearchEventId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeSearchEventId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:searchedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "SearchedByAgent" ;
    rdfs:comment "Who searched." .

effortless-ntwf:searchedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range xsd:string ;
    rdfs:label "SearchedAt" ;
    rdfs:comment "When." .

effortless-ntwf:channel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Channel" ;
    rdfs:comment "RegisterSearch, TabletSearch or AssistantRetrieval." .

effortless-ntwf:queryText a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "QueryText" ;
    rdfs:comment "What was searched for." .

effortless-ntwf:soughtProcedureVersion a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "SoughtProcedureVersion" ;
    rdfs:comment "Version the searcher was working with." .

effortless-ntwf:resultCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range xsd:integer ;
    rdfs:label "ResultCount" ;
    rdfs:comment "Results returned." .

effortless-ntwf:openedSegment a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range effortless-ntwf:RetrievalSegments ;
    rdfs:label "OpenedSegment" ;
    rdfs:comment "Segment opened." .

effortless-ntwf:openedProjection a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range effortless-ntwf:KnowledgeProjections ;
    rdfs:label "OpenedProjection" ;
    rdfs:comment "Document or diagram opened." .

effortless-ntwf:wasAbandoned a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasAbandoned" ;
    rdfs:comment "TRUE when the searcher gave up." .

effortless-ntwf:secondsBeforeAbandoning a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range xsd:string ;
    rdfs:label "SecondsBeforeAbandoning" ;
    rdfs:comment "Seconds before giving up." .

effortless-ntwf:dwellSeconds a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range xsd:string ;
    rdfs:label "DwellSeconds" ;
    rdfs:comment "Time spent with what was found." .

effortless-ntwf:linkedKnowledgeGap a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range effortless-ntwf:KnowledgeGaps ;
    rdfs:label "LinkedKnowledgeGap" ;
    rdfs:comment "Knowledge gap the failed search was linked to." .

effortless-ntwf:linkedUsabilityBarrier a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range xsd:string ;
    rdfs:label "LinkedUsabilityBarrier" ;
    rdfs:comment "Usability barrier the failed search was linked to." .

effortless-ntwf:foundNothingUseful a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range xsd:boolean ;
    rdfs:label "FoundNothingUseful" ;
    rdfs:comment "TRUE when a search returned nothing or nothing was opened." .
    # calculated: calculated

effortless-ntwf:gaveUpAfterSeeingResults a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range xsd:boolean ;
    rdfs:label "GaveUpAfterSeeingResults" ;
    rdfs:comment "TRUE when the searcher abandoned the query after results came back." .
    # calculated: calculated

effortless-ntwf:isUnlinkedFailedSearch a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeSearchEvents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnlinkedFailedSearch" ;
    rdfs:comment "TRUE when a search that found nothing useful is linked to no knowledge gap and no usability barrier." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

