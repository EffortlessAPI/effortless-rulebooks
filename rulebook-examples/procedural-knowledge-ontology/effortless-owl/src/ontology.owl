    rdfs:domain pko:Error ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoRemedyStep" ;
    rdfs:comment "TRUE when an error has been encountered and no step of any procedure remedies it." .

pko-native-procedural-knowledge-rulebook:hasNoResponse a owl:DatatypeProperty ;
    rdfs:domain pko-extension:FailureMode ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoResponse" ;
    rdfs:comment "TRUE when a failure mode names no response." .

pko-native-procedural-knowledge-rulebook:hasNoStatedReasonForExisting a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoStatedReasonForExisting" ;
    rdfs:comment "TRUE when nothing ties the procedure to a mission, rationale or value." .

pko-native-procedural-knowledge-rulebook:hasOntology a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeConsumerSystem ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOntology" ;
    rdfs:comment "Holds an ontology." .

pko-native-procedural-knowledge-rulebook:hasOpaqueIdentifier a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOpaqueIdentifier" ;
    rdfs:comment "TRUE when the subject identifier is a UUID URN or blank node a person or model cannot read or cite." .

pko-native-procedural-knowledge-rulebook:hasOpenBlockingGap a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOpenBlockingGap" ;
    rdfs:comment "TRUE when at least one open blocking gap stands against this version." .

pko-native-procedural-knowledge-rulebook:hasOpenPracticeDrift a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOpenPracticeDrift" ;
    rdfs:comment "TRUE when knowledge that no longer matches practice has been detected and is still open." .

pko-native-procedural-knowledge-rulebook:hasOperationalReliance a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOperationalReliance" ;
    rdfs:comment "TRUE when an exception handler exists on the step this claim governs." .

pko-native-procedural-knowledge-rulebook:hasOptOutPhrase a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOptOutPhrase" ;
    rdfs:comment "TRUE when the required opt-out phrase appears anywhere in the transmitted text." .

pko-native-procedural-knowledge-rulebook:hasOrphanTerms a owl:DatatypeProperty ;
    rdfs:domain pko-extension:Vocabulary ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOrphanTerms" ;
    rdfs:comment "TRUE when this vocabulary has at least one defined-but-unused term." .

pko-native-procedural-knowledge-rulebook:hasOrphanedProvenance a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOrphanedProvenance" ;
    rdfs:comment "TRUE when we still rely on this claim but the agent who gave it to us no longer holds a role here." .

pko-native-procedural-knowledge-rulebook:hasOwnVocabularyAndNorms a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CommunityOfPractice ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOwnVocabularyAndNorms" ;
    rdfs:comment "TRUE when the community has its own vocabulary and stated norms." .

pko-native-procedural-knowledge-rulebook:hasPostcondition a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasPostcondition" ;
    rdfs:comment "TRUE when the step states what must hold after it." .

pko-native-procedural-knowledge-rulebook:hasProducedArtifacts a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasProducedArtifacts" ;
    rdfs:comment "TRUE when some artifact is attributed to the agent." .

pko-native-procedural-knowledge-rulebook:hasRatifyingFragment a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AuthorityBoundary ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRatifyingFragment" ;
    rdfs:comment "TRUE when this boundary names a knowledge fragment as its justification. FALSE means the rule constrains behaviour on nobody's recorded authority — strictly worse than resting on an expired claim, and previously invisible because the ratification lookup returned NULL." .

pko-native-procedural-knowledge-rulebook:hasReachableOrigin a owl:DatatypeProperty ;
    rdfs:domain pko:Transition ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasReachableOrigin" ;
    rdfs:comment "TRUE when the origin step of this transition has been executed at least once." .

pko-native-procedural-knowledge-rulebook:hasReachableTarget a owl:DatatypeProperty ;
    rdfs:domain pko:Transition ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasReachableTarget" ;
    rdfs:comment "TRUE when the destination step of this transition has been executed at least once." .

pko-native-procedural-knowledge-rulebook:hasReasoner a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeConsumerSystem ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasReasoner" ;
    rdfs:comment "Has a reasoner." .

pko-native-procedural-knowledge-rulebook:hasRecordedElicitation a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRecordedElicitation" ;
    rdfs:comment "TRUE when this claim traces to a recorded elicitation session." .

pko-native-procedural-knowledge-rulebook:hasRecordedReason a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ObservedAction ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRecordedReason" ;
    rdfs:comment "TRUE when a reason is recorded against the observed action." .

pko-native-procedural-knowledge-rulebook:hasRejectedEvidence a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ArticleClaim ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRejectedEvidence" ;
    rdfs:comment "TRUE when evidence was offered and none of it meets the bar." .

pko-native-procedural-knowledge-rulebook:hasRenderedBody a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRenderedBody" ;
    rdfs:comment "TRUE when the exact transmitted text is still held on this record." .

pko-native-procedural-knowledge-rulebook:hasReportedRealityMismatch a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasReportedRealityMismatch" ;
    rdfs:comment "TRUE for a step practitioners' feedback says no longer matches how the work is done." .

pko-native-procedural-knowledge-rulebook:hasResolutionPlan a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeGap ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasResolutionPlan" ;
    rdfs:comment "TRUE when someone has written down how this gap would be closed." .

pko-native-procedural-knowledge-rulebook:hasResultingDelivery a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasResultingDelivery" ;
    rdfs:comment "TRUE when this intent produced a delivery record of any status." .

pko-native-procedural-knowledge-rulebook:hasRetryAttempt a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRetryAttempt" ;
    rdfs:comment "TRUE when a retry intent was raised for this deferred send." .

pko-native-procedural-knowledge-rulebook:hasReviewRecord a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasReviewRecord" ;
    rdfs:comment "Whether this fragment has ever had an actual review recorded, as opposed to merely having a ValidFrom date." .

pko-native-procedural-knowledge-rulebook:hasRun a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AccessDenialTest ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRun" ;
    rdfs:comment "True once the test has been executed at least once." .

pko-native-procedural-knowledge-rulebook:hasSemanticStorage a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeConsumerSystem ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSemanticStorage" ;
    rdfs:comment "Has semantic (triple) storage." .

pko-native-procedural-knowledge-rulebook:hasSentReminder a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSentReminder" ;
    rdfs:comment "TRUE when at least one reminder went out for this delivery." .

pko-native-procedural-knowledge-rulebook:hasSkippedVerification a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSkippedVerification" ;
    rdfs:comment "TRUE when a declared verification was never performed on this execution." .

pko-native-procedural-knowledge-rulebook:hasSmsConsent a owl:DatatypeProperty ;
    rdfs:domain pko-extension:Recipient ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSmsConsent" ;
    rdfs:comment "TRUE only when the recipient's SMS consent state is Granted." .

pko-native-procedural-knowledge-rulebook:hasSpecializations a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSpecializations" ;
