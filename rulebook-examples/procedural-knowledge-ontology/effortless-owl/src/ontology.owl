pko-native-procedural-knowledge-rulebook:isHumanEvaluated a owl:DatatypeProperty ;
    rdfs:domain pko:RequirementSatisfaction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHumanEvaluated" ;
