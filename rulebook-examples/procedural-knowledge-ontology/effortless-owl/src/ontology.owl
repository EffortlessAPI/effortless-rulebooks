pko-native-procedural-knowledge-rulebook:lacksSemanticTypeConvention a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RulebookTable ;
    rdfs:range xsd:boolean ;
    rdfs:label "LacksSemanticTypeConvention" ;
    rdfs:comment "TRUE when a table breaks the modeling convention that every row carries a SemanticTypeIri." .

