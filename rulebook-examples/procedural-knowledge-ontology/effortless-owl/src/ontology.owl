pko-native-procedural-knowledge-rulebook:isLongUnapproved a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLongUnapproved" ;
    rdfs:comment "A claim that has waited on my signature for more than thirty days." .

pko-native-procedural-knowledge-rulebook:isLostNewKnowledge a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelAnnotation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLostNewKnowledge" ;
    rdfs:comment "TRUE when new knowledge a practitioner added was not declined and never became a knowledge fragment." .

pko-native-procedural-knowledge-rulebook:isLowConfidence a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLowConfidence" ;
    rdfs:comment "TRUE when this claim was recorded with less than high confidence." .

pko-native-procedural-knowledge-rulebook:isMachineAccessible a owl:DatatypeProperty ;
