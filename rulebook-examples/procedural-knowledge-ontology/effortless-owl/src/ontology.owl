effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ExpertCognitions ===
effortless-ntwf:ExpertCognitions a owl:Class ;
    rdfs:label "ExpertCognitions" ;
    rdfs:comment "Mental models and decision heuristics experts apply, drawn out by protocols and incident interviews, with any exceptions the expert stated and whether the capture kept them." .

effortless-ntwf:expertCognitionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExpertCognitions ;
    rdfs:range xsd:string ;
    rdfs:label "ExpertCognitionId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:agent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "Agent" ;
    rdfs:comment "The expert." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "The step the cognition is applied at." .

effortless-ntwf:elicitationSession a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ElicitationSessions ;
    rdfs:label "ElicitationSession" ;
    rdfs:comment "The session that drew it out." .

effortless-ntwf:cognitionKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExpertCognitions ;
    rdfs:range xsd:string ;
    rdfs:label "CognitionKind" ;
    rdfs:comment "MentalModel or DecisionHeuristic." .

