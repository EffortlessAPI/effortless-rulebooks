effortless-ntwf:expectedInferenceCheckId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExpectedInferenceChecks ;
    rdfs:range xsd:string ;
    rdfs:label "ExpectedInferenceCheckId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:changeValidationRun a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ExpectedInferenceChecks ;
    rdfs:range effortless-ntwf:ChangeValidationRuns ;
    rdfs:label "ChangeValidationRun" ;
    rdfs:comment "Run." .

effortless-ntwf:chainDescription a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExpectedInferenceChecks ;
    rdfs:range xsd:string ;
    rdfs:label "ChainDescription" ;
