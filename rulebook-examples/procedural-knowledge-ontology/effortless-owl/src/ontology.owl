effortless-ntwf:resolvedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ResolvedAt" ;
    rdfs:comment "When the disagreement was resolved." .

effortless-ntwf:conflictingDepartment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DepartmentProcessAccounts ;
    rdfs:range xsd:string ;
    rdfs:label "ConflictingDepartment" ;
    rdfs:comment "The department giving the contradicting account." .
    # calculated: lookup

effortless-ntwf:isAwaitingEngagement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DepartmentProcessAccounts ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAwaitingEngagement" ;
    rdfs:comment "TRUE when the stakeholder department has not been engaged." .
    # calculated: calculated

effortless-ntwf:isConflictingAccount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DepartmentProcessAccounts ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConflictingAccount" ;
    rdfs:comment "TRUE when another department gives a contradicting account of the same process." .
