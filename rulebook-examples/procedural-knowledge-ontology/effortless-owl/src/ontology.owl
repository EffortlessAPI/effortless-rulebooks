    rdfs:range xsd:boolean ;
    rdfs:label "DegradationHiddenUntilWrongAnswer" ;
    rdfs:comment "TRUE when drift surfaced only through an expert noticing a wrong answer on a model whose questions were never periodically reviewed." .
    # calculated: calculated

effortless-ntwf:baselineQuestionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:integer ;
    rdfs:label "BaselineQuestionCount" ;
    rdfs:comment "Original competency questions recorded for the model." .
    # calculated: aggregation

effortless-ntwf:requirementsSpecIncomplete a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:boolean ;
    rdfs:label "RequirementsSpecIncomplete" ;
    rdfs:comment "TRUE when the requirements specification lacks a purpose, intended users or competency questions." .
    # calculated: calculated

effortless-ntwf:collectionControlCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:integer ;
    rdfs:label "CollectionControlCount" ;
    rdfs:comment "Governance controls over the collection stage." .
    # calculated: aggregation

effortless-ntwf:stewardshipControlCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:integer ;
    rdfs:label "StewardshipControlCount" ;
    rdfs:comment "Governance controls over the stewardship stage." .
    # calculated: aggregation

effortless-ntwf:retrievalControlCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:integer ;
    rdfs:label "RetrievalControlCount" ;
    rdfs:comment "Governance controls over the retrieval stage." .
    # calculated: aggregation

effortless-ntwf:useControlCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:integer ;
    rdfs:label "UseControlCount" ;
    rdfs:comment "Governance controls over the use stage." .
    # calculated: aggregation

effortless-ntwf:continuousPipelineStageCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:integer ;
    rdfs:label "ContinuousPipelineStageCount" ;
    rdfs:comment "Collection, organization and encoding stages that run continuously." .
    # calculated: aggregation

effortless-ntwf:lacksLifecycleStageControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:boolean ;
    rdfs:label "LacksLifecycleStageControl" ;
    rdfs:comment "TRUE for a procedure family with no governance control over capture, stewardship, retrieval or use." .
    # calculated: calculated

effortless-ntwf:pipelineNotContinuous a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:boolean ;
    rdfs:label "PipelineNotContinuous" ;
    rdfs:comment "TRUE for a procedure family whose collection, organization and encoding do not all run continuously." .
    # calculated: calculated

effortless-ntwf:procedureHasNoExplicitSteps a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:boolean ;
    rdfs:label "ProcedureHasNoExplicitSteps" ;
    rdfs:comment "Whether the procedure exists only as a title and documents." .
    # calculated: lookup

effortless-ntwf:isUnmanageableUndocumentedWork a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnmanageableUndocumentedWork" ;
    rdfs:comment "TRUE for a procedure family whose work was never documented into the knowledge system, so it cannot be managed." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

effortless-ntwf:originatingUseCase a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:string ;
    rdfs:label "OriginatingUseCase" ;
    rdfs:comment "The concrete use case the model was started from." .

effortless-ntwf:isWithoutOriginatingUseCase a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWithoutOriginatingUseCase" ;
    rdfs:comment "TRUE when a procedure family or ontology was modeled with no concrete use case behind it." .
    # calculated: calculated

effortless-ntwf:pilotCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:integer ;
    rdfs:label "PilotCount" ;
    rdfs:comment "Pilot implementations of the model." .
    # calculated: aggregation

effortless-ntwf:isAdoptedWithoutPilot a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAdoptedWithoutPilot" ;
    rdfs:comment "TRUE when a procedure family or ontology was adopted without ever being refined through a pilot." .
    # calculated: calculated

effortless-ntwf:requirementsExpertCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:integer ;
    rdfs:label "RequirementsExpertCount" ;
    rdfs:comment "Experts in requirements specification." .
    # calculated: aggregation

effortless-ntwf:implementationExpertCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:integer ;
    rdfs:label "ImplementationExpertCount" ;
    rdfs:comment "Experts in implementation." .
    # calculated: aggregation

effortless-ntwf:publicationExpertCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:integer ;
    rdfs:label "PublicationExpertCount" ;
    rdfs:comment "Experts in publication." .
    # calculated: aggregation

effortless-ntwf:maintenanceExpertCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:integer ;
    rdfs:label "MaintenanceExpertCount" ;
    rdfs:comment "Experts in maintenance." .
    # calculated: aggregation

effortless-ntwf:expertsNotInvolvedThroughout a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExpertsNotInvolvedThroughout" ;
    rdfs:comment "TRUE when some LOT activity of a procedure family or ontology ran with no domain expert taking part." .
    # calculated: calculated

effortless-ntwf:realDataMappingRunCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:integer ;
    rdfs:label "RealDataMappingRunCount" ;
    rdfs:comment "Runs that mapped the organization's real records into RDF." .
    # calculated: aggregation

effortless-ntwf:isImplementedWithoutRealData a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GovernedModels ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsImplementedWithoutRealData" ;
    rdfs:comment "TRUE when a procedure family or ontology was never implemented by mapping the organization's real data into RDF." .
    # calculated: calculated

# === Class: GroundingSnapshots ===
effortless-ntwf:GroundingSnapshots a owl:Class ;
    rdfs:label "GroundingSnapshots" ;
    rdfs:comment "A snapshot of the knowledge graph as it is served to retrieval and AI context, with its reasoning and governance record." .

effortless-ntwf:groundingSnapshotId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:string ;
    rdfs:label "GroundingSnapshotId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Snapshot." .

effortless-ntwf:builtAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:string ;
    rdfs:label "BuiltAt" ;
    rdfs:comment "When built." .

effortless-ntwf:servedFrom a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:string ;
    rdfs:label "ServedFrom" ;
    rdfs:comment "When retrieval began serving it." .

effortless-ntwf:servedTo a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:string ;
    rdfs:label "ServedTo" ;
    rdfs:comment "When it stopped being served." .

effortless-ntwf:stewardRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "StewardRole" ;
    rdfs:comment "Role that stewards the served graph." .

effortless-ntwf:governanceReviewedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:string ;
    rdfs:label "GovernanceReviewedAt" ;
    rdfs:comment "When the steward last reviewed the graph for serving." .

effortless-ntwf:isGoverned a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGoverned" ;
    rdfs:comment "TRUE when the snapshot has a steward and was reviewed before it was served." .
    # calculated: calculated

effortless-ntwf:reasonerRunCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:integer ;
    rdfs:label "ReasonerRunCount" ;
    rdfs:comment "Reasoner runs over the snapshot." .
    # calculated: aggregation

effortless-ntwf:consistentReasonerRunCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:integer ;
    rdfs:label "ConsistentReasonerRunCount" ;
    rdfs:comment "Reasoner runs that found the snapshot consistent." .
    # calculated: aggregation

effortless-ntwf:latestMaterializedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:string ;
    rdfs:label "LatestMaterializedAt" ;
    rdfs:comment "When a reasoner last materialized the snapshot's entailments." .
    # calculated: aggregation

effortless-ntwf:servedWithoutConsistencyCheck a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:boolean ;
    rdfs:label "ServedWithoutConsistencyCheck" ;
    rdfs:comment "TRUE when a snapshot was served to AI with no reasoner run finding it consistent." .
    # calculated: calculated

effortless-ntwf:servedBeforeMaterialization a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:boolean ;
    rdfs:label "ServedBeforeMaterialization" ;
    rdfs:comment "TRUE when a snapshot was served before a reasoner materialized what its assertions entail." .
    # calculated: calculated

effortless-ntwf:assertionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:integer ;
    rdfs:label "AssertionCount" ;
    rdfs:comment "Assertions served." .
    # calculated: aggregation

effortless-ntwf:staleAssignmentAssertionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:integer ;
    rdfs:label "StaleAssignmentAssertionCount" ;
    rdfs:comment "Served assertions resting on a role assignment that is no longer current." .
    # calculated: aggregation

effortless-ntwf:servesStaleRoleAssignments a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:boolean ;
    rdfs:label "ServesStaleRoleAssignments" ;
    rdfs:comment "TRUE when retrieval serves an assertion about a role assignment that has ended." .
    # calculated: calculated

effortless-ntwf:deprecatedAsCurrentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:integer ;
    rdfs:label "DeprecatedAsCurrentCount" ;
    rdfs:comment "Served assertions presenting a deprecated or archived version as current." .
    # calculated: aggregation

effortless-ntwf:servesDeprecatedAsCurrent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GroundingSnapshots ;
    rdfs:range xsd:boolean ;
    rdfs:label "ServesDeprecatedAsCurrent" ;
    rdfs:comment "TRUE when retrieval presents a deprecated workflow individual as current." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: InstanceDataVersions ===
effortless-ntwf:InstanceDataVersions a owl:Class ;
    rdfs:label "InstanceDataVersions" ;
    rdfs:comment "Versions of a model's instance data, kept separately from schema releases." .

effortless-ntwf:instanceDataVersionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InstanceDataVersions ;
