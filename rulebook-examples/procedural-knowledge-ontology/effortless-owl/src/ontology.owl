effortless-ntwf:stakeholderAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:DepartmentProcessAccounts ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "StakeholderAgent" ;
    rdfs:comment "Who speaks for the department." .

effortless-ntwf:engagedAt a owl:DatatypeProperty ;
