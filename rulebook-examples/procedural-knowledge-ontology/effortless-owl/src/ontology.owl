    rdfs:range xsd:boolean ;
    rdfs:label "CueSignalsIncompleteStep" ;
    rdfs:comment "Whether the observed warning sign means the step is not finished." .

pko-native-procedural-knowledge-rulebook:currentAccountableHumanCount a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:integer ;
    rdfs:label "CurrentAccountableHumanCount" ;
    rdfs:comment "Human persons currently accountable for the agent." .

pko-native-procedural-knowledge-rulebook:currentAgent a owl:ObjectProperty ;
    rdfs:range prov:Agent ;
    rdfs:label "CurrentAgent" .

pko-native-procedural-knowledge-rulebook:currentAgentKey a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentAgentKey" ;
    rdfs:comment "Echoes the Agent id only while this assignment is current; empty otherwise. Lets a parent count CURRENT assignments with a single-criterion COUNTIFS, which is the only shape this transpiler translates correctly." .

pko-native-procedural-knowledge-rulebook:currentAgentKind a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentAgentKind" ;
    rdfs:comment "Agent category of the current role filler." .

pko-native-procedural-knowledge-rulebook:currentAssignment a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentAssignment" ;
    rdfs:comment "The RoleAssignments id of the assignment by which this role is currently held. Deliberately a raw identifier, not a relationship: RoleAssignments already points at Roles, so an FK back would make the two mutually dependent and this rulebook must stay acyclic." .

pko-native-procedural-knowledge-rulebook:currentAssignmentValidFrom a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:dateTime ;
    rdfs:label "CurrentAssignmentValidFrom" ;
    rdfs:comment "Start of the currently-in-force assignment for this role." .

pko-native-procedural-knowledge-rulebook:currentAuthorityAgent a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentAuthorityAgent" ;
    rdfs:comment "Person holding the authority role now." .

pko-native-procedural-knowledge-rulebook:currentAuthorityRole a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentAuthorityRole" ;
    rdfs:comment "Authority role of the charter in force." .

pko-native-procedural-knowledge-rulebook:currentBodyHash a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentBodyHash" ;
    rdfs:comment "Digest of the template's current body text, maintained whenever the body is edited." .

pko-native-procedural-knowledge-rulebook:currentCharter a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentCharter" ;
    rdfs:comment "Key of the charter currently in force, blank when none." .

pko-native-procedural-knowledge-rulebook:currentCharterCount a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:integer ;
    rdfs:label "CurrentCharterCount" ;
    rdfs:comment "Charters in force now." .

pko-native-procedural-knowledge-rulebook:currentHolderName a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentHolderName" ;
    rdfs:comment "Name of the person or system holding the role." .

pko-native-procedural-knowledge-rulebook:currentLastApprovalAt a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:dateTime ;
    rdfs:label "CurrentLastApprovalAt" ;
    rdfs:comment "The template's most recent approval time as it stands NOW, for comparison against what was approved at send." .

pko-native-procedural-knowledge-rulebook:currentRelease a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentRelease" ;
    rdfs:comment "Key of the release the model is currently declared at." .

pko-native-procedural-knowledge-rulebook:currentStewardAgent a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentStewardAgent" ;
    rdfs:comment "Person holding the steward role now." .

pko-native-procedural-knowledge-rulebook:currentStewardRole a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernedModel ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentStewardRole" ;
    rdfs:comment "Steward role of the charter in force." .

pko-native-procedural-knowledge-rulebook:currentVersionKey a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentVersionKey" ;
    rdfs:comment "Current version identifier, mirrored structurally by ProcedureVersions.IsCurrent." .

pko-native-procedural-knowledge-rulebook:currentlyCoveredAssignmentCount a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:decimal ;
    rdfs:label "CurrentlyCoveredAssignmentCount" ;
    rdfs:comment "Number of assignment rows for this role that are in force right now." .

pko-native-procedural-knowledge-rulebook:customerSegment a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ApplicabilityScope ;
    rdfs:range xsd:string ;
    rdfs:label "CustomerSegment" ;
