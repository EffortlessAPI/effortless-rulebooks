    rdfs:range effortless-ntwf:CapabilityDeclines ;
    rdfs:label "PrecedingStageDecline" ;
    rdfs:comment "The decline of the stage that feeds this one." .

effortless-ntwf:evidence a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Evidence" ;
    rdfs:comment "What shows the decline." .

effortless-ntwf:precedingStage a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CapabilityDeclines ;
    rdfs:range xsd:string ;
    rdfs:label "PrecedingStage" ;
    rdfs:comment "The stage of the preceding decline." .
