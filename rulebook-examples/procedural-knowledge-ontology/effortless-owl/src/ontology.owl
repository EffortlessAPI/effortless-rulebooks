    rdfs:comment "Measured efficiency gain." .

effortless-ntwf:targetErrorRatePercent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeOutcomeMeasurements ;
    rdfs:range xsd:string ;
    rdfs:label "TargetErrorRatePercent" ;
    rdfs:comment "Tolerated error rate." .

effortless-ntwf:informedChangeRequest a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeOutcomeMeasurements ;
    rdfs:range effortless-ntwf:ChangeRequests ;
    rdfs:label "InformedChangeRequest" ;
