    rdfs:range effortless-ntwf:StepVariables ;
    rdfs:label "SourceVariable" ;
    rdfs:comment "For an input, the output variable of an earlier step that feeds it." .

effortless-ntwf:isExternalInput a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepVariables ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExternalInput" ;
