effortless-ntwf:baselineErrorRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeOutcomeMeasurements ;
    rdfs:range xsd:string ;
    rdfs:label "BaselineErrorRate" ;
    rdfs:comment "Baseline error rate." .
    # calculated: lookup

effortless-ntwf:baselineMinutesPerRun a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeOutcomeMeasurements ;
