effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: KnowledgeTransfers ===
effortless-ntwf:KnowledgeTransfers a owl:Class ;
    rdfs:label "KnowledgeTransfers" ;
    rdfs:comment "One occasion on which know-how passed from one person to another, and the channel it travelled through." .

effortless-ntwf:knowledgeTransferId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTransfers ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeTransferId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:knowHow a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:KnowHowCarriers ;
    rdfs:label "KnowHow" ;
    rdfs:comment "The know-how that passed." .

effortless-ntwf:fromAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTransfers ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "FromAgent" ;
    rdfs:comment "Who passed it on." .

effortless-ntwf:recipientAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTransfers ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "RecipientAgent" ;
    rdfs:comment "Who received it, when one person did." .

effortless-ntwf:channel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Channel" ;
    rdfs:comment "Document, TrainingProgram, Mentoring, PersonalRelationship, Collaboration, DesignProductionIteration, EmployerChange or AmbientExposure." .

effortless-ntwf:communityOfPractice a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:CommunitiesOfPractice ;
    rdfs:label "CommunityOfPractice" ;
    rdfs:comment "The community the transfer took place in." .

effortless-ntwf:occurredAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OccurredAt" ;
    rdfs:comment "When the transfer took place." .

effortless-ntwf:onAllocatedTime a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTransfers ;
    rdfs:range xsd:boolean ;
    rdfs:label "OnAllocatedTime" ;
    rdfs:comment "TRUE when the transfer was done on time the organization allotted for it." .

effortless-ntwf:fromOrganization a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTransfers ;
    rdfs:range xsd:string ;
    rdfs:label "FromOrganization" ;
    rdfs:comment "The giver's organization." .
    # calculated: lookup

effortless-ntwf:recipientRoleCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTransfers ;
    rdfs:range xsd:integer ;
    rdfs:label "RecipientRoleCount" ;
    rdfs:comment "Current role assignments the recipient holds." .
    # calculated: lookup

effortless-ntwf:isTraditionalChannel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTransfers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTraditionalChannel" ;
    rdfs:comment "TRUE for the traditional channels: documents, training programs and mentoring." .
    # calculated: calculated

effortless-ntwf:isSocialNetworkChannel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTransfers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSocialNetworkChannel" ;
    rdfs:comment "TRUE for relationships, collaboration, design-production iteration and people changing employers." .
    # calculated: calculated

effortless-ntwf:isAmbientAbsorptionByNonPractitioner a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTransfers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAmbientAbsorptionByNonPractitioner" ;
    rdfs:comment "TRUE when someone holding no role absorbed the know-how by living among the trade." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

effortless-ntwf:knowHowTopic a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeTransfers ;
    rdfs:range xsd:string ;
    rdfs:label "KnowHowTopic" ;
    rdfs:comment "What was handed over, in words: the topic of the know-how." .
    # calculated: lookup

