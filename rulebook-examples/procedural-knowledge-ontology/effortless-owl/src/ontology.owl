effortless-ntwf:precedingDeclineStartedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CapabilityDeclines ;
    rdfs:range xsd:string ;
    rdfs:label "PrecedingDeclineStartedAt" ;
    rdfs:comment "When the preceding decline started." .
    # calculated: lookup

effortless-ntwf:followsPrecedingStageDecline a owl:DatatypeProperty ;
