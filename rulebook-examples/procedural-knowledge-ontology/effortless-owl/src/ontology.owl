pko-native-procedural-knowledge-rulebook:isLate a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLate" ;
    rdfs:comment "TRUE when actual duration exceeds expected duration." .

pko-native-procedural-knowledge-rulebook:isLateAndUnexplained a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLateAndUnexplained" ;
    rdfs:comment "TRUE when the execution exceeded its expected duration and no deviation was recorded." .

pko-native-procedural-knowledge-rulebook:isLatest a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ConformanceRun ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLatest" ;
