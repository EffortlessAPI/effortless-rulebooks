    rdfs:range xsd:boolean ;
    rdfs:label "IsInconsistentGrounding" ;
    rdfs:comment "TRUE when retrieval serves two segments that contradict each other." .

pko-native-procedural-knowledge-rulebook:isInconsistentlyCategorized a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInconsistentlyCategorized" ;
