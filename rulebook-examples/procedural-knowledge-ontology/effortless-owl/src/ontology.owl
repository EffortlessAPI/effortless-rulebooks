# Steps rows whose StepKind is MultiStep
p-plan:MultiStep a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( p-plan:Step [ a owl:Restriction ; owl:onProperty pko-native-procedural-knowledge-rulebook:stepKind ; owl:hasValue "MultiStep" ] ) ] .

# === Inverse object-property pairs (reverse direction inferred) ===
pko-native-procedural-knowledge-rulebook:contradictsSegment owl:inverseOf pko-native-procedural-knowledge-rulebook:relatedSegment .
pko-native-procedural-knowledge-rulebook:escalationBackupRole owl:inverseOf pko-native-procedural-knowledge-rulebook:specializesRole .
pko:isStepOfMultiStep owl:inverseOf pko-native-procedural-knowledge-rulebook:prerequisiteStep .
pko-native-procedural-knowledge-rulebook:prerequisiteStep owl:inverseOf pko:isStepVerificationOf .

# === Disjoint class groups (mutually-exclusive FK targets) ===
p-plan:Step owl:disjointWith pko-native-procedural-knowledge-rulebook:ProcedureVersions .
p-plan:Step owl:disjointWith pro:RoleInTime .
pko-native-procedural-knowledge-rulebook:ProcedureVersions owl:disjointWith pro:RoleInTime .
