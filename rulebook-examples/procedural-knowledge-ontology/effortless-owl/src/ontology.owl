    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHighBlastRadiusUnapproved" ;
    rdfs:comment "An unapproved, operationally live claim of mine with more than one distinct downstream dependent." .

pko-native-procedural-knowledge-rulebook:isHighYieldSession a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationSession ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHighYieldSession" ;
    rdfs:comment "A session that alone underwrites three or more currently-valid claims." .

pko-native-procedural-knowledge-rulebook:isHinderedByAnotherOperation a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHinderedByAnotherOperation" ;
