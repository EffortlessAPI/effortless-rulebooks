    rdfs:comment "TRUE when a model version runs in production and no agent individual in the graph represents it." .

pko-native-procedural-knowledge-rulebook:isLiveDecisionBacklog a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveDecisionBacklog" ;
    rdfs:comment "TRUE when a decision I owe is blocking a change to a procedure currently in production." .

pko-native-procedural-knowledge-rulebook:isLiveInProduction a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AiModelDeployment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveInProduction" ;
    rdfs:comment "TRUE for a production deployment running at the evaluation instant." .

pko-native-procedural-knowledge-rulebook:isLiveModelUntraced a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveModelUntraced" ;
    rdfs:comment "TRUE when an executable process model traces to no collection activity." .

pko-native-procedural-knowledge-rulebook:isLiveWithBlockingGap a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveWithBlockingGap" ;
    rdfs:comment "TRUE when an executable version carries an unresolved blocking knowledge gap." .

pko-native-procedural-knowledge-rulebook:isLiveWithUnrehearsedControl a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveWithUnrehearsedControl" ;
    rdfs:comment "A version that is live for execution while carrying at least one never-rehearsed blocking control entry." .

pko-native-procedural-knowledge-rulebook:isLiveWithoutRecordedDecisions a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
