# === Class: ModelCharters ===
effortless-ntwf:ModelCharters a owl:Class ;
    rdfs:label "ModelCharters" ;
    rdfs:comment "Ownership charters: who stewards a governed model and who holds authority over it, with written responsibilities, for a period." .

effortless-ntwf:modelCharterId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:string ;
    rdfs:label "ModelCharterId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:governedModel a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:GovernedModels ;
    rdfs:label "GovernedModel" ;
    rdfs:comment "Model chartered." .

effortless-ntwf:stewardRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "StewardRole" ;
    rdfs:comment "Role responsible for the model's health." .

effortless-ntwf:authorityRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "AuthorityRole" ;
    rdfs:comment "Role empowered to approve changes." .

effortless-ntwf:stewardResponsibilities a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:string ;
    rdfs:label "StewardResponsibilities" ;
    rdfs:comment "The steward's written responsibilities." .

effortless-ntwf:authorityApprovalScope a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:string ;
    rdfs:label "AuthorityApprovalScope" ;
    rdfs:comment "What the authority approves, stated." .

effortless-ntwf:charterTemplate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:string ;
    rdfs:label "CharterTemplate" ;
    rdfs:comment "Corporate charter template this charter was drawn from, if any." .

effortless-ntwf:localAdaptation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:string ;
    rdfs:label "LocalAdaptation" ;
    rdfs:comment "How this organization fitted the template to its own procedures, systems and constraints." .

effortless-ntwf:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ValidFrom" ;
    rdfs:comment "Charter start." .

effortless-ntwf:validTo a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ValidTo" ;
    rdfs:comment "Charter end." .

effortless-ntwf:supersedesCharter a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range effortless-ntwf:ModelCharters ;
    rdfs:label "SupersedesCharter" ;
    rdfs:comment "Charter this one replaced." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "Evaluation context." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The modeled instant this row is judged against." .
    # calculated: lookup

effortless-ntwf:isCurrent a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrent" ;
    rdfs:comment "TRUE when the charter is in force at the modeled instant." .
    # calculated: calculated

effortless-ntwf:stewardAgent a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "StewardAgent" ;
    rdfs:comment "Who holds the steward role." .
    # calculated: lookup

effortless-ntwf:authorityAgent a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AuthorityAgent" ;
    rdfs:comment "Who holds the authority role." .
    # calculated: lookup

effortless-ntwf:authorityOrganization a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:string ;
    rdfs:label "AuthorityOrganization" ;
    rdfs:comment "Organization the authority role belongs to." .
    # calculated: lookup

effortless-ntwf:modelKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ModelKind" ;
    rdfs:comment "Kind of model chartered." .
    # calculated: lookup

effortless-ntwf:modelDomainOwner a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ModelDomainOwner" ;
    rdfs:comment "Function owning the modeled domain." .
    # calculated: lookup

effortless-ntwf:modelHeadcount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:integer ;
    rdfs:label "ModelHeadcount" ;
    rdfs:comment "Headcount of the governing organization." .
    # calculated: lookup

effortless-ntwf:modelToolingOwnerRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:string ;
    rdfs:label "ModelToolingOwnerRole" ;
    rdfs:comment "Role owning the model's tooling." .
    # calculated: lookup

effortless-ntwf:modelFirstControlAdoptedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:string ;
    rdfs:label "ModelFirstControlAdoptedAt" ;
    rdfs:comment "When the model's first non-ownership control was adopted." .
    # calculated: lookup

effortless-ntwf:isStewardUnwritten a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStewardUnwritten" ;
    rdfs:comment "TRUE when no steward is named or the steward has no written responsibilities." .
    # calculated: calculated

effortless-ntwf:isAuthorityScopeUnstated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAuthorityScopeUnstated" ;
    rdfs:comment "TRUE when no authority is named or nothing states what it approves." .
    # calculated: calculated

effortless-ntwf:conflatesStewardAndAuthority a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:boolean ;
    rdfs:label "ConflatesStewardAndAuthority" ;
    rdfs:comment "TRUE when one role is chartered as both steward and authority, so the two responsibilities are never defined apart." .
    # calculated: calculated

effortless-ntwf:isSanctionedDualHolding a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSanctionedDualHolding" ;
    rdfs:comment "TRUE when one person holds two distinct steward and authority roles in an organization of fifty or fewer, which needs no committee." .
    # calculated: calculated

effortless-ntwf:isAuthorityOutsideDomainOwner a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAuthorityOutsideDomainOwner" ;
    rdfs:comment "TRUE when authority over the model rests with a function other than the one that owns the domain." .
    # calculated: calculated

effortless-ntwf:controlsPrecedeOwnership a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:boolean ;
    rdfs:label "ControlsPrecedeOwnership" ;
    rdfs:comment "TRUE when governance controls were adopted before the model's first owner was named." .
    # calculated: calculated

effortless-ntwf:stewardActivityCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelCharters ;
    rdfs:range xsd:integer ;
    rdfs:label "StewardActivityCount" ;
    rdfs:comment "Steward activities recorded under the charter." .
