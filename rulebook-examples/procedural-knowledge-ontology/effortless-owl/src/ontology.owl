effortless-ntwf:raisedKnowledgeGap a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ModelAnnotations ;
    rdfs:range effortless-ntwf:KnowledgeGaps ;
    rdfs:label "RaisedKnowledgeGap" ;
    rdfs:comment "Knowledge gap a missing-knowledge report became." .

effortless-ntwf:isDiscussionInAuthoritativeModel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelAnnotations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDiscussionInAuthoritativeModel" ;
    rdfs:comment "TRUE when a comment, question, suggestion or alternative reading was written into the authoritative rulebook." .
    # calculated: calculated

effortless-ntwf:flagBypassedAnnotationInterface a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelAnnotations ;
    rdfs:range xsd:boolean ;
    rdfs:label "FlagBypassedAnnotationInterface" ;
    rdfs:comment "TRUE when a practitioner had to flag outdated guidance outside the annotation interface." .
    # calculated: calculated

effortless-ntwf:isLostNewKnowledge a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelAnnotations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLostNewKnowledge" ;
    rdfs:comment "TRUE when new knowledge a practitioner added was not declined and never became a knowledge fragment." .
    # calculated: calculated

effortless-ntwf:isFrictionWithoutGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelAnnotations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFrictionWithoutGap" ;
    rdfs:comment "TRUE when friction from missing knowledge was reported and never recorded as a knowledge gap." .
    # calculated: calculated

effortless-ntwf:isOpenOutdatedFlag a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelAnnotations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOpenOutdatedFlag" ;
    rdfs:comment "TRUE for guidance a practitioner flagged as outdated that is still open." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

