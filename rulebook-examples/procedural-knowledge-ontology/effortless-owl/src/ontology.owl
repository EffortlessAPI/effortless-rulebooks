# === Class: TermLabelVariants ===
effortless-ntwf:TermLabelVariants a owl:Class ;
    rdfs:label "TermLabelVariants" ;
    rdfs:comment "Preferred and alternative labels of a controlled concept, one row per wording, so variant wordings can be matched." .

effortless-ntwf:termLabelVariantId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TermLabelVariants ;
    rdfs:range xsd:string ;
    rdfs:label "TermLabelVariantId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:vocabularyTerm a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:VocabularyTerms ;
    rdfs:label "VocabularyTerm" ;
    rdfs:comment "Concept labeled." .

effortless-ntwf:labelKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TermLabelVariants ;
    rdfs:range xsd:string ;
    rdfs:label "LabelKind" ;
    rdfs:comment "pref (skos:prefLabel) or alt (skos:altLabel)." .

effortless-ntwf:wording a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Wording" ;
    rdfs:comment "The wording, lower case." .

effortless-ntwf:termScheme a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TermLabelVariants ;
    rdfs:range xsd:string ;
    rdfs:label "TermScheme" ;
    rdfs:comment "Scheme the concept belongs to." .
    # calculated: lookup

effortless-ntwf:termPrefLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TermLabelVariants ;
    rdfs:range xsd:string ;
    rdfs:label "TermPrefLabel" ;
    rdfs:comment "The preferred label of the concept this wording belongs to. What a vocabulary search answers with, whichever wording was typed." .
    # calculated: lookup

effortless-ntwf:wordingKey a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "WordingKey" ;
    rdfs:comment "Scheme and wording." .
    # calculated: calculated

effortless-ntwf:prefWordingKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TermLabelVariants ;
    rdfs:range xsd:string ;
    rdfs:label "PrefWordingKey" ;
    rdfs:comment "Scheme and wording for a preferred label." .
    # calculated: calculated

effortless-ntwf:conceptsSharingWording a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TermLabelVariants ;
    rdfs:range xsd:integer ;
    rdfs:label "ConceptsSharingWording" ;
    rdfs:comment "Labels in the same scheme with this exact wording." .
    # calculated: aggregation

effortless-ntwf:isAmbiguousLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TermLabelVariants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAmbiguousLabel" ;
    rdfs:comment "TRUE when one wording is a label of more than one concept in the scheme, so it cannot normalize to one canonical concept." .
    # calculated: calculated

effortless-ntwf:practitionerMentionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TermLabelVariants ;
    rdfs:range xsd:integer ;
    rdfs:label "PractitionerMentionCount" ;
    rdfs:comment "Practitioner mentions using this wording in this scheme." .
    # calculated: aggregation

effortless-ntwf:prefWording a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TermLabelVariants ;
    rdfs:range xsd:string ;
    rdfs:label "PrefWording" ;
    rdfs:comment "Wording of a preferred label, regardless of scheme." .
    # calculated: calculated

effortless-ntwf:samePrefWordingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TermLabelVariants ;
    rdfs:range xsd:integer ;
    rdfs:label "SamePrefWordingCount" ;
    rdfs:comment "Preferred labels in any scheme with this wording." .
    # calculated: aggregation

effortless-ntwf:isCrossSchemeDuplicatePref a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TermLabelVariants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCrossSchemeDuplicatePref" ;
    rdfs:comment "TRUE when the same concern is defined as a separate preferred concept in more than one scheme instead of being shared." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

