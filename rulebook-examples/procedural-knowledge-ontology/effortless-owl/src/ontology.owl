    rdfs:domain effortless-ntwf:ChangeObjections ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "RaisedByAgent" ;
    rdfs:comment "Objector." .

effortless-ntwf:raisedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeObjections ;
    rdfs:range xsd:string ;
    rdfs:label "RaisedAt" ;
    rdfs:comment "When." .

effortless-ntwf:objection a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeObjections ;
    rdfs:range xsd:string ;
    rdfs:label "Objection" ;
    rdfs:comment "The objection." .

effortless-ntwf:resolvedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ResolvedAt" ;
    rdfs:comment "When resolved." .

effortless-ntwf:resolvedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ChangeObjections ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ResolvedByAgent" ;
    rdfs:comment "Who resolved it." .

effortless-ntwf:resolution a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeObjections ;
    rdfs:range xsd:string ;
    rdfs:label "Resolution" ;
    rdfs:comment "How." .

effortless-ntwf:isUnresolved a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnresolved" ;
    rdfs:comment "TRUE while the objection has no resolution." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ChangeRequests ===
effortless-ntwf:ChangeRequests a owl:Class ;
    rdfs:label "ChangeRequests" ;
    rdfs:comment "Governed requests for semantic or operational change, anchored to a procedure version and authority. Explicit ERB-PKO extension." .

effortless-ntwf:changeRequestId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeRequestId" ;
    rdfs:comment "Stored logical identifier for one ChangeRequests row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the ChangeRequests row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version affected." .

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Change title." .

effortless-ntwf:changeKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeKind" ;
    rdfs:comment "Defect, Enhancement, NewRequirement, DataOperation, or BreakingChange." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Draft, UnderReview, Approved, Rejected, Implemented, or Closed." .

effortless-ntwf:requestedByAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "RequestedByAgent" ;
    rdfs:comment "Agent requesting the change." .

effortless-ntwf:authorityRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "AuthorityRole" ;
    rdfs:comment "Role authorized to approve the change." .

effortless-ntwf:requestedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RequestedAt" ;
    rdfs:comment "Request time." .

effortless-ntwf:decidedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DecidedAt" ;
    rdfs:comment "Decision time." .

effortless-ntwf:impactAssessment a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ImpactAssessment" ;
    rdfs:comment "Expected effect on commitments, data, projections, and tests." .

effortless-ntwf:isOpen a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOpen" ;
    rdfs:comment "TRUE while the change request is still outstanding. An Approved request stays open until ImplementedAt records that it actually landed — approval is a decision, not an outcome." .
    # calculated: calculated

effortless-ntwf:openChangeVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "OpenChangeVersionKey" ;
    rdfs:comment "Echoes the ProcedureVersion id only for change requests still open." .
    # calculated: calculated

effortless-ntwf:isDecided a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDecided" ;
    rdfs:comment "TRUE when a decision timestamp has been recorded." .
    # calculated: calculated

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:daysPending a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysPending" ;
    rdfs:comment "Days from request to decision, or to now if still undecided." .
    # calculated: calculated

effortless-ntwf:isStillPending a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStillPending" ;
    rdfs:comment "TRUE when the request is in an open status and has no decision recorded." .
    # calculated: calculated

effortless-ntwf:isStalled a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStalled" ;
    rdfs:comment "TRUE when an undecided change request has been pending more than fourteen days." .
    # calculated: calculated

effortless-ntwf:authorityAgent a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AuthorityAgent" ;
    rdfs:comment "The agent currently holding the authority role that owes a decision on this request." .
    # calculated: lookup

effortless-ntwf:requesterIsAuthority a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "RequesterIsAuthority" ;
    rdfs:comment "TRUE when the agent who raised the request is also the agent who decides it." .
    # calculated: calculated

effortless-ntwf:awaitsAuthorityDecision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "AwaitsAuthorityDecision" ;
    rdfs:comment "TRUE when this request is formally before its authority and no decision has been recorded." .
    # calculated: calculated

effortless-ntwf:authorityRoleLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "AuthorityRoleLabel" ;
    rdfs:comment "Human-readable label of the role that owes a decision." .
    # calculated: lookup

effortless-ntwf:touchesLiveVersion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "TouchesLiveVersion" ;
    rdfs:comment "Whether the version this request would alter is currently executable." .
    # calculated: lookup

effortless-ntwf:isLiveDecisionBacklog a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveDecisionBacklog" ;
    rdfs:comment "TRUE when a decision I owe is blocking a change to a procedure currently in production." .
    # calculated: calculated

effortless-ntwf:blocksAnOpenGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "BlocksAnOpenGap" ;
    rdfs:comment "TRUE when an undecided request against a live version is the kind that exists to close a known gap." .
    # calculated: calculated

effortless-ntwf:implementedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "ImplementedAt" ;
    rdfs:comment "When the approved change was actually applied to the procedure version. Null until it lands. Distinct from DecidedAt, which records only that the authority ruled. Approval and implementation are separate events; conflating them is what left IsOpen with no terminal state." .

effortless-ntwf:backlogVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "BacklogVersionKey" ;
    rdfs:comment "Composite-key echo: this request's procedure version when it is live decision backlog, blank otherwise." .
    # calculated: calculated

effortless-ntwf:isMyPendingDecision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyPendingDecision" ;
    rdfs:comment "A change request awaiting a decision that is mine personally to make." .
    # calculated: calculated

effortless-ntwf:isMyBlockingBacklog a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyBlockingBacklog" ;
    rdfs:comment "A decision waiting on me that is holding an open gap on a live procedure." .
    # calculated: calculated

effortless-ntwf:isMyOverdueBacklog a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyOverdueBacklog" ;
    rdfs:comment "A blocking decision that has waited on me for more than two weeks." .
    # calculated: calculated

effortless-ntwf:isImplemented a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsImplemented" ;
    rdfs:comment "Whether the approved change has actually been applied." .
    # calculated: calculated

effortless-ntwf:isMyDecidedRequest a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyDecidedRequest" ;
    rdfs:comment "A change request I have personally ruled on." .
    # calculated: calculated

effortless-ntwf:isMyDecidedButUnlanded a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyDecidedButUnlanded" ;
    rdfs:comment "A decision I have made that has not yet been applied — still counted against me by the loop-1 open-request measure." .
    # calculated: calculated

effortless-ntwf:decisionLatencyDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:integer ;
    rdfs:label "DecisionLatencyDays" ;
    rdfs:comment "How many days I took to rule, once ruled. Zero when undecided — read only alongside IsDecided." .
    # calculated: calculated

effortless-ntwf:implementationLatencyDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:integer ;
    rdfs:label "ImplementationLatencyDays" ;
    rdfs:comment "How many days elapsed between my ruling and the change actually landing. Zero when not yet implemented." .
    # calculated: calculated

effortless-ntwf:delayIsDownstreamOfMe a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "DelayIsDownstreamOfMe" ;
    rdfs:comment "A request I decided promptly that is nevertheless still outstanding because nobody has implemented it." .
    # calculated: calculated

effortless-ntwf:unlandedVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "UnlandedVersionKey" ;
    rdfs:comment "Composite-key echo: this request's procedure version when I have decided it but it has not landed, blank otherwise." .
    # calculated: calculated

effortless-ntwf:isApprovedNotImplemented a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApprovedNotImplemented" ;
    rdfs:comment "A change request the authority approved but that has not yet been applied." .
    # calculated: calculated

effortless-ntwf:daysSinceApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceApproval" ;
    rdfs:comment "How many days have elapsed since the authority decided this request. Zero when undecided." .
    # calculated: calculated

effortless-ntwf:isStalledImplementation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStalledImplementation" ;
    rdfs:comment "An approved change request that has sat unimplemented for more than two weeks." .
    # calculated: calculated

effortless-ntwf:stalledImplementationVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "StalledImplementationVersionKey" ;
    rdfs:comment "Composite-key echo: this request's procedure version when its implementation is stalled, blank otherwise." .
    # calculated: calculated

effortless-ntwf:approvedVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "ApprovedVersionKey" ;
    rdfs:comment "Echoes the target version id when this change request was approved." .
    # calculated: calculated

effortless-ntwf:isApprovedDecision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApprovedDecision" ;
    rdfs:comment "TRUE when this change request was decided in the affirmative." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

effortless-ntwf:ownerOrganization a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OwnerOrganization" ;
    rdfs:comment "The organization that owns the procedure this row belongs to, one hop at a time from Procedures.OwnerOrganization. A row policy compares it to the caller's organization, so a plant sign-in never sees the finance close." .
    # calculated: lookup

# === Class: ChangeValidationRuns ===
effortless-ntwf:ChangeValidationRuns a owl:Class ;
    rdfs:label "ChangeValidationRuns" ;
    rdfs:comment "The validation suite run with a proposed change applied." .

effortless-ntwf:changeValidationRunId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeValidationRunId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:modelChangeRequest a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ModelChangeRequests ;
    rdfs:label "ModelChangeRequest" ;
    rdfs:comment "Change applied in the run." .

effortless-ntwf:testSuite a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range effortless-ntwf:TestSuites ;
    rdfs:label "TestSuite" ;
    rdfs:comment "Suite run." .

effortless-ntwf:runPurpose a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range xsd:string ;
    rdfs:label "RunPurpose" ;
    rdfs:comment "Exploratory or Acceptance." .

effortless-ntwf:ranAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RanAt" ;
    rdfs:comment "When." .

effortless-ntwf:testCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "TestCount" ;
    rdfs:comment "Tests run." .

effortless-ntwf:failureCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range xsd:integer ;
    rdfs:label "FailureCount" ;
    rdfs:comment "Tests failed." .

effortless-ntwf:failuresInspectedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range xsd:string ;
    rdfs:label "FailuresInspectedAt" ;
    rdfs:comment "When someone inspected the failures." .

effortless-ntwf:consistencyCheckOutcome a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range xsd:string ;
    rdfs:label "ConsistencyCheckOutcome" ;
    rdfs:comment "Consistent, Inconsistent, or blank when no logical consistency check ran." .

effortless-ntwf:structuralCheckOutcome a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range xsd:string ;
    rdfs:label "StructuralCheckOutcome" ;
    rdfs:comment "Pass, Fail, or blank when not run." .

effortless-ntwf:vocabularyCheckOutcome a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range xsd:string ;
    rdfs:label "VocabularyCheckOutcome" ;
    rdfs:comment "Pass, Fail, or blank when not run." .

effortless-ntwf:release a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Release" ;
    rdfs:comment "Release the change targets." .
    # calculated: lookup

effortless-ntwf:expectedChainCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range xsd:integer ;
    rdfs:label "ExpectedChainCount" ;
    rdfs:comment "Expected inference chains checked." .
    # calculated: aggregation

effortless-ntwf:unproducedChainCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range xsd:integer ;
    rdfs:label "UnproducedChainCount" ;
    rdfs:comment "Expected inference chains the model did not produce." .
    # calculated: aggregation

effortless-ntwf:hasUninspectedFailures a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUninspectedFailures" ;
    rdfs:comment "TRUE when a run failed tests and nobody inspected the failures." .
    # calculated: calculated

effortless-ntwf:isUnconfirmedConsistency a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnconfirmedConsistency" ;
    rdfs:comment "TRUE when a run did not confirm the model free of logical inconsistency." .
    # calculated: calculated

effortless-ntwf:missesExpectedInference a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeValidationRuns ;
    rdfs:range xsd:boolean ;
    rdfs:label "MissesExpectedInference" ;
    rdfs:comment "TRUE when an expected inference chain was not produced in the run." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ClaimEvidence ===
effortless-ntwf:ClaimEvidence a owl:Class ;
    rdfs:label "ClaimEvidence" ;
    rdfs:comment "A proposed piece of evidence that the model covers a claim, with the justification a skeptic can audit. Whether it counts is computed in IsValid from measured facts, never asserted." .

effortless-ntwf:claimEvidenceId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:string ;
    rdfs:label "ClaimEvidenceId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:articleClaim a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range effortless-ntwf:ArticleClaims ;
    rdfs:label "ArticleClaim" ;
    rdfs:comment "The claim this evidence supports." .

effortless-ntwf:evidenceKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:string ;
    rdfs:label "EvidenceKind" ;
    rdfs:comment "Field | Table | RoleQuestion | OntologyProfile | KnowledgeMethod | Procedure." .

effortless-ntwf:rulebookField a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RulebookFields ;
    rdfs:label "RulebookField" ;
    rdfs:comment "Evidence field, when EvidenceKind is Field." .

effortless-ntwf:rulebookTable a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RulebookTables ;
    rdfs:label "RulebookTable" ;
    rdfs:comment "Evidence table, when EvidenceKind is Table." .

effortless-ntwf:roleQuestion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RoleQuestions ;
    rdfs:label "RoleQuestion" ;
    rdfs:comment "Evidence question, when EvidenceKind is RoleQuestion." .

effortless-ntwf:ontologyProfile a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:OntologyProfiles ;
    rdfs:label "OntologyProfile" ;
    rdfs:comment "Evidence profile, when EvidenceKind is OntologyProfile." .

effortless-ntwf:knowledgeMethod a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:KnowledgeMethods ;
    rdfs:label "KnowledgeMethod" ;
    rdfs:comment "Evidence method, when EvidenceKind is KnowledgeMethod." .

effortless-ntwf:procedure a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Procedures ;
    rdfs:label "Procedure" ;
    rdfs:comment "Evidence procedure, when EvidenceKind is Procedure." .

effortless-ntwf:justification a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:string ;
    rdfs:label "Justification" ;
    rdfs:comment "How this evidence answers the claim, in words a skeptic can check." .

effortless-ntwf:claimKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ClaimKind" ;
    rdfs:comment "Kind of the claim this evidence supports." .
    # calculated: lookup

effortless-ntwf:fieldCatalogName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:string ;
    rdfs:label "FieldCatalogName" ;
    rdfs:comment "The evidence field's name as the catalog records it; blank when the field does not exist." .
    # calculated: lookup

effortless-ntwf:fieldIsWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "FieldIsWitness" ;
    rdfs:comment "Whether the evidence field was invented for a role question." .
    # calculated: lookup

effortless-ntwf:fieldHasData a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "FieldHasData" ;
    rdfs:comment "Whether Postgres holds data for the evidence field." .
    # calculated: lookup

effortless-ntwf:fieldIsDiscriminating a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "FieldIsDiscriminating" ;
    rdfs:comment "Whether the evidence field tells rows apart." .
    # calculated: lookup

effortless-ntwf:fieldIsContested a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "FieldIsContested" ;
    rdfs:comment "Whether a graded substrate disagrees on the evidence field." .
    # calculated: lookup

effortless-ntwf:tableHasRows a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "TableHasRows" ;
    rdfs:comment "Whether Postgres holds rows of the evidence table." .
    # calculated: lookup

effortless-ntwf:questionIsAnswered a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "QuestionIsAnswered" ;
    rdfs:comment "Whether the evidence question has predicates." .
    # calculated: lookup

effortless-ntwf:questionWitnessedAnswer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:string ;
    rdfs:label "QuestionWitnessedAnswer" ;
    rdfs:comment "The substrate-computed answer of the evidence question." .
    # calculated: lookup

effortless-ntwf:profileMappingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:integer ;
    rdfs:label "ProfileMappingCount" ;
    rdfs:comment "Semantic mappings using the evidence profile." .
    # calculated: lookup

effortless-ntwf:methodIsApplied a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "MethodIsApplied" ;
    rdfs:comment "Whether a seeded row applies the evidence method." .
    # calculated: lookup

effortless-ntwf:procedureExecutionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:integer ;
    rdfs:label "ProcedureExecutionCount" ;
    rdfs:comment "Recorded executions of the evidence procedure." .
    # calculated: lookup

effortless-ntwf:hasJustification a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasJustification" ;
    rdfs:comment "TRUE when the justification is written." .
    # calculated: calculated

effortless-ntwf:isWitnessProof a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWitnessProof" ;
    rdfs:comment "Evidence is an existing field invented for a role question that discriminates." .
    # calculated: calculated

effortless-ntwf:isStructuralProof a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStructuralProof" ;
    rdfs:comment "Evidence is a table with rows or a field with data." .
    # calculated: calculated

effortless-ntwf:isQuestionProof a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsQuestionProof" ;
    rdfs:comment "Evidence is an answered role question with a computed answer." .
    # calculated: calculated

effortless-ntwf:isStandardProof a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStandardProof" ;
    rdfs:comment "Evidence is a mapped ontology profile or an applied knowledge method." .
    # calculated: calculated

effortless-ntwf:isScenarioProof a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsScenarioProof" ;
    rdfs:comment "Evidence is a procedure with recorded executions." .
    # calculated: calculated

effortless-ntwf:isValid a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsValid" ;
    rdfs:comment "TRUE when the evidence is justified and is the kind of proof this claim's kind demands." .
    # calculated: calculated

effortless-ntwf:isContested a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsContested" ;
    rdfs:comment "TRUE when the evidence field is disputed by a graded substrate." .
    # calculated: calculated

effortless-ntwf:isAgreedEvidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAgreedEvidence" ;
    rdfs:comment "TRUE when the evidence is valid and no graded substrate disputes it." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

