effortless-ntwf:isAiAgentWithoutModelVersion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAiAgentWithoutModelVersion" ;
    rdfs:comment "TRUE for an AI agent carrying no model version identifier." .
    # calculated: calculated

effortless-ntwf:attributedArtifactCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "AttributedArtifactCount" ;
    rdfs:comment "Artifacts attributed to the agent." .
    # calculated: aggregation

effortless-ntwf:hasProducedArtifacts a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasProducedArtifacts" ;
    rdfs:comment "TRUE when some artifact is attributed to the agent." .
    # calculated: calculated

effortless-ntwf:hasArtifactBlastRadius a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasArtifactBlastRadius" ;
    rdfs:comment "TRUE when moving the agent to another version affects steps downstream of its artifacts." .
    # calculated: calculated

effortless-ntwf:registryVersionMatchCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:integer ;
    rdfs:label "RegistryVersionMatchCount" ;
    rdfs:comment "Registry records whose Dublin Core identifier and version match this agent individual." .
    # calculated: aggregation

effortless-ntwf:isAiAgentNotFilledFromRegistry a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAiAgentNotFilledFromRegistry" ;
    rdfs:comment "TRUE for an AI agent individual that no registry record supplies, or whose version disagrees with the registry." .
    # calculated: calculated

effortless-ntwf:currentAccountableHumanCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:integer ;
    rdfs:label "CurrentAccountableHumanCount" ;
    rdfs:comment "Human persons currently accountable for the agent." .
    # calculated: aggregation

effortless-ntwf:isAiAgentWithoutAccountableHuman a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAiAgentWithoutAccountableHuman" ;
    rdfs:comment "TRUE for an AI agent currently filling a role with no human person accountable for it." .
    # calculated: calculated

effortless-ntwf:serviceStartedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "ServiceStartedAt" ;
    rdfs:comment "When the person began practising in the organization." .

effortless-ntwf:departureAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "DepartureAt" ;
    rdfs:comment "The person's planned or actual departure." .

effortless-ntwf:protectedMentoringHoursPerWeek a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "ProtectedMentoringHoursPerWeek" ;
    rdfs:comment "Weekly hours protected from production work for mentoring." .

effortless-ntwf:communityCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:integer ;
    rdfs:label "CommunityCount" ;
    rdfs:comment "Communities of practice the agent belongs to." .
    # calculated: aggregation

effortless-ntwf:isBoundarySpanner a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBoundarySpanner" ;
    rdfs:comment "TRUE when the agent belongs to two or more communities of practice." .
    # calculated: calculated

effortless-ntwf:snaIdentificationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:integer ;
    rdfs:label "SnaIdentificationCount" ;
    rdfs:comment "Network analyses that identified the agent as a connector." .
    # calculated: aggregation

effortless-ntwf:isUnidentifiedBoundarySpanner a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnidentifiedBoundarySpanner" ;
    rdfs:comment "TRUE when a person connecting communities was never found by a network analysis." .
    # calculated: calculated

effortless-ntwf:locatedKnowHowCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:integer ;
    rdfs:label "LocatedKnowHowCount" ;
    rdfs:comment "Know-how held by someone else that the agent, as broker, can point seekers to." .
    # calculated: aggregation

effortless-ntwf:requiredMentoringHoursPerWeek a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "RequiredMentoringHoursPerWeek" ;
    rdfs:comment "Weekly hours the agent's active mentorships need." .
    # calculated: aggregation

effortless-ntwf:lacksTimeToMentor a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "LacksTimeToMentor" ;
    rdfs:comment "TRUE when a mentor's protected hours fall short of what their active mentorships need." .
    # calculated: calculated

effortless-ntwf:transfersGivenCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:integer ;
    rdfs:label "TransfersGivenCount" ;
    rdfs:comment "Times the agent passed know-how on." .
    # calculated: aggregation

effortless-ntwf:recognitionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:integer ;
    rdfs:label "RecognitionCount" ;
    rdfs:comment "Recognitions the agent received for sharing." .
    # calculated: aggregation

effortless-ntwf:isUnrewardedSharer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnrewardedSharer" ;
    rdfs:comment "TRUE when someone who repeatedly passes know-how on has never been recognized for it." .
    # calculated: calculated

effortless-ntwf:downstreamOfHeldStepsCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:integer ;
    rdfs:label "DownstreamOfHeldStepsCount" ;
    rdfs:comment "Steps reachable along artifact hand-offs from the steps whose role this agent currently holds." .
    # calculated: aggregation

effortless-ntwf:artifactBlastRadiusStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:integer ;
    rdfs:label "ArtifactBlastRadiusStepCount" ;
    rdfs:comment "For an AI agent, the steps downstream of the steps it holds, found by traversing the artifact hand-off closure." .
    # calculated: calculated

# === Class: AiAdoptionInitiatives ===
effortless-ntwf:AiAdoptionInitiatives a owl:Class ;
    rdfs:label "AiAdoptionInitiatives" ;
    rdfs:comment "AI initiatives: the agent, the process and procedure it works on, the automation level, and what came of it." .

effortless-ntwf:aiAdoptionInitiativeId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:string ;
    rdfs:label "AiAdoptionInitiativeId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Initiative." .

effortless-ntwf:organization a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "Organization" ;
    rdfs:comment "Sponsoring organization." .

effortless-ntwf:agent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "Agent" ;
    rdfs:comment "AI agent." .

effortless-ntwf:targetProcedure a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range effortless-ntwf:Procedures ;
    rdfs:label "TargetProcedure" ;
    rdfs:comment "Procedure the AI works on." .

effortless-ntwf:targetVersion a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "TargetVersion" ;
    rdfs:comment "Version the AI works from." .

effortless-ntwf:approach a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:string ;
    rdfs:label "Approach" ;
    rdfs:comment "GroundedAgent, Assistant or PromptOnly." .

effortless-ntwf:automationLevel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:string ;
    rdfs:label "AutomationLevel" ;
    rdfs:comment "Assist, Partial or Full." .

effortless-ntwf:isAgentic a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAgentic" ;
    rdfs:comment "TRUE when the AI takes actions in the workflow, not just answers." .

effortless-ntwf:taskIsMultiStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "TaskIsMultiStep" ;
    rdfs:comment "TRUE when the AI's task follows ordered steps." .

effortless-ntwf:dependsOnOrganizationalKnowledge a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "DependsOnOrganizationalKnowledge" ;
    rdfs:comment "TRUE when the task depends on this organization's own knowledge." .

effortless-ntwf:precedingInitiative a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:label "PrecedingInitiative" ;
    rdfs:comment "The partial-automation stage this initiative follows." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Proposed, Pilot, InProduction or Retired." .

effortless-ntwf:outcome a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Outcome" ;
    rdfs:comment "Succeeded, Failed, Pending or NoMeasurableResult." .

effortless-ntwf:redesignStartedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:string ;
    rdfs:label "RedesignStartedAt" ;
    rdfs:comment "When the workflow redesign for AI began." .

effortless-ntwf:connectedToAiAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:string ;
    rdfs:label "ConnectedToAiAt" ;
    rdfs:comment "When knowledge was connected to the AI." .

effortless-ntwf:modelLayerBudget a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:string ;
    rdfs:label "ModelLayerBudget" ;
    rdfs:comment "Spend on models." .

effortless-ntwf:knowledgeLayerBudget a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeLayerBudget" ;
    rdfs:comment "Spend on eliciting, encoding and governing knowledge." .

effortless-ntwf:measuredBottomLineImpact a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:string ;
    rdfs:label "MeasuredBottomLineImpact" ;
    rdfs:comment "Measured bottom-line result." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "Instant judged against." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "Evaluation instant." .
    # calculated: lookup

effortless-ntwf:targetHasNoExplicitSteps a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "TargetHasNoExplicitSteps" ;
    rdfs:comment "Whether the procedure exists only as title and documents." .
    # calculated: lookup

effortless-ntwf:targetVersionIssuedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:string ;
    rdfs:label "TargetVersionIssuedAt" ;
    rdfs:comment "When the target version was issued." .
    # calculated: lookup

effortless-ntwf:targetVersionUnderSpecified a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "TargetVersionUnderSpecified" ;
    rdfs:comment "Whether the version lacks conditions or exception handling." .
    # calculated: lookup

effortless-ntwf:targetVersionNotationOnly a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "TargetVersionNotationOnly" ;
    rdfs:comment "Whether the version's steps carry no ontology type." .
    # calculated: lookup

effortless-ntwf:targetElicitationEvidenceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:integer ;
    rdfs:label "TargetElicitationEvidenceCount" ;
    rdfs:comment "Elicitation evidence behind the version." .
    # calculated: lookup

effortless-ntwf:reviewedOutputCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:integer ;
    rdfs:label "ReviewedOutputCount" ;
    rdfs:comment "AI outputs experts reviewed during this initiative." .
    # calculated: aggregation

effortless-ntwf:precedingReviewedOutputCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:integer ;
    rdfs:label "PrecedingReviewedOutputCount" ;
    rdfs:comment "Expert-reviewed outputs of the preceding stage." .
    # calculated: lookup

effortless-ntwf:lastOutcomeMeasuredAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:string ;
    rdfs:label "LastOutcomeMeasuredAt" ;
    rdfs:comment "When an outcome was last measured." .
    # calculated: aggregation

effortless-ntwf:daysSinceOutcomeMeasured a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceOutcomeMeasured" ;
    rdfs:comment "Days since the last outcome measurement." .
    # calculated: calculated

effortless-ntwf:aiInsightCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:integer ;
    rdfs:label "AiInsightCount" ;
    rdfs:comment "Insights the initiative folded back as proposals." .
    # calculated: aggregation

effortless-ntwf:handsTacitProcedureToAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "HandsTacitProcedureToAgent" ;
    rdfs:comment "TRUE when an agent is assigned a procedure that exists only as tacit knowledge and documents." .
    # calculated: calculated

effortless-ntwf:agentOnUnderSpecifiedProcedure a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "AgentOnUnderSpecifiedProcedure" ;
    rdfs:comment "TRUE when an agent runs a version that does not specify conditions or exception handling." .
    # calculated: calculated

effortless-ntwf:agentOnNotationOnlyProcedure a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "AgentOnNotationOnlyProcedure" ;
    rdfs:comment "TRUE when an agent runs a version whose steps carry no ontology type." .
    # calculated: calculated

effortless-ntwf:callsForProcessKnowledgeFramework a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "CallsForProcessKnowledgeFramework" ;
    rdfs:comment "TRUE when the AI task follows ordered steps and depends on organizational knowledge." .
    # calculated: calculated

effortless-ntwf:redesignedBeforeDocumented a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "RedesignedBeforeDocumented" ;
    rdfs:comment "TRUE when a workflow redesign for AI began before the workflow was documented as a version." .
    # calculated: calculated

effortless-ntwf:breaksElicitEncodeConnectOrder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "BreaksElicitEncodeConnectOrder" ;
    rdfs:comment "TRUE when knowledge was connected to AI with no elicitation behind it, or before it was encoded." .
    # calculated: calculated

effortless-ntwf:wentFullWithoutReviewedPartialStage a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "WentFullWithoutReviewedPartialStage" ;
    rdfs:comment "TRUE for full automation with no preceding partial stage whose output experts reviewed." .
    # calculated: calculated

effortless-ntwf:underinvestsKnowledgeLayer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "UnderinvestsKnowledgeLayer" ;
    rdfs:comment "TRUE when the knowledge layer gets less investment than the model layer." .
    # calculated: calculated

effortless-ntwf:notAnchoredInProcessKnowledge a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "NotAnchoredInProcessKnowledge" ;
    rdfs:comment "TRUE for an AI initiative past proposal that is anchored to no modeled procedure." .
    # calculated: calculated

effortless-ntwf:agenticWithoutKnowledgeCapture a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "AgenticWithoutKnowledgeCapture" ;
    rdfs:comment "TRUE for an agentic system past proposal that has produced no procedural knowledge back." .
    # calculated: calculated

effortless-ntwf:isAiOutcomeUnmeasured a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAiOutcomeUnmeasured" ;
    rdfs:comment "TRUE for a pilot or production AI never measured, or not measured in over 30 days." .
    # calculated: calculated

effortless-ntwf:adoptedWithoutBottomLineResult a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "AdoptedWithoutBottomLineResult" ;
    rdfs:comment "TRUE for AI in production with no measured bottom-line result." .
    # calculated: calculated

effortless-ntwf:failedWithoutFormalizedKnowledge a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AiAdoptionInitiatives ;
    rdfs:range xsd:boolean ;
    rdfs:label "FailedWithoutFormalizedKnowledge" ;
    rdfs:comment "TRUE when prompting a model about work with no formalized steps -- no procedure, or one with no steps -- failed." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: AiAgentAccountabilities ===
effortless-ntwf:AiAgentAccountabilities a owl:Class ;
    rdfs:label "AiAgentAccountabilities" ;
