    rdfs:domain pko-extension:ObservedAction ;
    rdfs:range xsd:string ;
    rdfs:label "CounterfactualAnswer" ;
    rdfs:comment "What the practitioner said they would do under that condition." .

pko-native-procedural-knowledge-rulebook:counterfactualCondition a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ObservedAction ;
    rdfs:range xsd:string ;
    rdfs:label "CounterfactualCondition" ;
    rdfs:comment "The different condition the observer asked about." .

pko-native-procedural-knowledge-rulebook:coverageCheckedAt a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelChangeRequest ;
    rdfs:range xsd:dateTime ;
    rdfs:label "CoverageCheckedAt" ;
