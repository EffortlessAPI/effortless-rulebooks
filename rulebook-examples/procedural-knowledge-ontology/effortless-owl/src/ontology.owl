effortless-ntwf:hasStepDeviation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasStepDeviation" ;
    rdfs:comment "TRUE when any step deviated." .
    # calculated: calculated

effortless-ntwf:deviatingFacilityKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "DeviatingFacilityKey" ;
    rdfs:comment "Facility key when the run deviated." .
    # calculated: calculated

effortless-ntwf:cleanFacilityKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "CleanFacilityKey" ;
    rdfs:comment "Facility key when the run did not deviate." .
