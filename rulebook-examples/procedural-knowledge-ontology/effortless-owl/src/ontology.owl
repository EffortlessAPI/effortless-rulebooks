effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: CellDisagreements ===
effortless-ntwf:CellDisagreements a owl:Class ;
    rdfs:label "CellDisagreements" ;
    rdfs:comment "Latest run only: one cell a substrate computed differently from the answer key, with both values verbatim. Sampled per field; see FieldDisagreements.IsFullySampled." .

effortless-ntwf:cellDisagreementId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CellDisagreements ;
    rdfs:range xsd:string ;
    rdfs:label "CellDisagreementId" ;
    rdfs:comment "Stored logical identifier: '<substrate>|<Table>.<Field>|<record id>'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:fieldDisagreement a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:CellDisagreements ;
    rdfs:range effortless-ntwf:FieldDisagreements ;
    rdfs:label "FieldDisagreement" ;
    rdfs:comment "The substrate-by-field disagreement this cell belongs to." .

effortless-ntwf:recordId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CellDisagreements ;
    rdfs:range xsd:string ;
    rdfs:label "RecordId" ;
    rdfs:comment "Primary key of the row whose cell disagreed." .

effortless-ntwf:expectedValue a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ExpectedValue" ;
    rdfs:comment "The answer key's value, JSON-encoded so null, '', false and 0 stay distinguishable." .

effortless-ntwf:actualValue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CellDisagreements ;
    rdfs:range xsd:string ;
    rdfs:label "ActualValue" ;
    rdfs:comment "The substrate's value, JSON-encoded the same way." .

effortless-ntwf:reason a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Reason" ;
    rdfs:comment "The harness's reason: 'wrong/null value', 'missing record' or 'missing entity file'." .

effortless-ntwf:substrate a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Substrate" ;
    rdfs:comment "The substrate that produced ActualValue." .
    # calculated: lookup

effortless-ntwf:rulebookField a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RulebookField" ;
    rdfs:comment "The field." .
    # calculated: lookup

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ChangeAuthorityRules ===
effortless-ntwf:ChangeAuthorityRules a owl:Class ;
    rdfs:label "ChangeAuthorityRules" ;
    rdfs:comment "Which role may change which layer of a model, who approves, through which process, and the response when a change breaks the model." .

effortless-ntwf:changeAuthorityRuleId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeAuthorityRules ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeAuthorityRuleId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:governedModel a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:GovernedModels ;
    rdfs:label "GovernedModel" ;
    rdfs:comment "Model." .

effortless-ntwf:changeLayer a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeLayer" ;
    rdfs:comment "Layer the rule governs." .

effortless-ntwf:permittedRole a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ChangeAuthorityRules ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "PermittedRole" ;
    rdfs:comment "Role that may make the change." .

effortless-ntwf:approvalRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "ApprovalRole" ;
    rdfs:comment "Role that approves it." .

effortless-ntwf:requiredRoute a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RequiredRoute" ;
    rdfs:comment "DataOperations or Governance." .

effortless-ntwf:whenPermitted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeAuthorityRules ;
    rdfs:range xsd:string ;
    rdfs:label "WhenPermitted" ;
    rdfs:comment "When such changes may be made." .

effortless-ntwf:breakageResponse a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeAuthorityRules ;
    rdfs:range xsd:string ;
    rdfs:label "BreakageResponse" ;
    rdfs:comment "What happens when a change of this kind breaks the model." .

effortless-ntwf:misroutedRequestCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeAuthorityRules ;
    rdfs:range xsd:integer ;
    rdfs:label "MisroutedRequestCount" ;
    rdfs:comment "Requests under this rule that went through the wrong process." .
    # calculated: aggregation

effortless-ntwf:isRuleBypassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeAuthorityRules ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRuleBypassed" ;
    rdfs:comment "TRUE when at least one change went around this rule's required process." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

