effortless-ntwf:usesAiInOneDirectionOnly a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "UsesAiInOneDirectionOnly" ;
    rdfs:comment "TRUE when AI only consumes the version and never contributes to it, or only contributes and never consumes it." .
    # calculated: calculated

effortless-ntwf:isUnmodifiedForTwelveMonths a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnmodifiedForTwelveMonths" ;
    rdfs:comment "TRUE for a current workflow not modified in more than twelve months." .
    # calculated: calculated

effortless-ntwf:designDecisionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "DesignDecisionCount" ;
    rdfs:comment "Design decisions recorded with the version." .
    # calculated: aggregation

effortless-ntwf:isLiveWithoutRecordedDecisions a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveWithoutRecordedDecisions" ;
    rdfs:comment "TRUE for a live version with no design decision recorded alongside it." .
    # calculated: calculated

effortless-ntwf:aiArtifactConsumingInputCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "AiArtifactConsumingInputCount" ;
    rdfs:comment "Inputs of the version's steps fed by an AI agent's artifact." .
    # calculated: aggregation

effortless-ntwf:containsStepsAffectedByAiAgentChange a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ContainsStepsAffectedByAiAgentChange" ;
    rdfs:comment "TRUE when the workflow contains a step that consumes an AI agent's artifact, so changing that agent affects it." .
    # calculated: calculated

effortless-ntwf:interviewSessionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "InterviewSessionCount" ;
    rdfs:comment "Interview sessions for the version." .
    # calculated: aggregation

effortless-ntwf:observationSessionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "ObservationSessionCount" ;
    rdfs:comment "Observation sessions for the version." .
    # calculated: aggregation

effortless-ntwf:workshopSessionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "WorkshopSessionCount" ;
    rdfs:comment "Workshop sessions for the version." .
    # calculated: aggregation

effortless-ntwf:protocolSessionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "ProtocolSessionCount" ;
    rdfs:comment "Think-aloud, retrospective, laddering and grid sessions for the version." .
    # calculated: aggregation

effortless-ntwf:incidentSessionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "IncidentSessionCount" ;
    rdfs:comment "Critical incident sessions for the version." .
    # calculated: aggregation

effortless-ntwf:reconciledDivergenceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "ReconciledDivergenceCount" ;
    rdfs:comment "Workflow disagreements settled for the version." .
    # calculated: aggregation

effortless-ntwf:complementaryMethodCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "ComplementaryMethodCount" ;
    rdfs:comment "Distinct families of elicitation used for the version." .
    # calculated: calculated

effortless-ntwf:reliesOnSingleMethod a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ReliesOnSingleMethod" ;
    rdfs:comment "TRUE when the version's knowledge was elicited with one family of method only." .
    # calculated: calculated

effortless-ntwf:missesARequiredElicitationMode a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "MissesARequiredElicitationMode" ;
    rdfs:comment "TRUE for an elicited version lacking a workshop, a structured interview, observation, or a session that settled a disagreement." .
    # calculated: calculated

effortless-ntwf:criticalIncidentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CriticalIncidentCount" ;
    rdfs:comment "Critical incidents collected for the version." .
    # calculated: aggregation

effortless-ntwf:judgmentUnprobedByIncidents a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "JudgmentUnprobedByIncidents" ;
    rdfs:comment "TRUE when a version relies on tacit or situated judgment yet no critical incident was collected to surface it." .
    # calculated: calculated

effortless-ntwf:smeApprovalCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "SmeApprovalCount" ;
    rdfs:comment "Approvals of the representation by subject matter experts it affects." .
    # calculated: aggregation

effortless-ntwf:smeAiEvaluationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "SmeAiEvaluationCount" ;
    rdfs:comment "Evaluations of AI output on this version by affected subject matter experts." .
    # calculated: aggregation

effortless-ntwf:isApprovedWithoutSmeSignoff a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApprovedWithoutSmeSignoff" ;
    rdfs:comment "TRUE for an approved version no affected subject matter expert approved the representation of." .
    # calculated: calculated

effortless-ntwf:expertsEvaluateAiNotRepresentation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExpertsEvaluateAiNotRepresentation" ;
    rdfs:comment "TRUE when experts were recruited to evaluate AI output on a version but none to approve the representation it rests on." .
    # calculated: calculated

effortless-ntwf:keSessionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "KeSessionCount" ;
    rdfs:comment "Sessions the knowledge engineer ran for the version." .
    # calculated: aggregation

effortless-ntwf:keFieldSessionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "KeFieldSessionCount" ;
    rdfs:comment "Sessions the knowledge engineer ran where the work is done." .
    # calculated: aggregation

effortless-ntwf:isStudiedOnlyFromTheDesk a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStudiedOnlyFromTheDesk" ;
    rdfs:comment "TRUE when the knowledge engineer elicited the version but never went where the work happens." .
    # calculated: calculated

effortless-ntwf:judgmentHeldOutsideSopCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "JudgmentHeldOutsideSopCount" ;
    rdfs:comment "Unformalized knowledge of the version its SOP says nothing about." .
    # calculated: aggregation

effortless-ntwf:tacitHoldingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "TacitHoldingCount" ;
    rdfs:comment "Holdings of the version in tacit form." .
    # calculated: aggregation

effortless-ntwf:explicitHoldingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "ExplicitHoldingCount" ;
    rdfs:comment "Holdings of the version in explicit form." .
    # calculated: aggregation

effortless-ntwf:tacitShareExceedsExplicit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "TacitShareExceedsExplicit" ;
    rdfs:comment "TRUE when more of the version's knowledge is held tacitly than in explicit carriers." .
    # calculated: calculated

effortless-ntwf:handsHeldCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "HandsHeldCount" ;
    rdfs:comment "Unformalized knowledge held only in operators' memory." .
    # calculated: aggregation

effortless-ntwf:negotiatedPracticeCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "NegotiatedPracticeCount" ;
    rdfs:comment "Unformalized knowledge held as unspoken crew agreements." .
    # calculated: aggregation

effortless-ntwf:livesInHandsSilenceAndNegotiation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "LivesInHandsSilenceAndNegotiation" ;
    rdfs:comment "TRUE when the version's knowledge lives at once in experienced hands, in what its SOP leaves unsaid, and in unspoken crew agreements." .
    # calculated: calculated

effortless-ntwf:processModelTraceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "ProcessModelTraceCount" ;
    rdfs:comment "Origin traces of the version as a process model." .
    # calculated: aggregation

effortless-ntwf:isLiveModelUntraced a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveModelUntraced" ;
    rdfs:comment "TRUE when an executable process model traces to no collection activity." .
    # calculated: calculated

effortless-ntwf:trailingPracticeTraceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "TrailingPracticeTraceCount" ;
    rdfs:comment "Contradictions showing a document of this version trailing practice." .
    # calculated: aggregation

effortless-ntwf:isDocumentedBehindPractice a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDocumentedBehindPractice" ;
    rdfs:comment "TRUE when the version's documentation trails how the work is performed." .
    # calculated: calculated

effortless-ntwf:standardizationDriver a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "StandardizationDriver" ;
    rdfs:comment "Why the version was standardized: Compliance or Practice." .

effortless-ntwf:tacitFragmentCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "TacitFragmentCount" ;
    rdfs:comment "Tacit knowledge fragments captured for the version." .
    # calculated: aggregation

effortless-ntwf:isStandardizedWithoutTacitCapture a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStandardizedWithoutTacitCapture" ;
    rdfs:comment "TRUE when a version standardized for compliance has no tacit knowledge captured behind it." .
    # calculated: calculated

effortless-ntwf:tacitFormFragmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "TacitFormFragmentCount" ;
    rdfs:comment "Tacit fragments attached to the version." .
    # calculated: aggregation

effortless-ntwf:situatedJudgmentFragmentCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "SituatedJudgmentFragmentCount" ;
    rdfs:comment "Situated-judgment fragments attached to the version." .
    # calculated: aggregation

effortless-ntwf:tacitJudgmentFragmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "TacitJudgmentFragmentCount" ;
    rdfs:comment "Tacit or situated-judgment fragments attached to the version." .
    # calculated: calculated

effortless-ntwf:firstStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "FirstStep" ;
    rdfs:comment "Declared first step (pko:hasFirstStep), read from the step that declares itself first." .
    # calculated: aggregation

effortless-ntwf:fallbackStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "FallbackStep" ;
    rdfs:comment "Declared fallback step (pko:hasFallbackStep), read from the step that declares itself the fallback." .
    # calculated: aggregation

effortless-ntwf:firstStepDisagreesWithGraph a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "FirstStepDisagreesWithGraph" ;
    rdfs:comment "TRUE when the transition graph has an entry step and the declared first step is a different one. A graph whose first step also receives a loop-back has no entry step, and is not a disagreement." .
    # calculated: calculated

effortless-ntwf:declaredFirstStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "DeclaredFirstStepCount" ;
    rdfs:comment "Steps of the version that declare themselves its first step." .
    # calculated: aggregation

effortless-ntwf:graphEntryStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "GraphEntryStepCount" ;
    rdfs:comment "Steps of the version with no incoming transition." .
    # calculated: aggregation

effortless-ntwf:ownerOrganization a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OwnerOrganization" ;
    rdfs:comment "The organization that owns the procedure this row belongs to, one hop at a time from Procedures.OwnerOrganization. A row policy compares it to the caller's organization, so a plant sign-in never sees the finance close." .
    # calculated: lookup

# === Class: Procedures ===
effortless-ntwf:Procedures a owl:Class ;
    rdfs:label "Procedures" ;
    rdfs:comment "Abstract, discoverable procedures. Each version is represented separately in ProcedureVersions. Maps to pko:Procedure and dcat:Resource." .

effortless-ntwf:procedureId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:string ;
    rdfs:label "ProcedureId" ;
    rdfs:comment "Stored logical identifier for one Procedures row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Procedures row." .
    # calculated: calculated

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Human-readable title; maps to dcterms:title." .

effortless-ntwf:procedureType a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range effortless-ntwf:ProcedureTypes ;
    rdfs:label "ProcedureType" ;
    rdfs:comment "Procedure type; maps to pko:hasProcedureType." .

effortless-ntwf:ownerOrganization a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "OwnerOrganization" ;
    rdfs:comment "Organization that owns the procedure." .

effortless-ntwf:adoptedByOrganization a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "AdoptedByOrganization" ;
    rdfs:comment "Organization that adopts the procedure; maps to pko:isAdoptedBy." .

effortless-ntwf:purpose a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Purpose" ;
    rdfs:comment "Desired outcome and scope of the procedure." .

effortless-ntwf:target a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:string ;
    rdfs:label "Target" ;
    rdfs:comment "Thing or population on which the procedure acts; maps to pko:hasProcedureTarget." .

effortless-ntwf:isTemplate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTemplate" ;
    rdfs:comment "TRUE when the procedure is a reusable template; maps to pko:isTemplate." .

effortless-ntwf:currentVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentVersionKey" ;
    rdfs:comment "Current version identifier, mirrored structurally by ProcedureVersions.IsCurrent." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

effortless-ntwf:executionCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "ExecutionCount" ;
    rdfs:comment "Recorded executions across every version of this procedure." .
    # calculated: aggregation

effortless-ntwf:templateProcedure a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range effortless-ntwf:Procedures ;
    rdfs:label "TemplateProcedure" ;
    rdfs:comment "Template this procedure instantiates (pko:hasTemplate)." .

effortless-ntwf:requiredByRegulation a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range effortless-ntwf:RegulatoryFrameworks ;
    rdfs:label "RequiredByRegulation" ;
    rdfs:comment "Regulation that makes this procedure mandatory." .

effortless-ntwf:isTemplateInstance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTemplateInstance" ;
    rdfs:comment "TRUE when the procedure instantiates a template." .
    # calculated: calculated

effortless-ntwf:targetCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "TargetCount" ;
    rdfs:comment "Targets the procedure is about." .
    # calculated: aggregation

effortless-ntwf:adoptionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "AdoptionCount" ;
    rdfs:comment "Organizations that adopted the procedure." .
    # calculated: aggregation

effortless-ntwf:specifiedStepTotal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "SpecifiedStepTotal" ;
    rdfs:comment "Steps specified across every version of the procedure." .
    # calculated: aggregation

effortless-ntwf:hasNoExplicitSteps a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoExplicitSteps" ;
    rdfs:comment "TRUE for a procedure that exists only as a title and documents: no version specifies a single step." .
    # calculated: calculated

effortless-ntwf:calledByStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "CalledByStepCount" ;
    rdfs:comment "Steps of other procedures that invoke this one as a sub-procedure." .
    # calculated: aggregation

effortless-ntwf:isNestedProcedure a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNestedProcedure" ;
    rdfs:comment "TRUE when the procedure runs inside a larger procedure." .
    # calculated: calculated

effortless-ntwf:failureCriterionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "FailureCriterionCount" ;
    rdfs:comment "Failure criteria." .
    # calculated: aggregation

effortless-ntwf:hasNoFailureCriterion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoFailureCriterion" ;
    rdfs:comment "TRUE when nothing says what outcome counts as failure." .
    # calculated: calculated

effortless-ntwf:lensViewCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "LensViewCount" ;
    rdfs:comment "Stakeholder views of the procedure." .
    # calculated: aggregation

effortless-ntwf:privilegesSingleStakeholderView a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "PrivilegesSingleStakeholderView" ;
    rdfs:comment "TRUE when the procedure is organized for exactly one stakeholder lens." .
    # calculated: calculated

effortless-ntwf:stepLevelViewCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "StepLevelViewCount" ;
    rdfs:comment "Views whose lens needs step-level detail." .
    # calculated: aggregation

effortless-ntwf:categoryLevelViewCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "CategoryLevelViewCount" ;
    rdfs:comment "Views whose lens needs only the category." .
    # calculated: aggregation

effortless-ntwf:procedureTypeRank a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:string ;
    rdfs:label "ProcedureTypeRank" ;
    rdfs:comment "Taxonomy rank of the procedure's type." .
    # calculated: lookup

effortless-ntwf:procedureTypeDefinition a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:string ;
    rdfs:label "ProcedureTypeDefinition" ;
    rdfs:comment "Definition of the procedure's type." .
    # calculated: lookup

effortless-ntwf:hasStepAndCategoryResolutions a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasStepAndCategoryResolutions" ;
    rdfs:comment "TRUE when the procedure can be shown both at step level and at its process-type category." .
    # calculated: calculated

effortless-ntwf:isMissingDemandedResolution a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMissingDemandedResolution" ;
    rdfs:comment "TRUE when a lens needs step-level detail the procedure does not have, or a category the procedure is not classified into." .
    # calculated: calculated

effortless-ntwf:isInconsistentlyCategorized a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInconsistentlyCategorized" ;
    rdfs:comment "TRUE when a procedure has no type, is filed at a domain or group rank instead of a process type, or its type has no definition." .
    # calculated: calculated

effortless-ntwf:strategicAlignmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "StrategicAlignmentCount" ;
    rdfs:comment "Strategic alignments stated for the procedure." .
    # calculated: aggregation

effortless-ntwf:hasNoStatedReasonForExisting a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoStatedReasonForExisting" ;
    rdfs:comment "TRUE when nothing ties the procedure to a mission, rationale or value." .
    # calculated: calculated

effortless-ntwf:outcomeMeasureCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "OutcomeMeasureCount" ;
    rdfs:comment "Outcome measures." .
    # calculated: aggregation

effortless-ntwf:unlinkedMeasureCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "UnlinkedMeasureCount" ;
    rdfs:comment "Outcome measures tied to no business outcome." .
    # calculated: aggregation

effortless-ntwf:measuresPerformanceWithoutBusinessLink a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "MeasuresPerformanceWithoutBusinessLink" ;
    rdfs:comment "TRUE when the procedure is measured but no measure connects to a business outcome." .
    # calculated: calculated

effortless-ntwf:hinderedByCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:integer ;
    rdfs:label "HinderedByCount" ;
    rdfs:comment "Operations that work against this one." .
    # calculated: aggregation

effortless-ntwf:isHinderedByAnotherOperation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHinderedByAnotherOperation" ;
    rdfs:comment "TRUE when another operation works against this one." .
    # calculated: calculated

effortless-ntwf:typeDistinguishingFacet a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:string ;
