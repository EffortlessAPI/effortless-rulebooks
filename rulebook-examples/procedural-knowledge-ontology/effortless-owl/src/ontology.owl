    rdfs:range xsd:dateTime ;
    rdfs:label "LastHeldAt" ;
    rdfs:comment "When it was last held." .

pko-native-procedural-knowledge-rulebook:lastMajorRevisionAt a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:OntologyProfiles ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastMajorRevisionAt" ;
