    rdfs:comment "TRUE when a breaking release shipped with no migration plan." .
    # calculated: calculated

effortless-ntwf:isUndocumentedVersionDecision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUndocumentedVersionDecision" ;
    rdfs:comment "TRUE when a governed release records no rationale or no decider for its version increment." .
    # calculated: calculated

effortless-ntwf:isUnannouncedToDependents a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:boolean ;
