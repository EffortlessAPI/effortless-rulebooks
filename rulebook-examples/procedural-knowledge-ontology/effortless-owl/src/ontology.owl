    rdfs:comment "TRUE when the stakeholder department has not been engaged." .

pko-native-procedural-knowledge-rulebook:isBackwardIncompatible a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBackwardIncompatible" ;
    rdfs:comment "TRUE when the change breaks existing data or queries." .

pko-native-procedural-knowledge-rulebook:isBareAssertion a owl:DatatypeProperty ;
    rdfs:domain pko:RequirementSatisfaction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBareAssertion" ;
    rdfs:comment "TRUE when a blocking control was cleared with no computed witness and no written justification." .

pko-native-procedural-knowledge-rulebook:isBaselineRegression a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CompetencyQuestionRun ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBaselineRegression" ;
    rdfs:comment "TRUE when an original question the previous release answered can no longer be answered." .

pko-native-procedural-knowledge-rulebook:isBehindCanonicalVersion a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ConsumerSystemSync ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBehindCanonicalVersion" ;
    rdfs:comment "TRUE when a consuming system holds a different version from the one the model says is current." .

pko-native-procedural-knowledge-rulebook:isBehindCurrentPractice a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Resources ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBehindCurrentPractice" ;
    rdfs:comment "TRUE when the document has fallen behind how the work is currently done." .

pko-native-procedural-knowledge-rulebook:isBehindCurrentRelease a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelDocument ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBehindCurrentRelease" ;
    rdfs:comment "TRUE when the document still describes an older release than the one the model is at." .

pko-native-procedural-knowledge-rulebook:isBelowTaskCompletionTarget a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBelowTaskCompletionTarget" ;
    rdfs:comment "TRUE for an AI agent completing fewer than 80% of its tasks." .

pko-native-procedural-knowledge-rulebook:isBlockedByFailedPrecondition a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBlockedByFailedPrecondition" ;
    rdfs:comment "A check on this step recorded that a precondition did not hold. The step may not be marked done; only a fallback is offered, exactly as for an observed warning sign." .

pko-native-procedural-knowledge-rulebook:isBlockedByIncompletePrerequisite a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBlockedByIncompletePrerequisite" ;
    rdfs:comment "TRUE for an unfinished step whose prerequisite has not completed in the same execution." .

pko-native-procedural-knowledge-rulebook:isBlockedByObservedCue a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBlockedByObservedCue" ;
    rdfs:comment "A warning sign that means 'not finished' was seen on this step execution, so the normal next step must not be offered; only a fallback is." .

pko-native-procedural-knowledge-rulebook:isBlockedOnPendingDecision a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBlockedOnPendingDecision" ;
    rdfs:comment "A live version carrying both an undecided change request and an open blocking gap — the gap cannot close until the decision lands." .

pko-native-procedural-knowledge-rulebook:isBlocking a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBlocking" .

pko-native-procedural-knowledge-rulebook:isBlockingAndUnmet a owl:DatatypeProperty ;
    rdfs:domain pko:RequirementSatisfaction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBlockingAndUnmet" ;
    rdfs:comment "TRUE when a blocking requirement is recorded at anything less than fully Satisfied. This is the control-failure witness at the requirement grain." .

pko-native-procedural-knowledge-rulebook:isBlockingControlOnReworkLoop a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBlockingControlOnReworkLoop" ;
    rdfs:comment "A step carrying at least one blocking requirement can be re-entered, so that control must hold on every pass, not only the first." .

pko-native-procedural-knowledge-rulebook:isBottleneck a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBottleneck" .

pko-native-procedural-knowledge-rulebook:isBottleneckStep a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBottleneckStep" ;
    rdfs:comment "TRUE when the step waits on a resource whose demand exceeds its capacity." .

pko-native-procedural-knowledge-rulebook:isBoundToAnyStep a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBoundToAnyStep" ;
    rdfs:comment "TRUE when at least one step carries this requirement." .

pko-native-procedural-knowledge-rulebook:isBoundarySpanner a owl:DatatypeProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBoundarySpanner" ;
    rdfs:comment "TRUE when the agent belongs to two or more communities of practice." .

pko-native-procedural-knowledge-rulebook:isBreachedButNeverFailed a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBreachedButNeverFailed" ;
    rdfs:comment "TRUE when the book holds a failed check of a condition this control enforces, and the control's own record still says it has never failed. The breach is on record; the control never heard about it." .

pko-native-procedural-knowledge-rulebook:isBreakingRelease a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBreakingRelease" ;
    rdfs:comment "TRUE for a major release or any release containing a breaking change." .

pko-native-procedural-knowledge-rulebook:isBusinessProcessOutsourcing a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourcingFunction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBusinessProcessOutsourcing" ;
    rdfs:comment "TRUE for routine transactional work performed by a provider." .

pko-native-procedural-knowledge-rulebook:isCaptureSeparateFromWork a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCaptureSeparateFromWork" ;
    rdfs:comment "TRUE when knowledge about the procedure is collected, but never in the course of the work." .

pko-native-procedural-knowledge-rulebook:isCaptured a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCaptured" ;
    rdfs:comment "TRUE when a repository entry captures the know-how." .

pko-native-procedural-knowledge-rulebook:isCapturedByAutomationAlone a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCapturedByAutomationAlone" ;
    rdfs:comment "TRUE when the procedure's knowledge was captured by machines and no practitioner was engaged." .

pko-native-procedural-knowledge-rulebook:isCapturedInFlowOfWork a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CollectedSourceMaterial ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCapturedInFlowOfWork" ;
    rdfs:comment "TRUE when the material was captured while the work was being done." .

pko-native-procedural-knowledge-rulebook:isCirculationEndingForLackOfApprentices a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CommunityOfPractice ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCirculationEndingForLackOfApprentices" ;
    rdfs:comment "TRUE when know-how circulates by people moving between firms but offered apprenticeships go unfilled." .

pko-native-procedural-knowledge-rulebook:isClaimingUnbackedApproval a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsClaimingUnbackedApproval" ;
    rdfs:comment "TRUE when a template's Status says Approved but no properly-authorized approval record backs it. The phantom-approval witness." .

pko-native-procedural-knowledge-rulebook:isClassRemovalOrRename a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ModelChangeLogEntries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsClassRemovalOrRename" ;
    rdfs:comment "TRUE when a class is removed or renamed." .

pko-native-procedural-knowledge-rulebook:isClean a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsClean" ;
    rdfs:comment "TRUE when this execution passed verification, deviated from nothing, left no open issue, and finished on time." .

pko-native-procedural-knowledge-rulebook:isCleanlyRetired a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCleanlyRetired" ;
    rdfs:comment "An unstewarded version that nothing depends on — a genuine, safe retirement." .

pko-native-procedural-knowledge-rulebook:isClearanceByUnfalsifiedControl a owl:DatatypeProperty ;
    rdfs:domain pko:RequirementSatisfaction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsClearanceByUnfalsifiedControl" ;
    rdfs:comment "TRUE when this record cleared a step against a blocking control that has never produced a negative outcome." .

pko-native-procedural-knowledge-rulebook:isClearedToSend a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SendIntent ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsClearedToSend" ;
    rdfs:comment "TRUE only when all four gates pass. THE single column the pipeline reads before transmitting." .

pko-native-procedural-knowledge-rulebook:isColocatedTrade a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CommunityOfPractice ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsColocatedTrade" ;
    rdfs:comment "TRUE when the trade is concentrated in one place." .

pko-native-procedural-knowledge-rulebook:isCommitmentWithoutRationale a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcessDesignDecision ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCommitmentWithoutRationale" ;
    rdfs:comment "TRUE when a procedure commitment was recorded with no reason behind it." .

pko-native-procedural-knowledge-rulebook:isCommunicationallyStranded a owl:DatatypeProperty ;
    rdfs:domain pko-extension:Recipient ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCommunicationallyStranded" ;
    rdfs:comment "TRUE when every channel we hold for this person is either non-consenting or unreachable, so no lawful route exists at all." .

pko-native-procedural-knowledge-rulebook:isComplete a owl:DatatypeProperty ;
    rdfs:domain pko-extension:WitnessLoop ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsComplete" ;
    rdfs:comment "TRUE once the loop has been committed." .

pko-native-procedural-knowledge-rulebook:isCompleted a owl:DatatypeProperty ;
    rdfs:domain pko:StepExecution ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCompleted" ;
    rdfs:comment "TRUE when this step execution reached a completed state." .

pko-native-procedural-knowledge-rulebook:isComplianceOnly a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CorporateGovernanceProgram ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsComplianceOnly" ;
    rdfs:comment "TRUE when a programme's scope is compliance and nothing else." .

pko-native-procedural-knowledge-rulebook:isCompositeWithoutChildren a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCompositeWithoutChildren" ;
    rdfs:comment "TRUE for a step declared MultiStep that has no sub-steps." .

pko-native-procedural-knowledge-rulebook:isCompoundFragile a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCompoundFragile" ;
    rdfs:comment "A fragment carrying at least three of the four decay signals at once." .

pko-native-procedural-knowledge-rulebook:isComputationallyQueryable a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeConsumerSystem ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsComputationallyQueryable" ;
    rdfs:comment "Whether the procedure knowledge this system holds can be queried structurally, rather than only opened and read by a person." .

pko-native-procedural-knowledge-rulebook:isComputationallyValidatable a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeConsumerSystem ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsComputationallyValidatable" ;
    rdfs:comment "Whether the procedure knowledge this system holds can be checked automatically against rules." .

pko-native-procedural-knowledge-rulebook:isComputedlyWitnessed a owl:DatatypeProperty ;
    rdfs:domain pko:RequirementSatisfaction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsComputedlyWitnessed" ;
    rdfs:comment "TRUE when this record scores a blocking control that has a computed witness behind it." .

pko-native-procedural-knowledge-rulebook:isConcentratedSingleWitness a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationSession ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConcentratedSingleWitness" ;
    rdfs:comment "One unrepeated session with one witness that underwrites three or more live claims." .

pko-native-procedural-knowledge-rulebook:isConflictingAccount a owl:DatatypeProperty ;
    rdfs:domain pko-extension:DepartmentProcessAccount ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConflictingAccount" ;
    rdfs:comment "TRUE when another department gives a contradicting account of the same process." .

pko-native-procedural-knowledge-rulebook:isConformant a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcessMiningRun ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConformant" ;
    rdfs:comment "TRUE when at least 80% of what actually happened matches what was documented." .

pko-native-procedural-knowledge-rulebook:isConsentViolation a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConsentViolation" ;
    rdfs:comment "TRUE when a message was actually transmitted on a consent-required channel to a recipient without consent. This is the TCPA witness." .

pko-native-procedural-knowledge-rulebook:isConsistent a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ReasonerRun ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConsistent" ;
    rdfs:comment "Whether the reasoner found the snapshot consistent." .

pko-native-procedural-knowledge-rulebook:isContentWithoutOrganization a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Resources ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsContentWithoutOrganization" ;
    rdfs:comment "TRUE when a resource has content but is not typed by the artifact scheme, has no keywords to be found by, or is linked to no procedure or step." .

pko-native-procedural-knowledge-rulebook:isContested a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ClaimEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsContested" ;
    rdfs:comment "TRUE when the evidence field is disputed by a graded substrate." .

pko-native-procedural-knowledge-rulebook:isContextSensitiveButUnscoped a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsContextSensitiveButUnscoped" ;
    rdfs:comment "TRUE when the step's significance depends on context and some such dependency says nowhere where it holds." .

pko-native-procedural-knowledge-rulebook:isContinuous a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernanceStageControl ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsContinuous" ;
    rdfs:comment "Runs continuously rather than as a one-off or batch." .

pko-native-procedural-knowledge-rulebook:isContinuousPipelineStage a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GovernanceStageControl ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsContinuousPipelineStage" ;
    rdfs:comment "TRUE for a collection, organization or encoding stage that runs continuously." .

pko-native-procedural-knowledge-rulebook:isControlledForEveryNonAdmin a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RulebookTable ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsControlledForEveryNonAdmin" ;
    rdfs:comment "Every non-administrator who can reach this table reaches it through a policy that cuts rows. The table is not merely policed; access to it is controlled." .

pko-native-procedural-knowledge-rulebook:isCoverageGap a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeAuditItem ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCoverageGap" ;
    rdfs:comment "TRUE when the client falls short and no provider available to it holds the knowledge either." .

pko-native-procedural-knowledge-rulebook:isCovered a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ArticleClaim ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCovered" ;
    rdfs:comment "TRUE when at least one evidence row meets the bar." .

pko-native-procedural-knowledge-rulebook:isCrossFirmPracticeCluster a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CommunityOfPractice ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCrossFirmPracticeCluster" ;
    rdfs:comment "TRUE when members from several firms share practice, people move between firms, and specialists are at hand." .

pko-native-procedural-knowledge-rulebook:isCrossFunctionExpansion a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelExpansionRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCrossFunctionExpansion" ;
    rdfs:comment "TRUE when a function other than the domain owner wants its workflows in the model." .

pko-native-procedural-knowledge-rulebook:isCrossOrganizationGrant a owl:DatatypeProperty ;
    rdfs:domain pko-extension:PrincipalAssignment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCrossOrganizationGrant" ;
    rdfs:comment "True when a user is allowed to act as a principal in a different organization. Legitimate for shared-service roles, but it crosses the tenancy boundary and should be deliberate rather than accidental." .

pko-native-procedural-knowledge-rulebook:isCrossSchemeDuplicatePref a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:TermLabelVariants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCrossSchemeDuplicatePref" ;
    rdfs:comment "TRUE when the same concern is defined as a separate preferred concept in more than one scheme instead of being shared." .

pko-native-procedural-knowledge-rulebook:isCurrent a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrent" .

pko-native-procedural-knowledge-rulebook:isCurrentAssignment a owl:DatatypeProperty ;
    rdfs:domain pko-extension:StewardshipAssignment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrentAssignment" ;
    rdfs:comment "TRUE when this stewardship assignment is in force right now." .

pko-native-procedural-knowledge-rulebook:isCurrentHumanAccountability a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AiAgentAccountability ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrentHumanAccountability" ;
    rdfs:comment "TRUE for an accountability in force that names a human person." .

pko-native-procedural-knowledge-rulebook:isCurrentWithoutMotivation a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrentWithoutMotivation" ;
    rdfs:comment "TRUE for a current version that never recorded why it was created." .

pko-native-procedural-knowledge-rulebook:isCurrentlyBinding a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AuthorityBoundary ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrentlyBinding" ;
    rdfs:comment "TRUE when this boundary is approved and inside its valid-time window right now." .

pko-native-procedural-knowledge-rulebook:isCurrentlyValid a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrentlyValid" .

pko-native-procedural-knowledge-rulebook:isDanglingInput a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:StepVariables ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDanglingInput" ;
    rdfs:comment "TRUE for an input no earlier step produces and nobody declared as external: the step cannot be run as specified." .

pko-native-procedural-knowledge-rulebook:isDecided a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ChangeRequest ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDecided" ;
    rdfs:comment "TRUE when a decision timestamp has been recorded." .

pko-native-procedural-knowledge-rulebook:isDecidedByRequiredRole a owl:DatatypeProperty ;
    rdfs:domain pko-extension:TemplateApproval ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDecidedByRequiredRole" ;
    rdfs:comment "TRUE when the approving role matches the role the policy designates." .

pko-native-procedural-knowledge-rulebook:isDeclaredCurrentRelease a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDeclaredCurrentRelease" ;
    rdfs:comment "TRUE for the release the model is currently declared at." .

pko-native-procedural-knowledge-rulebook:isDeclaredFallbackStep a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDeclaredFallbackStep" ;
    rdfs:comment "TRUE for the step its version declares as its fallback step." .

pko-native-procedural-knowledge-rulebook:isDeclaredFirstStep a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDeclaredFirstStep" ;
    rdfs:comment "TRUE for the step its version declares as its first step." .

pko-native-procedural-knowledge-rulebook:isDecompositionRung a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ConceptLadderRung ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDecompositionRung" ;
    rdfs:comment "TRUE for a rung below the action: a subprocess or condition that makes it up." .

pko-native-procedural-knowledge-rulebook:isDecorativeControl a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDecorativeControl" ;
    rdfs:comment "TRUE for a blocking requirement that is not attached to any step at all." .

pko-native-procedural-knowledge-rulebook:isDefault a owl:DatatypeProperty ;
    rdfs:domain pko-extension:PrincipalAssignment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDefault" ;
    rdfs:comment "True for the principal selected when the user does not name one." .

pko-native-procedural-knowledge-rulebook:isDefensible a owl:DatatypeProperty ;
    rdfs:domain pko-extension:DeliveredCommunication ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDefensible" ;
    rdfs:comment "TRUE when this delivery can be defended in a dispute: authorized, unaltered, and approved beforehand." .

pko-native-procedural-knowledge-rulebook:isDefined a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RelationType ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDefined" ;
    rdfs:comment "TRUE once ratified; FALSE for a proposed type." .

pko-native-procedural-knowledge-rulebook:isDegenerateView a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RoleSchemaView ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDegenerateView" ;
    rdfs:comment "True when the view exposes zero columns -- an emitted view that cannot be selected from. A generator that emits this has produced invalid DDL." .

pko-native-procedural-knowledge-rulebook:isDelegatedToUnfitSource a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDelegatedToUnfitSource" ;
    rdfs:comment "TRUE when the plan is to replace the know-how from public references or AI generation although it is not in public references." .

pko-native-procedural-knowledge-rulebook:isDelivered a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeDeliverable ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDelivered" ;
    rdfs:comment "TRUE once delivered." .

pko-native-procedural-knowledge-rulebook:isDemonstratedHumanGate a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDemonstratedHumanGate" ;
    rdfs:comment "A human gate that software has actually reached and that a human nevertheless held." .

pko-native-procedural-knowledge-rulebook:isDependencyInvisibleToChange a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CollectedSourceMaterial ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDependencyInvisibleToChange" ;
    rdfs:comment "TRUE when the material was encoded into a model but no trace records what rests on it, so a change to it reveals nothing." .

pko-native-procedural-knowledge-rulebook:isDeployedOnUngovernedGraph a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AgentIntegration ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDeployedOnUngovernedGraph" ;
    rdfs:comment "TRUE when an AI agent is deployed against a graph snapshot nobody governs." .

pko-native-procedural-knowledge-rulebook:isDerived a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RulebookField ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDerived" ;
    rdfs:comment "TRUE when this field is computed rather than stored." .

pko-native-procedural-knowledge-rulebook:isDetachedFromTaxonomy a owl:DatatypeProperty ;
    rdfs:domain pko:ProcedureType ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDetachedFromTaxonomy" ;
    rdfs:comment "TRUE when a node below domain rank has no broader node." .

pko-native-procedural-knowledge-rulebook:isDevMinted a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:IssuedTokens ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDevMinted" ;
    rdfs:comment "True when issued by the local dev minter rather than a real magic-links tenant. Dev tokens are genuine RS256 tokens with a genuine keypair; they simply skip the email round-trip." .

pko-native-procedural-knowledge-rulebook:isDeviationOnlyFacility a owl:DatatypeProperty ;
    rdfs:domain pko-industry:Site ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDeviationOnlyFacility" ;
    rdfs:comment "TRUE when every recorded execution at this facility deviated, while the procedure is run cleanly elsewhere." .

pko-native-procedural-knowledge-rulebook:isDeviationUnexplainedByPeople a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcessMiningRun ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDeviationUnexplainedByPeople" ;
    rdfs:comment "TRUE when mining found non-conforming variants and no capture from experienced workers explains them." .

pko-native-procedural-knowledge-rulebook:isDisconnectedFromOutcomes a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDisconnectedFromOutcomes" ;
    rdfs:comment "TRUE for a current, executed version no operational outcome is linked to." .

pko-native-procedural-knowledge-rulebook:isDisconnectedPromptKnowledge a owl:DatatypeProperty ;
    rdfs:domain pko-extension:PromptTemplate ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDisconnectedPromptKnowledge" ;
    rdfs:comment "TRUE when a prompt carries procedure instructions that exist in no procedure version of the model." .

pko-native-procedural-knowledge-rulebook:isDisconnectedSilo a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcedureLensView ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDisconnectedSilo" ;
    rdfs:comment "TRUE when a view is not projected from the procedure's current version: a free-standing copy that will drift apart." .

pko-native-procedural-knowledge-rulebook:isDiscriminating a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RulebookField ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDiscriminating" ;
    rdfs:comment "TRUE when the field takes at least two distinct values over the seed data, so it can tell rows apart. An all-true or all-false witness states nothing." .

pko-native-procedural-knowledge-rulebook:isDiscussionInAuthoritativeModel a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelAnnotation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDiscussionInAuthoritativeModel" ;
    rdfs:comment "TRUE when a comment, question, suggestion or alternative reading was written into the authoritative rulebook." .

pko-native-procedural-knowledge-rulebook:isDissentingViewNotKeptWithSource a owl:DatatypeProperty ;
    rdfs:domain pko-extension:StakeholderPerspective ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDissentingViewNotKeptWithSource" ;
    rdfs:comment "TRUE when a conflicting view was overridden into one version or kept without the source it comes from." .

pko-native-procedural-knowledge-rulebook:isDmnEncoded a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:DecisionPoints ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDmnEncoded" ;
    rdfs:comment "TRUE when the decision is encoded as a DMN decision." .

pko-native-procedural-knowledge-rulebook:isDocumentOrigin a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDocumentOrigin" ;
    rdfs:comment "TRUE when the knowledge was first taken from a document." .

pko-native-procedural-knowledge-rulebook:isDocumentSource a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CollectedSourceMaterial ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDocumentSource" ;
    rdfs:comment "TRUE for an excerpt of existing written material." .

pko-native-procedural-knowledge-rulebook:isDocumentStartNeverExtended a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDocumentStartNeverExtended" ;
    rdfs:comment "TRUE when a step taken from a document has never been extended by capture from people." .

pko-native-procedural-knowledge-rulebook:isDocumentStartNeverValidated a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDocumentStartNeverValidated" ;
    rdfs:comment "TRUE when a step taken from a document has never been confirmed by capture from people." .

pko-native-procedural-knowledge-rulebook:isDocumentTrailingPractice a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:KnowledgeTraces ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDocumentTrailingPractice" ;
    rdfs:comment "TRUE when practice evidence collected after the document's last revision contradicts it." .

pko-native-procedural-knowledge-rulebook:isDocumentedBehindPractice a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDocumentedBehindPractice" ;
    rdfs:comment "TRUE when the version's documentation trails how the work is performed." .

pko-native-procedural-knowledge-rulebook:isDraftKind a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AgentDecisionRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDraftKind" ;
    rdfs:comment "TRUE when this decision produced text — the drafter's own output class." .

pko-native-procedural-knowledge-rulebook:isDriftOnLiveVersion a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcessMiningRun ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDriftOnLiveVersion" ;
    rdfs:comment "TRUE when a major, real, mined deviation exists against a procedure version people are actually executing right now." .

pko-native-procedural-knowledge-rulebook:isDriftWatchLapsed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelCharter ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDriftWatchLapsed" ;
    rdfs:comment "TRUE when the steward of a charter in force has not watched for drift in more than ninety days." .

pko-native-procedural-knowledge-rulebook:isDriftedFromPractice a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDriftedFromPractice" ;
    rdfs:comment "TRUE when practice deviates from the step repeatedly, or deviates where practitioners flagged the guidance outdated." .

pko-native-procedural-knowledge-rulebook:isDriftedSend a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDriftedSend" ;
    rdfs:comment "TRUE when a message was transmitted from a template that was not validly sendable at the time. The drift witness." .

pko-native-procedural-knowledge-rulebook:isEmailReachable a owl:DatatypeProperty ;
    rdfs:domain pko-extension:Recipient ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEmailReachable" ;
    rdfs:comment "TRUE when a corporate email address is on file for this recipient." .

pko-native-procedural-knowledge-rulebook:isEmptySchema a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RoleSchema ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEmptySchema" ;
    rdfs:comment "True when the schema exposes no views, so the principal can read nothing at all." .

pko-native-procedural-knowledge-rulebook:isEnabled a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AppUser ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEnabled" ;
    rdfs:comment "False disables sign-in without deleting the identity or its history." .

pko-native-procedural-knowledge-rulebook:isEndedWithNoStewardNamed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:OntologySupportProgramme ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEndedWithNoStewardNamed" ;
    rdfs:comment "The programme has ended and this organization has named nobody to maintain what it took from it." .

pko-native-procedural-knowledge-rulebook:isEndingSoonWithNoStewardNamed a owl:DatatypeProperty ;
    rdfs:domain pko-extension:OntologySupportProgramme ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEndingSoonWithNoStewardNamed" ;
    rdfs:comment "The programme has not ended yet, ends within six months of the modelled instant, and nobody here has been named to maintain what we took from it. This is the window in which something can still be done about it." .

pko-native-procedural-knowledge-rulebook:isEnforcementRole a owl:DatatypeProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEnforcementRole" ;
    rdfs:comment "Whether this role's function is to enforce controls on other agents' actions." .

pko-native-procedural-knowledge-rulebook:isEntryStep a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEntryStep" ;
    rdfs:comment "No transition leads into this step: the procedure version starts here." .

pko-native-procedural-knowledge-rulebook:isErrorCorrection a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AgentDecisionRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsErrorCorrection" ;
    rdfs:comment "TRUE when the override corrected something I got wrong." .

pko-native-procedural-knowledge-rulebook:isEvidenceRequired a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEvidenceRequired" ;
    rdfs:comment "TRUE when we are still obliged to hold this message's text." .

pko-native-procedural-knowledge-rulebook:isEvidencedHoldingControl a owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEvidencedHoldingControl" ;
    rdfs:comment "TRUE for a witness that has never fired across a sample large enough for that to constitute evidence." .

pko-native-procedural-knowledge-rulebook:isExecutedWithoutFeedbackLoop a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExecutedWithoutFeedbackLoop" ;
    rdfs:comment "TRUE when the procedure is executed and nothing from execution was written back into its documentation." .

pko-native-procedural-knowledge-rulebook:isExecutionFeedback a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeRepositoryEntry ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExecutionFeedback" ;
    rdfs:comment "TRUE when the entry wrote back what an execution taught." .

pko-native-procedural-knowledge-rulebook:isExhaustedFollowUp a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExhaustedFollowUp" ;
    rdfs:comment "TRUE when I have sent three or more reminders and still have no acknowledgement -- the point at which this stops being my work and becomes a human escalation." .

pko-native-procedural-knowledge-rulebook:isExpertAuthoredConforming a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AuthoringSubmission ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExpertAuthoredConforming" ;
    rdfs:comment "TRUE when a domain expert with no ontology training produced a submission that conforms to the profile." .

pko-native-procedural-knowledge-rulebook:isExpiringSinglePointOfFailure a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExpiringSinglePointOfFailure" ;
    rdfs:comment "A single-sourced, operationally relied-upon claim that is also past its review date." .

pko-native-procedural-knowledge-rulebook:isExplicitlyGroundedRecommendation a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AssistantAnswer ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExplicitlyGroundedRecommendation" ;
    rdfs:comment "TRUE for a recommendation that names at least one piece of the organization's explicit process knowledge." .

pko-native-procedural-knowledge-rulebook:isExtension a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RulebookTable ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExtension" ;
    rdfs:comment "True when this table is an ERB extension rather than a native/aligned PKO term." .

pko-native-procedural-knowledge-rulebook:isExternalInput a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:StepVariables ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExternalInput" ;
    rdfs:comment "TRUE for an input supplied from outside the procedure." .

pko-native-procedural-knowledge-rulebook:isExternalMember a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CommunityMembership ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExternalMember" ;
    rdfs:comment "TRUE when the member works for a different organization than the community's host." .

pko-native-procedural-knowledge-rulebook:isExtractiveRelationship a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourceRelationship ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExtractiveRelationship" ;
    rdfs:comment "TRUE when trust is not established and no trust-building practice is recorded." .

pko-native-procedural-knowledge-rulebook:isFabricatedAcknowledgement a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFabricatedAcknowledgement" ;
    rdfs:comment "TRUE when an acknowledgement is recorded for a recipient we could not reach. This is the misrepresentation witness." .

pko-native-procedural-knowledge-rulebook:isFailedDelivery a owl:DatatypeProperty ;
    rdfs:domain pko-extension:MessageDelivery ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFailedDelivery" ;
    rdfs:comment "TRUE when the message left our systems but did not land." .

pko-native-procedural-knowledge-rulebook:isFailedPrecondition a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ConditionCheck ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFailedPrecondition" ;
    rdfs:comment "TRUE when a precondition did not hold." .

pko-native-procedural-knowledge-rulebook:isFailing a owl:DatatypeProperty ;
    rdfs:domain pko-extension:TestCase ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFailing" ;
    rdfs:comment "TRUE when the last run failed. A blocking failure means the model is asserting something false." .

pko-native-procedural-knowledge-rulebook:isFailureWithoutLandedRedesign a owl:DatatypeProperty ;
    rdfs:domain pko:IssueOccurrence ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFailureWithoutLandedRedesign" ;
    rdfs:comment "TRUE when a recorded failure has no redesign, or its redesign never landed." .

pko-native-procedural-knowledge-rulebook:isFiledAtWrongLevel a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcessLevelStatement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFiledAtWrongLevel" ;
    rdfs:comment "TRUE when a statement answers a question its level does not answer in the pyramid." .

pko-native-procedural-knowledge-rulebook:isFitToExecute a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFitToExecute" ;
    rdfs:comment "TRUE when this version is approved, current on review, and carries no open change request or high-severity gap." .

pko-native-procedural-knowledge-rulebook:isFlattenedToBrittleRule a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFlattenedToBrittleRule" ;
    rdfs:comment "TRUE when tacit or situated knowledge was encoded as a hard rule with no conditions saying when it holds." .

pko-native-procedural-knowledge-rulebook:isForeignVariable a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ExecutionEntities ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsForeignVariable" ;
    rdfs:comment "TRUE when the entity corresponds to a variable another step declares." .

pko-native-procedural-knowledge-rulebook:isFormalizedWithoutElicitationWork a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeHolding ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFormalizedWithoutElicitationWork" ;
    rdfs:comment "TRUE when knowledge was formalized into a fragment that no observation, interview or other elicitation produced." .

pko-native-procedural-knowledge-rulebook:isFresh a owl:DatatypeProperty ;
    rdfs:domain pko-extension:OperationalBinding ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFresh" ;
    rdfs:comment "TRUE when within freshness SLA." .

pko-native-procedural-knowledge-rulebook:isFrictionWithoutGap a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ModelAnnotation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFrictionWithoutGap" ;
    rdfs:comment "TRUE when friction from missing knowledge was reported and never recorded as a knowledge gap." .

pko-native-procedural-knowledge-rulebook:isFromOwnKnowledge a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:AnswerGroundings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFromOwnKnowledge" ;
    rdfs:comment "TRUE when the grounding is the organization's own assertion or segment." .

pko-native-procedural-knowledge-rulebook:isFromSingleWitness a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFromSingleWitness" ;
    rdfs:comment "Whether this claim rests on a single practitioner's account." .

pko-native-procedural-knowledge-rulebook:isFrozenDespiteNewCollection a owl:DatatypeProperty ;
    rdfs:domain pko-extension:Vocabulary ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFrozenDespiteNewCollection" ;
    rdfs:comment "TRUE when material collected after the scheme was established has never led to a refinement." .

pko-native-procedural-knowledge-rulebook:isFullWidth a owl:DatatypeProperty ;
    rdfs:domain pko-extension:RoleSchemaView ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFullWidth" ;
    rdfs:comment "True when every field on the table is exposed, so the horizontal cut removes nothing." .

pko-native-procedural-knowledge-rulebook:isFullyConformant a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFullyConformant" .

pko-native-procedural-knowledge-rulebook:isFullyCovered a owl:DatatypeProperty ;
    rdfs:domain pko-extension:SourceArticle ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFullyCovered" ;
    rdfs:comment "TRUE when every claim in this article is covered." .

pko-native-procedural-knowledge-rulebook:isFullySampled a owl:DatatypeProperty ;
    rdfs:domain pko-extension:FieldDisagreement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFullySampled" ;
    rdfs:comment "True when every failing cell is recorded, not just a sample." .

pko-native-procedural-knowledge-rulebook:isFullySatisfied a owl:DatatypeProperty ;
    rdfs:domain pko:RequirementSatisfaction ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFullySatisfied" ;
    rdfs:comment "TRUE only when the requirement is recorded as fully Satisfied. PartiallySatisfied, Unsatisfied, Waived, and blank are all FALSE." .

pko-native-procedural-knowledge-rulebook:isGainOutsideProceduralScope a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeOutcomeMeasurement ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGainOutsideProceduralScope" ;
    rdfs:comment "TRUE for an efficiency gain measured on knowledge that is not about procedures." .

pko-native-procedural-knowledge-rulebook:isGateBypassedPublication a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGateBypassedPublication" ;
    rdfs:comment "A publication step the procedure can reach without human sign-off: the approval gate is structurally bypassable." .

pko-native-procedural-knowledge-rulebook:isGatekeepingOrSabotage a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeGap ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGatekeepingOrSabotage" ;
    rdfs:comment "TRUE for a gap caused by gatekeeping or knowledge sabotage." .

pko-native-procedural-knowledge-rulebook:isGenericOrUnskilledCapture a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ElicitationSession ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGenericOrUnskilledCapture" ;
    rdfs:comment "TRUE when a session captured knowledge with a method outside the elicitation family or without a skilled elicitor running it." .

pko-native-procedural-knowledge-rulebook:isGenuinelyOverdue a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeFragment ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGenuinelyOverdue" ;
    rdfs:comment "A valid claim whose LAST ACTUAL REVIEW is older than the cadence its owning version promised." .

pko-native-procedural-knowledge-rulebook:isGoverned a owl:DatatypeProperty ;
    rdfs:domain pko-extension:GroundingSnapshot ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGoverned" ;
    rdfs:comment "TRUE when the snapshot has a steward and was reviewed before it was served." .

pko-native-procedural-knowledge-rulebook:isGovernedByLapsedAuthority a owl:DatatypeProperty ;
    rdfs:domain pro:Role ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGovernedByLapsedAuthority" ;
    rdfs:comment "TRUE when at least one constraint on this role rests on knowledge that is no longer valid." .

pko-native-procedural-knowledge-rulebook:isGovernedByUnwarrantedBoundary a owl:DatatypeProperty ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGovernedByUnwarrantedBoundary" ;
    rdfs:comment "Whether this step's constraints on machine authority rest on a claim that is no longer valid." .

pko-native-procedural-knowledge-rulebook:isGraded a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ConformanceSubstrate ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGraded" ;
    rdfs:comment "True for substrates the harness scores." .

pko-native-procedural-knowledge-rulebook:isGranularityMisfit a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ProcedureLensView ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGranularityMisfit" ;
    rdfs:comment "TRUE when a view is coarser or finer than its lens's use requires." .

pko-native-procedural-knowledge-rulebook:isGreen a owl:DatatypeProperty ;
    rdfs:domain pko-extension:TestSuite ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGreen" ;
    rdfs:comment "TRUE when no blocking check is failing. Advisory warnings do not break the board." .

pko-native-procedural-knowledge-rulebook:isHeldByCurrentPractitioner a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHeldByCurrentPractitioner" ;
    rdfs:comment "TRUE when a person who still holds a role carries the know-how." .

pko-native-procedural-knowledge-rulebook:isHeldByDepartedHolder a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHeldByDepartedHolder" ;
    rdfs:comment "TRUE when the person who carried the know-how has left." .

pko-native-procedural-knowledge-rulebook:isHeldInBothForms a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHeldInBothForms" ;
    rdfs:comment "TRUE when the know-how is at once a written procedure and trained skill." .

pko-native-procedural-knowledge-rulebook:isHeldOnlyByDeparted a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHeldOnlyByDeparted" ;
    rdfs:comment "TRUE when the only carrier has left and the know-how was neither transferred nor captured." .

pko-native-procedural-knowledge-rulebook:isHeldUnfitByLandedDecisions a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHeldUnfitByLandedDecisions" ;
    rdfs:comment "A version reading unfit to execute specifically because approved changes have not been marked implemented." .

pko-native-procedural-knowledge-rulebook:isHeldWithoutCapture a owl:DatatypeProperty ;
    rdfs:domain pko-extension:CollectionOccasion ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHeldWithoutCapture" ;
    rdfs:comment "TRUE when the occasion was held and nothing it surfaced was collected." .

pko-native-procedural-knowledge-rulebook:isHeuristicOversimplified a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ExpertCognition ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHeuristicOversimplified" ;
    rdfs:comment "TRUE when an expert stated when a heuristic does not hold and the capture kept only the bare rule." .

