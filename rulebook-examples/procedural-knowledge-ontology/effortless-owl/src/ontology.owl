    rdfs:range xsd:string ;
    rdfs:label "DetectedBy" ;
    rdfs:comment "StewardReview, StalenessQuery, ValidationSuite or ExpertWrongAnswer." .

effortless-ntwf:driftKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DriftObservations ;
    rdfs:range xsd:string ;
    rdfs:label "DriftKind" ;
    rdfs:comment "PracticeMismatch, ScopeExpansion or DependencyChange." .

effortless-ntwf:driftCause a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DriftObservations ;
    rdfs:range xsd:string ;
