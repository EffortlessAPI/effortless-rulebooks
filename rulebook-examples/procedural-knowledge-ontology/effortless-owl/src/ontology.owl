    rdfs:domain effortless-ntwf:SourcingFunctions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsKnowledgeProcessOutsourcing" ;
    rdfs:comment "TRUE for expertise-heavy work performed by a provider, the kind that builds deep process knowledge." .
