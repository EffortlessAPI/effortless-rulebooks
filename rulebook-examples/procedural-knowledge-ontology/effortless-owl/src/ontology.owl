effortless-ntwf:ExecutionParticipants a owl:Class ;
    rdfs:label "ExecutionParticipants" ;
    rdfs:comment "Agents associated with a procedure execution besides its executor (prov:wasAssociatedWith)." .

effortless-ntwf:executionParticipantId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExecutionParticipants ;
    rdfs:range xsd:string ;
    rdfs:label "ExecutionParticipantId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:procedureExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "ProcedureExecution" ;
    rdfs:comment "Execution." .

effortless-ntwf:agent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "Agent" ;
