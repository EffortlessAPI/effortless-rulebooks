    rdfs:comment "Scheme the material was organized into." .

effortless-ntwf:organizedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:string ;
    rdfs:label "OrganizedAt" ;
    rdfs:comment "When it was organized." .

effortless-ntwf:encodedIntoVersion a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "EncodedIntoVersion" ;
    rdfs:comment "Version it was modeled into." .

effortless-ntwf:encodedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:string ;
    rdfs:label "EncodedAt" ;
    rdfs:comment "When it was modeled." .

effortless-ntwf:isModeledBeforeOrganized a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsModeledBeforeOrganized" ;
    rdfs:comment "TRUE when material was encoded into a procedure version before it was organized, or without ever being organized." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

effortless-ntwf:sourceDocument a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Resources ;
    rdfs:label "SourceDocument" ;
    rdfs:comment "The existing document the material was excerpted from." .

effortless-ntwf:sourceDocumentRevisedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:string ;
    rdfs:label "SourceDocumentRevisedAt" ;
    rdfs:comment "Last revision of that document." .
    # calculated: lookup

effortless-ntwf:isDocumentSource a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDocumentSource" ;
    rdfs:comment "TRUE for an excerpt of existing written material." .
    # calculated: calculated

effortless-ntwf:isPeopleCapture a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPeopleCapture" ;
    rdfs:comment "TRUE for material captured from people: a transcript or field notes." .
    # calculated: calculated

effortless-ntwf:isPracticeEvidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPracticeEvidence" ;
    rdfs:comment "TRUE for material that records the work as performed: field notes or a mined event trace." .
    # calculated: calculated

effortless-ntwf:holdsReasoningOrTacitKnowledge a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:boolean ;
    rdfs:label "HoldsReasoningOrTacitKnowledge" ;
    rdfs:comment "TRUE when the material holds the reasoning or tacit knowledge behind the actions, not only the actions." .

effortless-ntwf:complementsMiningRun a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range effortless-ntwf:ProcessMiningRuns ;
    rdfs:label "ComplementsMiningRun" ;
    rdfs:comment "The mining run whose findings this capture from people explains." .

effortless-ntwf:capturedDuringExecution a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "CapturedDuringExecution" ;
    rdfs:comment "The execution during which the material was captured, when captured in the course of work." .

effortless-ntwf:isCapturedInFlowOfWork a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCapturedInFlowOfWork" ;
    rdfs:comment "TRUE when the material was captured while the work was being done." .
    # calculated: calculated

effortless-ntwf:collectedAtOccasion a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range effortless-ntwf:CollectionOccasions ;
    rdfs:label "CollectedAtOccasion" ;
    rdfs:comment "The recurring occasion at which the material was collected." .

effortless-ntwf:promptedByFeedback a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range effortless-ntwf:UserFeedback ;
    rdfs:label "PromptedByFeedback" ;
    rdfs:comment "The practitioner feedback that prompted this collection." .

effortless-ntwf:producedByMethodApplication a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range effortless-ntwf:MethodApplications ;
    rdfs:label "ProducedByMethodApplication" ;
    rdfs:comment "The method application that produced the material." .

effortless-ntwf:contributingExpert a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ContributingExpert" ;
    rdfs:comment "The domain expert whose time the capture consumed." .

effortless-ntwf:expertEffortHours a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:string ;
    rdfs:label "ExpertEffortHours" ;
    rdfs:comment "Hours of expert time the capture consumed." .

effortless-ntwf:dependentTraceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:integer ;
    rdfs:label "DependentTraceCount" ;
    rdfs:comment "Organized knowledge traced to this material." .
    # calculated: aggregation

effortless-ntwf:isDependencyInvisibleToChange a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDependencyInvisibleToChange" ;
    rdfs:comment "TRUE when the material was encoded into a model but no trace records what rests on it, so a change to it reveals nothing." .
    # calculated: calculated

effortless-ntwf:changedDependentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:integer ;
    rdfs:label "ChangedDependentCount" ;
    rdfs:comment "Traced knowledge taken before the source document was last revised." .
    # calculated: aggregation

effortless-ntwf:hasKnowledgeAffectedBySourceChange a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CollectedSourceMaterials ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasKnowledgeAffectedBySourceChange" ;
    rdfs:comment "TRUE when a revision of the source affects organized knowledge taken from it." .
    # calculated: calculated

# === Class: CollectionOccasions ===
effortless-ntwf:CollectionOccasions a owl:Class ;
