# === Class: ProcessDesignDecisions ===
effortless-ntwf:ProcessDesignDecisions a owl:Class ;
    rdfs:label "ProcessDesignDecisions" ;
    rdfs:comment "Design decisions behind a procedure's commitments, recorded alongside the procedure with their rationale." .

effortless-ntwf:processDesignDecisionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessDesignDecisions ;
    rdfs:range xsd:string ;
    rdfs:label "ProcessDesignDecisionId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Version." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Step the commitment is on." .

effortless-ntwf:decision a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Decision" ;
    rdfs:comment "The commitment." .

effortless-ntwf:rationale a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Rationale" ;
    rdfs:comment "Why." .

effortless-ntwf:decidedByAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "DecidedByAgent" ;
    rdfs:comment "Who decided." .

effortless-ntwf:decidedAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DecidedAt" ;
    rdfs:comment "When decided." .

effortless-ntwf:recordedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessDesignDecisions ;
    rdfs:range xsd:string ;
    rdfs:label "RecordedAt" ;
    rdfs:comment "When written down." .

effortless-ntwf:isCommitmentWithoutRationale a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessDesignDecisions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCommitmentWithoutRationale" ;
    rdfs:comment "TRUE when a procedure commitment was recorded with no reason behind it." .
    # calculated: calculated

effortless-ntwf:daysBeforeRecorded a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessDesignDecisions ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysBeforeRecorded" ;
    rdfs:comment "Days between deciding and writing the decision down." .
    # calculated: calculated

effortless-ntwf:isRecordedAfterTheFact a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessDesignDecisions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRecordedAfterTheFact" ;
    rdfs:comment "TRUE when a decision was written down more than thirty days after it was made, so its why was reconstructed from memory." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ProcessInterdependencies ===
effortless-ntwf:ProcessInterdependencies a owl:Class ;
    rdfs:label "ProcessInterdependencies" ;
    rdfs:comment "How one operation helps, hinders or requires another." .

effortless-ntwf:processInterdependencyId a owl:DatatypeProperty ;
