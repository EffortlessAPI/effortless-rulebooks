pko-native-procedural-knowledge-rulebook:customizationType a owl:DatatypeProperty ;
    rdfs:domain pko-native-procedural-knowledge-rulebook:ERBCustomizations ;
    rdfs:range xsd:string ;
    rdfs:label "CustomizationType" ;
    rdfs:comment "Customization category." .

pko-native-procedural-knowledge-rulebook:dangerCueCount a owl:DatatypeProperty ;
