# === Class: KnowledgeQueryDefinitions ===
effortless-ntwf:KnowledgeQueryDefinitions a owl:Class ;
    rdfs:label "KnowledgeQueryDefinitions" ;
    rdfs:comment "Structured queries (SPARQL or SQL) run over the knowledge, with the layers and sources they touch." .

effortless-ntwf:knowledgeQueryDefinitionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeQueryDefinitions ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeQueryDefinitionId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "The question the query answers." .

effortless-ntwf:queryLanguage a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "QueryLanguage" ;
    rdfs:comment "SPARQL or SQL." .

effortless-ntwf:queryText a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "QueryText" ;
    rdfs:comment "The query, abridged." .

effortless-ntwf:targetProcedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "TargetProcedureVersion" ;
    rdfs:comment "Version queried." .

effortless-ntwf:needsOntologyAndInstances a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeQueryDefinitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "NeedsOntologyAndInstances" ;
    rdfs:comment "TRUE when the question can only be answered by combining class definitions with instance data." .

effortless-ntwf:traversesOntologyLayer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeQueryDefinitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "TraversesOntologyLayer" ;
    rdfs:comment "TRUE when the query walks class or property definitions." .

effortless-ntwf:traversesInstanceLayer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeQueryDefinitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "TraversesInstanceLayer" ;
    rdfs:comment "TRUE when the query walks instance data." .

effortless-ntwf:ranOverConsolidatedCopy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeQueryDefinitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "RanOverConsolidatedCopy" ;
    rdfs:comment "TRUE when the sources were first copied into one store to run the query." .

effortless-ntwf:lastRunAt a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "LastRunAt" ;
    rdfs:comment "When last run." .

effortless-ntwf:sourceSystemCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeQueryDefinitions ;
    rdfs:range xsd:integer ;
    rdfs:label "SourceSystemCount" ;
    rdfs:comment "Knowledge systems the query reads." .
    # calculated: aggregation

effortless-ntwf:missesALayer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeQueryDefinitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "MissesALayer" ;
    rdfs:comment "TRUE when a question that needs ontology and instances together is answered by a query that walks only one of them." .
    # calculated: calculated

effortless-ntwf:consolidatedDistributedSources a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeQueryDefinitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ConsolidatedDistributedSources" ;
    rdfs:comment "TRUE when a query over several knowledge systems only ran after copying them into one store." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

