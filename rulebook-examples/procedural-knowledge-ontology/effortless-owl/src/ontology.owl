    rdfs:domain pko:RequirementSatisfaction ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasWrittenEvidence" ;
    rdfs:comment "TRUE when this satisfaction record carries any evidence text at all." .

pko-native-procedural-knowledge-rulebook:held a owl:DatatypeProperty ;
    rdfs:domain pko-extension:ConditionCheck ;
    rdfs:range xsd:boolean ;
    rdfs:label "Held" ;
    rdfs:comment "Whether the condition held." .

pko-native-procedural-knowledge-rulebook:heldInternalLevel a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeAuditItem ;
    rdfs:range xsd:integer ;
    rdfs:label "HeldInternalLevel" ;
    rdfs:comment "Level the client's own people hold, on the same scale." .

pko-native-procedural-knowledge-rulebook:heldSince a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowHowCarrier ;
    rdfs:range xsd:dateTime ;
    rdfs:label "HeldSince" ;
    rdfs:comment "When the carrier began to hold the know-how." .

pko-native-procedural-knowledge-rulebook:heldStepAtInstant a owl:DatatypeProperty ;
    rdfs:domain pko-extension:AssignmentInstantCheck ;
    rdfs:range xsd:boolean ;
    rdfs:label "HeldStepAtInstant" ;
    rdfs:comment "TRUE when this assignment held the step's role at the audited instant." .

pko-native-procedural-knowledge-rulebook:higherAccessFewerErrors a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeOutcomeMeasurement ;
    rdfs:range xsd:boolean ;
    rdfs:label "HigherAccessFewerErrors" ;
    rdfs:comment "TRUE when this team has better access to process knowledge than its baseline and fewer errors." .

pko-native-procedural-knowledge-rulebook:higherAccessMoreEfficient a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeOutcomeMeasurement ;
    rdfs:range xsd:boolean ;
    rdfs:label "HigherAccessMoreEfficient" ;
    rdfs:comment "TRUE when this team has better access than its baseline and takes fewer minutes per run." .

pko-native-procedural-knowledge-rulebook:higherAccessMoreSatisfied a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeOutcomeMeasurement ;
    rdfs:range xsd:boolean ;
    rdfs:label "HigherAccessMoreSatisfied" ;
    rdfs:comment "TRUE when this team has better access than its baseline and higher satisfaction." .

pko-native-procedural-knowledge-rulebook:higherIsBetter a owl:DatatypeProperty ;
    rdfs:domain pko-extension:KnowledgeTestOutcome ;
    rdfs:range xsd:boolean ;
    rdfs:label "HigherIsBetter" ;
