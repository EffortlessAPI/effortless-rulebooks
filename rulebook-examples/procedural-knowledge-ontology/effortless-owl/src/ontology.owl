effortless-ntwf:designsWhatItCannotBuild a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SourcingFunctions ;
    rdfs:range xsd:boolean ;
    rdfs:label "DesignsWhatItCannotBuild" ;
    rdfs:comment "TRUE when a product-delivering function is performed by a provider that keeps the documentation, the client's audited specification knowledge is complete, and its method knowledge falls short." .
