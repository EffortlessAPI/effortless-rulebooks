# === Class: ConceptLadderRungs ===
effortless-ntwf:ConceptLadderRungs a owl:Class ;
    rdfs:label "ConceptLadderRungs" ;
    rdfs:comment "Rungs of a concept ladder built around a concrete action: positive levels climb by asking why to the goals and values it serves, negative levels descend by asking how to its subprocesses and conditions." .

effortless-ntwf:conceptLadderRungId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConceptLadderRungs ;
    rdfs:range xsd:string ;
    rdfs:label "ConceptLadderRungId" ;
    rdfs:comment "Stored identifier." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Display name." .
    # calculated: calculated

effortless-ntwf:elicitationSession a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ElicitationSessions ;
    rdfs:label "ElicitationSession" ;
    rdfs:comment "The laddering session." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "The concrete action the ladder starts from." .

effortless-ntwf:ladderLevel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConceptLadderRungs ;
    rdfs:range xsd:integer ;
    rdfs:label "LadderLevel" ;
    rdfs:comment "Rung height: positive above the action, negative below." .

effortless-ntwf:rungKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConceptLadderRungs ;
    rdfs:range xsd:string ;
    rdfs:label "RungKind" ;
    rdfs:comment "Goal, Value, Subprocess or Condition." .

effortless-ntwf:statement a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Statement" ;
    rdfs:comment "The practitioner's answer at this rung." .

effortless-ntwf:stepTopLevel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConceptLadderRungs ;
    rdfs:range xsd:integer ;
    rdfs:label "StepTopLevel" ;
    rdfs:comment "The highest rung laddered from the same action." .
    # calculated: aggregation

effortless-ntwf:isUltimateGoal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConceptLadderRungs ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUltimateGoal" ;
    rdfs:comment "TRUE for the top rung above an action: the goal or value it ultimately serves." .
    # calculated: calculated

effortless-ntwf:isDecompositionRung a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConceptLadderRungs ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDecompositionRung" ;
    rdfs:comment "TRUE for a rung below the action: a subprocess or condition that makes it up." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

