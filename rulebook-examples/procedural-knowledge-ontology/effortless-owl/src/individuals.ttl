effortless-ntwf:q8-steward-lenses a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-steward-lenses" ;
    effortless-ntwf:roleQuestionId "q8-steward-lenses" ;
    effortless-ntwf:askingRole effortless-ntwf:process-steward ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Is each procedure organized for more than one stakeholder, and is every stakeholder's view projected from the one current specification rather than kept as a separate copy?" ;
    effortless-ntwf:whyItMatters "A procedure organized for auditors alone fails the trainer; an executive deck copied from the 2019 checklist silently contradicts the procedure it summarizes." ;
    effortless-ntwf:answerableBefore false ;
