    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c04 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ElicitationParticipants.IsPractitioner ;
    effortless-ntwf:justification "TRUE for participants who hold the process knowledge by doing the work: Tomas Reyes and Rosa Delgado in the lockout workshop, Amina Yusuf in the policy workshop." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

