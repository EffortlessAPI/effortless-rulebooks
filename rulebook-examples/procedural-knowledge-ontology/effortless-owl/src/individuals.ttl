    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Agents.LocatedKnowHowCount ;
    effortless-ntwf:justification "Counts know-how held by someone else that a broker can point seekers to. Lin knows that the Press 7 bleed-down know-how lives with Tomas without holding it herself: meta-knowledge of where process knowledge sits." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

