    effortless-ntwf:articleClaim effortless-ntwf:ont4-q21 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-ont4-q21 ;
    effortless-ntwf:justification "Asks which generated artifacts are attributed to each agent." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-q22-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-q22-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-q22-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-q22 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-ont4-q22 ;
    effortless-ntwf:justification "Asks which steps take as an input an artifact produced by an AI agent's step, naming the agent on each input." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-q23-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-q23-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-q23-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-q23 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-ont4-q23 ;
    effortless-ntwf:justification "Asks which role and agent are responsible for each step consuming an AI agent's artifact, and whether any such role is held by nobody." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

