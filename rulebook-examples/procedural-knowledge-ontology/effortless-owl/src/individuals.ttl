    effortless-ntwf:priorMeaningSince "2024-01-15T15:00:00+00:00"^^xsd:dateTime ;
    effortless-ntwf:changedAt "2026-01-02T15:00:00+00:00"^^xsd:dateTime ;
    effortless-ntwf:priorMeaning "A tagged build copied to production by an engineer." ;
    effortless-ntwf:newMeaning "A risk-classified change passed through the human release gate and rolled out by the pipeline." ;
    effortless-ntwf:isStructuralChange true ;
    effortless-ntwf:recordedByAgent effortless-ntwf:grace-holloway ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#TermMeaningChange" .

effortless-ntwf:tmc-rollback-2026 a effortless-ntwf:TermMeaningChanges ;
    effortless-ntwf:__key "tmc-rollback-2026" ;
    effortless-ntwf:termMeaningChangeId "tmc-rollback-2026" ;
    effortless-ntwf:vocabularyTerm effortless-ntwf:vt-rollback ;
    effortless-ntwf:priorMeaningSince "2025-06-01T14:00:00+00:00"^^xsd:dateTime ;
    effortless-ntwf:changedAt "2026-03-01T15:00:00+00:00"^^xsd:dateTime ;
    effortless-ntwf:priorMeaning "Redeploying the previous build by hand." ;
    effortless-ntwf:newMeaning "Returning to the previous release automatically when health checks fail." ;
    effortless-ntwf:isStructuralChange false ;
    effortless-ntwf:recordedByAgent effortless-ntwf:grace-holloway ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#TermMeaningChange" .

