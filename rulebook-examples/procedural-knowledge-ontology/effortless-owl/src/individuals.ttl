    effortless-ntwf:rulebookField effortless-ntwf:ModelChangeRequests.DomainChangeSpreadWrongInferences ;
    effortless-ntwf:justification "Fires on the RoleAssignments domain narrowing, whose altered accountability inferences surfaced in deployment queries." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-i22-e1 a effortless-ntwf:ClaimEvidence ;
