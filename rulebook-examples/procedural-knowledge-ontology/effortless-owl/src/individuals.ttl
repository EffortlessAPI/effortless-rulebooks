    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:VocabularyTerms.Definition ;
    effortless-ntwf:justification "Every controlled concept carries a definition, mapped to skos:definition." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c81-e1 a effortless-ntwf:ClaimEvidence ;
