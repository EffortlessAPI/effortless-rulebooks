    effortless-ntwf:rulebookTable effortless-ntwf:RoleAssignments ;
    effortless-ntwf:justification "A role is filled by an agent only through an assignment row with a validity period; steps name the role, never the agent." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

