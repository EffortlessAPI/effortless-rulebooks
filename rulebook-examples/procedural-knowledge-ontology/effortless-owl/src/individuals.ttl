    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowHowCarriers.IsOverlookedLivingHolder ;
    effortless-ntwf:justification "TRUE when uncaptured know-how is carried by someone still in a role whom no collection relationship has approached on that procedure. It fires on Tomas's improvised press setup, Ken's belt-drift diagnosis and Lin's forklift checks, and is FALSE on Tomas's bleed-down know-how, which a knowledge engineer is collecting from him: collection that follows documents rather than the social holder breaks the claim." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p16-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p16-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p16-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p16 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Agents.IsUnidentifiedBoundarySpanner ;
    effortless-ntwf:justification "TRUE when a person who connects two communities was never identified by a social network analysis. The plant analysis found Lin, so she reads FALSE; Ken (maintenance guild and Riverbend cluster) and Joao (two clusters) connect groups and no analysis found them." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p17-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p17-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p17-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p17 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourceRelationships.IsUnnegotiatedPowerGap ;
    effortless-ntwf:justification "TRUE when a power imbalance shapes a source relationship and nothing was negotiated about how the knowledge is collected and used. It fires on Ken, whose job is threatened by automation, and is FALSE on Tomas and Grace, where review rights and supervisor-free sessions were negotiated, and on Lin's balanced relationship." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p18-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p18-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p18-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p18 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourceRelationships.IsExtractiveRelationship ;
    effortless-ntwf:justification "TRUE when trust with a source is not established and the engineer records no trust-building practice. It fires on Grace (trust still building, nothing done to build it) and is FALSE on Ken, whose low trust is being addressed by returning transcripts, and on the established relationships." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

