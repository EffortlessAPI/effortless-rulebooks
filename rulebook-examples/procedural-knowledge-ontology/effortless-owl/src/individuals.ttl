    effortless-ntwf:justification "Links an AI agent to the agent accountable for it over a validity period; risk-classifier-2-4-1 is accountable to Omar Haddad." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c48-e1 a effortless-ntwf:ClaimEvidence ;
