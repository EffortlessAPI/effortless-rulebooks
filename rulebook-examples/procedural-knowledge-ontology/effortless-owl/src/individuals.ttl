# === Individuals: SourceArticles ===

effortless-ntwf:pkm-1 a effortless-ntwf:SourceArticles ;
    effortless-ntwf:__key "pkm-1" ;
    effortless-ntwf:sourceArticleId "pkm-1" ;
    effortless-ntwf:title "Process Knowledge Management, Part I: Accounting for How We Work" ;
    effortless-ntwf:author "Jessica Talisman" ;
    effortless-ntwf:series "Intentional Arrangement" ;
    effortless-ntwf:publishedOn "2025-12-03"^^xsd:date ;
    effortless-ntwf:localFileName "Intentional Arrangement - Process Knowledge Management, Part I.pdf" ;
    effortless-ntwf:thesis "Process knowledge, much of it tacit, is a distinct kind of organizational knowledge and now decides whether AI succeeds; representing it explicitly in ontologies with provenance makes AI more capable, interpretable and auditable." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#SourceArticle" .

effortless-ntwf:pkm-2 a effortless-ntwf:SourceArticles ;
    effortless-ntwf:__key "pkm-2" ;
    effortless-ntwf:sourceArticleId "pkm-2" ;
    effortless-ntwf:title "Process Knowledge Management, Part II: Collection Development and Organizing Principles" ;
    effortless-ntwf:author "Jessica Talisman" ;
    effortless-ntwf:series "Intentional Arrangement" ;
    effortless-ntwf:publishedOn "2025-12-08"^^xsd:date ;
    effortless-ntwf:localFileName "Intentional Arrangement - Process Knowledge Management, Part II.pdf" ;
    effortless-ntwf:thesis "Managing process knowledge is three continuous activities: collecting it from practitioners and systems, organizing it under explicit principles and vocabularies, and encoding it for people, search and AI agents, sustained by curation, governance and feedback loops until the knowledge is adequate." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#SourceArticle" .

effortless-ntwf:pkm-3 a effortless-ntwf:SourceArticles ;
    effortless-ntwf:__key "pkm-3" ;
    effortless-ntwf:sourceArticleId "pkm-3" ;
    effortless-ntwf:title "Process Knowledge Management, Part III: How We Lost Our Way" ;
    effortless-ntwf:author "Jessica Talisman" ;
    effortless-ntwf:series "Intentional Arrangement" ;
    effortless-ntwf:publishedOn "2025-12-13"^^xsd:date ;
    effortless-ntwf:localFileName "Intentional Arrangement - Process Knowledge Management, Part III.pdf" ;
    effortless-ntwf:thesis "Outsourcing shipped away the feedback loops, communities of practice and apprenticeship that generate process knowledge; organizations must audit what they hold, rebuild capture and transfer, and design new systems so knowledge capture is a primary goal." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#SourceArticle" .

effortless-ntwf:pkm-4 a effortless-ntwf:SourceArticles ;
    effortless-ntwf:__key "pkm-4" ;
    effortless-ntwf:sourceArticleId "pkm-4" ;
    effortless-ntwf:title "Process Knowledge Management, Part IV: From Theory to Practice, The Procedural Knowledge Ontology" ;
    effortless-ntwf:author "Jessica Talisman" ;
    effortless-ntwf:series "Intentional Arrangement" ;
    effortless-ntwf:publishedOn "2025-12-18"^^xsd:date ;
    effortless-ntwf:localFileName "Intentional Arrangement - Process Knowledge Management, Part IV.pdf" ;
    effortless-ntwf:thesis "The Procedural Knowledge Ontology separates procedures from their executions, reuses established vocabularies, is built by a lightweight methodology from expert workshops, and grounds elicitation tools and AI assistants in governed procedural knowledge." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#SourceArticle" .

effortless-ntwf:ont-4 a effortless-ntwf:SourceArticles ;
    effortless-ntwf:__key "ont-4" ;
    effortless-ntwf:sourceArticleId "ont-4" ;
    effortless-ntwf:title "Ontology Series, Part IV: Governance, Maintenance, and AI" ;
    effortless-ntwf:author "Jessica Talisman" ;
    effortless-ntwf:series "Ontology Series" ;
    effortless-ntwf:publishedOn "2026-03-17"^^xsd:date ;
    effortless-ntwf:localFileName "Ontology Series, Part IV - Governance, Maintenance, and AI (mislabeled as PKM Part V).htm" ;
    effortless-ntwf:thesis "Deployed models drift away from the organizations they describe; named stewardship and authority, semantic versioning, change requests tied to competency questions and regular review keep a model coherent, while AI proposes and people decide." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#SourceArticle" .

