    effortless-ntwf:justification "The responsibility each role carries, recorded on the role (e.g. confirms zero-energy states and receives escalated danger cues)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

