    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-q21-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-q21-e1" ;
