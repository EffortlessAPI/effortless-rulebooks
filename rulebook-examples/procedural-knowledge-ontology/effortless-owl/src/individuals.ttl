    effortless-ntwf:rulebookField effortless-ntwf:StepVariables.SourceStep ;
    effortless-ntwf:justification "On each input variable, the step whose output feeds it; the row's own step is the downstream step taking that artifact as an input." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

