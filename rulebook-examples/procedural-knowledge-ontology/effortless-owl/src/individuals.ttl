    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:PractitionerExpertise.IsUnexplainedForesight ;
    effortless-ntwf:justification "The software architect case: fires when a design judgment later proved right although its holder could not say why. It fires on Ravi's sense that the shared build cache would be costly to maintain; it does not fire on Omar's confirmed canary judgment, whose basis he stated, nor on detection expertise." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-i07-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-i07-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-i07-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-i07 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureVersions.TacitShareExceedsExplicit ;
    effortless-ntwf:justification "Compares tacit holdings (operator memory, departing staff, crew agreements) with explicit carriers (SOP, manual notes). It fires on loto-v1.0.0, where three of five holdings were tacit; it does not fire on loto-v2.0.0 after encoding." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-i08-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-i08-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-i08-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-i08 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureVersions.IsStudiedOnlyFromTheDesk ;
    effortless-ntwf:justification "The field-researcher comparison as a check: fires when the knowledge engineer elicited a version but never went where the work happens. It fires on deploy-v3.2.0, elicited by one remote interview; it does not fire on loto-v2.0.0, elicited on the plant floor." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-i09-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-i09-e1" ;
