    effortless-ntwf:justification "Fires on the assistant's suggestion that ProcedureVersions specialize p-plan:Plan, a provenance plan class, awaiting a person's modeling decision." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-i21-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-i21-e1" ;
