    effortless-ntwf:step effortless-ntwf:loto-04b ;
    effortless-ntwf:description "The pneumatic line re-pressurizes after the bleed." ;
    effortless-ntwf:response "Bleed again and fit a second valve lockout." ;
    effortless-ntwf:requiresEscalation false ;
