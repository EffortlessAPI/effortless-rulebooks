effortless-ntwf:q8-steward-shared-concerns a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-steward-shared-concerns" ;
    effortless-ntwf:roleQuestionId "q8-steward-shared-concerns" ;
    effortless-ntwf:askingRole effortless-ntwf:process-steward ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Is a concern that cuts across plant and engineering work, such as quality control or validation, defined once and shared, or defined again inside each domain?" ;
    effortless-ntwf:whyItMatters "Optimization, quality control and validation are the same problems in both disciplines; defining them twice splits the knowledge along the org chart." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "TermLabelVariants.IsCrossSchemeDuplicatePref=2/53" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q9-steward-lifecycle-feedback a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q9-steward-lifecycle-feedback" ;
    effortless-ntwf:roleQuestionId "q9-steward-lifecycle-feedback" ;
    effortless-ntwf:askingRole effortless-ntwf:process-steward ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-09 ;
    effortless-ntwf:questionText "At which stage of the knowledge lifecycle, from collecting to operationalizing, are we hearing nothing back?" ;
    effortless-ntwf:whyItMatters "Feedback that only arrives once knowledge is in operation means mistakes made while storing or codifying it surface on the shop floor." ;
