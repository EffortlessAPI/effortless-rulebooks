    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm3-q07 ;
    effortless-ntwf:justification "Asks, per function, whether the method knowledge of how it is really performed is held by the organization or by an outside provider." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-q12-e1 a effortless-ntwf:ClaimEvidence ;
