    effortless-ntwf:roleQuestionId "q11-sourcing-what-how-split" ;
    effortless-ntwf:askingRole effortless-ntwf:sourcing-manager ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-11 ;
    effortless-ntwf:questionText "Where we keep the specification but a provider holds the method, can we still build what we design, or have we hollowed out?" ;
