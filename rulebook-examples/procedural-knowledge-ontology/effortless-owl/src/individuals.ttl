    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeFragments.KnowledgeForm ;
    effortless-ntwf:justification "Every knowledge fragment is classified by form: Tacit, Explicit, Implicit or SituatedJudgment." ;
