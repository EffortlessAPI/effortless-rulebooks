# === Individuals: ConformanceSubstrates ===

effortless-ntwf:compile-rulebook a effortless-ntwf:ConformanceSubstrates ;
    effortless-ntwf:__key "compile-rulebook" ;
    effortless-ntwf:conformanceSubstrateId "compile-rulebook" ;
    effortless-ntwf:label "compile-rulebook" ;
    effortless-ntwf:transpiler "compile-rulebook" ;
    effortless-ntwf:outputFolder "/effortless-rulebook" ;
    effortless-ntwf:engine "Python formula engine (shared with rulebook-to-python)" ;
    effortless-ntwf:howItComputes "Runs first in the build and rewrites the rulebook in place: every calculated, lookup and aggregation value is computed across all tables to a fixed point and upserted into the rows. Those stored values become the answer keys. It is not graded against itself; when another substrate disagrees, either side can be the one that is wrong." ;
    effortless-ntwf:role "answer-key" ;
    effortless-ntwf:sortOrder 0 ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ConformanceSubstrate" .

