    effortless-ntwf:ontologyProfile effortless-ntwf:schema-org ;
    effortless-ntwf:justification "Schema.org is a recorded dependency with mappings (ProcedureLensViews to schema:HowTo, Steps to schema:HowToStep) and its deprecations tracked." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-s11-e1 a effortless-ntwf:ClaimEvidence ;
