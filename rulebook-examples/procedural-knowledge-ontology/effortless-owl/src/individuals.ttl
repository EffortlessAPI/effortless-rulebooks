effortless-ntwf:q8-ke-vocabulary-first a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-ke-vocabulary-first" ;
    effortless-ntwf:roleQuestionId "q8-ke-vocabulary-first" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "For each domain, was vocabulary control in place before ontology modeling began, and did we adopt standards in order from vocabularies to lightweight ontologies to process and decision models?" ;
    effortless-ntwf:whyItMatters "Classes built before the terms are controlled bake uncontrolled wordings into axioms; adopting DMN before the procedure ontology it decides over leaves decisions with nothing to refer to." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "OntologyProfiles.SkipsAdoptionPath=1/27; Vocabularies.OntologyPrecededVocabularyControl=1/12" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-ke-practitioner-terms a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-ke-practitioner-terms" ;
    effortless-ntwf:roleQuestionId "q8-ke-practitioner-terms" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Is each controlled concept organized around the words practitioners actually use, and do the different phrasings of one activity in different sources all reconcile to it?" ;
    effortless-ntwf:whyItMatters "Technicians say LOTO; a scheme organized around 'lockout/tagout' alone reads like the SOP and not like the floor. The runbook's 'release gate check' is the same review as 'sign-off' but nothing says so." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "VocabularyTerms.HasUnreconciledVariantPhrasings=4/44; VocabularyTerms.IsOrganizedAroundOfficialTerm=2/44" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-ke-canonical-resolution a effortless-ntwf:RoleQuestions ;
