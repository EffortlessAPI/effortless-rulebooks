    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-i30-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-i30-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-i30-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-i30 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:DriftObservations.DriftFollowsCleanRelease ;
    effortless-ntwf:justification "Fires on drift observed after releases that passed every acceptance validation (0.9.0, 0.10.1); drift after the failed 0.10.0 release and drift with no release reference read false." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c07-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c07-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c07-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c07 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Steps.StatesOperationalKnowledge ;
    effortless-ntwf:justification "TRUE for a step that states the three operational-level facts together: it is reached through the transition order (what comes before), it names the step it depends on, and it has a precondition that must hold before work continues. loto-03, loto-07 and deploy-04 carry all three; steps missing any of them read FALSE." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c08-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c08-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c08-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c08 ;
    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:TacticalResourceAllocations ;
    effortless-ntwf:justification "Each row is tactical knowledge: the capacity allocated to a step's resource, the demand on it, whether that makes a bottleneck, and the adjustment decided (order padlocks, fill the night deputy role)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c09-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c09-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c09-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c09 ;
    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:ProcessStrategicAlignments ;
    effortless-ntwf:justification "Each row ties a procedure to the mission of the organization it serves and records its rationale, the value it creates and the trade-offs it makes, e.g. lockout's extra hour of downtime per job." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c10-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c10-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c10-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c10 ;
    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:ProcessStages ;
    effortless-ntwf:justification "Stages group a version's steps (Steps.Stage), in sequence, as a product manager runs the release process: build and classify, approve, roll out and verify." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c11-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c11-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c11-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c11 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcessStages.OwnerRole ;
    effortless-ntwf:justification "The stakeholder role that owns each stage (release manager owns Approve, site reliability engineer owns Roll out and verify); Steps.AssignedRole already names the owner of each step." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c12-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c12-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c12-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c12 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcessOutcomeMeasures.ObservedValue ;
    effortless-ntwf:justification "The measured value of each outcome of a procedure over a period against its target, e.g. change failure rate 33% against 5%, zero-energy first-pass rate 60% against 95%." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c13-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c13-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c13-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c13 ;
    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:ProcessInterdependencies ;
    effortless-ntwf:justification "Rows record how one operation requires, helps or hinders another and the mechanism, e.g. deployments during the close window restarting the ledger integration: the cross-process dependencies an infrastructure engineer needs." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c14-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c14-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c14-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c14 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcessOutcomeMeasures.BusinessOutcome ;
    effortless-ntwf:justification "Links each process measure to the business outcome it drives (change failure rate to platform availability, owned by the VP of engineering), with LinkRationale saying how." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c34-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c34-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c34-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c34 ;
    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:StepContextSensitivities ;
    effortless-ntwf:justification "One row per way a step's significance changes with context, typed by ContextFactor Performer, Resource or Circumstance: a deputy verifying on nights, padlocks running short, a press carrying an accumulator retrofit." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p02-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p02-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p02-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p02 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcessKnowledgeLevels.LacksCaptureStrategyForEitherForm ;
    effortless-ntwf:justification "Fires on a level that has no capture strategy for its tacit knowledge or none for its explicit knowledge. The strategic level has only strategy memos (explicit) and nothing for the executives' tacit judgment, so it fires; operational and tactical have both and do not. That is the prescription that each level needs its own strategy for both forms broken." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p03-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p03-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p03-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p03 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Procedures.PrivilegesSingleStakeholderView ;
    effortless-ntwf:justification "Fires when a procedure is organized for exactly one stakeholder lens. The press-7 die changeover is organized only as the trainer's view, so every other stakeholder (auditor, manager, executive) is unserved; lockout and deployment serve several lenses and do not fire. That is one stakeholder view privileged over the rest." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p14-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p14-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p14-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p14 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:TermRelations.AssertsIndirectLinkAsDirect ;
    effortless-ntwf:justification "Fires when a skos:broader link, which must be direct, is asserted from a concept to its grandparent. The SOP index linked accumulator bleed-down straight to lockout/tagout although it sits under energy isolation, so it fires; the associative relations do not. The rule that a direct relation cannot stand in for an indirect one is enforced." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p15-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p15-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p15-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p15 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ExecutionEntities.ViolatesDeclaredDatatypeOrFormat ;
    effortless-ntwf:justification "Fires when a recorded value's datatype or media type differs from what its step variable declares. The 2026-07-14 hotfix recorded its risk report as a text/plain chat message where deploy-02 declares a RiskReport in application/json, so it fires; the conforming PDF verification record and JSON risk report do not. Expected datatype and format are enforced." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p28-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p28-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p28-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p28 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Steps.IsContextSensitiveButUnscoped ;
    effortless-ntwf:justification "Fires when a step's significance depends on context and a recorded dependency names no applicability scope. loto-03's dependence on the press-7 retrofit has no scope, so it fires; the night-shift and EU-freeze dependencies point at one compact ApplicabilityScopes row and do not. Context is captured by explicit scoping rather than by forking the procedure." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-q05-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-q05-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-q05-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-q05 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm1-q05 ;
    effortless-ntwf:justification "The operations manager's bottleneck question, answered by TacticalResourceAllocations.IsBottleneck and Steps.IsBottleneckStep: north-station padlocks and night verifier hours are demanded beyond capacity." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-q06-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-q06-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-q06-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-q06 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm1-q06 ;
    effortless-ntwf:justification "The VP's question on why each procedure exists and what it trades off, answered by ProcessStrategicAlignments and Procedures.HasNoStatedReasonForExisting / ProcessStrategicAlignments.StatesNoTradeOff." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-q07-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-q07-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-q07-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-q07 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm1-q07 ;
    effortless-ntwf:justification "The VP's question on how performance connects to business outcomes, answered by ProcessOutcomeMeasures.BusinessOutcome and Procedures.MeasuresPerformanceWithoutBusinessLink (conveyor maintenance is measured but tied to nothing)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-s06-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-s06-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-s06-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-s06 ;
    effortless-ntwf:evidenceKind "OntologyProfile" ;
    effortless-ntwf:ontologyProfile effortless-ntwf:sparql-11-sd ;
    effortless-ntwf:justification "SPARQL 1.1 Service Description's named graphs: ApplicabilityScopes maps to sd:NamedGraph and NamedGraphIri to sd:name, so knowledge scoped to a context is kept in the named graph where it holds." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-i04-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-i04-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-i04-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-i04 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:LevelCaptureStrategies.ContradictsKnowledgeForm ;
    effortless-ntwf:justification "Fires when tacit knowledge is to be passed on only as a stored document, or explicit knowledge only in person. The shift planners' tacit staffing heuristics were written up once as a wiki page, so it fires; shadowing veterans (tacit, in person) and encoding the SOP (explicit, codified) do not. It witnesses the chart's contrast: explicit knowledge is codified and stored, tacit knowledge is passed on in person." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-i05-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-i05-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-i05-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-i05 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcessLevelStatements.IsFiledAtWrongLevel ;
    effortless-ntwf:justification "Fires when a statement answers a question its level does not answer in the planning pyramid (LevelPyramidQuestions: strategic who and why, tactical what, operational how and where). The deployment's reason for gating releases (a why) was filed among operational statements, so it fires; the lockout statements filed by the pyramid do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p06-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p06-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p06-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p06 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Resources.IsContentWithoutOrganization ;
    effortless-ntwf:justification "Fires when a resource has content (a description) but lacks structure (no type from the artifact-type scheme), findability (no keywords) or linkage (no procedure or step references it). The press-7 changeover PDF has content but no keywords, so it fires; the typed, keyworded, referenced 2019 lockout SOP does not. Content alone does not pass." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p40-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p40-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p40-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p40 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Procedures.LacksManagedControlledVocabulary ;
    effortless-ntwf:justification "Fires when a procedure with specified steps has no controlled vocabulary whose metadata (governing role, establishment date) is managed. Conveyor maintenance has only an ungoverned PDF glossary, so it fires; lockout, deployment, close and policy each have a governed scheme and do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c40-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c40-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c40-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c40 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:CollectedSourceMaterials.MaterialKind ;
    effortless-ntwf:justification "Each collected item is typed as Transcript, FieldNotes, ProcessMap, MinedEventTrace or DocumentExcerpt, the raw material collection produces, with when it was organized and modeled." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c59-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c59-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c59-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c59 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Procedures.ProcedureType ;
    effortless-ntwf:justification "Each procedure instance is assigned a category of the process taxonomy (safety-procedure, software-release, support-runbook, ...); IsInconsistentlyCategorized checks the category is a suitable leaf." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c62-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c62-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c62-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c62 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Vocabularies.SchemeKind ;
    effortless-ntwf:justification "Distinguishes thesauri (the lockout, release and role schemes, which carry broader and related relations) from plain controlled vocabularies; the process taxonomy is ProcedureTypes." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

