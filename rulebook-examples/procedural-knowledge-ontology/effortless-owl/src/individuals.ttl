effortless-ntwf:aq-pkm2-q10 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm2-q10" ;
    effortless-ntwf:roleQuestionId "aq-pkm2-q10" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-authority ;
