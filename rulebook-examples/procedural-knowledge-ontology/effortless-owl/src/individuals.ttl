    effortless-ntwf:rulebookField effortless-ntwf:ElicitationParticipants.IsKnowledgeConsumer ;
    effortless-ntwf:justification "TRUE for participants who consume it, such as the operations manager and the knowledge engineer." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c09-e1 a effortless-ntwf:ClaimEvidence ;
