    effortless-ntwf:articleClaim effortless-ntwf:pkm2-i09 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureVersions.ExpertsEvaluateAiNotRepresentation ;
    effortless-ntwf:justification "Fires when experts were recruited to evaluate AI output on a version but none to approve the representation it rests on: Ravi Menon, an affected platform engineer, rated the deployment AI's output while no affected expert approved deploy-v3.2.0. It does not fire on loto-v2.0.0, approved by its experts." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

