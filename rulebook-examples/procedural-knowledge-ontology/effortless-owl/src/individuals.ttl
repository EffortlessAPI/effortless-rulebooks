    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-safety-granularity a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-safety-granularity" ;
    effortless-ntwf:roleQuestionId "q8-safety-granularity" ;
    effortless-ntwf:askingRole effortless-ntwf:plant-safety-officer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Is each view written at the level of detail its readers need, and does any procedure version mix whole activities with single actions at the same level?" ;
    effortless-ntwf:whyItMatters "Training needs every action; a planner drowning in actions misses the category; a checklist that says 'do the maintenance' beside 'apply locks' hides the hard part." ;
