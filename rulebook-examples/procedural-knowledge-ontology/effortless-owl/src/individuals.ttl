    effortless-ntwf:jwtClaimMappingId "claim-tenant" ;
    effortless-ntwf:claimName "tenant_id" ;
    effortless-ntwf:sqlAccessor "app.jwt_tenant_id()" ;
    effortless-ntwf:isReservedClaim true ;
    effortless-ntwf:mapsToPrincipal false ;
    effortless-ntwf:description2 "Magic-links tenant the token was minted for. Pinned so a token from another tenant cannot authenticate here." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#JwtClaimMapping" .

effortless-ntwf:claim-principal a effortless-ntwf:JwtClaimMappings ;
