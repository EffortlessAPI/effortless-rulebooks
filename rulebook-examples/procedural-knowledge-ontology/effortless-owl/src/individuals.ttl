    effortless-ntwf:claimEvidenceId "pkm2-q28-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-q28 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm2-q28 ;
    effortless-ntwf:justification "The steward's question, answered by Roles.Organization and OrganizationType, with IsNotHousedInDepartment for roles outside any department." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-q29-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-q29-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-q29-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-q29 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm2-q29 ;
    effortless-ntwf:justification "The steward's question, answered by Roles.SpecializesRole and HasSpecializations, with IsSeniorVariantNotSpecialization." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-q30-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-q30-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-q30-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-q30 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm2-q30 ;
    effortless-ntwf:justification "The product manager's question, answered by ProcedureTypes.BroaderProcedureType, TaxonomyRank and HasNarrowerTypes." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-q31-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-q31-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-q31-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-q31 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm2-q31 ;
    effortless-ntwf:justification "The product manager's question, answered by Procedures.HasStepAndCategoryResolutions and IsMissingDemandedResolution over step-level and category-level lens views." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-s09-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-s09-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-s09-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-s09 ;
    effortless-ntwf:evidenceKind "OntologyProfile" ;
    effortless-ntwf:ontologyProfile effortless-ntwf:skos ;
    effortless-ntwf:justification "SKOS mappings: Vocabularies to skos:ConceptScheme, VocabularyTerms to skos:Concept with prefLabel, altLabel, definition, scopeNote, broader and inScheme; TermRelations to skos:related." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-s23-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-s23-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-s23-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-s23 ;
    effortless-ntwf:evidenceKind "OntologyProfile" ;
    effortless-ntwf:ontologyProfile effortless-ntwf:sparql-11-sd ;
    effortless-ntwf:justification "Named graphs for scoping context: each ApplicabilityScopes row is mapped to sd:NamedGraph and carries its graph IRI (sd:name)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-s22-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-s22-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-s22-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-s22 ;
    effortless-ntwf:evidenceKind "KnowledgeMethod" ;
    effortless-ntwf:knowledgeMethod effortless-ntwf:FacetedClassification ;
    effortless-ntwf:justification "Applied by MethodApplications row ma8-faceted-procedure-types: procedure types are classified along four independent facets (ClassificationFacets: functional domain, hazard, audience, change type), each procedure carries a value per facet in ProcedureFacetAssignments, and ProcedureTypes.IsArbitraryGrouping checks members against the facet their grouping names." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-s02-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-s02-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-s02-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-s02 ;
    effortless-ntwf:evidenceKind "KnowledgeMethod" ;
    effortless-ntwf:knowledgeMethod effortless-ntwf:LayeredVocabularyToOntology ;
    effortless-ntwf:justification "Applied by MethodApplications row ma8-layered-lockout: the lockout activity thesaurus (Vocabularies, VocabularyTerms with SKOS labels and relations) and the process taxonomy (ProcedureTypes) were established before the lockout procedure was aligned to the PKO 2.0.0 ontology; Vocabularies.OntologyPrecededVocabularyControl checks that order per domain." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-i04-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-i04-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-i04-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-i04 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:VocabularyTerms.HasUnreconciledVariantPhrasings ;
    effortless-ntwf:justification "Fires when one concept appears under several phrasings across sources and some are not reconciled to it. Release Approval Review appears as 'sign-off' (transcript), 'go/no-go' (transcript) and 'release gate check' (runbook), the last unreconciled, so it fires; Zero-Energy Verification's phrasings all resolve and it does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-i05-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-i05-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-i05-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-i05 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Roles.IsSeniorVariantNotSpecialization ;
    effortless-ntwf:justification "Fires when a senior version of a role is not recorded as a specialization of a role in its own family. Lead Release Manager specializes nothing, so it fires; Senior Maintenance Technician specializes Maintenance Technician and does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-i10-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-i10-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-i10-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-i10 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Procedures.IsMissingDemandedResolution ;
    effortless-ntwf:justification "Fires when a lens needs step-level detail the procedure lacks, or a category it is not classified into. The press-7 changeover has a trainer's view but no steps (training needs step detail), and forklift inspection has a strategic planner's view but no process-type category; both fire. Lockout serves step and category readers and does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-i14-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-i14-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-i14-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-i14 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:OntologyProfiles.SkipsAdoptionPath ;
    effortless-ntwf:justification "Fires when a later-stage standard was adopted before the earlier-stage standard it builds on. DMN (decision modeling, stage 3) was adopted in May 2025, before PKO (lightweight ontology, stage 2) in September, so it fires; PKO, DCAT, P-Plan, FOAF and schema.org follow SKOS and do not. Unadopted standards are not flagged." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c22-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c22-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c22-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c22 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcessInterdependencies.Effect ;
    effortless-ntwf:justification "Records whether one operation Helps, Hinders or Requires another in the value chain (a verified zero-energy record helps roller replacement; press-7 lockouts hinder the die changeover), the knowledge lost when parts of the chain go." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-q04-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-q04-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-q04-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-q04 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm3-q04 ;
    effortless-ntwf:justification "The infrastructure engineer's question, answered by ProcessInterdependencies.Effect and IsHinderingDependency and by Procedures.IsHinderedByAnotherOperation." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm4-i08-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm4-i08-e1" ;
    effortless-ntwf:claimEvidenceId "pkm4-i08-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm4-i08 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:TermLabelVariants.IsCrossSchemeDuplicatePref ;
    effortless-ntwf:justification "Fires when the same concern is defined as a separate preferred concept in more than one scheme instead of once and shared. 'quality control' is defined both in the shared agent-capability scheme and again in the plant's local quality terms, and the maintenance technician is tagged with the plant copy; both labels fire. 'validation', shared by the safety officer and the site reliability engineer across plant and engineering, does not. It witnesses that these problems cut across disciplines and must not be split by domain." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c04-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c04-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c04-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c04 ;
    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:TermMeaningChanges ;
    effortless-ntwf:justification "Each row records that the organization's meaning of a controlled term changed (prior and new meaning, when); VocabularyTerms.HasStaleDefinition reads it against the term's definition, e.g. 'release' still defined the 2024 way." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c08-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c08-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c08-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c08 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:VocabularyTerms.NamespaceIri ;
    effortless-ntwf:justification "The namespace each concept belongs to; re-homed terms such as 'given name' carry the local urn:effortless:pko-extension# namespace in place of FOAF's." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c09-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c09-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c09-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c09 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:VocabularyTerms.ConceptIri ;
    effortless-ntwf:justification "A globally unique IRI for every controlled concept, mapped to the RDF 1.1 IRI identifier." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c10-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c10-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c10-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c10 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:OntologyProfiles.Version ;
    effortless-ntwf:justification "One record per reused external standard (SKOS, FOAF, schema.org, DCAT, PKO, ...) holding the version the model depends on, with its version IRI and namespace." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c11-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c11-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c11-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c11 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ExternalStandardTerms.DeprecatedBySource ;
    effortless-ntwf:justification "TRUE for an adopted external term its source standard marks deprecated (foaf:givenname, schema:serviceAudience, schema:vendor), with DeprecatedAt and StillResolves." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c12-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c12-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c12-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c12 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:VocabularyTerms.SameAsIri ;
    effortless-ntwf:justification "The reconciliation relation: the local concept asserts identity (owl:sameAs) with the deprecated external term, e.g. local 'given name' sameAs foaf:givenname." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c15-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c15-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c15-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c15 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Vocabularies.ModelLayer ;
    effortless-ntwf:justification "Marks controlled concept schemes (status, artifact types, capabilities, activities, roles) as the VocabularyLayer, held apart from the ontology profiles." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c32-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c32-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c32-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c32 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:LifecycleStatuses.WorkflowStatusConcept ;
    effortless-ntwf:justification "Maps every lifecycle status to a concept of the controlled workflow status scheme (active, draft, deprecated)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c33-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c33-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c33-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c33 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Resources.ArtifactTypeConcept ;
    effortless-ntwf:justification "Types each resource by a concept of the controlled artifact-type scheme (standard operating procedure, engineering drawing, runbook, training media, register entry)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c34-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c34-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c34-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c34 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Vocabularies.GovernedDimension ;
    effortless-ntwf:justification "Names what each scheme controls; voc-agent-capabilities is the AgentCapability scheme (compliance review, validation, risk scoring, automated deployment)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c35-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c35-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c35-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c35 ;
    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:RoleCapabilityTags ;
    effortless-ntwf:justification "Roles carry capability tags drawn from the capability scheme (the change risk classifier is tagged risk scoring), with IsTagOutsideCapabilityScheme catching a tag from another scheme." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-p01-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-p01-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-p01-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-p01 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:VocabularyTerms.HasStaleDefinition ;
    effortless-ntwf:justification "Fires when the organization's meaning of a term changed after its definition was last revised. 'release' changed in January 2026 to a risk-classified, gated, pipeline rollout while its definition still describes an engineer copying a build (revised 2024), so it fires; 'rollback' and 'zero-energy verification' were redefined when their meaning changed and do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-p03-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-p03-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-p03-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-p03 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ExternalStandardTerms.IsAlignmentStaleAfterDeprecation ;
    effortless-ntwf:justification "Fires when the source deprecated a term and our alignment and documentation were not updated afterwards, even though the IRI still resolves. schema:serviceAudience (deprecated September 2025, still mapped from StakeholderLenses) fires; schema:vendor, whose alignment was updated a month after deprecation, does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-p04-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-p04-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-p04-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-p04 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ExternalStandardTerms.IsNeededDeprecatedTermNotRehomed ;
    effortless-ntwf:justification "Fires when the model still needs a deprecated external term and has not taken it into the local namespace. schema:vendor is still needed for supplier organizations and was not re-homed, so it fires; the FOAF name terms were re-homed and serviceAudience is no longer needed, so they do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-p05-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-p05-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-p05-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-p05 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ExternalStandardTerms.IsRehomedWithoutIdentityLink ;
    effortless-ntwf:justification "Fires when a re-homed local concept does not assert identity with the external original. Local 'surname' carries no sameAs to foaf:surname, so it fires; 'given name' asserts sameAs foaf:givenname and does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-p06-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-p06-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-p06-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-p06 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ExternalStandardTerms.IsRehomedWithoutNewRelease ;
    effortless-ntwf:justification "Fires when a term was re-homed without a model release, issued after the deprecation, that introduces it. The local 'has version' replacing dct:hasVersion names no release, so it fires; the FOAF name terms arrived in release 0.9.1 and do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-p07-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-p07-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-p07-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-p07 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ExternalStandardTerms.HasUnpropagatedIdentifierChange ;
    effortless-ntwf:justification "Fires when a standard changed a term's prefix or identifier and some mapping still uses the old one. schema.org moved from http to https; the Procedures mapping still targets http://schema.org/HowTo, so HowTo fires, while HowToStep's mapping was updated and does not. A query against the old IRI would silently find nothing." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-p59-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-p59-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-p59-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-p59 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourceTermMentions.IsNonCanonicalGeneratedValue ;
    effortless-ntwf:justification "Fires when an AI-generated value is not a preferred label of the governed scheme. The ungrounded run's 'live', 'shipped', 'work in progress' and 'retired' fire; the grounded run's 'active', 'draft' and 'deprecated' do not. Practitioner and document wordings are never flagged by it." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-p62-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-p62-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-p62-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-p62 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:TermLabelVariants.IsAmbiguousLabel ;
    effortless-ntwf:justification "Fires when one wording is a label of more than one concept in a scheme, so alternative labels cannot normalize it to one canonical concept. 'review' is an alternative label of both Release Approval Review and Change Risk Classification, so both fire; 'sign-off' resolves to exactly one concept and does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-q26-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-q26-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-q26-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-q26 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-ont4-q26 ;
    effortless-ntwf:justification "The knowledge engineer's question, answered by ExternalStandardTerms.IsAdoptedButDeprecated over DeprecatedBySource and the mappings and re-homings that adopt each term." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-s03-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-s03-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-s03-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-s03 ;
