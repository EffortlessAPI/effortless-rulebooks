    effortless-ntwf:rulebookField effortless-ntwf:ProcedureVersions.OpenQuestionAnnotationCount ;
    effortless-ntwf:justification "Adequacy for collaboration: open clarifying questions collaborators attached to the version, a direct measure of where it is unclear." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c32-e1 a effortless-ntwf:ClaimEvidence ;
