# === Individuals: VocabularyTerms ===

effortless-ntwf:vt-cutoff a effortless-ntwf:VocabularyTerms ;
    effortless-ntwf:__key "vt-cutoff" ;
    effortless-ntwf:vocabularyTermId "vt-cutoff" ;
    effortless-ntwf:vocabulary effortless-ntwf:voc-close-controls ;
    effortless-ntwf:prefLabel "Cutoff Control" ;
    effortless-ntwf:altLabels "posting cutoff, period cutoff" ;
    effortless-ntwf:definition "A control preventing ledger entries after the period close boundary without an approved reopening." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#VocabularyTerm" .

effortless-ntwf:vt-reconciliation a effortless-ntwf:VocabularyTerms ;
    effortless-ntwf:__key "vt-reconciliation" ;
    effortless-ntwf:vocabularyTermId "vt-reconciliation" ;
    effortless-ntwf:vocabulary effortless-ntwf:voc-close-controls ;
    effortless-ntwf:prefLabel "Reconciliation Control" ;
    effortless-ntwf:altLabels "account reconciliation, balance control" ;
    effortless-ntwf:definition "A control requiring a material account to reconcile or carry an approved exception." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#VocabularyTerm" .

effortless-ntwf:vt-segregation a effortless-ntwf:VocabularyTerms ;
    effortless-ntwf:__key "vt-segregation" ;
    effortless-ntwf:vocabularyTermId "vt-segregation" ;
    effortless-ntwf:vocabulary effortless-ntwf:voc-close-controls ;
    effortless-ntwf:prefLabel "Segregation of Duties" ;
    effortless-ntwf:altLabels "SoD, maker-checker" ;
    effortless-ntwf:definition "A control requiring the preparer and the final approver of an action to be different agents." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#VocabularyTerm" .

effortless-ntwf:vt-evidence-retention a effortless-ntwf:VocabularyTerms ;
    effortless-ntwf:__key "vt-evidence-retention" ;
    effortless-ntwf:vocabularyTermId "vt-evidence-retention" ;
    effortless-ntwf:vocabulary effortless-ntwf:voc-close-controls ;
    effortless-ntwf:prefLabel "Evidence Retention" ;
    effortless-ntwf:altLabels "records retention, retention period" ;
    effortless-ntwf:definition "A requirement that evidence of an action remain retrievable for a fixed retention window." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#VocabularyTerm" .

effortless-ntwf:vt-human-approval-gate a effortless-ntwf:VocabularyTerms ;
    effortless-ntwf:__key "vt-human-approval-gate" ;
    effortless-ntwf:vocabularyTermId "vt-human-approval-gate" ;
    effortless-ntwf:vocabulary effortless-ntwf:voc-close-controls ;
    effortless-ntwf:prefLabel "Human Approval Gate" ;
    effortless-ntwf:altLabels "human-in-the-loop, human confirmation" ;
    effortless-ntwf:definition "A control requiring a human, not an automated agent, to confirm an approval." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#VocabularyTerm" .

effortless-ntwf:vt-consent a effortless-ntwf:VocabularyTerms ;
    effortless-ntwf:__key "vt-consent" ;
    effortless-ntwf:vocabularyTermId "vt-consent" ;
    effortless-ntwf:vocabulary effortless-ntwf:voc-policy-domains ;
    effortless-ntwf:prefLabel "Consent Requirement" ;
    effortless-ntwf:altLabels "opt-in, active consent" ;
    effortless-ntwf:definition "A requirement that a communication only be sent to a recipient with active, recorded consent." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#VocabularyTerm" .

effortless-ntwf:vt-quiet-hours a effortless-ntwf:VocabularyTerms ;
