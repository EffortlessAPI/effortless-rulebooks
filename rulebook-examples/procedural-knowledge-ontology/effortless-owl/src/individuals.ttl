effortless-ntwf:q8-ke-organize-before-model a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-ke-organize-before-model" ;
    effortless-ntwf:roleQuestionId "q8-ke-organize-before-model" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Was every piece of collected material organized into a scheme before it was modeled into a procedure version?" ;
    effortless-ntwf:whyItMatters "Encoding an unorganized document excerpt means modeling before knowing what is being modeled; the conveyor procedure was imported that way." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "CollectedSourceMaterials.IsModeledBeforeOrganized=1/15" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-steward-scheme-frames a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-steward-scheme-frames" ;
    effortless-ntwf:roleQuestionId "q8-steward-scheme-frames" ;
    effortless-ntwf:askingRole effortless-ntwf:process-steward ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Does each organizing scheme hold the different kinds of knowledge collected about its procedures in one frame, and has it been refined as new material came in?" ;
    effortless-ntwf:whyItMatters "A glossary built from document excerpts alone leaves the veterans' transcripts somewhere else; a scheme never refined after new field notes is organizing last year's understanding." ;
    effortless-ntwf:answerableBefore false ;
