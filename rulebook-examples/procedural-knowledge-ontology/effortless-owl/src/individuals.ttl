    effortless-ntwf:semanticTypeIri "http://www.w3.org/2004/02/skos/core#Concept" ;
    effortless-ntwf:scopeNote "Use for the whole family of energy-control activities; use a narrower concept for a specific activity." ;
    effortless-ntwf:conceptIri "urn:effortless:pko-extension:vocab/lockout-activities#energy-control" ;
    effortless-ntwf:namespaceIri "urn:effortless:pko-extension:vocab/lockout-activities#" .

