effortless-ntwf:aq-pkm2-q21 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm2-q21" ;
    effortless-ntwf:roleQuestionId "aq-pkm2-q21" ;
    effortless-ntwf:askingRole effortless-ntwf:internal-compliance-auditor ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Under which business unit, geography, customer segment or regulatory regime does each variant of a procedure apply, and when does it stop applying?" ;
