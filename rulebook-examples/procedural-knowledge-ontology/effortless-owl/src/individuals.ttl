    effortless-ntwf:claimName "principal" ;
    effortless-ntwf:sqlAccessor "app.jwt_principal()" ;
    effortless-ntwf:isReservedClaim false ;
    effortless-ntwf:mapsToPrincipal true ;
    effortless-ntwf:description2 "AccessPrincipals row the caller acts as, resolved from the verified email via vw_agents. Not trusted from the token itself." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#JwtClaimMapping" .

