    effortless-ntwf:rulebookField effortless-ntwf:CriticalIncidents.Outcome ;
    effortless-ntwf:justification "Each collected episode is typed WentWell, WentBadly or Improvised: the mixer 2 second-drive restart went badly, the press 3 gauge episode was improvised, the conveyor 5 hand-off went well." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

