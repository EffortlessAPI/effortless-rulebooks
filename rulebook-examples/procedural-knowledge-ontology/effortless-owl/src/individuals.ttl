# === Individuals: InterviewProbes ===

effortless-ntwf:ip7-loto-why-wait a effortless-ntwf:InterviewProbes ;
    effortless-ntwf:__key "ip7-loto-why-wait" ;
    effortless-ntwf:interviewProbeId "ip7-loto-why-wait" ;
    effortless-ntwf:elicitationSession effortless-ntwf:el7-loto-interview ;
    effortless-ntwf:step effortless-ntwf:loto-04b ;
    effortless-ntwf:probeKind "Why" ;
    effortless-ntwf:prompt "Why do you wait before bleeding the line a second time?" ;
    effortless-ntwf:answer "The press 3 accumulator refills from the dryer for a few seconds after the valve closes." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#InterviewProbe" .

effortless-ntwf:ip7-loto-short-zero a effortless-ntwf:InterviewProbes ;
    effortless-ntwf:__key "ip7-loto-short-zero" ;
    effortless-ntwf:interviewProbeId "ip7-loto-short-zero" ;
    effortless-ntwf:elicitationSession effortless-ntwf:el7-loto-interview ;
    effortless-ntwf:step effortless-ntwf:loto-06 ;
    effortless-ntwf:probeKind "ProcedureFallsShort" ;
    effortless-ntwf:prompt "What do you do when the zero-energy check is not enough?" ;
    effortless-ntwf:answer "On a retrofit with a capacitor bank I wait five minutes and test again before anyone reaches in." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#InterviewProbe" .

effortless-ntwf:ip7-loto-whatif-gauge a effortless-ntwf:InterviewProbes ;
    effortless-ntwf:__key "ip7-loto-whatif-gauge" ;
    effortless-ntwf:interviewProbeId "ip7-loto-whatif-gauge" ;
    effortless-ntwf:elicitationSession effortless-ntwf:el7-loto-interview ;
    effortless-ntwf:step effortless-ntwf:loto-04b ;
    effortless-ntwf:probeKind "WhatIf" ;
    effortless-ntwf:prompt "What if the line had a working bleed indicator?" ;
    effortless-ntwf:answer "I would still listen; indicators stick." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#InterviewProbe" .

effortless-ntwf:ip7-deploy-why-canary a effortless-ntwf:InterviewProbes ;
    effortless-ntwf:__key "ip7-deploy-why-canary" ;
    effortless-ntwf:interviewProbeId "ip7-deploy-why-canary" ;
    effortless-ntwf:elicitationSession effortless-ntwf:el7-deploy-interview ;
    effortless-ntwf:step effortless-ntwf:deploy-04 ;
    effortless-ntwf:probeKind "Why" ;
    effortless-ntwf:prompt "Why do you hold the canary longer on Fridays?" ;
    effortless-ntwf:answer "Weekend traffic shifts the error baseline and a short canary hides regressions." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#InterviewProbe" .

