    effortless-ntwf:rulebookField effortless-ntwf:ModelProposals.AwaitsStewardApproval ;
    effortless-ntwf:justification "Fires on the hotfix workflow steps the wiki extractor parsed from a newly written wiki page, proposed and awaiting approval." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-i28-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-i28-e1" ;
