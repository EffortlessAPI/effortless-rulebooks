    effortless-ntwf:changedAt "2026-05-20T14:00:00+00:00"^^xsd:dateTime ;
    effortless-ntwf:priorMeaning "The technician tries the start button once." ;
    effortless-ntwf:newMeaning "The safety officer verifies zero energy at every isolation point, at most twice." ;
