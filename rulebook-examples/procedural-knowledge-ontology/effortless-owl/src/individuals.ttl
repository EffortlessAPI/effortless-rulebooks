    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=OR({{RecentDeprecationCount}} >= 2, AND({{LastMajorRevisionAt}} <> \"\", {{DaysSinceMajorRevision}} < 730))" ;
