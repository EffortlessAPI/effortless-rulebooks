    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:VocabularyTerms.ScopeNote ;
    effortless-ntwf:justification "A SKOS scope note saying how a concept is to be used, e.g. zero-energy verification is for the check after isolation, not the restart try-out." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c82-e1 a effortless-ntwf:ClaimEvidence ;
