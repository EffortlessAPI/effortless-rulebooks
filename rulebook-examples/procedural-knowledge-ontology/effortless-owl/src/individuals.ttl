    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourceRelationships.WithholdingMotive ;
    effortless-ntwf:justification "Records why a source holds information back: Ken fears documenting his die-shim tricks makes him replaceable (job security); Grace guards the go/no-go judgment that gives her release authority (status)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c37-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c37-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c37-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c37 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:DepartmentProcessAccounts.ShapingInterest ;
    effortless-ntwf:justification "Each department's account of a process carries the interest that shapes it: maintenance's twenty-minute bleed is shaped by technician safety, production's five minutes by uptime targets; engineering's ten-minute rollback by release velocity, support's hour of errors by incident load." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c38-e1 a effortless-ntwf:ClaimEvidence ;
