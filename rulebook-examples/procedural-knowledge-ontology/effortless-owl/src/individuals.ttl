    effortless-ntwf:justification "Fires on the first PKO rulebook charter, stewarded by People Operations; the model moved to the knowledge engineer, who owns the build and publication tooling." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-i29-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-i29-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-i29-e1" ;
