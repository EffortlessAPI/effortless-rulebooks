    effortless-ntwf:rulebookField effortless-ntwf:ElicitationParticipants.IsKnowledgeEngineer ;
    effortless-ntwf:justification "TRUE for Sam Adeyemi, the knowledge engineer collecting the process knowledge in the lockout workshop." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c07-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c07-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c07-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c07 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ElicitationParticipants.IsKnowledgeProducer ;
    effortless-ntwf:justification "TRUE for participants who produce the knowledge being collected, such as the technician Tomas Reyes." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

