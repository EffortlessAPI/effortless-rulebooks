    effortless-ntwf:label "Concept laddering" ;
    effortless-ntwf:methodFamily "Elicitation" ;
    effortless-ntwf:summary "Moves up by asking why something matters and down by asking how it is done, to reach goals and sub-steps." ;
    effortless-ntwf:originReference "Knowledge acquisition practice" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#KnowledgeMethod" .

