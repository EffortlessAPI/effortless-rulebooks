    effortless-ntwf:rulebookField effortless-ntwf:InterviewProbes.ShortfallAnswer ;
    effortless-ntwf:justification "Holds what the practitioner does when the standard procedure proves insufficient: on a capacitor-bank retrofit Tomas waits five minutes and re-tests before anyone reaches in." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c11-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c11-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c11-e1" ;
