    effortless-ntwf:justification "OWL 2 mapping of VocabularyTerms.SameAsIri to owl:sameAs, the identity assertion between a re-homed local term and the deprecated original." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-s14-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-s14-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-s14-e1" ;
