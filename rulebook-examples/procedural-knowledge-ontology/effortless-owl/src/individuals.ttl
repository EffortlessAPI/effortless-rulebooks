    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:TermRelations ;
    effortless-ntwf:justification "Associative relations between concepts (skos:related), e.g. change risk classification related to release approval review." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p19-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p19-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p19-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p19 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:CollectedSourceMaterials.IsModeledBeforeOrganized ;
    effortless-ntwf:justification "Fires when material was encoded into a procedure version before, or without, being organized into a scheme. The conveyor manual excerpt was imported into convmaint-v1.0.0 and never organized, so it fires; the lockout transcript and SOP excerpt were organized on 10 May and modeled on 12 May and do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p20-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p20-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p20-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p20 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Vocabularies.IsSingleKindFrame ;
    effortless-ntwf:justification "Fires when a scheme organizes several materials but only one kind of knowledge. The conveyor glossary holds two document excerpts and nothing else, so it fires; the lockout thesaurus holds transcripts, field notes, a process map and SOP excerpts in one frame and does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p21-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p21-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p21-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p21 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SituationalVariants.DivergesWithoutStatedConditions ;
    effortless-ntwf:justification "Fires when a variant departs from the standard procedure and nothing states when it applies or where it stops. The hotfix no-canary variant (scope with no conditions) and night self-verification (no scope) fire; the press-7 accumulator and EU-freeze variants state their conditions and do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p23-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p23-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p23-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p23 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:VocabularyTerms.IsOrganizedAroundOfficialTerm ;
    effortless-ntwf:justification "Fires when practitioners repeatedly use an alternative wording more than the preferred label the scheme is built around. Technicians said 'loto' three times and never 'lockout/tagout'; the release manager said 'sign-off' and 'go/no-go', never 'release approval review'. Zero-energy verification, used in its preferred wording, does not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p24-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p24-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p24-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p24 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureLensViews.IsDisconnectedSilo ;
    effortless-ntwf:justification "Fires when a stakeholder view is not projected from the procedure's current version. The lockout executive table was built from the deprecated 2019 version and the deployment executive deck is free-standing, so both fire; the trainer, auditor and AI views project the current version and do not. Multiple perspectives stay one procedure." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p25-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p25-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p25-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p25 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureTypes.IsArbitraryGrouping ;
    effortless-ntwf:justification "Fires when a grouping names no distinguishing facet, or none of its members has the distinction it names. 'Customer-Facing Support Runbook' claims audience Customers but its one member is for support staff, so it fires; Equipment Safety Procedure's members all share hazard HazardousEnergy and it does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p26-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p26-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p26-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p26 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Vocabularies.IsFrozenDespiteNewCollection ;
    effortless-ntwf:justification "Fires when material was collected after a scheme was established and the scheme was never refined. The release thesaurus (December 2025) now organizes a July 2026 event trace with no refinement, so it fires; the lockout thesaurus was refined after the process map and the night field notes and does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p27-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p27-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p27-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p27 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureLensViews.IsGranularityMisfit ;
    effortless-ntwf:justification "Fires when a view's granularity differs from what its lens's use requires. The strategic planner was given lockout at step level, and the support agent got deployment only at category level, so both fire; the trainer's step view and the executive's category view do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p28-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p28-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p28-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p28 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureVersions.MixesGranularityAtOneLevel ;
    effortless-ntwf:justification "Fires when one level of a version mixes whole activities with single actions. The 2019 lockout checklist puts 'Do the maintenance' (an Activity) beside 'Apply locks' and 'Disconnect power' (Actions), so it fires; loto-v2.0.0 keeps its actions as sub-steps and does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p34-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p34-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p34-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p34 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Vocabularies.OntologyPrecededVocabularyControl ;
    effortless-ntwf:justification "Fires when ontology modeling for a domain began before its vocabulary control was established. Release modeling started 3 November 2025 and the release thesaurus was established 10 December, so it fires; lockout vocabulary (1 May) preceded its modeling (12 May) and does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p35-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p35-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p35-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p35 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Procedures.IsInconsistentlyCategorized ;
    effortless-ntwf:justification "Fires when a procedure has no type, is filed at domain or group rank rather than a process type, or its type is undefined. The new forklift inspection was filed straight under the Operations domain, so it fires; its peers sit at defined process types and do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p36-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p36-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p36-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p36 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourceTermMentions.IsUncontrolledWording ;
    effortless-ntwf:justification "Fires when a wording found in collected material resolves to no label in its scheme. The runbook's 'release gate check' (the same review as sign-off) fires; 'sign-off' and 'go/no-go' resolve through alternative labels to Release Approval Review and do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p37-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p37-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p37-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p37 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Roles.IsMissedByPhraseQuery ;
    effortless-ntwf:justification "Fires when a role is mentioned in some process material in words the role vocabulary does not resolve, so a query through the vocabulary misses that process. The night field notes say 'the tech', so Maintenance Technician fires; 'release captain' resolves to Release Manager and 'safety lead' to Plant Safety Officer, which do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p38-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p38-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p38-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p38 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureTypes.IsUnreachableByNavigation ;
    effortless-ntwf:justification "Fires when navigating down from the functional domains never reaches a taxonomy node. The Metrology group hangs off no domain, so it and Instrument Calibration Procedure beneath it fire; every other node is reachable and does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-q09-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-q09-e1" ;
