effortless-ntwf:q8-safety-context-scoping a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-safety-context-scoping" ;
    effortless-ntwf:roleQuestionId "q8-safety-context-scoping" ;
    effortless-ntwf:askingRole effortless-ntwf:plant-safety-officer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Where a step matters differently depending on who does it, what is on hand or what is going on, does the procedure say where that holds?" ;
