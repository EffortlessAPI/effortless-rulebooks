effortless-ntwf:vt-energy-control a effortless-ntwf:VocabularyTerms ;
    effortless-ntwf:__key "vt-energy-control" ;
    effortless-ntwf:vocabularyTermId "vt-energy-control" ;
    effortless-ntwf:vocabulary effortless-ntwf:voc-lockout-activities ;
    effortless-ntwf:prefLabel "Hazardous Energy Control" ;
    effortless-ntwf:altLabels "energy control" ;
