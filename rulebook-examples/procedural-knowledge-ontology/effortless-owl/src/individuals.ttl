    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:AgentIntegrations ;
    effortless-ntwf:justification "The central registry of agent integrations: agent, knowledge system, pathway, served snapshot, delivery mode and registry entry key." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c41-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c41-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c41-e1" ;
