    effortless-ntwf:rulebookField effortless-ntwf:InterviewProbes.WhyAnswer ;
    effortless-ntwf:justification "Holds the reason a practitioner gave when an interview asked why they make a choice: Tomas waits before bleeding again because the press 3 accumulator refills from the dryer." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c10-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c10-e1" ;
