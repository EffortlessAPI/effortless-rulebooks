    effortless-ntwf:__key "ont4-q04-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-q04-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-q04 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-ont4-q04 ;
    effortless-ntwf:justification "Asks which steps are affected, transitively along the artifact flow, if the agent moves to a newer model version." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-q06-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-q06-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-q06-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-q06 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-ont4-q06 ;
    effortless-ntwf:justification "Asks which current assignment covers a role that approval steps are assigned to, i.e. who approval notices go to now." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

