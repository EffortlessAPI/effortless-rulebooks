    effortless-ntwf:__key "fm-loto06-residual" ;
    effortless-ntwf:failureModeId "fm-loto06-residual" ;
    effortless-ntwf:step effortless-ntwf:loto-06 ;
    effortless-ntwf:description "Residual stored energy remains after isolation." ;
    effortless-ntwf:response "Keep every lock on, stop, escalate and re-isolate." ;
    effortless-ntwf:requiresEscalation true ;
    effortless-ntwf:escalateToRole effortless-ntwf:plant-safety-officer ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#FailureMode" .

