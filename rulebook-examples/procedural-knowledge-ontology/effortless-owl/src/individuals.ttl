    effortless-ntwf:conformanceSubstrateId "effortless-postgres" ;
    effortless-ntwf:label "PostgreSQL" ;
    effortless-ntwf:transpiler "rulebook-to-postgres" ;
    effortless-ntwf:outputFolder "/postgres-bootstrap" ;
    effortless-ntwf:engine "PostgreSQL views and calc_* SQL functions" ;
    effortless-ntwf:howItComputes "rulebook-to-postgres emits a table, a set of calc_* functions and a vw_<entity> view per table. The database is reset from the rulebook, and the harness reads SELECT * from every view." ;
    effortless-ntwf:role "graded" ;
    effortless-ntwf:sortOrder 1 ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ConformanceSubstrate" .

effortless-ntwf:effortless-python a effortless-ntwf:ConformanceSubstrates ;
    effortless-ntwf:__key "effortless-python" ;
    effortless-ntwf:conformanceSubstrateId "effortless-python" ;
    effortless-ntwf:label "Python" ;
    effortless-ntwf:transpiler "rulebook-to-python" ;
    effortless-ntwf:outputFolder "/effortless-python" ;
    effortless-ntwf:engine "CPython" ;
    effortless-ntwf:howItComputes "rulebook-to-python emits an SDK with one computed property per derived field. The harness loads the blank test rows (raw fields only) and asks the SDK for every derived value." ;
    effortless-ntwf:role "graded" ;
    effortless-ntwf:sortOrder 2 ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ConformanceSubstrate" .

effortless-ntwf:effortless-golang a effortless-ntwf:ConformanceSubstrates ;
    effortless-ntwf:__key "effortless-golang" ;
    effortless-ntwf:conformanceSubstrateId "effortless-golang" ;
    effortless-ntwf:label "Go" ;
    effortless-ntwf:transpiler "rulebook-to-go" ;
    effortless-ntwf:outputFolder "/effortless-golang" ;
    effortless-ntwf:engine "Go toolchain (compiled)" ;
    effortless-ntwf:howItComputes "rulebook-to-go emits a Go module. The harness compiles it with go build, runs it over the blank test rows, and reads back every derived value." ;
    effortless-ntwf:role "graded" ;
    effortless-ntwf:sortOrder 3 ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ConformanceSubstrate" .

effortless-ntwf:effortless-typescript a effortless-ntwf:ConformanceSubstrates ;
    effortless-ntwf:__key "effortless-typescript" ;
    effortless-ntwf:conformanceSubstrateId "effortless-typescript" ;
    effortless-ntwf:label "TypeScript" ;
    effortless-ntwf:transpiler "rulebook-to-typescript" ;
    effortless-ntwf:outputFolder "/effortless-typescript" ;
    effortless-ntwf:engine "Node.js running tsc output" ;
    effortless-ntwf:howItComputes "rulebook-to-typescript emits a typed SDK. The harness compiles it with tsc and runs it on Node over the blank test rows." ;
    effortless-ntwf:role "graded" ;
    effortless-ntwf:sortOrder 4 ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ConformanceSubstrate" .

effortless-ntwf:effortless-entity-framework a effortless-ntwf:ConformanceSubstrates ;
    effortless-ntwf:__key "effortless-entity-framework" ;
    effortless-ntwf:conformanceSubstrateId "effortless-entity-framework" ;
    effortless-ntwf:label "C# / Entity Framework" ;
    effortless-ntwf:transpiler "rulebook-to-entity-framework" ;
    effortless-ntwf:outputFolder "/effortless-entity-framework" ;
    effortless-ntwf:engine ".NET (C# Formula* properties)" ;
    effortless-ntwf:howItComputes "rulebook-to-entity-framework emits C# data classes whose Formula* properties compute derived fields. The harness compiles them with EF Core into a runner, loads the blank test rows into the generated context over a throwaway SQLite database, and reads every computed property back per row." ;
    effortless-ntwf:role "graded" ;
    effortless-ntwf:sortOrder 5 ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ConformanceSubstrate" .

effortless-ntwf:effortless-xlsx a effortless-ntwf:ConformanceSubstrates ;
    effortless-ntwf:__key "effortless-xlsx" ;
    effortless-ntwf:conformanceSubstrateId "effortless-xlsx" ;
    effortless-ntwf:label "Excel" ;
    effortless-ntwf:transpiler "rulebook-to-xlsx" ;
    effortless-ntwf:outputFolder "/effortless-xlsx" ;
    effortless-ntwf:engine "Spreadsheet formulas (cached values read with openpyxl)" ;
    effortless-ntwf:howItComputes "rulebook-to-xlsx compiles every formula into a real Excel formula over cells in the same workbook. The harness reads the workbook's cached values, after a LibreOffice recalc when LibreOffice is installed; a value that was never calculated reads as blank." ;
    effortless-ntwf:role "graded" ;
    effortless-ntwf:sortOrder 6 ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ConformanceSubstrate" .

effortless-ntwf:effortless-owl a effortless-ntwf:ConformanceSubstrates ;
    effortless-ntwf:__key "effortless-owl" ;
    effortless-ntwf:conformanceSubstrateId "effortless-owl" ;
    effortless-ntwf:label "OWL / SHACL" ;
    effortless-ntwf:transpiler "rulebook-to-owl" ;
    effortless-ntwf:outputFolder "/effortless-owl" ;
    effortless-ntwf:engine "SPARQL 1.1 (pyoxigraph) executing SHACL-AF rules" ;
    effortless-ntwf:howItComputes "rulebook-to-owl emits an ontology, an ABox of individuals carrying raw fields only, and one SHACL-AF SPARQL rule per derived field. The harness executes the rules in dependency order and reads the inferred triples back." ;
    effortless-ntwf:role "graded" ;
    effortless-ntwf:sortOrder 7 ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ConformanceSubstrate" .

