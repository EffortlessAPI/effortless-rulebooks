    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ElicitationSessions.IsInterviewWithoutWhyProbe ;
    effortless-ntwf:justification "Fires on an interview that never asked why a choice is made: the policy interview, which has no probes; it does not fire on the lockout and deployment interviews, which both asked why." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p04-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p04-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p04-e1" ;
