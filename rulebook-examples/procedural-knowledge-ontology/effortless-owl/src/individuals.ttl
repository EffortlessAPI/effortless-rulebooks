    effortless-ntwf:askingRole effortless-ntwf:release-manager ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-11 ;
    effortless-ntwf:questionText "Which live AI deployments are only a registry row, with no role, step or artifact connecting them to our workflows?" ;
