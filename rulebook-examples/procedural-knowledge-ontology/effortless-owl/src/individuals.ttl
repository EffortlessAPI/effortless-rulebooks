    effortless-ntwf:witnessedAnswer "KnowledgeTraces.IsUnfaithfulToSource=1/15" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q13-knowledge-engineer-evidence-kind a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q13-knowledge-engineer-evidence-kind" ;
    effortless-ntwf:roleQuestionId "q13-knowledge-engineer-evidence-kind" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "Is each claim cited to the kind of evidence that can support it: interviews for how a step is described, observation for workarounds, logs for what really ran?" ;
    effortless-ntwf:whyItMatters "A claim about real execution that rests on an interview is hearsay, however confident the speaker." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "CollectedSourceMaterials.IsPracticeEvidence=4/15; KnowledgeTraces.IsAspectUnsupportedBySourceKind=1/15; KnowledgeTraces.SourceIsPracticeEvidence=2/15" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:aq-pkm1-q08 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm1-q08" ;
    effortless-ntwf:roleQuestionId "aq-pkm1-q08" ;
    effortless-ntwf:askingRole effortless-ntwf:internal-compliance-auditor ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "For this knowledge item, where did it come from, how was it produced, and who confirmed it?" ;
    effortless-ntwf:whyItMatters "An auditor cannot rely on an item whose origin, route or confirmation is missing." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "KnowledgeTraces.HasIncompleteProvenance=1/15" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:aq-pkm2-q38 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm2-q38" ;
    effortless-ntwf:roleQuestionId "aq-pkm2-q38" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-authority ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "How was this piece of knowledge derived, and by a person or by a machine?" ;
    effortless-ntwf:whyItMatters "Knowledge a machine extracted needs a different kind of review from knowledge a person paraphrased." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "KnowledgeTraces.IsMachineDerived=1/15" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:aq-pkm2-q39 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm2-q39" ;
    effortless-ntwf:roleQuestionId "aq-pkm2-q39" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-authority ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "Who validated this piece of knowledge, and was it someone other than the person who derived it?" ;
    effortless-ntwf:whyItMatters "A derivation confirmed only by its own author has not been independently validated." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "KnowledgeTraces.IsSelfValidated=1/15" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q13-knowledge-engineer-document-starting-point a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q13-knowledge-engineer-document-starting-point" ;
    effortless-ntwf:roleQuestionId "q13-knowledge-engineer-document-starting-point" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "For steps we took from existing documents, has capture from the people who do the work since confirmed them, and added what the documents leave out?" ;
    effortless-ntwf:whyItMatters "Documents describe the prescribed process; only people who perform it can confirm it and supply what is missing." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "CollectedSourceMaterials.IsDocumentSource=5/15; CollectedSourceMaterials.IsPeopleCapture=7/15; KnowledgeTraces.IsDocumentOrigin=8/15; KnowledgeTraces.IsDocumentStartNeverExtended=3/15; KnowledgeTraces.IsDocumentStartNeverValidated=2/15; KnowledgeTraces.SourceIsDocument=8/15; KnowledgeTraces.SourceIsPeopleCapture=6/15" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:aq-pkm4-q13 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm4-q13" ;
    effortless-ntwf:roleQuestionId "aq-pkm4-q13" ;
    effortless-ntwf:askingRole effortless-ntwf:plant-operations-manager ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "Which of our procedures are documented in a way that trails how they are actually performed?" ;
    effortless-ntwf:whyItMatters "Operators follow the practice; auditors and new hires follow the document. Where they differ, one of them is wrong." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "KnowledgeTraces.IsDocumentTrailingPractice=1/15; ProcedureVersions.IsDocumentedBehindPractice=1/9; Resources.IsBehindCurrentPractice=1/19" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q13-knowledge-engineer-mining-complement a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q13-knowledge-engineer-mining-complement" ;
    effortless-ntwf:roleQuestionId "q13-knowledge-engineer-mining-complement" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "Where mining found cases that did not follow the procedure, have we asked experienced workers why?" ;
    effortless-ntwf:whyItMatters "An event log shows what was done, never the reasoning or tacit judgment behind it." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "CollectedSourceMaterials.HoldsReasoningOrTacitKnowledge=4/15; ProcessMiningRuns.IsDeviationUnexplainedByPeople=3/5" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:aq-pkm1-q13 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm1-q13" ;
    effortless-ntwf:roleQuestionId "aq-pkm1-q13" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "Which hand-offs in the flow mined from our event logs are not in the process logic we intended?" ;
    effortless-ntwf:whyItMatters "A path the model does not contain is either an undocumented practice or a control being bypassed." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "MinedFlowEdges.IsUndocumentedPath=2/6" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:aq-pkm2-q15 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm2-q15" ;
    effortless-ntwf:roleQuestionId "aq-pkm2-q15" ;
    effortless-ntwf:askingRole effortless-ntwf:release-manager ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "In which of our procedures does the process as enacted deviate from the documented one?" ;
    effortless-ntwf:whyItMatters "A release process that is enacted differently from its documentation is not governed by it." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "ProcessMiningRuns.HasUndocumentedEnactedPath=1/5" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:aq-pkm2-q16 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm2-q16" ;
    effortless-ntwf:roleQuestionId "aq-pkm2-q16" ;
    effortless-ntwf:askingRole effortless-ntwf:release-manager ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "Where in the mined release flow do cases sit waiting far longer than the next step should take?" ;
    effortless-ntwf:whyItMatters "Waiting is where release lead time goes, and where people start looking for a way around the gate." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "MinedFlowEdges.IsBottleneck=1/6" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q13-knowledge-authority-mined-versus-intended a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q13-knowledge-authority-mined-versus-intended" ;
    effortless-ntwf:roleQuestionId "q13-knowledge-authority-mined-versus-intended" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-authority ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "Has any mined behavior been recorded as intended process logic without anyone deciding that it should be?" ;
    effortless-ntwf:whyItMatters "A log records what happened, not what should happen; promoting it silently makes a workaround normative." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "MinedFlowEdges.IsMinedPathRecordedAsIntentWithoutDecision=1/6" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:aq-pkm1-q09 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm1-q09" ;
    effortless-ntwf:roleQuestionId "aq-pkm1-q09" ;
    effortless-ntwf:askingRole effortless-ntwf:process-steward ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "Which stakeholder perspectives on this process conflict, and which collected material does each come from?" ;
    effortless-ntwf:whyItMatters "Legitimate disagreement is information about the process; its source tells us whose experience it reflects." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "StakeholderPerspectives.IsInConflict=4/5" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q13-process-steward-dissent-kept a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q13-process-steward-dissent-kept" ;
    effortless-ntwf:roleQuestionId "q13-process-steward-dissent-kept" ;
    effortless-ntwf:askingRole effortless-ntwf:process-steward ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "Did we collapse a legitimate disagreement into one agreed version, or keep a dissenting view without its source?" ;
    effortless-ntwf:whyItMatters "Forcing consensus discards the knowledge of whoever lost the argument." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "StakeholderPerspectives.IsDissentingViewNotKeptWithSource=1/5" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q13-process-steward-capture-in-work a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q13-process-steward-capture-in-work" ;
    effortless-ntwf:roleQuestionId "q13-process-steward-capture-in-work" ;
    effortless-ntwf:askingRole effortless-ntwf:process-steward ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "For which procedures do we only collect knowledge in separate exercises and never while the work is being done?" ;
    effortless-ntwf:whyItMatters "Capture that waits for a workshop loses what people notice in the moment." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "CollectedSourceMaterials.IsCapturedInFlowOfWork=1/15; Procedures.IsCaptureSeparateFromWork=2/10" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q13-process-steward-collection-occasions a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q13-process-steward-collection-occasions" ;
    effortless-ntwf:roleQuestionId "q13-process-steward-collection-occasions" ;
    effortless-ntwf:askingRole effortless-ntwf:process-steward ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "Are our retrospectives, process reviews and improvement initiatives held on cadence, and does what they surface get collected?" ;
    effortless-ntwf:whyItMatters "A recurring occasion that is skipped, or held and not captured, is a collection channel that has quietly closed." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "CollectionOccasions.IsHeldWithoutCapture=1/3; CollectionOccasions.IsLapsed=1/3" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q13-knowledge-engineer-feedback-into-collection a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q13-knowledge-engineer-feedback-into-collection" ;
    effortless-ntwf:roleQuestionId "q13-knowledge-engineer-feedback-into-collection" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "When a practitioner's feedback reveals know-how the procedure lacks, did it prompt us to go and collect it?" ;
    effortless-ntwf:whyItMatters "Feedback is the cheapest discovery channel for tacit knowledge; unfollowed, it is lost with the ticket." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "UserFeedback.IsTacitSignalNotFedIntoCollection=1/6; UserFeedback.RevealsTacitKnowledge=2/6" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q13-knowledge-engineer-acquisition-cost a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q13-knowledge-engineer-acquisition-cost" ;
    effortless-ntwf:roleQuestionId "q13-knowledge-engineer-acquisition-cost" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "How many hours of our domain experts' time has capturing each procedure's knowledge taken?" ;
    effortless-ntwf:whyItMatters "Acquisition is paid for in expert time, by people whose job is not knowledge modeling." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:aq-pkm3-q11 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm3-q11" ;
    effortless-ntwf:roleQuestionId "aq-pkm3-q11" ;
    effortless-ntwf:askingRole effortless-ntwf:plant-safety-officer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "How has this procedure failed before, how was each failure recorded, and what redesign followed?" ;
    effortless-ntwf:whyItMatters "A failure that is recorded but never fed into a redesign will happen again at the next run." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "IssueOccurrences.IsFailureWithoutLandedRedesign=3/4" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q13-knowledge-authority-tacit-behind-compliance a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q13-knowledge-authority-tacit-behind-compliance" ;
    effortless-ntwf:roleQuestionId "q13-knowledge-authority-tacit-behind-compliance" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-authority ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-13 ;
    effortless-ntwf:questionText "Which procedures did we standardize for compliance without capturing the tacit knowledge that makes them work?" ;
    effortless-ntwf:whyItMatters "A compliant document does not carry the judgment of the people who perform it." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "ProcedureVersions.IsStandardizedWithoutTacitCapture=1/9" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q14-authority-use-case a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q14-authority-use-case" ;
    effortless-ntwf:roleQuestionId "q14-authority-use-case" ;
    effortless-ntwf:askingRole effortless-ntwf:ontology-authority ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-14 ;
    effortless-ntwf:questionText "Which models were built without a concrete use case behind them?" ;
    effortless-ntwf:whyItMatters "A model with no use case has no way to know when it is finished or wrong." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "GovernedModels.IsWithoutOriginatingUseCase=2/7" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q14-authority-pilots a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q14-authority-pilots" ;
    effortless-ntwf:roleQuestionId "q14-authority-pilots" ;
    effortless-ntwf:askingRole effortless-ntwf:ontology-authority ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-14 ;
    effortless-ntwf:questionText "Which models were adopted without ever being tried out in a pilot?" ;
    effortless-ntwf:whyItMatters "A pilot is where a model meets practice; skipping it moves the first test into production." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "GovernedModels.IsAdoptedWithoutPilot=3/7" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q14-ke-experts-throughout a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q14-ke-experts-throughout" ;
    effortless-ntwf:roleQuestionId "q14-ke-experts-throughout" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-14 ;
    effortless-ntwf:questionText "Did domain experts take part in every LOT activity of each model, or only at the start?" ;
    effortless-ntwf:whyItMatters "Experts who help write requirements but never see the implementation cannot catch it drifting from practice." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "GovernedModels.ExpertsNotInvolvedThroughout=3/7" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q14-ke-real-data a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q14-ke-real-data" ;
    effortless-ntwf:roleQuestionId "q14-ke-real-data" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-14 ;
    effortless-ntwf:questionText "Which models were implemented against the organization's real records, and which only on synthetic data or not at all?" ;
    effortless-ntwf:whyItMatters "An ontology that has only ever held invented data has never been tested against what the organization actually records." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "GovernedModels.IsImplementedWithoutRealData=3/7" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

