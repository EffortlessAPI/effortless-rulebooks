effortless-ntwf:q8-ke-faceted-groupings a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-ke-faceted-groupings" ;
    effortless-ntwf:roleQuestionId "q8-ke-faceted-groupings" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Does each grouping in the taxonomy name the facet that distinguishes it, and do its members actually share that distinction?" ;
    effortless-ntwf:whyItMatters "A grouping whose members lack the distinction it claims is a convenience bucket; it will mislead everyone who navigates by it." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "ProcedureTypes.IsArbitraryGrouping=1/17; Procedures.LacksTypeDistinction=2/10" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-ke-skos-structure a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-ke-skos-structure" ;
    effortless-ntwf:roleQuestionId "q8-ke-skos-structure" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Is every concept placed in its scheme with a definition, a scope note, a direct broader concept and its associative relations, and is any direct link really an indirect one?" ;
    effortless-ntwf:whyItMatters "A broader link that skips a level asserts a hierarchy the scheme does not have and double-counts every query that walks it." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "TermRelations.AssertsIndirectLinkAsDirect=1/4" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-steward-vocabulary-coverage a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-steward-vocabulary-coverage" ;
    effortless-ntwf:roleQuestionId "q8-steward-vocabulary-coverage" ;
    effortless-ntwf:askingRole effortless-ntwf:process-steward ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Does every procedure with steps have a controlled vocabulary whose metadata, its governing role and establishment, is managed?" ;
    effortless-ntwf:whyItMatters "A glossary nobody governs is a document, not vocabulary control." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "Procedures.LacksManagedControlledVocabulary=1/10" ;
