    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourceRelationships.TrustLevel ;
    effortless-ntwf:justification "The state of trust between the knowledge engineer and each source: Established with Tomas and Lin, Building with Grace, Low with Ken." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c39-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c39-e1" ;
