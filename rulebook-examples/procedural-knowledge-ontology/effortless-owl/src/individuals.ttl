    effortless-ntwf:rulebookField effortless-ntwf:AiRegistryModelVersions.IsLiveButUnregisteredInGraph ;
    effortless-ntwf:justification "Fires for a model version running in production that no agent individual in the graph represents: release-notes-writer 1.1.0; the risk classifier versions and health checker are individuals, and the retired 2.3.0 is not live." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-p71-e1 a effortless-ntwf:ClaimEvidence ;
