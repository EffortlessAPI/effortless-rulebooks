    effortless-ntwf:rulebookTable effortless-ntwf:AiAdoptionInitiatives ;
    effortless-ntwf:justification "Each initiative joins the people (sponsoring organization), the process and procedure it targets, and the AI technology, and records when the workflow redesign for AI started, which is the end-to-end workflow the article means." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c33-e1 a effortless-ntwf:ClaimEvidence ;
