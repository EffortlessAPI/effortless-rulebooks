    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeBrokerLinks.TranslationBetweenVocabularies ;
    effortless-ntwf:justification "The broker's translation between the words of the two communities a link connects, e.g. production's 'line stop' (plant quality vocabulary) = maintenance's 'energy isolation' (lockout vocabulary), and support's 'outage' = release engineering's 'rollback'." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c36-e1 a effortless-ntwf:ClaimEvidence ;
