    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "={{Justification}} <> \"\"" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ClaimEvidence.IsWitnessProof a effortless-ntwf:RulebookFields ;
    effortless-ntwf:__key "ClaimEvidence.IsWitnessProof" ;
    effortless-ntwf:rulebookFieldId "ClaimEvidence.IsWitnessProof" ;
    effortless-ntwf:targetTable "ClaimEvidence" ;
    effortless-ntwf:fieldName "IsWitnessProof" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{EvidenceKind}} = \"Field\", {{FieldCatalogName}} <> \"\", {{FieldIsWitness}}, {{FieldIsDiscriminating}})" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ClaimEvidence.IsStructuralProof a effortless-ntwf:RulebookFields ;
    effortless-ntwf:__key "ClaimEvidence.IsStructuralProof" ;
    effortless-ntwf:rulebookFieldId "ClaimEvidence.IsStructuralProof" ;
    effortless-ntwf:targetTable "ClaimEvidence" ;
    effortless-ntwf:fieldName "IsStructuralProof" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=OR(AND({{EvidenceKind}} = \"Table\", {{TableHasRows}}), AND({{EvidenceKind}} = \"Field\", {{FieldCatalogName}} <> \"\", {{FieldHasData}}))" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ClaimEvidence.IsQuestionProof a effortless-ntwf:RulebookFields ;
    effortless-ntwf:__key "ClaimEvidence.IsQuestionProof" ;
    effortless-ntwf:rulebookFieldId "ClaimEvidence.IsQuestionProof" ;
    effortless-ntwf:targetTable "ClaimEvidence" ;
    effortless-ntwf:fieldName "IsQuestionProof" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{EvidenceKind}} = \"RoleQuestion\", {{QuestionIsAnswered}}, {{QuestionWitnessedAnswer}} <> \"\")" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ClaimEvidence.IsStandardProof a effortless-ntwf:RulebookFields ;
    effortless-ntwf:__key "ClaimEvidence.IsStandardProof" ;
    effortless-ntwf:rulebookFieldId "ClaimEvidence.IsStandardProof" ;
    effortless-ntwf:targetTable "ClaimEvidence" ;
    effortless-ntwf:fieldName "IsStandardProof" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=OR(AND({{EvidenceKind}} = \"OntologyProfile\", {{ProfileMappingCount}} > 0), AND({{EvidenceKind}} = \"KnowledgeMethod\", {{MethodIsApplied}}))" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ClaimEvidence.IsScenarioProof a effortless-ntwf:RulebookFields ;
    effortless-ntwf:__key "ClaimEvidence.IsScenarioProof" ;
    effortless-ntwf:rulebookFieldId "ClaimEvidence.IsScenarioProof" ;
    effortless-ntwf:targetTable "ClaimEvidence" ;
    effortless-ntwf:fieldName "IsScenarioProof" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{EvidenceKind}} = \"Procedure\", {{ProcedureExecutionCount}} > 0)" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ClaimEvidence.IsValid a effortless-ntwf:RulebookFields ;
    effortless-ntwf:__key "ClaimEvidence.IsValid" ;
    effortless-ntwf:rulebookFieldId "ClaimEvidence.IsValid" ;
    effortless-ntwf:targetTable "ClaimEvidence" ;
    effortless-ntwf:fieldName "IsValid" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{HasJustification}}, OR(AND(OR({{ClaimKind}} = \"Prescription\", {{ClaimKind}} = \"Illustration\"), {{IsWitnessProof}}), AND({{ClaimKind}} = \"Concept\", {{IsStructuralProof}}), AND({{ClaimKind}} = \"CompetencyQuestion\", {{IsQuestionProof}}), AND({{ClaimKind}} = \"Standard\", {{IsStandardProof}}), AND({{ClaimKind}} = \"Scenario\", {{IsScenarioProof}})))" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ClaimEvidence.IsContested a effortless-ntwf:RulebookFields ;
    effortless-ntwf:__key "ClaimEvidence.IsContested" ;
