effortless-ntwf:q6-safety-unisolated-energy a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q6-safety-unisolated-energy" ;
    effortless-ntwf:roleQuestionId "q6-safety-unisolated-energy" ;
