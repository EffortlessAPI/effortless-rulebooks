    effortless-ntwf:procedureTarget effortless-ntwf:target-loto-press7 ;
    effortless-ntwf:description "The retrofitted press carries an accumulator the standard map omits." ;
    effortless-ntwf:response "Use the press-7 isolation map and bleed the accumulator before isolation." ;
    effortless-ntwf:requiresEscalation true ;
    effortless-ntwf:escalateToRole effortless-ntwf:plant-safety-officer ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#FailureMode" .

