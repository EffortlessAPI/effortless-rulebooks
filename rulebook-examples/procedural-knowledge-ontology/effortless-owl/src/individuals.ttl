    effortless-ntwf:justification "Each assignment-update policy for roles operational systems route from states the hours within which an update must be completed (24 for release approvers, 72 for AI agent fills, 0 where none is defined)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-p70-e1 a effortless-ntwf:ClaimEvidence ;
