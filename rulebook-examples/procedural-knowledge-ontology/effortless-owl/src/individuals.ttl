    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm3-q02 ;
    effortless-ntwf:justification "Asks, per audited knowledge area, what is needed against what is held, and whether a shortfall is a provider dependency or a coverage gap." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-q03-e1 a effortless-ntwf:ClaimEvidence ;
