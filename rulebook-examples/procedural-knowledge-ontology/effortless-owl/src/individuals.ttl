    effortless-ntwf:targetTable "ProcedureExecutions" ;
    effortless-ntwf:fieldName "AttestationWouldBeWeaklyBased" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{IsAttestationReady}}, OR({{InterestedPartyAssertionCount}} > 0, {{ComputedAssuranceRatio}} < 0.5))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-cfo-quality-of-a-green-attestation ;
    effortless-ntwf:measuredSubstantiveCount 0 ;
    effortless-ntwf:measuredDistinctValueCount 1 ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

