    effortless-ntwf:articleClaim effortless-ntwf:ont4-s08 ;
    effortless-ntwf:evidenceKind "OntologyProfile" ;
    effortless-ntwf:ontologyProfile effortless-ntwf:foaf-0-99 ;
    effortless-ntwf:justification "FOAF 0.99 is a recorded dependency with a mapping (Agents.DisplayName to foaf:name) and adopted terms in ExternalStandardTerms." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-s09-e1 a effortless-ntwf:ClaimEvidence ;
