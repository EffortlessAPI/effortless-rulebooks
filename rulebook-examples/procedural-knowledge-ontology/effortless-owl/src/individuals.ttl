    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Procedures.HasNoExplicitSteps ;
    effortless-ntwf:justification "TRUE for procedures such as the press-7 changeover and accumulator bleed-down that exist only as a title and documents, with no formal step representation to ground an AI." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c39-e1 a effortless-ntwf:ClaimEvidence ;
