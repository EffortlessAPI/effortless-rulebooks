effortless-ntwf:ProcedureExecutions.AssuranceGrade a effortless-ntwf:RulebookFields ;
    effortless-ntwf:__key "ProcedureExecutions.AssuranceGrade" ;
    effortless-ntwf:rulebookFieldId "ProcedureExecutions.AssuranceGrade" ;
    effortless-ntwf:targetTable "ProcedureExecutions" ;
    effortless-ntwf:fieldName "AssuranceGrade" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "string" ;
    effortless-ntwf:formula "=IF({{EvaluatedControlCount}} = 0, \"None: no blocking control was evaluated.\", IF({{InterestedPartyAssertionCount}} > 0, \"Weak: at least one control rests on an interested-party assertion.\", IF({{ComputedAssuranceRatio}} < 0.5, \"Thin: most controls rest on human assertion.\", IF({{ComputedAssuranceRatio}} < 1, \"Mixed: computed and asserted controls.\", \"Computed: every evaluated control has a witness.\"))))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-cfo-quality-of-a-green-attestation ;
    effortless-ntwf:measuredSubstantiveCount 10 ;
    effortless-ntwf:measuredDistinctValueCount 2 ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

