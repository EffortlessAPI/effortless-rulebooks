    effortless-ntwf:ontologyProfile effortless-ntwf:rdfs-1-1 ;
    effortless-ntwf:justification "RDF Schema mappings: ProcedureTypes.Label to rdfs:label and ProcedureTypes.Definition to rdfs:comment for term names and definitions." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-s12-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-s12-e1" ;
