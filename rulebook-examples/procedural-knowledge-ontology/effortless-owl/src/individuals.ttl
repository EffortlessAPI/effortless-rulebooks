# === Individuals: ClaimEvidence ===

effortless-ntwf:pkm1-c04-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c04-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c04-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c04 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeFragments.CognitiveBasis ;
    effortless-ntwf:justification "Each fragment records whether it rests on intuition, pattern recognition or judgment (tacit) or was articulated outright (explicit): the bleed cue is PatternRecognition, the retrofit zero-reading distrust is Intuition, the retyped manual note is Articulated." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c05-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c05-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c05-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c05 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureVersions.JudgmentHeldOutsideSopCount ;
    effortless-ntwf:justification "Counts the version's unformalized knowledge that its written SOP says nothing about; the four-step loto-v1.0.0 SOP left four pieces of expert handling outside it, and even loto-v2.0.0 still leaves one." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c06-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c06-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c06-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c06 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeHoldings.IsVeteranDiscretion ;
    effortless-ntwf:justification "TRUE where a veteran resolves an exception or discretionary decision that nothing written encodes: Tomas's bleed cue and Victor's twin-drive isolation before v2, and Tomas's distrust of zero readings on retrofits still today." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c15-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c15-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c15-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c15 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeConversions.ConversionMode ;
    effortless-ntwf:justification "Records each shift of the lockout bleed knowledge by mode: socialization (Ken learning beside Tomas), externalization (the cue stated in an interview), combination (merged into the v2 rulebook) and internalization (Aisha rehearsing it)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c28-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c28-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c28-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c28 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeFragments.TacitnessDegree ;
    effortless-ntwf:justification "Places each fragment on a 1-5 spectrum from fully articulated to not articulable instead of a binary: the manual note is 1, the shift hand-off 2, the twin-drive rule 3, the bleed cue 4, the retrofit zero-reading distrust 5." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p01-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p01-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p01-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p01 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeFragments.IsFlattenedToBrittleRule ;
    effortless-ntwf:justification "Fires when tacit or situated knowledge was encoded as a hard rule with no conditions saying when it holds. It fires on 'Always isolate both drives of mixer 2', which reduced Victor's judgment about retrofits to one machine's name; it does not fire on the bleed cue, encoded as guidance with its conditions, nor on the explicit manual note." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p04-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p04-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p04-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p04 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ElicitationSessions.IsGenericOrUnskilledCapture ;
    effortless-ntwf:justification "Fires when a session captured knowledge with a method outside the elicitation family or without the organization's knowledge engineer running it. It fires on the three earlier sessions a finance analyst, a communications manager and a policy owner ran, and on none of the lockout sessions Sam Adeyemi ran with elicitation methods." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p05-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p05-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p05-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p05 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeFragments.RestsOnSingleDataPoint ;
    effortless-ntwf:justification "Fires on approved knowledge that no second session or practitioner supports. It fires on the mixer 2 twin-drive rule, whose only other data point (Ken in think-aloud) disagrees, and on the retyped manual note; it does not fire on the bleed cue, corroborated by shadowing and by an incident, nor on the shift hand-off corroborated in the workshop." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-s07-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-s07-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-s07-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-s07 ;
    effortless-ntwf:evidenceKind "KnowledgeMethod" ;
    effortless-ntwf:knowledgeMethod effortless-ntwf:SeciConversion ;
    effortless-ntwf:justification "Applied by method application ma7-loto-seci, which typed the lockout bleed knowledge's conversions by SECI mode in KnowledgeConversions." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-s08-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-s08-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-s08-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-s08 ;
    effortless-ntwf:evidenceKind "KnowledgeMethod" ;
    effortless-ntwf:knowledgeMethod effortless-ntwf:PolanyiTacitExplicitDistinction ;
    effortless-ntwf:justification "Applied by method application ma7-loto-polanyi, which classified the lockout fragments and knowledge holdings as tacit or explicit before loto-v2.0.0 was encoded." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c01-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c01-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c01-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c01 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeFragments.LostInTranslation ;
    effortless-ntwf:justification "Records, for each elicited fragment, what its explicit statement fails to carry of the practice: the pitch change behind the bleed cue, Victor's reasons behind the twin-drive rule, what makes Tomas distrust a zero reading." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c02-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c02-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c02-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c02 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:PractitionerExpertise.UnstatedBasis ;
    effortless-ntwf:justification "Records, as a property of the practitioner holding the expertise, the basis they could not put into words: Tomas knows a bleed has not taken before the gauge settles and cannot say what in the sound tells him." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c03-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c03-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c03-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c03 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeMethods.ElicitationTradeoff ;
    effortless-ntwf:justification "States for each elicitation method what it gives up and for what: interviews give up accuracy for practicality, shadowing gives up reach for depth, workshops give up depth for reach, critical incidents give up accuracy for practicality." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c04-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c04-e1" ;
