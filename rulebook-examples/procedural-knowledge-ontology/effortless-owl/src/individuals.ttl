    effortless-ntwf:rulebookField effortless-ntwf:ModelChangeRequests.IntuitiveDisjointnessBrokeIndividuals ;
    effortless-ntwf:justification "Fires on the human/software disjointness axiom added with no motivating question, which made the plant organization agent inconsistent." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-i26-e1 a effortless-ntwf:ClaimEvidence ;
