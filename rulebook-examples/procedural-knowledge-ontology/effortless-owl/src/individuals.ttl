    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm3-q12 ;
    effortless-ntwf:justification "Asks, per provider engagement, whether it requires knowledge deliverables to the client and plans how the knowledge comes back." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-i01-e1 a effortless-ntwf:ClaimEvidence ;
