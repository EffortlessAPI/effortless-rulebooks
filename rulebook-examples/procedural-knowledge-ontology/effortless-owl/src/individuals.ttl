    effortless-ntwf:roleQuestionId "q8-ke-canonical-resolution" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Does every variant wording resolve through the labels to exactly one canonical concept?" ;
