    effortless-ntwf:rulebookField effortless-ntwf:CriticalIncidents.JudgmentFragment ;
    effortless-ntwf:justification "Links each episode to the knowledge fragment recording the judgment call it brought out: the mixer 2 restart to the twin-drive isolation fragment, the press 3 gauge episode to the bleed cue." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c13-e1 a effortless-ntwf:ClaimEvidence ;
