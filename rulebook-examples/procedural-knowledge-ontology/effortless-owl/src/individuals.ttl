    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-ke-resource-organization a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-ke-resource-organization" ;
    effortless-ntwf:roleQuestionId "q8-ke-resource-organization" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Is every resource with content also typed, findable and linked, so its structure counts as much as what it says?" ;
    effortless-ntwf:whyItMatters "A PDF with no artifact type, no keywords and no link to a step is content nobody will find when it is needed." ;
