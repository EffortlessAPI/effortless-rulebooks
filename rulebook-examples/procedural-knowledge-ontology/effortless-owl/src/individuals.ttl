    effortless-ntwf:rulebookField effortless-ntwf:SemanticMappings.ReinventsStandardTerm ;
    effortless-ntwf:justification "A deliberately small custom model leans on reused standards; this witness fires on custom terms that duplicate a reused standard's term, which is how a custom model grows beyond what it needs." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

