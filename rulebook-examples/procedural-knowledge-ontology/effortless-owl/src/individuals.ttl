effortless-ntwf:q8-ke-knowledge-levels a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-ke-knowledge-levels" ;
    effortless-ntwf:roleQuestionId "q8-ke-knowledge-levels" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Does each level of process knowledge, operational, tactical and strategic, have its own way of capturing both what can be written down and what can only be passed on in person?" ;
    effortless-ntwf:whyItMatters "A strategy that works for the technician's how does nothing for the planner's heuristics or the executive's why; a level with no tacit strategy loses that knowledge when its holders leave." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "LevelCaptureStrategies.ContradictsKnowledgeForm=1/5; ProcessKnowledgeLevels.LacksCaptureStrategyForEitherForm=1/3" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-ke-planning-pyramid a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-ke-planning-pyramid" ;
    effortless-ntwf:roleQuestionId "q8-ke-planning-pyramid" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Is every statement about a procedure filed at the level of the planning pyramid that answers its kind of question?" ;
    effortless-ntwf:whyItMatters "A why filed among the operational how-to steps is invisible to the executive who owns it and noise to the technician reading the steps." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "ProcessLevelStatements.IsFiledAtWrongLevel=1/8" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-tech-operational-level a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-tech-operational-level" ;
    effortless-ntwf:roleQuestionId "q8-tech-operational-level" ;
    effortless-ntwf:askingRole effortless-ntwf:maintenance-technician ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "For each step, does the procedure tell me what it follows, what it depends on and what must hold before I carry on?" ;
    effortless-ntwf:whyItMatters "Those three things are the operational level; a step missing any of them leaves the order to memory." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "Steps.StatesOperationalKnowledge=3/41" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:aq-pkm1-q05 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm1-q05" ;
    effortless-ntwf:roleQuestionId "aq-pkm1-q05" ;
    effortless-ntwf:askingRole effortless-ntwf:plant-operations-manager ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Where are the bottlenecks in our lockout and release work: which step waits on a resource that is allocated less than it is demanded, and what are we doing about it?" ;
    effortless-ntwf:whyItMatters "Paused lockouts waiting on padlocks and verifiers are a resource problem, not a technician problem; I can only fix what I can see." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "Steps.IsBottleneckStep=2/41; TacticalResourceAllocations.IsBottleneck=2/5" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:aq-pkm1-q06 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm1-q06" ;
    effortless-ntwf:roleQuestionId "aq-pkm1-q06" ;
    effortless-ntwf:askingRole effortless-ntwf:vp-engineering ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Why does each of our procedures exist, what value does it create for our mission, and what trade-offs does it make?" ;
    effortless-ntwf:whyItMatters "I decide which procedures to fund and which to relax; a procedure nobody can justify, or one whose costs nobody wrote down, cannot be weighed." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "Procedures.HasNoStatedReasonForExisting=6/10; ProcessStrategicAlignments.StatesNoTradeOff=1/4" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:aq-pkm1-q07 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm1-q07" ;
    effortless-ntwf:roleQuestionId "aq-pkm1-q07" ;
    effortless-ntwf:askingRole effortless-ntwf:vp-engineering ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "How does each procedure's measured performance connect to the business outcomes I am accountable for?" ;
    effortless-ntwf:whyItMatters "A change failure rate matters to me because it moves platform availability; a measure tied to nothing is activity, not performance." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "Procedures.MeasuresPerformanceWithoutBusinessLink=1/10; ProcessOutcomeMeasures.IsUnlinkedToBusinessOutcome=1/5" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-pm-stages a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-pm-stages" ;
    effortless-ntwf:roleQuestionId "q8-pm-stages" ;
    effortless-ntwf:askingRole effortless-ntwf:platform-product-manager ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Which stages group the release process's steps, who owns each stage, and is any stage without an owner who is actually there, or without steps?" ;
    effortless-ntwf:whyItMatters "I run the process by stage; a rollout stage owned by a role nobody holds is where releases stall." ;
    effortless-ntwf:answerableBefore false ;
