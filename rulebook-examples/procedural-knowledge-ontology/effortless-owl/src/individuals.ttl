    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:AgentIntegrations.ServesSnapshot ;
    effortless-ntwf:justification "Each integration hands its AI agent a governed snapshot of the process graph as its context, so the context comes from process knowledge rather than ad hoc runtime text." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm4-c09-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm4-c09-e1" ;
