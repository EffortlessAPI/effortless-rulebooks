    effortless-ntwf:rulebookField effortless-ntwf:CompetencyQuestionSetEntries.IsOutgrownBaselineQuestion ;
    effortless-ntwf:justification "Fires on two of leadership's original close questions from March 2025, found no longer relevant after more than a year; the CFO's sign-off question still fits." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

