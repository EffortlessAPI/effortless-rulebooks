    effortless-ntwf:evidenceKind "OntologyProfile" ;
    effortless-ntwf:ontologyProfile effortless-ntwf:dcat-3 ;
    effortless-ntwf:justification "DCAT 3 is a recorded dependency with semantic mappings (Resources.Keywords to dcat:keyword and others) and its major revision recorded." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-s10-e1 a effortless-ntwf:ClaimEvidence ;
