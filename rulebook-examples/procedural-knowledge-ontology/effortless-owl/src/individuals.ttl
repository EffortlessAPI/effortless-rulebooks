    effortless-ntwf:principal effortless-ntwf:principal-finance-analyst ;
    effortless-ntwf:targetTable effortless-ntwf:ProcedureVersions ;
    effortless-ntwf:forbiddenRowId "close-v1.0.0" ;
    effortless-ntwf:expectedVisible false ;
    effortless-ntwf:observedVisible false ;
    effortless-ntwf:lastRunAt "2026-09-13T18:36:06+00:00"^^xsd:dateTime ;
    effortless-ntwf:rationale "close-v1.0.0 is superseded (is_current=false). Only current versions are visible to an operating role; version history is for stewards." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AccessDenialTest" .

