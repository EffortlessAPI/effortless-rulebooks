    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c39 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourceRelationships.PowerDynamic ;
    effortless-ntwf:justification "The power dynamic shaping what each source shares: Tomas outranks the engineer, Grace's sessions had a supervisor present, Ken's knowledge is threatened by automation, Lin's relationship is balanced." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p15-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p15-e1" ;
