    effortless-ntwf:questionText "Is every AI model version the registry reports running in production an individual in our graph, with its deployments and evaluations?" ;
    effortless-ntwf:whyItMatters "An AI system that runs without being in the graph cannot be found by any accountability or impact query." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "AiModelDeployments.IsLiveInProduction=2/6; AiModelEvaluations.Passed=2/3; AiRegistryModelVersions.IsLiveButUnregisteredInGraph=1/6" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q11-ke-registry-populates-agents a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q11-ke-registry-populates-agents" ;
    effortless-ntwf:roleQuestionId "q11-ke-registry-populates-agents" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-11 ;
    effortless-ntwf:questionText "Were our AI agent individuals filled from the registry through its Dublin Core fields, or typed in by hand?" ;
    effortless-ntwf:whyItMatters "A hand-typed version drifts from the registry, and every query about that agent then answers for a version that does not exist." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "Agents.IsAiAgentNotFilledFromRegistry=11/55" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

