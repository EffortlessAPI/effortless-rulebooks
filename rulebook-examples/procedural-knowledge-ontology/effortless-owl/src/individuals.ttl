# === Individuals: JwtClaimMappings ===

effortless-ntwf:claim-email a effortless-ntwf:JwtClaimMappings ;
    effortless-ntwf:__key "claim-email" ;
    effortless-ntwf:jwtClaimMappingId "claim-email" ;
    effortless-ntwf:claimName "email" ;
    effortless-ntwf:sqlAccessor "app.jwt_email()" ;
    effortless-ntwf:isReservedClaim true ;
    effortless-ntwf:mapsToPrincipal true ;
    effortless-ntwf:description2 "Verified email address. Magic-links asserts only that the bearer controls this mailbox; everything else about the caller is resolved from it inside this database." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#JwtClaimMapping" .

effortless-ntwf:claim-tenant a effortless-ntwf:JwtClaimMappings ;
