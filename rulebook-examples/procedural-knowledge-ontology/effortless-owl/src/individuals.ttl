    effortless-ntwf:rulebookField effortless-ntwf:ElicitationSessions.IsReviewedRecording ;
    effortless-ntwf:justification "TRUE when a recording of the practitioner's work was reviewed by that practitioner afterward to explain their reasoning: Tomas's press 3 lockout recorded on 3 April and reviewed with him on 4 April." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c30-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c30-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c30-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c30 ;
    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:ConceptLadderRungs ;
    effortless-ntwf:justification "Holds the ladder built from a concrete action: from bleeding the pneumatic supply up to the goal 'no trapped air can move the clamp' and the value 'nobody's hand is ever inside a machine that can move', and down to its subprocess and condition." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c31-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c31-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c31-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c31 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:RepertoryGridConstructs.IsNeverStatedDimension ;
    effortless-ntwf:justification "TRUE for a dimension an expert uses to tell situations apart that only the grid comparison brought out: 'retrofitted vs original drive' and 'audible vs silent bleed', which Tomas never named unprompted." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p01-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p01-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p01-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p01 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ExpertCognitions.IsHeuristicOversimplified ;
    effortless-ntwf:justification "Fires when an expert said when a heuristic does not hold and the capture kept only the bare rule. It fires on Victor's 'lock a retrofitted machine out as two machines', whose stated exceptions were dropped; it does not fire on Ken's needle heuristic, captured with its press 3 exception, nor on a mental model." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p02-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p02-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p02-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-p02 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureVersions.ReliesOnSingleMethod ;
    effortless-ntwf:justification "Fires when a version's knowledge was elicited with only one family of method. It fires on close-v1.1.0 (shadowing only) and deploy-v3.2.0 (one remote interview); it does not fire on loto-v2.0.0, elicited by interview, observation, workshop, protocols and incidents, nor on policy-v1.0.0 (interview and workshop)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-p03-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-p03-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-p03-e1" ;
