    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeGaps.IsRequiredGatekeptUncodified ;
    effortless-ntwf:justification "Fires on blocking (required) gatekept or sabotaged knowledge never drawn out and codified: the retrofit override card removed from the binder. It does not fire on the press 3 crew's gatekept bleed check, which a critical incident session drew out and codified as the bleed cue fragment." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

