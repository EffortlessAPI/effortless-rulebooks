effortless-ntwf:aq-ont4-q26 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-ont4-q26" ;
    effortless-ntwf:roleQuestionId "aq-ont4-q26" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Which adopted external terms have since been deprecated by their source standard?" ;
    effortless-ntwf:whyItMatters "A deprecated term still resolves, so nothing breaks until a consumer upgrades the standard and our mappings point at nothing." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "ExternalStandardTerms.DeprecatedBySource=6/9; ExternalStandardTerms.IsAdoptedButDeprecated=6/9; ExternalStandardTerms.StillResolves=9/9" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-ke-rehoming a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-ke-rehoming" ;
    effortless-ntwf:roleQuestionId "q8-ke-rehoming" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "For each deprecated external term, did we update the alignment, take the term into our namespace if we still need it, link it to the original, cut a release for it, and propagate identifier changes?" ;
    effortless-ntwf:whyItMatters "Each skipped step leaves a different failure: stale documentation, a term that vanishes, a lost identity, an unversioned change, or queries against an old prefix." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "ExternalStandardTerms.HasUnpropagatedIdentifierChange=1/9; ExternalStandardTerms.IsAlignmentStaleAfterDeprecation=1/9; ExternalStandardTerms.IsNeededDeprecatedTermNotRehomed=1/9; ExternalStandardTerms.IsRecentDeprecation=3/9; ExternalStandardTerms.IsRehomedWithoutIdentityLink=1/9; ExternalStandardTerms.IsRehomedWithoutNewRelease=1/9; ExternalStandardTerms.ModelStillNeedsTerm=8/9; ExternalStandardTerms.RehomingKeptExternalNamespace=1/9" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-ke-standard-change-rates a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-ke-standard-change-rates" ;
    effortless-ntwf:roleQuestionId "q8-ke-standard-change-rates" ;
    effortless-ntwf:askingRole effortless-ntwf:knowledge-engineer ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "How fast does each standard we reuse change, and have we reviewed our dependency on the fast-changing ones recently enough?" ;
    effortless-ntwf:whyItMatters "FOAF has barely moved in a decade, schema.org deprecates terms every few releases, DCAT went through a major revision; one review cadence cannot fit all three." ;
    effortless-ntwf:answerableBefore false ;
    effortless-ntwf:witnessedAnswer "OntologyProfiles.IsReviewOverdueForChangeRate=1/27; OntologyProfiles.RequiresFrequentReview=2/27" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RoleQuestion" .

effortless-ntwf:q8-release-ai-grounding a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-release-ai-grounding" ;
    effortless-ntwf:roleQuestionId "q8-release-ai-grounding" ;
    effortless-ntwf:askingRole effortless-ntwf:release-manager ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "When an AI model labels workflow status for our releases, does it return only the governed status values, and is the vocabulary it is grounded in formal enough to use?" ;
    effortless-ntwf:whyItMatters "An ungrounded model calls the same status live, shipped and current; my dashboards count three statuses where there is one." ;
