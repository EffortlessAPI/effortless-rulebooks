    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:VocabularyTerms.BroaderTerm ;
    effortless-ntwf:justification "The direct broader concept (skos:broader); narrower concepts are its inverse (Lockout/Tagout is broader than Energy Isolation)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c83-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c83-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c83-e1" ;
