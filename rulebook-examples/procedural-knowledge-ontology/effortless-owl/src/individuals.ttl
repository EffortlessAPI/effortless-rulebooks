    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm3-q03 ;
    effortless-ntwf:justification "Asks which functions are strategically vital and expertise-heavy and which of those a provider performs." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-q07-e1 a effortless-ntwf:ClaimEvidence ;
