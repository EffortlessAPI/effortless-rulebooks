# === Individuals: FAQs ===

effortless-ntwf:faq-close-workpapers a effortless-ntwf:FAQs ;
    effortless-ntwf:__key "faq-close-workpapers" ;
    effortless-ntwf:faqId "faq-close-workpapers" ;
    effortless-ntwf:procedureVersion effortless-ntwf:close-v1.1.0 ;
    effortless-ntwf:step effortless-ntwf:close-08 ;
    effortless-ntwf:category effortless-ntwf:Storage ;
    effortless-ntwf:targetKind effortless-ntwf:Procedure ;
    effortless-ntwf:question "Where are close workpapers stored?" ;
    effortless-ntwf:answer "In the controlled close evidence repository linked from the execution record; email attachments are not the system of record." ;
    effortless-ntwf:semanticTypeIri "https://w3id.org/pko#FrequentlyAskedQuestion" .

effortless-ntwf:faq-policy-ai a effortless-ntwf:FAQs ;
    effortless-ntwf:__key "faq-policy-ai" ;
    effortless-ntwf:faqId "faq-policy-ai" ;
    effortless-ntwf:procedureVersion effortless-ntwf:policy-v1.0.0 ;
    effortless-ntwf:step effortless-ntwf:policy-03 ;
    effortless-ntwf:category effortless-ntwf:Authority ;
    effortless-ntwf:targetKind effortless-ntwf:Procedure ;
    effortless-ntwf:question "Can the drafting AI approve a workforce policy?" ;
    effortless-ntwf:answer "No. It may draft from approved sources, but a human policy owner and legal reviewer must approve the commitments." ;
    effortless-ntwf:semanticTypeIri "https://w3id.org/pko#FrequentlyAskedQuestion" .

effortless-ntwf:faq-policy-optout a effortless-ntwf:FAQs ;
    effortless-ntwf:__key "faq-policy-optout" ;
    effortless-ntwf:faqId "faq-policy-optout" ;
    effortless-ntwf:procedureVersion effortless-ntwf:policy-v1.0.0 ;
    effortless-ntwf:step effortless-ntwf:policy-07 ;
    effortless-ntwf:category effortless-ntwf:Consent ;
    effortless-ntwf:targetKind effortless-ntwf:Step ;
    effortless-ntwf:question "What happens when an employee opts out of SMS?" ;
    effortless-ntwf:answer "The pipeline suppresses SMS and continues through the approved email channel." ;
    effortless-ntwf:semanticTypeIri "https://w3id.org/pko#FrequentlyAskedQuestion" .

effortless-ntwf:faq-loto-gauge a effortless-ntwf:FAQs ;
    effortless-ntwf:__key "faq-loto-gauge" ;
    effortless-ntwf:faqId "faq-loto-gauge" ;
    effortless-ntwf:procedureVersion effortless-ntwf:loto-v2.0.0 ;
    effortless-ntwf:step effortless-ntwf:loto-06 ;
    effortless-ntwf:category effortless-ntwf:Safety ;
    effortless-ntwf:targetKind effortless-ntwf:Step ;
    effortless-ntwf:question "What if the gauge reads slightly above zero?" ;
    effortless-ntwf:answer "It is not zero. Keep locks on, bleed again, and escalate if it persists." ;
    effortless-ntwf:semanticTypeIri "https://w3id.org/pko#FrequentlyAskedQuestion" ;
    effortless-ntwf:resource effortless-ntwf:res-loto-faq-page .

