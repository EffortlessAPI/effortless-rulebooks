    effortless-ntwf:fieldName "IsContested" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{EvidenceKind}} = \"Field\", {{FieldIsContested}})" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ClaimEvidence.IsAgreedEvidence a effortless-ntwf:RulebookFields ;
    effortless-ntwf:__key "ClaimEvidence.IsAgreedEvidence" ;
    effortless-ntwf:rulebookFieldId "ClaimEvidence.IsAgreedEvidence" ;
    effortless-ntwf:targetTable "ClaimEvidence" ;
    effortless-ntwf:fieldName "IsAgreedEvidence" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{IsValid}}, {{IsContested}} = FALSE)" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

