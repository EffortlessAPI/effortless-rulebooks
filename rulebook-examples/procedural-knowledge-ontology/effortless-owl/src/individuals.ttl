# === Individuals: KnowledgeMethods ===

effortless-ntwf:Shadowing a effortless-ntwf:KnowledgeMethods ;
    effortless-ntwf:__key "Shadowing" ;
    effortless-ntwf:knowledgeMethodId "Shadowing" ;
    effortless-ntwf:label "Shadowing and observation" ;
    effortless-ntwf:methodFamily "Elicitation" ;
    effortless-ntwf:summary "A knowledge engineer observes a practitioner doing the real work and asks about choices in the moment." ;
    effortless-ntwf:originReference "Ethnographic observation; legitimate peripheral participation" ;
    effortless-ntwf:elicitationTradeoff "Gives up reach for depth and accuracy: one practitioner per shift, seen doing the real work." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#KnowledgeMethod" .

effortless-ntwf:PractitionerInterview a effortless-ntwf:KnowledgeMethods ;
    effortless-ntwf:__key "PractitionerInterview" ;
    effortless-ntwf:knowledgeMethodId "PractitionerInterview" ;
    effortless-ntwf:label "Structured practitioner interview" ;
    effortless-ntwf:methodFamily "Elicitation" ;
    effortless-ntwf:summary "A structured interview that asks why choices are made and what happens when the procedure is not enough." ;
    effortless-ntwf:originReference "Knowledge elicitation practice" ;
    effortless-ntwf:elicitationTradeoff "Gives up accuracy for practicality: an hour of talk, but practitioners describe what they believe they do." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#KnowledgeMethod" .

effortless-ntwf:FacilitatedWorkshop a effortless-ntwf:KnowledgeMethods ;
    effortless-ntwf:__key "FacilitatedWorkshop" ;
    effortless-ntwf:knowledgeMethodId "FacilitatedWorkshop" ;
    effortless-ntwf:label "Facilitated workshop" ;
    effortless-ntwf:methodFamily "Elicitation" ;
    effortless-ntwf:summary "A session bringing together people who initiate, execute and receive a process to map it together." ;
    effortless-ntwf:originReference "Collaborative process mapping" ;
    effortless-ntwf:elicitationTradeoff "Gives up depth for reach: many roles at once, each heard briefly." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#KnowledgeMethod" .

effortless-ntwf:CriticalIncidentTechnique a effortless-ntwf:KnowledgeMethods ;
    effortless-ntwf:__key "CriticalIncidentTechnique" ;
    effortless-ntwf:knowledgeMethodId "CriticalIncidentTechnique" ;
    effortless-ntwf:label "Critical incident technique" ;
    effortless-ntwf:methodFamily "Elicitation" ;
    effortless-ntwf:summary "Collects specific occasions when a process succeeded, failed or needed improvisation to surface judgment calls." ;
    effortless-ntwf:originReference "Flanagan, 1954" ;
    effortless-ntwf:elicitationTradeoff "Gives up accuracy for practicality: rare events are recalled and reconstructed rather than witnessed." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#KnowledgeMethod" .

effortless-ntwf:ThinkAloudProtocol a effortless-ntwf:KnowledgeMethods ;
    effortless-ntwf:__key "ThinkAloudProtocol" ;
    effortless-ntwf:knowledgeMethodId "ThinkAloudProtocol" ;
    effortless-ntwf:label "Think-aloud protocol" ;
    effortless-ntwf:methodFamily "Elicitation" ;
    effortless-ntwf:summary "The practitioner verbalizes reasoning while performing the task." ;
    effortless-ntwf:originReference "Cognitive psychology" ;
    effortless-ntwf:elicitationTradeoff "Gives up practicality and some accuracy for depth: speaking while working slows and alters the work." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#KnowledgeMethod" .

effortless-ntwf:RetrospectiveProtocol a effortless-ntwf:KnowledgeMethods ;
    effortless-ntwf:__key "RetrospectiveProtocol" ;
    effortless-ntwf:knowledgeMethodId "RetrospectiveProtocol" ;
    effortless-ntwf:label "Retrospective protocol" ;
    effortless-ntwf:methodFamily "Elicitation" ;
    effortless-ntwf:summary "The practitioner explains reasoning after the task, avoiding interference with the work." ;
    effortless-ntwf:originReference "Cognitive psychology" ;
    effortless-ntwf:elicitationTradeoff "Gives up some accuracy for undisturbed practice: reasons are reconstructed after the fact." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#KnowledgeMethod" .

effortless-ntwf:ConceptLaddering a effortless-ntwf:KnowledgeMethods ;
    effortless-ntwf:__key "ConceptLaddering" ;
