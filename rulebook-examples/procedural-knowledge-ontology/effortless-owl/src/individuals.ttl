    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:AssistantAnswers ;
    effortless-ntwf:justification "Records each answer the plant copilot, release assistant or risk classifier gave, with the organization's own assertions and segments it was grounded in (AnswerGroundings). The model records the assistant's answers; it does not run the assistant." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm4-c17-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm4-c17-e1" ;
    effortless-ntwf:claimEvidenceId "pkm4-c17-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm4-c17 ;
    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:KnowledgeFragments ;
    effortless-ntwf:justification "Records situated, tacit and implicit knowledge -- the judgment and operating constraints practitioners bring -- as its own rows attached to steps, separate from the Steps list itself." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c37-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c37-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c37-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c37 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Roles.EscalationBackupRole ;
    effortless-ntwf:justification "A role names the role that backs it up on escalation: release manager to VP of Engineering, safety officer to the night-shift deputy." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c51-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c51-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c51-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c51 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureVersions.Status ;
    effortless-ntwf:justification "Workflow individuals carry a status, and lockout/tagout 1.0.0 is marked Deprecated." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-c52-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-c52-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-c52-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-c52 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeConsumerSystems.SemanticLayerComponentCount ;
    effortless-ntwf:justification "Counts how many of taxonomy, thesaurus, ontology, metadata schemas and reasoner a knowledge system combines; the procedural knowledge graph combines all five." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p07-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p07-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p07-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p07 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureVersions.IsUnreachableKnowledge ;
    effortless-ntwf:justification "Fires on a current version that no one can reach: no published document or diagram and no consuming system holds it, so it cannot be shared or acted on. Fires on the conveyor maintenance, close and policy versions; not on lockout 2.0.0, deployment 3.2.0 or press changeover, which are published or synced." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p10-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p10-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p10-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p10 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ConsumerSystemSyncs.IsBehindCanonicalVersion ;
    effortless-ntwf:justification "Fires when a consuming system holds a different version from the one the model says is current: the maintenance tablet still holds the deprecated lockout 1.0.0. The copilot, release bot and graph syncs hold the current version and do not fire. Encoded knowledge that has not spread consistently is exactly this." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p11-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p11-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p11-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p11 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureVersions.IsNotQueryValidateReasonReady ;
    effortless-ntwf:justification "Fires on a current version that no structured query reads, that never passed PKO profile validation, or that has no assertion in a snapshot a reasoner found consistent. Lockout 2.0.0 and deployment 3.2.0 pass all three; conveyor maintenance (failed validation, never queried or reasoned) and press changeover fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p12-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p12-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p12-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p12 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:AssistantAnswers.ActedOnWithoutHumanJudgment ;
    effortless-ntwf:justification "Fires when an AI recommendation on a step that requires human confirmation was acted on with no expert review: the release assistant's advice to treat a chat message as the release approval was acted on. The risk classifier's recommendation reviewed by the release manager does not fire. Computation standing in for the judgment the step reserves to a person is the violation." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p13-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p13-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p13-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p13 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:RulebookTables.MeaningIsOnlyTabular ;
    effortless-ntwf:justification "Fires on a table with no semantic mapping to any ontology term, whose meaning is only its column layout (52 tables, e.g. ChangeRequests); the 101 mapped tables do not fire. It detects where the representation carries no context or meaning beyond the fixed schema." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p17-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p17-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p17-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p17 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeQueryDefinitions.MissesALayer ;
    effortless-ntwf:justification "Fires when a question that needs ontology and instance data together is answered by a query walking only one: 'is the accountable agent software?' was run as flat SQL over an agents export, which cannot see that a software agent is a kind of agent. The federated SPARQL approver query walks both and does not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p18-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p18-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p18-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p18 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeQueryDefinitions.ConsolidatedDistributedSources ;
    effortless-ntwf:justification "Fires when a query over several knowledge systems only ran after copying them into one store: the plant-wide lockout query reads a nightly consolidated warehouse copy of the tablet and register. The approver query federates the graph and register without consolidation and does not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p19-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p19-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p19-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p19 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ConsumerSystemSyncs.DropsProvenanceInTransit ;
    effortless-ntwf:justification "Fires when a version had its author on record and the copy a consuming system received dropped that provenance: the procedural graph's copy of deployment 3.2.0. The other syncs carried provenance and do not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p20-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p20-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p20-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p20 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:AiInsightProposals.IsUnvalidatedOrStrandedInsight ;
    effortless-ntwf:justification "Fires when an AI insight was folded into a change request with nobody validating it (the variance AI's timestamp pattern) or was validated and never folded back (the classifier's after-16:00 hotfix pattern). The copilot's gauge pattern, validated and carried into a change request, does not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p21-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p21-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p21-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p21 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:AssistantAnswers.LostTrackOfState ;
    effortless-ntwf:justification "Fires when an assistant acted as if the execution were at a step the execution record shows never completed: the copilot assumed locks were on during a paused run, and the release assistant assumed the approval gate had run. The record of step executions, not the AI, holds the state; answers consistent with it do not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p22-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p22-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p22-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p22 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:AssistantAnswers.ContradictsSharedModel ;
    effortless-ntwf:justification "Checks each AI answer's asserted next step against the procedure's transition graph and fires when no transition allows it: the copilot told a technician to go from applying locks (05) straight to maintenance (07). Answers whose next step the graph allows do not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p23-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p23-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p23-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p23 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:AssistantAnswers.RecommendationRestsOnNothingExplicit ;
    effortless-ntwf:justification "Fires on a recommendation grounded in none of the organization's explicit process knowledge: the release assistant's hotfix advice rested on an external forum thread only. Recommendations grounded in the step-06 or approval-gate segments do not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p24-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p24-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p24-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p24 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:AssistantAnswers.IsUncheckedRegulatedRecommendation ;
    effortless-ntwf:justification "Fires on a recommendation acting on a step that carries a regulatory requirement which was never checked against it: the copilot's advice to skip the second zero-energy verification (hazardous energy standard). The two recommendations checked against the change-control requirement do not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p31-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p31-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p31-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p31 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeConsumerSystems.IsUnlinkedToolchainComponent ;
    effortless-ntwf:justification "Fires on a process modeling tool, semantic repository or AI platform linked to neither the shared model nor any AI integration: the process modeling workbench. The procedure register and both AI platforms are linked and do not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p41-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p41-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p41-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p41 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcedureVersions.ServesOnlyHumansOrOnlyMachines ;
    effortless-ntwf:justification "Fires on a current version that is conveyed to people or to machines but not both: press changeover reaches only the copilot's AI platform. Lockout 2.0.0 and deployment 3.2.0 reach technicians through published projections and AI through syncs and served assertions, and do not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p42-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p42-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p42-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p42 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:AiAdoptionInitiatives.AgentOnNotationOnlyProcedure ;
    effortless-ntwf:justification "Fires when an agentic AI carries out a procedure whose steps have no ontology type and so no semantic context: the checklist bot runs on the 2019 lockout transcription. Agents on typed versions do not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-q11-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-q11-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-q11-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-q11 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm1-q11 ;
    effortless-ntwf:justification "The release manager's question; IsExplicitlyGroundedRecommendation reads, per recommendation, whether it names explicit process knowledge, and the AnswerGroundings rows list which segments and assertions each rests on." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-q12-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-q12-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-q12-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-q12 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm1-q12 ;
    effortless-ntwf:justification "The safety officer's question; ConflictsWithRegulation fires on the recommendation a requirement check found in conflict with the change-control requirement." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-q15-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-q15-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-q15-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-q15 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm1-q15 ;
    effortless-ntwf:justification "The AI enablement lead's question; CallsForProcessKnowledgeFramework is TRUE for initiatives whose task follows ordered steps and depends on organizational knowledge, FALSE for the single-shot risk classification and the routing AI." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-s01-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-s01-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-s01-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-s01 ;
    effortless-ntwf:evidenceKind "OntologyProfile" ;
    effortless-ntwf:ontologyProfile effortless-ntwf:owl-2 ;
    effortless-ntwf:justification "The OWL 2 profile, whose mappings record that the generated ontology declares tables as owl:Class and relationships as owl:ObjectProperty in RDF." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-s02-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-s02-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-s02-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-s02 ;
    effortless-ntwf:evidenceKind "OntologyProfile" ;
    effortless-ntwf:ontologyProfile effortless-ntwf:sparql-1-1 ;
    effortless-ntwf:justification "The SPARQL 1.1 profile; its mapping records that the OWL substrate computes step reachability with the SPARQL property path leadsTo+." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-s03-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-s03-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-s03-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-s03 ;
    effortless-ntwf:evidenceKind "OntologyProfile" ;
    effortless-ntwf:ontologyProfile effortless-ntwf:bpmn-2-0 ;
    effortless-ntwf:justification "The BPMN 2.0 profile, mapping steps to bpmn:Task and transitions to bpmn:SequenceFlow for projected diagrams." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

