    effortless-ntwf:ontologyProfile effortless-ntwf:skos ;
    effortless-ntwf:justification "SKOS concept schemes: mappings for skos:ConceptScheme, skos:Concept, prefLabel, altLabel, definition and inScheme on Vocabularies and VocabularyTerms." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-s08-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-s08-e1" ;
