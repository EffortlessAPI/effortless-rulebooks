    effortless-ntwf:ontologyProfile effortless-ntwf:rdf-1-1 ;
    effortless-ntwf:justification "RDF 1.1 Concepts mapping of VocabularyTerms.ConceptIri: every concept is identified by a globally unique IRI." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-i09-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-i09-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-i09-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-i09 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ExternalStandardTerms.RehomingKeptExternalNamespace ;
    effortless-ntwf:justification "Fires when a deprecated FOAF personal-name term said to be re-homed still sits in FOAF's namespace. The local copy of foaf:family_name kept http://xmlns.com/foaf/0.1/ as its namespace, so it fires; 'given name' was moved into urn:effortless:pko-extension# and linked to foaf:givenname, the illustration done correctly, and does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-i12-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-i12-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-i12-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-i12 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:VocabularyTerms.HasStructuralSenseShiftAcrossYears ;
    effortless-ntwf:justification "Fires when what a term refers to changed shape after holding for about two years or more. 'release' meant an engineer copying a tagged build from January 2024 and, since January 2026, a risk-classified change through a human gate and a pipeline, so it fires; 'rollback', reworded within a year without structural change, does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-i13-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-i13-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-i13-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-i13 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:OntologyProfiles.IsReviewOverdueForChangeRate ;
    effortless-ntwf:justification "Reads each standard's change rate (ChangeRateProfile: FOAF Dormant since 2014, schema.org FrequentDeprecation with two deprecations in two years, DCAT RecentMajorRevision in 2024) and fires when a fast-changing one has not had our dependency reviewed in 180 days. schema.org, last reviewed September 2025, fires; DCAT, reviewed June 2026, and dormant FOAF do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-i16-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-i16-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-i16-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-i16 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:AiLabelingRuns.IsUngroundedSynonymSprawl ;
    effortless-ntwf:justification "Fires when an ungrounded run produced values outside the canonical scheme. The ungrounded status run returned 'live', 'shipped', 'work in progress' and 'retired', so it fires; the same notes grounded in the workflow status scheme returned only active, draft and deprecated, and do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:ont4-i17-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "ont4-i17-e1" ;
    effortless-ntwf:claimEvidenceId "ont4-i17-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:ont4-i17 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:AiLabelingRuns.GroundedInNonMachineReadableScheme ;
    effortless-ntwf:justification "Fires when a model was grounded in a vocabulary that is not formal and machine-accessible. The support run was grounded in a PDF glossary and still produced 'looking into it', so it fires; the run grounded in the SKOS workflow status scheme does not. Grounding helps at scale only when the vocabulary is formal." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c30-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c30-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c30-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c30 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeTraces.ProvenanceStatement ;
    effortless-ntwf:justification "Every trace states in one line the material the item came from (origin), the derivation route and deriving agent (route), and the agent who confirmed it (confirmation), e.g. loto-04b from the press-7 drawing excerpt, paraphrased by the knowledge engineer, confirmed by the plant safety officer." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-c32-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-c32-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-c32-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-c32 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:CollectedSourceMaterials.ExpertEffortHours ;
    effortless-ntwf:justification "Each capture records the hours of domain-expert time it consumed and whose (ContributingExpert): technicians and the release manager, not knowledge modelers, spent 0.5 to 3 hours per capture; Procedures.ExpertAcquisitionHours totals the cost per procedure." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p25-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p25-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p25-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p25 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProcessMiningRuns.IsDeviationUnexplainedByPeople ;
    effortless-ntwf:justification "TRUE when a mining run found non-conforming variants and no capture from people that holds the reasoning behind them complements the run. It fires on the close cutoff-bypass run (3 of 8 variants conform, nobody asked why) and not on the deployment run, whose hotfix bypass Grace Holloway explained in an interview; a mining finding left uncomplemented is exactly the breach." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p26-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p26-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p26-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p26 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:MinedFlowEdges.IsMinedPathRecordedAsIntentWithoutDecision ;
    effortless-ntwf:justification "TRUE when a hand-off reconstructed from the event log is recorded as intended process logic with nobody having decided it should be. It fires on the deploy-05 -> deploy-04 retry loop, silently promoted from the log, and not on deploy-04 -> deploy-05 (decided by an engineer) or edges kept as Observed; the breach is mined behavior becoming indistinguishable from intent." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-p29-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-p29-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-p29-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-p29 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:StakeholderPerspectives.IsDissentingViewNotKeptWithSource ;
    effortless-ntwf:justification "TRUE when a perspective that conflicts with another was overridden into one agreed version or is kept without the material it comes from. It fires on the release manager's hotfix view, overridden by the auditor's, and not on the technician and safety officer views of zero-energy verification, both retained with their sources." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-q08-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-q08-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-q08-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-q08 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm1-q08 ;
    effortless-ntwf:justification "The auditor's question is answered per knowledge item by ProvenanceStatement (origin, route, confirmation), and HasIncompleteProvenance flags the item missing one of the three: the deploy-02 definition the wiki extractor produced, which nobody confirmed." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-q09-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-q09-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-q09-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-q09 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm1-q09 ;
    effortless-ntwf:justification "The steward's question is answered by StakeholderPerspectives: IsInConflict marks the four views that conflict (zero-energy verification, hotfix approval), and SourceMaterial / SourceMaterialKind say which transcript, excerpt or interview each comes from." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-q13-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-q13-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-q13-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-q13 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm1-q13 ;
    effortless-ntwf:justification "IsUndocumentedPath on each mined hand-off answers where log behavior departs from intended logic: the hotfix path deploy-02 -> deploy-04 (no approval) and the deploy-05 -> deploy-04 retry, neither in StepTransitions." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm1-s05-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm1-s05-e1" ;
    effortless-ntwf:claimEvidenceId "pkm1-s05-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm1-s05 ;
    effortless-ntwf:evidenceKind "KnowledgeMethod" ;
    effortless-ntwf:knowledgeMethod effortless-ntwf:ProcessMining ;
    effortless-ntwf:justification "Applied by MethodApplications ma13-process-mining-deploy to the CI/CD event log; its output is the mined event trace material and the MinedFlowEdges, and IsDeviationUnexplainedByPeople records that it is a partial aid that needs capture from people." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c19-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c19-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c19-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c19 ;
    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:MinedFlowEdges ;
    effortless-ntwf:justification "One row per step-to-step hand-off rebuilt from the CI/CD event log by a mining run, with the cases that took it and their wait times: the actual flow of the deployment process." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c20-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c20-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c20-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c20 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:MinedFlowEdges.IsUndocumentedPath ;
    effortless-ntwf:justification "TRUE for a reconstructed hand-off that no documented transition matches: the deviation between the documented deployment procedure and the flow rebuilt from its event log." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c21-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c21-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c21-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c21 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:MinedFlowEdges.IsBottleneck ;
    effortless-ntwf:justification "TRUE where mined cases wait more than four times the entered step's documented duration: cases sit a day (1440 minutes) before the fifteen-minute release approval gate." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c22-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c22-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c22-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c22 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:CollectedSourceMaterials.HoldsReasoningOrTacitKnowledge ;
    effortless-ntwf:justification "Each collected material records whether it holds the reasoning or tacit knowledge behind the actions. The mined deployment event trace reads FALSE (it holds only system events) while the interview and field-note captures read TRUE; the mining-complement witness counts only the latter." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c24-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c24-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c24-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c24 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:CollectedSourceMaterials.SourceDocument ;
    effortless-ntwf:justification "Collected excerpts name the existing document they were taken from: the deployment runbook, the 2019 lockout SOP and the press-7 retrofit drawing notes." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c25-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c25-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c25-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c25 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeTraces.PrescribedVersusEnacted ;
    effortless-ntwf:justification "For a trace where practice evidence contradicts a document, states what the document prescribes against what was enacted: the runbook requires recorded approval, the event log shows three hotfixes rolled out with no approval event." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c26-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c26-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c26-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c26 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Resources.IsBehindCurrentPractice ;
    effortless-ntwf:justification "TRUE for a document contradicted by practice evidence collected after its last revision: the deployment runbook, last revised 2026-01-02, contradicted by the event trace of 2026-07-18." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c102-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c102-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c102-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c102 ;
    effortless-ntwf:evidenceKind "Table" ;
    effortless-ntwf:rulebookTable effortless-ntwf:CollectionOccasions ;
    effortless-ntwf:justification "Recurring collection occasions with a cadence: the monthly release retrospective, the quarterly lockout process review and the close improvement initiative, with the materials each produced." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c103-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm2-c103-e1" ;
    effortless-ntwf:claimEvidenceId "pkm2-c103-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm2-c103 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeTraces.DerivationRoute ;
    effortless-ntwf:justification "Every trace records how the knowledge was derived from its source: paraphrased from a runbook section, extracted by the wiki extractor from a transcript, mined from the event log, observed and written up." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

