    effortless-ntwf:fieldName "CoveragePercent" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "number" ;
    effortless-ntwf:formula "=IF({{ClaimCount}} = 0, 0, ROUND(100 * {{CoveredClaimCount}} / {{ClaimCount}}, 1))" ;
