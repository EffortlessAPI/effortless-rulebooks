effortless-ntwf:q8-steward-terminological-drift a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "q8-steward-terminological-drift" ;
    effortless-ntwf:roleQuestionId "q8-steward-terminological-drift" ;
    effortless-ntwf:askingRole effortless-ntwf:process-steward ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "Has what we mean by any controlled term changed since its definition was last revised, and which terms changed shape over the years?" ;
    effortless-ntwf:whyItMatters "A definition of 'release' written when an engineer copied a build to production gives answers that were true two years ago." ;
    effortless-ntwf:answerableBefore false ;
