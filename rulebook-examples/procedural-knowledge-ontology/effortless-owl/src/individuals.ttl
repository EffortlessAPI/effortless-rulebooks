effortless-ntwf:aq-pkm2-q31 a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:__key "aq-pkm2-q31" ;
    effortless-ntwf:roleQuestionId "aq-pkm2-q31" ;
    effortless-ntwf:askingRole effortless-ntwf:platform-product-manager ;
    effortless-ntwf:witnessLoop effortless-ntwf:loop-08 ;
    effortless-ntwf:questionText "What does this process look like at step-level detail compared with its category, and does any reader need a resolution the procedure cannot give?" ;
