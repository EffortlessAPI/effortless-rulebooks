    effortless-ntwf:justification "TRUE when a community was mandated or came with a purchased platform and no sharing takes place in it. The portal community created when the knowledge portal was licensed fires; the grassroots maintenance guild and clusters, where know-how is passed on, do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p17-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p17-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p17-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p17 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Agents.LacksTimeToMentor ;
    effortless-ntwf:justification "TRUE when a mentor's protected weekly hours fall short of what their active mentorships need. Tomas has 4 protected hours against 12 needed for two apprentices; Devon's 3 hours cover his 2-hour mentorship." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p18-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p18-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p18-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p18 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Agents.IsUnrewardedSharer ;
    effortless-ntwf:justification "TRUE when someone has passed know-how on repeatedly and never been recognized for it. Grace documented and paired to pass on her go/no-go judgment with no recognition; Joao, who shares more, received a peer award and reads FALSE." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p19-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p19-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p19-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p19 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Organizations.TreatsKnowledgeWorkAsUnvalued ;
    effortless-ntwf:justification "TRUE when most of an organization's documentation and knowledge transfer is done outside allotted time, a culture that does not value it. acme-engineering fires (four of five pieces on people's own time); acme-plant, which gives time for entries and mentoring, does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p32-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p32-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p32-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p32 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowHowCarriers.IsDelegatedToUnfitSource ;
    effortless-ntwf:justification "TRUE when the plan to replace know-how relies on public references or AI generation although the know-how is not in public references. Ken's belt-drift diagnosis, slated for AI generation, fires; Lin's forklift checklist, which really is the manufacturer's public checklist, does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-q06-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-q06-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-q06-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-q06 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm3-q06 ;
    effortless-ntwf:justification "The release manager asks whether this problem was solved before; ProblemOccurrences.HasBeenSolvedBefore is TRUE when an earlier occurrence of the same problem was solved, and FALSE for first occurrences." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-q09-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-q09-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-q09-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-q09 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm3-q09 ;
    effortless-ntwf:justification "The release manager asks who handled a comparable problem and whether they can be consulted; ProblemOccurrences.HasConsultableSpecialist is TRUE when the earlier solver still holds a role." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-q10-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-q10-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-q10-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-q10 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm3-q10 ;
    effortless-ntwf:justification "The VP asks what would be relearned if the current team left; KnowHowCarriers.MustBeRelearnedIfHolderLeaves is TRUE for know-how carried by a serving person with nothing captured for a successor." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-i04-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-i04-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-i04-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-i04 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Organizations.ErodedInStages ;
    effortless-ntwf:justification "TRUE when facility investment declined, then engineer training after it, then upkeep of how-to-make knowledge after that. acme-plant fires (tooling budget frozen 2011, engineer rotation cut 2015, how-to-make binders abandoned 2020); acme-engineering's isolated training pause does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-i05-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-i05-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-i05-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-i05 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:CommunitiesOfPractice.IsCrossFirmPracticeCluster ;
    effortless-ntwf:justification "TRUE when members from several firms share practice, know-how moves with people changing employers, and specialists are at hand. The Riverbend press cluster fires (members from two supplier firms, Joao's move, Petra as specialist); single-firm guilds do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-i06-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-i06-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-i06-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-i06 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProblemOccurrences.IsTurnoverRegression ;
    effortless-ntwf:justification "TRUE when a fix that was never recorded comes back after the person who made it left. The contractor who fixed stale CDN assets in 2025 left without a note, and the bug returned in May 2026; the Press 7 bleed stall, whose fix was recorded, does not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-i07-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-i07-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-i07-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-i07 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:CommunitiesOfPractice.IsCirculationEndingForLackOfApprentices ;
    effortless-ntwf:justification "TRUE when know-how circulates through people moving between firms but offered apprenticeship places have gone unfilled for three years. The Eastvale packaging cluster fires (Petra's move, four open places, last apprentice in 2014); Riverbend, with no unfilled places, does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-i08-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-i08-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-i08-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-i08 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:CommunitiesOfPractice.HasAmbientTradeKnowHow ;
    effortless-ntwf:justification "TRUE when a trade concentrated in one place passes its know-how even to people who do not practise it. Riverbend fires: Nina, a school leaver with no role, absorbed servo timing by growing up among the works; no other community records such absorption." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-i09-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-i09-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-i09-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-i09 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Organizations.HoldsKnowHowInPeoplePlantsAndSystems ;
    effortless-ntwf:justification "TRUE when an organization's how-to-build knowledge is carried at once by people, plants and systems. acme-plant fires (technicians, the Plant North isolation layout, the PLC interlock logic); acme-engineering, whose know-how is carried only by people, does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm4-p04-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm4-p04-e1" ;
    effortless-ntwf:claimEvidenceId "pkm4-p04-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm4-p04 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Procedures.HasTransferShortfallExposure ;
    effortless-ntwf:justification "TRUE when a wave of three or more new starters meets untransferred veteran know-how, or a veteran about to leave carries untransferred know-how. Lockout/tagout fires on both counts: Aisha, Bea and Carlos started within 180 days and Tomas retires on 2026-09-30 with his bleed-down know-how untransferred. No other procedure is exposed." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm4-p05-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm4-p05-e1" ;
    effortless-ntwf:claimEvidenceId "pkm4-p05-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm4-p05 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowHowCarriers.TransferStopsWithoutVeteran ;
    effortless-ntwf:justification "TRUE when a serving veteran's know-how has only been passed person to person and nothing is captured, so the next newcomer still needs that veteran. Tomas's improvised press setup, taught only to Aisha, fires; Grace's go/no-go judgment, also written into the repository, does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm4-p08-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm4-p08-e1" ;
    effortless-ntwf:claimEvidenceId "pkm4-p08-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm4-p08 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Procedures.FormalizationDoesNotEaseOnboarding ;
    effortless-ntwf:justification "TRUE when starters who learned from captured knowledge took at least as long to reach proficiency as those who did not. Production deployment fires (55 days with the stale go/no-go notes against 40 without); lockout/tagout, where captured knowledge cut onboarding from 70 to 21 days, does not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm4-q14-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm4-q14-e1" ;
    effortless-ntwf:claimEvidenceId "pkm4-q14-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm4-q14 ;
    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm4-q14 ;
    effortless-ntwf:justification "The plant operations manager asks which know-how only veterans hold unpassed, and whether they are leaving; KnowHowCarriers.IsUntransferredVeteranKnowHow and IsAtRiskOfImminentLoss answer it, TRUE for Tomas's bleed-down know-how (retiring in 73 days) and, without the departure, Lin's checks." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c06-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c06-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c06-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c06 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourcingFunctions.IsBusinessProcessOutsourcing ;
    effortless-ntwf:justification "TRUE for a function a provider performs whose work is routine and transactional; it fires on accounts payable invoice processing sent to Harborline and on nothing expertise-heavy." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c07-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c07-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c07-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c07 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourcingFunctions.IsKnowledgeProcessOutsourcing ;
    effortless-ntwf:justification "TRUE for a function a provider performs whose work is expertise-heavy: appliance process engineering, safety regulatory research, acquisition due-diligence analysis, press overhaul and classifier training." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c08-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c08-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c08-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c08 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourcingFunctions.SourcingClass ;
    effortless-ntwf:justification "Every function carries its classification as RetainedCore or SentOutExecution, separately from who actually executes it." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c09-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c09-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c09-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c09 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourcingFunctions.ClaimsHowWithoutDoing ;
    effortless-ntwf:justification "The model records who holds the how of a function separately from who executes it, and flags a declaration that the client holds the method while a provider does the work: acme-engineering says it holds classifier training know-how while Northstar trains the model, and its own audit rates the in-house level 1 of the 3 needed." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c17-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c17-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c17-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c17 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:RecordsRetentionPolicies.RetentionDriver ;
    effortless-ntwf:justification "Each retention rule states whether its period is set by compliance risk or by the value of the knowledge in the records." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c18-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c18-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c18-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c18 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:CorporateGovernancePrograms.IsComplianceOnly ;
    effortless-ntwf:justification "Each governance programme records which of compliance, data quality, information management and knowledge management it covers; this field is TRUE for the programme whose scope is compliance alone." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c23-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c23-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c23-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c23 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourcingFunctions.IsWhatHowSplit ;
    effortless-ntwf:justification "Compares the party holding the specification of what is built with the party holding the method of how it is built, and is TRUE where different parties hold them." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c24-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c24-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c24-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c24 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Organizations.IsHollowedOutFirm ;
    effortless-ntwf:justification "TRUE for an organization every one of whose product-delivering functions depends on method knowledge a provider holds; ACME Home Brands keeps its brand, customers and specifications while Meridian holds how its appliances are assembled." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c25-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c25-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c25-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c25 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProviderEngagements.DocumentationOwnership ;
    effortless-ntwf:justification "Records per engagement whether the documentation the provider produces stays the provider's intellectual property (ProviderIP) or belongs to the client." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c28-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c28-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c28-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c28 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProviderEngagements.KnowledgeDutyTerms ;
    effortless-ntwf:justification "States the duty, if any, an engagement puts on the provider to build up the client's knowledge, such as Baxter training two plant technicians per overhaul; blank where the engagement carries none." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c29-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c29-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c29-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c29 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProviderEngagements.ProviderTreatsKnowHowAsDifferentiator ;
    effortless-ntwf:justification "Records whether the provider positions its procedural know-how as its competitive differentiator, the incentive to withhold it from the client." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c34-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c34-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c34-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c34 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeWorkforcePositions.Discipline ;
    effortless-ntwf:justification "Each dedicated position is typed KnowledgeEngineer, InformationArchitect or Ontologist, with the organization it serves and whether it is filled." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c35-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c35-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c35-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c35 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourcingFunctions.IsVitalExpertiseProcess ;
    effortless-ntwf:justification "TRUE for a function that is both strategically vital and expertise-heavy." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c36-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c36-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c36-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c36 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeAuditItems.IsKnowledgeDependency ;
    effortless-ntwf:justification "TRUE for an audited knowledge area where the organization holds less than it needs and relies on a provider that holds it at the needed level." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c37-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c37-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c37-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c37 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeAuditItems.IsCoverageGap ;
    effortless-ntwf:justification "TRUE for an audited knowledge area where the organization falls short and no provider available to it holds the knowledge either, such as the isolation sequence for mixer 2's twin-drive conversion." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-c38-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-c38-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-c38-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-c38 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeAuditItems.IsSingleTeamSilo ;
    effortless-ntwf:justification "Knowledge held at the needed level is classified by how many internal teams hold it; TRUE where exactly one team does (the standard-line isolation know-how), the silo single-team ownership creates, against areas already spread across two or three teams." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p03-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p03-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p03-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p03 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProviderEngagements.IsUnplannedKnowledgeReturn ;
    effortless-ntwf:justification "Fires when an audit shows the client relies on a provider's knowledge, the provider keeps the documentation as its own property, and the engagement records no plan for how the knowledge comes back: Meridian, Quillstone and Northstar; it does not fire on Baxter, whose documentation is joint and whose return plan is recorded." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p11-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p11-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p11-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p11 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeAudits.TreatsDeficitAsCostProblem ;
    effortless-ntwf:justification "Fires when an audit finds knowledge shortfalls but frames them as a cost and efficiency problem rather than a knowledge deficit: the 2025 Home Brands supplier review found two dependencies and filed them as cost; the plant and engineering audits acknowledge a deficit, and the 2024 corporate cost review found no shortfall." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p12-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p12-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p12-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p12 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourcingFunctions.IsUnauditedFunction ;
    effortless-ntwf:justification "Fires for an outsourced or strategically vital function that no audit has compared held against needed knowledge for: invoice processing at Harborline and the heating element R&D; audited functions do not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p13-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p13-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p13-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p13 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:KnowledgeAuditItems.IsUnnamedFinding ;
    effortless-ntwf:justification "Fires for an audit finding (gap or dependency) that no knowledge gap row names: the two Home Brands dependencies; the plant and engineering findings are each named as a knowledge gap." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p14-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p14-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p14-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p14 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:Organizations.HasKnowledgeFindingsWithoutKnowledgeStaff ;
    effortless-ntwf:justification "Fires for an organization whose audits found shortfalls while it has no filled knowledge engineer, information architect or ontologist position: ACME Home Brands, whose knowledge engineer position was never budgeted; the plant and engineering have filled positions." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p15-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p15-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p15-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p15 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:SourcingFunctions.IsUncapturedPriorityProcess ;
    effortless-ntwf:justification "Fires for a vital, expertise-heavy function that is outsourced or has a coverage gap and has no deliberate capture initiative: appliance assembly, safety research and classifier training; the press overhaul (shadowing), the lockout coverage gap (critical incidents) and deal analysis (practitioner pairing) have one." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p16-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p16-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p16-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p16 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProviderEngagements.IsKnowledgeAccessUnsecured ;
    effortless-ntwf:justification "Fires for a running engagement the client depends on for knowledge whose contract gives the client no access to that knowledge: Meridian and Northstar; Quillstone and Baxter depend on provider knowledge but grant access." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p20-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p20-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p20-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p20 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProviderEngagements.LacksKnowledgeDeliverables ;
    effortless-ntwf:justification "Fires for a running engagement that requires no knowledge management deliverable at all: the Meridian assembly contract; an ended engagement does not fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p21-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p21-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p21-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p21 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProviderEngagements.IsOneWayLearning ;
    effortless-ntwf:justification "Fires for a running engagement with knowledge deliverables where knowledge has actually been delivered in only one direction: Quillstone (digests to the client only) and Northstar (change history to the provider only); Harborline, Baxter and Lattice deliver both ways." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-p22-e1 a effortless-ntwf:ClaimEvidence ;
    effortless-ntwf:__key "pkm3-p22-e1" ;
    effortless-ntwf:claimEvidenceId "pkm3-p22-e1" ;
    effortless-ntwf:articleClaim effortless-ntwf:pkm3-p22 ;
    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:ProviderEngagements.IsShortTermWithoutJointKnowledge ;
    effortless-ntwf:justification "Fires for a running engagement contracted for under three years that builds no knowledge asset jointly, i.e. a provider treated transactionally rather than as a long-term partner: Meridian, Quillstone and Northstar; Baxter (60 months, shared failure-mode catalog) and Lattice (48 months, joint playbook) do not." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm3-q02-e1 a effortless-ntwf:ClaimEvidence ;
