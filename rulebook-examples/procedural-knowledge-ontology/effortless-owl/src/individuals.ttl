    effortless-ntwf:evidenceKind "RoleQuestion" ;
    effortless-ntwf:roleQuestion effortless-ntwf:aq-pkm2-q21 ;
    effortless-ntwf:justification "The auditor's question, answered by SituationalVariants through ApplicabilityScopes (business unit, geography, segment, regime) with HasNoApplicabilityDimension and DivergesWithoutStatedConditions." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-q28-e1 a effortless-ntwf:ClaimEvidence ;
