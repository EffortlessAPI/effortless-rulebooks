    effortless-ntwf:evidenceKind "Field" ;
    effortless-ntwf:rulebookField effortless-ntwf:CommunitiesOfPractice.HasOwnVocabularyAndNorms ;
    effortless-ntwf:justification "TRUE for a community that speaks its own vocabulary and states its own norms: the maintenance guild (lockout vocabulary; deviations talked through at the Friday huddle) and the release guild (release vocabulary; a written note for every rollback)." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#ClaimEvidence" .

effortless-ntwf:pkm2-c35-e1 a effortless-ntwf:ClaimEvidence ;
