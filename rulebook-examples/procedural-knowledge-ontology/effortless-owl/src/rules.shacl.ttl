    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usedAsAcceptanceCriterion ?used_as_acceptance_criterion . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usedAsTestDriver ?used_as_test_driver . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usedForGovernance ?used_for_governance . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usedForScoping ?used_for_scoping . }
                BIND(ROUND((((IF(COALESCE(?used_for_scoping, false), 1, 0) + IF(COALESCE(?used_as_acceptance_criterion, false), 1, 0)) + IF(COALESCE(?used_as_test_driver, false), 1, 0)) + IF(COALESCE(?used_for_governance, false), 1, 0))) AS ?_result)
            }
        """ ;
