            CONSTRUCT {
                $this effortless-ntwf:staleAtRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:BindingObservations .
                    ?child effortless-ntwf:staleAtRunStepKey ?backfk .
                    $this effortless-ntwf:stepExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_WasStaleWhenIRanIt" ;
        sh:prefixes effortless-ntwf: ;
