    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:openOutdatedFlagCount ?open_outdated_flag_count . }
                BIND((COALESCE((COALESCE(?deviated_run_count, 0) >= 2), false) || COALESCE((COALESCE((COALESCE(?deviated_run_count, 0) > 0), false) && COALESCE((COALESCE(?open_outdated_flag_count, 0) > 0), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Steps_AiFailureCount a sh:NodeShape ;
    sh:targetClass p-plan:Step ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_AiFailureCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:aiFailureCount ?_result .
            }
            WHERE {
    $this a p-plan:Step .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a p-plan:Step .
                    ?child a pko-extension:AssistantAnswer .
                    ?child pko-native-procedural-knowledge-rulebook:contextStep ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:stepId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:taskOutcome ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Failed"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
