            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isAwaitingAcknowledgement ?_result .
            }
            WHERE {
    $this a pko-extension:CueObservation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:acknowledgedAt ?acknowledged_at . OPTIONAL { ?acknowledged_at erb:key ?acknowledged_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wasEscalated ?was_escalated . }
                BIND((COALESCE((COALESCE(?was_escalated, false) = true), false) && COALESCE((COALESCE(?acknowledged_at__key, COALESCE(IF(isIRI(?acknowledged_at), REPLACE(STR(?acknowledged_at), "^.*[#/]", ""), STR(?acknowledged_at)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for DecisionPoints ===
pko-native-procedural-knowledge-rulebook-shapes:DecisionPoints_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:DecisionPoints ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DecisionPoints_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:DecisionPoints .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:question_DecisionPoints ?question . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?question), 1, 50)), REPLACE(STR(SUBSTR(STR(?question), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?question), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] .
