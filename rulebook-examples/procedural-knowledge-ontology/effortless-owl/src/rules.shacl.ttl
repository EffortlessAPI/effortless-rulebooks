        a sh:SPARQLRule ;
        rdfs:label "rule_AppRouteQuestions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AppRouteQuestion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:question ?question . OPTIONAL { ?question erb:key ?question__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:route ?route . OPTIONAL { ?route erb:key ?route__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?route__key, IF(isIRI(?route), REPLACE(STR(?route), "^.*[#/]", ""), STR(?route))), ""), " answers ", COALESCE(COALESCE(?question__key, IF(isIRI(?question), REPLACE(STR(?question), "^.*[#/]", ""), STR(?question))), "")) AS ?_result)
            }
        """ ;
    ] .

