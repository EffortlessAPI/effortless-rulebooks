    OPTIONAL { $this effortless-ntwf:representsOrganization ?represents_organization . OPTIONAL { ?represents_organization effortless-ntwf:__key ?represents_organization__key . } }
                BIND((COALESCE(?represents_organization__key, COALESCE(IF(isIRI(?represents_organization), REPLACE(STR(?represents_organization), "^.*[#/]", ""), STR(?represents_organization)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
