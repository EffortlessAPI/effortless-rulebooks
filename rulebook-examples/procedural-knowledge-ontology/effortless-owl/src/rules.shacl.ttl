                $this pko-native-procedural-knowledge-rulebook:isWellTimedUnanswered ?_result .
            }
            WHERE {
    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wasDeliveredAndUnanswered ?was_delivered_and_unanswered . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wasSentOutsideBusinessHours ?was_sent_outside_business_hours . }
                BIND((COALESCE(?was_delivered_and_unanswered, false) && COALESCE((!(COALESCE(?was_sent_outside_business_hours, false))), false)) AS ?_result)
            }
        """ ;
    ] .
