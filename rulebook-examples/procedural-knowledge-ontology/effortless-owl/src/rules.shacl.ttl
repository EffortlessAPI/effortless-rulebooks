pko-native-procedural-knowledge-rulebook-shapes:DepartmentProcessAccounts_IsConflictingAccount a sh:NodeShape ;
    sh:targetClass pko-extension:DepartmentProcessAccount ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DepartmentProcessAccounts_IsConflictingAccount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isConflictingAccount ?_result .
            }
            WHERE {
    $this a pko-extension:DepartmentProcessAccount .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conflictingDepartment ?conflicting_department . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conflictsWithAccount ?conflicts_with_account . OPTIONAL { ?conflicts_with_account erb:key ?conflicts_with_account__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:department ?department . }
                BIND((COALESCE((COALESCE(?conflicts_with_account__key, COALESCE(IF(isIRI(?conflicts_with_account), REPLACE(STR(?conflicts_with_account), "^.*[#/]", ""), STR(?conflicts_with_account)), "")) != ""), false) && COALESCE(COALESCE((?conflicting_department != ?department), !((!BOUND(?conflicting_department) || STR(?conflicting_department) = "") && (!BOUND(?department) || STR(?department) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .
