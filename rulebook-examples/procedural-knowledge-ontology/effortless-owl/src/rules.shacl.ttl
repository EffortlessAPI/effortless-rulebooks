            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUncreditedExpertKnowHow ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeRepositoryEntry .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authorAgent ?author_agent . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:creditsSourceExpert ?credits_source_expert . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceExpert ?source_expert . OPTIONAL { ?source_expert erb:key ?source_expert__key . } }
                BIND((COALESCE((COALESCE(?source_expert__key, COALESCE(IF(isIRI(?source_expert), REPLACE(STR(?source_expert), "^.*[#/]", ""), STR(?source_expert)), "")) != ""), false) && COALESCE(COALESCE((?source_expert != ?author_agent), !((!BOUND(?source_expert) || STR(?source_expert) = "") && (!BOUND(?author_agent) || STR(?author_agent) = ""))), false) && COALESCE((COALESCE(?credits_source_expert, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for KnowledgeSearchEvents ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeSearchEvents_Name a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeSearchEvent ;
    sh:order 1 ;
    sh:rule [
