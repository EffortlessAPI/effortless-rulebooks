pko-native-procedural-knowledge-rulebook-shapes:Procedures_IsCaptureSeparateFromWork a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_IsCaptureSeparateFromWork" ;
