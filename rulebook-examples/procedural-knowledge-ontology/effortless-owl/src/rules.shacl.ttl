            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_IsUnrehearsedControlEntry a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
