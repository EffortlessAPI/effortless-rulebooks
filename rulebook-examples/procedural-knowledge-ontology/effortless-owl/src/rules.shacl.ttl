            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:scopedVersionStatus ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:forProcedureVersion ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:ProcedureVersions . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:status ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_IsScopedToRetiredVersion a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsScopedToRetiredVersion" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isScopedToRetiredVersion ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isCurrent ?is_current . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:scopedVersionStatus ?scoped_version_status . OPTIONAL { ?scoped_version_status erb:key ?scoped_version_status__key . } }
                BIND((COALESCE(?is_current, false) && COALESCE((COALESCE((COALESCE(?scoped_version_status__key, COALESCE(IF(isIRI(?scoped_version_status), REPLACE(STR(?scoped_version_status), "^.*[#/]", ""), STR(?scoped_version_status)), "")) = "Deprecated"), false) || COALESCE((COALESCE(?scoped_version_status__key, COALESCE(IF(isIRI(?scoped_version_status), REPLACE(STR(?scoped_version_status), "^.*[#/]", ""), STR(?scoped_version_status)), "")) = "Archived"), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_PredecessorValidTo a sh:NodeShape ;
