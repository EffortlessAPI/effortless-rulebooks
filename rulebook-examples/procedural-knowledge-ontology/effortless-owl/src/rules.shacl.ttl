pko-native-procedural-knowledge-rulebook-shapes:Procedures_PrivilegesSingleStakeholderView a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_PrivilegesSingleStakeholderView" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:privilegesSingleStakeholderView ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Procedures .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lensViewCount ?lens_view_count . }
