                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:hasInternalShortfall ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Specification"))
                    FILTER(BOUND(?c4) && ?c4 = true)
