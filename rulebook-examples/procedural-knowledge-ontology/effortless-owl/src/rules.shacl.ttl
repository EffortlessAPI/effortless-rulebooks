            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isWithinValidityWindow ?is_within_validity_window . }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND((COALESCE((COALESCE(?step__key, COALESCE(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step)), "")) != ""), false) && COALESCE(?is_within_validity_window, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_StepProcedureVersionStatus" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
