            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
                OPTIONAL { $this effortless-ntwf:rehomedAsTerm ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:VocabularyTerms ; effortless-ntwf:vocabularyTermId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:namespaceIri ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_RehomedTermReleaseIssuedAt" ;
