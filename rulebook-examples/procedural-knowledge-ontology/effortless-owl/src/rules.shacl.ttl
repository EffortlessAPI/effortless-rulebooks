        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProviderEngagements_ToProviderDeliveredCount a sh:NodeShape ;
    sh:targetClass pko-extension:ProviderEngagement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_ToProviderDeliveredCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:toProviderDeliveredCount ?_result .
            }
            WHERE {
    $this a pko-extension:ProviderEngagement .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ProviderEngagement .
                    ?child a pko-extension:KnowledgeDeliverable .
                    ?child pko-native-procedural-knowledge-rulebook:providerEngagement $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:direction ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isDelivered ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "ToProvider"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProviderEngagements_JointDeliverableCount a sh:NodeShape ;
    sh:targetClass pko-extension:ProviderEngagement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_JointDeliverableCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:jointDeliverableCount ?_result .
            }
            WHERE {
    $this a pko-extension:ProviderEngagement .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ProviderEngagement .
                    ?child a pko-extension:KnowledgeDeliverable .
                    ?child pko-native-procedural-knowledge-rulebook:providerEngagement $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:direction ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Joint"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProviderEngagements_LacksKnowledgeDeliverables a sh:NodeShape ;
    sh:targetClass pko-extension:ProviderEngagement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_LacksKnowledgeDeliverables" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:lacksKnowledgeDeliverables ?_result .
            }
            WHERE {
    $this a pko-extension:ProviderEngagement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isActive ?is_active . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requiredDeliverableCount ?required_deliverable_count . }
                BIND((COALESCE(?is_active, false) && COALESCE((COALESCE(?required_deliverable_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProviderEngagements_IsOneWayLearning a sh:NodeShape ;
    sh:targetClass pko-extension:ProviderEngagement ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_IsOneWayLearning" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOneWayLearning ?_result .
            }
            WHERE {
    $this a pko-extension:ProviderEngagement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isActive ?is_active . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requiredDeliverableCount ?required_deliverable_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toClientDeliveredCount ?to_client_delivered_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toProviderDeliveredCount ?to_provider_delivered_count . }
                BIND((COALESCE(?is_active, false) && COALESCE((COALESCE(?required_deliverable_count, 0) > 0), false) && COALESCE((COALESCE((COALESCE(?to_client_delivered_count, 0) = 0), false) || COALESCE((COALESCE(?to_provider_delivered_count, 0) = 0), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProviderEngagements_IsShortTermWithoutJointKnowledge a sh:NodeShape ;
    sh:targetClass pko-extension:ProviderEngagement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_IsShortTermWithoutJointKnowledge" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isShortTermWithoutJointKnowledge ?_result .
            }
            WHERE {
    $this a pko-extension:ProviderEngagement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isActive ?is_active . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:jointDeliverableCount ?joint_deliverable_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:termMonths ?term_months . }
                BIND((COALESCE(?is_active, false) && COALESCE((COALESCE(?term_months, 0) < 36), false) && COALESCE((COALESCE(?joint_deliverable_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProviderEngagements_ObligesKnowledgeFlowBack a sh:NodeShape ;
    sh:targetClass pko-extension:ProviderEngagement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_ObligesKnowledgeFlowBack" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:obligesKnowledgeFlowBack ?_result .
            }
            WHERE {
    $this a pko-extension:ProviderEngagement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeReturnPlan ?knowledge_return_plan . OPTIONAL { ?knowledge_return_plan erb:key ?knowledge_return_plan__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toClientRequiredCount ?to_client_required_count . }
                BIND((COALESCE((COALESCE(?to_client_required_count, 0) > 0), false) && COALESCE((COALESCE(?knowledge_return_plan__key, COALESCE(IF(isIRI(?knowledge_return_plan), REPLACE(STR(?knowledge_return_plan), "^.*[#/]", ""), STR(?knowledge_return_plan)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for QualityAssessments ===
pko-native-procedural-knowledge-rulebook-shapes:QualityAssessments_Name a sh:NodeShape ;
