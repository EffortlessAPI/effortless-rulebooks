    $this a pko-extension:GovernedModel .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:implementationExpertCount ?implementation_expert_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:maintenanceExpertCount ?maintenance_expert_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelKind ?model_kind . OPTIONAL { ?model_kind erb:key ?model_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:publicationExpertCount ?publication_expert_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requirementsExpertCount ?requirements_expert_count . }
                BIND((COALESCE((COALESCE(?model_kind__key, COALESCE(IF(isIRI(?model_kind), REPLACE(STR(?model_kind), "^.*[#/]", ""), STR(?model_kind)), "")) != "Vocabulary"), false) && COALESCE((COALESCE((COALESCE(?requirements_expert_count, 0) = 0), false) || COALESCE((COALESCE(?implementation_expert_count, 0) = 0), false) || COALESCE((COALESCE(?publication_expert_count, 0) = 0), false) || COALESCE((COALESCE(?maintenance_expert_count, 0) = 0), false)), false)) AS ?_result)
            }
        """ ;
