    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_MethodFamily" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:methodFamily ?_result .
            }
            WHERE {
    $this a pko-extension:ElicitationSession .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:method ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:KnowledgeMethod . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:methodFamily ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ElicitationSessions_FacilitatorKnowledgeEngineerRoleCount a sh:NodeShape ;
    sh:targetClass pko-extension:ElicitationSession ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_FacilitatorKnowledgeEngineerRoleCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:facilitatorKnowledgeEngineerRoleCount ?_result .
            }
            WHERE {
    $this a pko-extension:ElicitationSession .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ElicitationSession .
                    ?child a pro:Role .
                    ?child pko-native-procedural-knowledge-rulebook:currentAgent ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:facilitatorAgent ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:roleId ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "knowledge-engineer"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ElicitationSessions_FacilitatorIsKnowledgeEngineer a sh:NodeShape ;
    sh:targetClass pko-extension:ElicitationSession ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_FacilitatorIsKnowledgeEngineer" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:facilitatorIsKnowledgeEngineer ?_result .
            }
            WHERE {
    $this a pko-extension:ElicitationSession .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:facilitatorKnowledgeEngineerRoleCount ?facilitator_knowledge_engineer_role_count . }
                BIND((COALESCE(?facilitator_knowledge_engineer_role_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ElicitationSessions_IsGenericOrUnskilledCapture a sh:NodeShape ;
    sh:targetClass pko-extension:ElicitationSession ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsGenericOrUnskilledCapture" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isGenericOrUnskilledCapture ?_result .
            }
            WHERE {
    $this a pko-extension:ElicitationSession .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:facilitatorIsKnowledgeEngineer ?facilitator_is_knowledge_engineer . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:method ?method . OPTIONAL { ?method erb:key ?method__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:methodFamily ?method_family . OPTIONAL { ?method_family erb:key ?method_family__key . } }
                BIND((COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?method_family__key, COALESCE(IF(isIRI(?method_family), REPLACE(STR(?method_family), "^.*[#/]", ""), STR(?method_family)), "")) != "Elicitation"), false) || COALESCE((!(COALESCE(?facilitator_is_knowledge_engineer, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ElicitationSessions_IsKeFieldSession a sh:NodeShape ;
    sh:targetClass pko-extension:ElicitationSession ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsKeFieldSession" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isKeFieldSession ?_result .
            }
            WHERE {
    $this a pko-extension:ElicitationSession .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:facilitatorIsKnowledgeEngineer ?facilitator_is_knowledge_engineer . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:setting ?setting . OPTIONAL { ?setting erb:key ?setting__key . } }
                BIND((COALESCE(?facilitator_is_knowledge_engineer, false) && COALESCE((COALESCE(?setting__key, COALESCE(IF(isIRI(?setting), REPLACE(STR(?setting), "^.*[#/]", ""), STR(?setting)), "")) = "InSitu"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ElicitationSessions_IsReviewedRecording a sh:NodeShape ;
    sh:targetClass pko-extension:ElicitationSession ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsReviewedRecording" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isReviewedRecording ?_result .
            }
            WHERE {
    $this a pko-extension:ElicitationSession .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:practitionerReviewedAt ?practitioner_reviewed_at . OPTIONAL { ?practitioner_reviewed_at erb:key ?practitioner_reviewed_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recordingReference ?recording_reference . OPTIONAL { ?recording_reference erb:key ?recording_reference__key . } }
                BIND((COALESCE((COALESCE(?recording_reference__key, COALESCE(IF(isIRI(?recording_reference), REPLACE(STR(?recording_reference), "^.*[#/]", ""), STR(?recording_reference)), "")) != ""), false) && COALESCE((COALESCE(?practitioner_reviewed_at__key, COALESCE(IF(isIRI(?practitioner_reviewed_at), REPLACE(STR(?practitioner_reviewed_at), "^.*[#/]", ""), STR(?practitioner_reviewed_at)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for EmbeddingProbes ===
pko-native-procedural-knowledge-rulebook-shapes:EmbeddingProbes_Name a sh:NodeShape ;
    sh:targetClass pko-extension:EmbeddingProbe ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EmbeddingProbes_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:EmbeddingProbe .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:embeddingModel ?embedding_model . OPTIONAL { ?embedding_model erb:key ?embedding_model__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:termA ?term_a . OPTIONAL { ?term_a erb:key ?term_a__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:termB ?term_b . OPTIONAL { ?term_b erb:key ?term_b__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?term_a__key, IF(isIRI(?term_a), REPLACE(STR(?term_a), "^.*[#/]", ""), STR(?term_a))), ""), " / ", COALESCE(COALESCE(?term_b__key, IF(isIRI(?term_b), REPLACE(STR(?term_b), "^.*[#/]", ""), STR(?term_b))), ""), " @ ", COALESCE(COALESCE(?embedding_model__key, IF(isIRI(?embedding_model), REPLACE(STR(?embedding_model), "^.*[#/]", ""), STR(?embedding_model))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:EmbeddingProbes_SynonymsNotSimilar a sh:NodeShape ;
    sh:targetClass pko-extension:EmbeddingProbe ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EmbeddingProbes_SynonymsNotSimilar" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:synonymsNotSimilar ?_result .
            }
            WHERE {
    $this a pko-extension:EmbeddingProbe .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cosineSimilarity ?cosine_similarity . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:expectedRelation ?expected_relation . OPTIONAL { ?expected_relation erb:key ?expected_relation__key . } }
                BIND((COALESCE((COALESCE(?expected_relation__key, COALESCE(IF(isIRI(?expected_relation), REPLACE(STR(?expected_relation), "^.*[#/]", ""), STR(?expected_relation)), "")) = "NearSynonym"), false) && COALESCE((COALESCE(?cosine_similarity, 0) < 0.7), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:EmbeddingProbes_OppositesNotOpposed a sh:NodeShape ;
    sh:targetClass pko-extension:EmbeddingProbe ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EmbeddingProbes_OppositesNotOpposed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:oppositesNotOpposed ?_result .
            }
            WHERE {
    $this a pko-extension:EmbeddingProbe .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cosineSimilarity ?cosine_similarity . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:expectedRelation ?expected_relation . OPTIONAL { ?expected_relation erb:key ?expected_relation__key . } }
                BIND((COALESCE((COALESCE(?expected_relation__key, COALESCE(IF(isIRI(?expected_relation), REPLACE(STR(?expected_relation), "^.*[#/]", ""), STR(?expected_relation)), "")) = "Opposite"), false) && COALESCE((COALESCE(?cosine_similarity, 0) > 0.3), false)) AS ?_result)
            }
        """ ;
    ] .

