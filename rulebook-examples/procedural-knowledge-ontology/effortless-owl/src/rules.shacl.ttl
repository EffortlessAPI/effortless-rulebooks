            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:fromStepIsHumanApprovalGate ?_result .
            }
            WHERE {
    $this a pko:Transition .
                OPTIONAL { $this pko:fromStep ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a p-plan:Step . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isHumanApprovalGate ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
