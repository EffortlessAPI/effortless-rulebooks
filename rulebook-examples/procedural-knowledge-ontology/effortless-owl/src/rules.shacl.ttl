        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_VersionOfStep" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:versionOfStep ?_result .
            }
            WHERE {
    $this a pko:StepExecution .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a p-plan:Step . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:procedureVersion ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_IsUngovernedDivergence a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsUngovernedDivergence" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUngovernedDivergence ?_result .
            }
            WHERE {
    $this a pko:StepExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasDeviation ?has_deviation . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasGoverningInstrument ?has_governing_instrument . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isLate ?is_late . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:proceededPastBlockingControl ?proceeded_past_blocking_control . }
                BIND((COALESCE((COALESCE(?has_deviation, false) || COALESCE(?is_late, false) || COALESCE(?proceeded_past_blocking_control, false)), false) && COALESCE((!(COALESCE(?has_governing_instrument, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_UngovernedDivergenceExecutionKey a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 8 ;
    sh:rule [
