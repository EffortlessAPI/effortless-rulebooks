            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepRequirements .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requirement ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:Requirement . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isBlocking ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
