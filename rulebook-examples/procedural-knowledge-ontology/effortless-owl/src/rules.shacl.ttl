                BIND(COALESCE((?evaluated_by_agent = ?scored_step_executor_agent), ((!BOUND(?evaluated_by_agent) || STR(?evaluated_by_agent) = "") && (!BOUND(?scored_step_executor_agent) || STR(?scored_step_executor_agent) = ""))) AS ?_result)
            }
