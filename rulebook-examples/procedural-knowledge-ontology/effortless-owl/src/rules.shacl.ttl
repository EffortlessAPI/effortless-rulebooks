    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:neededLevel ?needed_level . }
                BIND((COALESCE(?held_internal_level, 0) < COALESCE(?needed_level, 0)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeAuditItems_IsKnowledgeDependency a sh:NodeShape ;
