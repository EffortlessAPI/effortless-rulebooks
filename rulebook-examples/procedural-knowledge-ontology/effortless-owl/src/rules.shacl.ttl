            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:requiresSchemaExtension ?_result .
            }
            WHERE {
    $this a pko-extension:ModelExpansionRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:uncoveredConceptCount ?uncovered_concept_count . }
                BIND((COALESCE(?uncovered_concept_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ModelExpansionRequests_FitDecisionContradictsConceptFit a sh:NodeShape ;
    sh:targetClass pko-extension:ModelExpansionRequest ;
