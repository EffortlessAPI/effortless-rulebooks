            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnprovableApprovalClaim ?_result .
            }
            WHERE {
    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:provenanceIsLiveDerived ?provenance_is_live_derived . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:templateHasValidApproval ?template_has_valid_approval . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:templateReapprovedSinceSend ?template_reapproved_since_send . }
                BIND((COALESCE(?provenance_is_live_derived, false) && COALESCE((COALESCE(?template_reapproved_since_send, false) && COALESCE(?template_has_valid_approval, false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageDeliveries_HasSentReminder a sh:NodeShape ;
    sh:targetClass pko-extension:MessageDelivery ;
    sh:order 1 ;
