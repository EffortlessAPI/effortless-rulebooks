            WHERE {
    $this a prov:Agent .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a prov:Agent .
                    ?child a pko-extension:AssistantAnswer .
                    ?child pko-native-procedural-knowledge-rulebook:answeringAgent $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:taskOutcome ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Completed"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Agents_AiTaskCompletionPercent a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_AiTaskCompletionPercent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:aiTaskCompletionPercent ?_result .
            }
            WHERE {
    $this a prov:Agent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:aiTaskCompletedCount ?ai_task_completed_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:answerCount ?answer_count . }
                BIND(IF(COALESCE((COALESCE(?answer_count, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?ai_task_completed_count) / ?answer_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
