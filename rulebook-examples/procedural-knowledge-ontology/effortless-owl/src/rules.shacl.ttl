    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:revealedJudgment ?revealed_judgment . OPTIONAL { ?revealed_judgment erb:key ?revealed_judgment__key . } }
                BIND((COALESCE(?revealed_judgment__key, COALESCE(IF(isIRI(?revealed_judgment), REPLACE(STR(?revealed_judgment), "^.*[#/]", ""), STR(?revealed_judgment)), "")) != "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for CueObservations ===
pko-native-procedural-knowledge-rulebook-shapes:CueObservations_Name a sh:NodeShape ;
    sh:targetClass pko-extension:CueObservation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CueObservations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:CueObservation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepCue ?step_cue . OPTIONAL { ?step_cue erb:key ?step_cue__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . OPTIONAL { ?step_execution erb:key ?step_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_execution__key, IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution))), ""), " / ", COALESCE(COALESCE(?step_cue__key, IF(isIRI(?step_cue), REPLACE(STR(?step_cue), "^.*[#/]", ""), STR(?step_cue))), "")) AS ?_result)
            }
        """ ;
    ] .
