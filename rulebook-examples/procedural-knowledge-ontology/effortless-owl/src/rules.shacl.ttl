    OPTIONAL { $this effortless-ntwf:assignedRole ?assigned_role . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?assigned_role), ""), "^.*#", "") = "controller"), false) || COALESCE((REPLACE(COALESCE(STR(?assigned_role), ""), "^.*#", "") = "cfo"), false)) AS ?_result)
            }
