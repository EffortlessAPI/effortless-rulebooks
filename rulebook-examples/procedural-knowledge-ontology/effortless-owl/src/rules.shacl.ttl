    $this a pko-extension:RepertoryGridConstruct .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:poleA ?pole_a . OPTIONAL { ?pole_a erb:key ?pole_a__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:separatesSituations ?separates_situations . }
                BIND((COALESCE((COALESCE(?pole_a__key, COALESCE(IF(isIRI(?pole_a), REPLACE(STR(?pole_a), "^.*[#/]", ""), STR(?pole_a)), "")) != ""), false) && COALESCE(?separates_situations, false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for RepresentationReviews ===
pko-native-procedural-knowledge-rulebook-shapes:RepresentationReviews_Name a sh:NodeShape ;
