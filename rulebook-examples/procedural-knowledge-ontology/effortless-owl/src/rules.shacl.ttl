                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:modifiedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
