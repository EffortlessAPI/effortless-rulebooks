pko-native-procedural-knowledge-rulebook-shapes:ModelChangeRequests_AcceptanceFailureTotal a sh:NodeShape ;
    sh:targetClass pko-extension:ModelChangeRequest ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_AcceptanceFailureTotal" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:acceptanceFailureTotal ?_result .
            }
            WHERE {
    $this a pko-extension:ModelChangeRequest .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:ModelChangeRequest .
                    ?child a pko-extension:ChangeValidationRun .
                    ?child pko-native-procedural-knowledge-rulebook:modelChangeRequest $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:runPurpose ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:failureCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Acceptance"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
