                BIND((COALESCE((COALESCE(?agent_kind__key, COALESCE(IF(isIRI(?agent_kind), REPLACE(STR(?agent_kind), "^.*[#/]", ""), STR(?agent_kind)), "")) = "AIAgent"), false) && COALESCE((COALESCE(?answer_count, 0) > 0), false) && COALESCE((COALESCE(?search_event_count, 0) = 0), false)) AS ?_result)
            }
