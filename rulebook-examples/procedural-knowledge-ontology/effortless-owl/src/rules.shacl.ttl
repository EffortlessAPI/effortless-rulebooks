            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:labelKind ?label_kind . OPTIONAL { ?label_kind erb:key ?label_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:vocabularyTerm ?vocabulary_term . OPTIONAL { ?vocabulary_term erb:key ?vocabulary_term__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wording ?wording . OPTIONAL { ?wording erb:key ?wording__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?vocabulary_term__key, IF(isIRI(?vocabulary_term), REPLACE(STR(?vocabulary_term), "^.*[#/]", ""), STR(?vocabulary_term))), ""), " ", COALESCE(COALESCE(?label_kind__key, IF(isIRI(?label_kind), REPLACE(STR(?label_kind), "^.*[#/]", ""), STR(?label_kind))), ""), ": ", COALESCE(COALESCE(?wording__key, IF(isIRI(?wording), REPLACE(STR(?wording), "^.*[#/]", ""), STR(?wording))), "")) AS ?_result)
            }
        """ ;
    ] .
