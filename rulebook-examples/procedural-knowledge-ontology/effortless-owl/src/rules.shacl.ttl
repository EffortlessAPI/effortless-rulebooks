pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_EvaluatedControlCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_EvaluatedControlCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:evaluatedControlCount ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:assertedOnlyControlCount ?asserted_only_control_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:computedlyWitnessedControlCount ?computedly_witnessed_control_count . }
                BIND((?computedly_witnessed_control_count + ?asserted_only_control_count) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_ComputedAssuranceRatio a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ComputedAssuranceRatio" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:computedAssuranceRatio ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:computedlyWitnessedControlCount ?computedly_witnessed_control_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluatedControlCount ?evaluated_control_count . }
                BIND(IF(COALESCE((COALESCE(?evaluated_control_count, 0) = 0), false), 0, xsd:double(?computedly_witnessed_control_count / ?evaluated_control_count)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_InterestedPartyAssertionCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_InterestedPartyAssertionCount" ;
