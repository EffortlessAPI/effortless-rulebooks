pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_StatusChangeCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_StatusChangeCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:statusChangeCount ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:ProcedureExecution .
                    ?child a pko:ChangeOfStatus .
                    ?child pko:isChangeOfStatusOf $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_ClaimsCompletionWithoutAllSteps a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ClaimsCompletionWithoutAllSteps" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:claimsCompletionWithoutAllSteps ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:completedStepCount ?completed_step_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:executionStatus ?execution_status . OPTIONAL { ?execution_status erb:key ?execution_status__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:expectedStepCount ?expected_step_count . }
                BIND((COALESCE((COALESCE(?execution_status__key, COALESCE(IF(isIRI(?execution_status), REPLACE(STR(?execution_status), "^.*[#/]", ""), STR(?execution_status)), "")) = "Completed"), false) && COALESCE((COALESCE(?completed_step_count, 0) < COALESCE(?expected_step_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_IsUnconfirmedCompletion a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
