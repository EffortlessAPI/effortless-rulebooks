        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_BoundaryViolationCountForAssignment" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:boundaryViolationCountForAssignment ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pro:RoleInTime .
                    ?child a pko-extension:AgentDecisionRecord .
                    ?child pko-native-procedural-knowledge-rulebook:boundaryViolationRoleAssignmentKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:roleAssignmentId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_HasAnyBoundaryViolation a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasAnyBoundaryViolation" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasAnyBoundaryViolation ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:boundaryViolationCountForAssignment ?boundary_violation_count_for_assignment . }
                BIND((COALESCE(?boundary_violation_count_for_assignment, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_HasUngroundedGoverningBoundary a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasUngroundedGoverningBoundary" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasUngroundedGoverningBoundary ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:role ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:Role . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isGovernedByLapsedAuthority ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_SuspensionConditionMet a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_SuspensionConditionMet" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:suspensionConditionMet ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:exceedsTolerableErrorRate ?exceeds_tolerable_error_rate . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasAnyBoundaryViolation ?has_any_boundary_violation . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasUngroundedGoverningBoundary ?has_ungrounded_governing_boundary . }
                BIND((COALESCE(?exceeds_tolerable_error_rate, false) || COALESCE((COALESCE(?has_any_boundary_violation, false) || COALESCE(?has_ungrounded_governing_boundary, false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_IsOperatingUnderMetSuspensionCondition a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsOperatingUnderMetSuspensionCondition" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOperatingUnderMetSuspensionCondition ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:coversNow ?covers_now . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isNonHumanAssignment ?is_non_human_assignment . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:suspensionConditionMet ?suspension_condition_met . }
                BIND((COALESCE(?suspension_condition_met, false) && COALESCE((COALESCE(?covers_now, false) && COALESCE(?is_non_human_assignment, false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_HasDeclaredSuspensionCondition a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
