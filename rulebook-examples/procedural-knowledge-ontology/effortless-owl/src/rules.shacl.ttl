    $this a effortless-ntwf:ClaimEvidence .
                OPTIONAL { $this effortless-ntwf:knowledgeMethod ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeMethods ; effortless-ntwf:knowledgeMethodId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isApplied ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_ProcedureExecutionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
