    OPTIONAL { $this effortless-ntwf:declaredScale ?declared_scale . OPTIONAL { ?declared_scale effortless-ntwf:__key ?declared_scale__key . } }
                BIND((COALESCE((COALESCE(?change_operation__key, COALESCE(IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation)), "")) = "RenameClass"), false) || COALESCE((COALESCE(?change_operation__key, COALESCE(IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation)), "")) = "RemoveClass"), false) || COALESCE((COALESCE(?change_operation__key, COALESCE(IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation)), "")) = "ChangeDomainRange"), false) || COALESCE((COALESCE(?change_operation__key, COALESCE(IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation)), "")) = "AddDisjointness"), false) || COALESCE((COALESCE(?change_operation__key, COALESCE(IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation)), "")) = "AddVocabularyTerm"), false) || COALESCE((COALESCE(?change_operation__key, COALESCE(IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation)), "")) = "RetireDefinition"), false) || COALESCE((COALESCE(?declared_scale__key, COALESCE(IF(isIRI(?declared_scale), REPLACE(STR(?declared_scale), "^.*[#/]", ""), STR(?declared_scale)), "")) = "Major"), false)) AS ?_result)
            }
