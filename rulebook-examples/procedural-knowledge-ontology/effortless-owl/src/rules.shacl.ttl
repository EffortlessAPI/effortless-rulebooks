    $this a effortless-ntwf:RoleAssignmentUpdateTasks .
    OPTIONAL { $this effortless-ntwf:failedNoticeCount ?failed_notice_count . }
    OPTIONAL { $this effortless-ntwf:missedNextDependentRun ?missed_next_dependent_run . }
                BIND((COALESCE(?missed_next_dependent_run, false) && COALESCE((COALESCE(?failed_notice_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleAssignments ===
effortless-ntwf:RoleAssignmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleAssignments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:role ?role . OPTIONAL { ?role effortless-ntwf:__key ?role__key . } }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . OPTIONAL { ?valid_from effortless-ntwf:__key ?valid_from__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?role__key, IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role))), ""), " @ ", COALESCE(REPLACE(COALESCE(?valid_from__key, IF(isIRI(?valid_from), REPLACE(STR(?valid_from), "^.*[#/]", ""), STR(?valid_from))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsCurrent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . OPTIONAL { ?valid_to effortless-ntwf:__key ?valid_to__key . } }
                BIND((COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_CurrentAgentKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentAgentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:agent ?agent . }
    OPTIONAL { $this effortless-ntwf:isCurrent ?is_current . }
                BIND(IF(COALESCE(?is_current, false), ?agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsCurrentlyValid" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrentlyValid ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . OPTIONAL { ?valid_to effortless-ntwf:__key ?valid_to__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Active"), false) && COALESCE((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AgentRoleKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentRoleKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:agent ?agent . OPTIONAL { ?agent effortless-ntwf:__key ?agent__key . } }
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this effortless-ntwf:role ?role . OPTIONAL { ?role effortless-ntwf:__key ?role__key . } }
                BIND(IF(COALESCE(?is_currently_valid, false), CONCAT(COALESCE(COALESCE(?agent__key, IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent))), ""), "|", COALESCE(COALESCE(?role__key, IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role))), "")), "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasDeparted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasDeparted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . OPTIONAL { ?valid_to effortless-ntwf:__key ?valid_to__key . } }
                BIND((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) != ""), false) && COALESCE(COALESCE((?valid_to <= ?as_of_instant), ((!BOUND(?valid_to) || STR(?valid_to) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_CoversNow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:coversNow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . OPTIONAL { ?valid_to effortless-ntwf:__key ?valid_to__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Active"), false) && COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_RoleWhenCovering" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:roleWhenCovering ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:coversNow ?covers_now . }
    OPTIONAL { $this effortless-ntwf:role ?role . }
                BIND(IF(COALESCE(?covers_now, false), ?role, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:agent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsNonHumanAssignment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNonHumanAssignment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:agentKind ?agent_kind . OPTIONAL { ?agent_kind effortless-ntwf:__key ?agent_kind__key . } }
                BIND((!(COALESCE((COALESCE(?agent_kind__key, COALESCE(IF(isIRI(?agent_kind), REPLACE(STR(?agent_kind), "^.*[#/]", ""), STR(?agent_kind)), "")) = "Human"), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:supersedesAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsHumanToNonHumanHandover" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isHumanToNonHumanHandover ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:isNonHumanAssignment ?is_non_human_assignment . }
    OPTIONAL { $this effortless-ntwf:predecessorAgentKind ?predecessor_agent_kind . OPTIONAL { ?predecessor_agent_kind effortless-ntwf:__key ?predecessor_agent_kind__key . } }
                BIND((COALESCE((COALESCE(?predecessor_agent_kind__key, COALESCE(IF(isIRI(?predecessor_agent_kind), REPLACE(STR(?predecessor_agent_kind), "^.*[#/]", ""), STR(?predecessor_agent_kind)), "")) = "Human"), false) && COALESCE(?is_non_human_assignment, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsUnauthorizedNonHumanAssignment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnauthorizedNonHumanAssignment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:hasApprovingAuthority ?has_approving_authority . }
    OPTIONAL { $this effortless-ntwf:isNonHumanAssignment ?is_non_human_assignment . }
                BIND((COALESCE(?is_non_human_assignment, false) && COALESCE((!(COALESCE(?has_approving_authority, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_WasAuthorizedByChangeRequest" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasAuthorizedByChangeRequest ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizingChangeRequest ?authorizing_change_request . OPTIONAL { ?authorizing_change_request effortless-ntwf:__key ?authorizing_change_request__key . } }
    OPTIONAL { $this effortless-ntwf:hasApprovingAuthority ?has_approving_authority . }
                BIND((COALESCE(?has_approving_authority, false) && COALESCE((COALESCE(?authorizing_change_request__key, COALESCE(IF(isIRI(?authorizing_change_request), REPLACE(STR(?authorizing_change_request), "^.*[#/]", ""), STR(?authorizing_change_request)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_DecisionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:decisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:roleAssignmentWhenScored ?backfk .
                    $this effortless-ntwf:roleAssignmentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_OverriddenDecisionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overriddenDecisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:roleAssignmentWhenOverridden ?backfk .
                    $this effortless-ntwf:roleAssignmentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_OverrideRatePercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overrideRatePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:decisionCount ?decision_count . }
    OPTIONAL { $this effortless-ntwf:overriddenDecisionCount ?overridden_decision_count . }
                BIND(IF(COALESCE((COALESCE(?decision_count, 0) = 0), false), 0, ((?overridden_decision_count * 100) / ?decision_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorOverrideRatePercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorOverrideRatePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:supersedesAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:overrideRatePercent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_QualityRegressedVsPredecessor" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:qualityRegressedVsPredecessor ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:overrideRatePercent ?override_rate_percent . }
    OPTIONAL { $this effortless-ntwf:predecessorOverrideRatePercent ?predecessor_override_rate_percent . }
    OPTIONAL { $this effortless-ntwf:supersedesAssignment ?supersedes_assignment . OPTIONAL { ?supersedes_assignment effortless-ntwf:__key ?supersedes_assignment__key . } }
                BIND((COALESCE((COALESCE(?supersedes_assignment__key, COALESCE(IF(isIRI(?supersedes_assignment), REPLACE(STR(?supersedes_assignment), "^.*[#/]", ""), STR(?supersedes_assignment)), "")) != ""), false) && COALESCE((COALESCE(?override_rate_percent, 0) > COALESCE(?predecessor_override_rate_percent, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_DepartedRoleKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:departedRoleKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:hasDeparted ?has_departed . }
    OPTIONAL { $this effortless-ntwf:role ?role . }
                BIND(IF(COALESCE(?has_departed, false), ?role, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorDecisionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorDecisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:supersedesAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:decisionCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasSufficientSample" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasSufficientSample ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:decisionCount ?decision_count . }
    OPTIONAL { $this effortless-ntwf:minimumDecisionsForComparison ?minimum_decisions_for_comparison . }
                BIND((COALESCE(?decision_count, 0) >= COALESCE(?minimum_decisions_for_comparison, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorHasSufficientSample" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorHasSufficientSample ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:minimumDecisionsForComparison ?minimum_decisions_for_comparison . }
    OPTIONAL { $this effortless-ntwf:predecessorDecisionCount ?predecessor_decision_count . }
                BIND((COALESCE(?predecessor_decision_count, 0) >= COALESCE(?minimum_decisions_for_comparison, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ComparisonIsEvidentiallySound" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:comparisonIsEvidentiallySound ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:hasSufficientSample ?has_sufficient_sample . }
    OPTIONAL { $this effortless-ntwf:predecessorHasSufficientSample ?predecessor_has_sufficient_sample . }
                BIND((COALESCE(?has_sufficient_sample, false) && COALESCE(?predecessor_has_sufficient_sample, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_SingleOverrideSwingPercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:singleOverrideSwingPercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:decisionCount ?decision_count . }
                BIND(IF(COALESCE((COALESCE(?decision_count, 0) > 0), false), (100 / ?decision_count), 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_QualityVerdictIsUnsupported" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:qualityVerdictIsUnsupported ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:comparisonIsEvidentiallySound ?comparison_is_evidentially_sound . }
    OPTIONAL { $this effortless-ntwf:qualityRegressedVsPredecessor ?quality_regressed_vs_predecessor . }
                BIND((COALESCE((!(COALESCE(?comparison_is_evidentially_sound, false))), false) && COALESCE((!(COALESCE(?quality_regressed_vs_predecessor, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsUnmeasuredAutomationHandover" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnmeasuredAutomationHandover ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:comparisonIsEvidentiallySound ?comparison_is_evidentially_sound . }
    OPTIONAL { $this effortless-ntwf:isHumanToNonHumanHandover ?is_human_to_non_human_handover . }
                BIND((COALESCE(?is_human_to_non_human_handover, false) && COALESCE((!(COALESCE(?comparison_is_evidentially_sound, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ErrorCorrectionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:errorCorrectionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:errorCorrectionRoleAssignmentKey ?backfk .
                    $this effortless-ntwf:roleAssignmentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ErrorRatePercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:errorRatePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:decisionCount ?decision_count . }
    OPTIONAL { $this effortless-ntwf:errorCorrectionCount ?error_correction_count . }
                BIND(IF(COALESCE((COALESCE(?decision_count, 0) > 0), false), ((?error_correction_count * 100) / ?decision_count), 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasDatedAuthorization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasDatedAuthorization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:approvingAuthorityRole ?approving_authority_role . OPTIONAL { ?approving_authority_role effortless-ntwf:__key ?approving_authority_role__key . } }
    OPTIONAL { $this effortless-ntwf:authorizationDecidedAt ?authorization_decided_at . OPTIONAL { ?authorization_decided_at effortless-ntwf:__key ?authorization_decided_at__key . } }
                BIND((COALESCE((COALESCE(?approving_authority_role__key, COALESCE(IF(isIRI(?approving_authority_role), REPLACE(STR(?approving_authority_role), "^.*[#/]", ""), STR(?approving_authority_role)), "")) != ""), false) && COALESCE((COALESCE(?authorization_decided_at__key, COALESCE(IF(isIRI(?authorization_decided_at), REPLACE(STR(?authorization_decided_at), "^.*[#/]", ""), STR(?authorization_decided_at)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_DaysSinceAuthorizationReview" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceAuthorizationReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:authorizationReviewedAt ?authorization_reviewed_at . OPTIONAL { ?authorization_reviewed_at effortless-ntwf:__key ?authorization_reviewed_at__key . } }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
                BIND(ROUND(IF(COALESCE((COALESCE(?authorization_reviewed_at__key, COALESCE(IF(isIRI(?authorization_reviewed_at), REPLACE(STR(?authorization_reviewed_at), "^.*[#/]", ""), STR(?authorization_reviewed_at)), "")) != ""), false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?authorization_reviewed_at) + FLOOR((153 * (MONTH(?authorization_reviewed_at) + 12 * FLOOR((14 - MONTH(?authorization_reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?authorization_reviewed_at) + 4800 - FLOOR((14 - MONTH(?authorization_reviewed_at)) / 12)) + FLOOR((YEAR(?authorization_reviewed_at) + 4800 - FLOOR((14 - MONTH(?authorization_reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?authorization_reviewed_at) + 4800 - FLOOR((14 - MONTH(?authorization_reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?authorization_reviewed_at) + 4800 - FLOOR((14 - MONTH(?authorization_reviewed_at)) / 12)) / 400) - 32045)), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?valid_from) + FLOOR((153 * (MONTH(?valid_from) + 12 * FLOOR((14 - MONTH(?valid_from)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 4) - FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 100) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AuthorizationIsOverdueForReview" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:authorizationIsOverdueForReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizationReviewCadenceDays ?authorization_review_cadence_days . }
    OPTIONAL { $this effortless-ntwf:daysSinceAuthorizationReview ?days_since_authorization_review . }
                BIND((COALESCE((COALESCE(?authorization_review_cadence_days, 0) > 0), false) && COALESCE((COALESCE(?days_since_authorization_review, 0) > COALESCE(?authorization_review_cadence_days, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsStandingUnreviewedAutomation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStandingUnreviewedAutomation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizationIsOverdueForReview ?authorization_is_overdue_for_review . }
    OPTIONAL { $this effortless-ntwf:coversNow ?covers_now . }
    OPTIONAL { $this effortless-ntwf:isNonHumanAssignment ?is_non_human_assignment . }
                BIND((COALESCE(?covers_now, false) && COALESCE((COALESCE(?is_non_human_assignment, false) && COALESCE(?authorization_is_overdue_for_review, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsUnconditionedAutomationHandover" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnconditionedAutomationHandover ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizationReviewCadenceDays ?authorization_review_cadence_days . }
    OPTIONAL { $this effortless-ntwf:isHumanToNonHumanHandover ?is_human_to_non_human_handover . }
                BIND((COALESCE(?is_human_to_non_human_handover, false) && COALESCE((COALESCE(?authorization_review_cadence_days, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ExceedsTolerableErrorRate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:exceedsTolerableErrorRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:errorRatePercent ?error_rate_percent . }
    OPTIONAL { $this effortless-ntwf:maxTolerableErrorRatePercent ?max_tolerable_error_rate_percent . }
                BIND((COALESCE((COALESCE(?max_tolerable_error_rate_percent, 0) > 0), false) && COALESCE((COALESCE(?error_rate_percent, 0) >= COALESCE(?max_tolerable_error_rate_percent, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_BoundaryViolationCountForAssignment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryViolationCountForAssignment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:boundaryViolationRoleAssignmentKey ?backfk .
                    $this effortless-ntwf:roleAssignmentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasAnyBoundaryViolation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasAnyBoundaryViolation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:boundaryViolationCountForAssignment ?boundary_violation_count_for_assignment . }
                BIND((COALESCE(?boundary_violation_count_for_assignment, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasUngroundedGoverningBoundary" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasUngroundedGoverningBoundary ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:role ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isGovernedByLapsedAuthority ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_SuspensionConditionMet" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:suspensionConditionMet ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:exceedsTolerableErrorRate ?exceeds_tolerable_error_rate . }
    OPTIONAL { $this effortless-ntwf:hasAnyBoundaryViolation ?has_any_boundary_violation . }
    OPTIONAL { $this effortless-ntwf:hasUngroundedGoverningBoundary ?has_ungrounded_governing_boundary . }
                BIND((COALESCE(?exceeds_tolerable_error_rate, false) || COALESCE((COALESCE(?has_any_boundary_violation, false) || COALESCE(?has_ungrounded_governing_boundary, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsOperatingUnderMetSuspensionCondition" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOperatingUnderMetSuspensionCondition ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:coversNow ?covers_now . }
    OPTIONAL { $this effortless-ntwf:isNonHumanAssignment ?is_non_human_assignment . }
    OPTIONAL { $this effortless-ntwf:suspensionConditionMet ?suspension_condition_met . }
                BIND((COALESCE(?suspension_condition_met, false) && COALESCE((COALESCE(?covers_now, false) && COALESCE(?is_non_human_assignment, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasDeclaredSuspensionCondition" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasDeclaredSuspensionCondition ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:maxTolerableErrorRatePercent ?max_tolerable_error_rate_percent . }
                BIND((COALESCE(?max_tolerable_error_rate_percent, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasApprovingAuthority" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasApprovingAuthority ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:approvingAuthorityRole ?approving_authority_role . OPTIONAL { ?approving_authority_role effortless-ntwf:__key ?approving_authority_role__key . } }
                BIND((COALESCE(?approving_authority_role__key, COALESCE(IF(isIRI(?approving_authority_role), REPLACE(STR(?approving_authority_role), "^.*[#/]", ""), STR(?approving_authority_role)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasAuthorizingChangeRequest" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasAuthorizingChangeRequest ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizingChangeRequest ?authorizing_change_request . OPTIONAL { ?authorizing_change_request effortless-ntwf:__key ?authorizing_change_request__key . } }
                BIND((COALESCE(?authorizing_change_request__key, COALESCE(IF(isIRI(?authorizing_change_request), REPLACE(STR(?authorizing_change_request), "^.*[#/]", ""), STR(?authorizing_change_request)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsUnauthorizedEnforcementAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnauthorizedEnforcementAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:isEnforcementRole ?is_enforcement_role . }
    OPTIONAL { $this effortless-ntwf:isUnauthorizedNonHumanAssignment ?is_unauthorized_non_human_assignment . }
                BIND((COALESCE(?is_enforcement_role, false) && COALESCE(?is_unauthorized_non_human_assignment, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_GovernanceEvidenceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:governanceEvidenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:hasApprovingAuthority ?has_approving_authority . }
    OPTIONAL { $this effortless-ntwf:hasAuthorizingChangeRequest ?has_authorizing_change_request . }
                BIND(ROUND((IF(COALESCE(?has_approving_authority, false), 1, 0) + IF(COALESCE(?has_authorizing_change_request, false), 1, 0))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_UnauthorizedEnforcementRoleKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unauthorizedEnforcementRoleKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:isUnauthorizedNonHumanAssignment ?is_unauthorized_non_human_assignment . }
    OPTIONAL { $this effortless-ntwf:role ?role . }
                BIND(IF(COALESCE(?is_unauthorized_non_human_assignment, false), ?role, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ScopedVersionStatus" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:scopedVersionStatus ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:forProcedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:status ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsScopedToRetiredVersion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isScopedToRetiredVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:isCurrent ?is_current . }
    OPTIONAL { $this effortless-ntwf:scopedVersionStatus ?scoped_version_status . OPTIONAL { ?scoped_version_status effortless-ntwf:__key ?scoped_version_status__key . } }
                BIND((COALESCE(?is_current, false) && COALESCE((COALESCE((COALESCE(?scoped_version_status__key, COALESCE(IF(isIRI(?scoped_version_status), REPLACE(STR(?scoped_version_status), "^.*[#/]", ""), STR(?scoped_version_status)), "")) = "Deprecated"), false) || COALESCE((COALESCE(?scoped_version_status__key, COALESCE(IF(isIRI(?scoped_version_status), REPLACE(STR(?scoped_version_status), "^.*[#/]", ""), STR(?scoped_version_status)), "")) = "Archived"), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorValidTo" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorValidTo ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:supersedesAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:validTo ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorLacksValidityEnd" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorLacksValidityEnd ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:predecessorValidTo ?predecessor_valid_to . OPTIONAL { ?predecessor_valid_to effortless-ntwf:__key ?predecessor_valid_to__key . } }
    OPTIONAL { $this effortless-ntwf:supersedesAssignment ?supersedes_assignment . OPTIONAL { ?supersedes_assignment effortless-ntwf:__key ?supersedes_assignment__key . } }
                BIND((COALESCE((COALESCE(?supersedes_assignment__key, COALESCE(IF(isIRI(?supersedes_assignment), REPLACE(STR(?supersedes_assignment), "^.*[#/]", ""), STR(?supersedes_assignment)), "")) != ""), false) && COALESCE((COALESCE(?predecessor_valid_to__key, COALESCE(IF(isIRI(?predecessor_valid_to), REPLACE(STR(?predecessor_valid_to), "^.*[#/]", ""), STR(?predecessor_valid_to)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AgentVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:agent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:versionOrEmploymentKey ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AgentRolePairKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentRolePairKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:agent ?agent . OPTIONAL { ?agent effortless-ntwf:__key ?agent__key . } }
    OPTIONAL { $this effortless-ntwf:role ?role . OPTIONAL { ?role effortless-ntwf:__key ?role__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?agent__key, IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent))), ""), "|", COALESCE(COALESCE(?role__key, IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsOpenEnded" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOpenEnded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . OPTIONAL { ?valid_to effortless-ntwf:__key ?valid_to__key . } }
                BIND((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_RoleApprovalStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:roleApprovalStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:role ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:approvalStepCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ReceivesApprovalNoticesNow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:receivesApprovalNoticesNow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:coversNow ?covers_now . }
    OPTIONAL { $this effortless-ntwf:roleApprovalStepCount ?role_approval_step_count . }
                BIND((COALESCE(?covers_now, false) && COALESCE((COALESCE(?role_approval_step_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleCapabilityTags ===
effortless-ntwf:RoleCapabilityTagsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleCapabilityTags ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleCapabilityTags_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleCapabilityTags .
    OPTIONAL { $this effortless-ntwf:capabilityTerm ?capability_term . OPTIONAL { ?capability_term effortless-ntwf:__key ?capability_term__key . } }
    OPTIONAL { $this effortless-ntwf:role ?role . OPTIONAL { ?role effortless-ntwf:__key ?role__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?role__key, IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role))), ""), " can ", COALESCE(COALESCE(?capability_term__key, IF(isIRI(?capability_term), REPLACE(STR(?capability_term), "^.*[#/]", ""), STR(?capability_term))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleCapabilityTags_CapabilitySchemeDimension" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:capabilitySchemeDimension ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleCapabilityTags .
                OPTIONAL { $this effortless-ntwf:capabilityTerm ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:VocabularyTerms ; effortless-ntwf:vocabularyTermId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:schemeGovernedDimension ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleCapabilityTags_IsTagOutsideCapabilityScheme" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isTagOutsideCapabilityScheme ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleCapabilityTags .
    OPTIONAL { $this effortless-ntwf:capabilitySchemeDimension ?capability_scheme_dimension . OPTIONAL { ?capability_scheme_dimension effortless-ntwf:__key ?capability_scheme_dimension__key . } }
                BIND((COALESCE(?capability_scheme_dimension__key, COALESCE(IF(isIRI(?capability_scheme_dimension), REPLACE(STR(?capability_scheme_dimension), "^.*[#/]", ""), STR(?capability_scheme_dimension)), "")) != "AgentCapability") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleQuestions ===
effortless-ntwf:RoleQuestionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleQuestions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleQuestions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleQuestions .
    OPTIONAL { $this effortless-ntwf:askingRole ?asking_role . OPTIONAL { ?asking_role effortless-ntwf:__key ?asking_role__key . } }
    OPTIONAL { $this effortless-ntwf:questionText ?question_text . }
                BIND(CONCAT(COALESCE(COALESCE(?asking_role__key, IF(isIRI(?asking_role), REPLACE(STR(?asking_role), "^.*[#/]", ""), STR(?asking_role))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?question_text), 1, 60)), REPLACE(STR(SUBSTR(STR(?question_text), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?question_text), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleQuestions_PredicateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predicateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleQuestions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RulebookFields .
                    ?child effortless-ntwf:inventedForQuestion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleQuestions_IsAnswered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAnswered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleQuestions .
    OPTIONAL { $this effortless-ntwf:predicateCount ?predicate_count . }
                BIND((COALESCE(?predicate_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleSchemaViews ===
effortless-ntwf:RoleSchemaViewsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleSchemaViews ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
    OPTIONAL { $this effortless-ntwf:schemaName ?schema_name . OPTIONAL { ?schema_name effortless-ntwf:__key ?schema_name__key . } }
    OPTIONAL { $this effortless-ntwf:viewName ?view_name . OPTIONAL { ?view_name effortless-ntwf:__key ?view_name__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?schema_name__key, IF(isIRI(?schema_name), REPLACE(STR(?schema_name), "^.*[#/]", ""), STR(?schema_name))), ""), ".", COALESCE(COALESCE(?view_name__key, IF(isIRI(?view_name), REPLACE(STR(?view_name), "^.*[#/]", ""), STR(?view_name))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_SchemaName" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:schemaName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
                OPTIONAL { $this effortless-ntwf:roleSchema ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleSchemas ; effortless-ntwf:roleSchemaId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:schemaName ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_SourceView" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceView ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
                OPTIONAL { $this effortless-ntwf:targetTable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookTables ; effortless-ntwf:rulebookTableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:physicalView ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_GrantKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:grantKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
    OPTIONAL { $this effortless-ntwf:principal ?principal . OPTIONAL { ?principal effortless-ntwf:__key ?principal__key . } }
    OPTIONAL { $this effortless-ntwf:targetTable ?target_table . OPTIONAL { ?target_table effortless-ntwf:__key ?target_table__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), ""), "|", COALESCE(COALESCE(?target_table__key, IF(isIRI(?target_table), REPLACE(STR(?target_table), "^.*[#/]", ""), STR(?target_table))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_ColumnCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:columnCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FieldGrants .
                    ?child effortless-ntwf:grantKeyWhenReadable ?backfk .
                    $this effortless-ntwf:grantKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_TableFieldCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:tableFieldCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
                OPTIONAL { $this effortless-ntwf:targetTable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookTables ; effortless-ntwf:rulebookTableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:fieldCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_IsFullWidth" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFullWidth ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
    OPTIONAL { $this effortless-ntwf:columnCount ?column_count . }
    OPTIONAL { $this effortless-ntwf:tableFieldCount ?table_field_count . }
                BIND((COALESCE((COALESCE(?column_count, 0) > 0), false) && COALESCE((COALESCE(?column_count, 0) >= COALESCE(?table_field_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_IsDegenerateView" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDegenerateView ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
    OPTIONAL { $this effortless-ntwf:columnCount ?column_count . }
                BIND((COALESCE(?column_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleSchemas ===
effortless-ntwf:RoleSchemasShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleSchemas ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemas_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemas .
    OPTIONAL { $this effortless-ntwf:schemaName ?schema_name . }
                BIND(?schema_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemas_SearchPath" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:searchPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemas .
    OPTIONAL { $this effortless-ntwf:schemaName ?schema_name . }
                BIND(?schema_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemas_ViewCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:viewCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemas .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleSchemaViews .
                    ?child effortless-ntwf:roleSchema $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemas_IsEmptySchema" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isEmptySchema ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemas .
    OPTIONAL { $this effortless-ntwf:viewCount ?view_count . }
                BIND((COALESCE(?view_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Roles ===
effortless-ntwf:RolesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Roles ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_CurrentAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                OPTIONAL { $this effortless-ntwf:currentAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_ActiveAssignmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:activeAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:role $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_CurrentlyCoveredAssignmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentlyCoveredAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:roleWhenCovering ?backfk .
                    $this effortless-ntwf:roleId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_HasNoCurrentHolder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoCurrentHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:currentlyCoveredAssignmentCount ?currently_covered_assignment_count . }
                BIND((COALESCE(?currently_covered_assignment_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_CountOfAwaitedDecisions" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfAwaitedDecisions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeRequests .
                    ?child effortless-ntwf:authorityRole $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_CurrentAssignmentValidFrom" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentAssignmentValidFrom ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                OPTIONAL { $this effortless-ntwf:currentAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:validFrom ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsNonHumanHeld" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNonHumanHeld ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:currentAgentKind ?current_agent_kind . OPTIONAL { ?current_agent_kind effortless-ntwf:__key ?current_agent_kind__key . } }
                BIND((!(COALESCE((COALESCE(?current_agent_kind__key, COALESCE(IF(isIRI(?current_agent_kind), REPLACE(STR(?current_agent_kind), "^.*[#/]", ""), STR(?current_agent_kind)), "")) = "Human"), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsUngovernedNonHumanRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUngovernedNonHumanRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:hasNoCurrentHolder ?has_no_current_holder . }
    OPTIONAL { $this effortless-ntwf:isNonHumanHeld ?is_non_human_held . }
                BIND((COALESCE(?is_non_human_held, false) && COALESCE(?has_no_current_holder, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_DepartedAssignmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:departedAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:departedRoleKey ?backfk .
                    $this effortless-ntwf:roleId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_HasLostAHolder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasLostAHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:departedAssignmentCount ?departed_assignment_count . }
                BIND((COALESCE(?departed_assignment_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsVacatedRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isVacatedRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:hasLostAHolder ?has_lost_a_holder . }
    OPTIONAL { $this effortless-ntwf:hasNoCurrentHolder ?has_no_current_holder . }
                BIND((COALESCE(?has_lost_a_holder, false) && COALESCE(?has_no_current_holder, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_UngroundedBoundaryCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ungroundedBoundaryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AuthorityBoundaries .
                    ?child effortless-ntwf:constrainedRoleAssignmentKey ?backfk .
                    $this effortless-ntwf:roleId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsGovernedByLapsedAuthority" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isGovernedByLapsedAuthority ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:ungroundedBoundaryCount ?ungrounded_boundary_count . }
                BIND((COALESCE(?ungrounded_boundary_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_UnescalatedRefusalCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unescalatedRefusalCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SendIntents .
                    ?child effortless-ntwf:unescalatedRefusalRoleKey ?backfk .
                    $this effortless-ntwf:roleId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_UnauthorizedEnforcementAssignmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unauthorizedEnforcementAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:unauthorizedEnforcementRoleKey ?backfk .
                    $this effortless-ntwf:roleId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsUngovernedEnforcementRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUngovernedEnforcementRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:unauthorizedEnforcementAssignmentCount ?unauthorized_enforcement_assignment_count . }
                BIND((COALESCE(?unauthorized_enforcement_assignment_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_SpecializedRoleFamily" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:specializedRoleFamily ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                OPTIONAL { $this effortless-ntwf:specializesRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:roleFamily ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_SpecializationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:specializationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Roles .
                    ?child effortless-ntwf:specializesRole $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_HasSpecializations" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasSpecializations ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:specializationCount ?specialization_count . }
                BIND((COALESCE(?specialization_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsSeniorVariantNotSpecialization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSeniorVariantNotSpecialization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:roleFamily ?role_family . }
    OPTIONAL { $this effortless-ntwf:seniorityLevel ?seniority_level . OPTIONAL { ?seniority_level effortless-ntwf:__key ?seniority_level__key . } }
    OPTIONAL { $this effortless-ntwf:specializedRoleFamily ?specialized_role_family . }
    OPTIONAL { $this effortless-ntwf:specializesRole ?specializes_role . OPTIONAL { ?specializes_role effortless-ntwf:__key ?specializes_role__key . } }
                BIND((COALESCE((COALESCE(?seniority_level__key, COALESCE(IF(isIRI(?seniority_level), REPLACE(STR(?seniority_level), "^.*[#/]", ""), STR(?seniority_level)), "")) = "Senior"), false) && COALESCE((COALESCE((COALESCE(?specializes_role__key, COALESCE(IF(isIRI(?specializes_role), REPLACE(STR(?specializes_role), "^.*[#/]", ""), STR(?specializes_role)), "")) = ""), false) || COALESCE(COALESCE((?specialized_role_family != ?role_family), !((!BOUND(?specialized_role_family) || STR(?specialized_role_family) = "") && (!BOUND(?role_family) || STR(?role_family) = ""))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_OrganizationType" ;
