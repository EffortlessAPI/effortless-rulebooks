    $this a effortless-ntwf:Roles .
                OPTIONAL { $this effortless-ntwf:organization ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Organizations ; effortless-ntwf:organizationId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organizationType ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
