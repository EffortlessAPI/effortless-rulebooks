    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:priorSolver ?prior_solver . OPTIONAL { ?prior_solver erb:key ?prior_solver__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:priorSolverIsStillEngaged ?prior_solver_is_still_engaged . }
                BIND((COALESCE(?has_been_solved_before, false) && COALESCE((COALESCE(?prior_solver__key, COALESCE(IF(isIRI(?prior_solver), REPLACE(STR(?prior_solver), "^.*[#/]", ""), STR(?prior_solver)), "")) != ""), false) && COALESCE((COALESCE(?prior_solver_is_still_engaged, false) = true), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProblemOccurrences_IsRelearnedSolvedProblem a sh:NodeShape ;
    sh:targetClass pko-extension:ProblemOccurrence ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_IsRelearnedSolvedProblem" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isRelearnedSolvedProblem ?_result .
            }
            WHERE {
    $this a pko-extension:ProblemOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasBeenSolvedBefore ?has_been_solved_before . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:priorSolutionEntry ?prior_solution_entry . OPTIONAL { ?prior_solution_entry erb:key ?prior_solution_entry__key . } }
                BIND((COALESCE(?has_been_solved_before, false) && COALESCE((COALESCE(?prior_solution_entry__key, COALESCE(IF(isIRI(?prior_solution_entry), REPLACE(STR(?prior_solution_entry), "^.*[#/]", ""), STR(?prior_solution_entry)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProblemOccurrences_IsTurnoverRegression a sh:NodeShape ;
    sh:targetClass pko-extension:ProblemOccurrence ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_IsTurnoverRegression" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isTurnoverRegression ?_result .
            }
            WHERE {
    $this a pko-extension:ProblemOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isRelearnedSolvedProblem ?is_relearned_solved_problem . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:priorSolver ?prior_solver . OPTIONAL { ?prior_solver erb:key ?prior_solver__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:priorSolverIsStillEngaged ?prior_solver_is_still_engaged . }
                BIND((COALESCE(?is_relearned_solved_problem, false) && COALESCE((COALESCE(?prior_solver__key, COALESCE(IF(isIRI(?prior_solver), REPLACE(STR(?prior_solver), "^.*[#/]", ""), STR(?prior_solver)), "")) != ""), false) && COALESCE((COALESCE(?prior_solver_is_still_engaged, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcedureAdoptions ===
pko-native-procedural-knowledge-rulebook-shapes:ProcedureAdoptions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ProcedureAdoption ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureAdoptions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ProcedureAdoption .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:organization ?organization . OPTIONAL { ?organization erb:key ?organization__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?procedure . OPTIONAL { ?procedure erb:key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?organization__key, IF(isIRI(?organization), REPLACE(STR(?organization), "^.*[#/]", ""), STR(?organization))), ""), " adopts ", COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureAdoptions_IsAdoptionModeUnstated a sh:NodeShape ;
    sh:targetClass pko-extension:ProcedureAdoption ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureAdoptions_IsAdoptionModeUnstated" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isAdoptionModeUnstated ?_result .
            }
            WHERE {
    $this a pko-extension:ProcedureAdoption .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:adoptionMode ?adoption_mode . OPTIONAL { ?adoption_mode erb:key ?adoption_mode__key . } }
                BIND((COALESCE(?adoption_mode__key, COALESCE(IF(isIRI(?adoption_mode), REPLACE(STR(?adoption_mode), "^.*[#/]", ""), STR(?adoption_mode)), "")) = "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcedureExecutions ===
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_Name a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:context ?context . OPTIONAL { ?context erb:key ?context__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version erb:key ?procedure_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " / ", COALESCE(COALESCE(?context__key, IF(isIRI(?context), REPLACE(STR(?context), "^.*[#/]", ""), STR(?context))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_ExpectedStepCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ExpectedStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:expectedStepCount ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:ProcedureVersions . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:specifiedStepCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_CompletedStepCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_CompletedStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:completedStepCount ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:ProcedureExecution .
                    ?child a pko:StepExecution .
                    ?child pko-native-procedural-knowledge-rulebook:completedExecutionKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:procedureExecutionId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_ControlBreachCount a sh:NodeShape ;
