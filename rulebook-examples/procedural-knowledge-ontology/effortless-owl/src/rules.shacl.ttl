    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:accountableRole ?accountable_role . OPTIONAL { ?accountable_role erb:key ?accountable_role__key . } }
                BIND((COALESCE(?accountable_role__key, COALESCE(IF(isIRI(?accountable_role), REPLACE(STR(?accountable_role), "^.*[#/]", ""), STR(?accountable_role)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_IsOrphanedBlockingControl a sh:NodeShape ;
