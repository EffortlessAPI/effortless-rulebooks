    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_LacksLifecycleStageControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lacksLifecycleStageControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:collectionControlCount ?collection_control_count . }
    OPTIONAL { $this effortless-ntwf:modelKind ?model_kind . OPTIONAL { ?model_kind effortless-ntwf:__key ?model_kind__key . } }
    OPTIONAL { $this effortless-ntwf:retrievalControlCount ?retrieval_control_count . }
    OPTIONAL { $this effortless-ntwf:stewardshipControlCount ?stewardship_control_count . }
    OPTIONAL { $this effortless-ntwf:useControlCount ?use_control_count . }
                BIND((COALESCE((COALESCE(?model_kind__key, COALESCE(IF(isIRI(?model_kind), REPLACE(STR(?model_kind), "^.*[#/]", ""), STR(?model_kind)), "")) = "ProcedureFamily"), false) && COALESCE((COALESCE((COALESCE(?collection_control_count, 0) = 0), false) || COALESCE((COALESCE(?stewardship_control_count, 0) = 0), false) || COALESCE((COALESCE(?retrieval_control_count, 0) = 0), false) || COALESCE((COALESCE(?use_control_count, 0) = 0), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
