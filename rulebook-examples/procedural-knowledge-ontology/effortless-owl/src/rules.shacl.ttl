            }
            WHERE {
    $this a pko-extension:ProcedureLensView .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lensGranularityRank ?lens_granularity_rank . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?procedure . }
                BIND(IF(COALESCE((COALESCE(?lens_granularity_rank, 0) = 3), false), ?procedure, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureLensViews_CategoryLevelProcedureKey a sh:NodeShape ;
