            CONSTRUCT {
                $this effortless-ntwf:generatedEntityCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ExecutionEntities .
                    ?child effortless-ntwf:generatedExecutionKey ?backfk .
                    $this effortless-ntwf:stepExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_StepInputVariableCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepInputVariableCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:inputVariableCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_RanWithoutDeclaredInputs" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ranWithoutDeclaredInputs ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:isCompleted ?is_completed . }
    OPTIONAL { $this effortless-ntwf:stepInputVariableCount ?step_input_variable_count . }
    OPTIONAL { $this effortless-ntwf:usedEntityCount ?used_entity_count . }
                BIND((COALESCE(?is_completed, false) && COALESCE((COALESCE(?step_input_variable_count, 0) > 0), false) && COALESCE((COALESCE(?used_entity_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_StepPrerequisite" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepPrerequisite ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:prerequisiteStep ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_CompletedPrerequisiteRunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:completedPrerequisiteRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:step ?backfk .
                    $this effortless-ntwf:stepPrerequisite ?backpv .
                    OPTIONAL { ?child effortless-ntwf:procedureExecution ?c2 . }
                    OPTIONAL { $this effortless-ntwf:procedureExecution ?p2 . }
                    OPTIONAL { ?child effortless-ntwf:executionStatus ?c4 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(REPLACE(STR(?c2), "^.*[#/]", "") = REPLACE(STR(?p2), "^.*[#/]", ""))
                    FILTER((STR(?c4) = "Completed"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_RanBeforePrerequisiteCompleted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ranBeforePrerequisiteCompleted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:completedPrerequisiteRunCount ?completed_prerequisite_run_count . }
    OPTIONAL { $this effortless-ntwf:stepPrerequisite ?step_prerequisite . OPTIONAL { ?step_prerequisite effortless-ntwf:__key ?step_prerequisite__key . } }
                BIND((COALESCE((COALESCE(?step_prerequisite__key, COALESCE(IF(isIRI(?step_prerequisite), REPLACE(STR(?step_prerequisite), "^.*[#/]", ""), STR(?step_prerequisite)), "")) != ""), false) && COALESCE((COALESCE(?completed_prerequisite_run_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_DeviationExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:deviationExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:hasDeviation ?has_deviation . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?has_deviation, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_BrokeInvariant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:brokeInvariant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:violatedInvariantCount ?violated_invariant_count . }
                BIND((COALESCE(?violated_invariant_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsBlockedByIncompletePrerequisite" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBlockedByIncompletePrerequisite ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:completedPrerequisiteRunCount ?completed_prerequisite_run_count . }
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . OPTIONAL { ?execution_status effortless-ntwf:__key ?execution_status__key . } }
    OPTIONAL { $this effortless-ntwf:stepPrerequisite ?step_prerequisite . OPTIONAL { ?step_prerequisite effortless-ntwf:__key ?step_prerequisite__key . } }
                BIND((COALESCE((COALESCE(?step_prerequisite__key, COALESCE(IF(isIRI(?step_prerequisite), REPLACE(STR(?step_prerequisite), "^.*[#/]", ""), STR(?step_prerequisite)), "")) != ""), false) && COALESCE((COALESCE(?completed_prerequisite_run_count, 0) = 0), false) && COALESCE((COALESCE(?execution_status__key, COALESCE(IF(isIRI(?execution_status), REPLACE(STR(?execution_status), "^.*[#/]", ""), STR(?execution_status)), "")) != "Completed"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepFunctions ===
effortless-ntwf:StepFunctionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepFunctions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepFunctions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepFunctions .
    OPTIONAL { $this effortless-ntwf:function ?function . OPTIONAL { ?function effortless-ntwf:__key ?function__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?function__key, IF(isIRI(?function), REPLACE(STR(?function), "^.*[#/]", ""), STR(?function))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepLockRequirements ===
