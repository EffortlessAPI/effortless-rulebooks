            WHERE {
    $this a pko-extension:Recipient .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isEmailReachable ?is_email_reachable . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isSmsReachable ?is_sms_reachable . }
                BIND((COALESCE((!(COALESCE(?is_sms_reachable, false))), false) && COALESCE((!(COALESCE(?is_email_reachable, false))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for RecordsRetentionPolicies ===
pko-native-procedural-knowledge-rulebook-shapes:RecordsRetentionPolicies_Name a sh:NodeShape ;
    sh:targetClass pko-extension:RecordsRetentionPolicy ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RecordsRetentionPolicies_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:RecordsRetentionPolicy .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recordClass ?record_class . OPTIONAL { ?record_class erb:key ?record_class__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:retentionDriver ?retention_driver . OPTIONAL { ?retention_driver erb:key ?retention_driver__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?record_class__key, IF(isIRI(?record_class), REPLACE(STR(?record_class), "^.*[#/]", ""), STR(?record_class))), ""), " / ", COALESCE(COALESCE(?retention_driver__key, IF(isIRI(?retention_driver), REPLACE(STR(?retention_driver), "^.*[#/]", ""), STR(?retention_driver))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RecordsRetentionPolicies_ProgramSponsorDiscipline a sh:NodeShape ;
    sh:targetClass pko-extension:RecordsRetentionPolicy ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RecordsRetentionPolicies_ProgramSponsorDiscipline" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:programSponsorDiscipline ?_result .
            }
            WHERE {
    $this a pko-extension:RecordsRetentionPolicy .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:governanceProgram ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:CorporateGovernanceProgram . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:sponsorDiscipline ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RecordsRetentionPolicies_IsLegalLedKnowledgeDestruction a sh:NodeShape ;
    sh:targetClass pko-extension:RecordsRetentionPolicy ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RecordsRetentionPolicies_IsLegalLedKnowledgeDestruction" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isLegalLedKnowledgeDestruction ?_result .
            }
            WHERE {
    $this a pko-extension:RecordsRetentionPolicy .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeUsefulLifeYears ?knowledge_useful_life_years . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:programSponsorDiscipline ?program_sponsor_discipline . OPTIONAL { ?program_sponsor_discipline erb:key ?program_sponsor_discipline__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:retentionDriver ?retention_driver . OPTIONAL { ?retention_driver erb:key ?retention_driver__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:retentionYears ?retention_years . }
                BIND((COALESCE((COALESCE(?program_sponsor_discipline__key, COALESCE(IF(isIRI(?program_sponsor_discipline), REPLACE(STR(?program_sponsor_discipline), "^.*[#/]", ""), STR(?program_sponsor_discipline)), "")) = "Legal"), false) && COALESCE((COALESCE(?retention_driver__key, COALESCE(IF(isIRI(?retention_driver), REPLACE(STR(?retention_driver), "^.*[#/]", ""), STR(?retention_driver)), "")) = "ComplianceRisk"), false) && COALESCE((COALESCE(?retention_years, 0) < COALESCE(?knowledge_useful_life_years, 0)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for RegulatoryFrameworks ===
pko-native-procedural-knowledge-rulebook-shapes:RegulatoryFrameworks_Name a sh:NodeShape ;
    sh:targetClass pko-extension:RegulatoryFramework ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RegulatoryFrameworks_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:RegulatoryFramework .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RegulatoryFrameworks_RequirementCount a sh:NodeShape ;
    sh:targetClass pko-extension:RegulatoryFramework ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RegulatoryFrameworks_RequirementCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:requirementCount ?_result .
            }
            WHERE {
    $this a pko-extension:RegulatoryFramework .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:RegulatoryFramework .
                    ?child a pko:Requirement .
                    ?child pko-native-procedural-knowledge-rulebook:regulatoryFramework $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RegulatoryFrameworks_RequiredProcedureCount a sh:NodeShape ;
