pko-native-procedural-knowledge-rulebook-shapes:KnowledgeFragments_IsWithinValidityWindow a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeFragment ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsWithinValidityWindow" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isWithinValidityWindow ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeFragment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validFrom ?valid_from . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validTo ?valid_to . OPTIONAL { ?valid_to erb:key ?valid_to__key . } }
                BIND((COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
