    $this a pko-extension:VocabularyTerm .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:introducedInRelease ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:RulebookReleases . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:issuedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_LatestMeaningChangeAt a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_LatestMeaningChangeAt" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:latestMeaningChangeAt ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:VocabularyTerm .
                    ?child a pko-extension:TermMeaningChange .
                    ?child pko-native-procedural-knowledge-rulebook:vocabularyTerm $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:changedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_HasStaleDefinition a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_HasStaleDefinition" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasStaleDefinition ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:definitionRevisedAt ?definition_revised_at . OPTIONAL { ?definition_revised_at erb:key ?definition_revised_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:latestMeaningChangeAt ?latest_meaning_change_at . OPTIONAL { ?latest_meaning_change_at erb:key ?latest_meaning_change_at__key . } }
                BIND((COALESCE((COALESCE(?latest_meaning_change_at__key, COALESCE(IF(isIRI(?latest_meaning_change_at), REPLACE(STR(?latest_meaning_change_at), "^.*[#/]", ""), STR(?latest_meaning_change_at)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?definition_revised_at__key, COALESCE(IF(isIRI(?definition_revised_at), REPLACE(STR(?definition_revised_at), "^.*[#/]", ""), STR(?definition_revised_at)), "")) = ""), false) || COALESCE(COALESCE((?definition_revised_at < ?latest_meaning_change_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_StructuralShiftCount a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_StructuralShiftCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:structuralShiftCount ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:VocabularyTerm .
                    ?child a pko-extension:TermMeaningChange .
                    ?child pko-native-procedural-knowledge-rulebook:vocabularyTerm $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isStructuralChange ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:spanDays ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER((BOUND(?c4) && xsd:double(STR(?c4)) >= 700))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_HasStructuralSenseShiftAcrossYears a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_HasStructuralSenseShiftAcrossYears" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasStructuralSenseShiftAcrossYears ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:structuralShiftCount ?structural_shift_count . }
                BIND((COALESCE(?structural_shift_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_PrefLabelPractitionerMentionCount a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_PrefLabelPractitionerMentionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:prefLabelPractitionerMentionCount ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:VocabularyTerm .
                    ?child a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
                    ?child pko-native-procedural-knowledge-rulebook:vocabularyTerm $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:labelKind ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:practitionerMentionCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "pref"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_AltLabelPractitionerMentionCount a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_AltLabelPractitionerMentionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
