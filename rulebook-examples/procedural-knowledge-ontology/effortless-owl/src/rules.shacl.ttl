    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:navGroup ?nav_group . OPTIONAL { ?nav_group erb:key ?nav_group__key . } }
                BIND((COALESCE(?nav_group__key, COALESCE(IF(isIRI(?nav_group), REPLACE(STR(?nav_group), "^.*[#/]", ""), STR(?nav_group)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AppRoutes_IsShared a sh:NodeShape ;
    sh:targetClass pko-extension:AppRoute ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_IsShared" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isShared ?_result .
            }
            WHERE {
    $this a pko-extension:AppRoute .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:owningRole ?owning_role . OPTIONAL { ?owning_role erb:key ?owning_role__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:surface ?surface . OPTIONAL { ?surface erb:key ?surface__key . } }
                BIND((COALESCE((COALESCE(?owning_role__key, COALESCE(IF(isIRI(?owning_role), REPLACE(STR(?owning_role), "^.*[#/]", ""), STR(?owning_role)), "")) = ""), false) && COALESCE((COALESCE(?surface__key, COALESCE(IF(isIRI(?surface), REPLACE(STR(?surface), "^.*[#/]", ""), STR(?surface)), "")) = "domain"), false)) AS ?_result)
            }
        """ ;
    ] .
