                OPTIONAL { ?j1 a effortless-ntwf:RulebookTables ; effortless-ntwf:rulebookTableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:hasMeasuredRows ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
