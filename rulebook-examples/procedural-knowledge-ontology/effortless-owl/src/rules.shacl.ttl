            WHERE {
    $this a effortless-ntwf:OnboardingRecords .
    OPTIONAL { $this effortless-ntwf:proficientAt ?proficient_at . OPTIONAL { ?proficient_at effortless-ntwf:__key ?proficient_at__key . } }
    OPTIONAL { $this effortless-ntwf:startedAt ?started_at . OPTIONAL { ?started_at effortless-ntwf:__key ?started_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE((COALESCE(?started_at__key, COALESCE(IF(isIRI(?started_at), REPLACE(STR(?started_at), "^.*[#/]", ""), STR(?started_at)), "")) = ""), false) || COALESCE((COALESCE(?proficient_at__key, COALESCE(IF(isIRI(?proficient_at), REPLACE(STR(?proficient_at), "^.*[#/]", ""), STR(?proficient_at)), "")) = ""), false)), false), 0, ((DAY(?proficient_at) + FLOOR((153 * (MONTH(?proficient_at) + 12 * FLOOR((14 - MONTH(?proficient_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?proficient_at) + 4800 - FLOOR((14 - MONTH(?proficient_at)) / 12)) + FLOOR((YEAR(?proficient_at) + 4800 - FLOOR((14 - MONTH(?proficient_at)) / 12)) / 4) - FLOOR((YEAR(?proficient_at) + 4800 - FLOOR((14 - MONTH(?proficient_at)) / 12)) / 100) + FLOOR((YEAR(?proficient_at) + 4800 - FLOOR((14 - MONTH(?proficient_at)) / 12)) / 400) - 32045) - (DAY(?started_at) + FLOOR((153 * (MONTH(?started_at) + 12 * FLOOR((14 - MONTH(?started_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 4) - FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 100) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
