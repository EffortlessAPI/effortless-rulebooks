    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsUnreachableKnowledge" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnreachableKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:consumerSyncCount ?consumer_sync_count . }
    OPTIONAL { $this effortless-ntwf:isCurrent ?is_current . }
    OPTIONAL { $this effortless-ntwf:publishedProjectionCount ?published_projection_count . }
                BIND((COALESCE(?is_current, false) && COALESCE((COALESCE(?published_projection_count, 0) = 0), false) && COALESCE((COALESCE(?consumer_sync_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
