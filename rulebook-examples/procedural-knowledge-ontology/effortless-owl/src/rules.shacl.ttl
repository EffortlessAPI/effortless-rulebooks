            }
            WHERE {
    $this a pko:StepExecution .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a p-plan:Step . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:prerequisiteStep ?j3 . } }
