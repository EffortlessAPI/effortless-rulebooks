            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:recognitionCount ?_result .
            }
            WHERE {
    $this a prov:Agent .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a prov:Agent .
                    ?child a pko-extension:SharingRecognition .
                    ?child pko-native-procedural-knowledge-rulebook:recognizedAgent $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Agents_IsUnrewardedSharer a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_IsUnrewardedSharer" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnrewardedSharer ?_result .
            }
            WHERE {
    $this a prov:Agent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recognitionCount ?recognition_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:transfersGivenCount ?transfers_given_count . }
                BIND((COALESCE((COALESCE(?transfers_given_count, 0) >= 2), false) && COALESCE((COALESCE(?recognition_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Agents_DownstreamOfHeldStepsCount a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_DownstreamOfHeldStepsCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:downstreamOfHeldStepsCount ?_result .
            }
            WHERE {
    $this a prov:Agent .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a prov:Agent .
                    ?child a p-plan:Step .
                    ?child pko-native-procedural-knowledge-rulebook:accountableAgent ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:agentId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:downstreamArtifactStepCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Agents_ArtifactBlastRadiusStepCount a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_ArtifactBlastRadiusStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:artifactBlastRadiusStepCount ?_result .
            }
            WHERE {
    $this a prov:Agent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:agentKind ?agent_kind . OPTIONAL { ?agent_kind erb:key ?agent_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:downstreamOfHeldStepsCount ?downstream_of_held_steps_count . }
                BIND(ROUND(IF(COALESCE((COALESCE(?agent_kind__key, COALESCE(IF(isIRI(?agent_kind), REPLACE(STR(?agent_kind), "^.*[#/]", ""), STR(?agent_kind)), "")) = "AIAgent"), false), ?downstream_of_held_steps_count, 0)) AS ?_result)
            }
        """ ;
    ] .

