            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isKnowledgeProcessOutsourcing ?_result .
            }
            WHERE {
    $this a pko-extension:SourcingFunction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOutsourced ?is_outsourced . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:workNature ?work_nature . OPTIONAL { ?work_nature erb:key ?work_nature__key . } }
                BIND((COALESCE(?is_outsourced, false) && COALESCE((COALESCE(?work_nature__key, COALESCE(IF(isIRI(?work_nature), REPLACE(STR(?work_nature), "^.*[#/]", ""), STR(?work_nature)), "")) = "ExpertiseHeavy"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourcingFunctions_IsVitalExpertiseClassedNonCore a sh:NodeShape ;
    sh:targetClass pko-extension:SourcingFunction ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsVitalExpertiseClassedNonCore" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isVitalExpertiseClassedNonCore ?_result .
            }
            WHERE {
    $this a pko-extension:SourcingFunction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isStrategicallyVital ?is_strategically_vital . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourcingClass ?sourcing_class . OPTIONAL { ?sourcing_class erb:key ?sourcing_class__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:workNature ?work_nature . OPTIONAL { ?work_nature erb:key ?work_nature__key . } }
                BIND((COALESCE((COALESCE(?sourcing_class__key, COALESCE(IF(isIRI(?sourcing_class), REPLACE(STR(?sourcing_class), "^.*[#/]", ""), STR(?sourcing_class)), "")) = "SentOutExecution"), false) && COALESCE(?is_strategically_vital, false) && COALESCE((COALESCE(?work_nature__key, COALESCE(IF(isIRI(?work_nature), REPLACE(STR(?work_nature), "^.*[#/]", ""), STR(?work_nature)), "")) = "ExpertiseHeavy"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourcingFunctions_IsWhatHowSplit a sh:NodeShape ;
    sh:targetClass pko-extension:SourcingFunction ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsWhatHowSplit" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isWhatHowSplit ?_result .
            }
            WHERE {
    $this a pko-extension:SourcingFunction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:methodHolder ?method_holder . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:specificationHolder ?specification_holder . }
                BIND(COALESCE((?specification_holder != ?method_holder), !((!BOUND(?specification_holder) || STR(?specification_holder) = "") && (!BOUND(?method_holder) || STR(?method_holder) = ""))) AS ?_result)
            }
        """ ;
    ] .
