# === Rules for ElicitationSessions ===
pko-native-procedural-knowledge-rulebook-shapes:ElicitationSessions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ElicitationSession ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ElicitationSession .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:method ?method . OPTIONAL { ?method erb:key ?method__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:startedAt ?started_at . OPTIONAL { ?started_at erb:key ?started_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?method__key, IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method))), ""), " / ", COALESCE(REPLACE(COALESCE(?started_at__key, IF(isIRI(?started_at), REPLACE(STR(?started_at), "^.*[#/]", ""), STR(?started_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ElicitationSessions_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-extension:ElicitationSession ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_AsOfInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-extension:ElicitationSession .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ElicitationSessions_DaysSinceElicited a sh:NodeShape ;
    sh:targetClass pko-extension:ElicitationSession ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_DaysSinceElicited" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceElicited ?_result .
            }
            WHERE {
    $this a pko-extension:ElicitationSession .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:endedAt ?ended_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?ended_at) + FLOOR((153 * (MONTH(?ended_at) + 12 * FLOOR((14 - MONTH(?ended_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 4) - FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 100) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ElicitationSessions_IsSingleWitnessMethod a sh:NodeShape ;
    sh:targetClass pko-extension:ElicitationSession ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsSingleWitnessMethod" ;
