    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:countOfFromStepExecutions ?count_of_from_step_executions . }
                BIND((COALESCE(?count_of_from_step_executions, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_HasReachableTarget a sh:NodeShape ;
