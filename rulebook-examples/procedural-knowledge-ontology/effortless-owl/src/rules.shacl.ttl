    OPTIONAL { $this effortless-ntwf:requirementIsApprovalType ?requirement_is_approval_type . OPTIONAL { ?requirement_is_approval_type effortless-ntwf:__key ?requirement_is_approval_type__key . } }
                BIND((COALESCE((COALESCE(?requirement_is_approval_type__key, COALESCE(IF(isIRI(?requirement_is_approval_type), REPLACE(STR(?requirement_is_approval_type), "^.*[#/]", ""), STR(?requirement_is_approval_type)), "")) = "Approval"), false) && COALESCE((COALESCE((!(COALESCE(?is_fully_satisfied, false))), false) || COALESCE((!(COALESCE(?is_human_evaluated, false))), false)), false)) AS ?_result)
            }
        """ ;
