    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:geography ?geography . OPTIONAL { ?geography erb:key ?geography__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:regulatoryRegime ?regulatory_regime . OPTIONAL { ?regulatory_regime erb:key ?regulatory_regime__key . } }
                BIND(ROUND((((IF(COALESCE((COALESCE(?business_unit__key, COALESCE(IF(isIRI(?business_unit), REPLACE(STR(?business_unit), "^.*[#/]", ""), STR(?business_unit)), "")) != ""), false), 1, 0) + IF(COALESCE((COALESCE(?geography__key, COALESCE(IF(isIRI(?geography), REPLACE(STR(?geography), "^.*[#/]", ""), STR(?geography)), "")) != ""), false), 1, 0)) + IF(COALESCE((COALESCE(?customer_segment__key, COALESCE(IF(isIRI(?customer_segment), REPLACE(STR(?customer_segment), "^.*[#/]", ""), STR(?customer_segment)), "")) != ""), false), 1, 0)) + IF(COALESCE((COALESCE(?regulatory_regime__key, COALESCE(IF(isIRI(?regulatory_regime), REPLACE(STR(?regulatory_regime), "^.*[#/]", ""), STR(?regulatory_regime)), "")) != ""), false), 1, 0))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ApplicabilityScopes_StatesConditions a sh:NodeShape ;
    sh:targetClass pko-extension:ApplicabilityScope ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ApplicabilityScopes_StatesConditions" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:statesConditions ?_result .
            }
            WHERE {
    $this a pko-extension:ApplicabilityScope .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:appliesWhen ?applies_when . OPTIONAL { ?applies_when erb:key ?applies_when__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:exclusionCondition ?exclusion_condition . OPTIONAL { ?exclusion_condition erb:key ?exclusion_condition__key . } }
                BIND((COALESCE((COALESCE(?applies_when__key, COALESCE(IF(isIRI(?applies_when), REPLACE(STR(?applies_when), "^.*[#/]", ""), STR(?applies_when)), "")) != ""), false) || COALESCE((COALESCE(?exclusion_condition__key, COALESCE(IF(isIRI(?exclusion_condition), REPLACE(STR(?exclusion_condition), "^.*[#/]", ""), STR(?exclusion_condition)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ArticleClaims ===
pko-native-procedural-knowledge-rulebook-shapes:ArticleClaims_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ArticleClaim ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ArticleClaim .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:articleClaimId ?article_claim_id . OPTIONAL { ?article_claim_id erb:key ?article_claim_id__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:claimText ?claim_text . }
                BIND(CONCAT(COALESCE(COALESCE(?article_claim_id__key, IF(isIRI(?article_claim_id), REPLACE(STR(?article_claim_id), "^.*[#/]", ""), STR(?article_claim_id))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?claim_text), 1, 60)), REPLACE(STR(SUBSTR(STR(?claim_text), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?claim_text), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ArticleClaims_RequiredEvidence a sh:NodeShape ;
    sh:targetClass pko-extension:ArticleClaim ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_RequiredEvidence" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:requiredEvidence ?_result .
            }
            WHERE {
    $this a pko-extension:ArticleClaim .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:claimKind ?claim_kind . OPTIONAL { ?claim_kind erb:key ?claim_kind__key . } }
                BIND(IF(COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "Concept"), false), "a table with rows or a field with data", IF(COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "CompetencyQuestion"), false), "an answered role question with a computed answer", IF(COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "Standard"), false), "a mapped ontology profile or an applied knowledge method", IF(COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "Scenario"), false), "a procedure with recorded executions", "a discriminating witness invented for a role question")))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ArticleClaims_EvidenceCount a sh:NodeShape ;
    sh:targetClass pko-extension:ArticleClaim ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_EvidenceCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:evidenceCount ?_result .
            }
            WHERE {
    $this a pko-extension:ArticleClaim .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ArticleClaim .
                    ?child a pko-extension:ClaimEvidence .
                    ?child pko-native-procedural-knowledge-rulebook:articleClaim $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ArticleClaims_ValidEvidenceCount a sh:NodeShape ;
    sh:targetClass pko-extension:ArticleClaim ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_ValidEvidenceCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:validEvidenceCount ?_result .
            }
            WHERE {
    $this a pko-extension:ArticleClaim .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ArticleClaim .
                    ?child a pko-extension:ClaimEvidence .
                    ?child pko-native-procedural-knowledge-rulebook:articleClaim $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isValid ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ArticleClaims_AgreedEvidenceCount a sh:NodeShape ;
    sh:targetClass pko-extension:ArticleClaim ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_AgreedEvidenceCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:agreedEvidenceCount ?_result .
            }
            WHERE {
    $this a pko-extension:ArticleClaim .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ArticleClaim .
                    ?child a pko-extension:ClaimEvidence .
                    ?child pko-native-procedural-knowledge-rulebook:articleClaim $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isAgreedEvidence ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ArticleClaims_IsCovered a sh:NodeShape ;
    sh:targetClass pko-extension:ArticleClaim ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_IsCovered" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isCovered ?_result .
            }
            WHERE {
    $this a pko-extension:ArticleClaim .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validEvidenceCount ?valid_evidence_count . }
                BIND((COALESCE(?valid_evidence_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ArticleClaims_IsAgreed a sh:NodeShape ;
    sh:targetClass pko-extension:ArticleClaim ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_IsAgreed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isAgreed ?_result .
            }
            WHERE {
    $this a pko-extension:ArticleClaim .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:agreedEvidenceCount ?agreed_evidence_count . }
                BIND((COALESCE(?agreed_evidence_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ArticleClaims_HasRejectedEvidence a sh:NodeShape ;
    sh:targetClass pko-extension:ArticleClaim ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_HasRejectedEvidence" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasRejectedEvidence ?_result .
            }
            WHERE {
    $this a pko-extension:ArticleClaim .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evidenceCount ?evidence_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validEvidenceCount ?valid_evidence_count . }
                BIND((COALESCE((COALESCE(?evidence_count, 0) > 0), false) && COALESCE((COALESCE(?valid_evidence_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ArtifactHandoffs ===
pko-native-procedural-knowledge-rulebook-shapes:ArtifactHandoffs_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ArtifactHandoff ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArtifactHandoffs_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ArtifactHandoff .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fromStep ?from_step . OPTIONAL { ?from_step erb:key ?from_step__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toStep ?to_step . OPTIONAL { ?to_step erb:key ?to_step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_step__key, IF(isIRI(?from_step), REPLACE(STR(?from_step), "^.*[#/]", ""), STR(?from_step))), ""), " -> ", COALESCE(COALESCE(?to_step__key, IF(isIRI(?to_step), REPLACE(STR(?to_step), "^.*[#/]", ""), STR(?to_step))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ArtifactHandoffs_DeclaredSourceStep a sh:NodeShape ;
    sh:targetClass pko-extension:ArtifactHandoff ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArtifactHandoffs_DeclaredSourceStep" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:declaredSourceStep ?_result .
            }
            WHERE {
    $this a pko-extension:ArtifactHandoff .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepVariable ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:StepVariables . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:sourceStep ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ArtifactHandoffs_DeclaredConsumerStep a sh:NodeShape ;
    sh:targetClass pko-extension:ArtifactHandoff ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArtifactHandoffs_DeclaredConsumerStep" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:declaredConsumerStep ?_result .
            }
            WHERE {
    $this a pko-extension:ArtifactHandoff .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepVariable ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:StepVariables . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ArtifactHandoffs_DisagreesWithDeclaredVariable a sh:NodeShape ;
    sh:targetClass pko-extension:ArtifactHandoff ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArtifactHandoffs_DisagreesWithDeclaredVariable" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:disagreesWithDeclaredVariable ?_result .
            }
            WHERE {
    $this a pko-extension:ArtifactHandoff .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:declaredConsumerStep ?declared_consumer_step . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:declaredSourceStep ?declared_source_step . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fromStep ?from_step . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toStep ?to_step . }
                BIND((COALESCE(COALESCE((?from_step != ?declared_source_step), !((!BOUND(?from_step) || STR(?from_step) = "") && (!BOUND(?declared_source_step) || STR(?declared_source_step) = ""))), false) || COALESCE(COALESCE((?to_step != ?declared_consumer_step), !((!BOUND(?to_step) || STR(?to_step) = "") && (!BOUND(?declared_consumer_step) || STR(?declared_consumer_step) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for AssignmentInstantChecks ===
pko-native-procedural-knowledge-rulebook-shapes:AssignmentInstantChecks_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentInstantCheck ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentInstantCheck .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:roleAssignment ?role_assignment . OPTIONAL { ?role_assignment erb:key ?role_assignment__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?role_assignment__key, IF(isIRI(?role_assignment), REPLACE(STR(?role_assignment), "^.*[#/]", ""), STR(?role_assignment))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentInstantChecks_StepRole a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentInstantCheck ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_StepRole" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:stepRole ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentInstantCheck .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a p-plan:Step . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:assignedRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentInstantChecks_AssignmentRole a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentInstantCheck ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_AssignmentRole" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:assignmentRole ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentInstantCheck .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:roleAssignment ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:RoleInTime . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:role ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentInstantChecks_AssignmentValidFrom a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentInstantCheck ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_AssignmentValidFrom" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:assignmentValidFrom ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentInstantCheck .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:roleAssignment ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:RoleInTime . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:validFrom ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentInstantChecks_AssignmentValidTo a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentInstantCheck ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_AssignmentValidTo" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:assignmentValidTo ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentInstantCheck .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:roleAssignment ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:RoleInTime . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:validTo ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentInstantChecks_AssignmentAgent a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentInstantCheck ;
