            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepVerifications .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:verificationKind ?verification_kind . OPTIONAL { ?verification_kind erb:key ?verification_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?verification_kind__key, IF(isIRI(?verification_kind), REPLACE(STR(?verification_kind), "^.*[#/]", ""), STR(?verification_kind))), "")) AS ?_result)
            }
        """ ;
    ] .

