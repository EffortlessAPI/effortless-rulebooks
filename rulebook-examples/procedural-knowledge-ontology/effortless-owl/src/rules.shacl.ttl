            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DomainCoverageAreas .
    OPTIONAL { $this effortless-ntwf:areaLabel ?area_label . }
                BIND(?area_label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DomainCoverageAreas_IsUncoveredArea" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUncoveredArea ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DomainCoverageAreas .
    OPTIONAL { $this effortless-ntwf:coveringTable ?covering_table . OPTIONAL { ?covering_table effortless-ntwf:__key ?covering_table__key . } }
                BIND((COALESCE(?covering_table__key, COALESCE(IF(isIRI(?covering_table), REPLACE(STR(?covering_table), "^.*[#/]", ""), STR(?covering_table)), "")) = "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for DriftObservations ===
effortless-ntwf:DriftObservationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DriftObservations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DriftObservations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DriftObservations .
    OPTIONAL { $this effortless-ntwf:description ?description . }
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?description), 1, 50)), REPLACE(STR(SUBSTR(STR(?description), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?description), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DriftObservations_ReleasePassedValidation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:releasePassedValidation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DriftObservations .
                OPTIONAL { $this effortless-ntwf:sinceRelease ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookReleases ; effortless-ntwf:rulebookReleaseId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:passedValidationAtRelease ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DriftObservations_ReleaseIssuedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:releaseIssuedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DriftObservations .
                OPTIONAL { $this effortless-ntwf:sinceRelease ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookReleases ; effortless-ntwf:rulebookReleaseId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:issuedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DriftObservations_IsOpenPracticeMismatch" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOpenPracticeMismatch ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DriftObservations .
    OPTIONAL { $this effortless-ntwf:driftKind ?drift_kind . OPTIONAL { ?drift_kind effortless-ntwf:__key ?drift_kind__key . } }
    OPTIONAL { $this effortless-ntwf:resolvedAt ?resolved_at . OPTIONAL { ?resolved_at effortless-ntwf:__key ?resolved_at__key . } }
                BIND((COALESCE((COALESCE(?drift_kind__key, COALESCE(IF(isIRI(?drift_kind), REPLACE(STR(?drift_kind), "^.*[#/]", ""), STR(?drift_kind)), "")) = "PracticeMismatch"), false) && COALESCE((COALESCE(?resolved_at__key, COALESCE(IF(isIRI(?resolved_at), REPLACE(STR(?resolved_at), "^.*[#/]", ""), STR(?resolved_at)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DriftObservations_WentUndetectedByPassingSuite" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wentUndetectedByPassingSuite ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DriftObservations .
    OPTIONAL { $this effortless-ntwf:detectedBy ?detected_by . OPTIONAL { ?detected_by effortless-ntwf:__key ?detected_by__key . } }
    OPTIONAL { $this effortless-ntwf:releasePassedValidation ?release_passed_validation . }
    OPTIONAL { $this effortless-ntwf:sinceRelease ?since_release . OPTIONAL { ?since_release effortless-ntwf:__key ?since_release__key . } }
                BIND((COALESCE((COALESCE(?since_release__key, COALESCE(IF(isIRI(?since_release), REPLACE(STR(?since_release), "^.*[#/]", ""), STR(?since_release)), "")) != ""), false) && COALESCE(?release_passed_validation, false) && COALESCE((COALESCE(?detected_by__key, COALESCE(IF(isIRI(?detected_by), REPLACE(STR(?detected_by), "^.*[#/]", ""), STR(?detected_by)), "")) != "ValidationSuite"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DriftObservations_DriftFollowsCleanRelease" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:driftFollowsCleanRelease ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DriftObservations .
    OPTIONAL { $this effortless-ntwf:observedAt ?observed_at . }
    OPTIONAL { $this effortless-ntwf:releaseIssuedAt ?release_issued_at . }
    OPTIONAL { $this effortless-ntwf:releasePassedValidation ?release_passed_validation . }
    OPTIONAL { $this effortless-ntwf:sinceRelease ?since_release . OPTIONAL { ?since_release effortless-ntwf:__key ?since_release__key . } }
                BIND((COALESCE((COALESCE(?since_release__key, COALESCE(IF(isIRI(?since_release), REPLACE(STR(?since_release), "^.*[#/]", ""), STR(?since_release)), "")) != ""), false) && COALESCE(?release_passed_validation, false) && COALESCE(COALESCE((?observed_at > ?release_issued_at), false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ElicitationParticipants ===
effortless-ntwf:ElicitationParticipantsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ElicitationParticipants ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationParticipants_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationParticipants .
    OPTIONAL { $this effortless-ntwf:agent ?agent . OPTIONAL { ?agent effortless-ntwf:__key ?agent__key . } }
    OPTIONAL { $this effortless-ntwf:elicitationSession ?elicitation_session . OPTIONAL { ?elicitation_session effortless-ntwf:__key ?elicitation_session__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?agent__key, IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent))), ""), " in ", COALESCE(COALESCE(?elicitation_session__key, IF(isIRI(?elicitation_session), REPLACE(STR(?elicitation_session), "^.*[#/]", ""), STR(?elicitation_session))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationParticipants_IsPractitioner" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPractitioner ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationParticipants .
    OPTIONAL { $this effortless-ntwf:participationRole ?participation_role . OPTIONAL { ?participation_role effortless-ntwf:__key ?participation_role__key . } }
                BIND((COALESCE(?participation_role__key, COALESCE(IF(isIRI(?participation_role), REPLACE(STR(?participation_role), "^.*[#/]", ""), STR(?participation_role)), "")) = "Practitioner") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationParticipants_IsSubjectMatterExpert" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSubjectMatterExpert ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationParticipants .
    OPTIONAL { $this effortless-ntwf:participationRole ?participation_role . OPTIONAL { ?participation_role effortless-ntwf:__key ?participation_role__key . } }
                BIND((COALESCE(?participation_role__key, COALESCE(IF(isIRI(?participation_role), REPLACE(STR(?participation_role), "^.*[#/]", ""), STR(?participation_role)), "")) = "SubjectMatterExpert") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationParticipants_IsKnowledgeEngineer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isKnowledgeEngineer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationParticipants .
    OPTIONAL { $this effortless-ntwf:participationRole ?participation_role . OPTIONAL { ?participation_role effortless-ntwf:__key ?participation_role__key . } }
                BIND((COALESCE(?participation_role__key, COALESCE(IF(isIRI(?participation_role), REPLACE(STR(?participation_role), "^.*[#/]", ""), STR(?participation_role)), "")) = "KnowledgeEngineer") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationParticipants_IsKnowledgeProducer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isKnowledgeProducer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationParticipants .
    OPTIONAL { $this effortless-ntwf:knowledgeFlow ?knowledge_flow . OPTIONAL { ?knowledge_flow effortless-ntwf:__key ?knowledge_flow__key . } }
                BIND((COALESCE((COALESCE(?knowledge_flow__key, COALESCE(IF(isIRI(?knowledge_flow), REPLACE(STR(?knowledge_flow), "^.*[#/]", ""), STR(?knowledge_flow)), "")) = "Producer"), false) || COALESCE((COALESCE(?knowledge_flow__key, COALESCE(IF(isIRI(?knowledge_flow), REPLACE(STR(?knowledge_flow), "^.*[#/]", ""), STR(?knowledge_flow)), "")) = "Both"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationParticipants_IsKnowledgeConsumer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isKnowledgeConsumer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationParticipants .
    OPTIONAL { $this effortless-ntwf:knowledgeFlow ?knowledge_flow . OPTIONAL { ?knowledge_flow effortless-ntwf:__key ?knowledge_flow__key . } }
                BIND((COALESCE((COALESCE(?knowledge_flow__key, COALESCE(IF(isIRI(?knowledge_flow), REPLACE(STR(?knowledge_flow), "^.*[#/]", ""), STR(?knowledge_flow)), "")) = "Consumer"), false) || COALESCE((COALESCE(?knowledge_flow__key, COALESCE(IF(isIRI(?knowledge_flow), REPLACE(STR(?knowledge_flow), "^.*[#/]", ""), STR(?knowledge_flow)), "")) = "Both"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ElicitationSessions ===
effortless-ntwf:ElicitationSessionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ElicitationSessions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:method ?method . OPTIONAL { ?method effortless-ntwf:__key ?method__key . } }
    OPTIONAL { $this effortless-ntwf:startedAt ?started_at . OPTIONAL { ?started_at effortless-ntwf:__key ?started_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?method__key, IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method))), ""), " / ", COALESCE(REPLACE(COALESCE(?started_at__key, IF(isIRI(?started_at), REPLACE(STR(?started_at), "^.*[#/]", ""), STR(?started_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_DaysSinceElicited" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceElicited ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:endedAt ?ended_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?ended_at) + FLOOR((153 * (MONTH(?ended_at) + 12 * FLOOR((14 - MONTH(?ended_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 4) - FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 100) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsSingleWitnessMethod" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSingleWitnessMethod ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:method ?method . OPTIONAL { ?method effortless-ntwf:__key ?method__key . } }
                BIND((COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) = "Shadowing"), false) || COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) = "PractitionerInterview"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_PractitionerIsStillEngaged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:practitionerIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                OPTIONAL { $this effortless-ntwf:practitionerAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isStillEngaged ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_ValidFragmentsProduced" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:validFragmentsProduced ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeFragments .
                    ?child effortless-ntwf:validFragmentSessionKey ?backfk .
                    $this effortless-ntwf:elicitationSessionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsHighYieldSession" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isHighYieldSession ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:validFragmentsProduced ?valid_fragments_produced . }
                BIND((COALESCE(?valid_fragments_produced, 0) >= 3) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsConcentratedSingleWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isConcentratedSingleWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:isHighYieldSession ?is_high_yield_session . }
    OPTIONAL { $this effortless-ntwf:isSingleWitnessMethod ?is_single_witness_method . }
                BIND((COALESCE(?is_single_witness_method, false) && COALESCE(?is_high_yield_session, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsStaleConcentratedWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStaleConcentratedWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:daysSinceElicited ?days_since_elicited . }
    OPTIONAL { $this effortless-ntwf:isConcentratedSingleWitness ?is_concentrated_single_witness . }
                BIND((COALESCE(?is_concentrated_single_witness, false) && COALESCE((COALESCE(?days_since_elicited, 0) > 180), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_ConcentratedSessionVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:concentratedSessionVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:isConcentratedSingleWitness ?is_concentrated_single_witness . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_concentrated_single_witness, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_ElicitationMode" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:elicitationMode ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:method ?method . OPTIONAL { ?method effortless-ntwf:__key ?method__key . } }
                BIND(IF(COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) = "PractitionerInterview"), false), "Interview", IF(COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) = "Shadowing"), false), "Observation", IF(COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) = "FacilitatedWorkshop"), false), "Workshop", IF(COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) = "CriticalIncidentTechnique"), false), "Incident", IF(COALESCE((COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) = "ThinkAloudProtocol"), false) || COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) = "RetrospectiveProtocol"), false) || COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) = "ConceptLaddering"), false) || COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) = "RepertoryGrid"), false)), false), "Protocol", "Other"))))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsInterview" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInterview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:elicitationMode ?elicitation_mode . OPTIONAL { ?elicitation_mode effortless-ntwf:__key ?elicitation_mode__key . } }
                BIND((COALESCE(?elicitation_mode__key, COALESCE(IF(isIRI(?elicitation_mode), REPLACE(STR(?elicitation_mode), "^.*[#/]", ""), STR(?elicitation_mode)), "")) = "Interview") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsWorkshop" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWorkshop ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:elicitationMode ?elicitation_mode . OPTIONAL { ?elicitation_mode effortless-ntwf:__key ?elicitation_mode__key . } }
                BIND((COALESCE(?elicitation_mode__key, COALESCE(IF(isIRI(?elicitation_mode), REPLACE(STR(?elicitation_mode), "^.*[#/]", ""), STR(?elicitation_mode)), "")) = "Workshop") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_WhyProbeCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:whyProbeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:InterviewProbes .
                    ?child effortless-ntwf:elicitationSession $this .
                    OPTIONAL { ?child effortless-ntwf:probeKind ?c2 . }
                    FILTER((STR(?c2) = "Why"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_ShortfallProbeCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:shortfallProbeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:InterviewProbes .
                    ?child effortless-ntwf:elicitationSession $this .
                    OPTIONAL { ?child effortless-ntwf:probeKind ?c2 . }
                    FILTER((STR(?c2) = "ProcedureFallsShort"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsInterviewWithoutWhyProbe" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInterviewWithoutWhyProbe ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:isInterview ?is_interview . }
    OPTIONAL { $this effortless-ntwf:whyProbeCount ?why_probe_count . }
                BIND((COALESCE(?is_interview, false) && COALESCE((COALESCE(?why_probe_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsInterviewWithoutShortfallProbe" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInterviewWithoutShortfallProbe ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:isInterview ?is_interview . }
    OPTIONAL { $this effortless-ntwf:shortfallProbeCount ?shortfall_probe_count . }
                BIND((COALESCE(?is_interview, false) && COALESCE((COALESCE(?shortfall_probe_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_InitiatorCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:initiatorCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ElicitationParticipants .
                    ?child effortless-ntwf:elicitationSession $this .
                    OPTIONAL { ?child effortless-ntwf:processStake ?c2 . }
                    FILTER((STR(?c2) = "Initiates"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_ExecutorCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:executorCount ?_result .
            }
