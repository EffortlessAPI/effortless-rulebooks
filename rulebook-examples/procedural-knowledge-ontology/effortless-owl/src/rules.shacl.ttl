                $this pko-native-procedural-knowledge-rulebook:isAlignmentStaleAfterDeprecation ?_result .
            }
            WHERE {
    $this a pko-extension:ExternalStandardTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:alignmentUpdatedAt ?alignment_updated_at . OPTIONAL { ?alignment_updated_at erb:key ?alignment_updated_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deprecatedAt ?deprecated_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deprecatedBySource ?deprecated_by_source . }
                BIND((COALESCE(?deprecated_by_source, false) && COALESCE((COALESCE((COALESCE(?alignment_updated_at__key, COALESCE(IF(isIRI(?alignment_updated_at), REPLACE(STR(?alignment_updated_at), "^.*[#/]", ""), STR(?alignment_updated_at)), "")) = ""), false) || COALESCE(COALESCE((?alignment_updated_at < ?deprecated_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExternalStandardTerms_IsNeededDeprecatedTermNotRehomed a sh:NodeShape ;
