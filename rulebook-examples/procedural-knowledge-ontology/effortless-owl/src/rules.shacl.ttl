            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:reasonerRunCount ?_result .
            }
            WHERE {
    $this a pko-extension:GroundingSnapshot .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:GroundingSnapshot .
                    ?child a pko-extension:ReasonerRun .
                    ?child pko-native-procedural-knowledge-rulebook:snapshot $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:GroundingSnapshots_ConsistentReasonerRunCount a sh:NodeShape ;
    sh:targetClass pko-extension:GroundingSnapshot ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_ConsistentReasonerRunCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:consistentReasonerRunCount ?_result .
            }
            WHERE {
    $this a pko-extension:GroundingSnapshot .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:GroundingSnapshot .
                    ?child a pko-extension:ReasonerRun .
                    ?child pko-native-procedural-knowledge-rulebook:snapshot $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isConsistent ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:GroundingSnapshots_LatestMaterializedAt a sh:NodeShape ;
    sh:targetClass pko-extension:GroundingSnapshot ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_LatestMaterializedAt" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:latestMaterializedAt ?_result .
            }
            WHERE {
    $this a pko-extension:GroundingSnapshot .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:GroundingSnapshot .
                    ?child a pko-extension:ReasonerRun .
                    ?child pko-native-procedural-knowledge-rulebook:snapshot $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:materializedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:GroundingSnapshots_ServedWithoutConsistencyCheck a sh:NodeShape ;
    sh:targetClass pko-extension:GroundingSnapshot ;
    sh:order 2 ;
    sh:rule [
