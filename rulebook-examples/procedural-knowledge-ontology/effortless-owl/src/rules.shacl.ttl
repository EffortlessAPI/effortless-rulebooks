pko-native-procedural-knowledge-rulebook-shapes:AssistantAnswers_RequirementCheckCount a sh:NodeShape ;
    sh:targetClass pko-extension:AssistantAnswer ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_RequirementCheckCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:requirementCheckCount ?_result .
            }
            WHERE {
    $this a pko-extension:AssistantAnswer .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AssistantAnswer .
                    ?child a pko-extension:AnswerRequirementCheck .
                    ?child pko-native-procedural-knowledge-rulebook:assistantAnswer $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssistantAnswers_ConflictCount a sh:NodeShape ;
    sh:targetClass pko-extension:AssistantAnswer ;
    sh:order 1 ;
