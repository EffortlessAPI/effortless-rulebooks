pko-native-procedural-knowledge-rulebook-shapes:Machines_EnergySourceCount a sh:NodeShape ;
    sh:targetClass pko-industry:Machine ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Machines_EnergySourceCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:energySourceCount ?_result .
            }
            WHERE {
    $this a pko-industry:Machine .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-industry:Machine .
                    ?child a pko-extension:MachineEnergySource .
                    ?child pko-native-procedural-knowledge-rulebook:machine $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Machines_UnisolatedEnergySourceCount a sh:NodeShape ;
    sh:targetClass pko-industry:Machine ;
