                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isUnreachable ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
