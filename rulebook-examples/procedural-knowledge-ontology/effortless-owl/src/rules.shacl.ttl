pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_CompletedPrerequisiteRunCount a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_CompletedPrerequisiteRunCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:completedPrerequisiteRunCount ?_result .
            }
            WHERE {
    $this a pko:StepExecution .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:StepExecution .
                    ?child a pko:StepExecution .
                    ?child pko-native-procedural-knowledge-rulebook:step ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:stepPrerequisite ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:procedureExecution ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureExecution ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:executionStatus_StepExecutions ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    FILTER((COALESCE(?c4__key, STR(?c4)) = "Completed"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_RanBeforePrerequisiteCompleted a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 3 ;
    sh:rule [
