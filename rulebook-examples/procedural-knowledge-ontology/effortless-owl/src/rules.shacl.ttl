            CONSTRUCT {
                $this effortless-ntwf:validFragmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeFragments .
                    ?child effortless-ntwf:validFragmentVersionKey ?backfk .
                    $this effortless-ntwf:procedureVersionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_StillOwnsValidKnowledge" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stillOwnsValidKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:validFragmentCount ?valid_fragment_count . }
                BIND((COALESCE(?valid_fragment_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IncomingSupersessionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:incomingSupersessionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureVersionLinks .
                    ?child effortless-ntwf:supersededVersionKey ?backfk .
                    $this effortless-ntwf:procedureVersionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsStillReferenced" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStillReferenced ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:incomingSupersessionCount ?incoming_supersession_count . }
                BIND((COALESCE(?incoming_supersession_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsLoadBearingOrphan" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLoadBearingOrphan ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:isStillReferenced ?is_still_referenced . }
    OPTIONAL { $this effortless-ntwf:isUnstewarded ?is_unstewarded . }
    OPTIONAL { $this effortless-ntwf:stillOwnsValidKnowledge ?still_owns_valid_knowledge . }
                BIND((COALESCE(?is_unstewarded, false) && COALESCE((COALESCE(?still_owns_valid_knowledge, false) || COALESCE(?is_still_referenced, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsCleanlyRetired" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCleanlyRetired ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:isStillReferenced ?is_still_referenced . }
    OPTIONAL { $this effortless-ntwf:isUnstewarded ?is_unstewarded . }
    OPTIONAL { $this effortless-ntwf:stillOwnsValidKnowledge ?still_owns_valid_knowledge . }
                BIND((COALESCE(?is_unstewarded, false) && COALESCE((!(COALESCE(?still_owns_valid_knowledge, false))), false) && COALESCE((!(COALESCE(?is_still_referenced, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_StalledImplementationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stalledImplementationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeRequests .
                    ?child effortless-ntwf:stalledImplementationVersionKey ?backfk .
                    $this effortless-ntwf:procedureVersionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsHeldUnfitByLandedDecisions" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isHeldUnfitByLandedDecisions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:isFitToExecute ?is_fit_to_execute . }
    OPTIONAL { $this effortless-ntwf:stalledImplementationCount ?stalled_implementation_count . }
                BIND((COALESCE((!(COALESCE(?is_fit_to_execute, false))), false) && COALESCE((COALESCE(?stalled_implementation_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_UndeclaredControlKindCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:undeclaredControlKindCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:undeclaredControlVersionKey ?backfk .
                    $this effortless-ntwf:procedureVersionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ControlTaxonomyIsIncomplete" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:controlTaxonomyIsIncomplete ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:undeclaredControlKindCount ?undeclared_control_kind_count . }
                BIND((COALESCE(?undeclared_control_kind_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HasApprovedChangeRequest" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasApprovedChangeRequest ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:approvedChangeRequestCount ?approved_change_request_count . }
                BIND((COALESCE(?approved_change_request_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ApprovedChangeRequestCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approvedChangeRequestCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeRequests .
                    ?child effortless-ntwf:approvedVersionKey ?backfk .
                    $this effortless-ntwf:procedureVersionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_UnwatchedUnownedControlCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unwatchedUnownedControlCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Requirements .
                    OPTIONAL { ?child effortless-ntwf:unwatchedUnownedFlag ?c0 . }
                    FILTER((STR(?c0) = "unwatched-unowned"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_MiningRunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:miningRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcessMiningRuns .
                    ?child effortless-ntwf:procedureVersion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_DriftedMiningRunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:driftedMiningRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcessMiningRuns .
                    ?child effortless-ntwf:driftedMiningRunKey ?backfk .
                    $this effortless-ntwf:procedureVersionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HasUnresolvedMiningDrift" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasUnresolvedMiningDrift ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:driftedMiningRunCount ?drifted_mining_run_count . }
                BIND((COALESCE(?drifted_mining_run_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_EntryStepId" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:entryStepId ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:entryStepKey ?sumraw . }
                    BIND(STR(?sumraw) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] .
# Rule for DaysSinceLastReview - parse error: aggregation formula must be COUNTIFS / SUMIFS / AVERAGEIFS / MAXIFS / MINIFS / COUNTIF / their bare AGG(Child!{{Col}}) forms

# === Shape with rules for Procedures ===
effortless-ntwf:ProceduresShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Procedures ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcessMiningRuns ===
effortless-ntwf:ProcessMiningRunsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcessMiningRuns ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:eventLogSource ?event_log_source . }
    OPTIONAL { $this effortless-ntwf:minedAt ?mined_at . }
                BIND(CONCAT(IF(isIRI(?event_log_source), REPLACE(STR(?event_log_source), "^.*[#/]", ""), STR(?event_log_source)), " / ", REPLACE(IF(isIRI(?mined_at), REPLACE(STR(?mined_at), "^.*[#/]", ""), STR(?mined_at)), "Z$", "+00:00")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_ConformanceRate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:conformanceRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:conformingVariantCount ?conforming_variant_count . }
    OPTIONAL { $this effortless-ntwf:discoveredVariantCount ?discovered_variant_count . }
                BIND(IF(COALESCE((COALESCE(?discovered_variant_count, 0) = 0), false), 0, (?conforming_variant_count / ?discovered_variant_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsConformant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isConformant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:conformanceRate ?conformance_rate . }
                BIND((COALESCE(?conformance_rate, 0) >= 0.8) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_HasMajorDriftFromDocumentation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasMajorDriftFromDocumentation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:conformanceRate ?conformance_rate . }
                BIND((COALESCE(?conformance_rate, 0) < 0.5) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_DaysSinceMined" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceMined ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:minedAt ?mined_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?mined_at) + FLOOR((153 * (MONTH(?mined_at) + 12 * FLOOR((14 - MONTH(?mined_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) + FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 4) - FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 100) + FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsStaleMiningEvidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStaleMiningEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:daysSinceMined ?days_since_mined . }
                BIND((COALESCE(?days_since_mined, 0) > 180) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_ProcedureVersionIsLive" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:procedureVersionIsLive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isLive ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsDriftOnLiveVersion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDriftOnLiveVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:hasMajorDriftFromDocumentation ?has_major_drift_from_documentation . }
    OPTIONAL { $this effortless-ntwf:procedureVersionIsLive ?procedure_version_is_live . }
                BIND((COALESCE(?has_major_drift_from_documentation, false) && COALESCE(?procedure_version_is_live, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_DriftedMiningRunKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:driftedMiningRunKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:isDriftOnLiveVersion ?is_drift_on_live_version . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_drift_on_live_version, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Rationales ===
effortless-ntwf:RationalesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Rationales ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Rationales_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Rationales .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Recipients ===
effortless-ntwf:RecipientsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Recipients ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_HasSmsConsent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasSmsConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:smsConsentStatus ?sms_consent_status . }
                BIND((REPLACE(COALESCE(STR(?sms_consent_status), ""), "^.*#", "") = "Granted") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsEmailReachable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isEmailReachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:emailAddress ?email_address . }
                BIND((REPLACE(COALESCE(STR(?email_address), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsSmsReachable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSmsReachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:mobileNumber ?mobile_number . }
                BIND((REPLACE(COALESCE(STR(?mobile_number), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsUnreachable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnreachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:isEmailReachable ?is_email_reachable . }
    OPTIONAL { $this effortless-ntwf:isSmsReachable ?is_sms_reachable . }
                BIND((COALESCE((!(COALESCE(?is_email_reachable, false))), false) && COALESCE((!(COALESCE(?is_sms_reachable, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsCommunicationallyStranded" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCommunicationallyStranded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:isEmailReachable ?is_email_reachable . }
    OPTIONAL { $this effortless-ntwf:isSmsReachable ?is_sms_reachable . }
                BIND((COALESCE((!(COALESCE(?is_sms_reachable, false))), false) && COALESCE((!(COALESCE(?is_email_reachable, false))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RequirementSatisfactions ===
effortless-ntwf:RequirementSatisfactionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RequirementSatisfactions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:requirement ?requirement . }
    OPTIONAL { $this effortless-ntwf:satisfactionLevel ?satisfaction_level . }
                BIND(CONCAT(IF(isIRI(?requirement), REPLACE(STR(?requirement), "^.*[#/]", ""), STR(?requirement)), " / ", IF(isIRI(?satisfaction_level), REPLACE(STR(?satisfaction_level), "^.*[#/]", ""), STR(?satisfaction_level))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RequirementIsBlocking" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requirementIsBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isBlocking ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsFullySatisfied" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFullySatisfied ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:satisfactionLevel ?satisfaction_level . }
                BIND((REPLACE(COALESCE(STR(?satisfaction_level), ""), "^.*#", "") = "Satisfied") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsBlockingAndUnmet" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBlockingAndUnmet ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
                BIND((COALESCE(?requirement_is_blocking, false) && COALESCE((!(COALESCE(?is_fully_satisfied, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_BlockingUnmetStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:blockingUnmetStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isBlockingAndUnmet ?is_blocking_and_unmet . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_blocking_and_unmet, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_BlockingSatisfactionStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:blockingSatisfactionStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?requirement_is_blocking, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_NegativeOutcomeRequirementKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:negativeOutcomeRequirementKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this effortless-ntwf:requirement ?requirement . }
                BIND(IF(COALESCE((!(COALESCE(?is_fully_satisfied, false))), false), ?requirement, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_EvaluatorAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:evaluatorAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:evaluatedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_NonHumanEvaluatedHumanControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:nonHumanEvaluatedHumanControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:evaluatorAgentKind ?evaluator_agent_kind . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
                BIND((COALESCE(?requirement_is_blocking, false) && COALESCE((REPLACE(COALESCE(STR(?evaluator_agent_kind), ""), "^.*#", "") != "Human"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RequirementHasComputedWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requirementHasComputedWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:hasComputedWitness ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsAssertedOnly" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAssertedOnly ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this effortless-ntwf:requirementHasComputedWitness ?requirement_has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
                BIND((COALESCE(?requirement_is_blocking, false) && COALESCE(?is_fully_satisfied, false) && COALESCE((!(COALESCE(?requirement_has_computed_witness, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_AssertedOnlyExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assertedOnlyExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isAssertedOnly ?is_asserted_only . }
    OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?parent_procedure_execution . }
                BIND(IF(COALESCE(?is_asserted_only, false), ?parent_procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_ParentProcedureExecution" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:parentProcedureExecution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:procedureExecution ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_StepExecutionWhenScored" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepExecutionWhenScored ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:satisfactionLevel ?satisfaction_level . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE((REPLACE(COALESCE(STR(?satisfaction_level), ""), "^.*#", "") != ""), false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsHumanEvaluated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isHumanEvaluated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:evaluatorAgentKind ?evaluator_agent_kind . }
                BIND((REPLACE(COALESCE(STR(?evaluator_agent_kind), ""), "^.*#", "") = "Human") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RequirementIsApprovalType" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requirementIsApprovalType ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:requirementType ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsInvalidApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInvalidApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this effortless-ntwf:isHumanEvaluated ?is_human_evaluated . }
    OPTIONAL { $this effortless-ntwf:requirementIsApprovalType ?requirement_is_approval_type . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?requirement_is_approval_type), ""), "^.*#", "") = "Approval"), false) && COALESCE((COALESCE((!(COALESCE(?is_fully_satisfied, false))), false) || COALESCE((!(COALESCE(?is_human_evaluated, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_ProcedureExecutionOfSatisfaction" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:procedureExecutionOfSatisfaction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:procedureExecution ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RunWhenInvalidApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:runWhenInvalidApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isInvalidApproval ?is_invalid_approval . }
    OPTIONAL { $this effortless-ntwf:procedureExecutionOfSatisfaction ?procedure_execution_of_satisfaction . }
                BIND(IF(COALESCE(?is_invalid_approval, false), ?procedure_execution_of_satisfaction, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RequirementIsUnfalsified" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requirementIsUnfalsified ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isUnfalsifiedControl ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsClearanceByUnfalsifiedControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isClearanceByUnfalsifiedControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
    OPTIONAL { $this effortless-ntwf:requirementIsUnfalsified ?requirement_is_unfalsified . }
                BIND((COALESCE(?is_fully_satisfied, false) && COALESCE(?requirement_is_blocking, false) && COALESCE(?requirement_is_unfalsified, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_UnfalsifiedClearanceStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unfalsifiedClearanceStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isClearanceByUnfalsifiedControl ?is_clearance_by_unfalsified_control . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_clearance_by_unfalsified_control, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_SpecStepOfExecution" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:specStepOfExecution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_BindingKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:bindingKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:requirementSatisfactionId ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepRequirements ; effortless-ntwf:stepRequirementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:stepRequirementId ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_ScoredStepExecutorAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:scoredStepExecutorAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:executedByAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_EvaluatorIsStepExecutor" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:evaluatorIsStepExecutor ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:evaluatedByAgent ?evaluated_by_agent . }
    OPTIONAL { $this effortless-ntwf:scoredStepExecutorAgent ?scored_step_executor_agent . }
                BIND(COALESCE((?evaluated_by_agent = ?scored_step_executor_agent), ((!BOUND(?evaluated_by_agent) || STR(?evaluated_by_agent) = "") && (!BOUND(?scored_step_executor_agent) || STR(?scored_step_executor_agent) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RunOwnerAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:runOwnerAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureExecutions ; effortless-ntwf:procedureExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:executedByAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_EvaluatorOwnsTheRun" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:evaluatorOwnsTheRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:evaluatedByAgent ?evaluated_by_agent . }
    OPTIONAL { $this effortless-ntwf:runOwnerAgent ?run_owner_agent . }
                BIND(COALESCE((?evaluated_by_agent = ?run_owner_agent), ((!BOUND(?evaluated_by_agent) || STR(?evaluated_by_agent) = "") && (!BOUND(?run_owner_agent) || STR(?run_owner_agent) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsInterestedPartyAssertion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInterestedPartyAssertion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:evaluatorIsStepExecutor ?evaluator_is_step_executor . }
    OPTIONAL { $this effortless-ntwf:evaluatorOwnsTheRun ?evaluator_owns_the_run . }
    OPTIONAL { $this effortless-ntwf:isAssertedOnly ?is_asserted_only . }
                BIND((COALESCE(?is_asserted_only, false) && COALESCE((COALESCE(?evaluator_is_step_executor, false) || COALESCE(?evaluator_owns_the_run, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_HasWrittenEvidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasWrittenEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:evidence ?evidence . }
                BIND((REPLACE(COALESCE(STR(?evidence), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsBareAssertion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBareAssertion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:hasWrittenEvidence ?has_written_evidence . }
    OPTIONAL { $this effortless-ntwf:isAssertedOnly ?is_asserted_only . }
                BIND((COALESCE(?is_asserted_only, false) && COALESCE((!(COALESCE(?has_written_evidence, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_InterestedAssertionExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:interestedAssertionExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isInterestedPartyAssertion ?is_interested_party_assertion . }
    OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?parent_procedure_execution . }
                BIND(IF(COALESCE(?is_interested_party_assertion, false), ?parent_procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsComputedlyWitnessed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isComputedlyWitnessed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:requirementHasComputedWitness ?requirement_has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
                BIND((COALESCE(?requirement_is_blocking, false) && COALESCE(?requirement_has_computed_witness, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_ComputedWitnessExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:computedWitnessExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isComputedlyWitnessed ?is_computedly_witnessed . }
    OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?parent_procedure_execution . }
                BIND(IF(COALESCE(?is_computedly_witnessed, false), ?parent_procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_StepExecutorAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepExecutorAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:executedByAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_WasScoredAfterAttestation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasScoredAfterAttestation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:attestationInstantForRun ?attestation_instant_for_run . }
    OPTIONAL { $this effortless-ntwf:evaluatedAt ?evaluated_at . }
                BIND((COALESCE(((((DAY(?evaluated_at) + FLOOR((153 * (MONTH(?evaluated_at) + 12 * FLOOR((14 - MONTH(?evaluated_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 4) - FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 100) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 400) - 32045) - (DAY(?attestation_instant_for_run) + FLOOR((153 * (MONTH(?attestation_instant_for_run) + 12 * FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?attestation_instant_for_run) + 4800 - FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12)) + FLOOR((YEAR(?attestation_instant_for_run) + 4800 - FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12)) / 4) - FLOOR((YEAR(?attestation_instant_for_run) + 4800 - FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12)) / 100) + FLOOR((YEAR(?attestation_instant_for_run) + 4800 - FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?evaluated_at) * 3600 + MINUTES(?evaluated_at) * 60 + SECONDS(?evaluated_at)) - (HOURS(?attestation_instant_for_run) * 3600 + MINUTES(?attestation_instant_for_run) * 60 + SECONDS(?attestation_instant_for_run))) / 60), 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_AttestationInstantForRun" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:attestationInstantForRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureExecutions ; effortless-ntwf:procedureExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:latestAttestationInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_PostAttestationScoreExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:postAttestationScoreExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?parent_procedure_execution . }
    OPTIONAL { $this effortless-ntwf:wasScoredAfterAttestation ?was_scored_after_attestation . }
                BIND(IF(COALESCE(?was_scored_after_attestation, false), ?parent_procedure_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Requirements ===
effortless-ntwf:RequirementsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Requirements ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_SatisfactionRecordCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:satisfactionRecordCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:requirement $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_StepBindingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepBindingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepRequirements .
                    ?child effortless-ntwf:requirement $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsBoundToAnyStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBoundToAnyStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:stepBindingCount ?step_binding_count . }
                BIND((COALESCE(?step_binding_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_HasEverBeenEvaluated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasEverBeenEvaluated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:satisfactionRecordCount ?satisfaction_record_count . }
                BIND((COALESCE(?satisfaction_record_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_NegativeOutcomeCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:negativeOutcomeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:negativeOutcomeRequirementKey ?backfk .
                    $this effortless-ntwf:requirementId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsInoperativeControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInoperativeControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasEverBeenEvaluated ?has_ever_been_evaluated . }
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
    OPTIONAL { $this effortless-ntwf:isBoundToAnyStep ?is_bound_to_any_step . }
                BIND((COALESCE(?is_blocking, false) && COALESCE(?is_bound_to_any_step, false) && COALESCE((!(COALESCE(?has_ever_been_evaluated, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsDecorativeControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDecorativeControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
    OPTIONAL { $this effortless-ntwf:isBoundToAnyStep ?is_bound_to_any_step . }
                BIND((COALESCE(?is_blocking, false) && COALESCE((!(COALESCE(?is_bound_to_any_step, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_HasEverProducedNegative" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasEverProducedNegative ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:negativeOutcomeCount ?negative_outcome_count . }
                BIND((COALESCE(?negative_outcome_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsUnfalsifiedControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnfalsifiedControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasEverBeenEvaluated ?has_ever_been_evaluated . }
    OPTIONAL { $this effortless-ntwf:hasEverProducedNegative ?has_ever_produced_negative . }
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
                BIND((COALESCE(?is_blocking, false) && COALESCE(?has_ever_been_evaluated, false) && COALESCE((!(COALESCE(?has_ever_produced_negative, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_ClaimsAWitnessField" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:claimsAWitnessField ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:witnessFieldName ?witness_field_name . }
                BIND((REPLACE(COALESCE(STR(?witness_field_name), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_NamedWitnessFieldExists" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:namedWitnessFieldExists ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
                OPTIONAL { $this effortless-ntwf:witnessFieldName ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isDerived ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_DerivedHasComputedWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:derivedHasComputedWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:claimsAWitnessField ?claims_a_witness_field . }
    OPTIONAL { $this effortless-ntwf:namedWitnessFieldExists ?named_witness_field_exists . }
                BIND((COALESCE(?claims_a_witness_field, false) && COALESCE(?named_witness_field_exists, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_WitnessClaimIsUnverified" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:witnessClaimIsUnverified ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:derivedHasComputedWitness ?derived_has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:hasComputedWitness ?has_computed_witness . }
                BIND((!(COALESCE((COALESCE(?has_computed_witness, false) = COALESCE(?derived_has_computed_witness, false)), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsUnwitnessedBlockingControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwitnessedBlockingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:derivedHasComputedWitness ?derived_has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
                BIND((COALESCE(?is_blocking, false) && COALESCE((!(COALESCE(?derived_has_computed_witness, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_WitnessFireCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:witnessFireCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:negativeOutcomeCount ?negative_outcome_count . }
                BIND(?negative_outcome_count AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_WitnessHasNeverFired" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:witnessHasNeverFired ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:witnessFireCount ?witness_fire_count . }
                BIND((COALESCE(?has_computed_witness, false) && COALESCE((COALESCE(?witness_fire_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_EvaluationSampleSize" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:evaluationSampleSize ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:satisfactionRecordCount ?satisfaction_record_count . }
                BIND(?satisfaction_record_count AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_HasMeaningfulSample" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasMeaningfulSample ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:evaluationSampleSize ?evaluation_sample_size . }
    OPTIONAL { $this effortless-ntwf:minimumSampleForAssurance ?minimum_sample_for_assurance . }
                BIND((COALESCE(?evaluation_sample_size, 0) >= COALESCE(?minimum_sample_for_assurance, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsUntestedWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUntestedWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasMeaningfulSample ?has_meaningful_sample . }
    OPTIONAL { $this effortless-ntwf:witnessHasNeverFired ?witness_has_never_fired . }
                BIND((COALESCE(?witness_has_never_fired, false) && COALESCE((!(COALESCE(?has_meaningful_sample, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsEvidencedHoldingControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isEvidencedHoldingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasMeaningfulSample ?has_meaningful_sample . }
    OPTIONAL { $this effortless-ntwf:witnessHasNeverFired ?witness_has_never_fired . }
                BIND((COALESCE(?witness_has_never_fired, false) && COALESCE(?has_meaningful_sample, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_ControlAssuranceState" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:controlAssuranceState ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:hasEverBeenEvaluated ?has_ever_been_evaluated . }
    OPTIONAL { $this effortless-ntwf:hasMeaningfulSample ?has_meaningful_sample . }
    OPTIONAL { $this effortless-ntwf:isBoundToAnyStep ?is_bound_to_any_step . }
    OPTIONAL { $this effortless-ntwf:witnessFireCount ?witness_fire_count . }
                BIND(IF(COALESCE((!(COALESCE(?is_bound_to_any_step, false))), false), "Decorative", IF(COALESCE((!(COALESCE(?has_ever_been_evaluated, false))), false), "Inoperative", IF(COALESCE((!(COALESCE(?has_computed_witness, false))), false), "Asserted", IF(COALESCE((COALESCE(?witness_fire_count, 0) > 0), false), "Demonstrated", IF(COALESCE(?has_meaningful_sample, false), "Holding", "Untested"))))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_UnexercisedBindingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unexercisedBindingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepRequirements .
                    ?child effortless-ntwf:unexercisedBindingRequirementKey ?backfk .
                    $this effortless-ntwf:requirementId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_WitnessIsPartiallyScoped" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:witnessIsPartiallyScoped ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:unexercisedBindingCount ?unexercised_binding_count . }
                BIND((COALESCE(?has_computed_witness, false) && COALESCE((COALESCE(?unexercised_binding_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_AccountableAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:accountableAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
                OPTIONAL { $this effortless-ntwf:accountableRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:currentAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_HasNamedOwner" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNamedOwner ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:accountableRole ?accountable_role . }
                BIND((REPLACE(COALESCE(STR(?accountable_role), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsOrphanedBlockingControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOrphanedBlockingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasNamedOwner ?has_named_owner . }
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
                BIND((COALESCE(?is_blocking, false) && COALESCE((!(COALESCE(?has_named_owner, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsUnwatchedAndUnowned" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwatchedAndUnowned ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:hasNamedOwner ?has_named_owner . }
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
                BIND((COALESCE(?is_blocking, false) && COALESCE((!(COALESCE(?has_computed_witness, false))), false) && COALESCE((!(COALESCE(?has_named_owner, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_AttestationExposureNote" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:attestationExposureNote ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
    OPTIONAL { $this effortless-ntwf:isOrphanedBlockingControl ?is_orphaned_blocking_control . }
    OPTIONAL { $this effortless-ntwf:isUnwatchedAndUnowned ?is_unwatched_and_unowned . }
                BIND(IF(COALESCE((!(COALESCE(?is_blocking, false))), false), "", IF(COALESCE(?is_unwatched_and_unowned, false), "Unwatched and unowned: exposure defaults to the signatory.", IF(COALESCE(?is_orphaned_blocking_control, false), "Witnessed but unowned: no named accountability.", IF(COALESCE((!(COALESCE(?has_computed_witness, false))), false), "Owned but unwitnessed: rests on human judgement.", "")))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_UnwatchedUnownedFlag" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unwatchedUnownedFlag ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:isUnwatchedAndUnowned ?is_unwatched_and_unowned . }
                BIND(IF(COALESCE(?is_unwatched_and_unowned, false), "unwatched-unowned", "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_UsesControlledVocabulary" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:usesControlledVocabulary ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:controlledTerm ?controlled_term . }
                BIND((REPLACE(COALESCE(STR(?controlled_term), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Resources ===
effortless-ntwf:ResourcesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Resources ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Resources .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_IsApprovedSource" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isApprovedSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Resources .
    OPTIONAL { $this effortless-ntwf:approvalStatus ?approval_status . }
                BIND((REPLACE(COALESCE(STR(?approval_status), ""), "^.*#", "") = "Approved") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ReviewEvents ===
effortless-ntwf:ReviewEventsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ReviewEvents ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
    OPTIONAL { $this effortless-ntwf:reviewKind ?review_kind . }
                BIND(CONCAT(IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version)), " / ", IF(isIRI(?review_kind), REPLACE(STR(?review_kind), "^.*[#/]", ""), STR(?review_kind))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_IsOverdue" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOverdue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:nextReviewDue ?next_review_due . }
                BIND(COALESCE((?next_review_due < ?as_of_instant), false) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_OverdueVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overdueVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:isOverdue ?is_overdue . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_overdue, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_PromisedCadenceDays" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:promisedCadenceDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:stewardReviewCadenceDays ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_DaysSinceReviewed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceReviewed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:reviewedAt ?reviewed_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?reviewed_at) + FLOOR((153 * (MONTH(?reviewed_at) + 12 * FLOOR((14 - MONTH(?reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_ExceedsPromisedCadence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:exceedsPromisedCadence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:daysSinceReviewed ?days_since_reviewed . }
    OPTIONAL { $this effortless-ntwf:promisedCadenceDays ?promised_cadence_days . }
                BIND((COALESCE(?days_since_reviewed, 0) > COALESCE(?promised_cadence_days, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_CadenceDriftDays" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cadenceDriftDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:daysSinceReviewed ?days_since_reviewed . }
    OPTIONAL { $this effortless-ntwf:promisedCadenceDays ?promised_cadence_days . }
                BIND(ROUND((?days_since_reviewed - ?promised_cadence_days)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_PromiseAndBehaviorDisagree" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:promiseAndBehaviorDisagree ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:exceedsPromisedCadence ?exceeds_promised_cadence . }
    OPTIONAL { $this effortless-ntwf:isOverdue ?is_overdue . }
                BIND((COALESCE(?exceeds_promised_cadence, false) && COALESCE((!(COALESCE(?is_overdue, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_CadenceBreachVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cadenceBreachVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:exceedsPromisedCadence ?exceeds_promised_cadence . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?exceeds_promised_cadence, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleAssignments ===
effortless-ntwf:RoleAssignmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleAssignments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:role ?role . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
                BIND(CONCAT(IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role)), " @ ", REPLACE(IF(isIRI(?valid_from), REPLACE(STR(?valid_from), "^.*[#/]", ""), STR(?valid_from)), "Z$", "+00:00")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsCurrent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND((COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_CurrentAgentKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentAgentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:agent ?agent . }
    OPTIONAL { $this effortless-ntwf:isCurrent ?is_current . }
                BIND(IF(COALESCE(?is_current, false), ?agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsCurrentlyValid" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrentlyValid ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Active"), false) && COALESCE((COALESCE((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AgentRoleKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentRoleKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:agent ?agent . }
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this effortless-ntwf:role ?role . }
                BIND(IF(COALESCE(?is_currently_valid, false), CONCAT(IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent)), "|", IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role))), "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasDeparted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasDeparted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") != ""), false) && COALESCE(COALESCE((?valid_to <= ?as_of_instant), ((!BOUND(?valid_to) || STR(?valid_to) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_CoversNow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:coversNow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Active"), false) && COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_RoleWhenCovering" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:roleWhenCovering ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:coversNow ?covers_now . }
    OPTIONAL { $this effortless-ntwf:role ?role . }
                BIND(IF(COALESCE(?covers_now, false), ?role, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:agent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsNonHumanAssignment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNonHumanAssignment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:agentKind ?agent_kind . }
                BIND((!(COALESCE((REPLACE(COALESCE(STR(?agent_kind), ""), "^.*#", "") = "Human"), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:supersedesAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsHumanToNonHumanHandover" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isHumanToNonHumanHandover ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:isNonHumanAssignment ?is_non_human_assignment . }
    OPTIONAL { $this effortless-ntwf:predecessorAgentKind ?predecessor_agent_kind . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?predecessor_agent_kind), ""), "^.*#", "") = "Human"), false) && COALESCE(?is_non_human_assignment, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsUnauthorizedNonHumanAssignment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnauthorizedNonHumanAssignment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:hasApprovingAuthority ?has_approving_authority . }
    OPTIONAL { $this effortless-ntwf:isNonHumanAssignment ?is_non_human_assignment . }
                BIND((COALESCE(?is_non_human_assignment, false) && COALESCE((!(COALESCE(?has_approving_authority, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_WasAuthorizedByChangeRequest" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasAuthorizedByChangeRequest ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizingChangeRequest ?authorizing_change_request . }
    OPTIONAL { $this effortless-ntwf:hasApprovingAuthority ?has_approving_authority . }
                BIND((COALESCE(?has_approving_authority, false) && COALESCE((REPLACE(COALESCE(STR(?authorizing_change_request), ""), "^.*#", "") != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_DecisionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:decisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:roleAssignmentWhenScored ?backfk .
                    $this effortless-ntwf:roleAssignmentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_OverriddenDecisionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overriddenDecisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:roleAssignmentWhenOverridden ?backfk .
                    $this effortless-ntwf:roleAssignmentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_OverrideRatePercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overrideRatePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:decisionCount ?decision_count . }
    OPTIONAL { $this effortless-ntwf:overriddenDecisionCount ?overridden_decision_count . }
                BIND(IF(COALESCE((COALESCE(?decision_count, 0) = 0), false), 0, ((?overridden_decision_count * 100) / ?decision_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorOverrideRatePercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorOverrideRatePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:supersedesAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:overrideRatePercent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_QualityRegressedVsPredecessor" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:qualityRegressedVsPredecessor ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:overrideRatePercent ?override_rate_percent . }
    OPTIONAL { $this effortless-ntwf:predecessorOverrideRatePercent ?predecessor_override_rate_percent . }
    OPTIONAL { $this effortless-ntwf:supersedesAssignment ?supersedes_assignment . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?supersedes_assignment), ""), "^.*#", "") != ""), false) && COALESCE((COALESCE(?override_rate_percent, 0) > COALESCE(?predecessor_override_rate_percent, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_DepartedRoleKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:departedRoleKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:hasDeparted ?has_departed . }
    OPTIONAL { $this effortless-ntwf:role ?role . }
                BIND(IF(COALESCE(?has_departed, false), ?role, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorDecisionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorDecisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:supersedesAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:decisionCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasSufficientSample" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasSufficientSample ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:decisionCount ?decision_count . }
    OPTIONAL { $this effortless-ntwf:minimumDecisionsForComparison ?minimum_decisions_for_comparison . }
                BIND((COALESCE(?decision_count, 0) >= COALESCE(?minimum_decisions_for_comparison, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorHasSufficientSample" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorHasSufficientSample ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:minimumDecisionsForComparison ?minimum_decisions_for_comparison . }
    OPTIONAL { $this effortless-ntwf:predecessorDecisionCount ?predecessor_decision_count . }
                BIND((COALESCE(?predecessor_decision_count, 0) >= COALESCE(?minimum_decisions_for_comparison, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ComparisonIsEvidentiallySound" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:comparisonIsEvidentiallySound ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:hasSufficientSample ?has_sufficient_sample . }
    OPTIONAL { $this effortless-ntwf:predecessorHasSufficientSample ?predecessor_has_sufficient_sample . }
                BIND((COALESCE(?has_sufficient_sample, false) && COALESCE(?predecessor_has_sufficient_sample, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_SingleOverrideSwingPercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:singleOverrideSwingPercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:decisionCount ?decision_count . }
                BIND(IF(COALESCE((COALESCE(?decision_count, 0) > 0), false), (100 / ?decision_count), 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_QualityVerdictIsUnsupported" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:qualityVerdictIsUnsupported ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:comparisonIsEvidentiallySound ?comparison_is_evidentially_sound . }
    OPTIONAL { $this effortless-ntwf:qualityRegressedVsPredecessor ?quality_regressed_vs_predecessor . }
                BIND((COALESCE((!(COALESCE(?comparison_is_evidentially_sound, false))), false) && COALESCE((!(COALESCE(?quality_regressed_vs_predecessor, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsUnmeasuredAutomationHandover" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnmeasuredAutomationHandover ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:comparisonIsEvidentiallySound ?comparison_is_evidentially_sound . }
    OPTIONAL { $this effortless-ntwf:isHumanToNonHumanHandover ?is_human_to_non_human_handover . }
                BIND((COALESCE(?is_human_to_non_human_handover, false) && COALESCE((!(COALESCE(?comparison_is_evidentially_sound, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ErrorCorrectionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:errorCorrectionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:errorCorrectionRoleAssignmentKey ?backfk .
                    $this effortless-ntwf:roleAssignmentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ErrorRatePercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:errorRatePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:decisionCount ?decision_count . }
    OPTIONAL { $this effortless-ntwf:errorCorrectionCount ?error_correction_count . }
                BIND(IF(COALESCE((COALESCE(?decision_count, 0) > 0), false), ((?error_correction_count * 100) / ?decision_count), 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasDatedAuthorization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasDatedAuthorization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:approvingAuthorityRole ?approving_authority_role . }
    OPTIONAL { $this effortless-ntwf:authorizationDecidedAt ?authorization_decided_at . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?approving_authority_role), ""), "^.*#", "") != ""), false) && COALESCE((REPLACE(COALESCE(STR(?authorization_decided_at), ""), "^.*#", "") != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_DaysSinceAuthorizationReview" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceAuthorizationReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:authorizationReviewedAt ?authorization_reviewed_at . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
                BIND(ROUND(IF(COALESCE((REPLACE(COALESCE(STR(?authorization_reviewed_at), ""), "^.*#", "") != ""), false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?authorization_reviewed_at) + FLOOR((153 * (MONTH(?authorization_reviewed_at) + 12 * FLOOR((14 - MONTH(?authorization_reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?authorization_reviewed_at) + 4800 - FLOOR((14 - MONTH(?authorization_reviewed_at)) / 12)) + FLOOR((YEAR(?authorization_reviewed_at) + 4800 - FLOOR((14 - MONTH(?authorization_reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?authorization_reviewed_at) + 4800 - FLOOR((14 - MONTH(?authorization_reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?authorization_reviewed_at) + 4800 - FLOOR((14 - MONTH(?authorization_reviewed_at)) / 12)) / 400) - 32045)), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?valid_from) + FLOOR((153 * (MONTH(?valid_from) + 12 * FLOOR((14 - MONTH(?valid_from)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 4) - FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 100) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AuthorizationIsOverdueForReview" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:authorizationIsOverdueForReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizationReviewCadenceDays ?authorization_review_cadence_days . }
    OPTIONAL { $this effortless-ntwf:daysSinceAuthorizationReview ?days_since_authorization_review . }
                BIND((COALESCE((COALESCE(?authorization_review_cadence_days, 0) > 0), false) && COALESCE((COALESCE(?days_since_authorization_review, 0) > COALESCE(?authorization_review_cadence_days, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsStandingUnreviewedAutomation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStandingUnreviewedAutomation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizationIsOverdueForReview ?authorization_is_overdue_for_review . }
    OPTIONAL { $this effortless-ntwf:coversNow ?covers_now . }
    OPTIONAL { $this effortless-ntwf:isNonHumanAssignment ?is_non_human_assignment . }
                BIND((COALESCE(?covers_now, false) && COALESCE((COALESCE(?is_non_human_assignment, false) && COALESCE(?authorization_is_overdue_for_review, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsUnconditionedAutomationHandover" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnconditionedAutomationHandover ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizationReviewCadenceDays ?authorization_review_cadence_days . }
    OPTIONAL { $this effortless-ntwf:isHumanToNonHumanHandover ?is_human_to_non_human_handover . }
                BIND((COALESCE(?is_human_to_non_human_handover, false) && COALESCE((COALESCE(?authorization_review_cadence_days, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ExceedsTolerableErrorRate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:exceedsTolerableErrorRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:errorRatePercent ?error_rate_percent . }
    OPTIONAL { $this effortless-ntwf:maxTolerableErrorRatePercent ?max_tolerable_error_rate_percent . }
                BIND((COALESCE((COALESCE(?max_tolerable_error_rate_percent, 0) > 0), false) && COALESCE((COALESCE(?error_rate_percent, 0) >= COALESCE(?max_tolerable_error_rate_percent, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_BoundaryViolationCountForAssignment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryViolationCountForAssignment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:boundaryViolationRoleAssignmentKey ?backfk .
                    $this effortless-ntwf:roleAssignmentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasAnyBoundaryViolation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasAnyBoundaryViolation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:boundaryViolationCountForAssignment ?boundary_violation_count_for_assignment . }
                BIND((COALESCE(?boundary_violation_count_for_assignment, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasUngroundedGoverningBoundary" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasUngroundedGoverningBoundary ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:role ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isGovernedByLapsedAuthority ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_SuspensionConditionMet" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:suspensionConditionMet ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:exceedsTolerableErrorRate ?exceeds_tolerable_error_rate . }
    OPTIONAL { $this effortless-ntwf:hasAnyBoundaryViolation ?has_any_boundary_violation . }
    OPTIONAL { $this effortless-ntwf:hasUngroundedGoverningBoundary ?has_ungrounded_governing_boundary . }
                BIND((COALESCE(?exceeds_tolerable_error_rate, false) || COALESCE((COALESCE(?has_any_boundary_violation, false) || COALESCE(?has_ungrounded_governing_boundary, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsOperatingUnderMetSuspensionCondition" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOperatingUnderMetSuspensionCondition ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:coversNow ?covers_now . }
    OPTIONAL { $this effortless-ntwf:isNonHumanAssignment ?is_non_human_assignment . }
    OPTIONAL { $this effortless-ntwf:suspensionConditionMet ?suspension_condition_met . }
                BIND((COALESCE(?suspension_condition_met, false) && COALESCE((COALESCE(?covers_now, false) && COALESCE(?is_non_human_assignment, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasDeclaredSuspensionCondition" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasDeclaredSuspensionCondition ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:maxTolerableErrorRatePercent ?max_tolerable_error_rate_percent . }
                BIND((COALESCE(?max_tolerable_error_rate_percent, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasApprovingAuthority" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasApprovingAuthority ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:approvingAuthorityRole ?approving_authority_role . }
                BIND((REPLACE(COALESCE(STR(?approving_authority_role), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasAuthorizingChangeRequest" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasAuthorizingChangeRequest ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizingChangeRequest ?authorizing_change_request . }
                BIND((REPLACE(COALESCE(STR(?authorizing_change_request), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsUnauthorizedEnforcementAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnauthorizedEnforcementAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:isEnforcementRole ?is_enforcement_role . }
    OPTIONAL { $this effortless-ntwf:isUnauthorizedNonHumanAssignment ?is_unauthorized_non_human_assignment . }
                BIND((COALESCE(?is_enforcement_role, false) && COALESCE(?is_unauthorized_non_human_assignment, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_GovernanceEvidenceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:governanceEvidenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:hasApprovingAuthority ?has_approving_authority . }
    OPTIONAL { $this effortless-ntwf:hasAuthorizingChangeRequest ?has_authorizing_change_request . }
                BIND(ROUND((IF(COALESCE(?has_approving_authority, false), 1, 0) + IF(COALESCE(?has_authorizing_change_request, false), 1, 0))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_UnauthorizedEnforcementRoleKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unauthorizedEnforcementRoleKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:isUnauthorizedNonHumanAssignment ?is_unauthorized_non_human_assignment . }
    OPTIONAL { $this effortless-ntwf:role ?role . }
                BIND(IF(COALESCE(?is_unauthorized_non_human_assignment, false), ?role, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleQuestions ===
effortless-ntwf:RoleQuestionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleQuestions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleQuestions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleQuestions .
    OPTIONAL { $this effortless-ntwf:askingRole ?asking_role . }
    OPTIONAL { $this effortless-ntwf:questionText ?question_text . }
                BIND(CONCAT(IF(isIRI(?asking_role), REPLACE(STR(?asking_role), "^.*[#/]", ""), STR(?asking_role)), ": ", IF(isIRI(SUBSTR(STR(?question_text), 1, 60)), REPLACE(STR(SUBSTR(STR(?question_text), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?question_text), 1, 60)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleQuestions_PredicateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predicateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleQuestions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RulebookFields .
                    ?child effortless-ntwf:inventedForQuestion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleQuestions_IsAnswered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAnswered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleQuestions .
    OPTIONAL { $this effortless-ntwf:predicateCount ?predicate_count . }
                BIND((COALESCE(?predicate_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleSchemaViews ===
effortless-ntwf:RoleSchemaViewsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleSchemaViews ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
    OPTIONAL { $this effortless-ntwf:schemaName ?schema_name . }
    OPTIONAL { $this effortless-ntwf:viewName ?view_name . }
                BIND(CONCAT(IF(isIRI(?schema_name), REPLACE(STR(?schema_name), "^.*[#/]", ""), STR(?schema_name)), ".", IF(isIRI(?view_name), REPLACE(STR(?view_name), "^.*[#/]", ""), STR(?view_name))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_SchemaName" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:schemaName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
                OPTIONAL { $this effortless-ntwf:roleSchema ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleSchemas ; effortless-ntwf:roleSchemaId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:schemaName ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_SourceView" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceView ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
                OPTIONAL { $this effortless-ntwf:targetTable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookTables ; effortless-ntwf:rulebookTableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:physicalView ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_GrantKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:grantKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
    OPTIONAL { $this effortless-ntwf:targetTable ?target_table . }
                BIND(CONCAT(IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal)), "|", IF(isIRI(?target_table), REPLACE(STR(?target_table), "^.*[#/]", ""), STR(?target_table))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_ColumnCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:columnCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FieldGrants .
                    ?child effortless-ntwf:grantKeyWhenReadable ?backfk .
                    $this effortless-ntwf:grantKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_TableFieldCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:tableFieldCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
                OPTIONAL { $this effortless-ntwf:targetTable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookTables ; effortless-ntwf:rulebookTableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:fieldCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_IsFullWidth" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFullWidth ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
    OPTIONAL { $this effortless-ntwf:columnCount ?column_count . }
    OPTIONAL { $this effortless-ntwf:tableFieldCount ?table_field_count . }
                BIND((COALESCE((COALESCE(?column_count, 0) > 0), false) && COALESCE((COALESCE(?column_count, 0) >= COALESCE(?table_field_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_IsDegenerateView" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDegenerateView ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
    OPTIONAL { $this effortless-ntwf:columnCount ?column_count . }
                BIND((COALESCE(?column_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleSchemas ===
effortless-ntwf:RoleSchemasShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleSchemas ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemas_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemas .
    OPTIONAL { $this effortless-ntwf:schemaName ?schema_name . }
                BIND(?schema_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemas_SearchPath" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:searchPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemas .
    OPTIONAL { $this effortless-ntwf:schemaName ?schema_name . }
                BIND(?schema_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemas_ViewCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:viewCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemas .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleSchemaViews .
                    ?child effortless-ntwf:roleSchema $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemas_IsEmptySchema" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isEmptySchema ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemas .
    OPTIONAL { $this effortless-ntwf:viewCount ?view_count . }
                BIND((COALESCE(?view_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Roles ===
effortless-ntwf:RolesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Roles ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_CurrentAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                OPTIONAL { $this effortless-ntwf:currentAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_ActiveAssignmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:activeAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:role $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_CurrentlyCoveredAssignmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentlyCoveredAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:roleWhenCovering ?backfk .
                    $this effortless-ntwf:roleId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_HasNoCurrentHolder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoCurrentHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:currentlyCoveredAssignmentCount ?currently_covered_assignment_count . }
                BIND((COALESCE(?currently_covered_assignment_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_CountOfAwaitedDecisions" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfAwaitedDecisions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeRequests .
                    ?child effortless-ntwf:authorityRole $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_CurrentAssignmentValidFrom" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentAssignmentValidFrom ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                OPTIONAL { $this effortless-ntwf:currentAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:validFrom ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsNonHumanHeld" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNonHumanHeld ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:currentAgentKind ?current_agent_kind . }
                BIND((!(COALESCE((REPLACE(COALESCE(STR(?current_agent_kind), ""), "^.*#", "") = "Human"), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsUngovernedNonHumanRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUngovernedNonHumanRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:hasNoCurrentHolder ?has_no_current_holder . }
    OPTIONAL { $this effortless-ntwf:isNonHumanHeld ?is_non_human_held . }
                BIND((COALESCE(?is_non_human_held, false) && COALESCE(?has_no_current_holder, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_DepartedAssignmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:departedAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:departedRoleKey ?backfk .
                    $this effortless-ntwf:roleId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_HasLostAHolder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasLostAHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:departedAssignmentCount ?departed_assignment_count . }
                BIND((COALESCE(?departed_assignment_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsVacatedRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isVacatedRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:hasLostAHolder ?has_lost_a_holder . }
    OPTIONAL { $this effortless-ntwf:hasNoCurrentHolder ?has_no_current_holder . }
                BIND((COALESCE(?has_lost_a_holder, false) && COALESCE(?has_no_current_holder, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_UngroundedBoundaryCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ungroundedBoundaryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AuthorityBoundaries .
                    ?child effortless-ntwf:constrainedRoleAssignmentKey ?backfk .
                    $this effortless-ntwf:roleId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsGovernedByLapsedAuthority" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isGovernedByLapsedAuthority ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:ungroundedBoundaryCount ?ungrounded_boundary_count . }
                BIND((COALESCE(?ungrounded_boundary_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_UnescalatedRefusalCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unescalatedRefusalCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SendIntents .
                    ?child effortless-ntwf:unescalatedRefusalRoleKey ?backfk .
                    $this effortless-ntwf:roleId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_UnauthorizedEnforcementAssignmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unauthorizedEnforcementAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:unauthorizedEnforcementRoleKey ?backfk .
                    $this effortless-ntwf:roleId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsUngovernedEnforcementRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUngovernedEnforcementRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:unauthorizedEnforcementAssignmentCount ?unauthorized_enforcement_assignment_count . }
                BIND((COALESCE(?unauthorized_enforcement_assignment_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RulebookFields ===
effortless-ntwf:RulebookFieldsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RulebookFields ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:fieldName ?field_name . }
    OPTIONAL { $this effortless-ntwf:targetTable ?target_table . }
                BIND(CONCAT(IF(isIRI(?target_table), REPLACE(STR(?target_table), "^.*[#/]", ""), STR(?target_table)), ".", IF(isIRI(?field_name), REPLACE(STR(?field_name), "^.*[#/]", ""), STR(?field_name))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_IsDerived" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDerived ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:fieldType ?field_type . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?field_type), ""), "^.*#", "") = "calculated"), false) || COALESCE((REPLACE(COALESCE(STR(?field_type), ""), "^.*#", "") = "lookup"), false) || COALESCE((REPLACE(COALESCE(STR(?field_type), ""), "^.*#", "") = "aggregation"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_IsWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:inventedForQuestion ?invented_for_question . }
                BIND((REPLACE(COALESCE(STR(?invented_for_question), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_DisagreeingSubstrateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:disagreeingSubstrateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FieldDisagreements .
                    ?child effortless-ntwf:rulebookField $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_IsSubstrateContested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSubstrateContested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:disagreeingSubstrateCount ?disagreeing_substrate_count . }
                BIND((COALESCE(?disagreeing_substrate_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RulebookReleases ===
effortless-ntwf:RulebookReleasesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RulebookReleases ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:pkoCoreVersionIri ?pko_core_version_iri . }
    OPTIONAL { $this effortless-ntwf:rulebookVersion ?rulebook_version . }
                BIND(CONCAT(IF(isIRI(?rulebook_version), REPLACE(STR(?rulebook_version), "^.*[#/]", ""), STR(?rulebook_version)), " / PKO ", IF(isIRI(?pko_core_version_iri), REPLACE(STR(?pko_core_version_iri), "^.*[#/]", ""), STR(?pko_core_version_iri))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RulebookTables ===
effortless-ntwf:RulebookTablesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RulebookTables ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
    OPTIONAL { $this effortless-ntwf:tableName ?table_name . }
                BIND(?table_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_FieldCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RulebookFields .
                    ?child effortless-ntwf:targetTable ?backfk .
                    $this effortless-ntwf:rulebookTableId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_PolicyCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AccessPolicies .
                    ?child effortless-ntwf:targetTable $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_IsUnsecured" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnsecured ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
    OPTIONAL { $this effortless-ntwf:policyCount ?policy_count . }
                BIND((COALESCE(?policy_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_DisagreeingSubstrateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:disagreeingSubstrateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TableConformance .
                    ?child effortless-ntwf:imperfectTableKey ?backfk .
                    $this effortless-ntwf:rulebookTableId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for SemanticMappings ===
effortless-ntwf:SemanticMappingsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SemanticMappings ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SemanticMappings_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SemanticMappings .
    OPTIONAL { $this effortless-ntwf:sourcePath ?source_path . }
    OPTIONAL { $this effortless-ntwf:targetIri ?target_iri . }
                BIND(CONCAT(IF(isIRI(?source_path), REPLACE(STR(?source_path), "^.*[#/]", ""), STR(?source_path)), " -> ", IF(isIRI(?target_iri), REPLACE(STR(?target_iri), "^.*[#/]", ""), STR(?target_iri))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SendIntents ===
effortless-ntwf:SendIntentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SendIntents ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . }
    OPTIONAL { $this effortless-ntwf:recipient ?recipient . }
                BIND(CONCAT(IF(isIRI(?recipient), REPLACE(STR(?recipient), "^.*[#/]", ""), STR(?recipient)), " / ", IF(isIRI(?message_template), REPLACE(STR(?message_template), "^.*[#/]", ""), STR(?message_template)), " / intent") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentPolicy" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentPolicy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:communicationPolicy ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentChannel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentChannel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:channel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_PolicyIsActive" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyIsActive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isActivePolicy ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentRequiresConsent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentRequiresConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:consentRequired ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RecipientHasChannelConsent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientHasChannelConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:hasSmsConsent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ConsentGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:consentGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentRequiresConsent ?intent_requires_consent . }
    OPTIONAL { $this effortless-ntwf:recipientHasChannelConsent ?recipient_has_channel_consent . }
                BIND((COALESCE((!(COALESCE(?intent_requires_consent, false))), false) || COALESCE(?recipient_has_channel_consent, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RecipientIsSmsReachable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientIsSmsReachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isSmsReachable ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RecipientIsEmailReachable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientIsEmailReachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isEmailReachable ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ReachabilityGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reachabilityGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentChannel ?intent_channel . }
    OPTIONAL { $this effortless-ntwf:recipientIsEmailReachable ?recipient_is_email_reachable . }
    OPTIONAL { $this effortless-ntwf:recipientIsSmsReachable ?recipient_is_sms_reachable . }
                BIND(IF(COALESCE((REPLACE(COALESCE(STR(?intent_channel), ""), "^.*#", "") = "SMS"), false), ?recipient_is_sms_reachable, ?recipient_is_email_reachable) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_PermissionGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:permissionGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:consentGatePassed ?consent_gate_passed . }
    OPTIONAL { $this effortless-ntwf:policyIsActive ?policy_is_active . }
    OPTIONAL { $this effortless-ntwf:reachabilityGatePassed ?reachability_gate_passed . }
                BIND((COALESCE(?policy_is_active, false) && COALESCE((COALESCE(?consent_gate_passed, false) && COALESCE(?reachability_gate_passed, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentQuietStartHour" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentQuietStartHour ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:quietHoursStartHour ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentQuietEndHour" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentQuietEndHour ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:quietHoursEndHour ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentPolicyHasQuietHours" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentPolicyHasQuietHours ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentQuietEndHour ?intent_quiet_end_hour . }
    OPTIONAL { $this effortless-ntwf:intentQuietStartHour ?intent_quiet_start_hour . }
                BIND((COALESCE(?intent_quiet_start_hour, 0) != COALESCE(?intent_quiet_end_hour, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentQuietWindowWraps" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentQuietWindowWraps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentQuietEndHour ?intent_quiet_end_hour . }
    OPTIONAL { $this effortless-ntwf:intentQuietStartHour ?intent_quiet_start_hour . }
                BIND((COALESCE(?intent_quiet_start_hour, 0) > COALESCE(?intent_quiet_end_hour, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentIsInsideQuietWindow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentIsInsideQuietWindow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentQuietEndHour ?intent_quiet_end_hour . }
    OPTIONAL { $this effortless-ntwf:intentQuietStartHour ?intent_quiet_start_hour . }
    OPTIONAL { $this effortless-ntwf:intentQuietWindowWraps ?intent_quiet_window_wraps . }
    OPTIONAL { $this effortless-ntwf:proposedSendAtLocalHour ?proposed_send_at_local_hour . }
                BIND(IF(COALESCE(?intent_quiet_window_wraps, false), (COALESCE((COALESCE(?proposed_send_at_local_hour, 0) >= COALESCE(?intent_quiet_start_hour, 0)), false) || COALESCE((COALESCE(?proposed_send_at_local_hour, 0) < COALESCE(?intent_quiet_end_hour, 0)), false)), (COALESCE((COALESCE(?proposed_send_at_local_hour, 0) >= COALESCE(?intent_quiet_start_hour, 0)), false) && COALESCE((COALESCE(?proposed_send_at_local_hour, 0) < COALESCE(?intent_quiet_end_hour, 0)), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_TimingGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:timingGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentIsInsideQuietWindow ?intent_is_inside_quiet_window . }
    OPTIONAL { $this effortless-ntwf:intentPolicyHasQuietHours ?intent_policy_has_quiet_hours . }
                BIND((COALESCE((!(COALESCE(?intent_policy_has_quiet_hours, false))), false) || COALESCE((!(COALESCE(?intent_is_inside_quiet_window, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_HoursUntilWindowOpens" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hoursUntilWindowOpens ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentQuietEndHour ?intent_quiet_end_hour . }
    OPTIONAL { $this effortless-ntwf:proposedSendAtLocalHour ?proposed_send_at_local_hour . }
    OPTIONAL { $this effortless-ntwf:timingGatePassed ?timing_gate_passed . }
                BIND(ROUND(IF(COALESCE(?timing_gate_passed, false), 0, IF(COALESCE((COALESCE(?proposed_send_at_local_hour, 0) < COALESCE(?intent_quiet_end_hour, 0)), false), (?intent_quiet_end_hour - ?proposed_send_at_local_hour), ((24 - ?proposed_send_at_local_hour) + ?intent_quiet_end_hour)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentMaxMessageLength" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentMaxMessageLength ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:maxMessageLength ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentMaxSegments" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentMaxSegments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:maxSegments ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_LengthGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lengthGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentMaxSegments ?intent_max_segments . }
    OPTIONAL { $this effortless-ntwf:proposedBodyLength ?proposed_body_length . }
    OPTIONAL { $this effortless-ntwf:proposedSegmentCount ?proposed_segment_count . }
                BIND((COALESCE((COALESCE(?proposed_body_length, 0) > 0), false) && COALESCE((COALESCE(?proposed_segment_count, 0) <= COALESCE(?intent_max_segments, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentRequiredOptOutPhrase" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentRequiredOptOutPhrase ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:requiredOptOutPhrase ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_OptOutGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:optOutGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentMaxMessageLength ?intent_max_message_length . }
    OPTIONAL { $this effortless-ntwf:intentRequiredOptOutPhrase ?intent_required_opt_out_phrase . }
    OPTIONAL { $this effortless-ntwf:proposedOptOutPosition ?proposed_opt_out_position . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?intent_required_opt_out_phrase), ""), "^.*#", "") = ""), false) || COALESCE((COALESCE((COALESCE(?proposed_opt_out_position, 0) > 0), false) && COALESCE((COALESCE(?proposed_opt_out_position, 0) <= COALESCE(?intent_max_message_length, 0)), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ContentGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:contentGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:lengthGatePassed ?length_gate_passed . }
    OPTIONAL { $this effortless-ntwf:optOutGatePassed ?opt_out_gate_passed . }
                BIND((COALESCE(?length_gate_passed, false) && COALESCE(?opt_out_gate_passed, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_TemplateIsSendable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:templateIsSendable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isSendableUnderApproval ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ExecutionHasLegalClearance" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
