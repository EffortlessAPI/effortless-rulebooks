            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:failureModeCount ?_result .
            }
            WHERE {
    $this a p-plan:Step .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a p-plan:Step .
                    ?child a pko-extension:FailureMode .
                    ?child pko-native-procedural-knowledge-rulebook:step $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
