    OPTIONAL { $this effortless-ntwf:implementedAt ?implemented_at . }
    OPTIONAL { $this effortless-ntwf:isImplemented ?is_implemented . }
                BIND(ROUND(IF(COALESCE(?is_implemented, false), ((DAY(?implemented_at) + FLOOR((153 * (MONTH(?implemented_at) + 12 * FLOOR((14 - MONTH(?implemented_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) + FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 4) - FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 100) + FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_DelayIsDownstreamOfMe" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:delayIsDownstreamOfMe ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:decisionLatencyDays ?decision_latency_days . }
    OPTIONAL { $this effortless-ntwf:isMyDecidedButUnlanded ?is_my_decided_but_unlanded . }
                BIND((COALESCE(?is_my_decided_but_unlanded, false) && COALESCE((COALESCE(?decision_latency_days, 0) <= 14), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_UnlandedVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unlandedVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isMyDecidedButUnlanded ?is_my_decided_but_unlanded . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_my_decided_but_unlanded, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsApprovedNotImplemented" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isApprovedNotImplemented ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isImplemented ?is_implemented . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) && COALESCE((!(COALESCE(?is_implemented, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_DaysSinceApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . }
    OPTIONAL { $this effortless-ntwf:isDecided ?is_decided . }
                BIND(ROUND(IF(COALESCE(?is_decided, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsStalledImplementation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStalledImplementation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:daysSinceApproval ?days_since_approval . }
    OPTIONAL { $this effortless-ntwf:isApprovedNotImplemented ?is_approved_not_implemented . }
                BIND((COALESCE(?is_approved_not_implemented, false) && COALESCE((COALESCE(?days_since_approval, 0) > 14), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_StalledImplementationVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stalledImplementationVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isStalledImplementation ?is_stalled_implementation . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_stalled_implementation, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_ApprovedVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approvedVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isApprovedDecision ?is_approved_decision . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_approved_decision, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsApprovedDecision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isApprovedDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ChangeValidationRuns ===
effortless-ntwf:ChangeValidationRunsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ChangeValidationRuns ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeValidationRuns_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeValidationRuns .
    OPTIONAL { $this effortless-ntwf:modelChangeRequest ?model_change_request . OPTIONAL { ?model_change_request effortless-ntwf:__key ?model_change_request__key . } }
    OPTIONAL { $this effortless-ntwf:runPurpose ?run_purpose . OPTIONAL { ?run_purpose effortless-ntwf:__key ?run_purpose__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_change_request__key, IF(isIRI(?model_change_request), REPLACE(STR(?model_change_request), "^.*[#/]", ""), STR(?model_change_request))), ""), " ", COALESCE(COALESCE(?run_purpose__key, IF(isIRI(?run_purpose), REPLACE(STR(?run_purpose), "^.*[#/]", ""), STR(?run_purpose))), ""), " run") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeValidationRuns_Release" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:release ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeValidationRuns .
                OPTIONAL { $this effortless-ntwf:modelChangeRequest ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ModelChangeRequests ; effortless-ntwf:modelChangeRequestId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:targetRelease ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeValidationRuns_ExpectedChainCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expectedChainCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeValidationRuns .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ExpectedInferenceChecks .
                    ?child effortless-ntwf:changeValidationRun $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeValidationRuns_UnproducedChainCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unproducedChainCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeValidationRuns .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ExpectedInferenceChecks .
                    ?child effortless-ntwf:changeValidationRun $this .
                    OPTIONAL { ?child effortless-ntwf:isUnproduced ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeValidationRuns_HasUninspectedFailures" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasUninspectedFailures ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeValidationRuns .
    OPTIONAL { $this effortless-ntwf:failureCount ?failure_count . }
    OPTIONAL { $this effortless-ntwf:failuresInspectedAt ?failures_inspected_at . OPTIONAL { ?failures_inspected_at effortless-ntwf:__key ?failures_inspected_at__key . } }
                BIND((COALESCE((COALESCE(?failure_count, 0) > 0), false) && COALESCE((COALESCE(?failures_inspected_at__key, COALESCE(IF(isIRI(?failures_inspected_at), REPLACE(STR(?failures_inspected_at), "^.*[#/]", ""), STR(?failures_inspected_at)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeValidationRuns_IsUnconfirmedConsistency" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnconfirmedConsistency ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeValidationRuns .
    OPTIONAL { $this effortless-ntwf:consistencyCheckOutcome ?consistency_check_outcome . OPTIONAL { ?consistency_check_outcome effortless-ntwf:__key ?consistency_check_outcome__key . } }
                BIND((COALESCE(?consistency_check_outcome__key, COALESCE(IF(isIRI(?consistency_check_outcome), REPLACE(STR(?consistency_check_outcome), "^.*[#/]", ""), STR(?consistency_check_outcome)), "")) != "Consistent") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeValidationRuns_MissesExpectedInference" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:missesExpectedInference ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeValidationRuns .
    OPTIONAL { $this effortless-ntwf:unproducedChainCount ?unproduced_chain_count . }
                BIND((COALESCE(?unproduced_chain_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ClaimEvidence ===
effortless-ntwf:ClaimEvidenceShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ClaimEvidence ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
    OPTIONAL { $this effortless-ntwf:articleClaim ?article_claim . OPTIONAL { ?article_claim effortless-ntwf:__key ?article_claim__key . } }
    OPTIONAL { $this effortless-ntwf:evidenceKind ?evidence_kind . OPTIONAL { ?evidence_kind effortless-ntwf:__key ?evidence_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?article_claim__key, IF(isIRI(?article_claim), REPLACE(STR(?article_claim), "^.*[#/]", ""), STR(?article_claim))), ""), " <- ", COALESCE(COALESCE(?evidence_kind__key, IF(isIRI(?evidence_kind), REPLACE(STR(?evidence_kind), "^.*[#/]", ""), STR(?evidence_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_ClaimKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:claimKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
                OPTIONAL { $this effortless-ntwf:articleClaim ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ArticleClaims ; effortless-ntwf:articleClaimId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:claimKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_FieldCatalogName" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldCatalogName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
                OPTIONAL { $this effortless-ntwf:rulebookField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:fieldName ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_FieldIsWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldIsWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
                OPTIONAL { $this effortless-ntwf:rulebookField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isWitness ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_FieldHasData" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldHasData ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
                OPTIONAL { $this effortless-ntwf:rulebookField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:hasMeasuredData ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_FieldIsDiscriminating" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldIsDiscriminating ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
                OPTIONAL { $this effortless-ntwf:rulebookField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isDiscriminating ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_FieldIsContested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldIsContested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
                OPTIONAL { $this effortless-ntwf:rulebookField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isSubstrateContested ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_TableHasRows" ;
        sh:prefixes effortless-ntwf: ;
