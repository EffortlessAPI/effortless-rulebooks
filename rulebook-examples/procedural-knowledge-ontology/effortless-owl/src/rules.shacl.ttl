            }
            WHERE {
    $this a pko-extension:EncodingLifecycleStage .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:annotationCount ?annotation_count . }
                BIND((COALESCE(?annotation_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

