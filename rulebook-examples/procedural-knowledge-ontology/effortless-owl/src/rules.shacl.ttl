                    ?child a pko-extension:KnowledgeFragment .
                    ?child pko-native-procedural-knowledge-rulebook:procedureVersion $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:knowledgeForm ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "SituatedJudgment"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_TacitJudgmentFragmentCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_TacitJudgmentFragmentCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:tacitJudgmentFragmentCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:situatedJudgmentFragmentCount ?situated_judgment_fragment_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:tacitFormFragmentCount ?tacit_form_fragment_count . }
                BIND(ROUND((?tacit_form_fragment_count + ?situated_judgment_fragment_count)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_FirstStep a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_FirstStep" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko:hasFirstStep ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                    ?child a p-plan:Step .
                    ?child pko-native-procedural-knowledge-rulebook:procedureVersion $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:declaredFirstStepKey ?sumraw . }
                    BIND(STR(?sumraw) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_FallbackStep a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_FallbackStep" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko:hasFallbackStep ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                    ?child a p-plan:Step .
                    ?child pko-native-procedural-knowledge-rulebook:procedureVersion $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:declaredFallbackStepKey ?sumraw . }
                    BIND(STR(?sumraw) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_FirstStepDisagreesWithGraph a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_FirstStepDisagreesWithGraph" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:firstStepDisagreesWithGraph ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:declaredFirstStepCount ?declared_first_step_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:entryStepId ?entry_step_id . }
    OPTIONAL { $this pko:hasFirstStep ?first_step . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:graphEntryStepCount ?graph_entry_step_count . }
                BIND((COALESCE((COALESCE(?declared_first_step_count, 0) > 0), false) && COALESCE((COALESCE(?graph_entry_step_count, 0) > 0), false) && COALESCE(COALESCE((?first_step != ?entry_step_id), !((!BOUND(?first_step) || STR(?first_step) = "") && (!BOUND(?entry_step_id) || STR(?entry_step_id) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_DeclaredFirstStepCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_DeclaredFirstStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:declaredFirstStepCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                    ?child a p-plan:Step .
                    ?child pko-native-procedural-knowledge-rulebook:procedureVersion $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isDeclaredFirstStep ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_GraphEntryStepCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_GraphEntryStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:graphEntryStepCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                    ?child a p-plan:Step .
                    ?child pko-native-procedural-knowledge-rulebook:procedureVersion $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isEntryStep ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_OwnerOrganization a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_OwnerOrganization" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:ownerOrganization ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:Procedures . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:ownerOrganization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for Procedures ===
pko-native-procedural-knowledge-rulebook-shapes:Procedures_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Procedures .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Procedures_ExecutionCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_ExecutionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:executionCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Procedures .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:Procedures .
                    ?child a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                    ?child pko-native-procedural-knowledge-rulebook:procedure $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:executionCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Procedures_IsTemplateInstance a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_IsTemplateInstance" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isTemplateInstance ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Procedures .
    OPTIONAL { $this pko:hasTemplate ?template_procedure . OPTIONAL { ?template_procedure erb:key ?template_procedure__key . } }
                BIND((COALESCE(?template_procedure__key, COALESCE(IF(isIRI(?template_procedure), REPLACE(STR(?template_procedure), "^.*[#/]", ""), STR(?template_procedure)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Procedures_TargetCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
