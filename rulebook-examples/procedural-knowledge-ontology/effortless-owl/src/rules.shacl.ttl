            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:approvedOverUnresolvedObjection ?_result .
            }
            WHERE {
    $this a pko-extension:ModelChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAccepted ?is_accepted . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:unresolvedObjectionCount ?unresolved_objection_count . }
                BIND((COALESCE(?is_accepted, false) && COALESCE((COALESCE(?unresolved_objection_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ModelCharters ===
pko-native-procedural-knowledge-rulebook-shapes:ModelCharters_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ModelCharter ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelCharters_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ModelCharter .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authorityRole ?authority_role . OPTIONAL { ?authority_role erb:key ?authority_role__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:governedModel ?governed_model . OPTIONAL { ?governed_model erb:key ?governed_model__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stewardRole ?steward_role . OPTIONAL { ?steward_role erb:key ?steward_role__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " / ", COALESCE(COALESCE(?steward_role__key, IF(isIRI(?steward_role), REPLACE(STR(?steward_role), "^.*[#/]", ""), STR(?steward_role))), ""), " + ", COALESCE(COALESCE(?authority_role__key, IF(isIRI(?authority_role), REPLACE(STR(?authority_role), "^.*[#/]", ""), STR(?authority_role))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ModelCharters_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-extension:ModelCharter ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelCharters_AsOfInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-extension:ModelCharter .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ModelCharters_IsCurrent a sh:NodeShape ;
    sh:targetClass pko-extension:ModelCharter ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelCharters_IsCurrent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isCurrent ?_result .
            }
            WHERE {
    $this a pko-extension:ModelCharter .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validFrom ?valid_from . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validTo ?valid_to . OPTIONAL { ?valid_to erb:key ?valid_to__key . } }
                BIND((COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
