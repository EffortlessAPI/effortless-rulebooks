    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reviewCadenceDays ?review_cadence_days . }
                BIND((COALESCE(?is_currently_valid, false) && COALESCE(?has_review_record, false) && COALESCE((COALESCE(?days_since_actual_review, 0) > COALESCE(?review_cadence_days, 0)), false)) AS ?_result)
            }
        """ ;
