            }
            WHERE {
    $this a pko-extension:RoleQuestion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:predicateCount ?predicate_count . }
                BIND((COALESCE(?predicate_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

