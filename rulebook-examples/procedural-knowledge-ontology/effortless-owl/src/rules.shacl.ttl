                BIND((COALESCE(?authority_reviewed_at__key, COALESCE(IF(isIRI(?authority_reviewed_at), REPLACE(STR(?authority_reviewed_at), "^.*[#/]", ""), STR(?authority_reviewed_at)), "")) != "") AS ?_result)
