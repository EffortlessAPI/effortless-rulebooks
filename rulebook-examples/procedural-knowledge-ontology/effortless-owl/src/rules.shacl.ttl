    $this a pko-native-procedural-knowledge-rulebook:StepTools .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:tool ?tool . OPTIONAL { ?tool erb:key ?tool__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?tool__key, IF(isIRI(?tool), REPLACE(STR(?tool), "^.*[#/]", ""), STR(?tool))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for StepTransitions ===
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_Name a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:Transition .
    OPTIONAL { $this pko:fromStep ?from_step . OPTIONAL { ?from_step erb:key ?from_step__key . } }
    OPTIONAL { $this pko:toStep ?to_step . OPTIONAL { ?to_step erb:key ?to_step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_step__key, IF(isIRI(?from_step), REPLACE(STR(?from_step), "^.*[#/]", ""), STR(?from_step))), ""), " -> ", COALESCE(COALESCE(?to_step__key, IF(isIRI(?to_step), REPLACE(STR(?to_step), "^.*[#/]", ""), STR(?to_step))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_IsRecoveryPath a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsRecoveryPath" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isRecoveryPath ?_result .
            }
            WHERE {
    $this a pko:Transition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:transitionKind ?transition_kind . OPTIONAL { ?transition_kind erb:key ?transition_kind__key . } }
                BIND((COALESCE((COALESCE(?transition_kind__key, COALESCE(IF(isIRI(?transition_kind), REPLACE(STR(?transition_kind), "^.*[#/]", ""), STR(?transition_kind)), "")) = "Fallback"), false) || COALESCE((COALESCE(?transition_kind__key, COALESCE(IF(isIRI(?transition_kind), REPLACE(STR(?transition_kind), "^.*[#/]", ""), STR(?transition_kind)), "")) = "Alternative"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_CountOfFromStepExecutions a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_CountOfFromStepExecutions" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:countOfFromStepExecutions ?_result .
            }
            WHERE {
    $this a pko:Transition .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:Transition .
                    ?child a pko:StepExecution .
                    ?child pko-native-procedural-knowledge-rulebook:step ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko:fromStep ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
