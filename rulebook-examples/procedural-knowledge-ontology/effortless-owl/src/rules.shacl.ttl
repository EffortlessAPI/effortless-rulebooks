        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_AiInsightCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:aiInsightCount ?_result .
            }
            WHERE {
    $this a pko-extension:AiAdoptionInitiative .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AiAdoptionInitiative .
                    ?child a pko-extension:AiInsightProposal .
                    ?child pko-native-procedural-knowledge-rulebook:sourceInitiative $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiAdoptionInitiatives_HandsTacitProcedureToAgent a sh:NodeShape ;
    sh:targetClass pko-extension:AiAdoptionInitiative ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_HandsTacitProcedureToAgent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:handsTacitProcedureToAgent ?_result .
            }
            WHERE {
    $this a pko-extension:AiAdoptionInitiative .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAgentic ?is_agentic . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetHasNoExplicitSteps ?target_has_no_explicit_steps . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetProcedure ?target_procedure . OPTIONAL { ?target_procedure erb:key ?target_procedure__key . } }
                BIND((COALESCE(?is_agentic, false) && COALESCE((COALESCE(?target_procedure__key, COALESCE(IF(isIRI(?target_procedure), REPLACE(STR(?target_procedure), "^.*[#/]", ""), STR(?target_procedure)), "")) != ""), false) && COALESCE(?target_has_no_explicit_steps, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiAdoptionInitiatives_AgentOnUnderSpecifiedProcedure a sh:NodeShape ;
    sh:targetClass pko-extension:AiAdoptionInitiative ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_AgentOnUnderSpecifiedProcedure" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:agentOnUnderSpecifiedProcedure ?_result .
            }
            WHERE {
    $this a pko-extension:AiAdoptionInitiative .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAgentic ?is_agentic . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetVersion ?target_version . OPTIONAL { ?target_version erb:key ?target_version__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetVersionUnderSpecified ?target_version_under_specified . }
