            }
            WHERE {
    $this a pko-extension:KnowledgeSearchEvent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:foundNothingUseful ?found_nothing_useful . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:linkedKnowledgeGap ?linked_knowledge_gap . OPTIONAL { ?linked_knowledge_gap erb:key ?linked_knowledge_gap__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:linkedUsabilityBarrier ?linked_usability_barrier . OPTIONAL { ?linked_usability_barrier erb:key ?linked_usability_barrier__key . } }
                BIND((COALESCE(?found_nothing_useful, false) && COALESCE((COALESCE(?linked_knowledge_gap__key, COALESCE(IF(isIRI(?linked_knowledge_gap), REPLACE(STR(?linked_knowledge_gap), "^.*[#/]", ""), STR(?linked_knowledge_gap)), "")) = ""), false) && COALESCE((COALESCE(?linked_usability_barrier__key, COALESCE(IF(isIRI(?linked_usability_barrier), REPLACE(STR(?linked_usability_barrier), "^.*[#/]", ""), STR(?linked_usability_barrier)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

