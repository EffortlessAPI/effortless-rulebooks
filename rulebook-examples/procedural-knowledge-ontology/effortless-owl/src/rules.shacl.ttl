        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:calculatedScore ?_result .
            }
            WHERE {
    $this a pko-extension:SubstrateRunScore .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:calculatedPassed ?calculated_passed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:calculatedTested ?calculated_tested . }
                BIND(IF(COALESCE((COALESCE(?calculated_tested, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?calculated_passed) / ?calculated_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_LookupScore a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
