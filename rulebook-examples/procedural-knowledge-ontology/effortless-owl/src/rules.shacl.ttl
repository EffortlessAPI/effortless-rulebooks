            CONSTRUCT {
                $this effortless-ntwf:uncorroboratedPassCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:VerificationOutcomes .
                    ?child effortless-ntwf:uncorroboratedPassStepKey ?backfk .
                    $this effortless-ntwf:stepExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_EvidencePositionIsWeak" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:evidencePositionIsWeak ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:performedVerificationCount ?performed_verification_count . }
    OPTIONAL { $this effortless-ntwf:uncorroboratedPassCount ?uncorroborated_pass_count . }
                BIND((COALESCE((COALESCE(?performed_verification_count, 0) > 0), false) && COALESCE((COALESCE(?uncorroborated_pass_count, 0) >= COALESCE(?performed_verification_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
