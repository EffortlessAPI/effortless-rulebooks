    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:completedPrerequisiteRunCount ?completed_prerequisite_run_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:executionStatus_StepExecutions ?execution_status . OPTIONAL { ?execution_status erb:key ?execution_status__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepPrerequisite ?step_prerequisite . OPTIONAL { ?step_prerequisite erb:key ?step_prerequisite__key . } }
                BIND((COALESCE((COALESCE(?step_prerequisite__key, COALESCE(IF(isIRI(?step_prerequisite), REPLACE(STR(?step_prerequisite), "^.*[#/]", ""), STR(?step_prerequisite)), "")) != ""), false) && COALESCE((COALESCE(?completed_prerequisite_run_count, 0) = 0), false) && COALESCE((COALESCE(?execution_status__key, COALESCE(IF(isIRI(?execution_status), REPLACE(STR(?execution_status), "^.*[#/]", ""), STR(?execution_status)), "")) != "Completed"), false)) AS ?_result)
            }
