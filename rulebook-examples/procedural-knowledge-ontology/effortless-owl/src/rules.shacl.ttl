            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:auditItemCount ?_result .
            }
            WHERE {
    $this a pko-extension:SourcingFunction .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:SourcingFunction .
                    ?child a pko-extension:KnowledgeAuditItem .
                    ?child pko-native-procedural-knowledge-rulebook:sourcingFunction $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
