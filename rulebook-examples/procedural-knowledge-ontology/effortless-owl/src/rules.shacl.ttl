            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:orphanTermVocabularyKey ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOrphanTerm ?is_orphan_term . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:vocabulary ?vocabulary . }
                BIND(IF(COALESCE(?is_orphan_term, false), ?vocabulary, "") AS ?_result)
            }
        """ ;
    ] .
