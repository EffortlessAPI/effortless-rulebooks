    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?procedure . }
                BIND(IF(COALESCE((COALESCE(?lens_granularity_rank, 0) = 1), false), ?procedure, "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcedureOutcomeCriteria ===
pko-native-procedural-knowledge-rulebook-shapes:ProcedureOutcomeCriteria_Name a sh:NodeShape ;
    sh:targetClass pko-extension:OutcomeCriterion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureOutcomeCriteria_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:OutcomeCriterion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:polarity ?polarity . OPTIONAL { ?polarity erb:key ?polarity__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?procedure . OPTIONAL { ?procedure erb:key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), " ", COALESCE(COALESCE(?polarity__key, IF(isIRI(?polarity), REPLACE(STR(?polarity), "^.*[#/]", ""), STR(?polarity))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureOutcomeCriteria_FailureProcedureKey a sh:NodeShape ;
    sh:targetClass pko-extension:OutcomeCriterion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureOutcomeCriteria_FailureProcedureKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:failureProcedureKey ?_result .
            }
            WHERE {
    $this a pko-extension:OutcomeCriterion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:polarity ?polarity . OPTIONAL { ?polarity erb:key ?polarity__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?procedure . }
                BIND(IF(COALESCE((COALESCE(?polarity__key, COALESCE(IF(isIRI(?polarity), REPLACE(STR(?polarity), "^.*[#/]", ""), STR(?polarity)), "")) = "Failure"), false), ?procedure, "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcedureResources ===
pko-native-procedural-knowledge-rulebook-shapes:ProcedureResources_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureResources ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureResources_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureResources .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version erb:key ?procedure_version__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resource ?resource . OPTIONAL { ?resource erb:key ?resource__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " / ", COALESCE(COALESCE(?resource__key, IF(isIRI(?resource), REPLACE(STR(?resource), "^.*[#/]", ""), STR(?resource))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureResources_RelationIri a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureResources ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureResources_RelationIri" ;
