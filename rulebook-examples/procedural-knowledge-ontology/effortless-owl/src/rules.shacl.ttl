            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDeclaredCurrentRelease ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:modelCurrentRelease ?model_current_release . OPTIONAL { ?model_current_release effortless-ntwf:__key ?model_current_release__key . } }
    OPTIONAL { $this effortless-ntwf:rulebookReleaseId ?rulebook_release_id . }
                BIND((COALESCE((COALESCE(?model_current_release__key, COALESCE(IF(isIRI(?model_current_release), REPLACE(STR(?model_current_release), "^.*[#/]", ""), STR(?model_current_release)), "")) != ""), false) && COALESCE(COALESCE((?rulebook_release_id = ?model_current_release), ((!BOUND(?rulebook_release_id) || STR(?rulebook_release_id) = "") && (!BOUND(?model_current_release) || STR(?model_current_release) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_LogEntryCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:logEntryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelChangeLogEntries .
                    ?child effortless-ntwf:release $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_LogicalChangeCount" ;
