    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:inWorkCaptureCount ?in_work_capture_count . }
                BIND((COALESCE((COALESCE(?collected_material_count, 0) > 0), false) && COALESCE((COALESCE(?in_work_capture_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Procedures_ExpertAcquisitionHours a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_ExpertAcquisitionHours" ;
