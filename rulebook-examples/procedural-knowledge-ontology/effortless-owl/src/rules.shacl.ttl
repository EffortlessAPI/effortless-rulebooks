# === Rules for ProcessDesignDecisions ===
pko-native-procedural-knowledge-rulebook-shapes:ProcessDesignDecisions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessDesignDecision ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessDesignDecisions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessDesignDecision .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decision ?decision . }
                BIND(SUBSTR(STR(?decision), 1, 60) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessDesignDecisions_IsCommitmentWithoutRationale a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessDesignDecision ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessDesignDecisions_IsCommitmentWithoutRationale" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isCommitmentWithoutRationale ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessDesignDecision .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decision ?decision . OPTIONAL { ?decision erb:key ?decision__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rationale ?rationale . OPTIONAL { ?rationale erb:key ?rationale__key . } }
                BIND((COALESCE((COALESCE(?decision__key, COALESCE(IF(isIRI(?decision), REPLACE(STR(?decision), "^.*[#/]", ""), STR(?decision)), "")) != ""), false) && COALESCE((COALESCE(?rationale__key, COALESCE(IF(isIRI(?rationale), REPLACE(STR(?rationale), "^.*[#/]", ""), STR(?rationale)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessDesignDecisions_DaysBeforeRecorded a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessDesignDecision ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessDesignDecisions_DaysBeforeRecorded" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysBeforeRecorded ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessDesignDecision .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decidedAt ?decided_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recordedAt ?recorded_at . }
                BIND(ROUND(((DAY(?recorded_at) + FLOOR((153 * (MONTH(?recorded_at) + 12 * FLOOR((14 - MONTH(?recorded_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?recorded_at) + 4800 - FLOOR((14 - MONTH(?recorded_at)) / 12)) + FLOOR((YEAR(?recorded_at) + 4800 - FLOOR((14 - MONTH(?recorded_at)) / 12)) / 4) - FLOOR((YEAR(?recorded_at) + 4800 - FLOOR((14 - MONTH(?recorded_at)) / 12)) / 100) + FLOOR((YEAR(?recorded_at) + 4800 - FLOOR((14 - MONTH(?recorded_at)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessDesignDecisions_IsRecordedAfterTheFact a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessDesignDecision ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessDesignDecisions_IsRecordedAfterTheFact" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isRecordedAfterTheFact ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessDesignDecision .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysBeforeRecorded ?days_before_recorded . }
                BIND((COALESCE(?days_before_recorded, 0) > 30) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcessInterdependencies ===
pko-native-procedural-knowledge-rulebook-shapes:ProcessInterdependencies_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessInterdependency ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessInterdependencies_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessInterdependency .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:effect ?effect . OPTIONAL { ?effect erb:key ?effect__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fromProcedure ?from_procedure . OPTIONAL { ?from_procedure erb:key ?from_procedure__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toProcedure ?to_procedure . OPTIONAL { ?to_procedure erb:key ?to_procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_procedure__key, IF(isIRI(?from_procedure), REPLACE(STR(?from_procedure), "^.*[#/]", ""), STR(?from_procedure))), ""), " ", COALESCE(COALESCE(?effect__key, IF(isIRI(?effect), REPLACE(STR(?effect), "^.*[#/]", ""), STR(?effect))), ""), " ", COALESCE(COALESCE(?to_procedure__key, IF(isIRI(?to_procedure), REPLACE(STR(?to_procedure), "^.*[#/]", ""), STR(?to_procedure))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessInterdependencies_IsHinderingDependency a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessInterdependency ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessInterdependencies_IsHinderingDependency" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isHinderingDependency ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessInterdependency .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:effect ?effect . OPTIONAL { ?effect erb:key ?effect__key . } }
                BIND((COALESCE(?effect__key, COALESCE(IF(isIRI(?effect), REPLACE(STR(?effect), "^.*[#/]", ""), STR(?effect)), "")) = "Hinders") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessInterdependencies_HinderedProcedureKey a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessInterdependency ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessInterdependencies_HinderedProcedureKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hinderedProcedureKey ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessInterdependency .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:effect ?effect . OPTIONAL { ?effect erb:key ?effect__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toProcedure ?to_procedure . }
                BIND(IF(COALESCE((COALESCE(?effect__key, COALESCE(IF(isIRI(?effect), REPLACE(STR(?effect), "^.*[#/]", ""), STR(?effect)), "")) = "Hinders"), false), ?to_procedure, "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcessKnowledgeLevels ===
pko-native-procedural-knowledge-rulebook-shapes:ProcessKnowledgeLevels_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessKnowledgeLevel ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessKnowledgeLevels_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessKnowledgeLevel .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessKnowledgeLevels_TacitStrategyCount a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessKnowledgeLevel ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessKnowledgeLevels_TacitStrategyCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:tacitStrategyCount ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessKnowledgeLevel .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ProcessKnowledgeLevel .
                    ?child a pko-extension:LevelCaptureStrategy .
                    ?child pko-native-procedural-knowledge-rulebook:level $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:knowledgeForm ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Tacit"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessKnowledgeLevels_ExplicitStrategyCount a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessKnowledgeLevel ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessKnowledgeLevels_ExplicitStrategyCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:explicitStrategyCount ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessKnowledgeLevel .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ProcessKnowledgeLevel .
                    ?child a pko-extension:LevelCaptureStrategy .
                    ?child pko-native-procedural-knowledge-rulebook:level $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:knowledgeForm ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Explicit"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessKnowledgeLevels_LacksCaptureStrategyForEitherForm a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessKnowledgeLevel ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessKnowledgeLevels_LacksCaptureStrategyForEitherForm" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:lacksCaptureStrategyForEitherForm ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessKnowledgeLevel .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:explicitStrategyCount ?explicit_strategy_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:tacitStrategyCount ?tacit_strategy_count . }
                BIND((COALESCE((COALESCE(?tacit_strategy_count, 0) = 0), false) || COALESCE((COALESCE(?explicit_strategy_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcessLevelStatements ===
pko-native-procedural-knowledge-rulebook-shapes:ProcessLevelStatements_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessLevelStatement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessLevelStatements_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessLevelStatement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:level ?level . OPTIONAL { ?level erb:key ?level__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?procedure . OPTIONAL { ?procedure erb:key ?procedure__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:questionKind ?question_kind . OPTIONAL { ?question_kind erb:key ?question_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), " ", COALESCE(COALESCE(?level__key, IF(isIRI(?level), REPLACE(STR(?level), "^.*[#/]", ""), STR(?level))), ""), " ", COALESCE(COALESCE(?question_kind__key, IF(isIRI(?question_kind), REPLACE(STR(?question_kind), "^.*[#/]", ""), STR(?question_kind))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessLevelStatements_LevelQuestionKey a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessLevelStatement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessLevelStatements_LevelQuestionKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:levelQuestionKey ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessLevelStatement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:level ?level . OPTIONAL { ?level erb:key ?level__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:questionKind ?question_kind . OPTIONAL { ?question_kind erb:key ?question_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?level__key, IF(isIRI(?level), REPLACE(STR(?level), "^.*[#/]", ""), STR(?level))), ""), "|", COALESCE(COALESCE(?question_kind__key, IF(isIRI(?question_kind), REPLACE(STR(?question_kind), "^.*[#/]", ""), STR(?question_kind))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessLevelStatements_PyramidMatchCount a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessLevelStatement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessLevelStatements_PyramidMatchCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:pyramidMatchCount ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessLevelStatement .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ProcessLevelStatement .
                    ?child a pko-extension:LevelPyramidQuestion .
                    ?child pko-native-procedural-knowledge-rulebook:levelPyramidQuestionId ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:levelQuestionKey ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessLevelStatements_IsFiledAtWrongLevel a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessLevelStatement ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessLevelStatements_IsFiledAtWrongLevel" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFiledAtWrongLevel ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessLevelStatement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:pyramidMatchCount ?pyramid_match_count . }
                BIND((COALESCE(?pyramid_match_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcessMiningRuns ===
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:eventLogSource ?event_log_source . OPTIONAL { ?event_log_source erb:key ?event_log_source__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:minedAt ?mined_at . OPTIONAL { ?mined_at erb:key ?mined_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?event_log_source__key, IF(isIRI(?event_log_source), REPLACE(STR(?event_log_source), "^.*[#/]", ""), STR(?event_log_source))), ""), " / ", COALESCE(REPLACE(COALESCE(?mined_at__key, IF(isIRI(?mined_at), REPLACE(STR(?mined_at), "^.*[#/]", ""), STR(?mined_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_AsOfInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_ConformanceRate a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_ConformanceRate" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:conformanceRate ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conformingVariantCount ?conforming_variant_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:discoveredVariantCount ?discovered_variant_count . }
                BIND(IF(COALESCE((COALESCE(?discovered_variant_count, 0) = 0), false), 0, xsd:double(?conforming_variant_count / ?discovered_variant_count)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_IsConformant a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsConformant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isConformant ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conformanceRate ?conformance_rate . }
                BIND((COALESCE(?conformance_rate, 0) >= 0.8) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_HasMajorDriftFromDocumentation a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_HasMajorDriftFromDocumentation" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasMajorDriftFromDocumentation ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conformanceRate ?conformance_rate . }
                BIND((COALESCE(?conformance_rate, 0) < 0.5) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_DaysSinceMined a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_DaysSinceMined" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceMined ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:minedAt ?mined_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?mined_at) + FLOOR((153 * (MONTH(?mined_at) + 12 * FLOOR((14 - MONTH(?mined_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) + FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 4) - FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 100) + FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_IsStaleMiningEvidence a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsStaleMiningEvidence" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isStaleMiningEvidence ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceMined ?days_since_mined . }
                BIND((COALESCE(?days_since_mined, 0) > 180) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_ProcedureVersionIsLive a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_ProcedureVersionIsLive" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:procedureVersionIsLive ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:ProcedureVersions . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isLive ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_IsDriftOnLiveVersion a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsDriftOnLiveVersion" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDriftOnLiveVersion ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasMajorDriftFromDocumentation ?has_major_drift_from_documentation . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersionIsLive ?procedure_version_is_live . }
                BIND((COALESCE(?has_major_drift_from_documentation, false) && COALESCE(?procedure_version_is_live, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_DriftedMiningRunKey a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_DriftedMiningRunKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:driftedMiningRunKey ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isDriftOnLiveVersion ?is_drift_on_live_version . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_drift_on_live_version, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_PeopleCaptureComplementCount a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_PeopleCaptureComplementCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:peopleCaptureComplementCount ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ProcessMiningRun .
                    ?child a pko-extension:CollectedSourceMaterial .
                    ?child pko-native-procedural-knowledge-rulebook:complementsMiningRun $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:holdsReasoningOrTacitKnowledge ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_IsDeviationUnexplainedByPeople a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsDeviationUnexplainedByPeople" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDeviationUnexplainedByPeople ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conformingVariantCount ?conforming_variant_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:discoveredVariantCount ?discovered_variant_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:peopleCaptureComplementCount ?people_capture_complement_count . }
                BIND((COALESCE((COALESCE(?discovered_variant_count, 0) > COALESCE(?conforming_variant_count, 0)), false) && COALESCE((COALESCE(?people_capture_complement_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_UndocumentedPathCount a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_UndocumentedPathCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:undocumentedPathCount ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ProcessMiningRun .
                    ?child a pko-extension:MinedFlowEdge .
                    ?child pko-native-procedural-knowledge-rulebook:processMiningRun $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isUndocumentedPath ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_HasUndocumentedEnactedPath a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_HasUndocumentedEnactedPath" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasUndocumentedEnactedPath ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:undocumentedPathCount ?undocumented_path_count . }
                BIND((COALESCE(?undocumented_path_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessMiningRuns_ConformancePercent a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessMiningRun ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_ConformancePercent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:conformancePercent ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessMiningRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conformanceRate ?conformance_rate . }
                BIND(ROUND((ROUND((?conformance_rate * 100) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcessOutcomeMeasures ===
pko-native-procedural-knowledge-rulebook-shapes:ProcessOutcomeMeasures_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessOutcomeMeasure ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessOutcomeMeasures_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessOutcomeMeasure .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . OPTIONAL { ?label erb:key ?label__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?procedure . OPTIONAL { ?procedure erb:key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), ": ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessOutcomeMeasures_IsUnlinkedToBusinessOutcome a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessOutcomeMeasure ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessOutcomeMeasures_IsUnlinkedToBusinessOutcome" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnlinkedToBusinessOutcome ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessOutcomeMeasure .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:businessOutcome ?business_outcome . OPTIONAL { ?business_outcome erb:key ?business_outcome__key . } }
                BIND((COALESCE(?business_outcome__key, COALESCE(IF(isIRI(?business_outcome), REPLACE(STR(?business_outcome), "^.*[#/]", ""), STR(?business_outcome)), "")) = "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcessStages ===
pko-native-procedural-knowledge-rulebook-shapes:ProcessStages_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessStage ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessStages_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessStage .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . OPTIONAL { ?label erb:key ?label__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version erb:key ?procedure_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " stage ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessStages_StepCount a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessStage ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessStages_StepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:stepCount ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessStage .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ProcessStage .
                    ?child a p-plan:Step .
                    ?child pko-native-procedural-knowledge-rulebook:stage $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessStages_OwnerHasNoHolder a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessStage ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessStages_OwnerHasNoHolder" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:ownerHasNoHolder ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessStage .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ownerRole ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:Role . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:hasNoCurrentHolder ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessStages_IsUnownedOrEmptyStage a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessStage ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessStages_IsUnownedOrEmptyStage" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnownedOrEmptyStage ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessStage .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ownerHasNoHolder ?owner_has_no_holder . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ownerRole ?owner_role . OPTIONAL { ?owner_role erb:key ?owner_role__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepCount ?step_count . }
                BIND((COALESCE((COALESCE(?owner_role__key, COALESCE(IF(isIRI(?owner_role), REPLACE(STR(?owner_role), "^.*[#/]", ""), STR(?owner_role)), "")) = ""), false) || COALESCE(?owner_has_no_holder, false) || COALESCE((COALESCE(?step_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcessStrategicAlignments ===
pko-native-procedural-knowledge-rulebook-shapes:ProcessStrategicAlignments_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessStrategicAlignment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessStrategicAlignments_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessStrategicAlignment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:organization ?organization . OPTIONAL { ?organization erb:key ?organization__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?procedure . OPTIONAL { ?procedure erb:key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), " serves ", COALESCE(COALESCE(?organization__key, IF(isIRI(?organization), REPLACE(STR(?organization), "^.*[#/]", ""), STR(?organization))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcessStrategicAlignments_StatesNoTradeOff a sh:NodeShape ;
    sh:targetClass pko-extension:ProcessStrategicAlignment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessStrategicAlignments_StatesNoTradeOff" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:statesNoTradeOff ?_result .
            }
            WHERE {
    $this a pko-extension:ProcessStrategicAlignment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:tradeOffs ?trade_offs . OPTIONAL { ?trade_offs erb:key ?trade_offs__key . } }
                BIND((COALESCE(?trade_offs__key, COALESCE(IF(isIRI(?trade_offs), REPLACE(STR(?trade_offs), "^.*[#/]", ""), STR(?trade_offs)), "")) = "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for PromptTemplates ===
pko-native-procedural-knowledge-rulebook-shapes:PromptTemplates_Name a sh:NodeShape ;
    sh:targetClass pko-extension:PromptTemplate ;
    sh:order 1 ;
