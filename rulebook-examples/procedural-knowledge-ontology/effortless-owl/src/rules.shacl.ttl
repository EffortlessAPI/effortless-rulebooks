            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:isUnmaintained ?is_unmaintained . }
    OPTIONAL { $this effortless-ntwf:openPracticeDriftCount ?open_practice_drift_count . }
                BIND((COALESCE(?is_unmaintained, false) && COALESCE((COALESCE(?open_practice_drift_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
