            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:departedHolderKnowHowCount ?_result .
            }
            WHERE {
    $this a pko-industry:Department .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-industry:Department .
                    ?child a pko-extension:KnowHowCarrier .
                    ?child pko-native-procedural-knowledge-rulebook:organization $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isHeldByDepartedHolder ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
