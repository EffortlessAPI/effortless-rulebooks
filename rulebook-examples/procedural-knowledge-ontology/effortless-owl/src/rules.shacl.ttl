        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:deployedWithoutTargetRelease ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
    OPTIONAL { $this effortless-ntwf:isSchemaChange ?is_schema_change . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
    OPTIONAL { $this effortless-ntwf:targetRelease ?target_release . OPTIONAL { ?target_release effortless-ntwf:__key ?target_release__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Deployed"), false) && COALESCE(?is_schema_change, false) && COALESCE((COALESCE(?target_release__key, COALESCE(IF(isIRI(?target_release), REPLACE(STR(?target_release), "^.*[#/]", ""), STR(?target_release)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
