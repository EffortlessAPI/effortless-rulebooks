    OPTIONAL { $this effortless-ntwf:refusalNotifiedRole ?refusal_notified_role . }
                BIND(IF(COALESCE(?is_unrecorded_refusal, false), ?refusal_notified_role, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_UnrecordedRefusalExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
