pko-native-procedural-knowledge-rulebook-shapes:CompetencyQuestionSetEntries_DaysSinceAdded a sh:NodeShape ;
    sh:targetClass pko-extension:CompetencyQuestionSetEntry ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionSetEntries_DaysSinceAdded" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceAdded ?_result .
            }
            WHERE {
    $this a pko-extension:CompetencyQuestionSetEntry .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:addedAt ?added_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?added_at) + FLOOR((153 * (MONTH(?added_at) + 12 * FLOOR((14 - MONTH(?added_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?added_at) + 4800 - FLOOR((14 - MONTH(?added_at)) / 12)) + FLOOR((YEAR(?added_at) + 4800 - FLOOR((14 - MONTH(?added_at)) / 12)) / 4) - FLOOR((YEAR(?added_at) + 4800 - FLOOR((14 - MONTH(?added_at)) / 12)) / 100) + FLOOR((YEAR(?added_at) + 4800 - FLOOR((14 - MONTH(?added_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CompetencyQuestionSetEntries_IsOutgrownBaselineQuestion a sh:NodeShape ;
    sh:targetClass pko-extension:CompetencyQuestionSetEntry ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionSetEntries_IsOutgrownBaselineQuestion" ;
