    OPTIONAL { $this effortless-ntwf:hasApprovedChangeCoverage ?has_approved_change_coverage . }
    OPTIONAL { $this effortless-ntwf:ranUnderException ?ran_under_exception . }
                BIND((COALESCE(?ran_under_exception, false) || COALESCE(?has_approved_change_coverage, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasApprovedChangeCoverage" ;
