# === Rules for DriftObservations ===
pko-native-procedural-knowledge-rulebook-shapes:DriftObservations_Name a sh:NodeShape ;
    sh:targetClass pko-extension:DriftObservation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DriftObservations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:DriftObservation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:description ?description . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:governedModel ?governed_model . OPTIONAL { ?governed_model erb:key ?governed_model__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?description), 1, 50)), REPLACE(STR(SUBSTR(STR(?description), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?description), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] .
