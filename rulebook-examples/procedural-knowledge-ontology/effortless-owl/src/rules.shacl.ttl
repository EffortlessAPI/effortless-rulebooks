            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:conflictCount ?_result .
            }
            WHERE {
    $this a pko-extension:AssistantAnswer .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AssistantAnswer .
                    ?child a pko-extension:AnswerRequirementCheck .
                    ?child pko-native-procedural-knowledge-rulebook:assistantAnswer $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:verdict ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Conflicts"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
