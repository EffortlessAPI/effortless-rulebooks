            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reachableStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(*) AS ?_result) WHERE {
                        $this effortless-ntwf:leadsTo+ ?b .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_ReachedFromStepCount" ;
        sh:prefixes effortless-ntwf: ;
