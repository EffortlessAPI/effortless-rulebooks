            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:boundaryViolationCount ?_result .
            }
            WHERE {
    $this a prov:Agent .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a prov:Agent .
                    ?child a pko-extension:AgentDecisionRecord .
                    ?child pko-native-procedural-knowledge-rulebook:agentWhenBoundaryViolated ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:agentId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
