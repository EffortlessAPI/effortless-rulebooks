# === Rules for ReasonerRuns ===
pko-native-procedural-knowledge-rulebook-shapes:ReasonerRuns_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ReasonerRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReasonerRuns_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ReasonerRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reasonerProfile ?reasoner_profile . OPTIONAL { ?reasoner_profile erb:key ?reasoner_profile__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:snapshot ?snapshot . OPTIONAL { ?snapshot erb:key ?snapshot__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?snapshot__key, IF(isIRI(?snapshot), REPLACE(STR(?snapshot), "^.*[#/]", ""), STR(?snapshot))), ""), " / ", COALESCE(COALESCE(?reasoner_profile__key, IF(isIRI(?reasoner_profile), REPLACE(STR(?reasoner_profile), "^.*[#/]", ""), STR(?reasoner_profile))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ReasonerRuns_IsRichnessTractabilityFailure a sh:NodeShape ;
    sh:targetClass pko-extension:ReasonerRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReasonerRuns_IsRichnessTractabilityFailure" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isRichnessTractabilityFailure ?_result .
            }
            WHERE {
    $this a pko-extension:ReasonerRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:droppedAxiomCount ?dropped_axiom_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:durationSeconds ?duration_seconds . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:timeBudgetSeconds ?time_budget_seconds . }
                BIND((COALESCE((COALESCE(?duration_seconds, 0) > COALESCE(?time_budget_seconds, 0)), false) || COALESCE((COALESCE(?dropped_axiom_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ReasonerRuns_PassesSchemaButFailsReasoner a sh:NodeShape ;
    sh:targetClass pko-extension:ReasonerRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReasonerRuns_PassesSchemaButFailsReasoner" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:passesSchemaButFailsReasoner ?_result .
            }
            WHERE {
    $this a pko-extension:ReasonerRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isConsistent ?is_consistent . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:schemaValidationPassed ?schema_validation_passed . }
                BIND((COALESCE(?schema_validation_passed, false) && COALESCE((COALESCE(?is_consistent, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

