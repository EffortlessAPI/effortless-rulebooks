    ] .
pko-native-procedural-knowledge-rulebook-shapes:Recipients_IsUnreachable a sh:NodeShape ;
    sh:targetClass pko-extension:Recipient ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsUnreachable" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnreachable ?_result .
            }
            WHERE {
    $this a pko-extension:Recipient .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isEmailReachable ?is_email_reachable . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isSmsReachable ?is_sms_reachable . }
                BIND((COALESCE((!(COALESCE(?is_email_reachable, false))), false) && COALESCE((!(COALESCE(?is_sms_reachable, false))), false)) AS ?_result)
            }
        """ ;
    ] .
