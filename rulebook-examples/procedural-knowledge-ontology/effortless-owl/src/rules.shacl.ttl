            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:gateHeldByHuman ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:assignedAgentKind ?assigned_agent_kind . }
    OPTIONAL { $this effortless-ntwf:isHumanApprovalGate ?is_human_approval_gate . }
                BIND((COALESCE(?is_human_approval_gate, false) && COALESCE((REPLACE(COALESCE(STR(?assigned_agent_kind), ""), "^.*#", "") = "Human"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_BindingBoundaryCount" ;
