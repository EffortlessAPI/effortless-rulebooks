# === Rules for KnowledgeMethods ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeMethods_Name a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeMethod ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeMethods_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeMethod .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeMethods_ElicitationUseCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeMethod ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeMethods_ElicitationUseCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:elicitationUseCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeMethod .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:KnowledgeMethod .
                    ?child a pko-extension:ElicitationSession .
                    ?child pko-native-procedural-knowledge-rulebook:method $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeMethods_ApplicationCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeMethod ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeMethods_ApplicationCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:applicationCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeMethod .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:KnowledgeMethod .
                    ?child a pko-extension:MethodApplication .
                    ?child pko-native-procedural-knowledge-rulebook:knowledgeMethod $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeMethods_UsageCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeMethod ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeMethods_UsageCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:usageCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeMethod .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:applicationCount ?application_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:elicitationUseCount ?elicitation_use_count . }
                BIND(ROUND((?elicitation_use_count + ?application_count)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeMethods_IsApplied a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeMethod ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeMethods_IsApplied" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isApplied ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeMethod .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usageCount ?usage_count . }
                BIND((COALESCE(?usage_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

