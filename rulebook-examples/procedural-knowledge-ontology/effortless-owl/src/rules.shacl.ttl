    OPTIONAL { $this effortless-ntwf:questionTopic ?question_topic . OPTIONAL { ?question_topic effortless-ntwf:__key ?question_topic__key . } }
    OPTIONAL { $this effortless-ntwf:retrievalMode ?retrieval_mode . OPTIONAL { ?retrieval_mode effortless-ntwf:__key ?retrieval_mode__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?question_topic__key, COALESCE(IF(isIRI(?question_topic), REPLACE(STR(?question_topic), "^.*[#/]", ""), STR(?question_topic)), "")) = "Authority"), false) || COALESCE((COALESCE(?question_topic__key, COALESCE(IF(isIRI(?question_topic), REPLACE(STR(?question_topic), "^.*[#/]", ""), STR(?question_topic)), "")) = "Safety"), false)), false) && COALESCE((COALESCE(?retrieval_mode__key, COALESCE(IF(isIRI(?retrieval_mode), REPLACE(STR(?retrieval_mode), "^.*[#/]", ""), STR(?retrieval_mode)), "")) = "DocumentPassage"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_DocumentInterpretationErred" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:documentInterpretationErred ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantAnswers .
    OPTIONAL { $this effortless-ntwf:questionTopic ?question_topic . OPTIONAL { ?question_topic effortless-ntwf:__key ?question_topic__key . } }
    OPTIONAL { $this effortless-ntwf:retrievalMode ?retrieval_mode . OPTIONAL { ?retrieval_mode effortless-ntwf:__key ?retrieval_mode__key . } }
    OPTIONAL { $this effortless-ntwf:wasCorrect ?was_correct . }
                BIND((COALESCE((COALESCE(?retrieval_mode__key, COALESCE(IF(isIRI(?retrieval_mode), REPLACE(STR(?retrieval_mode), "^.*[#/]", ""), STR(?retrieval_mode)), "")) = "DocumentPassage"), false) && COALESCE((COALESCE(?question_topic__key, COALESCE(IF(isIRI(?question_topic), REPLACE(STR(?question_topic), "^.*[#/]", ""), STR(?question_topic)), "")) = "Authority"), false) && COALESCE((COALESCE(?was_correct, false) = false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_ModelDidTheReasoning" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:modelDidTheReasoning ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantAnswers .
    OPTIONAL { $this effortless-ntwf:derivationPerformedBy ?derivation_performed_by . OPTIONAL { ?derivation_performed_by effortless-ntwf:__key ?derivation_performed_by__key . } }
    OPTIONAL { $this effortless-ntwf:needsInference ?needs_inference . }
                BIND((COALESCE(?needs_inference, false) && COALESCE((COALESCE(?derivation_performed_by__key, COALESCE(IF(isIRI(?derivation_performed_by), REPLACE(STR(?derivation_performed_by), "^.*[#/]", ""), STR(?derivation_performed_by)), "")) = "LanguageModel"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_WrongBecauseGraphWasStale" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wrongBecauseGraphWasStale ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantAnswers .
    OPTIONAL { $this effortless-ntwf:retrievalMode ?retrieval_mode . OPTIONAL { ?retrieval_mode effortless-ntwf:__key ?retrieval_mode__key . } }
    OPTIONAL { $this effortless-ntwf:staleGroundingCount ?stale_grounding_count . }
    OPTIONAL { $this effortless-ntwf:wasCorrect ?was_correct . }
                BIND((COALESCE((COALESCE(?retrieval_mode__key, COALESCE(IF(isIRI(?retrieval_mode), REPLACE(STR(?retrieval_mode), "^.*[#/]", ""), STR(?retrieval_mode)), "")) = "StructuredQuery"), false) && COALESCE((COALESCE(?was_correct, false) = false), false) && COALESCE((COALESCE(?stale_grounding_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AssistantBenchmarks ===
effortless-ntwf:AssistantBenchmarksShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AssistantBenchmarks ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantBenchmarks_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantBenchmarks .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantBenchmarks_AccuracyLiftPoints" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:accuracyLiftPoints ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantBenchmarks .
    OPTIONAL { $this effortless-ntwf:graphGroundedAccuracyPercent ?graph_grounded_accuracy_percent . }
    OPTIONAL { $this effortless-ntwf:ungroundedAccuracyPercent ?ungrounded_accuracy_percent . }
                BIND((?graph_grounded_accuracy_percent - ?ungrounded_accuracy_percent) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantBenchmarks_ShowsSpatialLiftFromGraphQueries" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:showsSpatialLiftFromGraphQueries ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantBenchmarks .
    OPTIONAL { $this effortless-ntwf:accuracyLiftPoints ?accuracy_lift_points . }
    OPTIONAL { $this effortless-ntwf:generatesDatabaseQueries ?generates_database_queries . }
    OPTIONAL { $this effortless-ntwf:taskFamily ?task_family . OPTIONAL { ?task_family effortless-ntwf:__key ?task_family__key . } }
                BIND((COALESCE((COALESCE(?task_family__key, COALESCE(IF(isIRI(?task_family), REPLACE(STR(?task_family), "^.*[#/]", ""), STR(?task_family)), "")) = "Spatial"), false) && COALESCE(?generates_database_queries, false) && COALESCE((COALESCE(?accuracy_lift_points, 0) >= 20), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantBenchmarks_ShowsGeospatialRetrievalLift" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:showsGeospatialRetrievalLift ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantBenchmarks .
    OPTIONAL { $this effortless-ntwf:accuracyLiftPoints ?accuracy_lift_points . }
    OPTIONAL { $this effortless-ntwf:taskFamily ?task_family . OPTIONAL { ?task_family effortless-ntwf:__key ?task_family__key . } }
                BIND((COALESCE((COALESCE(?task_family__key, COALESCE(IF(isIRI(?task_family), REPLACE(STR(?task_family), "^.*[#/]", ""), STR(?task_family)), "")) = "Geospatial"), false) && COALESCE((COALESCE(?accuracy_lift_points, 0) >= 20), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Attestations ===
effortless-ntwf:AttestationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Attestations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
    OPTIONAL { $this effortless-ntwf:attestationId ?attestation_id . OPTIONAL { ?attestation_id effortless-ntwf:__key ?attestation_id__key . } }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . OPTIONAL { ?procedure_execution effortless-ntwf:__key ?procedure_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_execution__key, IF(isIRI(?procedure_execution), REPLACE(STR(?procedure_execution), "^.*[#/]", ""), STR(?procedure_execution))), ""), " / ", COALESCE(COALESCE(?attestation_id__key, IF(isIRI(?attestation_id), REPLACE(STR(?attestation_id), "^.*[#/]", ""), STR(?attestation_id))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_VersionIsFitNow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:versionIsFitNow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
                OPTIONAL { $this effortless-ntwf:procedureExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureExecutions ; effortless-ntwf:procedureExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:executedVersionIsFit ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_FitnessVerdictHasDrifted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fitnessVerdictHasDrifted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
    OPTIONAL { $this effortless-ntwf:versionIsFitNow ?version_is_fit_now . }
    OPTIONAL { $this effortless-ntwf:versionWasFitAtSigning ?version_was_fit_at_signing . }
                BIND((!(COALESCE((COALESCE(?version_was_fit_at_signing, false) = COALESCE(?version_is_fit_now, false)), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_AssuranceGradeNow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assuranceGradeNow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
                OPTIONAL { $this effortless-ntwf:procedureExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureExecutions ; effortless-ntwf:procedureExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:assuranceGrade ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_AssuranceGradeHasDrifted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assuranceGradeHasDrifted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
    OPTIONAL { $this effortless-ntwf:assuranceGradeAtSigning ?assurance_grade_at_signing . }
    OPTIONAL { $this effortless-ntwf:assuranceGradeNow ?assurance_grade_now . }
                BIND((!(COALESCE(COALESCE((?assurance_grade_at_signing = ?assurance_grade_now), ((!BOUND(?assurance_grade_at_signing) || STR(?assurance_grade_at_signing) = "") && (!BOUND(?assurance_grade_now) || STR(?assurance_grade_now) = ""))), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_WouldNotSurviveRestatement" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wouldNotSurviveRestatement ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
    OPTIONAL { $this effortless-ntwf:assuranceGradeHasDrifted ?assurance_grade_has_drifted . }
    OPTIONAL { $this effortless-ntwf:fitnessVerdictHasDrifted ?fitness_verdict_has_drifted . }
                BIND((COALESCE(?fitness_verdict_has_drifted, false) || COALESCE(?assurance_grade_has_drifted, false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AuthoringSubmissions ===
effortless-ntwf:AuthoringSubmissionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AuthoringSubmissions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthoringSubmissions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthoringSubmissions .
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version effortless-ntwf:__key ?procedure_version__key . } }
    OPTIONAL { $this effortless-ntwf:submittedByAgent ?submitted_by_agent . OPTIONAL { ?submitted_by_agent effortless-ntwf:__key ?submitted_by_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " by ", COALESCE(COALESCE(?submitted_by_agent__key, IF(isIRI(?submitted_by_agent), REPLACE(STR(?submitted_by_agent), "^.*[#/]", ""), STR(?submitted_by_agent))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthoringSubmissions_IsExpertAuthoredConforming" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isExpertAuthoredConforming ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthoringSubmissions .
    OPTIONAL { $this effortless-ntwf:profileValidationPassed ?profile_validation_passed . }
    OPTIONAL { $this effortless-ntwf:submitterExpertise ?submitter_expertise . OPTIONAL { ?submitter_expertise effortless-ntwf:__key ?submitter_expertise__key . } }
                BIND((COALESCE((COALESCE(?submitter_expertise__key, COALESCE(IF(isIRI(?submitter_expertise), REPLACE(STR(?submitter_expertise), "^.*[#/]", ""), STR(?submitter_expertise)), "")) = "DomainExpert"), false) && COALESCE(?profile_validation_passed, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthoringSubmissions_IsNonConformingAccepted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNonConformingAccepted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthoringSubmissions .
    OPTIONAL { $this effortless-ntwf:profileValidationPassed ?profile_validation_passed . }
    OPTIONAL { $this effortless-ntwf:wasAccepted ?was_accepted . }
                BIND((COALESCE(?was_accepted, false) && COALESCE((COALESCE(?profile_validation_passed, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AuthorityBoundaries ===
effortless-ntwf:AuthorityBoundariesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AuthorityBoundaries ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:forbiddenAgentKind ?forbidden_agent_kind . OPTIONAL { ?forbidden_agent_kind effortless-ntwf:__key ?forbidden_agent_kind__key . } }
    OPTIONAL { $this effortless-ntwf:forbiddenDecisionKind ?forbidden_decision_kind . OPTIONAL { ?forbidden_decision_kind effortless-ntwf:__key ?forbidden_decision_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?forbidden_agent_kind__key, IF(isIRI(?forbidden_agent_kind), REPLACE(STR(?forbidden_agent_kind), "^.*[#/]", ""), STR(?forbidden_agent_kind))), ""), " may not ", COALESCE(COALESCE(?forbidden_decision_kind__key, IF(isIRI(?forbidden_decision_kind), REPLACE(STR(?forbidden_decision_kind), "^.*[#/]", ""), STR(?forbidden_decision_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsCurrentlyBinding" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrentlyBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . OPTIONAL { ?valid_to effortless-ntwf:__key ?valid_to__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) && COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentIsValid" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentIsValid ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isCurrentlyValid ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_StepWhenBinding" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepWhenBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_currently_binding, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_BoundaryMatchKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryMatchKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:forbiddenAgentKind ?forbidden_agent_kind . OPTIONAL { ?forbidden_agent_kind effortless-ntwf:__key ?forbidden_agent_kind__key . } }
    OPTIONAL { $this effortless-ntwf:forbiddenDecisionKind ?forbidden_decision_kind . OPTIONAL { ?forbidden_decision_kind effortless-ntwf:__key ?forbidden_decision_kind__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), "|", COALESCE(COALESCE(?forbidden_agent_kind__key, IF(isIRI(?forbidden_agent_kind), REPLACE(STR(?forbidden_agent_kind), "^.*[#/]", ""), STR(?forbidden_agent_kind))), ""), "|", COALESCE(COALESCE(?forbidden_decision_kind__key, IF(isIRI(?forbidden_decision_kind), REPLACE(STR(?forbidden_decision_kind), "^.*[#/]", ""), STR(?forbidden_decision_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_ViolationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:violationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:boundaryMatchKey ?backfk .
                    $this effortless-ntwf:boundaryMatchKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsUntested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUntested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:violationCount ?violation_count . }
                BIND((COALESCE(?is_currently_binding, false) && COALESCE((COALESCE(?violation_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_HasRatifyingFragment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasRatifyingFragment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?ratified_by_knowledge_fragment . OPTIONAL { ?ratified_by_knowledge_fragment effortless-ntwf:__key ?ratified_by_knowledge_fragment__key . } }
                BIND((COALESCE(?ratified_by_knowledge_fragment__key, COALESCE(IF(isIRI(?ratified_by_knowledge_fragment), REPLACE(STR(?ratified_by_knowledge_fragment), "^.*[#/]", ""), STR(?ratified_by_knowledge_fragment)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsUnwarranted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwarranted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:hasRatifyingFragment ?has_ratifying_fragment . }
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:ratifyingFragmentIsValid ?ratifying_fragment_is_valid . }
                BIND((COALESCE(?is_currently_binding, false) && COALESCE((COALESCE((!(COALESCE(?has_ratifying_fragment, false))), false) || COALESCE((!(COALESCE(?ratifying_fragment_is_valid, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentIsOverdue" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentIsOverdue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isOverdueForReview ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentIsSingleWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentIsSingleWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isFromSingleWitness ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_WarrantIsThin" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:warrantIsThin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:ratifyingFragmentIsOverdue ?ratifying_fragment_is_overdue . }
    OPTIONAL { $this effortless-ntwf:ratifyingFragmentIsSingleWitness ?ratifying_fragment_is_single_witness . }
                BIND((COALESCE(?is_currently_binding, false) && COALESCE((COALESCE(?ratifying_fragment_is_overdue, false) || COALESCE(?ratifying_fragment_is_single_witness, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsUnwarrantedAndUntested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwarrantedAndUntested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isUntested ?is_untested . }
    OPTIONAL { $this effortless-ntwf:isUnwarranted ?is_unwarranted . }
                BIND((COALESCE(?is_unwarranted, false) && COALESCE(?is_untested, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_UnwarrantedBoundaryStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unwarrantedBoundaryStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isUnwarranted ?is_unwarranted . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_unwarranted, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?ratified_by_knowledge_fragment . }
                BIND(IF(COALESCE(?is_currently_binding, false), ?ratified_by_knowledge_fragment, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentStatus" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentStatus ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:status ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatificationLapsed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratificationLapsed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:hasRatifyingFragment ?has_ratifying_fragment . }
    OPTIONAL { $this effortless-ntwf:ratifyingFragmentIsValid ?ratifying_fragment_is_valid . }
                BIND((COALESCE(?has_ratifying_fragment, false) && COALESCE((!(COALESCE(?ratifying_fragment_is_valid, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_BindsDespiteLapsedRatification" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:bindsDespiteLapsedRatification ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:ratificationLapsed ?ratification_lapsed . }
                BIND((COALESCE(?is_currently_binding, false) && COALESCE(?ratification_lapsed, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsUngroundedAndUntested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUngroundedAndUntested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:bindsDespiteLapsedRatification ?binds_despite_lapsed_ratification . }
    OPTIONAL { $this effortless-ntwf:isUntested ?is_untested . }
                BIND((COALESCE(?binds_despite_lapsed_ratification, false) && COALESCE(?is_untested, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_ConstrainedRoleAssignmentKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:constrainedRoleAssignmentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:authorityRole ?authority_role . }
    OPTIONAL { $this effortless-ntwf:bindsDespiteLapsedRatification ?binds_despite_lapsed_ratification . }
                BIND(IF(COALESCE(?binds_despite_lapsed_ratification, false), ?authority_role, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for BindingObservations ===
effortless-ntwf:BindingObservationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:BindingObservations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
    OPTIONAL { $this effortless-ntwf:bindingObservationId ?binding_observation_id . OPTIONAL { ?binding_observation_id effortless-ntwf:__key ?binding_observation_id__key . } }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . OPTIONAL { ?step_execution effortless-ntwf:__key ?step_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_execution__key, IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution))), ""), " / ", COALESCE(COALESCE(?binding_observation_id__key, IF(isIRI(?binding_observation_id), REPLACE(STR(?binding_observation_id), "^.*[#/]", ""), STR(?binding_observation_id))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_SlaMinutesAtRun" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:slaMinutesAtRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
                OPTIONAL { $this effortless-ntwf:operationalBinding ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:OperationalBindings ; effortless-ntwf:operationalBindingId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:freshnessSlaMinutes ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_AgeAtRunMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ageAtRunMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
    OPTIONAL { $this effortless-ntwf:observedSourceTimestamp ?observed_source_timestamp . }
    OPTIONAL { $this effortless-ntwf:readAt ?read_at . }
                BIND(ROUND(((((DAY(?read_at) + FLOOR((153 * (MONTH(?read_at) + 12 * FLOOR((14 - MONTH(?read_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) + FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 4) - FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 100) + FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 400) - 32045) - (DAY(?observed_source_timestamp) + FLOOR((153 * (MONTH(?observed_source_timestamp) + 12 * FLOOR((14 - MONTH(?observed_source_timestamp)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) + FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 4) - FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 100) + FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?read_at) * 3600 + MINUTES(?read_at) * 60 + SECONDS(?read_at)) - (HOURS(?observed_source_timestamp) * 3600 + MINUTES(?observed_source_timestamp) * 60 + SECONDS(?observed_source_timestamp))) / 60)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_WasStaleAtRun" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasStaleAtRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
    OPTIONAL { $this effortless-ntwf:ageAtRunMinutes ?age_at_run_minutes . }
    OPTIONAL { $this effortless-ntwf:isAuthoritativeBinding ?is_authoritative_binding . }
    OPTIONAL { $this effortless-ntwf:slaMinutesAtRun ?sla_minutes_at_run . }
                BIND((COALESCE(?is_authoritative_binding, false) && COALESCE((COALESCE(?age_at_run_minutes, 0) > COALESCE(?sla_minutes_at_run, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_IsAuthoritativeBinding" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAuthoritativeBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
                OPTIONAL { $this effortless-ntwf:operationalBinding ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:OperationalBindings ; effortless-ntwf:operationalBindingId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isAuthoritative ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_StaleAtRunStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:staleAtRunStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
    OPTIONAL { $this effortless-ntwf:wasStaleAtRun ?was_stale_at_run . }
                BIND(IF(COALESCE(?was_stale_at_run, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for BusinessOutcomes ===
effortless-ntwf:BusinessOutcomesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:BusinessOutcomes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BusinessOutcomes_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BusinessOutcomes .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BusinessOutcomes_LinkedMeasureCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:linkedMeasureCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BusinessOutcomes .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcessOutcomeMeasures .
                    ?child effortless-ntwf:businessOutcome $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for CapabilityDeclines ===
effortless-ntwf:CapabilityDeclinesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CapabilityDeclines ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CapabilityDeclines_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CapabilityDeclines .
    OPTIONAL { $this effortless-ntwf:organization ?organization . OPTIONAL { ?organization effortless-ntwf:__key ?organization__key . } }
    OPTIONAL { $this effortless-ntwf:stage ?stage . OPTIONAL { ?stage effortless-ntwf:__key ?stage__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?organization__key, IF(isIRI(?organization), REPLACE(STR(?organization), "^.*[#/]", ""), STR(?organization))), ""), ": ", COALESCE(COALESCE(?stage__key, IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CapabilityDeclines_PrecedingStage" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:precedingStage ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CapabilityDeclines .
                OPTIONAL { $this effortless-ntwf:precedingStageDecline ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CapabilityDeclines ; effortless-ntwf:capabilityDeclineId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:stage ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CapabilityDeclines_PrecedingDeclineStartedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:precedingDeclineStartedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CapabilityDeclines .
                OPTIONAL { $this effortless-ntwf:precedingStageDecline ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CapabilityDeclines ; effortless-ntwf:capabilityDeclineId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:declineStartedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CapabilityDeclines_FollowsPrecedingStageDecline" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:followsPrecedingStageDecline ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CapabilityDeclines .
    OPTIONAL { $this effortless-ntwf:declineStartedAt ?decline_started_at . }
    OPTIONAL { $this effortless-ntwf:precedingDeclineStartedAt ?preceding_decline_started_at . }
    OPTIONAL { $this effortless-ntwf:precedingStage ?preceding_stage . OPTIONAL { ?preceding_stage effortless-ntwf:__key ?preceding_stage__key . } }
    OPTIONAL { $this effortless-ntwf:precedingStageDecline ?preceding_stage_decline . OPTIONAL { ?preceding_stage_decline effortless-ntwf:__key ?preceding_stage_decline__key . } }
    OPTIONAL { $this effortless-ntwf:stage ?stage . OPTIONAL { ?stage effortless-ntwf:__key ?stage__key . } }
                BIND((COALESCE((COALESCE(?preceding_stage_decline__key, COALESCE(IF(isIRI(?preceding_stage_decline), REPLACE(STR(?preceding_stage_decline), "^.*[#/]", ""), STR(?preceding_stage_decline)), "")) != ""), false) && COALESCE(COALESCE((?preceding_decline_started_at < ?decline_started_at), false), false) && COALESCE((COALESCE((COALESCE((COALESCE(?stage__key, COALESCE(IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage)), "")) = "EngineerTraining"), false) && COALESCE((COALESCE(?preceding_stage__key, COALESCE(IF(isIRI(?preceding_stage), REPLACE(STR(?preceding_stage), "^.*[#/]", ""), STR(?preceding_stage)), "")) = "FacilityInvestment"), false)), false) || COALESCE((COALESCE((COALESCE(?stage__key, COALESCE(IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage)), "")) = "KnowHowUpkeep"), false) && COALESCE((COALESCE(?preceding_stage__key, COALESCE(IF(isIRI(?preceding_stage), REPLACE(STR(?preceding_stage), "^.*[#/]", ""), STR(?preceding_stage)), "")) = "EngineerTraining"), false)), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CellDisagreements ===
effortless-ntwf:CellDisagreementsShape a sh:NodeShape ;
