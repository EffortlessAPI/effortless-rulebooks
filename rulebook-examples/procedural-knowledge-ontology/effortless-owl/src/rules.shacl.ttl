pko-native-procedural-knowledge-rulebook-shapes:MessageTemplates_TemplateDrawsNoResponse a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    sh:order 5 ;
