                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelCharter ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:ModelCharter . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:governedModel ?j3 . } }
