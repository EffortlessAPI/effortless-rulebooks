pko-native-procedural-knowledge-rulebook-shapes:Organizations_RetainedDepartedKnowHowPercent a sh:NodeShape ;
    sh:targetClass pko-industry:Department ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_RetainedDepartedKnowHowPercent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:retainedDepartedKnowHowPercent ?_result .
            }
            WHERE {
    $this a pko-industry:Department .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:departedHolderKnowHowCount ?departed_holder_know_how_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lostDepartedKnowHowCount ?lost_departed_know_how_count . }
                BIND(IF(COALESCE((COALESCE(?departed_holder_know_how_count, 0) = 0), false), 100, (ROUND(xsd:double((100 * (?departed_holder_know_how_count - ?lost_departed_know_how_count)) / ?departed_holder_know_how_count) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Organizations_MemoryLeavesWithStaff a sh:NodeShape ;
    sh:targetClass pko-industry:Department ;
    sh:order 10 ;
    sh:rule [
