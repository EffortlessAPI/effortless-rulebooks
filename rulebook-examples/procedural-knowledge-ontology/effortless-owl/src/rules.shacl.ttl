                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:RepertoryGridConstruct .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:dimension ?dimension . }
                BIND(?dimension AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RepertoryGridConstructs_Dimension a sh:NodeShape ;
    sh:targetClass pko-extension:RepertoryGridConstruct ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RepertoryGridConstructs_Dimension" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:dimension ?_result .
            }
            WHERE {
    $this a pko-extension:RepertoryGridConstruct .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:poleA ?pole_a . OPTIONAL { ?pole_a erb:key ?pole_a__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:poleB ?pole_b . OPTIONAL { ?pole_b erb:key ?pole_b__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?pole_a__key, IF(isIRI(?pole_a), REPLACE(STR(?pole_a), "^.*[#/]", ""), STR(?pole_a))), ""), " vs ", COALESCE(COALESCE(?pole_b__key, IF(isIRI(?pole_b), REPLACE(STR(?pole_b), "^.*[#/]", ""), STR(?pole_b))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RepertoryGridConstructs_IsNeverStatedDimension a sh:NodeShape ;
    sh:targetClass pko-extension:RepertoryGridConstruct ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RepertoryGridConstructs_IsNeverStatedDimension" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isNeverStatedDimension ?_result .
            }
            WHERE {
    $this a pko-extension:RepertoryGridConstruct .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:poleA ?pole_a . OPTIONAL { ?pole_a erb:key ?pole_a__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wasStatedUnprompted ?was_stated_unprompted . }
                BIND((COALESCE((COALESCE(?pole_a__key, COALESCE(IF(isIRI(?pole_a), REPLACE(STR(?pole_a), "^.*[#/]", ""), STR(?pole_a)), "")) != ""), false) && COALESCE((!(COALESCE(?was_stated_unprompted, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RepertoryGridConstructs_IsRecordedDiscriminatingDimension a sh:NodeShape ;
    sh:targetClass pko-extension:RepertoryGridConstruct ;
