            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnmodifiedForTwelveMonths ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:daysSinceModified ?days_since_modified . }
    OPTIONAL { $this effortless-ntwf:isCurrent ?is_current . }
                BIND((COALESCE(?is_current, false) && COALESCE((COALESCE(?days_since_modified, 0) > 365), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_DesignDecisionCount" ;
