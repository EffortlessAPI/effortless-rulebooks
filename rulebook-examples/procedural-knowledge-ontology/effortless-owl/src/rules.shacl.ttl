    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deliveredAt ?delivered_at . OPTIONAL { ?delivered_at erb:key ?delivered_at__key . } }
                BIND((COALESCE(?delivered_at__key, COALESCE(IF(isIRI(?delivered_at), REPLACE(STR(?delivered_at), "^.*[#/]", ""), STR(?delivered_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] .

