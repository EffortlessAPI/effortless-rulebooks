            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:collectedMaterialCount ?collected_material_count . }
    OPTIONAL { $this effortless-ntwf:inWorkCaptureCount ?in_work_capture_count . }
                BIND((COALESCE((COALESCE(?collected_material_count, 0) > 0), false) && COALESCE((COALESCE(?in_work_capture_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_ExpertAcquisitionHours" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expertAcquisitionHours ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:CollectedSourceMaterials .
                    ?child effortless-ntwf:procedure $this .
                    OPTIONAL { ?child effortless-ntwf:expertEffortHours ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_ComplianceDocumentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:complianceDocumentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Resources .
                    ?child effortless-ntwf:complianceRecordFor $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for ProcessDesignDecisions ===
effortless-ntwf:ProcessDesignDecisionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcessDesignDecisions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessDesignDecisions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessDesignDecisions .
    OPTIONAL { $this effortless-ntwf:decision ?decision . }
                BIND(SUBSTR(STR(?decision), 1, 60) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessDesignDecisions_IsCommitmentWithoutRationale" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCommitmentWithoutRationale ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessDesignDecisions .
    OPTIONAL { $this effortless-ntwf:decision ?decision . OPTIONAL { ?decision effortless-ntwf:__key ?decision__key . } }
    OPTIONAL { $this effortless-ntwf:rationale ?rationale . OPTIONAL { ?rationale effortless-ntwf:__key ?rationale__key . } }
                BIND((COALESCE((COALESCE(?decision__key, COALESCE(IF(isIRI(?decision), REPLACE(STR(?decision), "^.*[#/]", ""), STR(?decision)), "")) != ""), false) && COALESCE((COALESCE(?rationale__key, COALESCE(IF(isIRI(?rationale), REPLACE(STR(?rationale), "^.*[#/]", ""), STR(?rationale)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessDesignDecisions_DaysBeforeRecorded" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysBeforeRecorded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessDesignDecisions .
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . }
    OPTIONAL { $this effortless-ntwf:recordedAt ?recorded_at . }
                BIND(ROUND(((DAY(?recorded_at) + FLOOR((153 * (MONTH(?recorded_at) + 12 * FLOOR((14 - MONTH(?recorded_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?recorded_at) + 4800 - FLOOR((14 - MONTH(?recorded_at)) / 12)) + FLOOR((YEAR(?recorded_at) + 4800 - FLOOR((14 - MONTH(?recorded_at)) / 12)) / 4) - FLOOR((YEAR(?recorded_at) + 4800 - FLOOR((14 - MONTH(?recorded_at)) / 12)) / 100) + FLOOR((YEAR(?recorded_at) + 4800 - FLOOR((14 - MONTH(?recorded_at)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessDesignDecisions_IsRecordedAfterTheFact" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRecordedAfterTheFact ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessDesignDecisions .
    OPTIONAL { $this effortless-ntwf:daysBeforeRecorded ?days_before_recorded . }
                BIND((COALESCE(?days_before_recorded, 0) > 30) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcessInterdependencies ===
effortless-ntwf:ProcessInterdependenciesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcessInterdependencies ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessInterdependencies_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessInterdependencies .
    OPTIONAL { $this effortless-ntwf:effect ?effect . OPTIONAL { ?effect effortless-ntwf:__key ?effect__key . } }
    OPTIONAL { $this effortless-ntwf:fromProcedure ?from_procedure . OPTIONAL { ?from_procedure effortless-ntwf:__key ?from_procedure__key . } }
    OPTIONAL { $this effortless-ntwf:toProcedure ?to_procedure . OPTIONAL { ?to_procedure effortless-ntwf:__key ?to_procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_procedure__key, IF(isIRI(?from_procedure), REPLACE(STR(?from_procedure), "^.*[#/]", ""), STR(?from_procedure))), ""), " ", COALESCE(COALESCE(?effect__key, IF(isIRI(?effect), REPLACE(STR(?effect), "^.*[#/]", ""), STR(?effect))), ""), " ", COALESCE(COALESCE(?to_procedure__key, IF(isIRI(?to_procedure), REPLACE(STR(?to_procedure), "^.*[#/]", ""), STR(?to_procedure))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessInterdependencies_IsHinderingDependency" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isHinderingDependency ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessInterdependencies .
    OPTIONAL { $this effortless-ntwf:effect ?effect . OPTIONAL { ?effect effortless-ntwf:__key ?effect__key . } }
                BIND((COALESCE(?effect__key, COALESCE(IF(isIRI(?effect), REPLACE(STR(?effect), "^.*[#/]", ""), STR(?effect)), "")) = "Hinders") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessInterdependencies_HinderedProcedureKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hinderedProcedureKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessInterdependencies .
    OPTIONAL { $this effortless-ntwf:effect ?effect . OPTIONAL { ?effect effortless-ntwf:__key ?effect__key . } }
    OPTIONAL { $this effortless-ntwf:toProcedure ?to_procedure . }
                BIND(IF(COALESCE((COALESCE(?effect__key, COALESCE(IF(isIRI(?effect), REPLACE(STR(?effect), "^.*[#/]", ""), STR(?effect)), "")) = "Hinders"), false), ?to_procedure, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcessKnowledgeLevels ===
effortless-ntwf:ProcessKnowledgeLevelsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcessKnowledgeLevels ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessKnowledgeLevels_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessKnowledgeLevels .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessKnowledgeLevels_TacitStrategyCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:tacitStrategyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessKnowledgeLevels .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:LevelCaptureStrategies .
                    ?child effortless-ntwf:level $this .
                    OPTIONAL { ?child effortless-ntwf:knowledgeForm ?c2 . }
                    FILTER((STR(?c2) = "Tacit"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessKnowledgeLevels_ExplicitStrategyCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:explicitStrategyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessKnowledgeLevels .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:LevelCaptureStrategies .
                    ?child effortless-ntwf:level $this .
                    OPTIONAL { ?child effortless-ntwf:knowledgeForm ?c2 . }
                    FILTER((STR(?c2) = "Explicit"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessKnowledgeLevels_LacksCaptureStrategyForEitherForm" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lacksCaptureStrategyForEitherForm ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessKnowledgeLevels .
    OPTIONAL { $this effortless-ntwf:explicitStrategyCount ?explicit_strategy_count . }
    OPTIONAL { $this effortless-ntwf:tacitStrategyCount ?tacit_strategy_count . }
                BIND((COALESCE((COALESCE(?tacit_strategy_count, 0) = 0), false) || COALESCE((COALESCE(?explicit_strategy_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcessLevelStatements ===
effortless-ntwf:ProcessLevelStatementsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcessLevelStatements ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessLevelStatements_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessLevelStatements .
    OPTIONAL { $this effortless-ntwf:level ?level . OPTIONAL { ?level effortless-ntwf:__key ?level__key . } }
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . OPTIONAL { ?procedure effortless-ntwf:__key ?procedure__key . } }
    OPTIONAL { $this effortless-ntwf:questionKind ?question_kind . OPTIONAL { ?question_kind effortless-ntwf:__key ?question_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), " ", COALESCE(COALESCE(?level__key, IF(isIRI(?level), REPLACE(STR(?level), "^.*[#/]", ""), STR(?level))), ""), " ", COALESCE(COALESCE(?question_kind__key, IF(isIRI(?question_kind), REPLACE(STR(?question_kind), "^.*[#/]", ""), STR(?question_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessLevelStatements_LevelQuestionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:levelQuestionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessLevelStatements .
    OPTIONAL { $this effortless-ntwf:level ?level . OPTIONAL { ?level effortless-ntwf:__key ?level__key . } }
    OPTIONAL { $this effortless-ntwf:questionKind ?question_kind . OPTIONAL { ?question_kind effortless-ntwf:__key ?question_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?level__key, IF(isIRI(?level), REPLACE(STR(?level), "^.*[#/]", ""), STR(?level))), ""), "|", COALESCE(COALESCE(?question_kind__key, IF(isIRI(?question_kind), REPLACE(STR(?question_kind), "^.*[#/]", ""), STR(?question_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessLevelStatements_PyramidMatchCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:pyramidMatchCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessLevelStatements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:LevelPyramidQuestions .
                    ?child effortless-ntwf:levelPyramidQuestionId ?backfk .
                    $this effortless-ntwf:levelQuestionKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessLevelStatements_IsFiledAtWrongLevel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFiledAtWrongLevel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessLevelStatements .
    OPTIONAL { $this effortless-ntwf:pyramidMatchCount ?pyramid_match_count . }
                BIND((COALESCE(?pyramid_match_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcessMiningRuns ===
effortless-ntwf:ProcessMiningRunsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcessMiningRuns ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:eventLogSource ?event_log_source . OPTIONAL { ?event_log_source effortless-ntwf:__key ?event_log_source__key . } }
    OPTIONAL { $this effortless-ntwf:minedAt ?mined_at . OPTIONAL { ?mined_at effortless-ntwf:__key ?mined_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?event_log_source__key, IF(isIRI(?event_log_source), REPLACE(STR(?event_log_source), "^.*[#/]", ""), STR(?event_log_source))), ""), " / ", COALESCE(REPLACE(COALESCE(?mined_at__key, IF(isIRI(?mined_at), REPLACE(STR(?mined_at), "^.*[#/]", ""), STR(?mined_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_ConformanceRate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:conformanceRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:conformingVariantCount ?conforming_variant_count . }
    OPTIONAL { $this effortless-ntwf:discoveredVariantCount ?discovered_variant_count . }
                BIND(IF(COALESCE((COALESCE(?discovered_variant_count, 0) = 0), false), 0, (?conforming_variant_count / ?discovered_variant_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsConformant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isConformant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:conformanceRate ?conformance_rate . }
                BIND((COALESCE(?conformance_rate, 0) >= 0.8) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_HasMajorDriftFromDocumentation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasMajorDriftFromDocumentation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:conformanceRate ?conformance_rate . }
                BIND((COALESCE(?conformance_rate, 0) < 0.5) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_DaysSinceMined" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceMined ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:minedAt ?mined_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?mined_at) + FLOOR((153 * (MONTH(?mined_at) + 12 * FLOOR((14 - MONTH(?mined_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) + FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 4) - FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 100) + FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsStaleMiningEvidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStaleMiningEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:daysSinceMined ?days_since_mined . }
                BIND((COALESCE(?days_since_mined, 0) > 180) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_ProcedureVersionIsLive" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:procedureVersionIsLive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isLive ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsDriftOnLiveVersion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDriftOnLiveVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:hasMajorDriftFromDocumentation ?has_major_drift_from_documentation . }
    OPTIONAL { $this effortless-ntwf:procedureVersionIsLive ?procedure_version_is_live . }
                BIND((COALESCE(?has_major_drift_from_documentation, false) && COALESCE(?procedure_version_is_live, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_DriftedMiningRunKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:driftedMiningRunKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:isDriftOnLiveVersion ?is_drift_on_live_version . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_drift_on_live_version, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_PeopleCaptureComplementCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:peopleCaptureComplementCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CollectedSourceMaterials .
                    ?child effortless-ntwf:complementsMiningRun $this .
                    OPTIONAL { ?child effortless-ntwf:holdsReasoningOrTacitKnowledge ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsDeviationUnexplainedByPeople" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDeviationUnexplainedByPeople ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:conformingVariantCount ?conforming_variant_count . }
    OPTIONAL { $this effortless-ntwf:discoveredVariantCount ?discovered_variant_count . }
    OPTIONAL { $this effortless-ntwf:peopleCaptureComplementCount ?people_capture_complement_count . }
                BIND((COALESCE((COALESCE(?discovered_variant_count, 0) > COALESCE(?conforming_variant_count, 0)), false) && COALESCE((COALESCE(?people_capture_complement_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_UndocumentedPathCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:undocumentedPathCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MinedFlowEdges .
                    ?child effortless-ntwf:processMiningRun $this .
                    OPTIONAL { ?child effortless-ntwf:isUndocumentedPath ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_HasUndocumentedEnactedPath" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasUndocumentedEnactedPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:undocumentedPathCount ?undocumented_path_count . }
                BIND((COALESCE(?undocumented_path_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcessOutcomeMeasures ===
effortless-ntwf:ProcessOutcomeMeasuresShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcessOutcomeMeasures ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessOutcomeMeasures_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessOutcomeMeasures .
    OPTIONAL { $this effortless-ntwf:label ?label . OPTIONAL { ?label effortless-ntwf:__key ?label__key . } }
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . OPTIONAL { ?procedure effortless-ntwf:__key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), ": ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessOutcomeMeasures_IsUnlinkedToBusinessOutcome" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnlinkedToBusinessOutcome ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessOutcomeMeasures .
    OPTIONAL { $this effortless-ntwf:businessOutcome ?business_outcome . OPTIONAL { ?business_outcome effortless-ntwf:__key ?business_outcome__key . } }
                BIND((COALESCE(?business_outcome__key, COALESCE(IF(isIRI(?business_outcome), REPLACE(STR(?business_outcome), "^.*[#/]", ""), STR(?business_outcome)), "")) = "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcessStages ===
effortless-ntwf:ProcessStagesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcessStages ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessStages_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessStages .
    OPTIONAL { $this effortless-ntwf:label ?label . OPTIONAL { ?label effortless-ntwf:__key ?label__key . } }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version effortless-ntwf:__key ?procedure_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " stage ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessStages_StepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessStages .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:stage $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessStages_OwnerHasNoHolder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ownerHasNoHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessStages .
                OPTIONAL { $this effortless-ntwf:ownerRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:hasNoCurrentHolder ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessStages_IsUnownedOrEmptyStage" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnownedOrEmptyStage ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessStages .
    OPTIONAL { $this effortless-ntwf:ownerHasNoHolder ?owner_has_no_holder . }
    OPTIONAL { $this effortless-ntwf:ownerRole ?owner_role . OPTIONAL { ?owner_role effortless-ntwf:__key ?owner_role__key . } }
    OPTIONAL { $this effortless-ntwf:stepCount ?step_count . }
                BIND((COALESCE((COALESCE(?owner_role__key, COALESCE(IF(isIRI(?owner_role), REPLACE(STR(?owner_role), "^.*[#/]", ""), STR(?owner_role)), "")) = ""), false) || COALESCE(?owner_has_no_holder, false) || COALESCE((COALESCE(?step_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcessStrategicAlignments ===
effortless-ntwf:ProcessStrategicAlignmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcessStrategicAlignments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessStrategicAlignments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessStrategicAlignments .
    OPTIONAL { $this effortless-ntwf:organization ?organization . OPTIONAL { ?organization effortless-ntwf:__key ?organization__key . } }
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . OPTIONAL { ?procedure effortless-ntwf:__key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), " serves ", COALESCE(COALESCE(?organization__key, IF(isIRI(?organization), REPLACE(STR(?organization), "^.*[#/]", ""), STR(?organization))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessStrategicAlignments_StatesNoTradeOff" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:statesNoTradeOff ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessStrategicAlignments .
    OPTIONAL { $this effortless-ntwf:tradeOffs ?trade_offs . OPTIONAL { ?trade_offs effortless-ntwf:__key ?trade_offs__key . } }
                BIND((COALESCE(?trade_offs__key, COALESCE(IF(isIRI(?trade_offs), REPLACE(STR(?trade_offs), "^.*[#/]", ""), STR(?trade_offs)), "")) = "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for PromptTemplates ===
effortless-ntwf:PromptTemplatesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:PromptTemplates ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PromptTemplates_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PromptTemplates .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PromptTemplates_ChildTemplateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:childTemplateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PromptTemplates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:PromptTemplates .
                    ?child effortless-ntwf:parentTemplate $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PromptTemplates_IsDisconnectedPromptKnowledge" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDisconnectedPromptKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PromptTemplates .
    OPTIONAL { $this effortless-ntwf:carriesProcedureInstructions ?carries_procedure_instructions . }
    OPTIONAL { $this effortless-ntwf:sourceProcedureVersion ?source_procedure_version . OPTIONAL { ?source_procedure_version effortless-ntwf:__key ?source_procedure_version__key . } }
                BIND((COALESCE(?carries_procedure_instructions, false) && COALESCE((COALESCE(?source_procedure_version__key, COALESCE(IF(isIRI(?source_procedure_version), REPLACE(STR(?source_procedure_version), "^.*[#/]", ""), STR(?source_procedure_version)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PromptTemplates_IsUnmanagedPromptInUse" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnmanagedPromptInUse ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PromptTemplates .
    OPTIONAL { $this effortless-ntwf:libraryStatus ?library_status . OPTIONAL { ?library_status effortless-ntwf:__key ?library_status__key . } }
    OPTIONAL { $this effortless-ntwf:maintainedByRole ?maintained_by_role . OPTIONAL { ?maintained_by_role effortless-ntwf:__key ?maintained_by_role__key . } }
    OPTIONAL { $this effortless-ntwf:usedByAgent ?used_by_agent . OPTIONAL { ?used_by_agent effortless-ntwf:__key ?used_by_agent__key . } }
                BIND((COALESCE((COALESCE(?used_by_agent__key, COALESCE(IF(isIRI(?used_by_agent), REPLACE(STR(?used_by_agent), "^.*[#/]", ""), STR(?used_by_agent)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?library_status__key, COALESCE(IF(isIRI(?library_status), REPLACE(STR(?library_status), "^.*[#/]", ""), STR(?library_status)), "")) != "Maintained"), false) || COALESCE((COALESCE(?maintained_by_role__key, COALESCE(IF(isIRI(?maintained_by_role), REPLACE(STR(?maintained_by_role), "^.*[#/]", ""), STR(?maintained_by_role)), "")) = ""), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PromptTemplates_SpendsBudgetOnRareDetail" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:spendsBudgetOnRareDetail ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PromptTemplates .
    OPTIONAL { $this effortless-ntwf:estimatedTokens ?estimated_tokens . }
    OPTIONAL { $this effortless-ntwf:includesRareDetail ?includes_rare_detail . }
    OPTIONAL { $this effortless-ntwf:tokenBudget ?token_budget . }
                BIND((COALESCE(?includes_rare_detail, false) && COALESCE((COALESCE(?estimated_tokens, 0) > COALESCE(?token_budget, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PromptTemplates_CondensationPercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:condensationPercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PromptTemplates .
    OPTIONAL { $this effortless-ntwf:estimatedTokens ?estimated_tokens . }
    OPTIONAL { $this effortless-ntwf:sourceTokenCount ?source_token_count . }
                BIND(IF(COALESCE((COALESCE(?source_token_count, 0) = 0), false), 0, (ROUND(((100 * ?estimated_tokens) / ?source_token_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PromptTemplates_IsVerbatimDump" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isVerbatimDump ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PromptTemplates .
    OPTIONAL { $this effortless-ntwf:condensationPercent ?condensation_percent . }
    OPTIONAL { $this effortless-ntwf:sourceTokenCount ?source_token_count . }
                BIND((COALESCE((COALESCE(?source_token_count, 0) > 0), false) && COALESCE((COALESCE(?condensation_percent, 0) >= 90), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProtectiveEquipment ===
effortless-ntwf:ProtectiveEquipmentShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProtectiveEquipment ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProtectiveEquipment_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProtectiveEquipment .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProviderEngagements ===
effortless-ntwf:ProviderEngagementsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProviderEngagements ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
    OPTIONAL { $this effortless-ntwf:clientOrganization ?client_organization . OPTIONAL { ?client_organization effortless-ntwf:__key ?client_organization__key . } }
    OPTIONAL { $this effortless-ntwf:provider ?provider . OPTIONAL { ?provider effortless-ntwf:__key ?provider__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?client_organization__key, IF(isIRI(?client_organization), REPLACE(STR(?client_organization), "^.*[#/]", ""), STR(?client_organization))), ""), " <- ", COALESCE(COALESCE(?provider__key, IF(isIRI(?provider), REPLACE(STR(?provider), "^.*[#/]", ""), STR(?provider))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_IsActive" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isActive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Active") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_ReliedDependencyCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reliedDependencyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeAuditItems .
                    ?child effortless-ntwf:providerHoldingKnowledge ?backfk .
                    $this effortless-ntwf:provider ?backpv .
                    OPTIONAL { ?child effortless-ntwf:clientOrganization ?c2 . }
                    OPTIONAL { $this effortless-ntwf:clientOrganization ?p2 . }
                    OPTIONAL { ?child effortless-ntwf:isKnowledgeDependency ?c4 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(REPLACE(STR(?c2), "^.*[#/]", "") = REPLACE(STR(?p2), "^.*[#/]", ""))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_IsUnplannedKnowledgeReturn" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnplannedKnowledgeReturn ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
    OPTIONAL { $this effortless-ntwf:documentationOwnership ?documentation_ownership . OPTIONAL { ?documentation_ownership effortless-ntwf:__key ?documentation_ownership__key . } }
    OPTIONAL { $this effortless-ntwf:knowledgeReturnPlan ?knowledge_return_plan . OPTIONAL { ?knowledge_return_plan effortless-ntwf:__key ?knowledge_return_plan__key . } }
    OPTIONAL { $this effortless-ntwf:reliedDependencyCount ?relied_dependency_count . }
                BIND((COALESCE((COALESCE(?relied_dependency_count, 0) > 0), false) && COALESCE((COALESCE(?documentation_ownership__key, COALESCE(IF(isIRI(?documentation_ownership), REPLACE(STR(?documentation_ownership), "^.*[#/]", ""), STR(?documentation_ownership)), "")) = "ProviderIP"), false) && COALESCE((COALESCE(?knowledge_return_plan__key, COALESCE(IF(isIRI(?knowledge_return_plan), REPLACE(STR(?knowledge_return_plan), "^.*[#/]", ""), STR(?knowledge_return_plan)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_IsKnowledgeAccessUnsecured" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isKnowledgeAccessUnsecured ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
    OPTIONAL { $this effortless-ntwf:hasKnowledgeAccessClause ?has_knowledge_access_clause . }
    OPTIONAL { $this effortless-ntwf:isActive ?is_active . }
    OPTIONAL { $this effortless-ntwf:reliedDependencyCount ?relied_dependency_count . }
                BIND((COALESCE(?is_active, false) && COALESCE((COALESCE(?relied_dependency_count, 0) > 0), false) && COALESCE((COALESCE(?has_knowledge_access_clause, false) = false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_RequiredDeliverableCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requiredDeliverableCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeDeliverables .
                    ?child effortless-ntwf:providerEngagement $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_ToClientRequiredCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:toClientRequiredCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeDeliverables .
                    ?child effortless-ntwf:providerEngagement $this .
                    OPTIONAL { ?child effortless-ntwf:direction ?c2 . }
                    FILTER((STR(?c2) = "ToClient"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_ToClientDeliveredCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:toClientDeliveredCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeDeliverables .
                    ?child effortless-ntwf:providerEngagement $this .
                    OPTIONAL { ?child effortless-ntwf:direction ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:isDelivered ?c4 . }
                    FILTER((STR(?c2) = "ToClient"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_ToProviderDeliveredCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:toProviderDeliveredCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeDeliverables .
                    ?child effortless-ntwf:providerEngagement $this .
                    OPTIONAL { ?child effortless-ntwf:direction ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:isDelivered ?c4 . }
                    FILTER((STR(?c2) = "ToProvider"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_JointDeliverableCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:jointDeliverableCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeDeliverables .
                    ?child effortless-ntwf:providerEngagement $this .
                    OPTIONAL { ?child effortless-ntwf:direction ?c2 . }
                    FILTER((STR(?c2) = "Joint"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_LacksKnowledgeDeliverables" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lacksKnowledgeDeliverables ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
    OPTIONAL { $this effortless-ntwf:isActive ?is_active . }
    OPTIONAL { $this effortless-ntwf:requiredDeliverableCount ?required_deliverable_count . }
                BIND((COALESCE(?is_active, false) && COALESCE((COALESCE(?required_deliverable_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_IsOneWayLearning" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOneWayLearning ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
    OPTIONAL { $this effortless-ntwf:isActive ?is_active . }
    OPTIONAL { $this effortless-ntwf:requiredDeliverableCount ?required_deliverable_count . }
    OPTIONAL { $this effortless-ntwf:toClientDeliveredCount ?to_client_delivered_count . }
    OPTIONAL { $this effortless-ntwf:toProviderDeliveredCount ?to_provider_delivered_count . }
                BIND((COALESCE(?is_active, false) && COALESCE((COALESCE(?required_deliverable_count, 0) > 0), false) && COALESCE((COALESCE((COALESCE(?to_client_delivered_count, 0) = 0), false) || COALESCE((COALESCE(?to_provider_delivered_count, 0) = 0), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_IsShortTermWithoutJointKnowledge" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isShortTermWithoutJointKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
    OPTIONAL { $this effortless-ntwf:isActive ?is_active . }
    OPTIONAL { $this effortless-ntwf:jointDeliverableCount ?joint_deliverable_count . }
    OPTIONAL { $this effortless-ntwf:termMonths ?term_months . }
                BIND((COALESCE(?is_active, false) && COALESCE((COALESCE(?term_months, 0) < 36), false) && COALESCE((COALESCE(?joint_deliverable_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_ObligesKnowledgeFlowBack" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:obligesKnowledgeFlowBack ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProviderEngagements .
    OPTIONAL { $this effortless-ntwf:knowledgeReturnPlan ?knowledge_return_plan . OPTIONAL { ?knowledge_return_plan effortless-ntwf:__key ?knowledge_return_plan__key . } }
    OPTIONAL { $this effortless-ntwf:toClientRequiredCount ?to_client_required_count . }
                BIND((COALESCE((COALESCE(?to_client_required_count, 0) > 0), false) && COALESCE((COALESCE(?knowledge_return_plan__key, COALESCE(IF(isIRI(?knowledge_return_plan), REPLACE(STR(?knowledge_return_plan), "^.*[#/]", ""), STR(?knowledge_return_plan)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for QualityAssessments ===
effortless-ntwf:QualityAssessmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:QualityAssessments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_QualityAssessments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:QualityAssessments .
    OPTIONAL { $this effortless-ntwf:qualityCriterion ?quality_criterion . OPTIONAL { ?quality_criterion effortless-ntwf:__key ?quality_criterion__key . } }
    OPTIONAL { $this effortless-ntwf:rulebookRelease ?rulebook_release . OPTIONAL { ?rulebook_release effortless-ntwf:__key ?rulebook_release__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?rulebook_release__key, IF(isIRI(?rulebook_release), REPLACE(STR(?rulebook_release), "^.*[#/]", ""), STR(?rulebook_release))), ""), " / ", COALESCE(COALESCE(?quality_criterion__key, IF(isIRI(?quality_criterion), REPLACE(STR(?quality_criterion), "^.*[#/]", ""), STR(?quality_criterion))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for QualityCriteria ===
effortless-ntwf:QualityCriteriaShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:QualityCriteria ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_QualityCriteria_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:QualityCriteria .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_QualityCriteria_AssessmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assessmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:QualityCriteria .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:QualityAssessments .
                    ?child effortless-ntwf:qualityCriterion $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for Rationales ===
effortless-ntwf:RationalesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Rationales ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Rationales_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Rationales .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ReasonerRuns ===
effortless-ntwf:ReasonerRunsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ReasonerRuns ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReasonerRuns_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReasonerRuns .
    OPTIONAL { $this effortless-ntwf:reasonerProfile ?reasoner_profile . OPTIONAL { ?reasoner_profile effortless-ntwf:__key ?reasoner_profile__key . } }
    OPTIONAL { $this effortless-ntwf:snapshot ?snapshot . OPTIONAL { ?snapshot effortless-ntwf:__key ?snapshot__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?snapshot__key, IF(isIRI(?snapshot), REPLACE(STR(?snapshot), "^.*[#/]", ""), STR(?snapshot))), ""), " / ", COALESCE(COALESCE(?reasoner_profile__key, IF(isIRI(?reasoner_profile), REPLACE(STR(?reasoner_profile), "^.*[#/]", ""), STR(?reasoner_profile))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReasonerRuns_IsRichnessTractabilityFailure" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRichnessTractabilityFailure ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReasonerRuns .
    OPTIONAL { $this effortless-ntwf:droppedAxiomCount ?dropped_axiom_count . }
    OPTIONAL { $this effortless-ntwf:durationSeconds ?duration_seconds . }
    OPTIONAL { $this effortless-ntwf:timeBudgetSeconds ?time_budget_seconds . }
                BIND((COALESCE((COALESCE(?duration_seconds, 0) > COALESCE(?time_budget_seconds, 0)), false) || COALESCE((COALESCE(?dropped_axiom_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReasonerRuns_PassesSchemaButFailsReasoner" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:passesSchemaButFailsReasoner ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReasonerRuns .
    OPTIONAL { $this effortless-ntwf:isConsistent ?is_consistent . }
    OPTIONAL { $this effortless-ntwf:schemaValidationPassed ?schema_validation_passed . }
                BIND((COALESCE(?schema_validation_passed, false) && COALESCE((COALESCE(?is_consistent, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Recipients ===
effortless-ntwf:RecipientsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Recipients ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_HasSmsConsent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasSmsConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:smsConsentStatus ?sms_consent_status . OPTIONAL { ?sms_consent_status effortless-ntwf:__key ?sms_consent_status__key . } }
                BIND((COALESCE(?sms_consent_status__key, COALESCE(IF(isIRI(?sms_consent_status), REPLACE(STR(?sms_consent_status), "^.*[#/]", ""), STR(?sms_consent_status)), "")) = "Granted") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsEmailReachable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isEmailReachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:emailAddress ?email_address . OPTIONAL { ?email_address effortless-ntwf:__key ?email_address__key . } }
                BIND((COALESCE(?email_address__key, COALESCE(IF(isIRI(?email_address), REPLACE(STR(?email_address), "^.*[#/]", ""), STR(?email_address)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsSmsReachable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSmsReachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:mobileNumber ?mobile_number . OPTIONAL { ?mobile_number effortless-ntwf:__key ?mobile_number__key . } }
                BIND((COALESCE(?mobile_number__key, COALESCE(IF(isIRI(?mobile_number), REPLACE(STR(?mobile_number), "^.*[#/]", ""), STR(?mobile_number)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsUnreachable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnreachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:isEmailReachable ?is_email_reachable . }
    OPTIONAL { $this effortless-ntwf:isSmsReachable ?is_sms_reachable . }
                BIND((COALESCE((!(COALESCE(?is_email_reachable, false))), false) && COALESCE((!(COALESCE(?is_sms_reachable, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsCommunicationallyStranded" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCommunicationallyStranded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:isEmailReachable ?is_email_reachable . }
    OPTIONAL { $this effortless-ntwf:isSmsReachable ?is_sms_reachable . }
                BIND((COALESCE((!(COALESCE(?is_sms_reachable, false))), false) && COALESCE((!(COALESCE(?is_email_reachable, false))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RecordsRetentionPolicies ===
effortless-ntwf:RecordsRetentionPoliciesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RecordsRetentionPolicies ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RecordsRetentionPolicies_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RecordsRetentionPolicies .
    OPTIONAL { $this effortless-ntwf:recordClass ?record_class . OPTIONAL { ?record_class effortless-ntwf:__key ?record_class__key . } }
    OPTIONAL { $this effortless-ntwf:retentionDriver ?retention_driver . OPTIONAL { ?retention_driver effortless-ntwf:__key ?retention_driver__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?record_class__key, IF(isIRI(?record_class), REPLACE(STR(?record_class), "^.*[#/]", ""), STR(?record_class))), ""), " / ", COALESCE(COALESCE(?retention_driver__key, IF(isIRI(?retention_driver), REPLACE(STR(?retention_driver), "^.*[#/]", ""), STR(?retention_driver))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RecordsRetentionPolicies_ProgramSponsorDiscipline" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:programSponsorDiscipline ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RecordsRetentionPolicies .
                OPTIONAL { $this effortless-ntwf:governanceProgram ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CorporateGovernancePrograms ; effortless-ntwf:corporateGovernanceProgramId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:sponsorDiscipline ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RecordsRetentionPolicies_IsLegalLedKnowledgeDestruction" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLegalLedKnowledgeDestruction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RecordsRetentionPolicies .
    OPTIONAL { $this effortless-ntwf:knowledgeUsefulLifeYears ?knowledge_useful_life_years . }
    OPTIONAL { $this effortless-ntwf:programSponsorDiscipline ?program_sponsor_discipline . OPTIONAL { ?program_sponsor_discipline effortless-ntwf:__key ?program_sponsor_discipline__key . } }
    OPTIONAL { $this effortless-ntwf:retentionDriver ?retention_driver . OPTIONAL { ?retention_driver effortless-ntwf:__key ?retention_driver__key . } }
    OPTIONAL { $this effortless-ntwf:retentionYears ?retention_years . }
                BIND((COALESCE((COALESCE(?program_sponsor_discipline__key, COALESCE(IF(isIRI(?program_sponsor_discipline), REPLACE(STR(?program_sponsor_discipline), "^.*[#/]", ""), STR(?program_sponsor_discipline)), "")) = "Legal"), false) && COALESCE((COALESCE(?retention_driver__key, COALESCE(IF(isIRI(?retention_driver), REPLACE(STR(?retention_driver), "^.*[#/]", ""), STR(?retention_driver)), "")) = "ComplianceRisk"), false) && COALESCE((COALESCE(?retention_years, 0) < COALESCE(?knowledge_useful_life_years, 0)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RegulatoryFrameworks ===
effortless-ntwf:RegulatoryFrameworksShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RegulatoryFrameworks ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RegulatoryFrameworks_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RegulatoryFrameworks .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RegulatoryFrameworks_RequirementCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requirementCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RegulatoryFrameworks .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Requirements .
                    ?child effortless-ntwf:regulatoryFramework $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RegulatoryFrameworks_RequiredProcedureCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requiredProcedureCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RegulatoryFrameworks .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Procedures .
                    ?child effortless-ntwf:requiredByRegulation $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for RelationTypes ===
effortless-ntwf:RelationTypesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RelationTypes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RelationTypes_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RelationTypes .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RelationTypes_UsageCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:usageCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RelationTypes .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ActivityRelations .
                    ?child effortless-ntwf:relationType $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for RepertoryGridConstructs ===
effortless-ntwf:RepertoryGridConstructsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RepertoryGridConstructs ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RepertoryGridConstructs_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RepertoryGridConstructs .
    OPTIONAL { $this effortless-ntwf:dimension ?dimension . }
                BIND(?dimension AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RepertoryGridConstructs_Dimension" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:dimension ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RepertoryGridConstructs .
    OPTIONAL { $this effortless-ntwf:poleA ?pole_a . OPTIONAL { ?pole_a effortless-ntwf:__key ?pole_a__key . } }
    OPTIONAL { $this effortless-ntwf:poleB ?pole_b . OPTIONAL { ?pole_b effortless-ntwf:__key ?pole_b__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?pole_a__key, IF(isIRI(?pole_a), REPLACE(STR(?pole_a), "^.*[#/]", ""), STR(?pole_a))), ""), " vs ", COALESCE(COALESCE(?pole_b__key, IF(isIRI(?pole_b), REPLACE(STR(?pole_b), "^.*[#/]", ""), STR(?pole_b))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RepertoryGridConstructs_IsNeverStatedDimension" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNeverStatedDimension ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RepertoryGridConstructs .
    OPTIONAL { $this effortless-ntwf:poleA ?pole_a . OPTIONAL { ?pole_a effortless-ntwf:__key ?pole_a__key . } }
    OPTIONAL { $this effortless-ntwf:wasStatedUnprompted ?was_stated_unprompted . }
                BIND((COALESCE((COALESCE(?pole_a__key, COALESCE(IF(isIRI(?pole_a), REPLACE(STR(?pole_a), "^.*[#/]", ""), STR(?pole_a)), "")) != ""), false) && COALESCE((!(COALESCE(?was_stated_unprompted, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RepertoryGridConstructs_IsRecordedDiscriminatingDimension" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRecordedDiscriminatingDimension ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RepertoryGridConstructs .
    OPTIONAL { $this effortless-ntwf:poleA ?pole_a . OPTIONAL { ?pole_a effortless-ntwf:__key ?pole_a__key . } }
    OPTIONAL { $this effortless-ntwf:separatesSituations ?separates_situations . }
                BIND((COALESCE((COALESCE(?pole_a__key, COALESCE(IF(isIRI(?pole_a), REPLACE(STR(?pole_a), "^.*[#/]", ""), STR(?pole_a)), "")) != ""), false) && COALESCE(?separates_situations, false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RepresentationReviews ===
effortless-ntwf:RepresentationReviewsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RepresentationReviews ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RepresentationReviews_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RepresentationReviews .
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version effortless-ntwf:__key ?procedure_version__key . } }
    OPTIONAL { $this effortless-ntwf:reviewPurpose ?review_purpose . OPTIONAL { ?review_purpose effortless-ntwf:__key ?review_purpose__key . } }
    OPTIONAL { $this effortless-ntwf:reviewerAgent ?reviewer_agent . OPTIONAL { ?reviewer_agent effortless-ntwf:__key ?reviewer_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?review_purpose__key, IF(isIRI(?review_purpose), REPLACE(STR(?review_purpose), "^.*[#/]", ""), STR(?review_purpose))), ""), ": ", COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " by ", COALESCE(COALESCE(?reviewer_agent__key, IF(isIRI(?reviewer_agent), REPLACE(STR(?reviewer_agent), "^.*[#/]", ""), STR(?reviewer_agent))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RequirementSatisfactions ===
effortless-ntwf:RequirementSatisfactionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RequirementSatisfactions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:requirement ?requirement . OPTIONAL { ?requirement effortless-ntwf:__key ?requirement__key . } }
    OPTIONAL { $this effortless-ntwf:satisfactionLevel ?satisfaction_level . OPTIONAL { ?satisfaction_level effortless-ntwf:__key ?satisfaction_level__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?requirement__key, IF(isIRI(?requirement), REPLACE(STR(?requirement), "^.*[#/]", ""), STR(?requirement))), ""), " / ", COALESCE(COALESCE(?satisfaction_level__key, IF(isIRI(?satisfaction_level), REPLACE(STR(?satisfaction_level), "^.*[#/]", ""), STR(?satisfaction_level))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RequirementIsBlocking" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requirementIsBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isBlocking ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsFullySatisfied" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFullySatisfied ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:satisfactionLevel ?satisfaction_level . OPTIONAL { ?satisfaction_level effortless-ntwf:__key ?satisfaction_level__key . } }
                BIND((COALESCE(?satisfaction_level__key, COALESCE(IF(isIRI(?satisfaction_level), REPLACE(STR(?satisfaction_level), "^.*[#/]", ""), STR(?satisfaction_level)), "")) = "Satisfied") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsBlockingAndUnmet" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBlockingAndUnmet ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
                BIND((COALESCE(?requirement_is_blocking, false) && COALESCE((!(COALESCE(?is_fully_satisfied, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_BlockingUnmetStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:blockingUnmetStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isBlockingAndUnmet ?is_blocking_and_unmet . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_blocking_and_unmet, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
