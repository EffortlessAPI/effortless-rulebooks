            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AiRegistryModelVersion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:dcHasVersion ?dc_has_version . OPTIONAL { ?dc_has_version erb:key ?dc_has_version__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:dcTitle ?dc_title . OPTIONAL { ?dc_title erb:key ?dc_title__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?dc_title__key, IF(isIRI(?dc_title), REPLACE(STR(?dc_title), "^.*[#/]", ""), STR(?dc_title))), ""), " ", COALESCE(COALESCE(?dc_has_version__key, IF(isIRI(?dc_has_version), REPLACE(STR(?dc_has_version), "^.*[#/]", ""), STR(?dc_has_version))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiRegistryModelVersions_GraphIndividualCount a sh:NodeShape ;
    sh:targetClass pko-extension:AiRegistryModelVersion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiRegistryModelVersions_GraphIndividualCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:graphIndividualCount ?_result .
            }
            WHERE {
    $this a pko-extension:AiRegistryModelVersion .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AiRegistryModelVersion .
                    ?child a prov:Agent .
                    ?child pko-native-procedural-knowledge-rulebook:agentId ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:dcIdentifier ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiRegistryModelVersions_LiveProductionDeploymentCount a sh:NodeShape ;
    sh:targetClass pko-extension:AiRegistryModelVersion ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiRegistryModelVersions_LiveProductionDeploymentCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:liveProductionDeploymentCount ?_result .
            }
            WHERE {
    $this a pko-extension:AiRegistryModelVersion .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AiRegistryModelVersion .
                    ?child a pko-extension:AiModelDeployment .
                    ?child pko-native-procedural-knowledge-rulebook:modelVersion $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isLiveInProduction ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiRegistryModelVersions_IsLiveButUnregisteredInGraph a sh:NodeShape ;
    sh:targetClass pko-extension:AiRegistryModelVersion ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiRegistryModelVersions_IsLiveButUnregisteredInGraph" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isLiveButUnregisteredInGraph ?_result .
            }
            WHERE {
    $this a pko-extension:AiRegistryModelVersion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:graphIndividualCount ?graph_individual_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:liveProductionDeploymentCount ?live_production_deployment_count . }
                BIND((COALESCE((COALESCE(?live_production_deployment_count, 0) > 0), false) && COALESCE((COALESCE(?graph_individual_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for AiToolInvocations ===
pko-native-procedural-knowledge-rulebook-shapes:AiToolInvocations_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AiToolInvocation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiToolInvocations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AiToolInvocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:function ?function . OPTIONAL { ?function erb:key ?function__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:invokingAgent ?invoking_agent . OPTIONAL { ?invoking_agent erb:key ?invoking_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?invoking_agent__key, IF(isIRI(?invoking_agent), REPLACE(STR(?invoking_agent), "^.*[#/]", ""), STR(?invoking_agent))), ""), " -> ", COALESCE(COALESCE(?function__key, IF(isIRI(?function), REPLACE(STR(?function), "^.*[#/]", ""), STR(?function))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiToolInvocations_ExecutedStep a sh:NodeShape ;
    sh:targetClass pko-extension:AiToolInvocation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiToolInvocations_ExecutedStep" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:executedStep ?_result .
            }
            WHERE {
    $this a pko-extension:AiToolInvocation .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:StepExecution . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiToolInvocations_DeclaredFunctionCount a sh:NodeShape ;
    sh:targetClass pko-extension:AiToolInvocation ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiToolInvocations_DeclaredFunctionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:declaredFunctionCount ?_result .
            }
            WHERE {
    $this a pko-extension:AiToolInvocation .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AiToolInvocation .
                    ?child a pko-native-procedural-knowledge-rulebook:StepFunctions .
                    ?child pko-native-procedural-knowledge-rulebook:step ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:executedStep ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:function ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:function ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiToolInvocations_IsUndeclaredToolUse a sh:NodeShape ;
    sh:targetClass pko-extension:AiToolInvocation ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiToolInvocations_IsUndeclaredToolUse" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUndeclaredToolUse ?_result .
            }
            WHERE {
    $this a pko-extension:AiToolInvocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:declaredFunctionCount ?declared_function_count . }
                BIND((COALESCE(?declared_function_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiToolInvocations_DeclaredInputCount a sh:NodeShape ;
    sh:targetClass pko-extension:AiToolInvocation ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiToolInvocations_DeclaredInputCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:declaredInputCount ?_result .
            }
            WHERE {
    $this a pko-extension:AiToolInvocation .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:StepExecution . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:stepInputVariableCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiToolInvocations_ActedWithoutDeclaredContext a sh:NodeShape ;
    sh:targetClass pko-extension:AiToolInvocation ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiToolInvocations_ActedWithoutDeclaredContext" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:actedWithoutDeclaredContext ?_result .
            }
            WHERE {
    $this a pko-extension:AiToolInvocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:declaredInputCount ?declared_input_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:suppliedInputCount ?supplied_input_count . }
                BIND((COALESCE((COALESCE(?declared_input_count, 0) > 0), false) && COALESCE((COALESCE(?supplied_input_count, 0) < COALESCE(?declared_input_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for AnswerGroundings ===
pko-native-procedural-knowledge-rulebook-shapes:AnswerGroundings_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:AnswerGroundings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AnswerGroundings_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:AnswerGroundings .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:assistantAnswer ?assistant_answer . OPTIONAL { ?assistant_answer erb:key ?assistant_answer__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:externalSourceUri ?external_source_uri . OPTIONAL { ?external_source_uri erb:key ?external_source_uri__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:retrievalSegment ?retrieval_segment . OPTIONAL { ?retrieval_segment erb:key ?retrieval_segment__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:snapshotAssertion ?snapshot_assertion . OPTIONAL { ?snapshot_assertion erb:key ?snapshot_assertion__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?assistant_answer__key, IF(isIRI(?assistant_answer), REPLACE(STR(?assistant_answer), "^.*[#/]", ""), STR(?assistant_answer))), ""), " <- ", COALESCE(COALESCE(?snapshot_assertion__key, IF(isIRI(?snapshot_assertion), REPLACE(STR(?snapshot_assertion), "^.*[#/]", ""), STR(?snapshot_assertion))), ""), COALESCE(COALESCE(?retrieval_segment__key, IF(isIRI(?retrieval_segment), REPLACE(STR(?retrieval_segment), "^.*[#/]", ""), STR(?retrieval_segment))), ""), COALESCE(COALESCE(?external_source_uri__key, IF(isIRI(?external_source_uri), REPLACE(STR(?external_source_uri), "^.*[#/]", ""), STR(?external_source_uri))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AnswerGroundings_IsFromOwnKnowledge a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:AnswerGroundings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AnswerGroundings_IsFromOwnKnowledge" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFromOwnKnowledge ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:AnswerGroundings .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:externalSourceUri ?external_source_uri . OPTIONAL { ?external_source_uri erb:key ?external_source_uri__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:retrievalSegment ?retrieval_segment . OPTIONAL { ?retrieval_segment erb:key ?retrieval_segment__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:snapshotAssertion ?snapshot_assertion . OPTIONAL { ?snapshot_assertion erb:key ?snapshot_assertion__key . } }
                BIND((COALESCE((COALESCE(?external_source_uri__key, COALESCE(IF(isIRI(?external_source_uri), REPLACE(STR(?external_source_uri), "^.*[#/]", ""), STR(?external_source_uri)), "")) = ""), false) && COALESCE((COALESCE((COALESCE(?snapshot_assertion__key, COALESCE(IF(isIRI(?snapshot_assertion), REPLACE(STR(?snapshot_assertion), "^.*[#/]", ""), STR(?snapshot_assertion)), "")) != ""), false) || COALESCE((COALESCE(?retrieval_segment__key, COALESCE(IF(isIRI(?retrieval_segment), REPLACE(STR(?retrieval_segment), "^.*[#/]", ""), STR(?retrieval_segment)), "")) != ""), false)), false)) AS ?_result)
            }
        """ ;
    ] .
