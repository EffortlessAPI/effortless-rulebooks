pko-native-procedural-knowledge-rulebook-shapes:KnowledgeFragments_HasReviewRecord a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeFragment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_HasReviewRecord" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasReviewRecord ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeFragment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastReviewedAt ?last_reviewed_at . OPTIONAL { ?last_reviewed_at erb:key ?last_reviewed_at__key . } }
                BIND((COALESCE(?last_reviewed_at__key, COALESCE(IF(isIRI(?last_reviewed_at), REPLACE(STR(?last_reviewed_at), "^.*[#/]", ""), STR(?last_reviewed_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeFragments_DaysSinceActualReview a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeFragment ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_DaysSinceActualReview" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceActualReview ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeFragment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasReviewRecord ?has_review_record . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastReviewedAt ?last_reviewed_at . }
                BIND(ROUND(IF(COALESCE(?has_review_record, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_reviewed_at) + FLOOR((153 * (MONTH(?last_reviewed_at) + 12 * FLOOR((14 - MONTH(?last_reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) + FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] .
