            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:approvalStepCount ?_result .
            }
            WHERE {
    $this a pro:Role .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pro:Role .
                    ?child a p-plan:Step .
                    ?child pko-native-procedural-knowledge-rulebook:assignedRole $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:controlKind ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Approval"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for RulebookFields ===
pko-native-procedural-knowledge-rulebook-shapes:RulebookFields_Name a sh:NodeShape ;
    sh:targetClass pko-extension:RulebookField ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:RulebookField .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fieldName ?field_name . OPTIONAL { ?field_name erb:key ?field_name__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetTable_RulebookFields ?target_table . OPTIONAL { ?target_table erb:key ?target_table__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?target_table__key, IF(isIRI(?target_table), REPLACE(STR(?target_table), "^.*[#/]", ""), STR(?target_table))), ""), ".", COALESCE(COALESCE(?field_name__key, IF(isIRI(?field_name), REPLACE(STR(?field_name), "^.*[#/]", ""), STR(?field_name))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RulebookFields_IsDerived a sh:NodeShape ;
    sh:targetClass pko-extension:RulebookField ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_IsDerived" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDerived ?_result .
            }
            WHERE {
    $this a pko-extension:RulebookField .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fieldType ?field_type . OPTIONAL { ?field_type erb:key ?field_type__key . } }
                BIND((COALESCE((COALESCE(?field_type__key, COALESCE(IF(isIRI(?field_type), REPLACE(STR(?field_type), "^.*[#/]", ""), STR(?field_type)), "")) = "calculated"), false) || COALESCE((COALESCE(?field_type__key, COALESCE(IF(isIRI(?field_type), REPLACE(STR(?field_type), "^.*[#/]", ""), STR(?field_type)), "")) = "lookup"), false) || COALESCE((COALESCE(?field_type__key, COALESCE(IF(isIRI(?field_type), REPLACE(STR(?field_type), "^.*[#/]", ""), STR(?field_type)), "")) = "aggregation"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RulebookFields_IsWitness a sh:NodeShape ;
    sh:targetClass pko-extension:RulebookField ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_IsWitness" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isWitness ?_result .
            }
            WHERE {
    $this a pko-extension:RulebookField .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:inventedForQuestion ?invented_for_question . OPTIONAL { ?invented_for_question erb:key ?invented_for_question__key . } }
                BIND((COALESCE(?invented_for_question__key, COALESCE(IF(isIRI(?invented_for_question), REPLACE(STR(?invented_for_question), "^.*[#/]", ""), STR(?invented_for_question)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RulebookFields_DisagreeingSubstrateCount a sh:NodeShape ;
    sh:targetClass pko-extension:RulebookField ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_DisagreeingSubstrateCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:disagreeingSubstrateCount ?_result .
            }
            WHERE {
    $this a pko-extension:RulebookField .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:RulebookField .
                    ?child a pko-extension:FieldDisagreement .
                    ?child pko-native-procedural-knowledge-rulebook:rulebookField $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RulebookFields_IsSubstrateContested a sh:NodeShape ;
    sh:targetClass pko-extension:RulebookField ;
