# === Rules for FieldDisagreements ===
pko-native-procedural-knowledge-rulebook-shapes:FieldDisagreements_Name a sh:NodeShape ;
    sh:targetClass pko-extension:FieldDisagreement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:FieldDisagreement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rulebookField ?rulebook_field . OPTIONAL { ?rulebook_field erb:key ?rulebook_field__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:substrate ?substrate . OPTIONAL { ?substrate erb:key ?substrate__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?substrate__key, IF(isIRI(?substrate), REPLACE(STR(?substrate), "^.*[#/]", ""), STR(?substrate))), ""), " / ", COALESCE(COALESCE(?rulebook_field__key, IF(isIRI(?rulebook_field), REPLACE(STR(?rulebook_field), "^.*[#/]", ""), STR(?rulebook_field))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:FieldDisagreements_SampledCellCount a sh:NodeShape ;
    sh:targetClass pko-extension:FieldDisagreement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_SampledCellCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:sampledCellCount ?_result .
            }
            WHERE {
    $this a pko-extension:FieldDisagreement .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:FieldDisagreement .
                    ?child a pko-extension:CellDisagreement .
                    ?child pko-native-procedural-knowledge-rulebook:fieldDisagreement $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:FieldDisagreements_IsFullySampled a sh:NodeShape ;
    sh:targetClass pko-extension:FieldDisagreement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_IsFullySampled" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFullySampled ?_result .
            }
            WHERE {
    $this a pko-extension:FieldDisagreement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsFailed ?cells_failed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sampledCellCount ?sampled_cell_count . }
                BIND((COALESCE(?sampled_cell_count, 0) = COALESCE(?cells_failed, 0)) AS ?_result)
            }
        """ ;
    ] .
