                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:FragmentCorroboration .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:elicitationSession ?elicitation_session . OPTIONAL { ?elicitation_session erb:key ?elicitation_session__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeFragment ?knowledge_fragment . OPTIONAL { ?knowledge_fragment erb:key ?knowledge_fragment__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?knowledge_fragment__key, IF(isIRI(?knowledge_fragment), REPLACE(STR(?knowledge_fragment), "^.*[#/]", ""), STR(?knowledge_fragment))), ""), " via ", COALESCE(COALESCE(?elicitation_session__key, IF(isIRI(?elicitation_session), REPLACE(STR(?elicitation_session), "^.*[#/]", ""), STR(?elicitation_session))), "")) AS ?_result)
            }
        """ ;
