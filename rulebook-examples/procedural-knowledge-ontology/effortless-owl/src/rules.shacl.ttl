        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeIntegrityChecks .
    OPTIONAL { $this effortless-ntwf:checkKind ?check_kind . OPTIONAL { ?check_kind effortless-ntwf:__key ?check_kind__key . } }
    OPTIONAL { $this effortless-ntwf:modelChangeRequest ?model_change_request . OPTIONAL { ?model_change_request effortless-ntwf:__key ?model_change_request__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_change_request__key, IF(isIRI(?model_change_request), REPLACE(STR(?model_change_request), "^.*[#/]", ""), STR(?model_change_request))), ""), " ", COALESCE(COALESCE(?check_kind__key, IF(isIRI(?check_kind), REPLACE(STR(?check_kind), "^.*[#/]", ""), STR(?check_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeIntegrityChecks_CheckerKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:checkerKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeIntegrityChecks .
                OPTIONAL { $this effortless-ntwf:checkedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ChangeObjections ===
effortless-ntwf:ChangeObjectionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ChangeObjections ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeObjections_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeObjections .
    OPTIONAL { $this effortless-ntwf:modelChangeRequest ?model_change_request . OPTIONAL { ?model_change_request effortless-ntwf:__key ?model_change_request__key . } }
    OPTIONAL { $this effortless-ntwf:raisedByAgent ?raised_by_agent . OPTIONAL { ?raised_by_agent effortless-ntwf:__key ?raised_by_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_change_request__key, IF(isIRI(?model_change_request), REPLACE(STR(?model_change_request), "^.*[#/]", ""), STR(?model_change_request))), ""), " objection by ", COALESCE(COALESCE(?raised_by_agent__key, IF(isIRI(?raised_by_agent), REPLACE(STR(?raised_by_agent), "^.*[#/]", ""), STR(?raised_by_agent))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeObjections_IsUnresolved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnresolved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeObjections .
    OPTIONAL { $this effortless-ntwf:resolvedAt ?resolved_at . OPTIONAL { ?resolved_at effortless-ntwf:__key ?resolved_at__key . } }
                BIND((COALESCE(?resolved_at__key, COALESCE(IF(isIRI(?resolved_at), REPLACE(STR(?resolved_at), "^.*[#/]", ""), STR(?resolved_at)), "")) = "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ChangeRequests ===
effortless-ntwf:ChangeRequestsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ChangeRequests ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsOpen" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOpen ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:implementedAt ?implemented_at . OPTIONAL { ?implemented_at effortless-ntwf:__key ?implemented_at__key . } }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Draft"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "UnderReview"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false)), false) && COALESCE((COALESCE(?implemented_at__key, COALESCE(IF(isIRI(?implemented_at), REPLACE(STR(?implemented_at), "^.*[#/]", ""), STR(?implemented_at)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_OpenChangeVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:openChangeVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isOpen ?is_open . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_open, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsDecided" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDecided ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . OPTIONAL { ?decided_at effortless-ntwf:__key ?decided_at__key . } }
                BIND((COALESCE(?decided_at__key, COALESCE(IF(isIRI(?decided_at), REPLACE(STR(?decided_at), "^.*[#/]", ""), STR(?decided_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
