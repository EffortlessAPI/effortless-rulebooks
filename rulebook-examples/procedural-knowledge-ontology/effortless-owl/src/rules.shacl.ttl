# === Rules for ChangeAuthorityRules ===
pko-native-procedural-knowledge-rulebook-shapes:ChangeAuthorityRules_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeAuthorityRule ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeAuthorityRules_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeAuthorityRule .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:changeLayer ?change_layer . OPTIONAL { ?change_layer erb:key ?change_layer__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:governedModel ?governed_model . OPTIONAL { ?governed_model erb:key ?governed_model__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " ", COALESCE(COALESCE(?change_layer__key, IF(isIRI(?change_layer), REPLACE(STR(?change_layer), "^.*[#/]", ""), STR(?change_layer))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeAuthorityRules_MisroutedRequestCount a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeAuthorityRule ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeAuthorityRules_MisroutedRequestCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:misroutedRequestCount ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeAuthorityRule .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ChangeAuthorityRule .
                    ?child a pko-extension:ModelChangeRequest .
                    ?child pko-native-procedural-knowledge-rulebook:ruleKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:changeAuthorityRuleId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isMisrouted ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeAuthorityRules_IsRuleBypassed a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeAuthorityRule ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeAuthorityRules_IsRuleBypassed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isRuleBypassed ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeAuthorityRule .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:misroutedRequestCount ?misrouted_request_count . }
                BIND((COALESCE(?misrouted_request_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

