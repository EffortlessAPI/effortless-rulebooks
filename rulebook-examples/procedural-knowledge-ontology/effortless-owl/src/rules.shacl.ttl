pko-native-procedural-knowledge-rulebook-shapes:PromptTemplates_ChildTemplateCount a sh:NodeShape ;
    sh:targetClass pko-extension:PromptTemplate ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
