            }
            WHERE {
    $this a pko-extension:ModelChangeRequest .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ModelChangeRequest .
                    ?child a pko-extension:ChangeValidationRun .
                    ?child pko-native-procedural-knowledge-rulebook:modelChangeRequest $this .
