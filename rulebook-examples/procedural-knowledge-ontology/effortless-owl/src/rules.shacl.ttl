    OPTIONAL { $this effortless-ntwf:changeSummary ?change_summary . }
                BIND(CONCAT(COALESCE(COALESCE(?change_operation__key, IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?change_summary), 1, 50)), REPLACE(STR(SUBSTR(STR(?change_summary), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?change_summary), 1, 50))), "")) AS ?_result)
            }
