    $this a p-plan:Step .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepNumber ?step_number . OPTIONAL { ?step_number erb:key ?step_number__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:title ?title . OPTIONAL { ?title erb:key ?title__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_number__key, IF(isIRI(?step_number), REPLACE(STR(?step_number), "^.*[#/]", ""), STR(?step_number))), ""), ". ", COALESCE(COALESCE(?title__key, IF(isIRI(?title), REPLACE(STR(?title), "^.*[#/]", ""), STR(?title))), "")) AS ?_result)
            }
        """ ;
    ] .
