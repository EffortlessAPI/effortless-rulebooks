                $this effortless-ntwf:unrecordedRefusalExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:isUnrecordedRefusal ?is_unrecorded_refusal . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?is_unrecorded_refusal, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_WasDeferredOnTiming" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasDeferredOnTiming ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:contentGatePassed ?content_gate_passed . }
    OPTIONAL { $this effortless-ntwf:permissionGatePassed ?permission_gate_passed . }
    OPTIONAL { $this effortless-ntwf:timingGatePassed ?timing_gate_passed . }
                BIND((COALESCE((!(COALESCE(?timing_gate_passed, false))), false) && COALESCE((COALESCE(?permission_gate_passed, false) && COALESCE(?content_gate_passed, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_WindowHasSinceReopened" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:windowHasSinceReopened ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:evaluatedAt ?evaluated_at . }
    OPTIONAL { $this effortless-ntwf:hoursUntilWindowOpens ?hours_until_window_opens . }
                BIND((COALESCE((COALESCE(?hours_until_window_opens, 0) > 0), false) && COALESCE((COALESCE(((((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?evaluated_at) + FLOOR((153 * (MONTH(?evaluated_at) + 12 * FLOOR((14 - MONTH(?evaluated_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 4) - FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 100) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?as_of_instant) * 3600 + MINUTES(?as_of_instant) * 60 + SECONDS(?as_of_instant)) - (HOURS(?evaluated_at) * 3600 + MINUTES(?evaluated_at) * 60 + SECONDS(?evaluated_at))) / 3600), 0) > COALESCE(?hours_until_window_opens, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_HasRetryAttempt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasRetryAttempt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:retryIntent ?retry_intent . OPTIONAL { ?retry_intent effortless-ntwf:__key ?retry_intent__key . } }
                BIND((COALESCE(?retry_intent__key, COALESCE(IF(isIRI(?retry_intent), REPLACE(STR(?retry_intent), "^.*[#/]", ""), STR(?retry_intent)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RetryWasCleared" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:retryWasCleared ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:retryIntent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:SendIntents ; effortless-ntwf:sendIntentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isClearedToSend ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsAbandonedDeferral" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAbandonedDeferral ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:hasRetryAttempt ?has_retry_attempt . }
    OPTIONAL { $this effortless-ntwf:wasDeferredOnTiming ?was_deferred_on_timing . }
    OPTIONAL { $this effortless-ntwf:windowHasSinceReopened ?window_has_since_reopened . }
                BIND((COALESCE(?was_deferred_on_timing, false) && COALESCE((COALESCE(?window_has_since_reopened, false) && COALESCE((!(COALESCE(?has_retry_attempt, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_DeferralAgeHours" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:deferralAgeHours ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:evaluatedAt ?evaluated_at . }
                BIND(ROUND(((((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?evaluated_at) + FLOOR((153 * (MONTH(?evaluated_at) + 12 * FLOOR((14 - MONTH(?evaluated_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 4) - FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 100) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?as_of_instant) * 3600 + MINUTES(?as_of_instant) * 60 + SECONDS(?as_of_instant)) - (HOURS(?evaluated_at) * 3600 + MINUTES(?evaluated_at) * 60 + SECONDS(?evaluated_at))) / 3600)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsStaleDeferral" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStaleDeferral ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:deferralAgeHours ?deferral_age_hours . }
    OPTIONAL { $this effortless-ntwf:wasDeferredOnTiming ?was_deferred_on_timing . }
                BIND((COALESCE(?was_deferred_on_timing, false) && COALESCE((COALESCE(?deferral_age_hours, 0) > 24), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_EnforcedByUnauthorizedAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:enforcedByUnauthorizedAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:evaluatingRoleAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isUnauthorizedEnforcementAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ConsentInputWasResolvable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:consentInputWasResolvable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:recipientConsentStatusRaw ?recipient_consent_status_raw . OPTIONAL { ?recipient_consent_status_raw effortless-ntwf:__key ?recipient_consent_status_raw__key . } }
                BIND((COALESCE(?recipient_consent_status_raw__key, COALESCE(IF(isIRI(?recipient_consent_status_raw), REPLACE(STR(?recipient_consent_status_raw), "^.*[#/]", ""), STR(?recipient_consent_status_raw)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RecipientConsentStatusRaw" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientConsentStatusRaw ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:smsConsentStatus ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_PolicyInputWasResolvable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyInputWasResolvable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentPolicy ?intent_policy . OPTIONAL { ?intent_policy effortless-ntwf:__key ?intent_policy__key . } }
                BIND((COALESCE(?intent_policy__key, COALESCE(IF(isIRI(?intent_policy), REPLACE(STR(?intent_policy), "^.*[#/]", ""), STR(?intent_policy)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_AllGateInputsResolved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:allGateInputsResolved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:consentInputWasResolvable ?consent_input_was_resolvable . }
    OPTIONAL { $this effortless-ntwf:policyInputWasResolvable ?policy_input_was_resolvable . }
                BIND((COALESCE(?consent_input_was_resolvable, false) && COALESCE(?policy_input_was_resolvable, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsUnevaluableRefusal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnevaluableRefusal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:allGateInputsResolved ?all_gate_inputs_resolved . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
                BIND((COALESCE((!(COALESCE(?is_cleared_to_send, false))), false) && COALESCE((!(COALESCE(?all_gate_inputs_resolved, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsSelfWitnessedDecision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSelfWitnessedDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:gateResultWasIndependentlyConfirmed ?gate_result_was_independently_confirmed . }
                BIND((!(COALESCE(?gate_result_was_independently_confirmed, false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsIndependentlyConfirmed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isIndependentlyConfirmed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:hasResultingDelivery ?has_resulting_delivery . }
    OPTIONAL { $this effortless-ntwf:resultingDeliveryWasTransmitted ?resulting_delivery_was_transmitted . }
                BIND((COALESCE(?has_resulting_delivery, false) && COALESCE(?resulting_delivery_was_transmitted, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IndependentlyConfirmedExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:independentlyConfirmedExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:isIndependentlyConfirmed ?is_independently_confirmed . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?is_independently_confirmed, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SharingRecognitions ===
effortless-ntwf:SharingRecognitionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SharingRecognitions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SharingRecognitions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SharingRecognitions .
    OPTIONAL { $this effortless-ntwf:recognitionKind ?recognition_kind . OPTIONAL { ?recognition_kind effortless-ntwf:__key ?recognition_kind__key . } }
    OPTIONAL { $this effortless-ntwf:recognizedAgent ?recognized_agent . OPTIONAL { ?recognized_agent effortless-ntwf:__key ?recognized_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?recognition_kind__key, IF(isIRI(?recognition_kind), REPLACE(STR(?recognition_kind), "^.*[#/]", ""), STR(?recognition_kind))), ""), ": ", COALESCE(COALESCE(?recognized_agent__key, IF(isIRI(?recognized_agent), REPLACE(STR(?recognized_agent), "^.*[#/]", ""), STR(?recognized_agent))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SituationalVariants ===
effortless-ntwf:SituationalVariantsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SituationalVariants ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SituationalVariants_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SituationalVariants .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SituationalVariants_ScopeDimensionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:scopeDimensionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SituationalVariants .
                OPTIONAL { $this effortless-ntwf:applicabilityScope ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ApplicabilityScopes ; effortless-ntwf:applicabilityScopeId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:dimensionCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SituationalVariants_ScopeStatesConditions" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:scopeStatesConditions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SituationalVariants .
                OPTIONAL { $this effortless-ntwf:applicabilityScope ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ApplicabilityScopes ; effortless-ntwf:applicabilityScopeId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:statesConditions ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SituationalVariants_HasNoApplicabilityDimension" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoApplicabilityDimension ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SituationalVariants .
    OPTIONAL { $this effortless-ntwf:applicabilityScope ?applicability_scope . OPTIONAL { ?applicability_scope effortless-ntwf:__key ?applicability_scope__key . } }
    OPTIONAL { $this effortless-ntwf:scopeDimensionCount ?scope_dimension_count . }
                BIND((COALESCE((COALESCE(?applicability_scope__key, COALESCE(IF(isIRI(?applicability_scope), REPLACE(STR(?applicability_scope), "^.*[#/]", ""), STR(?applicability_scope)), "")) = ""), false) || COALESCE((COALESCE(?scope_dimension_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SituationalVariants_DivergesWithoutStatedConditions" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:divergesWithoutStatedConditions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SituationalVariants .
    OPTIONAL { $this effortless-ntwf:adaptation ?adaptation . OPTIONAL { ?adaptation effortless-ntwf:__key ?adaptation__key . } }
    OPTIONAL { $this effortless-ntwf:applicabilityScope ?applicability_scope . OPTIONAL { ?applicability_scope effortless-ntwf:__key ?applicability_scope__key . } }
    OPTIONAL { $this effortless-ntwf:scopeStatesConditions ?scope_states_conditions . }
                BIND((COALESCE((COALESCE(?adaptation__key, COALESCE(IF(isIRI(?adaptation), REPLACE(STR(?adaptation), "^.*[#/]", ""), STR(?adaptation)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?applicability_scope__key, COALESCE(IF(isIRI(?applicability_scope), REPLACE(STR(?applicability_scope), "^.*[#/]", ""), STR(?applicability_scope)), "")) = ""), false) || COALESCE((COALESCE(?scope_states_conditions, false) = false), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SnapshotAssertions ===
effortless-ntwf:SnapshotAssertionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SnapshotAssertions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SnapshotAssertions .
    OPTIONAL { $this effortless-ntwf:objectValue ?object_value . OPTIONAL { ?object_value effortless-ntwf:__key ?object_value__key . } }
    OPTIONAL { $this effortless-ntwf:predicate ?predicate . OPTIONAL { ?predicate effortless-ntwf:__key ?predicate__key . } }
    OPTIONAL { $this effortless-ntwf:subjectIdentifier ?subject_identifier . OPTIONAL { ?subject_identifier effortless-ntwf:__key ?subject_identifier__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?subject_identifier__key, IF(isIRI(?subject_identifier), REPLACE(STR(?subject_identifier), "^.*[#/]", ""), STR(?subject_identifier))), ""), " ", COALESCE(COALESCE(?predicate__key, IF(isIRI(?predicate), REPLACE(STR(?predicate), "^.*[#/]", ""), STR(?predicate))), ""), " ", COALESCE(COALESCE(?object_value__key, IF(isIRI(?object_value), REPLACE(STR(?object_value), "^.*[#/]", ""), STR(?object_value))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_SourceVersionStatus" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceVersionStatus ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SnapshotAssertions .
                OPTIONAL { $this effortless-ntwf:sourceProcedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:status ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_SourceAssignmentIsCurrent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceAssignmentIsCurrent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SnapshotAssertions .
                OPTIONAL { $this effortless-ntwf:sourceRoleAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isCurrent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_SnapshotConsistentRunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:snapshotConsistentRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SnapshotAssertions .
                OPTIONAL { $this effortless-ntwf:snapshot ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:GroundingSnapshots ; effortless-ntwf:groundingSnapshotId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:consistentReasonerRunCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_SnapshotIsReasoned" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:snapshotIsReasoned ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SnapshotAssertions .
    OPTIONAL { $this effortless-ntwf:snapshotConsistentRunCount ?snapshot_consistent_run_count . }
                BIND((COALESCE(?snapshot_consistent_run_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_IsStaleRoleAssertion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStaleRoleAssertion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SnapshotAssertions .
    OPTIONAL { $this effortless-ntwf:sourceAssignmentIsCurrent ?source_assignment_is_current . }
    OPTIONAL { $this effortless-ntwf:sourceRoleAssignment ?source_role_assignment . OPTIONAL { ?source_role_assignment effortless-ntwf:__key ?source_role_assignment__key . } }
                BIND((COALESCE((COALESCE(?source_role_assignment__key, COALESCE(IF(isIRI(?source_role_assignment), REPLACE(STR(?source_role_assignment), "^.*[#/]", ""), STR(?source_role_assignment)), "")) != ""), false) && COALESCE((COALESCE(?source_assignment_is_current, false) = false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_PresentsDeprecatedAsCurrent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:presentsDeprecatedAsCurrent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SnapshotAssertions .
    OPTIONAL { $this effortless-ntwf:presentedStatus ?presented_status . OPTIONAL { ?presented_status effortless-ntwf:__key ?presented_status__key . } }
    OPTIONAL { $this effortless-ntwf:sourceVersionStatus ?source_version_status . OPTIONAL { ?source_version_status effortless-ntwf:__key ?source_version_status__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?source_version_status__key, COALESCE(IF(isIRI(?source_version_status), REPLACE(STR(?source_version_status), "^.*[#/]", ""), STR(?source_version_status)), "")) = "Deprecated"), false) || COALESCE((COALESCE(?source_version_status__key, COALESCE(IF(isIRI(?source_version_status), REPLACE(STR(?source_version_status), "^.*[#/]", ""), STR(?source_version_status)), "")) = "Archived"), false)), false) && COALESCE((COALESCE(?presented_status__key, COALESCE(IF(isIRI(?presented_status), REPLACE(STR(?presented_status), "^.*[#/]", ""), STR(?presented_status)), "")) = "Current"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_LacksProvenance" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lacksProvenance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SnapshotAssertions .
    OPTIONAL { $this effortless-ntwf:provenanceUri ?provenance_uri . OPTIONAL { ?provenance_uri effortless-ntwf:__key ?provenance_uri__key . } }
    OPTIONAL { $this effortless-ntwf:sourceProcedureVersion ?source_procedure_version . OPTIONAL { ?source_procedure_version effortless-ntwf:__key ?source_procedure_version__key . } }
    OPTIONAL { $this effortless-ntwf:sourceRoleAssignment ?source_role_assignment . OPTIONAL { ?source_role_assignment effortless-ntwf:__key ?source_role_assignment__key . } }
    OPTIONAL { $this effortless-ntwf:sourceStep ?source_step . OPTIONAL { ?source_step effortless-ntwf:__key ?source_step__key . } }
                BIND((COALESCE((COALESCE(?provenance_uri__key, COALESCE(IF(isIRI(?provenance_uri), REPLACE(STR(?provenance_uri), "^.*[#/]", ""), STR(?provenance_uri)), "")) = ""), false) && COALESCE((COALESCE(?source_procedure_version__key, COALESCE(IF(isIRI(?source_procedure_version), REPLACE(STR(?source_procedure_version), "^.*[#/]", ""), STR(?source_procedure_version)), "")) = ""), false) && COALESCE((COALESCE(?source_step__key, COALESCE(IF(isIRI(?source_step), REPLACE(STR(?source_step), "^.*[#/]", ""), STR(?source_step)), "")) = ""), false) && COALESCE((COALESCE(?source_role_assignment__key, COALESCE(IF(isIRI(?source_role_assignment), REPLACE(STR(?source_role_assignment), "^.*[#/]", ""), STR(?source_role_assignment)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_HasOpaqueIdentifier" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasOpaqueIdentifier ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SnapshotAssertions .
    OPTIONAL { $this effortless-ntwf:subjectIdentifier ?subject_identifier . }
                BIND((COALESCE((SUBSTR(STR(?subject_identifier), 1, 9) = "urn:uuid:"), false) || COALESCE((SUBSTR(STR(?subject_identifier), 1, 2) = "_:"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_LacksDublinCore" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lacksDublinCore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SnapshotAssertions .
    OPTIONAL { $this effortless-ntwf:dcDescription ?dc_description . OPTIONAL { ?dc_description effortless-ntwf:__key ?dc_description__key . } }
    OPTIONAL { $this effortless-ntwf:dcTitle ?dc_title . OPTIONAL { ?dc_title effortless-ntwf:__key ?dc_title__key . } }
                BIND((COALESCE((COALESCE(?dc_title__key, COALESCE(IF(isIRI(?dc_title), REPLACE(STR(?dc_title), "^.*[#/]", ""), STR(?dc_title)), "")) = ""), false) || COALESCE((COALESCE(?dc_description__key, COALESCE(IF(isIRI(?dc_description), REPLACE(STR(?dc_description), "^.*[#/]", ""), STR(?dc_description)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SourceArticles ===
effortless-ntwf:SourceArticlesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SourceArticles ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceArticles .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_ClaimCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:claimCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceArticles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ArticleClaims .
                    ?child effortless-ntwf:sourceArticle $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_CoveredClaimCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:coveredClaimCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceArticles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ArticleClaims .
                    ?child effortless-ntwf:sourceArticle $this .
                    OPTIONAL { ?child effortless-ntwf:isCovered ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_AgreedClaimCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agreedClaimCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceArticles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ArticleClaims .
                    ?child effortless-ntwf:sourceArticle $this .
                    OPTIONAL { ?child effortless-ntwf:isAgreed ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_UncoveredClaimCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:uncoveredClaimCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceArticles .
    OPTIONAL { $this effortless-ntwf:claimCount ?claim_count . }
    OPTIONAL { $this effortless-ntwf:coveredClaimCount ?covered_claim_count . }
                BIND(ROUND((?claim_count - ?covered_claim_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_CoveragePercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:coveragePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceArticles .
    OPTIONAL { $this effortless-ntwf:claimCount ?claim_count . }
    OPTIONAL { $this effortless-ntwf:coveredClaimCount ?covered_claim_count . }
                BIND(IF(COALESCE((COALESCE(?claim_count, 0) = 0), false), 0, (ROUND(((100 * ?covered_claim_count) / ?claim_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_AgreedCoveragePercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agreedCoveragePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceArticles .
    OPTIONAL { $this effortless-ntwf:agreedClaimCount ?agreed_claim_count . }
    OPTIONAL { $this effortless-ntwf:claimCount ?claim_count . }
                BIND(IF(COALESCE((COALESCE(?claim_count, 0) = 0), false), 0, (ROUND(((100 * ?agreed_claim_count) / ?claim_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_IsFullyCovered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFullyCovered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceArticles .
    OPTIONAL { $this effortless-ntwf:claimCount ?claim_count . }
    OPTIONAL { $this effortless-ntwf:uncoveredClaimCount ?uncovered_claim_count . }
                BIND((COALESCE((COALESCE(?claim_count, 0) > 0), false) && COALESCE((COALESCE(?uncovered_claim_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SourceRelationships ===
effortless-ntwf:SourceRelationshipsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SourceRelationships ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceRelationships_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceRelationships .
    OPTIONAL { $this effortless-ntwf:knowledgeEngineer ?knowledge_engineer . OPTIONAL { ?knowledge_engineer effortless-ntwf:__key ?knowledge_engineer__key . } }
    OPTIONAL { $this effortless-ntwf:sourceAgent ?source_agent . OPTIONAL { ?source_agent effortless-ntwf:__key ?source_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?knowledge_engineer__key, IF(isIRI(?knowledge_engineer), REPLACE(STR(?knowledge_engineer), "^.*[#/]", ""), STR(?knowledge_engineer))), ""), " with ", COALESCE(COALESCE(?source_agent__key, IF(isIRI(?source_agent), REPLACE(STR(?source_agent), "^.*[#/]", ""), STR(?source_agent))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceRelationships_IsUnnegotiatedPowerGap" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnnegotiatedPowerGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceRelationships .
    OPTIONAL { $this effortless-ntwf:negotiatedAgreement ?negotiated_agreement . OPTIONAL { ?negotiated_agreement effortless-ntwf:__key ?negotiated_agreement__key . } }
    OPTIONAL { $this effortless-ntwf:powerDynamic ?power_dynamic . OPTIONAL { ?power_dynamic effortless-ntwf:__key ?power_dynamic__key . } }
                BIND((COALESCE((COALESCE(?power_dynamic__key, COALESCE(IF(isIRI(?power_dynamic), REPLACE(STR(?power_dynamic), "^.*[#/]", ""), STR(?power_dynamic)), "")) != ""), false) && COALESCE((COALESCE(?power_dynamic__key, COALESCE(IF(isIRI(?power_dynamic), REPLACE(STR(?power_dynamic), "^.*[#/]", ""), STR(?power_dynamic)), "")) != "Balanced"), false) && COALESCE((COALESCE(?negotiated_agreement__key, COALESCE(IF(isIRI(?negotiated_agreement), REPLACE(STR(?negotiated_agreement), "^.*[#/]", ""), STR(?negotiated_agreement)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceRelationships_IsExtractiveRelationship" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isExtractiveRelationship ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceRelationships .
    OPTIONAL { $this effortless-ntwf:trustBuildingPractice ?trust_building_practice . OPTIONAL { ?trust_building_practice effortless-ntwf:__key ?trust_building_practice__key . } }
    OPTIONAL { $this effortless-ntwf:trustLevel ?trust_level . OPTIONAL { ?trust_level effortless-ntwf:__key ?trust_level__key . } }
                BIND((COALESCE((COALESCE(?trust_level__key, COALESCE(IF(isIRI(?trust_level), REPLACE(STR(?trust_level), "^.*[#/]", ""), STR(?trust_level)), "")) != ""), false) && COALESCE((COALESCE(?trust_level__key, COALESCE(IF(isIRI(?trust_level), REPLACE(STR(?trust_level), "^.*[#/]", ""), STR(?trust_level)), "")) != "Established"), false) && COALESCE((COALESCE(?trust_building_practice__key, COALESCE(IF(isIRI(?trust_building_practice), REPLACE(STR(?trust_building_practice), "^.*[#/]", ""), STR(?trust_building_practice)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SourceTermMentions ===
effortless-ntwf:SourceTermMentionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SourceTermMentions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceTermMentions .
    OPTIONAL { $this effortless-ntwf:conceptScheme ?concept_scheme . OPTIONAL { ?concept_scheme effortless-ntwf:__key ?concept_scheme__key . } }
    OPTIONAL { $this effortless-ntwf:wording ?wording . OPTIONAL { ?wording effortless-ntwf:__key ?wording__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?concept_scheme__key, IF(isIRI(?concept_scheme), REPLACE(STR(?concept_scheme), "^.*[#/]", ""), STR(?concept_scheme))), ""), ": ", COALESCE(COALESCE(?wording__key, IF(isIRI(?wording), REPLACE(STR(?wording), "^.*[#/]", ""), STR(?wording))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_WordingKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wordingKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceTermMentions .
    OPTIONAL { $this effortless-ntwf:conceptScheme ?concept_scheme . OPTIONAL { ?concept_scheme effortless-ntwf:__key ?concept_scheme__key . } }
    OPTIONAL { $this effortless-ntwf:wording ?wording . OPTIONAL { ?wording effortless-ntwf:__key ?wording__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?concept_scheme__key, IF(isIRI(?concept_scheme), REPLACE(STR(?concept_scheme), "^.*[#/]", ""), STR(?concept_scheme))), ""), "|", COALESCE(COALESCE(?wording__key, IF(isIRI(?wording), REPLACE(STR(?wording), "^.*[#/]", ""), STR(?wording))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_MatchingLabelCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:matchingLabelCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceTermMentions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TermLabelVariants .
                    ?child effortless-ntwf:wordingKey ?backfk .
                    $this effortless-ntwf:wordingKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_MatchingPrefLabelCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:matchingPrefLabelCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceTermMentions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TermLabelVariants .
                    ?child effortless-ntwf:prefWordingKey ?backfk .
                    $this effortless-ntwf:wordingKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_IsUncontrolledWording" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUncontrolledWording ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceTermMentions .
    OPTIONAL { $this effortless-ntwf:matchingLabelCount ?matching_label_count . }
                BIND((COALESCE(?matching_label_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_IsNonCanonicalGeneratedValue" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNonCanonicalGeneratedValue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceTermMentions .
    OPTIONAL { $this effortless-ntwf:matchingPrefLabelCount ?matching_pref_label_count . }
    OPTIONAL { $this effortless-ntwf:mentionOrigin ?mention_origin . OPTIONAL { ?mention_origin effortless-ntwf:__key ?mention_origin__key . } }
                BIND((COALESCE((COALESCE(?mention_origin__key, COALESCE(IF(isIRI(?mention_origin), REPLACE(STR(?mention_origin), "^.*[#/]", ""), STR(?mention_origin)), "")) = "AIGenerated"), false) && COALESCE((COALESCE(?matching_pref_label_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_IntendedTermRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intendedTermRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceTermMentions .
                OPTIONAL { $this effortless-ntwf:intendedTerm ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:VocabularyTerms ; effortless-ntwf:vocabularyTermId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:representsRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_UnresolvedIntendedTermKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unresolvedIntendedTermKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceTermMentions .
    OPTIONAL { $this effortless-ntwf:intendedTerm ?intended_term . }
    OPTIONAL { $this effortless-ntwf:matchingLabelCount ?matching_label_count . }
                BIND(IF(COALESCE((COALESCE(?matching_label_count, 0) = 0), false), ?intended_term, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_UnresolvedRoleKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unresolvedRoleKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourceTermMentions .
    OPTIONAL { $this effortless-ntwf:intendedTermRole ?intended_term_role . }
    OPTIONAL { $this effortless-ntwf:matchingLabelCount ?matching_label_count . }
                BIND(IF(COALESCE((COALESCE(?matching_label_count, 0) = 0), false), ?intended_term_role, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SourcingFunctions ===
effortless-ntwf:SourcingFunctionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SourcingFunctions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:clientOrganization ?client_organization . OPTIONAL { ?client_organization effortless-ntwf:__key ?client_organization__key . } }
    OPTIONAL { $this effortless-ntwf:label ?label . OPTIONAL { ?label effortless-ntwf:__key ?label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?client_organization__key, IF(isIRI(?client_organization), REPLACE(STR(?client_organization), "^.*[#/]", ""), STR(?client_organization))), ""), ": ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsOutsourced" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOutsourced ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:clientOrganization ?client_organization . }
    OPTIONAL { $this effortless-ntwf:executingOrganization ?executing_organization . }
                BIND(COALESCE((?executing_organization != ?client_organization), !((!BOUND(?executing_organization) || STR(?executing_organization) = "") && (!BOUND(?client_organization) || STR(?client_organization) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsBusinessProcessOutsourcing" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBusinessProcessOutsourcing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:isOutsourced ?is_outsourced . }
    OPTIONAL { $this effortless-ntwf:workNature ?work_nature . OPTIONAL { ?work_nature effortless-ntwf:__key ?work_nature__key . } }
                BIND((COALESCE(?is_outsourced, false) && COALESCE((COALESCE(?work_nature__key, COALESCE(IF(isIRI(?work_nature), REPLACE(STR(?work_nature), "^.*[#/]", ""), STR(?work_nature)), "")) = "Transactional"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsKnowledgeProcessOutsourcing" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isKnowledgeProcessOutsourcing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:isOutsourced ?is_outsourced . }
    OPTIONAL { $this effortless-ntwf:workNature ?work_nature . OPTIONAL { ?work_nature effortless-ntwf:__key ?work_nature__key . } }
                BIND((COALESCE(?is_outsourced, false) && COALESCE((COALESCE(?work_nature__key, COALESCE(IF(isIRI(?work_nature), REPLACE(STR(?work_nature), "^.*[#/]", ""), STR(?work_nature)), "")) = "ExpertiseHeavy"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsVitalExpertiseClassedNonCore" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isVitalExpertiseClassedNonCore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:isStrategicallyVital ?is_strategically_vital . }
    OPTIONAL { $this effortless-ntwf:sourcingClass ?sourcing_class . OPTIONAL { ?sourcing_class effortless-ntwf:__key ?sourcing_class__key . } }
    OPTIONAL { $this effortless-ntwf:workNature ?work_nature . OPTIONAL { ?work_nature effortless-ntwf:__key ?work_nature__key . } }
                BIND((COALESCE((COALESCE(?sourcing_class__key, COALESCE(IF(isIRI(?sourcing_class), REPLACE(STR(?sourcing_class), "^.*[#/]", ""), STR(?sourcing_class)), "")) = "SentOutExecution"), false) && COALESCE(?is_strategically_vital, false) && COALESCE((COALESCE(?work_nature__key, COALESCE(IF(isIRI(?work_nature), REPLACE(STR(?work_nature), "^.*[#/]", ""), STR(?work_nature)), "")) = "ExpertiseHeavy"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsWhatHowSplit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWhatHowSplit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:methodHolder ?method_holder . }
    OPTIONAL { $this effortless-ntwf:specificationHolder ?specification_holder . }
                BIND(COALESCE((?specification_holder != ?method_holder), !((!BOUND(?specification_holder) || STR(?specification_holder) = "") && (!BOUND(?method_holder) || STR(?method_holder) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsMethodKnowledgeHeldOutside" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMethodKnowledgeHeldOutside ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:clientOrganization ?client_organization . }
    OPTIONAL { $this effortless-ntwf:methodHolder ?method_holder . }
                BIND(COALESCE((?method_holder != ?client_organization), !((!BOUND(?method_holder) || STR(?method_holder) = "") && (!BOUND(?client_organization) || STR(?client_organization) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_ClaimsHowWithoutDoing" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:claimsHowWithoutDoing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:clientOrganization ?client_organization . }
    OPTIONAL { $this effortless-ntwf:isOutsourced ?is_outsourced . }
    OPTIONAL { $this effortless-ntwf:methodHolder ?method_holder . }
                BIND((COALESCE(COALESCE((?method_holder = ?client_organization), ((!BOUND(?method_holder) || STR(?method_holder) = "") && (!BOUND(?client_organization) || STR(?client_organization) = ""))), false) && COALESCE(?is_outsourced, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsVitalExpertiseProcess" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isVitalExpertiseProcess ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:isStrategicallyVital ?is_strategically_vital . }
    OPTIONAL { $this effortless-ntwf:workNature ?work_nature . OPTIONAL { ?work_nature effortless-ntwf:__key ?work_nature__key . } }
                BIND((COALESCE(?is_strategically_vital, false) && COALESCE((COALESCE(?work_nature__key, COALESCE(IF(isIRI(?work_nature), REPLACE(STR(?work_nature), "^.*[#/]", ""), STR(?work_nature)), "")) = "ExpertiseHeavy"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsOutsourcedVitalExpertiseProcess" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOutsourcedVitalExpertiseProcess ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:isOutsourced ?is_outsourced . }
    OPTIONAL { $this effortless-ntwf:isVitalExpertiseProcess ?is_vital_expertise_process . }
                BIND((COALESCE(?is_vital_expertise_process, false) && COALESCE(?is_outsourced, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_AuditItemCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:auditItemCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeAuditItems .
                    ?child effortless-ntwf:sourcingFunction $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_DependencyCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:dependencyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeAuditItems .
                    ?child effortless-ntwf:sourcingFunction $this .
                    OPTIONAL { ?child effortless-ntwf:isKnowledgeDependency ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_CoverageGapCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:coverageGapCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeAuditItems .
                    ?child effortless-ntwf:sourcingFunction $this .
                    OPTIONAL { ?child effortless-ntwf:isCoverageGap ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_SpecificationAuditCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:specificationAuditCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeAuditItems .
                    ?child effortless-ntwf:sourcingFunction $this .
                    OPTIONAL { ?child effortless-ntwf:knowledgeKind ?c2 . }
                    FILTER((STR(?c2) = "Specification"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_SpecificationShortfallCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:specificationShortfallCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeAuditItems .
                    ?child effortless-ntwf:sourcingFunction $this .
                    OPTIONAL { ?child effortless-ntwf:knowledgeKind ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:hasInternalShortfall ?c4 . }
                    FILTER((STR(?c2) = "Specification"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_MethodShortfallCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:methodShortfallCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeAuditItems .
                    ?child effortless-ntwf:sourcingFunction $this .
                    OPTIONAL { ?child effortless-ntwf:knowledgeKind ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:hasInternalShortfall ?c4 . }
                    FILTER((STR(?c2) = "Method"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_ProviderIpDocumentationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:providerIpDocumentationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProviderEngagements .
                    ?child effortless-ntwf:sourcingFunction $this .
                    OPTIONAL { ?child effortless-ntwf:documentationOwnership ?c2 . }
                    FILTER((STR(?c2) = "ProviderIP"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_DesignsWhatItCannotBuild" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:designsWhatItCannotBuild ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:deliversOwnProduct ?delivers_own_product . }
    OPTIONAL { $this effortless-ntwf:isOutsourced ?is_outsourced . }
    OPTIONAL { $this effortless-ntwf:methodShortfallCount ?method_shortfall_count . }
    OPTIONAL { $this effortless-ntwf:providerIpDocumentationCount ?provider_ip_documentation_count . }
    OPTIONAL { $this effortless-ntwf:specificationAuditCount ?specification_audit_count . }
    OPTIONAL { $this effortless-ntwf:specificationShortfallCount ?specification_shortfall_count . }
                BIND((COALESCE(?delivers_own_product, false) && COALESCE(?is_outsourced, false) && COALESCE((COALESCE(?provider_ip_documentation_count, 0) > 0), false) && COALESCE((COALESCE(?specification_audit_count, 0) > 0), false) && COALESCE((COALESCE(?specification_shortfall_count, 0) = 0), false) && COALESCE((COALESCE(?method_shortfall_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsUnauditedFunction" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnauditedFunction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:auditItemCount ?audit_item_count . }
    OPTIONAL { $this effortless-ntwf:isOutsourced ?is_outsourced . }
    OPTIONAL { $this effortless-ntwf:isStrategicallyVital ?is_strategically_vital . }
                BIND((COALESCE((COALESCE(?is_outsourced, false) || COALESCE(?is_strategically_vital, false)), false) && COALESCE((COALESCE(?audit_item_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_CaptureInitiativeCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:captureInitiativeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeCaptureInitiatives .
                    ?child effortless-ntwf:sourcingFunction $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsUncapturedPriorityProcess" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUncapturedPriorityProcess ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SourcingFunctions .
    OPTIONAL { $this effortless-ntwf:captureInitiativeCount ?capture_initiative_count . }
    OPTIONAL { $this effortless-ntwf:coverageGapCount ?coverage_gap_count . }
    OPTIONAL { $this effortless-ntwf:isOutsourced ?is_outsourced . }
    OPTIONAL { $this effortless-ntwf:isVitalExpertiseProcess ?is_vital_expertise_process . }
                BIND((COALESCE(?is_vital_expertise_process, false) && COALESCE((COALESCE(?is_outsourced, false) || COALESCE((COALESCE(?coverage_gap_count, 0) > 0), false)), false) && COALESCE((COALESCE(?capture_initiative_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StakeholderLenses ===
effortless-ntwf:StakeholderLensesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StakeholderLenses ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderLenses_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderLenses .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderLenses_GranularityRank" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:granularityRank ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderLenses .
    OPTIONAL { $this effortless-ntwf:requiredGranularity ?required_granularity . OPTIONAL { ?required_granularity effortless-ntwf:__key ?required_granularity__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?required_granularity__key, COALESCE(IF(isIRI(?required_granularity), REPLACE(STR(?required_granularity), "^.*[#/]", ""), STR(?required_granularity)), "")) = "Step"), false), 3, IF(COALESCE((COALESCE(?required_granularity__key, COALESCE(IF(isIRI(?required_granularity), REPLACE(STR(?required_granularity), "^.*[#/]", ""), STR(?required_granularity)), "")) = "Stage"), false), 2, IF(COALESCE((COALESCE(?required_granularity__key, COALESCE(IF(isIRI(?required_granularity), REPLACE(STR(?required_granularity), "^.*[#/]", ""), STR(?required_granularity)), "")) = "Category"), false), 1, 0)))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StakeholderPerspectives ===
effortless-ntwf:StakeholderPerspectivesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StakeholderPerspectives ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderPerspectives_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderPerspectives .
    OPTIONAL { $this effortless-ntwf:holderRole ?holder_role . OPTIONAL { ?holder_role effortless-ntwf:__key ?holder_role__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?holder_role__key, IF(isIRI(?holder_role), REPLACE(STR(?holder_role), "^.*[#/]", ""), STR(?holder_role))), ""), " on ", COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderPerspectives_SourceMaterialKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceMaterialKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderPerspectives .
                OPTIONAL { $this effortless-ntwf:sourceMaterial ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CollectedSourceMaterials ; effortless-ntwf:collectedSourceMaterialId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:materialKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderPerspectives_ConflictPartnerCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:conflictPartnerCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderPerspectives .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StakeholderPerspectives .
                    ?child effortless-ntwf:conflictsWithPerspective $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderPerspectives_IsInConflict" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInConflict ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderPerspectives .
    OPTIONAL { $this effortless-ntwf:conflictPartnerCount ?conflict_partner_count . }
    OPTIONAL { $this effortless-ntwf:conflictsWithPerspective ?conflicts_with_perspective . OPTIONAL { ?conflicts_with_perspective effortless-ntwf:__key ?conflicts_with_perspective__key . } }
                BIND((COALESCE((COALESCE(?conflicts_with_perspective__key, COALESCE(IF(isIRI(?conflicts_with_perspective), REPLACE(STR(?conflicts_with_perspective), "^.*[#/]", ""), STR(?conflicts_with_perspective)), "")) != ""), false) || COALESCE((COALESCE(?conflict_partner_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderPerspectives_IsDissentingViewNotKeptWithSource" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDissentingViewNotKeptWithSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderPerspectives .
    OPTIONAL { $this effortless-ntwf:disposition ?disposition . OPTIONAL { ?disposition effortless-ntwf:__key ?disposition__key . } }
    OPTIONAL { $this effortless-ntwf:isInConflict ?is_in_conflict . }
    OPTIONAL { $this effortless-ntwf:sourceMaterial ?source_material . OPTIONAL { ?source_material effortless-ntwf:__key ?source_material__key . } }
                BIND((COALESCE(?is_in_conflict, false) && COALESCE((COALESCE((COALESCE(?disposition__key, COALESCE(IF(isIRI(?disposition), REPLACE(STR(?disposition), "^.*[#/]", ""), STR(?disposition)), "")) = "OverriddenByConsensus"), false) || COALESCE((COALESCE(?source_material__key, COALESCE(IF(isIRI(?source_material), REPLACE(STR(?source_material), "^.*[#/]", ""), STR(?source_material)), "")) = ""), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StakeholderQuestions ===
effortless-ntwf:StakeholderQuestionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StakeholderQuestions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderQuestions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderQuestions .
    OPTIONAL { $this effortless-ntwf:questionText ?question_text . }
                BIND(SUBSTR(STR(?question_text), 1, 60) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderQuestions_TriagerKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:triagerKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderQuestions .
                OPTIONAL { $this effortless-ntwf:triagedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderQuestions_ResultRoute" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:resultRoute ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderQuestions .
                OPTIONAL { $this effortless-ntwf:resultingChangeRequest ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ModelChangeRequests ; effortless-ntwf:modelChangeRequestId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:route ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderQuestions_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderQuestions .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderQuestions_DaysOpen" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysOpen ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderQuestions .
    OPTIONAL { $this effortless-ntwf:answeredAt ?answered_at . OPTIONAL { ?answered_at effortless-ntwf:__key ?answered_at__key . } }
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:askedAt ?asked_at . }
                BIND(ROUND(IF(COALESCE((COALESCE(?answered_at__key, COALESCE(IF(isIRI(?answered_at), REPLACE(STR(?answered_at), "^.*[#/]", ""), STR(?answered_at)), "")) = ""), false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?asked_at) + FLOOR((153 * (MONTH(?asked_at) + 12 * FLOOR((14 - MONTH(?asked_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?asked_at) + 4800 - FLOOR((14 - MONTH(?asked_at)) / 12)) + FLOOR((YEAR(?asked_at) + 4800 - FLOOR((14 - MONTH(?asked_at)) / 12)) / 4) - FLOOR((YEAR(?asked_at) + 4800 - FLOOR((14 - MONTH(?asked_at)) / 12)) / 100) + FLOOR((YEAR(?asked_at) + 4800 - FLOOR((14 - MONTH(?asked_at)) / 12)) / 400) - 32045)), ((DAY(?answered_at) + FLOOR((153 * (MONTH(?answered_at) + 12 * FLOOR((14 - MONTH(?answered_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?answered_at) + 4800 - FLOOR((14 - MONTH(?answered_at)) / 12)) + FLOOR((YEAR(?answered_at) + 4800 - FLOOR((14 - MONTH(?answered_at)) / 12)) / 4) - FLOOR((YEAR(?answered_at) + 4800 - FLOOR((14 - MONTH(?answered_at)) / 12)) / 100) + FLOOR((YEAR(?answered_at) + 4800 - FLOOR((14 - MONTH(?answered_at)) / 12)) / 400) - 32045) - (DAY(?asked_at) + FLOOR((153 * (MONTH(?asked_at) + 12 * FLOOR((14 - MONTH(?asked_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?asked_at) + 4800 - FLOOR((14 - MONTH(?asked_at)) / 12)) + FLOOR((YEAR(?asked_at) + 4800 - FLOOR((14 - MONTH(?asked_at)) / 12)) / 4) - FLOOR((YEAR(?asked_at) + 4800 - FLOOR((14 - MONTH(?asked_at)) / 12)) / 100) + FLOOR((YEAR(?asked_at) + 4800 - FLOOR((14 - MONTH(?asked_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderQuestions_IsUnansweredPastDue" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnansweredPastDue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderQuestions .
    OPTIONAL { $this effortless-ntwf:answeredAt ?answered_at . OPTIONAL { ?answered_at effortless-ntwf:__key ?answered_at__key . } }
    OPTIONAL { $this effortless-ntwf:daysOpen ?days_open . }
                BIND((COALESCE((COALESCE(?answered_at__key, COALESCE(IF(isIRI(?answered_at), REPLACE(STR(?answered_at), "^.*[#/]", ""), STR(?answered_at)), "")) = ""), false) && COALESCE((COALESCE(?days_open, 0) > 14), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderQuestions_IsUnanswerableToday" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnanswerableToday ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderQuestions .
    OPTIONAL { $this effortless-ntwf:answeringRoleQuestion ?answering_role_question . OPTIONAL { ?answering_role_question effortless-ntwf:__key ?answering_role_question__key . } }
                BIND((COALESCE(?answering_role_question__key, COALESCE(IF(isIRI(?answering_role_question), REPLACE(STR(?answering_role_question), "^.*[#/]", ""), STR(?answering_role_question)), "")) = "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderQuestions_IsUntriagedUnanswerable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUntriagedUnanswerable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderQuestions .
    OPTIONAL { $this effortless-ntwf:isUnanswerableToday ?is_unanswerable_today . }
    OPTIONAL { $this effortless-ntwf:triageOutcome ?triage_outcome . OPTIONAL { ?triage_outcome effortless-ntwf:__key ?triage_outcome__key . } }
                BIND((COALESCE(?is_unanswerable_today, false) && COALESCE((COALESCE(?triage_outcome__key, COALESCE(IF(isIRI(?triage_outcome), REPLACE(STR(?triage_outcome), "^.*[#/]", ""), STR(?triage_outcome)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderQuestions_NeedsStructuralChange" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:needsStructuralChange ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderQuestions .
    OPTIONAL { $this effortless-ntwf:triageOutcome ?triage_outcome . OPTIONAL { ?triage_outcome effortless-ntwf:__key ?triage_outcome__key . } }
                BIND((COALESCE(?triage_outcome__key, COALESCE(IF(isIRI(?triage_outcome), REPLACE(STR(?triage_outcome), "^.*[#/]", ""), STR(?triage_outcome)), "")) = "StructuralChange") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderQuestions_UnanswerableWithoutScopeRequest" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unanswerableWithoutScopeRequest ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderQuestions .
    OPTIONAL { $this effortless-ntwf:isUnanswerableToday ?is_unanswerable_today . }
    OPTIONAL { $this effortless-ntwf:resultingChangeRequest ?resulting_change_request . OPTIONAL { ?resulting_change_request effortless-ntwf:__key ?resulting_change_request__key . } }
                BIND((COALESCE(?is_unanswerable_today, false) && COALESCE((COALESCE(?resulting_change_request__key, COALESCE(IF(isIRI(?resulting_change_request), REPLACE(STR(?resulting_change_request), "^.*[#/]", ""), STR(?resulting_change_request)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderQuestions_IsMisroutedAfterTriage" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMisroutedAfterTriage ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StakeholderQuestions .
    OPTIONAL { $this effortless-ntwf:resultRoute ?result_route . OPTIONAL { ?result_route effortless-ntwf:__key ?result_route__key . } }
    OPTIONAL { $this effortless-ntwf:resultingChangeRequest ?resulting_change_request . OPTIONAL { ?resulting_change_request effortless-ntwf:__key ?resulting_change_request__key . } }
    OPTIONAL { $this effortless-ntwf:triageOutcome ?triage_outcome . OPTIONAL { ?triage_outcome effortless-ntwf:__key ?triage_outcome__key . } }
                BIND((COALESCE((COALESCE(?resulting_change_request__key, COALESCE(IF(isIRI(?resulting_change_request), REPLACE(STR(?resulting_change_request), "^.*[#/]", ""), STR(?resulting_change_request)), "")) != ""), false) && COALESCE((COALESCE((COALESCE((COALESCE(?triage_outcome__key, COALESCE(IF(isIRI(?triage_outcome), REPLACE(STR(?triage_outcome), "^.*[#/]", ""), STR(?triage_outcome)), "")) = "MoreData"), false) && COALESCE((COALESCE(?result_route__key, COALESCE(IF(isIRI(?result_route), REPLACE(STR(?result_route), "^.*[#/]", ""), STR(?result_route)), "")) != "DataOperations"), false)), false) || COALESCE((COALESCE((COALESCE(?triage_outcome__key, COALESCE(IF(isIRI(?triage_outcome), REPLACE(STR(?triage_outcome), "^.*[#/]", ""), STR(?triage_outcome)), "")) != "MoreData"), false) && COALESCE((COALESCE(?triage_outcome__key, COALESCE(IF(isIRI(?triage_outcome), REPLACE(STR(?triage_outcome), "^.*[#/]", ""), STR(?triage_outcome)), "")) != ""), false) && COALESCE((COALESCE(?result_route__key, COALESCE(IF(isIRI(?result_route), REPLACE(STR(?result_route), "^.*[#/]", ""), STR(?result_route)), "")) != "Governance"), false)), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StalenessQueryRuns ===
effortless-ntwf:StalenessQueryRunsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StalenessQueryRuns ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StalenessQueryRuns_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StalenessQueryRuns .
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " staleness run") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StalenessQueryRuns_RunnerKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:runnerKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StalenessQueryRuns .
                OPTIONAL { $this effortless-ntwf:ranByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StalenessQueryRuns_NotSurfacedToSteward" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:notSurfacedToSteward ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StalenessQueryRuns .
    OPTIONAL { $this effortless-ntwf:staleWorkflowCount ?stale_workflow_count . }
    OPTIONAL { $this effortless-ntwf:surfacedToStewardAt ?surfaced_to_steward_at . OPTIONAL { ?surfaced_to_steward_at effortless-ntwf:__key ?surfaced_to_steward_at__key . } }
                BIND((COALESCE((COALESCE(?stale_workflow_count, 0) > 0), false) && COALESCE((COALESCE(?surfaced_to_steward_at__key, COALESCE(IF(isIRI(?surfaced_to_steward_at), REPLACE(STR(?surfaced_to_steward_at), "^.*[#/]", ""), STR(?surfaced_to_steward_at)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepActions ===
effortless-ntwf:StepActionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepActions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepActions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepActions .
    OPTIONAL { $this effortless-ntwf:action ?action . OPTIONAL { ?action effortless-ntwf:__key ?action__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?action__key, IF(isIRI(?action), REPLACE(STR(?action), "^.*[#/]", ""), STR(?action))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepConditions ===
effortless-ntwf:StepConditionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepConditions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepConditions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepConditions .
    OPTIONAL { $this effortless-ntwf:conditionKind ?condition_kind . OPTIONAL { ?condition_kind effortless-ntwf:__key ?condition_kind__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " ", COALESCE(COALESCE(?condition_kind__key, IF(isIRI(?condition_kind), REPLACE(STR(?condition_kind), "^.*[#/]", ""), STR(?condition_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepConditions_CheckCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:checkCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepConditions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ConditionChecks .
                    ?child effortless-ntwf:stepCondition $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepConditions_IsNeverChecked" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNeverChecked ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepConditions .
    OPTIONAL { $this effortless-ntwf:checkCount ?check_count . }
                BIND((COALESCE(?check_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepConditions_PreconditionStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:preconditionStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepConditions .
    OPTIONAL { $this effortless-ntwf:conditionKind ?condition_kind . OPTIONAL { ?condition_kind effortless-ntwf:__key ?condition_kind__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE((COALESCE(?condition_kind__key, COALESCE(IF(isIRI(?condition_kind), REPLACE(STR(?condition_kind), "^.*[#/]", ""), STR(?condition_kind)), "")) = "Precondition"), false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepConditions_PostconditionStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:postconditionStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepConditions .
    OPTIONAL { $this effortless-ntwf:conditionKind ?condition_kind . OPTIONAL { ?condition_kind effortless-ntwf:__key ?condition_kind__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE((COALESCE(?condition_kind__key, COALESCE(IF(isIRI(?condition_kind), REPLACE(STR(?condition_kind), "^.*[#/]", ""), STR(?condition_kind)), "")) = "Postcondition"), false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepConditions_InvariantStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:invariantStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepConditions .
    OPTIONAL { $this effortless-ntwf:conditionKind ?condition_kind . OPTIONAL { ?condition_kind effortless-ntwf:__key ?condition_kind__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE((COALESCE(?condition_kind__key, COALESCE(IF(isIRI(?condition_kind), REPLACE(STR(?condition_kind), "^.*[#/]", ""), STR(?condition_kind)), "")) = "Invariant"), false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepConditions_SafetyCriticalStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:safetyCriticalStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepConditions .
    OPTIONAL { $this effortless-ntwf:isSafetyCritical ?is_safety_critical . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_safety_critical, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepConditions_IsMachineParseable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMachineParseable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepConditions .
    OPTIONAL { $this effortless-ntwf:machineExpression ?machine_expression . OPTIONAL { ?machine_expression effortless-ntwf:__key ?machine_expression__key . } }
                BIND((COALESCE(?machine_expression__key, COALESCE(IF(isIRI(?machine_expression), REPLACE(STR(?machine_expression), "^.*[#/]", ""), STR(?machine_expression)), "")) != "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepContextSensitivities ===
effortless-ntwf:StepContextSensitivitiesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepContextSensitivities ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepContextSensitivities_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepContextSensitivities .
    OPTIONAL { $this effortless-ntwf:contextFactor ?context_factor . OPTIONAL { ?context_factor effortless-ntwf:__key ?context_factor__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?context_factor__key, IF(isIRI(?context_factor), REPLACE(STR(?context_factor), "^.*[#/]", ""), STR(?context_factor))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepContextSensitivities_UnscopedStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unscopedStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepContextSensitivities .
    OPTIONAL { $this effortless-ntwf:applicabilityScope ?applicability_scope . OPTIONAL { ?applicability_scope effortless-ntwf:__key ?applicability_scope__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE((COALESCE(?applicability_scope__key, COALESCE(IF(isIRI(?applicability_scope), REPLACE(STR(?applicability_scope), "^.*[#/]", ""), STR(?applicability_scope)), "")) = ""), false), ?step, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepCues ===
effortless-ntwf:StepCuesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepCues ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepCues_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepCues .
    OPTIONAL { $this effortless-ntwf:cueKind ?cue_kind . OPTIONAL { ?cue_kind effortless-ntwf:__key ?cue_kind__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " ", COALESCE(COALESCE(?cue_kind__key, IF(isIRI(?cue_kind), REPLACE(STR(?cue_kind), "^.*[#/]", ""), STR(?cue_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepCues_ObservationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:observationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepCues .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CueObservations .
                    ?child effortless-ntwf:stepCue $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepCues_UnescalatedObservationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unescalatedObservationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepCues .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CueObservations .
                    ?child effortless-ntwf:unescalatedCueKey ?backfk .
                    $this effortless-ntwf:stepCueId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepCues_DangerCueStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:dangerCueStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepCues .
    OPTIONAL { $this effortless-ntwf:requiresEscalation ?requires_escalation . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?requires_escalation, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepCues_IncompleteCueStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:incompleteCueStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepCues .
    OPTIONAL { $this effortless-ntwf:signalsIncompleteStep ?signals_incomplete_step . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?signals_incomplete_step, false), ?step, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepExecutions ===
effortless-ntwf:StepExecutionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepExecutions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . OPTIONAL { ?procedure_execution effortless-ntwf:__key ?procedure_execution__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_execution__key, IF(isIRI(?procedure_execution), REPLACE(STR(?procedure_execution), "^.*[#/]", ""), STR(?procedure_execution))), ""), " / ", COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ActualDurationMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:actualDurationMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:endedAt ?ended_at . OPTIONAL { ?ended_at effortless-ntwf:__key ?ended_at__key . } }
    OPTIONAL { $this effortless-ntwf:startedAt ?started_at . }
                BIND(ROUND(IF(COALESCE((COALESCE(?ended_at__key, COALESCE(IF(isIRI(?ended_at), REPLACE(STR(?ended_at), "^.*[#/]", ""), STR(?ended_at)), "")) = ""), false), 0, ((((DAY(?ended_at) + FLOOR((153 * (MONTH(?ended_at) + 12 * FLOOR((14 - MONTH(?ended_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 4) - FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 100) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 400) - 32045) - (DAY(?started_at) + FLOOR((153 * (MONTH(?started_at) + 12 * FLOOR((14 - MONTH(?started_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 4) - FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 100) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?ended_at) * 3600 + MINUTES(?ended_at) * 60 + SECONDS(?ended_at)) - (HOURS(?started_at) * 3600 + MINUTES(?started_at) * 60 + SECONDS(?started_at))) / 60))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExpectedDurationMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expectedDurationMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:expectedDurationMinutes ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsLate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:actualDurationMinutes ?actual_duration_minutes . }
    OPTIONAL { $this effortless-ntwf:expectedDurationMinutes ?expected_duration_minutes . }
                BIND((COALESCE(?actual_duration_minutes, 0) > COALESCE(?expected_duration_minutes, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_BlockingUnmetCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:blockingUnmetCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:stepExecution $this .
                    OPTIONAL { ?child effortless-ntwf:isBlockingAndUnmet ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_BlockingUnmetCountSafe" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:blockingUnmetCountSafe ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:blockingUnmetStepKey ?backfk .
                    $this effortless-ntwf:stepExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ProceededPastBlockingControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:proceededPastBlockingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:blockingUnmetCountSafe ?blocking_unmet_count_safe . }
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . OPTIONAL { ?execution_status effortless-ntwf:__key ?execution_status__key . } }
                BIND((COALESCE((COALESCE(?execution_status__key, COALESCE(IF(isIRI(?execution_status), REPLACE(STR(?execution_status), "^.*[#/]", ""), STR(?execution_status)), "")) = "Completed"), false) && COALESCE((COALESCE(?blocking_unmet_count_safe, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExpectedBlockingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expectedBlockingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:blockingRequirementCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_EvaluatedBlockingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:evaluatedBlockingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:blockingSatisfactionStepKey ?backfk .
                    $this effortless-ntwf:stepExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_UnevaluatedBlockingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unevaluatedBlockingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:evaluatedBlockingCount ?evaluated_blocking_count . }
    OPTIONAL { $this effortless-ntwf:expectedBlockingCount ?expected_blocking_count . }
                BIND((?expected_blocking_count - ?evaluated_blocking_count) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasUnevaluatedBlockingControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasUnevaluatedBlockingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:unevaluatedBlockingCount ?unevaluated_blocking_count . }
                BIND((COALESCE(?unevaluated_blocking_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_StaleAuthoritativeSourceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:staleAuthoritativeSourceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:authoritativeStaleCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_RanOnStaleAuthoritativeSource" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ranOnStaleAuthoritativeSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:staleAuthoritativeSourceCount ?stale_authoritative_source_count . }
                BIND((COALESCE(?stale_authoritative_source_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasDeviationNote" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasDeviationNote ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:deviation ?deviation . OPTIONAL { ?deviation effortless-ntwf:__key ?deviation__key . } }
                BIND((COALESCE(?deviation__key, COALESCE(IF(isIRI(?deviation), REPLACE(STR(?deviation), "^.*[#/]", ""), STR(?deviation)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsLateAndUnexplained" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLateAndUnexplained ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:hasDeviationNote ?has_deviation_note . }
    OPTIONAL { $this effortless-ntwf:isLate ?is_late . }
                BIND((COALESCE(?is_late, false) && COALESCE((!(COALESCE(?has_deviation_note, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_AvailableExceptionCountForStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:availableExceptionCountForStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:availableExceptionCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HadUninvokedExceptionAvailable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hadUninvokedExceptionAvailable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:availableExceptionCountForStep ?available_exception_count_for_step . }
    OPTIONAL { $this effortless-ntwf:isLateAndUnexplained ?is_late_and_unexplained . }
                BIND((COALESCE(?is_late_and_unexplained, false) && COALESCE((COALESCE(?available_exception_count_for_step, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExpectedVerificationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expectedVerificationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:declaredVerificationCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_PerformedVerificationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:performedVerificationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:VerificationOutcomes .
                    ?child effortless-ntwf:stepExecution $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_SkippedVerificationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:skippedVerificationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:expectedVerificationCount ?expected_verification_count . }
    OPTIONAL { $this effortless-ntwf:performedVerificationCount ?performed_verification_count . }
                BIND((?expected_verification_count - ?performed_verification_count) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasSkippedVerification" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasSkippedVerification ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:skippedVerificationCount ?skipped_verification_count . }
                BIND((COALESCE(?skipped_verification_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ClaimsPassWithoutEvidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:claimsPassWithoutEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:hasSkippedVerification ?has_skipped_verification . }
    OPTIONAL { $this effortless-ntwf:verificationResult ?verification_result . OPTIONAL { ?verification_result effortless-ntwf:__key ?verification_result__key . } }
                BIND((COALESCE((COALESCE(?verification_result__key, COALESCE(IF(isIRI(?verification_result), REPLACE(STR(?verification_result), "^.*[#/]", ""), STR(?verification_result)), "")) = "PASS"), false) && COALESCE(?has_skipped_verification, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_StepIsPreparation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepIsPreparation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isPreparationStep ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_StepIsApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepIsApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isApprovalStep ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_PreparerAgentKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:preparerAgentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executedByAgent ?executed_by_agent . OPTIONAL { ?executed_by_agent effortless-ntwf:__key ?executed_by_agent__key . } }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . OPTIONAL { ?procedure_execution effortless-ntwf:__key ?procedure_execution__key . } }
    OPTIONAL { $this effortless-ntwf:stepIsPreparation ?step_is_preparation . }
                BIND(IF(COALESCE(?step_is_preparation, false), CONCAT(COALESCE(COALESCE(?procedure_execution__key, IF(isIRI(?procedure_execution), REPLACE(STR(?procedure_execution), "^.*[#/]", ""), STR(?procedure_execution))), ""), "|", COALESCE(COALESCE(?executed_by_agent__key, IF(isIRI(?executed_by_agent), REPLACE(STR(?executed_by_agent), "^.*[#/]", ""), STR(?executed_by_agent))), "")), "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ApproverAgentKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approverAgentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executedByAgent ?executed_by_agent . OPTIONAL { ?executed_by_agent effortless-ntwf:__key ?executed_by_agent__key . } }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . OPTIONAL { ?procedure_execution effortless-ntwf:__key ?procedure_execution__key . } }
    OPTIONAL { $this effortless-ntwf:stepIsApproval ?step_is_approval . }
                BIND(IF(COALESCE(?step_is_approval, false), CONCAT(COALESCE(COALESCE(?procedure_execution__key, IF(isIRI(?procedure_execution), REPLACE(STR(?procedure_execution), "^.*[#/]", ""), STR(?procedure_execution))), ""), "|", COALESCE(COALESCE(?executed_by_agent__key, IF(isIRI(?executed_by_agent), REPLACE(STR(?executed_by_agent), "^.*[#/]", ""), STR(?executed_by_agent))), "")), "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_PreparedByThisAgentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:preparedByThisAgentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:preparerAgentKey ?backfk .
                    $this effortless-ntwf:approverAgentKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ViolatesSeparationOfDuties" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:violatesSeparationOfDuties ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:preparedByThisAgentCount ?prepared_by_this_agent_count . }
    OPTIONAL { $this effortless-ntwf:stepIsApproval ?step_is_approval . }
                BIND((COALESCE(?step_is_approval, false) && COALESCE((COALESCE(?prepared_by_this_agent_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_RequiredRoleForStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requiredRoleForStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:assignedRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExecutorRoleKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:executorRoleKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executedByAgent ?executed_by_agent . OPTIONAL { ?executed_by_agent effortless-ntwf:__key ?executed_by_agent__key . } }
    OPTIONAL { $this effortless-ntwf:requiredRoleForStep ?required_role_for_step . OPTIONAL { ?required_role_for_step effortless-ntwf:__key ?required_role_for_step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?executed_by_agent__key, IF(isIRI(?executed_by_agent), REPLACE(STR(?executed_by_agent), "^.*[#/]", ""), STR(?executed_by_agent))), ""), "|", COALESCE(COALESCE(?required_role_for_step__key, IF(isIRI(?required_role_for_step), REPLACE(STR(?required_role_for_step), "^.*[#/]", ""), STR(?required_role_for_step))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExecutorAuthorityCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:executorAuthorityCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:agentRoleKey ?backfk .
                    $this effortless-ntwf:executorRoleKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExecutorHeldRequiredRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:executorHeldRequiredRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executorAuthorityCount ?executor_authority_count . }
                BIND((COALESCE(?executor_authority_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsUnauthorizedApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnauthorizedApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executorHeldRequiredRole ?executor_held_required_role . }
    OPTIONAL { $this effortless-ntwf:stepIsApproval ?step_is_approval . }
                BIND((COALESCE(?step_is_approval, false) && COALESCE((!(COALESCE(?executor_held_required_role, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_CompletedExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:completedExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . OPTIONAL { ?execution_status effortless-ntwf:__key ?execution_status__key . } }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE((COALESCE(?execution_status__key, COALESCE(IF(isIRI(?execution_status), REPLACE(STR(?execution_status), "^.*[#/]", ""), STR(?execution_status)), "")) = "Completed"), false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ControlBreachExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:controlBreachExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:claimsPassWithoutEvidence ?claims_pass_without_evidence . }
    OPTIONAL { $this effortless-ntwf:isUnauthorizedApproval ?is_unauthorized_approval . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
    OPTIONAL { $this effortless-ntwf:proceededPastBlockingControl ?proceeded_past_blocking_control . }
    OPTIONAL { $this effortless-ntwf:violatesSeparationOfDuties ?violates_separation_of_duties . }
                BIND(IF(COALESCE((COALESCE(?proceeded_past_blocking_control, false) || COALESCE(?violates_separation_of_duties, false) || COALESCE(?is_unauthorized_approval, false) || COALESCE(?claims_pass_without_evidence, false)), false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_LateExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lateExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:isLate ?is_late . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?is_late, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExecutorAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:executorAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:executedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExecutorIsHuman" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:executorIsHuman ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executorAgentKind ?executor_agent_kind . OPTIONAL { ?executor_agent_kind effortless-ntwf:__key ?executor_agent_kind__key . } }
                BIND((COALESCE(?executor_agent_kind__key, COALESCE(IF(isIRI(?executor_agent_kind), REPLACE(STR(?executor_agent_kind), "^.*[#/]", ""), STR(?executor_agent_kind)), "")) = "Human") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_StepRequiresHumanConfirmation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepRequiresHumanConfirmation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:requiresHumanConfirmation ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_NonHumanRanHumanStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:nonHumanRanHumanStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executorIsHuman ?executor_is_human . }
    OPTIONAL { $this effortless-ntwf:stepRequiresHumanConfirmation ?step_requires_human_confirmation . }
                BIND((COALESCE(?step_requires_human_confirmation, false) && COALESCE((!(COALESCE(?executor_is_human, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_NonHumanApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:nonHumanApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executorIsHuman ?executor_is_human . }
    OPTIONAL { $this effortless-ntwf:stepIsApproval ?step_is_approval . }
                BIND((COALESCE(?step_is_approval, false) && COALESCE((!(COALESCE(?executor_is_human, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
