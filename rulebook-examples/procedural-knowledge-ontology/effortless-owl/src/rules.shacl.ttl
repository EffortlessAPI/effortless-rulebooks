pko-native-procedural-knowledge-rulebook-shapes:Procedures_HasTransferShortfallExposure a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_HasTransferShortfallExposure" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasTransferShortfallExposure ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Procedures .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:departingVeteranKnowHowCount ?departing_veteran_know_how_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recentStarterCount ?recent_starter_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:untransferredVeteranKnowHowCount ?untransferred_veteran_know_how_count . }
                BIND((COALESCE((COALESCE((COALESCE(?recent_starter_count, 0) >= 3), false) && COALESCE((COALESCE(?untransferred_veteran_know_how_count, 0) > 0), false)), false) || COALESCE((COALESCE(?departing_veteran_know_how_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Procedures_ProficientWithCaptureCount a sh:NodeShape ;
