    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executionVersion ?execution_version . }
    OPTIONAL { $this effortless-ntwf:versionOfStep ?version_of_step . }
                BIND(COALESCE((?version_of_step != ?execution_version), !((!BOUND(?version_of_step) || STR(?version_of_step) = "") && (!BOUND(?execution_version) || STR(?execution_version) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_RepetitionCount" ;
