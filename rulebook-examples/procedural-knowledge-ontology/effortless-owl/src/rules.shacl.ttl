    OPTIONAL { $this effortless-ntwf:holderTenureYears ?holder_tenure_years . }
                BIND((COALESCE((COALESCE(?holder_agent__key, COALESCE(IF(isIRI(?holder_agent), REPLACE(STR(?holder_agent), "^.*[#/]", ""), STR(?holder_agent)), "")) != ""), false) && COALESCE((COALESCE(?holder_tenure_years, 0) >= 10), false)) AS ?_result)
