            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:higherAccessMoreSatisfied ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeOutcomeMeasurement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:baselineAccessScore ?baseline_access_score . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:baselineSatisfaction ?baseline_satisfaction . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:comparisonBaseline ?comparison_baseline . OPTIONAL { ?comparison_baseline erb:key ?comparison_baseline__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeAccessScore ?knowledge_access_score . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:satisfactionScore ?satisfaction_score . }
                BIND((COALESCE((COALESCE(?comparison_baseline__key, COALESCE(IF(isIRI(?comparison_baseline), REPLACE(STR(?comparison_baseline), "^.*[#/]", ""), STR(?comparison_baseline)), "")) != ""), false) && COALESCE((COALESCE(?knowledge_access_score, 0) > COALESCE(?baseline_access_score, 0)), false) && COALESCE((COALESCE(?satisfaction_score, 0) > COALESCE(?baseline_satisfaction, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeOutcomeMeasurements_IsUnactedAdverseOutcome a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeOutcomeMeasurement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_IsUnactedAdverseOutcome" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnactedAdverseOutcome ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeOutcomeMeasurement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:errorRatePercent ?error_rate_percent . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:informedChangeRequest ?informed_change_request . OPTIONAL { ?informed_change_request erb:key ?informed_change_request__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:informedInvestmentDecision ?informed_investment_decision . OPTIONAL { ?informed_investment_decision erb:key ?informed_investment_decision__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetErrorRatePercent ?target_error_rate_percent . }
                BIND((COALESCE((COALESCE(?error_rate_percent, 0) > COALESCE(?target_error_rate_percent, 0)), false) && COALESCE((COALESCE(?informed_change_request__key, COALESCE(IF(isIRI(?informed_change_request), REPLACE(STR(?informed_change_request), "^.*[#/]", ""), STR(?informed_change_request)), "")) = ""), false) && COALESCE((COALESCE(?informed_investment_decision__key, COALESCE(IF(isIRI(?informed_investment_decision), REPLACE(STR(?informed_investment_decision), "^.*[#/]", ""), STR(?informed_investment_decision)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeOutcomeMeasurements_IsGainOutsideProceduralScope a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeOutcomeMeasurement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_IsGainOutsideProceduralScope" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isGainOutsideProceduralScope ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeOutcomeMeasurement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:efficiencyGainPercent ?efficiency_gain_percent . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeScope ?knowledge_scope . OPTIONAL { ?knowledge_scope erb:key ?knowledge_scope__key . } }
                BIND((COALESCE((COALESCE(?efficiency_gain_percent, 0) > 0), false) && COALESCE((COALESCE(?knowledge_scope__key, COALESCE(IF(isIRI(?knowledge_scope), REPLACE(STR(?knowledge_scope), "^.*[#/]", ""), STR(?knowledge_scope)), "")) != "Procedural"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for KnowledgeProjections ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeProjections_Name a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeProjection ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeProjections_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeProjection .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeProjections_VersionModifiedAt a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeProjection ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeProjections_VersionModifiedAt" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:versionModifiedAt ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeProjection .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:ProcedureVersions . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:modifiedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeProjections_OpenCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeProjection ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeProjections_OpenCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:openCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeProjection .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:KnowledgeProjection .
                    ?child a pko-extension:KnowledgeSearchEvent .
                    ?child pko-native-procedural-knowledge-rulebook:openedProjection $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeProjections_DiagramCanDivergeFromModel a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeProjection ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeProjections_DiagramCanDivergeFromModel" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:diagramCanDivergeFromModel ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeProjection .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:generatedAt ?generated_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:generatedByTool ?generated_by_tool . OPTIONAL { ?generated_by_tool erb:key ?generated_by_tool__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:projectionKind ?projection_kind . OPTIONAL { ?projection_kind erb:key ?projection_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:versionModifiedAt ?version_modified_at . }
                BIND((COALESCE((COALESCE(?projection_kind__key, COALESCE(IF(isIRI(?projection_kind), REPLACE(STR(?projection_kind), "^.*[#/]", ""), STR(?projection_kind)), "")) = "Diagram"), false) && COALESCE((COALESCE((COALESCE(?generated_by_tool__key, COALESCE(IF(isIRI(?generated_by_tool), REPLACE(STR(?generated_by_tool), "^.*[#/]", ""), STR(?generated_by_tool)), "")) = ""), false) || COALESCE(COALESCE((?generated_at < ?version_modified_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
