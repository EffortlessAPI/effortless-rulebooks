    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ApprovalRestsOnSelfAttestation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approvalRestsOnSelfAttestation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:hasSkippedVerification ?has_skipped_verification . }
    OPTIONAL { $this effortless-ntwf:selfWitnessedVerificationCount ?self_witnessed_verification_count . }
    OPTIONAL { $this effortless-ntwf:stepIsApproval ?step_is_approval . }
                BIND((COALESCE(?step_is_approval, false) && COALESCE((COALESCE((COALESCE(?self_witnessed_verification_count, 0) > 0), false) || COALESCE(?has_skipped_verification, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExceptionInvocationCount" ;
        sh:prefixes effortless-ntwf: ;
