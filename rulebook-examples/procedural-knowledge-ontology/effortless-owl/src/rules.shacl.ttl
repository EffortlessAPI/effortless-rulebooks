    OPTIONAL { $this effortless-ntwf:reviewOutcome ?review_outcome . OPTIONAL { ?review_outcome effortless-ntwf:__key ?review_outcome__key . } }
                BIND((COALESCE((COALESCE(?proposal_kind__key, COALESCE(IF(isIRI(?proposal_kind), REPLACE(STR(?proposal_kind), "^.*[#/]", ""), STR(?proposal_kind)), "")) = "Alignment"), false) && COALESCE((COALESCE(?review_outcome__key, COALESCE(IF(isIRI(?review_outcome), REPLACE(STR(?review_outcome), "^.*[#/]", ""), STR(?review_outcome)), "")) = ""), false) && COALESCE((COALESCE(?committed_at__key, COALESCE(IF(isIRI(?committed_at), REPLACE(STR(?committed_at), "^.*[#/]", ""), STR(?committed_at)), "")) = ""), false)) AS ?_result)
            }
