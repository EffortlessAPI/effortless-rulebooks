    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_LastOutcomeMeasuredAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lastOutcomeMeasuredAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAdoptionInitiatives .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:KnowledgeOutcomeMeasurements .
                    ?child effortless-ntwf:aiInitiative $this .
                    OPTIONAL { ?child effortless-ntwf:measuredAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_DaysSinceOutcomeMeasured" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceOutcomeMeasured ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAdoptionInitiatives .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:lastOutcomeMeasuredAt ?last_outcome_measured_at . OPTIONAL { ?last_outcome_measured_at effortless-ntwf:__key ?last_outcome_measured_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?last_outcome_measured_at__key, COALESCE(IF(isIRI(?last_outcome_measured_at), REPLACE(STR(?last_outcome_measured_at), "^.*[#/]", ""), STR(?last_outcome_measured_at)), "")) = ""), false), 0, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_outcome_measured_at) + FLOOR((153 * (MONTH(?last_outcome_measured_at) + 12 * FLOOR((14 - MONTH(?last_outcome_measured_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_outcome_measured_at) + 4800 - FLOOR((14 - MONTH(?last_outcome_measured_at)) / 12)) + FLOOR((YEAR(?last_outcome_measured_at) + 4800 - FLOOR((14 - MONTH(?last_outcome_measured_at)) / 12)) / 4) - FLOOR((YEAR(?last_outcome_measured_at) + 4800 - FLOOR((14 - MONTH(?last_outcome_measured_at)) / 12)) / 100) + FLOOR((YEAR(?last_outcome_measured_at) + 4800 - FLOOR((14 - MONTH(?last_outcome_measured_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_AiInsightCount" ;
