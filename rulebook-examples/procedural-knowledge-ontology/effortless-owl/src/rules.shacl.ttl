# === Rules for CommunityMemberships ===
pko-native-procedural-knowledge-rulebook-shapes:CommunityMemberships_Name a sh:NodeShape ;
    sh:targetClass pko-extension:CommunityMembership ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunityMemberships_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:CommunityMembership .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:agent ?agent . OPTIONAL { ?agent erb:key ?agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:communityOfPractice ?community_of_practice . OPTIONAL { ?community_of_practice erb:key ?community_of_practice__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?agent__key, IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent))), ""), " in ", COALESCE(COALESCE(?community_of_practice__key, IF(isIRI(?community_of_practice), REPLACE(STR(?community_of_practice), "^.*[#/]", ""), STR(?community_of_practice))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CommunityMemberships_MemberOrganization a sh:NodeShape ;
    sh:targetClass pko-extension:CommunityMembership ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunityMemberships_MemberOrganization" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:memberOrganization ?_result .
            }
            WHERE {
    $this a pko-extension:CommunityMembership .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:agent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CommunityMemberships_CommunityOrganization a sh:NodeShape ;
    sh:targetClass pko-extension:CommunityMembership ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
