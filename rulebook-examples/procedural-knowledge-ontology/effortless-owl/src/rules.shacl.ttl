            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUntestedRecoveryPath ?_result .
            }
            WHERE {
    $this a pko:Transition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isNeverExercised ?is_never_exercised . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isRecoveryPath ?is_recovery_path . }
                BIND((COALESCE(?is_recovery_path, false) && COALESCE(?is_never_exercised, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_CountOfObservedTraversals a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_CountOfObservedTraversals" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:countOfObservedTraversals ?_result .
            }
            WHERE {
    $this a pko:Transition .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:Transition .
                    ?child a pko-extension:ObservedTransition .
                    ?child pko-native-procedural-knowledge-rulebook:stepTransition $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_HasBeenTraversed a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_HasBeenTraversed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasBeenTraversed ?_result .
            }
            WHERE {
    $this a pko:Transition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:countOfObservedTraversals ?count_of_observed_traversals . }
                BIND((COALESCE(?count_of_observed_traversals, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_IsUnwalkedRecoveryPath a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsUnwalkedRecoveryPath" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnwalkedRecoveryPath ?_result .
            }
            WHERE {
    $this a pko:Transition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasBeenTraversed ?has_been_traversed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isRecoveryPath ?is_recovery_path . }
                BIND((COALESCE(?is_recovery_path, false) && COALESCE((!(COALESCE(?has_been_traversed, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_TargetBlockingRequirementCount a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_TargetBlockingRequirementCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:targetBlockingRequirementCount ?_result .
            }
            WHERE {
    $this a pko:Transition .
                OPTIONAL { $this pko:toStep ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a p-plan:Step . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:blockingRequirementCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_TargetCarriesBlockingControl a sh:NodeShape ;
