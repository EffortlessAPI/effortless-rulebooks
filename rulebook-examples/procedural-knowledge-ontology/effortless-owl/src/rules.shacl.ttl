            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:StepCue .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cueKind ?cue_kind . OPTIONAL { ?cue_kind erb:key ?cue_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " ", COALESCE(COALESCE(?cue_kind__key, IF(isIRI(?cue_kind), REPLACE(STR(?cue_kind), "^.*[#/]", ""), STR(?cue_kind))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepCues_ObservationCount a sh:NodeShape ;
    sh:targetClass pko-extension:StepCue ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepCues_ObservationCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:observationCount ?_result .
            }
            WHERE {
    $this a pko-extension:StepCue .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:StepCue .
                    ?child a pko-extension:CueObservation .
                    ?child pko-native-procedural-knowledge-rulebook:stepCue $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepCues_UnescalatedObservationCount a sh:NodeShape ;
    sh:targetClass pko-extension:StepCue ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepCues_UnescalatedObservationCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:unescalatedObservationCount ?_result .
            }
            WHERE {
    $this a pko-extension:StepCue .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:StepCue .
                    ?child a pko-extension:CueObservation .
                    ?child pko-native-procedural-knowledge-rulebook:unescalatedCueKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:stepCueId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepCues_DangerCueStepKey a sh:NodeShape ;
    sh:targetClass pko-extension:StepCue ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepCues_DangerCueStepKey" ;
