            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:lastApprovalAt ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:MessageTemplates .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastValidApproval ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:TemplateApproval . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:decidedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for MethodApplications ===
pko-native-procedural-knowledge-rulebook-shapes:MethodApplications_Name a sh:NodeShape ;
    sh:targetClass pko-extension:MethodApplication ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MethodApplications_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:MethodApplication .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:appliedTo ?applied_to . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeMethod ?knowledge_method . OPTIONAL { ?knowledge_method erb:key ?knowledge_method__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?knowledge_method__key, IF(isIRI(?knowledge_method), REPLACE(STR(?knowledge_method), "^.*[#/]", ""), STR(?knowledge_method))), ""), " applied: ", COALESCE(IF(isIRI(SUBSTR(STR(?applied_to), 1, 50)), REPLACE(STR(SUBSTR(STR(?applied_to), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?applied_to), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for MinedFlowEdges ===
pko-native-procedural-knowledge-rulebook-shapes:MinedFlowEdges_Name a sh:NodeShape ;
    sh:targetClass pko-extension:MinedFlowEdge ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MinedFlowEdges_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:MinedFlowEdge .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fromStep ?from_step . OPTIONAL { ?from_step erb:key ?from_step__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toStep ?to_step . OPTIONAL { ?to_step erb:key ?to_step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_step__key, IF(isIRI(?from_step), REPLACE(STR(?from_step), "^.*[#/]", ""), STR(?from_step))), ""), " -> ", COALESCE(COALESCE(?to_step__key, IF(isIRI(?to_step), REPLACE(STR(?to_step), "^.*[#/]", ""), STR(?to_step))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MinedFlowEdges_DocumentedTransitionCount a sh:NodeShape ;
    sh:targetClass pko-extension:MinedFlowEdge ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MinedFlowEdges_DocumentedTransitionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:documentedTransitionCount ?_result .
            }
            WHERE {
    $this a pko-extension:MinedFlowEdge .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:MinedFlowEdge .
                    ?child a pko:Transition .
                    ?child pko:fromStep ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:fromStep ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko:toStep ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toStep ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MinedFlowEdges_IsUndocumentedPath a sh:NodeShape ;
    sh:targetClass pko-extension:MinedFlowEdge ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MinedFlowEdges_IsUndocumentedPath" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUndocumentedPath ?_result .
            }
            WHERE {
    $this a pko-extension:MinedFlowEdge .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:documentedTransitionCount ?documented_transition_count . }
                BIND((COALESCE(?documented_transition_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MinedFlowEdges_ToStepExpectedMinutes a sh:NodeShape ;
    sh:targetClass pko-extension:MinedFlowEdge ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MinedFlowEdges_ToStepExpectedMinutes" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:toStepExpectedMinutes ?_result .
            }
            WHERE {
    $this a pko-extension:MinedFlowEdge .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toStep ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a p-plan:Step . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:expectedDurationMinutes ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MinedFlowEdges_IsBottleneck a sh:NodeShape ;
    sh:targetClass pko-extension:MinedFlowEdge ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MinedFlowEdges_IsBottleneck" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isBottleneck ?_result .
            }
            WHERE {
    $this a pko-extension:MinedFlowEdge .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:medianWaitMinutes ?median_wait_minutes . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toStepExpectedMinutes ?to_step_expected_minutes . }
                BIND((COALESCE((COALESCE(?to_step_expected_minutes, 0) > 0), false) && COALESCE((COALESCE(?median_wait_minutes, 0) > COALESCE((4 * ?to_step_expected_minutes), 0)), false)) AS ?_result)
            }
        """ ;
    ] .
