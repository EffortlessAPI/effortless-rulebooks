# === Rules for ProcedureFacetAssignments ===
pko-native-procedural-knowledge-rulebook-shapes:ProcedureFacetAssignments_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ProcedureFacetAssignment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureFacetAssignments_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ProcedureFacetAssignment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:facet ?facet . OPTIONAL { ?facet erb:key ?facet__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:facetValue ?facet_value . OPTIONAL { ?facet_value erb:key ?facet_value__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?procedure . OPTIONAL { ?procedure erb:key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), " ", COALESCE(COALESCE(?facet__key, IF(isIRI(?facet), REPLACE(STR(?facet), "^.*[#/]", ""), STR(?facet))), ""), "=", COALESCE(COALESCE(?facet_value__key, IF(isIRI(?facet_value), REPLACE(STR(?facet_value), "^.*[#/]", ""), STR(?facet_value))), "")) AS ?_result)
            }
        """ ;
    ] .

