    $this a pko-extension:VocabularyTerm .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:vocabulary ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:Vocabulary . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:governedDimension ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_IntroducedReleaseIssuedAt a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
