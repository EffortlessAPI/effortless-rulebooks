    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:hasUnevaluatedBlockingControl ?has_unevaluated_blocking_control . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?has_unevaluated_blocking_control, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
