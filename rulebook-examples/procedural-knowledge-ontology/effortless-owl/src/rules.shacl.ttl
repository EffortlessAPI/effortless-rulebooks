            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAgingLowConfidenceClaim ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:exceedsOwningCadence ?exceeds_owning_cadence . }
    OPTIONAL { $this effortless-ntwf:isLowConfidence ?is_low_confidence . }
                BIND((COALESCE(?exceeds_owning_cadence, false) && COALESCE(?is_low_confidence, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
