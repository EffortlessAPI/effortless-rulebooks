            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasNoRecordedSolution ?_result .
            }
            WHERE {
    $this a pko:IssueOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:issueSolution ?issue_solution . OPTIONAL { ?issue_solution erb:key ?issue_solution__key . } }
                BIND((COALESCE(?issue_solution__key, COALESCE(IF(isIRI(?issue_solution), REPLACE(STR(?issue_solution), "^.*[#/]", ""), STR(?issue_solution)), "")) = "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:IssueOccurrences_RedesignImplementedAt a sh:NodeShape ;
    sh:targetClass pko:IssueOccurrence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_RedesignImplementedAt" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:redesignImplementedAt ?_result .
            }
            WHERE {
    $this a pko:IssueOccurrence .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:redesignChangeRequest ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:ChangeRequest . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:implementedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:IssueOccurrences_IsFailureWithoutLandedRedesign a sh:NodeShape ;
    sh:targetClass pko:IssueOccurrence ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_IsFailureWithoutLandedRedesign" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFailureWithoutLandedRedesign ?_result .
            }
            WHERE {
    $this a pko:IssueOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:redesignChangeRequest ?redesign_change_request . OPTIONAL { ?redesign_change_request erb:key ?redesign_change_request__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:redesignImplementedAt ?redesign_implemented_at . OPTIONAL { ?redesign_implemented_at erb:key ?redesign_implemented_at__key . } }
                BIND((COALESCE((COALESCE(?redesign_change_request__key, COALESCE(IF(isIRI(?redesign_change_request), REPLACE(STR(?redesign_change_request), "^.*[#/]", ""), STR(?redesign_change_request)), "")) = ""), false) || COALESCE((COALESCE(?redesign_implemented_at__key, COALESCE(IF(isIRI(?redesign_implemented_at), REPLACE(STR(?redesign_implemented_at), "^.*[#/]", ""), STR(?redesign_implemented_at)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:IssueOccurrences_ImprovementCyclePath a sh:NodeShape ;
    sh:targetClass pko:IssueOccurrence ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_ImprovementCyclePath" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:improvementCyclePath ?_result .
            }
            WHERE {
    $this a pko:IssueOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:encounteredByAgent ?encountered_by_agent . OPTIONAL { ?encountered_by_agent erb:key ?encountered_by_agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:error ?error . OPTIONAL { ?error erb:key ?error__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:executedStep ?executed_step . OPTIONAL { ?executed_step erb:key ?executed_step__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:issueCause ?issue_cause . OPTIONAL { ?issue_cause erb:key ?issue_cause__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:redesignChangeRequest ?redesign_change_request . OPTIONAL { ?redesign_change_request erb:key ?redesign_change_request__key . } }
                BIND(IF(COALESCE((COALESCE(?redesign_change_request__key, COALESCE(IF(isIRI(?redesign_change_request), REPLACE(STR(?redesign_change_request), "^.*[#/]", ""), STR(?redesign_change_request)), "")) = ""), false), "", CONCAT("Observed at ", COALESCE(COALESCE(?executed_step__key, IF(isIRI(?executed_step), REPLACE(STR(?executed_step), "^.*[#/]", ""), STR(?executed_step))), ""), " by ", COALESCE(COALESCE(?encountered_by_agent__key, IF(isIRI(?encountered_by_agent), REPLACE(STR(?encountered_by_agent), "^.*[#/]", ""), STR(?encountered_by_agent))), ""), "; recorded as ", COALESCE(COALESCE(?error__key, IF(isIRI(?error), REPLACE(STR(?error), "^.*[#/]", ""), STR(?error))), ""), " (", COALESCE(COALESCE(?issue_cause__key, IF(isIRI(?issue_cause), REPLACE(STR(?issue_cause), "^.*[#/]", ""), STR(?issue_cause))), ""), "); redesigned by ", COALESCE(COALESCE(?redesign_change_request__key, IF(isIRI(?redesign_change_request), REPLACE(STR(?redesign_change_request), "^.*[#/]", ""), STR(?redesign_change_request))), ""))) AS ?_result)
            }
        """ ;
    ] .

# === Rules for IssuedTokens ===
pko-native-procedural-knowledge-rulebook-shapes:IssuedTokens_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:IssuedTokens ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssuedTokens_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:IssuedTokens .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:appUser ?app_user . OPTIONAL { ?app_user erb:key ?app_user__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:issuedAt ?issued_at . OPTIONAL { ?issued_at erb:key ?issued_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:principal ?principal . OPTIONAL { ?principal erb:key ?principal__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?app_user__key, IF(isIRI(?app_user), REPLACE(STR(?app_user), "^.*[#/]", ""), STR(?app_user))), ""), " as ", COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), ""), " @ ", COALESCE(REPLACE(COALESCE(?issued_at__key, IF(isIRI(?issued_at), REPLACE(STR(?issued_at), "^.*[#/]", ""), STR(?issued_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:IssuedTokens_IsDevMinted a sh:NodeShape ;
