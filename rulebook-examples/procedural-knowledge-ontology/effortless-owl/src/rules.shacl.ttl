pko-native-procedural-knowledge-rulebook-shapes:KnowledgeHoldings_IsVeteranDiscretion a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeHolding ;
    sh:order 2 ;
    sh:rule [
