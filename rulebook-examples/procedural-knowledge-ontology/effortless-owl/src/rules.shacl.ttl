            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wentFullWithoutReviewedPartialStage ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAdoptionInitiatives .
    OPTIONAL { $this effortless-ntwf:automationLevel ?automation_level . OPTIONAL { ?automation_level effortless-ntwf:__key ?automation_level__key . } }
    OPTIONAL { $this effortless-ntwf:precedingInitiative ?preceding_initiative . OPTIONAL { ?preceding_initiative effortless-ntwf:__key ?preceding_initiative__key . } }
    OPTIONAL { $this effortless-ntwf:precedingReviewedOutputCount ?preceding_reviewed_output_count . }
                BIND((COALESCE((COALESCE(?automation_level__key, COALESCE(IF(isIRI(?automation_level), REPLACE(STR(?automation_level), "^.*[#/]", ""), STR(?automation_level)), "")) = "Full"), false) && COALESCE((COALESCE((COALESCE(?preceding_initiative__key, COALESCE(IF(isIRI(?preceding_initiative), REPLACE(STR(?preceding_initiative), "^.*[#/]", ""), STR(?preceding_initiative)), "")) = ""), false) || COALESCE((COALESCE(?preceding_reviewed_output_count, 0) = 0), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_UnderinvestsKnowledgeLayer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:underinvestsKnowledgeLayer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAdoptionInitiatives .
    OPTIONAL { $this effortless-ntwf:knowledgeLayerBudget ?knowledge_layer_budget . }
    OPTIONAL { $this effortless-ntwf:modelLayerBudget ?model_layer_budget . }
                BIND((COALESCE((COALESCE(?model_layer_budget, 0) > 0), false) && COALESCE((COALESCE(?knowledge_layer_budget, 0) < COALESCE(?model_layer_budget, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
