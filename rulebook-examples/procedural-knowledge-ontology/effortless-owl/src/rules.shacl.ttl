pko-native-procedural-knowledge-rulebook-shapes:Steps_BlockingRequirementCount a sh:NodeShape ;
    sh:targetClass p-plan:Step ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_BlockingRequirementCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:blockingRequirementCount ?_result .
            }
            WHERE {
    $this a p-plan:Step .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a p-plan:Step .
                    ?child a pko-native-procedural-knowledge-rulebook:StepRequirements .
                    ?child pko-native-procedural-knowledge-rulebook:blockingStepKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:stepId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
