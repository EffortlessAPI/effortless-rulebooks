            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:matchingPrefLabelCount ?_result .
            }
            WHERE {
    $this a pko-extension:SourceTermMention .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:SourceTermMention .
                    ?child a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
                    ?child pko-native-procedural-knowledge-rulebook:prefWordingKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:wordingKey ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceTermMentions_IsUncontrolledWording a sh:NodeShape ;
    sh:targetClass pko-extension:SourceTermMention ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_IsUncontrolledWording" ;
