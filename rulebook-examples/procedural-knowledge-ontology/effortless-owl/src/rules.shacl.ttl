            WHERE {
    $this a pko-extension:AuthorityBoundary .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authorityRole ?authority_role . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:bindsDespiteLapsedRatification ?binds_despite_lapsed_ratification . }
                BIND(IF(COALESCE(?binds_despite_lapsed_ratification, false), ?authority_role, "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for BindingObservations ===
pko-native-procedural-knowledge-rulebook-shapes:BindingObservations_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:BindingObservations ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:BindingObservations .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:bindingObservationId ?binding_observation_id . OPTIONAL { ?binding_observation_id erb:key ?binding_observation_id__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . OPTIONAL { ?step_execution erb:key ?step_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_execution__key, IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution))), ""), " / ", COALESCE(COALESCE(?binding_observation_id__key, IF(isIRI(?binding_observation_id), REPLACE(STR(?binding_observation_id), "^.*[#/]", ""), STR(?binding_observation_id))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:BindingObservations_SlaMinutesAtRun a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:BindingObservations ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_SlaMinutesAtRun" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:slaMinutesAtRun ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:BindingObservations .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:operationalBinding ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:OperationalBinding . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:freshnessSlaMinutes ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:BindingObservations_AgeAtRunMinutes a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:BindingObservations ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_AgeAtRunMinutes" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:ageAtRunMinutes ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:BindingObservations .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:observedSourceTimestamp ?observed_source_timestamp . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:readAt ?read_at . }
                BIND(ROUND(((((DAY(?read_at) + FLOOR((153 * (MONTH(?read_at) + 12 * FLOOR((14 - MONTH(?read_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) + FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 4) - FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 100) + FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 400) - 32045) - (DAY(?observed_source_timestamp) + FLOOR((153 * (MONTH(?observed_source_timestamp) + 12 * FLOOR((14 - MONTH(?observed_source_timestamp)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) + FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 4) - FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 100) + FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?read_at) * 3600 + MINUTES(?read_at) * 60 + SECONDS(?read_at)) - (HOURS(?observed_source_timestamp) * 3600 + MINUTES(?observed_source_timestamp) * 60 + SECONDS(?observed_source_timestamp))) / 60)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:BindingObservations_WasStaleAtRun a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:BindingObservations ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_WasStaleAtRun" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:wasStaleAtRun ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:BindingObservations .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ageAtRunMinutes ?age_at_run_minutes . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAuthoritativeBinding ?is_authoritative_binding . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:slaMinutesAtRun ?sla_minutes_at_run . }
                BIND((COALESCE(?is_authoritative_binding, false) && COALESCE((COALESCE(?age_at_run_minutes, 0) > COALESCE(?sla_minutes_at_run, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:BindingObservations_IsAuthoritativeBinding a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:BindingObservations ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_IsAuthoritativeBinding" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isAuthoritativeBinding ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:BindingObservations .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:operationalBinding ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:OperationalBinding . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isAuthoritative ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:BindingObservations_StaleAtRunStepKey a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:BindingObservations ;
    sh:order 3 ;
