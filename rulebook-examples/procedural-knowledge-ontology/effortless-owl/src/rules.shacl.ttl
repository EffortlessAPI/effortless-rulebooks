            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnusedFaq ?_result .
            }
            WHERE {
    $this a pko:FrequentlyAskedQuestion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resolutionCount ?resolution_count . }
                BIND((COALESCE(?resolution_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Facilities ===
pko-native-procedural-knowledge-rulebook-shapes:Facilities_Name a sh:NodeShape ;
