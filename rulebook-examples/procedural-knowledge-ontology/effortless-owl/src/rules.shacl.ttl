pko-native-procedural-knowledge-rulebook-shapes:RulebookReleases_ValidationFailureTotal a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_ValidationFailureTotal" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:validationFailureTotal ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:RulebookReleases .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:RulebookReleases .
                    ?child a pko-extension:ChangeValidationRun .
                    ?child pko-native-procedural-knowledge-rulebook:release ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:rulebookReleaseId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:runPurpose ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:failureCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Acceptance"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
