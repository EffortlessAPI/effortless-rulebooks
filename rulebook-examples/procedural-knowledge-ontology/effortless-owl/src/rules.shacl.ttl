    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ambientAbsorptionCount ?ambient_absorption_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isColocatedTrade ?is_colocated_trade . }
                BIND((COALESCE(?is_colocated_trade, false) && COALESCE((COALESCE(?ambient_absorption_count, 0) >= 1), false)) AS ?_result)
            }
        """ ;
