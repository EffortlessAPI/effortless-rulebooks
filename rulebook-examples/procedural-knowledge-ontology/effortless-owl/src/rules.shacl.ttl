            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:childStepCount ?child_step_count . }
    OPTIONAL { $this effortless-ntwf:stepKind ?step_kind . OPTIONAL { ?step_kind effortless-ntwf:__key ?step_kind__key . } }
                BIND((COALESCE((COALESCE(?step_kind__key, COALESCE(IF(isIRI(?step_kind), REPLACE(STR(?step_kind), "^.*[#/]", ""), STR(?step_kind)), "")) = "MultiStep"), false) && COALESCE((COALESCE(?child_step_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
