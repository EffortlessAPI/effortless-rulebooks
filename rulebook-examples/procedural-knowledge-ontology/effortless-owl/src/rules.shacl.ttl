                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a p-plan:Step . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:inputVariableCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_RanWithoutDeclaredInputs a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_RanWithoutDeclaredInputs" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:ranWithoutDeclaredInputs ?_result .
            }
            WHERE {
    $this a pko:StepExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isCompleted ?is_completed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepInputVariableCount ?step_input_variable_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usedEntityCount ?used_entity_count . }
                BIND((COALESCE(?is_completed, false) && COALESCE((COALESCE(?step_input_variable_count, 0) > 0), false) && COALESCE((COALESCE(?used_entity_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_StepPrerequisite a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
