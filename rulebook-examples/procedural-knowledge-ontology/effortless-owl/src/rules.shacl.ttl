    OPTIONAL { $this effortless-ntwf:targetVersion ?target_version . OPTIONAL { ?target_version effortless-ntwf:__key ?target_version__key . } }
    OPTIONAL { $this effortless-ntwf:targetVersionIssuedAt ?target_version_issued_at . }
                BIND((COALESCE((COALESCE(?redesign_started_at__key, COALESCE(IF(isIRI(?redesign_started_at), REPLACE(STR(?redesign_started_at), "^.*[#/]", ""), STR(?redesign_started_at)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?target_version__key, COALESCE(IF(isIRI(?target_version), REPLACE(STR(?target_version), "^.*[#/]", ""), STR(?target_version)), "")) = ""), false) || COALESCE(COALESCE((?redesign_started_at < ?target_version_issued_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
