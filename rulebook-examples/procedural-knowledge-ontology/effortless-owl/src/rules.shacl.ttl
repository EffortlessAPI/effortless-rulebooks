    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isUsableForDrafting ?is_usable_for_drafting . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . }
                BIND(IF(COALESCE(?is_usable_for_drafting, false), "", ?step) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Organizations ===
pko-native-procedural-knowledge-rulebook-shapes:Organizations_Name a sh:NodeShape ;
    sh:targetClass pko-industry:Department ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-industry:Department .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Organizations_FailedAiInitiativeCount a sh:NodeShape ;
    sh:targetClass pko-industry:Department ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_FailedAiInitiativeCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:failedAiInitiativeCount ?_result .
            }
            WHERE {
    $this a pko-industry:Department .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-industry:Department .
                    ?child a pko-extension:AiAdoptionInitiative .
                    ?child pko-native-procedural-knowledge-rulebook:organization $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:outcome ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Failed"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Organizations_OwnedProcedureCount a sh:NodeShape ;
