    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_AssessedInconsistentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assessedInconsistentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeImpactFindings .
                    ?child effortless-ntwf:modelChangeRequest $this .
                    OPTIONAL { ?child effortless-ntwf:findingKind ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:findingStage ?c4 . }
                    FILTER((STR(?c2) = "InconsistentInstance"))
                    FILTER((STR(?c4) = "Assessment"))
                    }
                }
            }
        """ ;
    ] ;
