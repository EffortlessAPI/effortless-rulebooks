pko-native-procedural-knowledge-rulebook-shapes:RoleAssignmentUpdateTasks_PolicyTriggerOwnerRole a sh:NodeShape ;
    sh:targetClass pko-extension:RoleAssignmentUpdateTask ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignmentUpdateTasks_PolicyTriggerOwnerRole" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:policyTriggerOwnerRole ?_result .
            }
            WHERE {
    $this a pko-extension:RoleAssignmentUpdateTask .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:governingPolicy ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:AssignmentUpdatePolicy . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:triggerOwnerRole ?j3 . } }
