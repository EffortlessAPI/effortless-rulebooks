pko-native-procedural-knowledge-rulebook-shapes:Organizations_DepartedHolderKnowHowCount a sh:NodeShape ;
    sh:targetClass pko-industry:Department ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_DepartedHolderKnowHowCount" ;
