pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_AsOfInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_DaysSinceModified a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_DaysSinceModified" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceModified ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modifiedAt ?modified_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?modified_at) + FLOOR((153 * (MONTH(?modified_at) + 12 * FLOOR((14 - MONTH(?modified_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) + FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 4) - FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 100) + FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_DaysSinceLastReview a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_DaysSinceLastReview" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceLastReview ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                    ?child a pko:ReviewEvent .
                    ?child pko-native-procedural-knowledge-rulebook:procedureVersion $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:reviewedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?__agg0__)
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
