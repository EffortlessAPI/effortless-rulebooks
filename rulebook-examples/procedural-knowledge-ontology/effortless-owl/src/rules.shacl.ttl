    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:namespaceDereferences ?namespace_dereferences . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:namespaceServesRdf ?namespace_serves_rdf . }
                BIND((COALESCE(?namespace_dereferences, false) && COALESCE(?namespace_serves_rdf, false) && COALESCE((COALESCE(?mapping_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for OntologySupportProgrammes ===
pko-native-procedural-knowledge-rulebook-shapes:OntologySupportProgrammes_Name a sh:NodeShape ;
