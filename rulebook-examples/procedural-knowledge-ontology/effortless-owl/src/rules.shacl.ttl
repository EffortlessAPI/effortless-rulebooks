            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:tableFieldCount ?_result .
            }
            WHERE {
    $this a pko-extension:RoleSchemaView .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetTable ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:RulebookTable . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:fieldCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleSchemaViews_IsFullWidth a sh:NodeShape ;
    sh:targetClass pko-extension:RoleSchemaView ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_IsFullWidth" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFullWidth ?_result .
            }
            WHERE {
    $this a pko-extension:RoleSchemaView .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:columnCount ?column_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:tableFieldCount ?table_field_count . }
                BIND((COALESCE((COALESCE(?column_count, 0) > 0), false) && COALESCE((COALESCE(?column_count, 0) >= COALESCE(?table_field_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleSchemaViews_IsDegenerateView a sh:NodeShape ;
    sh:targetClass pko-extension:RoleSchemaView ;
