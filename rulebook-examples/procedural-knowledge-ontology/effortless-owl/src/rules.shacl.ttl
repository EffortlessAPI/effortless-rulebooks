            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:proficientWithoutCaptureCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:OnboardingRecords .
                    ?child effortless-ntwf:procedure $this .
                    OPTIONAL { ?child effortless-ntwf:isProficient ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:usedCapturedKnowledge ?c4 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER(BOUND(?c4) && ?c4 = false)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_DaysWithCaptureTotal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysWithCaptureTotal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:OnboardingRecords .
                    ?child effortless-ntwf:procedure $this .
                    OPTIONAL { ?child effortless-ntwf:isProficient ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:usedCapturedKnowledge ?c4 . }
                    OPTIONAL { ?child effortless-ntwf:daysToProficiency ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER(BOUND(?c4) && ?c4 = true)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_DaysWithoutCaptureTotal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysWithoutCaptureTotal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:OnboardingRecords .
                    ?child effortless-ntwf:procedure $this .
                    OPTIONAL { ?child effortless-ntwf:isProficient ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:usedCapturedKnowledge ?c4 . }
                    OPTIONAL { ?child effortless-ntwf:daysToProficiency ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER(BOUND(?c4) && ?c4 = false)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_AvgDaysToProficiencyWithCapture" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:avgDaysToProficiencyWithCapture ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:daysWithCaptureTotal ?days_with_capture_total . }
    OPTIONAL { $this effortless-ntwf:proficientWithCaptureCount ?proficient_with_capture_count . }
                BIND(IF(COALESCE((COALESCE(?proficient_with_capture_count, 0) = 0), false), 0, (ROUND((?days_with_capture_total / ?proficient_with_capture_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_AvgDaysToProficiencyWithoutCapture" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:avgDaysToProficiencyWithoutCapture ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:daysWithoutCaptureTotal ?days_without_capture_total . }
    OPTIONAL { $this effortless-ntwf:proficientWithoutCaptureCount ?proficient_without_capture_count . }
                BIND(IF(COALESCE((COALESCE(?proficient_without_capture_count, 0) = 0), false), 0, (ROUND((?days_without_capture_total / ?proficient_without_capture_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_FormalizationDoesNotEaseOnboarding" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:formalizationDoesNotEaseOnboarding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:avgDaysToProficiencyWithCapture ?avg_days_to_proficiency_with_capture . }
    OPTIONAL { $this effortless-ntwf:avgDaysToProficiencyWithoutCapture ?avg_days_to_proficiency_without_capture . }
    OPTIONAL { $this effortless-ntwf:proficientWithCaptureCount ?proficient_with_capture_count . }
    OPTIONAL { $this effortless-ntwf:proficientWithoutCaptureCount ?proficient_without_capture_count . }
                BIND((COALESCE((COALESCE(?proficient_with_capture_count, 0) > 0), false) && COALESCE((COALESCE(?proficient_without_capture_count, 0) > 0), false) && COALESCE((COALESCE(?avg_days_to_proficiency_with_capture, 0) >= COALESCE(?avg_days_to_proficiency_without_capture, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_CollectedMaterialCount" ;
