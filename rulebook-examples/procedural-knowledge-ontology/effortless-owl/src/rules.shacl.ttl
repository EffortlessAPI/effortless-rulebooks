    OPTIONAL { $this effortless-ntwf:authorityAgent ?authority_agent . }
    OPTIONAL { $this effortless-ntwf:changeOperation ?change_operation . OPTIONAL { ?change_operation effortless-ntwf:__key ?change_operation__key . } }
    OPTIONAL { $this effortless-ntwf:stewardAgent ?steward_agent . }
                BIND((COALESCE((COALESCE((COALESCE(?change_operation__key, COALESCE(IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation)), "")) = "CreateDefinition"), false) || COALESCE((COALESCE(?change_operation__key, COALESCE(IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation)), "")) = "ModifyDefinition"), false) || COALESCE((COALESCE(?change_operation__key, COALESCE(IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation)), "")) = "RetireDefinition"), false)), false) && COALESCE((COALESCE(?approved_by_agent__key, COALESCE(IF(isIRI(?approved_by_agent), REPLACE(STR(?approved_by_agent), "^.*[#/]", ""), STR(?approved_by_agent)), "")) != ""), false) && COALESCE(COALESCE((?approved_by_agent != ?steward_agent), !((!BOUND(?approved_by_agent) || STR(?approved_by_agent) = "") && (!BOUND(?steward_agent) || STR(?steward_agent) = ""))), false) && COALESCE(COALESCE((?approved_by_agent != ?authority_agent), !((!BOUND(?approved_by_agent) || STR(?approved_by_agent) = "") && (!BOUND(?authority_agent) || STR(?authority_agent) = ""))), false)) AS ?_result)
            }
