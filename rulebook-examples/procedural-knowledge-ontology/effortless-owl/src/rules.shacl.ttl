            }
            WHERE {
    $this a pko:StepExecution .
                OPTIONAL { $this pko:previousStepExecution ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:StepExecution . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
