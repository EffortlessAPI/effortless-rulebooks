            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:approvalRoleAgentKind ?approval_role_agent_kind . OPTIONAL { ?approval_role_agent_kind effortless-ntwf:__key ?approval_role_agent_kind__key . } }
                BIND((COALESCE(?approval_role_agent_kind__key, COALESCE(IF(isIRI(?approval_role_agent_kind), REPLACE(STR(?approval_role_agent_kind), "^.*[#/]", ""), STR(?approval_role_agent_kind)), "")) = "Human") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_AuthorizationGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:authorizationGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:approvalIsHuman ?approval_is_human . }
    OPTIONAL { $this effortless-ntwf:executionHasLegalClearance ?execution_has_legal_clearance . }
    OPTIONAL { $this effortless-ntwf:templateIsSendable ?template_is_sendable . }
                BIND((COALESCE(?template_is_sendable, false) && COALESCE((COALESCE(?execution_has_legal_clearance, false) && COALESCE(?approval_is_human, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsClearedToSend" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isClearedToSend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:authorizationGatePassed ?authorization_gate_passed . }
    OPTIONAL { $this effortless-ntwf:contentGatePassed ?content_gate_passed . }
    OPTIONAL { $this effortless-ntwf:permissionGatePassed ?permission_gate_passed . }
    OPTIONAL { $this effortless-ntwf:timingGatePassed ?timing_gate_passed . }
                BIND((COALESCE(?permission_gate_passed, false) && COALESCE((COALESCE(?timing_gate_passed, false) && COALESCE((COALESCE(?content_gate_passed, false) && COALESCE(?authorization_gate_passed, false)), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_BlockingGateName" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:blockingGateName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:contentGatePassed ?content_gate_passed . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
    OPTIONAL { $this effortless-ntwf:permissionGatePassed ?permission_gate_passed . }
    OPTIONAL { $this effortless-ntwf:timingGatePassed ?timing_gate_passed . }
                BIND(IF(COALESCE(?is_cleared_to_send, false), "", IF(COALESCE((!(COALESCE(?permission_gate_passed, false))), false), "Permission", IF(COALESCE((!(COALESCE(?timing_gate_passed, false))), false), "Timing", IF(COALESCE((!(COALESCE(?content_gate_passed, false))), false), "Content", "Authorization")))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_HasResultingDelivery" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasResultingDelivery ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:resultingDelivery ?resulting_delivery . OPTIONAL { ?resulting_delivery effortless-ntwf:__key ?resulting_delivery__key . } }
                BIND((COALESCE(?resulting_delivery__key, COALESCE(IF(isIRI(?resulting_delivery), REPLACE(STR(?resulting_delivery), "^.*[#/]", ""), STR(?resulting_delivery)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ResultingDeliveryWasTransmitted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:resultingDeliveryWasTransmitted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:resultingDelivery ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageDeliveries ; effortless-ntwf:messageDeliveryId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:wasActuallyTransmitted ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsOverriddenRefusal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOverriddenRefusal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:hasResultingDelivery ?has_resulting_delivery . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
    OPTIONAL { $this effortless-ntwf:resultingDeliveryWasTransmitted ?resulting_delivery_was_transmitted . }
                BIND((COALESCE((!(COALESCE(?is_cleared_to_send, false))), false) && COALESCE((COALESCE(?has_resulting_delivery, false) && COALESCE(?resulting_delivery_was_transmitted, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsSilentlyDropped" ;
        sh:prefixes effortless-ntwf: ;
