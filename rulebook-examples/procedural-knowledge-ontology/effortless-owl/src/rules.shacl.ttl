            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:assuranceGradeNow ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Attestations .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureExecution ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:ProcedureExecution . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:assuranceGrade ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Attestations_AssuranceGradeHasDrifted a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Attestations ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_AssuranceGradeHasDrifted" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:assuranceGradeHasDrifted ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Attestations .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:assuranceGradeAtSigning ?assurance_grade_at_signing . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:assuranceGradeNow ?assurance_grade_now . }
                BIND((!(COALESCE(COALESCE((?assurance_grade_at_signing = ?assurance_grade_now), ((!BOUND(?assurance_grade_at_signing) || STR(?assurance_grade_at_signing) = "") && (!BOUND(?assurance_grade_now) || STR(?assurance_grade_now) = ""))), false))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Attestations_WouldNotSurviveRestatement a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Attestations ;
    sh:order 10 ;
    sh:rule [
