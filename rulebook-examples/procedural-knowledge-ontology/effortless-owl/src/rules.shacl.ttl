            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
    OPTIONAL { $this effortless-ntwf:versionDecidedByAgent ?version_decided_by_agent . OPTIONAL { ?version_decided_by_agent effortless-ntwf:__key ?version_decided_by_agent__key . } }
    OPTIONAL { $this effortless-ntwf:versionDecisionRationale ?version_decision_rationale . OPTIONAL { ?version_decision_rationale effortless-ntwf:__key ?version_decision_rationale__key . } }
                BIND((COALESCE((COALESCE(?governed_model__key, COALESCE(IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?version_decision_rationale__key, COALESCE(IF(isIRI(?version_decision_rationale), REPLACE(STR(?version_decision_rationale), "^.*[#/]", ""), STR(?version_decision_rationale)), "")) = ""), false) || COALESCE((COALESCE(?version_decided_by_agent__key, COALESCE(IF(isIRI(?version_decided_by_agent), REPLACE(STR(?version_decided_by_agent), "^.*[#/]", ""), STR(?version_decided_by_agent)), "")) = ""), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
