    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:samePrefWordingCount ?same_pref_wording_count . }
                BIND((COALESCE((COALESCE(?label_kind__key, COALESCE(IF(isIRI(?label_kind), REPLACE(STR(?label_kind), "^.*[#/]", ""), STR(?label_kind)), "")) = "pref"), false) && COALESCE((COALESCE(?same_pref_wording_count, 0) > 1), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for TermMeaningChanges ===
pko-native-procedural-knowledge-rulebook-shapes:TermMeaningChanges_Name a sh:NodeShape ;
    sh:targetClass pko-extension:TermMeaningChange ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermMeaningChanges_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:TermMeaningChange .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:changedAt ?changed_at . OPTIONAL { ?changed_at erb:key ?changed_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:vocabularyTerm ?vocabulary_term . OPTIONAL { ?vocabulary_term erb:key ?vocabulary_term__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?vocabulary_term__key, IF(isIRI(?vocabulary_term), REPLACE(STR(?vocabulary_term), "^.*[#/]", ""), STR(?vocabulary_term))), ""), " meaning changed ", COALESCE(REPLACE(COALESCE(?changed_at__key, IF(isIRI(?changed_at), REPLACE(STR(?changed_at), "^.*[#/]", ""), STR(?changed_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TermMeaningChanges_SpanDays a sh:NodeShape ;
    sh:targetClass pko-extension:TermMeaningChange ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermMeaningChanges_SpanDays" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:spanDays ?_result .
            }
            WHERE {
    $this a pko-extension:TermMeaningChange .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:changedAt ?changed_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:priorMeaningSince ?prior_meaning_since . OPTIONAL { ?prior_meaning_since erb:key ?prior_meaning_since__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?prior_meaning_since__key, COALESCE(IF(isIRI(?prior_meaning_since), REPLACE(STR(?prior_meaning_since), "^.*[#/]", ""), STR(?prior_meaning_since)), "")) = ""), false), 0, ((DAY(?changed_at) + FLOOR((153 * (MONTH(?changed_at) + 12 * FLOOR((14 - MONTH(?changed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?changed_at) + 4800 - FLOOR((14 - MONTH(?changed_at)) / 12)) + FLOOR((YEAR(?changed_at) + 4800 - FLOOR((14 - MONTH(?changed_at)) / 12)) / 4) - FLOOR((YEAR(?changed_at) + 4800 - FLOOR((14 - MONTH(?changed_at)) / 12)) / 100) + FLOOR((YEAR(?changed_at) + 4800 - FLOOR((14 - MONTH(?changed_at)) / 12)) / 400) - 32045) - (DAY(?prior_meaning_since) + FLOOR((153 * (MONTH(?prior_meaning_since) + 12 * FLOOR((14 - MONTH(?prior_meaning_since)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?prior_meaning_since) + 4800 - FLOOR((14 - MONTH(?prior_meaning_since)) / 12)) + FLOOR((YEAR(?prior_meaning_since) + 4800 - FLOOR((14 - MONTH(?prior_meaning_since)) / 12)) / 4) - FLOOR((YEAR(?prior_meaning_since) + 4800 - FLOOR((14 - MONTH(?prior_meaning_since)) / 12)) / 100) + FLOOR((YEAR(?prior_meaning_since) + 4800 - FLOOR((14 - MONTH(?prior_meaning_since)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] .

# === Rules for TermRelations ===
pko-native-procedural-knowledge-rulebook-shapes:TermRelations_Name a sh:NodeShape ;
    sh:targetClass pko-extension:TermRelation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermRelations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:TermRelation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fromTerm ?from_term . OPTIONAL { ?from_term erb:key ?from_term__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:relationKind ?relation_kind . OPTIONAL { ?relation_kind erb:key ?relation_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toTerm ?to_term . OPTIONAL { ?to_term erb:key ?to_term__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_term__key, IF(isIRI(?from_term), REPLACE(STR(?from_term), "^.*[#/]", ""), STR(?from_term))), ""), " ", COALESCE(COALESCE(?relation_kind__key, IF(isIRI(?relation_kind), REPLACE(STR(?relation_kind), "^.*[#/]", ""), STR(?relation_kind))), ""), " ", COALESCE(COALESCE(?to_term__key, IF(isIRI(?to_term), REPLACE(STR(?to_term), "^.*[#/]", ""), STR(?to_term))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TermRelations_FromTermGrandparent a sh:NodeShape ;
    sh:targetClass pko-extension:TermRelation ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermRelations_FromTermGrandparent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:fromTermGrandparent ?_result .
            }
            WHERE {
    $this a pko-extension:TermRelation .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fromTerm ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:VocabularyTerm . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:broaderTermParent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TermRelations_AssertsIndirectLinkAsDirect a sh:NodeShape ;
    sh:targetClass pko-extension:TermRelation ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermRelations_AssertsIndirectLinkAsDirect" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:assertsIndirectLinkAsDirect ?_result .
            }
            WHERE {
    $this a pko-extension:TermRelation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fromTermGrandparent ?from_term_grandparent . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:relationKind ?relation_kind . OPTIONAL { ?relation_kind erb:key ?relation_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toTerm ?to_term . }
                BIND((COALESCE((COALESCE(?relation_kind__key, COALESCE(IF(isIRI(?relation_kind), REPLACE(STR(?relation_kind), "^.*[#/]", ""), STR(?relation_kind)), "")) = "broader"), false) && COALESCE(COALESCE((?to_term = ?from_term_grandparent), ((!BOUND(?to_term) || STR(?to_term) = "") && (!BOUND(?from_term_grandparent) || STR(?from_term_grandparent) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for TestCases ===
pko-native-procedural-knowledge-rulebook-shapes:TestCases_Name a sh:NodeShape ;
    sh:targetClass pko-extension:TestCase ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:TestCase .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:subject ?subject . OPTIONAL { ?subject erb:key ?subject__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:testKind ?test_kind . OPTIONAL { ?test_kind erb:key ?test_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?test_kind__key, IF(isIRI(?test_kind), REPLACE(STR(?test_kind), "^.*[#/]", ""), STR(?test_kind))), ""), ": ", COALESCE(COALESCE(?subject__key, IF(isIRI(?subject), REPLACE(STR(?subject), "^.*[#/]", ""), STR(?subject))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TestCases_IsBlocking a sh:NodeShape ;
    sh:targetClass pko-extension:TestCase ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_IsBlocking" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isBlocking ?_result .
            }
            WHERE {
    $this a pko-extension:TestCase .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:severity ?severity . OPTIONAL { ?severity erb:key ?severity__key . } }
                BIND((COALESCE(?severity__key, COALESCE(IF(isIRI(?severity), REPLACE(STR(?severity), "^.*[#/]", ""), STR(?severity)), "")) = "blocking") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TestCases_IsPassing a sh:NodeShape ;
    sh:targetClass pko-extension:TestCase ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_IsPassing" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isPassing ?_result .
            }
            WHERE {
    $this a pko-extension:TestCase .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastOutcome ?last_outcome . OPTIONAL { ?last_outcome erb:key ?last_outcome__key . } }
                BIND((COALESCE(?last_outcome__key, COALESCE(IF(isIRI(?last_outcome), REPLACE(STR(?last_outcome), "^.*[#/]", ""), STR(?last_outcome)), "")) = "PASS") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TestCases_IsFailing a sh:NodeShape ;
    sh:targetClass pko-extension:TestCase ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_IsFailing" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFailing ?_result .
            }
            WHERE {
    $this a pko-extension:TestCase .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastOutcome ?last_outcome . OPTIONAL { ?last_outcome erb:key ?last_outcome__key . } }
                BIND((COALESCE(?last_outcome__key, COALESCE(IF(isIRI(?last_outcome), REPLACE(STR(?last_outcome), "^.*[#/]", ""), STR(?last_outcome)), "")) = "FAIL") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TestCases_NeedsAttention a sh:NodeShape ;
    sh:targetClass pko-extension:TestCase ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_NeedsAttention" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:needsAttention ?_result .
            }
            WHERE {
    $this a pko-extension:TestCase .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isBlocking ?is_blocking . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isFailing ?is_failing . }
                BIND((COALESCE(?is_failing, false) && COALESCE(?is_blocking, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TestCases_PassingSuiteKey a sh:NodeShape ;
    sh:targetClass pko-extension:TestCase ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_PassingSuiteKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:passingSuiteKey ?_result .
            }
            WHERE {
    $this a pko-extension:TestCase .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isPassing ?is_passing . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:suite ?suite . }
                BIND(IF(COALESCE(?is_passing, false), ?suite, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TestCases_NeedsAttentionSuiteKey a sh:NodeShape ;
    sh:targetClass pko-extension:TestCase ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_NeedsAttentionSuiteKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:needsAttentionSuiteKey ?_result .
            }
            WHERE {
    $this a pko-extension:TestCase .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:needsAttention ?needs_attention . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:suite ?suite . }
                BIND(IF(COALESCE(?needs_attention, false), ?suite, "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for TestSuites ===
pko-native-procedural-knowledge-rulebook-shapes:TestSuites_Name a sh:NodeShape ;
    sh:targetClass pko-extension:TestSuite ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:TestSuite .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TestSuites_TestCount a sh:NodeShape ;
    sh:targetClass pko-extension:TestSuite ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_TestCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:testCount ?_result .
            }
            WHERE {
    $this a pko-extension:TestSuite .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:TestSuite .
                    ?child a pko-extension:TestCase .
                    ?child pko-native-procedural-knowledge-rulebook:suite $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TestSuites_PassCount a sh:NodeShape ;
    sh:targetClass pko-extension:TestSuite ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_PassCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:passCount ?_result .
            }
            WHERE {
    $this a pko-extension:TestSuite .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:TestSuite .
                    ?child a pko-extension:TestCase .
                    ?child pko-native-procedural-knowledge-rulebook:passingSuiteKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:testSuiteId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TestSuites_BlockingFailCount a sh:NodeShape ;
    sh:targetClass pko-extension:TestSuite ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_BlockingFailCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:blockingFailCount ?_result .
            }
            WHERE {
    $this a pko-extension:TestSuite .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:TestSuite .
                    ?child a pko-extension:TestCase .
                    ?child pko-native-procedural-knowledge-rulebook:needsAttentionSuiteKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:testSuiteId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TestSuites_IsGreen a sh:NodeShape ;
    sh:targetClass pko-extension:TestSuite ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_IsGreen" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isGreen ?_result .
            }
            WHERE {
    $this a pko-extension:TestSuite .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:blockingFailCount ?blocking_fail_count . }
                BIND((COALESCE(?blocking_fail_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Tools ===
pko-native-procedural-knowledge-rulebook-shapes:Tools_Name a sh:NodeShape ;
    sh:targetClass nfdi4ing-metadata4ing:Tool ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Tools_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX nfdi4ing-metadata4ing: <http://w3id.org/nfdi4ing/metadata4ing#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a nfdi4ing-metadata4ing:Tool .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Rules for UserFeedback ===
pko-native-procedural-knowledge-rulebook-shapes:UserFeedback_Name a sh:NodeShape ;
    sh:targetClass pko:UserFeedbackOccurrence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserFeedback_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:UserFeedbackOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:disposition ?disposition . OPTIONAL { ?disposition erb:key ?disposition__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:feedbackText ?feedback_text . }
                BIND(CONCAT(COALESCE(COALESCE(?disposition__key, IF(isIRI(?disposition), REPLACE(STR(?disposition), "^.*[#/]", ""), STR(?disposition))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?feedback_text), 1, 60)), REPLACE(STR(SUBSTR(STR(?feedback_text), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?feedback_text), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:UserFeedback_IsUnactionedProcedureCritique a sh:NodeShape ;
    sh:targetClass pko:UserFeedbackOccurrence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserFeedback_IsUnactionedProcedureCritique" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnactionedProcedureCritique ?_result .
            }
            WHERE {
    $this a pko:UserFeedbackOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:changeRequestKey ?change_request_key . OPTIONAL { ?change_request_key erb:key ?change_request_key__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:disposition ?disposition . OPTIONAL { ?disposition erb:key ?disposition__key . } }
    OPTIONAL { $this pko:feedbackOnProcedure ?feedback_on_procedure . OPTIONAL { ?feedback_on_procedure erb:key ?feedback_on_procedure__key . } }
                BIND((COALESCE((COALESCE(?feedback_on_procedure__key, COALESCE(IF(isIRI(?feedback_on_procedure), REPLACE(STR(?feedback_on_procedure), "^.*[#/]", ""), STR(?feedback_on_procedure)), "")) != ""), false) && COALESCE((COALESCE(?change_request_key__key, COALESCE(IF(isIRI(?change_request_key), REPLACE(STR(?change_request_key), "^.*[#/]", ""), STR(?change_request_key)), "")) = ""), false) && COALESCE((COALESCE(?disposition__key, COALESCE(IF(isIRI(?disposition), REPLACE(STR(?disposition), "^.*[#/]", ""), STR(?disposition)), "")) != "Declined"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:UserFeedback_CollectionFollowUpCount a sh:NodeShape ;
    sh:targetClass pko:UserFeedbackOccurrence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserFeedback_CollectionFollowUpCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:collectionFollowUpCount ?_result .
            }
            WHERE {
    $this a pko:UserFeedbackOccurrence .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:UserFeedbackOccurrence .
                    ?child a pko-extension:CollectedSourceMaterial .
                    ?child pko-native-procedural-knowledge-rulebook:promptedByFeedback $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:UserFeedback_IsTacitSignalNotFedIntoCollection a sh:NodeShape ;
    sh:targetClass pko:UserFeedbackOccurrence ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserFeedback_IsTacitSignalNotFedIntoCollection" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isTacitSignalNotFedIntoCollection ?_result .
            }
            WHERE {
    $this a pko:UserFeedbackOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:collectionFollowUpCount ?collection_follow_up_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:revealsTacitKnowledge ?reveals_tacit_knowledge . }
                BIND((COALESCE(?reveals_tacit_knowledge, false) && COALESCE((COALESCE(?collection_follow_up_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for UserQuestions ===
pko-native-procedural-knowledge-rulebook-shapes:UserQuestions_Name a sh:NodeShape ;
    sh:targetClass pko:UserQuestionOccurrence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserQuestions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:UserQuestionOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:questionText ?question_text . }
                BIND(SUBSTR(STR(?question_text), 1, 70) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:UserQuestions_IsUnaddressedQuestion a sh:NodeShape ;
    sh:targetClass pko:UserQuestionOccurrence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserQuestions_IsUnaddressedQuestion" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnaddressedQuestion ?_result .
            }
            WHERE {
    $this a pko:UserQuestionOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:addressedByResource ?addressed_by_resource . OPTIONAL { ?addressed_by_resource erb:key ?addressed_by_resource__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resolvedByFaq ?resolved_by_faq . OPTIONAL { ?resolved_by_faq erb:key ?resolved_by_faq__key . } }
                BIND((COALESCE((COALESCE(?addressed_by_resource__key, COALESCE(IF(isIRI(?addressed_by_resource), REPLACE(STR(?addressed_by_resource), "^.*[#/]", ""), STR(?addressed_by_resource)), "")) = ""), false) && COALESCE((COALESCE(?resolved_by_faq__key, COALESCE(IF(isIRI(?resolved_by_faq), REPLACE(STR(?resolved_by_faq), "^.*[#/]", ""), STR(?resolved_by_faq)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for VerificationOutcomes ===
pko-native-procedural-knowledge-rulebook-shapes:VerificationOutcomes_Name a sh:NodeShape ;
    sh:targetClass pko-extension:VerificationOutcome ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:VerificationOutcome .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . OPTIONAL { ?step_execution erb:key ?step_execution__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepVerification ?step_verification . OPTIONAL { ?step_verification erb:key ?step_verification__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_execution__key, IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution))), ""), " / ", COALESCE(COALESCE(?step_verification__key, IF(isIRI(?step_verification), REPLACE(STR(?step_verification), "^.*[#/]", ""), STR(?step_verification))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VerificationOutcomes_ExpectedSignalValue a sh:NodeShape ;
    sh:targetClass pko-extension:VerificationOutcome ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_ExpectedSignalValue" ;
