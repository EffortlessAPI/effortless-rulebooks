    OPTIONAL { $this effortless-ntwf:invokedException ?invoked_exception . }
                BIND((REPLACE(COALESCE(STR(?invoked_exception), ""), "^.*#", "") = "exc-unreachable") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsFabricatedAcknowledgement" ;
