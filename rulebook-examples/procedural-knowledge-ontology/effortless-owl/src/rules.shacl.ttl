                $this pko-native-procedural-knowledge-rulebook:isUnwatchedAndUnowned ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasNamedOwner ?has_named_owner . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isBlocking ?is_blocking . }
                BIND((COALESCE(?is_blocking, false) && COALESCE((!(COALESCE(?has_computed_witness, false))), false) && COALESCE((!(COALESCE(?has_named_owner, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_AttestationExposureNote a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_AttestationExposureNote" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:attestationExposureNote ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isBlocking ?is_blocking . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOrphanedBlockingControl ?is_orphaned_blocking_control . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isUnwatchedAndUnowned ?is_unwatched_and_unowned . }
                BIND(IF(COALESCE((!(COALESCE(?is_blocking, false))), false), "", IF(COALESCE(?is_unwatched_and_unowned, false), "Unwatched and unowned: exposure defaults to the signatory.", IF(COALESCE(?is_orphaned_blocking_control, false), "Witnessed but unowned: no named accountability.", IF(COALESCE((!(COALESCE(?has_computed_witness, false))), false), "Owned but unwitnessed: rests on human judgement.", "")))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_UnwatchedUnownedFlag a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 3 ;
    sh:rule [
