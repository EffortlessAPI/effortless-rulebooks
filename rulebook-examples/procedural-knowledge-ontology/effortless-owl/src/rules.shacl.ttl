    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wasSentOutsideBusinessHours ?was_sent_outside_business_hours . }
                BIND((COALESCE(?was_delivered_and_unanswered, false) && COALESCE(?was_sent_outside_business_hours, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageDeliveries_IsWellTimedUnanswered a sh:NodeShape ;
    sh:targetClass pko-extension:MessageDelivery ;
    sh:order 3 ;
