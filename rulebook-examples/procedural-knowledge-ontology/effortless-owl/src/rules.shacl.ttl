    $this a prov:Agent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:agentKind ?agent_kind . OPTIONAL { ?agent_kind erb:key ?agent_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:answerCount ?answer_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:runtimeIntegrationCount ?runtime_integration_count . }
                BIND((COALESCE((COALESCE(?agent_kind__key, COALESCE(IF(isIRI(?agent_kind), REPLACE(STR(?agent_kind), "^.*[#/]", ""), STR(?agent_kind)), "")) = "AIAgent"), false) && COALESCE((COALESCE(?answer_count, 0) > 0), false) && COALESCE((COALESCE(?runtime_integration_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
