            }
            WHERE {
    $this a pko-extension:ProcedureLensView .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?procedure . OPTIONAL { ?procedure erb:key ?procedure__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stakeholderLens ?stakeholder_lens . OPTIONAL { ?stakeholder_lens erb:key ?stakeholder_lens__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), " for ", COALESCE(COALESCE(?stakeholder_lens__key, IF(isIRI(?stakeholder_lens), REPLACE(STR(?stakeholder_lens), "^.*[#/]", ""), STR(?stakeholder_lens))), "")) AS ?_result)
            }
        """ ;
    ] .
