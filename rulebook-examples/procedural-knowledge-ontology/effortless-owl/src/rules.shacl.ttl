            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:acceptedWithoutVocabularyCheck ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
    OPTIONAL { $this effortless-ntwf:isAccepted ?is_accepted . }
    OPTIONAL { $this effortless-ntwf:isModelingChange ?is_modeling_change . }
    OPTIONAL { $this effortless-ntwf:vocabularyPassCount ?vocabulary_pass_count . }
                BIND((COALESCE(?is_accepted, false) && COALESCE(?is_modeling_change, false) && COALESCE((COALESCE(?vocabulary_pass_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_IntegrityCheckCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:integrityCheckCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeIntegrityChecks .
                    ?child effortless-ntwf:modelChangeRequest $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_HumanIntegrityCheckCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:humanIntegrityCheckCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeIntegrityChecks .
                    ?child effortless-ntwf:modelChangeRequest $this .
                    OPTIONAL { ?child effortless-ntwf:checkerKind ?c2 . }
                    FILTER((STR(?c2) = "Human"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_DisjointnessCheckCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:disjointnessCheckCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeIntegrityChecks .
                    ?child effortless-ntwf:modelChangeRequest $this .
                    OPTIONAL { ?child effortless-ntwf:checkKind ?c2 . }
                    FILTER((STR(?c2) = "Disjointness"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_DomainInferenceCheckCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:domainInferenceCheckCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeIntegrityChecks .
                    ?child effortless-ntwf:modelChangeRequest $this .
                    OPTIONAL { ?child effortless-ntwf:checkKind ?c2 . }
                    FILTER((STR(?c2) = "DomainInference"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_RangeConsistencyCheckCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:rangeConsistencyCheckCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeIntegrityChecks .
                    ?child effortless-ntwf:modelChangeRequest $this .
                    OPTIONAL { ?child effortless-ntwf:checkKind ?c2 . }
                    FILTER((STR(?c2) = "RangeConsistency"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_IntegrityDecidedWithoutHuman" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:integrityDecidedWithoutHuman ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
    OPTIONAL { $this effortless-ntwf:humanIntegrityCheckCount ?human_integrity_check_count . }
    OPTIONAL { $this effortless-ntwf:integrityCheckCount ?integrity_check_count . }
    OPTIONAL { $this effortless-ntwf:isAccepted ?is_accepted . }
    OPTIONAL { $this effortless-ntwf:isSchemaChange ?is_schema_change . }
                BIND((COALESCE(?is_accepted, false) && COALESCE(?is_schema_change, false) && COALESCE((COALESCE(?integrity_check_count, 0) > 0), false) && COALESCE((COALESCE(?human_integrity_check_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_SkippedDisjointnessReview" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:skippedDisjointnessReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
    OPTIONAL { $this effortless-ntwf:disjointnessCheckCount ?disjointness_check_count . }
    OPTIONAL { $this effortless-ntwf:isAccepted ?is_accepted . }
    OPTIONAL { $this effortless-ntwf:isSchemaChange ?is_schema_change . }
                BIND((COALESCE(?is_accepted, false) && COALESCE(?is_schema_change, false) && COALESCE((COALESCE(?disjointness_check_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_SkippedDomainInferenceReview" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:skippedDomainInferenceReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
    OPTIONAL { $this effortless-ntwf:domainInferenceCheckCount ?domain_inference_check_count . }
    OPTIONAL { $this effortless-ntwf:isAccepted ?is_accepted . }
    OPTIONAL { $this effortless-ntwf:isSchemaChange ?is_schema_change . }
                BIND((COALESCE(?is_accepted, false) && COALESCE(?is_schema_change, false) && COALESCE((COALESCE(?domain_inference_check_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_SkippedRangeReview" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:skippedRangeReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
    OPTIONAL { $this effortless-ntwf:isAccepted ?is_accepted . }
    OPTIONAL { $this effortless-ntwf:isSchemaChange ?is_schema_change . }
    OPTIONAL { $this effortless-ntwf:rangeConsistencyCheckCount ?range_consistency_check_count . }
                BIND((COALESCE(?is_accepted, false) && COALESCE(?is_schema_change, false) && COALESCE((COALESCE(?range_consistency_check_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_UnresolvedObjectionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unresolvedObjectionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeObjections .
                    ?child effortless-ntwf:modelChangeRequest $this .
                    OPTIONAL { ?child effortless-ntwf:isUnresolved ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_ApprovedOverUnresolvedObjection" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approvedOverUnresolvedObjection ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
    OPTIONAL { $this effortless-ntwf:isAccepted ?is_accepted . }
    OPTIONAL { $this effortless-ntwf:unresolvedObjectionCount ?unresolved_objection_count . }
                BIND((COALESCE(?is_accepted, false) && COALESCE((COALESCE(?unresolved_objection_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ModelCharters ===
effortless-ntwf:ModelChartersShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelCharters ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelCharters_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelCharters .
    OPTIONAL { $this effortless-ntwf:authorityRole ?authority_role . OPTIONAL { ?authority_role effortless-ntwf:__key ?authority_role__key . } }
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
    OPTIONAL { $this effortless-ntwf:stewardRole ?steward_role . OPTIONAL { ?steward_role effortless-ntwf:__key ?steward_role__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " / ", COALESCE(COALESCE(?steward_role__key, IF(isIRI(?steward_role), REPLACE(STR(?steward_role), "^.*[#/]", ""), STR(?steward_role))), ""), " + ", COALESCE(COALESCE(?authority_role__key, IF(isIRI(?authority_role), REPLACE(STR(?authority_role), "^.*[#/]", ""), STR(?authority_role))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelCharters_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelCharters .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelCharters_IsCurrent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelCharters .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . OPTIONAL { ?valid_to effortless-ntwf:__key ?valid_to__key . } }
