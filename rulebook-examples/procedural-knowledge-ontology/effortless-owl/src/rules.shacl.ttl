    $this a pko-native-procedural-knowledge-rulebook:MessageTemplates .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validApprovalCount ?valid_approval_count . }
                BIND((COALESCE(?valid_approval_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageTemplates_IsClaimingUnbackedApproval a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_IsClaimingUnbackedApproval" ;
        sh:construct """
