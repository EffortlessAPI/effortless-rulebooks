pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_HasDeviationNote a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasDeviationNote" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasDeviationNote ?_result .
            }
            WHERE {
    $this a pko:StepExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deviation ?deviation . OPTIONAL { ?deviation erb:key ?deviation__key . } }
                BIND((COALESCE(?deviation__key, COALESCE(IF(isIRI(?deviation), REPLACE(STR(?deviation), "^.*[#/]", ""), STR(?deviation)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_IsLateAndUnexplained a sh:NodeShape ;
