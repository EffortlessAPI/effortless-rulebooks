    ] .
pko-native-procedural-knowledge-rulebook-shapes:TermLabelVariants_IsCrossSchemeDuplicatePref a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:TermLabelVariants ;
    sh:order 3 ;
