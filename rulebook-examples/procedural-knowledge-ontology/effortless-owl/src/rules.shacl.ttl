            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isLive ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Published"), false)) AS ?_result)
            }
        """ ;
    ] .
