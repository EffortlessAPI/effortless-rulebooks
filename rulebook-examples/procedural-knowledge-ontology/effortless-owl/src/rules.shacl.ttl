                $this pko-native-procedural-knowledge-rulebook:filledKnowledgePositionCount ?_result .
            }
            WHERE {
    $this a pko-industry:Department .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-industry:Department .
                    ?child a pko-extension:KnowledgeWorkforcePosition .
                    ?child pko-native-procedural-knowledge-rulebook:organization $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:status_KnowledgeWorkforcePositions ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Filled"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
