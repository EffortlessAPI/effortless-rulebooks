pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_PreviousExecutedStep a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_PreviousExecutedStep" ;
