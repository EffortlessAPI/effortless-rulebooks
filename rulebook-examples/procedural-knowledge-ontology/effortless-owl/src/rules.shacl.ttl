            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:requiresHumanConfirmation ?requires_human_confirmation . }
    OPTIONAL { $this effortless-ntwf:unconfirmedNonHumanDecisionCount ?unconfirmed_non_human_decision_count . }
                BIND((COALESCE(?requires_human_confirmation, false) && COALESCE((COALESCE(?unconfirmed_non_human_decision_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_DraftedFromUnusableSource" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:draftedFromUnusableSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . OPTIONAL { ?execution_status effortless-ntwf:__key ?execution_status__key . } }
    OPTIONAL { $this effortless-ntwf:inputsWereUsable ?inputs_were_usable . }
                BIND((COALESCE((COALESCE(?execution_status__key, COALESCE(IF(isIRI(?execution_status), REPLACE(STR(?execution_status), "^.*[#/]", ""), STR(?execution_status)), "")) = "Completed"), false) && COALESCE((!(COALESCE(?inputs_were_usable, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
