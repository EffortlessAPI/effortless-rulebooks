                BIND((COALESCE((COALESCE(?isolates_energy_source__key, COALESCE(IF(isIRI(?isolates_energy_source), REPLACE(STR(?isolates_energy_source), "^.*[#/]", ""), STR(?isolates_energy_source)), "")) != ""), false) && COALESCE((COALESCE(?required_lock_count, 0) = 0), false)) AS ?_result)
