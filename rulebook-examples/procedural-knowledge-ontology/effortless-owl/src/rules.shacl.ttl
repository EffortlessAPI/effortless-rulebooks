    OPTIONAL { $this effortless-ntwf:procedure ?procedure . OPTIONAL { ?procedure effortless-ntwf:__key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?new_starter__key, IF(isIRI(?new_starter), REPLACE(STR(?new_starter), "^.*[#/]", ""), STR(?new_starter))), ""), " on ", COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), "")) AS ?_result)
