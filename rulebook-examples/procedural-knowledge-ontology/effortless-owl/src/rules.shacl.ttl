    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentIntegrations .
                    ?child effortless-ntwf:agent $this .
                    OPTIONAL { ?child effortless-ntwf:deliveryMode ?c2 . }
                    FILTER((STR(?c2) = "Runtime"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_LacksRuntimeKnowledgeIntegration" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lacksRuntimeKnowledgeIntegration ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:agentKind ?agent_kind . OPTIONAL { ?agent_kind effortless-ntwf:__key ?agent_kind__key . } }
    OPTIONAL { $this effortless-ntwf:answerCount ?answer_count . }
    OPTIONAL { $this effortless-ntwf:runtimeIntegrationCount ?runtime_integration_count . }
                BIND((COALESCE((COALESCE(?agent_kind__key, COALESCE(IF(isIRI(?agent_kind), REPLACE(STR(?agent_kind), "^.*[#/]", ""), STR(?agent_kind)), "")) = "AIAgent"), false) && COALESCE((COALESCE(?answer_count, 0) > 0), false) && COALESCE((COALESCE(?runtime_integration_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
