# === Rules for ExceptionInvocations ===
pko-native-procedural-knowledge-rulebook-shapes:ExceptionInvocations_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ExceptionInvocation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ExceptionInvocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:exception ?exception . OPTIONAL { ?exception erb:key ?exception__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . OPTIONAL { ?step_execution erb:key ?step_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_execution__key, IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution))), ""), " / ", COALESCE(COALESCE(?exception__key, IF(isIRI(?exception), REPLACE(STR(?exception), "^.*[#/]", ""), STR(?exception))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExceptionInvocations_ExpectedHandling a sh:NodeShape ;
    sh:targetClass pko-extension:ExceptionInvocation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ExpectedHandling" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:expectedHandling ?_result .
            }
            WHERE {
    $this a pko-extension:ExceptionInvocation .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:exception ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:Exception . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:handling ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
