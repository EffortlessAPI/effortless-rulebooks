    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_ReceivesApprovalNoticesNow a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ReceivesApprovalNoticesNow" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:receivesApprovalNoticesNow ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:coversNow ?covers_now . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:roleApprovalStepCount ?role_approval_step_count . }
                BIND((COALESCE(?covers_now, false) && COALESCE((COALESCE(?role_approval_step_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for RoleCapabilityTags ===
pko-native-procedural-knowledge-rulebook-shapes:RoleCapabilityTags_Name a sh:NodeShape ;
    sh:targetClass pko-extension:RoleCapabilityTag ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleCapabilityTags_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:RoleCapabilityTag .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:capabilityTerm ?capability_term . OPTIONAL { ?capability_term erb:key ?capability_term__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:role ?role . OPTIONAL { ?role erb:key ?role__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?role__key, IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role))), ""), " can ", COALESCE(COALESCE(?capability_term__key, IF(isIRI(?capability_term), REPLACE(STR(?capability_term), "^.*[#/]", ""), STR(?capability_term))), "")) AS ?_result)
            }
        """ ;
    ] .
