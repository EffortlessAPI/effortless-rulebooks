# === Rules for ConceptLadderRungs ===
pko-native-procedural-knowledge-rulebook-shapes:ConceptLadderRungs_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ConceptLadderRung ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConceptLadderRungs_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ConceptLadderRung .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rungKind ?rung_kind . OPTIONAL { ?rung_kind erb:key ?rung_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:statement ?statement . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " ", COALESCE(COALESCE(?rung_kind__key, IF(isIRI(?rung_kind), REPLACE(STR(?rung_kind), "^.*[#/]", ""), STR(?rung_kind))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?statement), 1, 50)), REPLACE(STR(SUBSTR(STR(?statement), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?statement), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConceptLadderRungs_StepTopLevel a sh:NodeShape ;
    sh:targetClass pko-extension:ConceptLadderRung ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConceptLadderRungs_StepTopLevel" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:stepTopLevel ?_result .
            }
            WHERE {
    $this a pko-extension:ConceptLadderRung .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:ConceptLadderRung .
                    ?child a pko-extension:ConceptLadderRung .
                    ?child pko-native-procedural-knowledge-rulebook:step ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:step ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:ladderLevel ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConceptLadderRungs_IsUltimateGoal a sh:NodeShape ;
    sh:targetClass pko-extension:ConceptLadderRung ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConceptLadderRungs_IsUltimateGoal" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUltimateGoal ?_result .
            }
            WHERE {
    $this a pko-extension:ConceptLadderRung .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ladderLevel ?ladder_level . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepTopLevel ?step_top_level . }
                BIND((COALESCE((COALESCE(?ladder_level, 0) > 0), false) && COALESCE((COALESCE(?ladder_level, 0) = COALESCE(?step_top_level, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConceptLadderRungs_IsDecompositionRung a sh:NodeShape ;
    sh:targetClass pko-extension:ConceptLadderRung ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConceptLadderRungs_IsDecompositionRung" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDecompositionRung ?_result .
            }
            WHERE {
    $this a pko-extension:ConceptLadderRung .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ladderLevel ?ladder_level . }
                BIND((COALESCE(?ladder_level, 0) < 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ConditionChecks ===
pko-native-procedural-knowledge-rulebook-shapes:ConditionChecks_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ConditionCheck ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ConditionCheck .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepCondition ?step_condition . OPTIONAL { ?step_condition erb:key ?step_condition__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . OPTIONAL { ?step_execution erb:key ?step_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_execution__key, IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution))), ""), " / ", COALESCE(COALESCE(?step_condition__key, IF(isIRI(?step_condition), REPLACE(STR(?step_condition), "^.*[#/]", ""), STR(?step_condition))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConditionChecks_ConditionKind a sh:NodeShape ;
    sh:targetClass pko-extension:ConditionCheck ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_ConditionKind" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:conditionKind ?_result .
            }
            WHERE {
    $this a pko-extension:ConditionCheck .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepCondition ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:StepCondition . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:conditionKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConditionChecks_IsFailedPrecondition a sh:NodeShape ;
    sh:targetClass pko-extension:ConditionCheck ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_IsFailedPrecondition" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFailedPrecondition ?_result .
            }
            WHERE {
    $this a pko-extension:ConditionCheck .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conditionKind ?condition_kind . OPTIONAL { ?condition_kind erb:key ?condition_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:held ?held . }
                BIND((COALESCE((COALESCE(?condition_kind__key, COALESCE(IF(isIRI(?condition_kind), REPLACE(STR(?condition_kind), "^.*[#/]", ""), STR(?condition_kind)), "")) = "Precondition"), false) && COALESCE((COALESCE(?held, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConditionChecks_IsViolatedInvariant a sh:NodeShape ;
    sh:targetClass pko-extension:ConditionCheck ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_IsViolatedInvariant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isViolatedInvariant ?_result .
            }
            WHERE {
    $this a pko-extension:ConditionCheck .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conditionKind ?condition_kind . OPTIONAL { ?condition_kind erb:key ?condition_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:held ?held . }
                BIND((COALESCE((COALESCE(?condition_kind__key, COALESCE(IF(isIRI(?condition_kind), REPLACE(STR(?condition_kind), "^.*[#/]", ""), STR(?condition_kind)), "")) = "Invariant"), false) && COALESCE((COALESCE(?held, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConditionChecks_FailedPreconditionExecutionKey a sh:NodeShape ;
    sh:targetClass pko-extension:ConditionCheck ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_FailedPreconditionExecutionKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:failedPreconditionExecutionKey ?_result .
            }
            WHERE {
    $this a pko-extension:ConditionCheck .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isFailedPrecondition ?is_failed_precondition . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_failed_precondition, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConditionChecks_ViolatedInvariantExecutionKey a sh:NodeShape ;
    sh:targetClass pko-extension:ConditionCheck ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_ViolatedInvariantExecutionKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:violatedInvariantExecutionKey ?_result .
            }
            WHERE {
    $this a pko-extension:ConditionCheck .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isViolatedInvariant ?is_violated_invariant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_violated_invariant, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConditionChecks_EnforcedRequirement a sh:NodeShape ;
    sh:targetClass pko-extension:ConditionCheck ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_EnforcedRequirement" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:enforcedRequirement ?_result .
            }
            WHERE {
    $this a pko-extension:ConditionCheck .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepCondition ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:StepCondition . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:enforcesRequirement ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConditionChecks_FailedCheckRequirementKey a sh:NodeShape ;
    sh:targetClass pko-extension:ConditionCheck ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_FailedCheckRequirementKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:failedCheckRequirementKey ?_result .
            }
            WHERE {
    $this a pko-extension:ConditionCheck .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:enforcedRequirement ?enforced_requirement . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:held ?held . }
                BIND(IF(COALESCE((COALESCE(?held, false) = false), false), ?enforced_requirement, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConditionChecks_EnforcedRequirementIsComputed a sh:NodeShape ;
    sh:targetClass pko-extension:ConditionCheck ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_EnforcedRequirementIsComputed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:enforcedRequirementIsComputed ?_result .
            }
            WHERE {
    $this a pko-extension:ConditionCheck .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepCondition ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:StepCondition . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:enforcedRequirementIsComputed ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConditionChecks_EnforcedRequirementStatement a sh:NodeShape ;
    sh:targetClass pko-extension:ConditionCheck ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_EnforcedRequirementStatement" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:enforcedRequirementStatement ?_result .
            }
            WHERE {
    $this a pko-extension:ConditionCheck .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepCondition ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:StepCondition . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:enforcedRequirementStatement ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConditionChecks_IsScoredBreach a sh:NodeShape ;
    sh:targetClass pko-extension:ConditionCheck ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_IsScoredBreach" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isScoredBreach ?_result .
            }
            WHERE {
    $this a pko-extension:ConditionCheck .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:enforcedRequirementIsComputed ?enforced_requirement_is_computed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:held ?held . }
                BIND((COALESCE((COALESCE(?held, false) = false), false) && COALESCE(?enforced_requirement_is_computed, false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ConformanceRuns ===
pko-native-procedural-knowledge-rulebook-shapes:ConformanceRuns_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conformanceRunId ?conformance_run_id . }
                BIND(?conformance_run_id AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConformanceRuns_SubstrateCount a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_SubstrateCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:substrateCount ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceRun .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ConformanceRun .
                    ?child a pko-extension:SubstrateRunScore .
                    ?child pko-native-procedural-knowledge-rulebook:run $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConformanceRuns_PerfectSubstrateCount a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceRun ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_PerfectSubstrateCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:perfectSubstrateCount ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceRun .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ConformanceRun .
                    ?child a pko-extension:SubstrateRunScore .
                    ?child pko-native-procedural-knowledge-rulebook:perfectRunKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:conformanceRunId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConformanceRuns_CellsTested a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_CellsTested" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:cellsTested ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceRun .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:ConformanceRun .
                    ?child a pko-extension:SubstrateRunScore .
                    ?child pko-native-procedural-knowledge-rulebook:run $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:cellsTested ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConformanceRuns_CellsPassed a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_CellsPassed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:cellsPassed ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceRun .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:ConformanceRun .
                    ?child a pko-extension:SubstrateRunScore .
                    ?child pko-native-procedural-knowledge-rulebook:run $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:cellsPassed ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConformanceRuns_CellsFailed a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceRun ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_CellsFailed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:cellsFailed ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsPassed ?cells_passed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsTested ?cells_tested . }
                BIND((?cells_tested - ?cells_passed) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConformanceRuns_OverallScore a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceRun ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_OverallScore" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:overallScore ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsPassed ?cells_passed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsTested ?cells_tested . }
                BIND(IF(COALESCE((COALESCE(?cells_tested, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?cells_passed) / ?cells_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConformanceRuns_ImperfectSubstrateCount a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceRun ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_ImperfectSubstrateCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:imperfectSubstrateCount ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:perfectSubstrateCount ?perfect_substrate_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:substrateCount ?substrate_count . }
                BIND((?substrate_count - ?perfect_substrate_count) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConformanceRuns_IsFullyConformant a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceRun ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_IsFullyConformant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFullyConformant ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:imperfectSubstrateCount ?imperfect_substrate_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:substrateCount ?substrate_count . }
                BIND((COALESCE((COALESCE(?substrate_count, 0) > 0), false) && COALESCE((COALESCE(?imperfect_substrate_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ConformanceSubstrates ===
pko-native-procedural-knowledge-rulebook-shapes:ConformanceSubstrates_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceSubstrate ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceSubstrate .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConformanceSubstrates_IsGraded a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceSubstrate ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_IsGraded" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isGraded ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceSubstrate .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:role_ConformanceSubstrates ?role . OPTIONAL { ?role erb:key ?role__key . } }
                BIND((COALESCE(?role__key, COALESCE(IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role)), "")) = "graded") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConformanceSubstrates_RunCount a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceSubstrate ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_RunCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:runCount ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceSubstrate .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ConformanceSubstrate .
                    ?child a pko-extension:SubstrateRunScore .
                    ?child pko-native-procedural-knowledge-rulebook:substrate $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConformanceSubstrates_LatestCellsTested a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceSubstrate ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_LatestCellsTested" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:latestCellsTested ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceSubstrate .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:ConformanceSubstrate .
                    ?child a pko-extension:SubstrateRunScore .
                    ?child pko-native-procedural-knowledge-rulebook:substrate $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:latestCellsTested ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
