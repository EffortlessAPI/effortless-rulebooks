    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeProjections .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:isPublished ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ConsumerSyncCount" ;
