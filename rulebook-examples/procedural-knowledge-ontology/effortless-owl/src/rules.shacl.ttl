    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lookupTested ?lookup_tested . }
                BIND(IF(COALESCE((COALESCE(?lookup_tested, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?lookup_passed) / ?lookup_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_AggregationScore a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_AggregationScore" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:aggregationScore ?_result .
            }
            WHERE {
    $this a pko-extension:SubstrateRunScore .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:aggregationPassed ?aggregation_passed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:aggregationTested ?aggregation_tested . }
                BIND(IF(COALESCE((COALESCE(?aggregation_tested, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?aggregation_passed) / ?aggregation_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_IsPerfect a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_IsPerfect" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isPerfect ?_result .
            }
            WHERE {
    $this a pko-extension:SubstrateRunScore .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsFailed ?cells_failed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsTested ?cells_tested . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:harnessError ?harness_error . OPTIONAL { ?harness_error erb:key ?harness_error__key . } }
                BIND((COALESCE((COALESCE(?harness_error__key, COALESCE(IF(isIRI(?harness_error), REPLACE(STR(?harness_error), "^.*[#/]", ""), STR(?harness_error)), "")) = ""), false) && COALESCE((COALESCE(?cells_tested, 0) > 0), false) && COALESCE((COALESCE(?cells_failed, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_PerfectRunKey a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_PerfectRunKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:perfectRunKey ?_result .
            }
            WHERE {
    $this a pko-extension:SubstrateRunScore .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isPerfect ?is_perfect . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:run ?run . }
                BIND(IF(COALESCE(?is_perfect, false), ?run, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_IsInLatestRun a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_IsInLatestRun" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isInLatestRun ?_result .
            }
            WHERE {
    $this a pko-extension:SubstrateRunScore .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:run ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:ConformanceRun . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isLatest ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_LatestCellsTested a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_LatestCellsTested" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:latestCellsTested ?_result .
            }
            WHERE {
    $this a pko-extension:SubstrateRunScore .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsTested ?cells_tested . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isInLatestRun ?is_in_latest_run . }
                BIND(IF(COALESCE(?is_in_latest_run, false), ?cells_tested, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_LatestCellsPassed a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_LatestCellsPassed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:latestCellsPassed ?_result .
            }
            WHERE {
    $this a pko-extension:SubstrateRunScore .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsPassed ?cells_passed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isInLatestRun ?is_in_latest_run . }
                BIND(IF(COALESCE(?is_in_latest_run, false), ?cells_passed, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_LatestErrorFlag a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_LatestErrorFlag" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:latestErrorFlag ?_result .
            }
            WHERE {
    $this a pko-extension:SubstrateRunScore .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:harnessError ?harness_error . OPTIONAL { ?harness_error erb:key ?harness_error__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isInLatestRun ?is_in_latest_run . }
                BIND(IF(COALESCE((COALESCE(?is_in_latest_run, false) && COALESCE((COALESCE(?harness_error__key, COALESCE(IF(isIRI(?harness_error), REPLACE(STR(?harness_error), "^.*[#/]", ""), STR(?harness_error)), "")) != ""), false)), false), 1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_SubstrateLabel a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_SubstrateLabel" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:substrateLabel ?_result .
            }
            WHERE {
    $this a pko-extension:SubstrateRunScore .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:substrate ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:ConformanceSubstrate . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for TableConformance ===
pko-native-procedural-knowledge-rulebook-shapes:TableConformance_Name a sh:NodeShape ;
    sh:targetClass pko-extension:TableConformance ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:TableConformance .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rulebookTable ?rulebook_table . OPTIONAL { ?rulebook_table erb:key ?rulebook_table__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:substrate ?substrate . OPTIONAL { ?substrate erb:key ?substrate__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?substrate__key, IF(isIRI(?substrate), REPLACE(STR(?substrate), "^.*[#/]", ""), STR(?substrate))), ""), " / ", COALESCE(COALESCE(?rulebook_table__key, IF(isIRI(?rulebook_table), REPLACE(STR(?rulebook_table), "^.*[#/]", ""), STR(?rulebook_table))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TableConformance_CellsFailed a sh:NodeShape ;
    sh:targetClass pko-extension:TableConformance ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_CellsFailed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:cellsFailed ?_result .
            }
            WHERE {
    $this a pko-extension:TableConformance .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsPassed ?cells_passed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsTested ?cells_tested . }
                BIND((?cells_tested - ?cells_passed) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TableConformance_Score a sh:NodeShape ;
    sh:targetClass pko-extension:TableConformance ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_Score" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:score ?_result .
            }
            WHERE {
    $this a pko-extension:TableConformance .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsPassed ?cells_passed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsTested ?cells_tested . }
                BIND(IF(COALESCE((COALESCE(?cells_tested, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?cells_passed) / ?cells_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TableConformance_IsPerfect a sh:NodeShape ;
    sh:targetClass pko-extension:TableConformance ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_IsPerfect" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isPerfect ?_result .
            }
            WHERE {
    $this a pko-extension:TableConformance .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsFailed ?cells_failed . }
                BIND((COALESCE(?cells_failed, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TableConformance_ImperfectSubstrateKey a sh:NodeShape ;
    sh:targetClass pko-extension:TableConformance ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_ImperfectSubstrateKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:imperfectSubstrateKey ?_result .
            }
            WHERE {
    $this a pko-extension:TableConformance .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isPerfect ?is_perfect . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:substrate ?substrate . }
                BIND(IF(COALESCE(?is_perfect, false), "", ?substrate) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TableConformance_ImperfectTableKey a sh:NodeShape ;
    sh:targetClass pko-extension:TableConformance ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_ImperfectTableKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:imperfectTableKey ?_result .
            }
            WHERE {
    $this a pko-extension:TableConformance .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isPerfect ?is_perfect . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rulebookTable ?rulebook_table . }
                BIND(IF(COALESCE(?is_perfect, false), "", ?rulebook_table) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TableConformance_DisagreeingFieldCount a sh:NodeShape ;
    sh:targetClass pko-extension:TableConformance ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_DisagreeingFieldCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:disagreeingFieldCount ?_result .
            }
            WHERE {
    $this a pko-extension:TableConformance .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:TableConformance .
                    ?child a pko-extension:FieldDisagreement .
                    ?child pko-native-procedural-knowledge-rulebook:tableConformance $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TableConformance_SubstrateLabel a sh:NodeShape ;
    sh:targetClass pko-extension:TableConformance ;
    sh:order 1 ;
    sh:rule [
