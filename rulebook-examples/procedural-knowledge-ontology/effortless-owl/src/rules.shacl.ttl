# === Rules for Attestations ===
pko-native-procedural-knowledge-rulebook-shapes:Attestations_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Attestations ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Attestations .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:attestationId ?attestation_id . OPTIONAL { ?attestation_id erb:key ?attestation_id__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureExecution ?procedure_execution . OPTIONAL { ?procedure_execution erb:key ?procedure_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_execution__key, IF(isIRI(?procedure_execution), REPLACE(STR(?procedure_execution), "^.*[#/]", ""), STR(?procedure_execution))), ""), " / ", COALESCE(COALESCE(?attestation_id__key, IF(isIRI(?attestation_id), REPLACE(STR(?attestation_id), "^.*[#/]", ""), STR(?attestation_id))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Attestations_VersionIsFitNow a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Attestations ;
    sh:order 7 ;
