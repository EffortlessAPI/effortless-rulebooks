pko-native-procedural-knowledge-rulebook-shapes:KnowledgeOutcomeMeasurements_BaselineAccessScore a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeOutcomeMeasurement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_BaselineAccessScore" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:baselineAccessScore ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeOutcomeMeasurement .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:comparisonBaseline ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:KnowledgeOutcomeMeasurement . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:knowledgeAccessScore ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
