    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_SegmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:segmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyMaxMessageLengthAtSend ?policy_max_message_length_at_send . }
    OPTIONAL { $this effortless-ntwf:renderedBodyLength ?rendered_body_length . }
                BIND(ROUND(IF(COALESCE((COALESCE(?rendered_body_length, 0) = 0), false), 0, IF(COALESCE((COALESCE(?rendered_body_length, 0) <= COALESCE(?policy_max_message_length_at_send, 0)), false), 1, (CEIL((?rendered_body_length / ?policy_max_message_length_at_send) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double))))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
