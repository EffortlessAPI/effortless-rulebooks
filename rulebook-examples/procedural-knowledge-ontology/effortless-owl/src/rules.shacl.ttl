pko-native-procedural-knowledge-rulebook-shapes:ModelProposals_IsAiCandidate a sh:NodeShape ;
    sh:targetClass pko-extension:ModelProposal ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelProposals_IsAiCandidate" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
