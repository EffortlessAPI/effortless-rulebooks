pko-native-procedural-knowledge-rulebook-shapes:KnowledgeQueryDefinitions_SourceSystemCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeQueryDefinition ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeQueryDefinitions_SourceSystemCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:sourceSystemCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeQueryDefinition .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:KnowledgeQueryDefinition .
                    ?child a pko-extension:KnowledgeQuerySource .
                    ?child pko-native-procedural-knowledge-rulebook:queryDefinition $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
