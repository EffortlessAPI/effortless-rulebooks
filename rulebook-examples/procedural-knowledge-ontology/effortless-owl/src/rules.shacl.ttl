# === Rules for KnowledgeHoldings ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeHoldings_Name a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeHolding ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeHoldings_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeHolding .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:carrier ?carrier . OPTIONAL { ?carrier erb:key ?carrier__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:snapshot_KnowledgeHoldings ?snapshot . OPTIONAL { ?snapshot erb:key ?snapshot__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:statement ?statement . }
                BIND(CONCAT(COALESCE(COALESCE(?snapshot__key, IF(isIRI(?snapshot), REPLACE(STR(?snapshot), "^.*[#/]", ""), STR(?snapshot))), ""), " ", COALESCE(COALESCE(?carrier__key, IF(isIRI(?carrier), REPLACE(STR(?carrier), "^.*[#/]", ""), STR(?carrier))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?statement), 1, 50)), REPLACE(STR(SUBSTR(STR(?statement), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?statement), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeHoldings_FormalizedFragmentSession a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeHolding ;
