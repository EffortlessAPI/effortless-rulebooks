            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:breakingReleaseWithoutMigrationPlan ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:isBreakingRelease ?is_breaking_release . }
    OPTIONAL { $this effortless-ntwf:migrationPlan ?migration_plan . OPTIONAL { ?migration_plan effortless-ntwf:__key ?migration_plan__key . } }
                BIND((COALESCE(?is_breaking_release, false) && COALESCE((COALESCE(?migration_plan__key, COALESCE(IF(isIRI(?migration_plan), REPLACE(STR(?migration_plan), "^.*[#/]", ""), STR(?migration_plan)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
