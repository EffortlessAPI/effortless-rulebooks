            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:wentUndetectedByPassingSuite ?_result .
            }
            WHERE {
    $this a pko-extension:DriftObservation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:detectedBy ?detected_by . OPTIONAL { ?detected_by erb:key ?detected_by__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:releasePassedValidation ?release_passed_validation . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sinceRelease ?since_release . OPTIONAL { ?since_release erb:key ?since_release__key . } }
                BIND((COALESCE((COALESCE(?since_release__key, COALESCE(IF(isIRI(?since_release), REPLACE(STR(?since_release), "^.*[#/]", ""), STR(?since_release)), "")) != ""), false) && COALESCE(?release_passed_validation, false) && COALESCE((COALESCE(?detected_by__key, COALESCE(IF(isIRI(?detected_by), REPLACE(STR(?detected_by), "^.*[#/]", ""), STR(?detected_by)), "")) != "ValidationSuite"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:DriftObservations_DriftFollowsCleanRelease a sh:NodeShape ;
    sh:targetClass pko-extension:DriftObservation ;
