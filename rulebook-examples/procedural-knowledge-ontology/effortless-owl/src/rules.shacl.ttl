    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ratificationLapsed ?ratification_lapsed . }
                BIND((COALESCE(?is_currently_binding, false) && COALESCE(?ratification_lapsed, false)) AS ?_result)
            }
        """ ;
