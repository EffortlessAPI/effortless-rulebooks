            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:unwitnessedBlockingCount ?_result .
            }
            WHERE {
    $this a p-plan:Step .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a p-plan:Step .
                    ?child a pko-native-procedural-knowledge-rulebook:StepRequirements .
                    ?child pko-native-procedural-knowledge-rulebook:unwitnessedStepKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:stepId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
