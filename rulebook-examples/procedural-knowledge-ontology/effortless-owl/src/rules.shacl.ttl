            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isSendableUnderApproval ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:MessageTemplates .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasBodyDrifted ?has_body_drifted . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasValidApproval ?has_valid_approval . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status_MessageTemplates ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) && COALESCE((COALESCE(?has_valid_approval, false) && COALESCE((!(COALESCE(?has_body_drifted, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] .
