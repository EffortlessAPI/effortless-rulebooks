    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermDefinitions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:TermDefinition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rulebookTable ?rulebook_table . OPTIONAL { ?rulebook_table erb:key ?rulebook_table__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?rulebook_table__key, IF(isIRI(?rulebook_table), REPLACE(STR(?rulebook_table), "^.*[#/]", ""), STR(?rulebook_table))), ""), " definition") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TermDefinitions_DrafterKind a sh:NodeShape ;
    sh:targetClass pko-extension:TermDefinition ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
