            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:expectedSignalValue ?_result .
            }
            WHERE {
    $this a pko-extension:VerificationOutcome .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepVerification ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:StepVerifications . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:expectedSignalValue ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
