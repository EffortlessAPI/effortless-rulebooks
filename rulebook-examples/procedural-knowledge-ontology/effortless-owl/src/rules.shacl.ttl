            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:touchesLiveVersion ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:ProcedureVersions . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isLive ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_IsLiveDecisionBacklog a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsLiveDecisionBacklog" ;
