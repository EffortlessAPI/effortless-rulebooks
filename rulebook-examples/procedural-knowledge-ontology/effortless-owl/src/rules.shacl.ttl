    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:witnessFireCount ?witness_fire_count . }
                BIND((COALESCE(?has_computed_witness, false) && COALESCE((COALESCE(?witness_fire_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_EvaluationSampleSize a sh:NodeShape ;
