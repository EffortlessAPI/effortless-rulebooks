                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:assignedRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_ConsumerWorkflow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:consumerWorkflow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:procedureVersion ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_SourceStepAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceStepAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
                OPTIONAL { $this effortless-ntwf:sourceStep ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:accountableAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_SourceStepAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceStepAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
                OPTIONAL { $this effortless-ntwf:sourceStep ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:assignedAgentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_IsInputFromAiArtifact" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInputFromAiArtifact ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
    OPTIONAL { $this effortless-ntwf:direction ?direction . OPTIONAL { ?direction effortless-ntwf:__key ?direction__key . } }
    OPTIONAL { $this effortless-ntwf:sourceStepAgentKind ?source_step_agent_kind . OPTIONAL { ?source_step_agent_kind effortless-ntwf:__key ?source_step_agent_kind__key . } }
                BIND((COALESCE((COALESCE(?direction__key, COALESCE(IF(isIRI(?direction), REPLACE(STR(?direction), "^.*[#/]", ""), STR(?direction)), "")) = "Input"), false) && COALESCE((COALESCE(?source_step_agent_kind__key, COALESCE(IF(isIRI(?source_step_agent_kind), REPLACE(STR(?source_step_agent_kind), "^.*[#/]", ""), STR(?source_step_agent_kind)), "")) = "AIAgent"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_AiArtifactConsumerHasNoAccountableAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:aiArtifactConsumerHasNoAccountableAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
    OPTIONAL { $this effortless-ntwf:isInputFromAiArtifact ?is_input_from_ai_artifact . }
    OPTIONAL { $this effortless-ntwf:stepAccountableAgent ?step_accountable_agent . OPTIONAL { ?step_accountable_agent effortless-ntwf:__key ?step_accountable_agent__key . } }
                BIND((COALESCE(?is_input_from_ai_artifact, false) && COALESCE((COALESCE(?step_accountable_agent__key, COALESCE(IF(isIRI(?step_accountable_agent), REPLACE(STR(?step_accountable_agent), "^.*[#/]", ""), STR(?step_accountable_agent)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_AiBlastRadiusPath" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:aiBlastRadiusPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
    OPTIONAL { $this effortless-ntwf:consumerRole ?consumer_role . OPTIONAL { ?consumer_role effortless-ntwf:__key ?consumer_role__key . } }
    OPTIONAL { $this effortless-ntwf:consumerWorkflow ?consumer_workflow . OPTIONAL { ?consumer_workflow effortless-ntwf:__key ?consumer_workflow__key . } }
    OPTIONAL { $this effortless-ntwf:isInputFromAiArtifact ?is_input_from_ai_artifact . }
    OPTIONAL { $this effortless-ntwf:label ?label . OPTIONAL { ?label effortless-ntwf:__key ?label__key . } }
    OPTIONAL { $this effortless-ntwf:sourceStepAgent ?source_step_agent . OPTIONAL { ?source_step_agent effortless-ntwf:__key ?source_step_agent__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
    OPTIONAL { $this effortless-ntwf:stepAccountableAgent ?step_accountable_agent . OPTIONAL { ?step_accountable_agent effortless-ntwf:__key ?step_accountable_agent__key . } }
                BIND(IF(COALESCE(?is_input_from_ai_artifact, false), CONCAT(COALESCE(COALESCE(?source_step_agent__key, IF(isIRI(?source_step_agent), REPLACE(STR(?source_step_agent), "^.*[#/]", ""), STR(?source_step_agent))), ""), " produces ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), ""), " for ", COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), "; role ", COALESCE(COALESCE(?consumer_role__key, IF(isIRI(?consumer_role), REPLACE(STR(?consumer_role), "^.*[#/]", ""), STR(?consumer_role))), ""), "; agent ", COALESCE(COALESCE(?step_accountable_agent__key, IF(isIRI(?step_accountable_agent), REPLACE(STR(?step_accountable_agent), "^.*[#/]", ""), STR(?step_accountable_agent))), ""), "; workflow ", COALESCE(COALESCE(?consumer_workflow__key, IF(isIRI(?consumer_workflow), REPLACE(STR(?consumer_workflow), "^.*[#/]", ""), STR(?consumer_workflow))), "")), "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepVerifications ===
effortless-ntwf:StepVerificationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepVerifications ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVerifications_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVerifications .
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
    OPTIONAL { $this effortless-ntwf:verificationKind ?verification_kind . OPTIONAL { ?verification_kind effortless-ntwf:__key ?verification_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?verification_kind__key, IF(isIRI(?verification_kind), REPLACE(STR(?verification_kind), "^.*[#/]", ""), STR(?verification_kind))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Steps ===
effortless-ntwf:StepsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Steps ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:stepNumber ?step_number . OPTIONAL { ?step_number effortless-ntwf:__key ?step_number__key . } }
    OPTIONAL { $this effortless-ntwf:title ?title . OPTIONAL { ?title effortless-ntwf:__key ?title__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_number__key, IF(isIRI(?step_number), REPLACE(STR(?step_number), "^.*[#/]", ""), STR(?step_number))), ""), ". ", COALESCE(COALESCE(?title__key, IF(isIRI(?title), REPLACE(STR(?title), "^.*[#/]", ""), STR(?title))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_AssignedRoleLabel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assignedRoleLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                OPTIONAL { $this effortless-ntwf:assignedRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_AssignedAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assignedAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                OPTIONAL { $this effortless-ntwf:assignedRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:currentAgentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_BlockingRequirementCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:blockingRequirementCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepRequirements .
                    ?child effortless-ntwf:blockingStepKey ?backfk .
                    $this effortless-ntwf:stepId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_StaleBindingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:staleBindingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:OperationalBindings .
                    ?child effortless-ntwf:staleBindingStepKey ?backfk .
                    $this effortless-ntwf:stepId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_AuthoritativeStaleCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:authoritativeStaleCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:OperationalBindings .
                    ?child effortless-ntwf:authoritativeStaleStepKey ?backfk .
                    $this effortless-ntwf:stepId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_AvailableExceptionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
