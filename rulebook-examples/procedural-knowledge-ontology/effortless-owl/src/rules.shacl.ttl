            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:cueRequiresEscalation ?_result .
            }
            WHERE {
    $this a pko-extension:CueObservation .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepCue ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:StepCue . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:requiresEscalation ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
