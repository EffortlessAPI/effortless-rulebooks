            }
            WHERE {
    $this a pko-extension:DeliveredCommunication .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authorizingStepExecution ?authorizing_step_execution . OPTIONAL { ?authorizing_step_execution erb:key ?authorizing_step_execution__key . } }
                BIND((COALESCE(?authorizing_step_execution__key, COALESCE(IF(isIRI(?authorizing_step_execution), REPLACE(STR(?authorizing_step_execution), "^.*[#/]", ""), STR(?authorizing_step_execution)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:DeliveredCommunications_ContentMatchesApproval a sh:NodeShape ;
    sh:targetClass pko-extension:DeliveredCommunication ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_ContentMatchesApproval" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:contentMatchesApproval ?_result .
            }
            WHERE {
    $this a pko-extension:DeliveredCommunication .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:approvedContentHash ?approved_content_hash . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:renderedContentHash ?rendered_content_hash . }
                BIND(COALESCE((?rendered_content_hash = ?approved_content_hash), ((!BOUND(?rendered_content_hash) || STR(?rendered_content_hash) = "") && (!BOUND(?approved_content_hash) || STR(?approved_content_hash) = ""))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:DeliveredCommunications_AuthorizedAt a sh:NodeShape ;
    sh:targetClass pko-extension:DeliveredCommunication ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_AuthorizedAt" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:authorizedAt ?_result .
            }
            WHERE {
    $this a pko-extension:DeliveredCommunication .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authorizingStepExecution ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:StepExecution . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:endedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:DeliveredCommunications_WasApprovedBeforeSending a sh:NodeShape ;
    sh:targetClass pko-extension:DeliveredCommunication ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_WasApprovedBeforeSending" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:wasApprovedBeforeSending ?_result .
            }
            WHERE {
    $this a pko-extension:DeliveredCommunication .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authorizedAt ?authorized_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sentAt ?sent_at . }
                BIND(COALESCE((?authorized_at <= ?sent_at), ((!BOUND(?authorized_at) || STR(?authorized_at) = "") && (!BOUND(?sent_at) || STR(?sent_at) = ""))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:DeliveredCommunications_IsDefensible a sh:NodeShape ;
    sh:targetClass pko-extension:DeliveredCommunication ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_IsDefensible" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDefensible ?_result .
            }
            WHERE {
    $this a pko-extension:DeliveredCommunication .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:contentMatchesApproval ?content_matches_approval . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasAuthorization ?has_authorization . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wasApprovedBeforeSending ?was_approved_before_sending . }
                BIND((COALESCE(?has_authorization, false) && COALESCE(?content_matches_approval, false) && COALESCE(?was_approved_before_sending, false)) AS ?_result)
            }
        """ ;
    ] .

