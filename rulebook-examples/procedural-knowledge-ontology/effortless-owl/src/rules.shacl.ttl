            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:altLabelPractitionerMentionCount ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:VocabularyTerm .
                    ?child a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
                    ?child pko-native-procedural-knowledge-rulebook:vocabularyTerm $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:labelKind ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:practitionerMentionCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "alt"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_IsOrganizedAroundOfficialTerm a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_IsOrganizedAroundOfficialTerm" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOrganizedAroundOfficialTerm ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:altLabelPractitionerMentionCount ?alt_label_practitioner_mention_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:prefLabelPractitionerMentionCount ?pref_label_practitioner_mention_count . }
                BIND((COALESCE((COALESCE(?alt_label_practitioner_mention_count, 0) >= 2), false) && COALESCE((COALESCE(?alt_label_practitioner_mention_count, 0) > COALESCE(?pref_label_practitioner_mention_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_SourcePhrasingCount a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_SourcePhrasingCount" ;
