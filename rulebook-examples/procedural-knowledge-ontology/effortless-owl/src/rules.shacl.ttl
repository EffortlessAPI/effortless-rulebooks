    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOutsourced ?is_outsourced . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isStrategicallyVital ?is_strategically_vital . }
                BIND((COALESCE((COALESCE(?is_outsourced, false) || COALESCE(?is_strategically_vital, false)), false) && COALESCE((COALESCE(?audit_item_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
