    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_BreakingReleaseWithUnrevalidatedConsumers" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:breakingReleaseWithUnrevalidatedConsumers ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:consumerCount ?consumer_count . }
    OPTIONAL { $this effortless-ntwf:isBreakingRelease ?is_breaking_release . }
    OPTIONAL { $this effortless-ntwf:revalidatedConsumerCount ?revalidated_consumer_count . }
                BIND((COALESCE(?is_breaking_release, false) && COALESCE((COALESCE(?revalidated_consumer_count, 0) < COALESCE(?consumer_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
