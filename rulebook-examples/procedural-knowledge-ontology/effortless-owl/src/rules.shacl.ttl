            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:canonicalVersion ?_result .
            }
            WHERE {
    $this a pko-extension:ConsumerSystemSync .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:loadedProcedure ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:Procedures . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:currentVersionKey ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConsumerSystemSyncs_CanonicalVersionModifiedAt a sh:NodeShape ;
    sh:targetClass pko-extension:ConsumerSystemSync ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_CanonicalVersionModifiedAt" ;
        sh:construct """
