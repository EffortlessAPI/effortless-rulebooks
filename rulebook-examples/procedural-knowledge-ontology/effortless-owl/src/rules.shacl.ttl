    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_MatchingDistinctionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:matchingDistinctionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureFacetAssignments .
                    ?child effortless-ntwf:procedure $this .
                    OPTIONAL { ?child effortless-ntwf:facet ?c2 . }
                    OPTIONAL { $this effortless-ntwf:typeDistinguishingFacet ?p2 . }
                    OPTIONAL { ?child effortless-ntwf:facetValue ?c4 . }
                    OPTIONAL { $this effortless-ntwf:typeDistinguishingValue ?p4 . }
                    FILTER(REPLACE(STR(?c2), "^.*[#/]", "") = REPLACE(STR(?p2), "^.*[#/]", ""))
                    FILTER(REPLACE(STR(?c4), "^.*[#/]", "") = REPLACE(STR(?p4), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_LacksTypeDistinction" ;
