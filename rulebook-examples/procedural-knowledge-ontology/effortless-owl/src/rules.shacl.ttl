pko-native-procedural-knowledge-rulebook-shapes:CollectedSourceMaterials_IsPracticeEvidence a sh:NodeShape ;
    sh:targetClass pko-extension:CollectedSourceMaterial ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_IsPracticeEvidence" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isPracticeEvidence ?_result .
            }
            WHERE {
    $this a pko-extension:CollectedSourceMaterial .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:materialKind ?material_kind . OPTIONAL { ?material_kind erb:key ?material_kind__key . } }
                BIND((COALESCE((COALESCE(?material_kind__key, COALESCE(IF(isIRI(?material_kind), REPLACE(STR(?material_kind), "^.*[#/]", ""), STR(?material_kind)), "")) = "FieldNotes"), false) || COALESCE((COALESCE(?material_kind__key, COALESCE(IF(isIRI(?material_kind), REPLACE(STR(?material_kind), "^.*[#/]", ""), STR(?material_kind)), "")) = "MinedEventTrace"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CollectedSourceMaterials_IsCapturedInFlowOfWork a sh:NodeShape ;
    sh:targetClass pko-extension:CollectedSourceMaterial ;
