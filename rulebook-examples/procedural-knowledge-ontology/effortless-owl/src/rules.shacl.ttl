            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnsecuredGovernanceRecord ?_result .
            }
            WHERE {
    $this a pko-extension:RulebookTable .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:policyCount ?policy_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:subjectArea ?subject_area . OPTIONAL { ?subject_area erb:key ?subject_area__key . } }
                BIND((COALESCE((COALESCE(?subject_area__key, COALESCE(IF(isIRI(?subject_area), REPLACE(STR(?subject_area), "^.*[#/]", ""), STR(?subject_area)), "")) = "governance"), false) && COALESCE((COALESCE(?policy_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RulebookTables_UnrestrictedNonAdminPolicyCount a sh:NodeShape ;
    sh:targetClass pko-extension:RulebookTable ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_UnrestrictedNonAdminPolicyCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:unrestrictedNonAdminPolicyCount ?_result .
            }
            WHERE {
    $this a pko-extension:RulebookTable .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:RulebookTable .
                    ?child a pko-extension:AccessPolicy .
                    ?child pko-native-procedural-knowledge-rulebook:targetTable $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isUnrestrictedNonAdminGrant ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
