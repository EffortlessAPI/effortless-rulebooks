                BIND((COALESCE((!(COALESCE(?is_cleared_to_send, false))), false) && COALESCE((!(COALESCE(?refusal_was_escalated, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
