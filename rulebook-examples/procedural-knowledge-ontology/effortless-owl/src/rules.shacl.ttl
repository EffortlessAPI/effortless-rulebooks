    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_LengthGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lengthGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentMaxSegments ?intent_max_segments . }
    OPTIONAL { $this effortless-ntwf:proposedBodyLength ?proposed_body_length . }
    OPTIONAL { $this effortless-ntwf:proposedSegmentCount ?proposed_segment_count . }
                BIND((COALESCE((COALESCE(?proposed_body_length, 0) > 0), false) && COALESCE((COALESCE(?proposed_segment_count, 0) <= COALESCE(?intent_max_segments, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentRequiredOptOutPhrase" ;
