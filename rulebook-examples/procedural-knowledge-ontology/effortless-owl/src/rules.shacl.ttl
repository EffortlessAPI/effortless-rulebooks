                $this effortless-ntwf:isFabricatedAcknowledgement ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isAcknowledged ?is_acknowledged . }
    OPTIONAL { $this effortless-ntwf:recipientIsUnreachable ?recipient_is_unreachable . }
                BIND((COALESCE(?recipient_is_unreachable, false) && COALESCE(?is_acknowledged, false)) AS ?_result)
            }
