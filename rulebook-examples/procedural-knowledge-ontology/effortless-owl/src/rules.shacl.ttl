pko-native-procedural-knowledge-rulebook-shapes:RulebookTables_IsUnsecuredGovernanceRecord a sh:NodeShape ;
    sh:targetClass pko-extension:RulebookTable ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_IsUnsecuredGovernanceRecord" ;
