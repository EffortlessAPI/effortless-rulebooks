    $this a pko:Transition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isUnrehearsedControlEntry ?is_unrehearsed_control_entry . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_unrehearsed_control_entry, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_FromStepIsHumanApprovalGate a sh:NodeShape ;
