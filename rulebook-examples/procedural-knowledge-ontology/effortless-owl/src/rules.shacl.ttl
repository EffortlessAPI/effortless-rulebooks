                BIND((COALESCE(?diverged_from_specification, false) && COALESCE((COALESCE(?ungoverned_divergence_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_ComputedlyWitnessedControlCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ComputedlyWitnessedControlCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
