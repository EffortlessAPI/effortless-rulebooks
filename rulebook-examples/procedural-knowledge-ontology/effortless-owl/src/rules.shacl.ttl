    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:retryIntent ?retry_intent . OPTIONAL { ?retry_intent erb:key ?retry_intent__key . } }
                BIND((COALESCE(?retry_intent__key, COALESCE(IF(isIRI(?retry_intent), REPLACE(STR(?retry_intent), "^.*[#/]", ""), STR(?retry_intent)), "")) != "") AS ?_result)
