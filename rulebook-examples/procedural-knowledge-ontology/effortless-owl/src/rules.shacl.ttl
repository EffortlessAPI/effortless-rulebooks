                $this effortless-ntwf:intentRequiredOptOutPhrase ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:requiredOptOutPhrase ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_OptOutGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:optOutGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentMaxMessageLength ?intent_max_message_length . }
    OPTIONAL { $this effortless-ntwf:intentRequiredOptOutPhrase ?intent_required_opt_out_phrase . OPTIONAL { ?intent_required_opt_out_phrase effortless-ntwf:__key ?intent_required_opt_out_phrase__key . } }
    OPTIONAL { $this effortless-ntwf:proposedOptOutPosition ?proposed_opt_out_position . }
                BIND((COALESCE((COALESCE(?intent_required_opt_out_phrase__key, COALESCE(IF(isIRI(?intent_required_opt_out_phrase), REPLACE(STR(?intent_required_opt_out_phrase), "^.*[#/]", ""), STR(?intent_required_opt_out_phrase)), "")) = ""), false) || COALESCE((COALESCE((COALESCE(?proposed_opt_out_position, 0) > 0), false) && COALESCE((COALESCE(?proposed_opt_out_position, 0) <= COALESCE(?intent_max_message_length, 0)), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ContentGatePassed" ;
