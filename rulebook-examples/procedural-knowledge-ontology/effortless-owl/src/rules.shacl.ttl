    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE(?is_within_retention_window, false)) AS ?_result)
            }
