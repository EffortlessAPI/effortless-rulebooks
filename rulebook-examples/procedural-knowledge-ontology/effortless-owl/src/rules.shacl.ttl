    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:capturedDuringExecution ?captured_during_execution . OPTIONAL { ?captured_during_execution erb:key ?captured_during_execution__key . } }
                BIND((COALESCE(?captured_during_execution__key, COALESCE(IF(isIRI(?captured_during_execution), REPLACE(STR(?captured_during_execution), "^.*[#/]", ""), STR(?captured_during_execution)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CollectedSourceMaterials_DependentTraceCount a sh:NodeShape ;
    sh:targetClass pko-extension:CollectedSourceMaterial ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_DependentTraceCount" ;
