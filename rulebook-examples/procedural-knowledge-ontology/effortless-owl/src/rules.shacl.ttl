            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isRegulatoryRequirement ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:regulatoryFramework ?regulatory_framework . OPTIONAL { ?regulatory_framework erb:key ?regulatory_framework__key . } }
                BIND((COALESCE(?regulatory_framework__key, COALESCE(IF(isIRI(?regulatory_framework), REPLACE(STR(?regulatory_framework), "^.*[#/]", ""), STR(?regulatory_framework)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_ConstraintTraceCount a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_ConstraintTraceCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:constraintTraceCount ?_result .
            }
            WHERE {
    $this a pko:Requirement .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:Requirement .
                    ?child a pko-native-procedural-knowledge-rulebook:KnowledgeTraces .
                    ?child pko-native-procedural-knowledge-rulebook:requirement $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:targetKind_KnowledgeTraces ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Constraint"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_IsUntracedBoundConstraint a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsUntracedBoundConstraint" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUntracedBoundConstraint ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:constraintTraceCount ?constraint_trace_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isBoundToAnyStep ?is_bound_to_any_step . }
                BIND((COALESCE(?is_bound_to_any_step, false) && COALESCE((COALESCE(?constraint_trace_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_RecordedPassCount a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_RecordedPassCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:recordedPassCount ?_result .
            }
            WHERE {
    $this a pko:Requirement .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko:Requirement .
                    ?child a pko-native-procedural-knowledge-rulebook:StepRequirements .
                    ?child pko-native-procedural-knowledge-rulebook:requirement $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:passCountOnStep ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_IsPassedButNeverEvaluated a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsPassedButNeverEvaluated" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isPassedButNeverEvaluated ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isInoperativeControl ?is_inoperative_control . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recordedPassCount ?recorded_pass_count . }
                BIND((COALESCE(?is_inoperative_control, false) && COALESCE((COALESCE(?recorded_pass_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_FailedCheckCount a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_FailedCheckCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:failedCheckCount ?_result .
            }
            WHERE {
    $this a pko:Requirement .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:Requirement .
                    ?child a pko-extension:ConditionCheck .
                    ?child pko-native-procedural-knowledge-rulebook:failedCheckRequirementKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:requirementId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_IsBreachedButNeverFailed a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsBreachedButNeverFailed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isBreachedButNeverFailed ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:failedCheckCount ?failed_check_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasEverProducedNegative ?has_ever_produced_negative . }
                BIND((COALESCE((COALESCE(?failed_check_count, 0) > 0), false) && COALESCE((!(COALESCE(?has_ever_produced_negative, false))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Resources ===
pko-native-procedural-knowledge-rulebook-shapes:Resources_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Resources ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Resources .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Resources_IsApprovedSource a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Resources ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_IsApprovedSource" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isApprovedSource ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Resources .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:approvalStatus ?approval_status . OPTIONAL { ?approval_status erb:key ?approval_status__key . } }
                BIND((COALESCE(?approval_status__key, COALESCE(IF(isIRI(?approval_status), REPLACE(STR(?approval_status), "^.*[#/]", ""), STR(?approval_status)), "")) = "Approved") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Resources_SourceModifiedAt a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Resources ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_SourceModifiedAt" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:sourceModifiedAt ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Resources .
                OPTIONAL { $this pko:wasExtractedFrom ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:Resources . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:modifiedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Resources_IsStaleExtraction a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Resources ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_IsStaleExtraction" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isStaleExtraction ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Resources .
    OPTIONAL { $this pko:wasExtractedFrom ?extracted_from_resource . OPTIONAL { ?extracted_from_resource erb:key ?extracted_from_resource__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modifiedAt ?modified_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceModifiedAt ?source_modified_at . }
                BIND((COALESCE((COALESCE(?extracted_from_resource__key, COALESCE(IF(isIRI(?extracted_from_resource), REPLACE(STR(?extracted_from_resource), "^.*[#/]", ""), STR(?extracted_from_resource)), "")) != ""), false) && COALESCE(COALESCE((?source_modified_at > ?modified_at), false), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Resources_ReferencingStepCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Resources ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_ReferencingStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:referencingStepCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Resources .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:Resources .
                    ?child a pko-extension:StepResource .
                    ?child pko-native-procedural-knowledge-rulebook:resource $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Resources_ReferencingVersionCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Resources ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_ReferencingVersionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:referencingVersionCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Resources .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:Resources .
                    ?child a pko-native-procedural-knowledge-rulebook:ProcedureResources .
                    ?child pko-native-procedural-knowledge-rulebook:resource $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Resources_IsUnusedResource a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Resources ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_IsUnusedResource" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnusedResource ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Resources .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:referencingStepCount ?referencing_step_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:referencingVersionCount ?referencing_version_count . }
                BIND((COALESCE((COALESCE(?referencing_step_count, 0) = 0), false) && COALESCE((COALESCE(?referencing_version_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Resources_IsContentWithoutOrganization a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Resources ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_IsContentWithoutOrganization" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isContentWithoutOrganization ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Resources .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:artifactTypeConcept ?artifact_type_concept . OPTIONAL { ?artifact_type_concept erb:key ?artifact_type_concept__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:description ?description . OPTIONAL { ?description erb:key ?description__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:keywords ?keywords . OPTIONAL { ?keywords erb:key ?keywords__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:referencingStepCount ?referencing_step_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:referencingVersionCount ?referencing_version_count . }
                BIND((COALESCE((COALESCE(?description__key, COALESCE(IF(isIRI(?description), REPLACE(STR(?description), "^.*[#/]", ""), STR(?description)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?artifact_type_concept__key, COALESCE(IF(isIRI(?artifact_type_concept), REPLACE(STR(?artifact_type_concept), "^.*[#/]", ""), STR(?artifact_type_concept)), "")) = ""), false) || COALESCE((COALESCE(?keywords__key, COALESCE(IF(isIRI(?keywords), REPLACE(STR(?keywords), "^.*[#/]", ""), STR(?keywords)), "")) = ""), false) || COALESCE((COALESCE((?referencing_step_count + ?referencing_version_count), 0) = 0), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Resources_TrailingPracticeCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Resources ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_TrailingPracticeCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:trailingPracticeCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Resources .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:Resources .
                    ?child a pko-native-procedural-knowledge-rulebook:KnowledgeTraces .
                    ?child pko-native-procedural-knowledge-rulebook:contradictedDocument $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isDocumentTrailingPractice ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Resources_IsBehindCurrentPractice a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Resources ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_IsBehindCurrentPractice" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isBehindCurrentPractice ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Resources .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:trailingPracticeCount ?trailing_practice_count . }
                BIND((COALESCE(?trailing_practice_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for RetrievalSegments ===
pko-native-procedural-knowledge-rulebook-shapes:RetrievalSegments_Name a sh:NodeShape ;
    sh:targetClass pko-extension:RetrievalSegment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RetrievalSegments_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:RetrievalSegment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:retrievalSegmentId ?retrieval_segment_id . OPTIONAL { ?retrieval_segment_id erb:key ?retrieval_segment_id__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:segmentText ?segment_text . }
                BIND(CONCAT(COALESCE(COALESCE(?retrieval_segment_id__key, IF(isIRI(?retrieval_segment_id), REPLACE(STR(?retrieval_segment_id), "^.*[#/]", ""), STR(?retrieval_segment_id))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?segment_text), 1, 50)), REPLACE(STR(SUBSTR(STR(?segment_text), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?segment_text), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RetrievalSegments_AuthorAgentKind a sh:NodeShape ;
    sh:targetClass pko-extension:RetrievalSegment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RetrievalSegments_AuthorAgentKind" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:authorAgentKind ?_result .
            }
            WHERE {
    $this a pko-extension:RetrievalSegment .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authoredByAgent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RetrievalSegments_RelatedFromCount a sh:NodeShape ;
    sh:targetClass pko-extension:RetrievalSegment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RetrievalSegments_RelatedFromCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:relatedFromCount ?_result .
            }
            WHERE {
    $this a pko-extension:RetrievalSegment .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:RetrievalSegment .
                    ?child a pko-extension:RetrievalSegment .
                    ?child pko-native-procedural-knowledge-rulebook:relatedSegment $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RetrievalSegments_IsIsolatedChunk a sh:NodeShape ;
    sh:targetClass pko-extension:RetrievalSegment ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RetrievalSegments_IsIsolatedChunk" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isIsolatedChunk ?_result .
            }
            WHERE {
    $this a pko-extension:RetrievalSegment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:applicabilityCondition ?applicability_condition . OPTIONAL { ?applicability_condition erb:key ?applicability_condition__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:positionInProcess ?position_in_process . OPTIONAL { ?position_in_process erb:key ?position_in_process__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:relatedFromCount ?related_from_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:relatedSegment ?related_segment . OPTIONAL { ?related_segment erb:key ?related_segment__key . } }
                BIND((COALESCE((COALESCE(?position_in_process__key, COALESCE(IF(isIRI(?position_in_process), REPLACE(STR(?position_in_process), "^.*[#/]", ""), STR(?position_in_process)), "")) = ""), false) && COALESCE((COALESCE(?applicability_condition__key, COALESCE(IF(isIRI(?applicability_condition), REPLACE(STR(?applicability_condition), "^.*[#/]", ""), STR(?applicability_condition)), "")) = ""), false) && COALESCE((COALESCE(?related_segment__key, COALESCE(IF(isIRI(?related_segment), REPLACE(STR(?related_segment), "^.*[#/]", ""), STR(?related_segment)), "")) = ""), false) && COALESCE((COALESCE(?related_from_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RetrievalSegments_ContradictedIsIndexed a sh:NodeShape ;
