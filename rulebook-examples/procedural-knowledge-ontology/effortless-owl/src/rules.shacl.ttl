    OPTIONAL { $this effortless-ntwf:isModelingChange ?is_modeling_change . }
    OPTIONAL { $this effortless-ntwf:structuralPassCount ?structural_pass_count . }
                BIND((COALESCE(?is_accepted, false) && COALESCE(?is_modeling_change, false) && COALESCE((COALESCE(?structural_pass_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_AcceptedWithoutVocabularyCheck" ;
        sh:prefixes effortless-ntwf: ;
