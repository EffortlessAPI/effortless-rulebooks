# === Rules for StepFunctions ===
pko-native-procedural-knowledge-rulebook-shapes:StepFunctions_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepFunctions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepFunctions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepFunctions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:function ?function . OPTIONAL { ?function erb:key ?function__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?function__key, IF(isIRI(?function), REPLACE(STR(?function), "^.*[#/]", ""), STR(?function))), "")) AS ?_result)
            }
        """ ;
    ] .

