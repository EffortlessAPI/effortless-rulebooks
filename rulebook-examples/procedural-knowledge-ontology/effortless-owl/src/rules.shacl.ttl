pko-native-procedural-knowledge-rulebook-shapes:ChangeValidationRuns_ExpectedChainCount a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeValidationRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeValidationRuns_ExpectedChainCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:expectedChainCount ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeValidationRun .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ChangeValidationRun .
                    ?child a pko-extension:ExpectedInferenceCheck .
                    ?child pko-native-procedural-knowledge-rulebook:changeValidationRun $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeValidationRuns_UnproducedChainCount a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeValidationRun ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeValidationRuns_UnproducedChainCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:unproducedChainCount ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeValidationRun .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ChangeValidationRun .
                    ?child a pko-extension:ExpectedInferenceCheck .
                    ?child pko-native-procedural-knowledge-rulebook:changeValidationRun $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isUnproduced ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeValidationRuns_HasUninspectedFailures a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeValidationRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeValidationRuns_HasUninspectedFailures" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasUninspectedFailures ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeValidationRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:failureCount ?failure_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:failuresInspectedAt ?failures_inspected_at . OPTIONAL { ?failures_inspected_at erb:key ?failures_inspected_at__key . } }
                BIND((COALESCE((COALESCE(?failure_count, 0) > 0), false) && COALESCE((COALESCE(?failures_inspected_at__key, COALESCE(IF(isIRI(?failures_inspected_at), REPLACE(STR(?failures_inspected_at), "^.*[#/]", ""), STR(?failures_inspected_at)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeValidationRuns_IsUnconfirmedConsistency a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeValidationRun ;
