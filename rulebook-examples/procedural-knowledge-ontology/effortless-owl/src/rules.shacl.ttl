# === Rules for ProviderEngagements ===
pko-native-procedural-knowledge-rulebook-shapes:ProviderEngagements_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ProviderEngagement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ProviderEngagement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:clientOrganization ?client_organization . OPTIONAL { ?client_organization erb:key ?client_organization__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:provider ?provider . OPTIONAL { ?provider erb:key ?provider__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?client_organization__key, IF(isIRI(?client_organization), REPLACE(STR(?client_organization), "^.*[#/]", ""), STR(?client_organization))), ""), " <- ", COALESCE(COALESCE(?provider__key, IF(isIRI(?provider), REPLACE(STR(?provider), "^.*[#/]", ""), STR(?provider))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProviderEngagements_IsActive a sh:NodeShape ;
    sh:targetClass pko-extension:ProviderEngagement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_IsActive" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isActive ?_result .
            }
            WHERE {
    $this a pko-extension:ProviderEngagement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status_ProviderEngagements ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Active") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProviderEngagements_ReliedDependencyCount a sh:NodeShape ;
    sh:targetClass pko-extension:ProviderEngagement ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_ReliedDependencyCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:reliedDependencyCount ?_result .
            }
            WHERE {
    $this a pko-extension:ProviderEngagement .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ProviderEngagement .
                    ?child a pko-extension:KnowledgeAuditItem .
                    ?child pko-native-procedural-knowledge-rulebook:providerHoldingKnowledge ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:provider ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:clientOrganization ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:clientOrganization ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isKnowledgeDependency ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProviderEngagements_IsUnplannedKnowledgeReturn a sh:NodeShape ;
    sh:targetClass pko-extension:ProviderEngagement ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_IsUnplannedKnowledgeReturn" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnplannedKnowledgeReturn ?_result .
            }
            WHERE {
    $this a pko-extension:ProviderEngagement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:documentationOwnership ?documentation_ownership . OPTIONAL { ?documentation_ownership erb:key ?documentation_ownership__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeReturnPlan ?knowledge_return_plan . OPTIONAL { ?knowledge_return_plan erb:key ?knowledge_return_plan__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reliedDependencyCount ?relied_dependency_count . }
                BIND((COALESCE((COALESCE(?relied_dependency_count, 0) > 0), false) && COALESCE((COALESCE(?documentation_ownership__key, COALESCE(IF(isIRI(?documentation_ownership), REPLACE(STR(?documentation_ownership), "^.*[#/]", ""), STR(?documentation_ownership)), "")) = "ProviderIP"), false) && COALESCE((COALESCE(?knowledge_return_plan__key, COALESCE(IF(isIRI(?knowledge_return_plan), REPLACE(STR(?knowledge_return_plan), "^.*[#/]", ""), STR(?knowledge_return_plan)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProviderEngagements_IsKnowledgeAccessUnsecured a sh:NodeShape ;
    sh:targetClass pko-extension:ProviderEngagement ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_IsKnowledgeAccessUnsecured" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isKnowledgeAccessUnsecured ?_result .
            }
            WHERE {
    $this a pko-extension:ProviderEngagement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasKnowledgeAccessClause ?has_knowledge_access_clause . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isActive ?is_active . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reliedDependencyCount ?relied_dependency_count . }
                BIND((COALESCE(?is_active, false) && COALESCE((COALESCE(?relied_dependency_count, 0) > 0), false) && COALESCE((COALESCE(?has_knowledge_access_clause, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .
