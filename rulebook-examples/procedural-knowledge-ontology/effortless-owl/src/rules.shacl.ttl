            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:sourcePhrasingCount ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:VocabularyTerm .
                    ?child a pko-extension:SourceTermMention .
                    ?child pko-native-procedural-knowledge-rulebook:intendedTerm $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_UnreconciledPhrasingCount a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_UnreconciledPhrasingCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:unreconciledPhrasingCount ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:VocabularyTerm .
                    ?child a pko-extension:SourceTermMention .
                    ?child pko-native-procedural-knowledge-rulebook:unresolvedIntendedTermKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:vocabularyTermId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_HasUnreconciledVariantPhrasings a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_HasUnreconciledVariantPhrasings" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasUnreconciledVariantPhrasings ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourcePhrasingCount ?source_phrasing_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:unreconciledPhrasingCount ?unreconciled_phrasing_count . }
                BIND((COALESCE((COALESCE(?source_phrasing_count, 0) >= 2), false) && COALESCE((COALESCE(?unreconciled_phrasing_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for WitnessLoops ===
pko-native-procedural-knowledge-rulebook-shapes:WitnessLoops_Name a sh:NodeShape ;
    sh:targetClass pko-extension:WitnessLoop ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WitnessLoops_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:WitnessLoop .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:loopNumber ?loop_number . OPTIONAL { ?loop_number erb:key ?loop_number__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:title ?title . OPTIONAL { ?title erb:key ?title__key . } }
                BIND(CONCAT("Loop ", COALESCE(COALESCE(?loop_number__key, IF(isIRI(?loop_number), REPLACE(STR(?loop_number), "^.*[#/]", ""), STR(?loop_number))), ""), ": ", COALESCE(COALESCE(?title__key, IF(isIRI(?title), REPLACE(STR(?title), "^.*[#/]", ""), STR(?title))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:WitnessLoops_QuestionCount a sh:NodeShape ;
    sh:targetClass pko-extension:WitnessLoop ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WitnessLoops_QuestionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:questionCount ?_result .
            }
            WHERE {
    $this a pko-extension:WitnessLoop .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:WitnessLoop .
                    ?child a pko-extension:RoleQuestion .
                    ?child pko-native-procedural-knowledge-rulebook:witnessLoop $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:WitnessLoops_IsComplete a sh:NodeShape ;
    sh:targetClass pko-extension:WitnessLoop ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WitnessLoops_IsComplete" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isComplete ?_result .
            }
            WHERE {
    $this a pko-extension:WitnessLoop .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:completedAt ?completed_at . OPTIONAL { ?completed_at erb:key ?completed_at__key . } }
                BIND((COALESCE(?completed_at__key, COALESCE(IF(isIRI(?completed_at), REPLACE(STR(?completed_at), "^.*[#/]", ""), STR(?completed_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for WorkflowViewDivergences ===
pko-native-procedural-knowledge-rulebook-shapes:WorkflowViewDivergences_Name a sh:NodeShape ;
    sh:targetClass pko-extension:WorkflowViewDivergence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WorkflowViewDivergences_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:WorkflowViewDivergence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:viewA ?view_a . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:viewB ?view_b . }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?view_a), 1, 40)), REPLACE(STR(SUBSTR(STR(?view_a), 1, 40)), "^.*[#/]", ""), STR(SUBSTR(STR(?view_a), 1, 40))), ""), " / ", COALESCE(IF(isIRI(SUBSTR(STR(?view_b), 1, 40)), REPLACE(STR(SUBSTR(STR(?view_b), 1, 40)), "^.*[#/]", ""), STR(SUBSTR(STR(?view_b), 1, 40))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:WorkflowViewDivergences_IsReconciled a sh:NodeShape ;
    sh:targetClass pko-extension:WorkflowViewDivergence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WorkflowViewDivergences_IsReconciled" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isReconciled ?_result .
            }
            WHERE {
    $this a pko-extension:WorkflowViewDivergence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reconciledStatement ?reconciled_statement . OPTIONAL { ?reconciled_statement erb:key ?reconciled_statement__key . } }
                BIND((COALESCE(?reconciled_statement__key, COALESCE(IF(isIRI(?reconciled_statement), REPLACE(STR(?reconciled_statement), "^.*[#/]", ""), STR(?reconciled_statement)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:WorkflowViewDivergences_IsSurfacedButUnreconciled a sh:NodeShape ;
    sh:targetClass pko-extension:WorkflowViewDivergence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WorkflowViewDivergences_IsSurfacedButUnreconciled" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isSurfacedButUnreconciled ?_result .
            }
            WHERE {
    $this a pko-extension:WorkflowViewDivergence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reconciledStatement ?reconciled_statement . OPTIONAL { ?reconciled_statement erb:key ?reconciled_statement__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:viewA ?view_a . OPTIONAL { ?view_a erb:key ?view_a__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:viewB ?view_b . OPTIONAL { ?view_b erb:key ?view_b__key . } }
                BIND((COALESCE((COALESCE(?view_a__key, COALESCE(IF(isIRI(?view_a), REPLACE(STR(?view_a), "^.*[#/]", ""), STR(?view_a)), "")) != ""), false) && COALESCE((COALESCE(?view_b__key, COALESCE(IF(isIRI(?view_b), REPLACE(STR(?view_b), "^.*[#/]", ""), STR(?view_b)), "")) != ""), false) && COALESCE((COALESCE(?reconciled_statement__key, COALESCE(IF(isIRI(?reconciled_statement), REPLACE(STR(?reconciled_statement), "^.*[#/]", ""), STR(?reconciled_statement)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

