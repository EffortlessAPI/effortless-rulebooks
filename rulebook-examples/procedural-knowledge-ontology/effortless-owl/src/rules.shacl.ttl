    OPTIONAL { $this effortless-ntwf:daysServedToDeparture ?days_served_to_departure . }
    OPTIONAL { $this effortless-ntwf:daysUntilHolderDeparture ?days_until_holder_departure . }
    OPTIONAL { $this effortless-ntwf:holderDepartureAt ?holder_departure_at . OPTIONAL { ?holder_departure_at effortless-ntwf:__key ?holder_departure_at__key . } }
                BIND((ROUND((IF(COALESCE((COALESCE((COALESCE(?holder_departure_at__key, COALESCE(IF(isIRI(?holder_departure_at), REPLACE(STR(?holder_departure_at), "^.*[#/]", ""), STR(?holder_departure_at)), "")) != ""), false) && COALESCE((COALESCE(?days_until_holder_departure, 0) < 0), false)), false), ?days_served_to_departure, ?days_served_to_as_of) / 365) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
