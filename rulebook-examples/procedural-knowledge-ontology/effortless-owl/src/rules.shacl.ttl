            CONSTRUCT {
                $this effortless-ntwf:ownerOrganization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeRepositoryEntries .
                OPTIONAL { $this effortless-ntwf:procedure ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Procedures ; effortless-ntwf:procedureId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:ownerOrganization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeRepositoryEntries_DaysSinceUpdated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceUpdated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeRepositoryEntries .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:lastUpdatedAt ?last_updated_at . OPTIONAL { ?last_updated_at effortless-ntwf:__key ?last_updated_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?last_updated_at__key, COALESCE(IF(isIRI(?last_updated_at), REPLACE(STR(?last_updated_at), "^.*[#/]", ""), STR(?last_updated_at)), "")) = ""), false), 0, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_updated_at) + FLOOR((153 * (MONTH(?last_updated_at) + 12 * FLOOR((14 - MONTH(?last_updated_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_updated_at) + 4800 - FLOOR((14 - MONTH(?last_updated_at)) / 12)) + FLOOR((YEAR(?last_updated_at) + 4800 - FLOOR((14 - MONTH(?last_updated_at)) / 12)) / 4) - FLOOR((YEAR(?last_updated_at) + 4800 - FLOOR((14 - MONTH(?last_updated_at)) / 12)) / 100) + FLOOR((YEAR(?last_updated_at) + 4800 - FLOOR((14 - MONTH(?last_updated_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeRepositoryEntries_IsStale" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStale ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeRepositoryEntries .
    OPTIONAL { $this effortless-ntwf:daysSinceUpdated ?days_since_updated . }
    OPTIONAL { $this effortless-ntwf:reviewIntervalDays ?review_interval_days . }
                BIND((COALESCE((COALESCE(?review_interval_days, 0) > 0), false) && COALESCE((COALESCE(?days_since_updated, 0) > COALESCE(?review_interval_days, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeRepositoryEntries_IsExecutionFeedback" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isExecutionFeedback ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeRepositoryEntries .
    OPTIONAL { $this effortless-ntwf:fedFromExecution ?fed_from_execution . OPTIONAL { ?fed_from_execution effortless-ntwf:__key ?fed_from_execution__key . } }
                BIND((COALESCE(?fed_from_execution__key, COALESCE(IF(isIRI(?fed_from_execution), REPLACE(STR(?fed_from_execution), "^.*[#/]", ""), STR(?fed_from_execution)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeRepositoryEntries_IsMachineAuthored" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMachineAuthored ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeRepositoryEntries .
    OPTIONAL { $this effortless-ntwf:authorAgent ?author_agent . OPTIONAL { ?author_agent effortless-ntwf:__key ?author_agent__key . } }
    OPTIONAL { $this effortless-ntwf:authorAgentKind ?author_agent_kind . OPTIONAL { ?author_agent_kind effortless-ntwf:__key ?author_agent_kind__key . } }
                BIND((COALESCE((COALESCE(?author_agent__key, COALESCE(IF(isIRI(?author_agent), REPLACE(STR(?author_agent), "^.*[#/]", ""), STR(?author_agent)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?author_agent_kind__key, COALESCE(IF(isIRI(?author_agent_kind), REPLACE(STR(?author_agent_kind), "^.*[#/]", ""), STR(?author_agent_kind)), "")) = "AIAgent"), false) || COALESCE((COALESCE(?author_agent_kind__key, COALESCE(IF(isIRI(?author_agent_kind), REPLACE(STR(?author_agent_kind), "^.*[#/]", ""), STR(?author_agent_kind)), "")) = "AutomatedPipeline"), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeRepositoryEntries_OutlivesAuthorTenure" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:outlivesAuthorTenure ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeRepositoryEntries .
    OPTIONAL { $this effortless-ntwf:authorAgent ?author_agent . OPTIONAL { ?author_agent effortless-ntwf:__key ?author_agent__key . } }
    OPTIONAL { $this effortless-ntwf:authorIsStillEngaged ?author_is_still_engaged . }
    OPTIONAL { $this effortless-ntwf:isStale ?is_stale . }
                BIND((COALESCE((COALESCE(?author_agent__key, COALESCE(IF(isIRI(?author_agent), REPLACE(STR(?author_agent), "^.*[#/]", ""), STR(?author_agent)), "")) != ""), false) && COALESCE((COALESCE(?author_is_still_engaged, false) = false), false) && COALESCE((COALESCE(?is_stale, false) = false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeRepositoryEntries_IsUncreditedExpertKnowHow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUncreditedExpertKnowHow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeRepositoryEntries .
    OPTIONAL { $this effortless-ntwf:authorAgent ?author_agent . }
    OPTIONAL { $this effortless-ntwf:creditsSourceExpert ?credits_source_expert . }
    OPTIONAL { $this effortless-ntwf:sourceExpert ?source_expert . OPTIONAL { ?source_expert effortless-ntwf:__key ?source_expert__key . } }
                BIND((COALESCE((COALESCE(?source_expert__key, COALESCE(IF(isIRI(?source_expert), REPLACE(STR(?source_expert), "^.*[#/]", ""), STR(?source_expert)), "")) != ""), false) && COALESCE(COALESCE((?source_expert != ?author_agent), !((!BOUND(?source_expert) || STR(?source_expert) = "") && (!BOUND(?author_agent) || STR(?author_agent) = ""))), false) && COALESCE((COALESCE(?credits_source_expert, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeSearchEvents ===
effortless-ntwf:KnowledgeSearchEventsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeSearchEvents ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeSearchEvents_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeSearchEvents .
    OPTIONAL { $this effortless-ntwf:queryText ?query_text . }
    OPTIONAL { $this effortless-ntwf:searchedByAgent ?searched_by_agent . OPTIONAL { ?searched_by_agent effortless-ntwf:__key ?searched_by_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?searched_by_agent__key, IF(isIRI(?searched_by_agent), REPLACE(STR(?searched_by_agent), "^.*[#/]", ""), STR(?searched_by_agent))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?query_text), 1, 40)), REPLACE(STR(SUBSTR(STR(?query_text), 1, 40)), "^.*[#/]", ""), STR(SUBSTR(STR(?query_text), 1, 40))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeSearchEvents_FoundNothingUseful" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:foundNothingUseful ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeSearchEvents .
    OPTIONAL { $this effortless-ntwf:openedProjection ?opened_projection . OPTIONAL { ?opened_projection effortless-ntwf:__key ?opened_projection__key . } }
    OPTIONAL { $this effortless-ntwf:openedSegment ?opened_segment . OPTIONAL { ?opened_segment effortless-ntwf:__key ?opened_segment__key . } }
    OPTIONAL { $this effortless-ntwf:resultCount ?result_count . }
                BIND((COALESCE((COALESCE(?result_count, 0) = 0), false) || COALESCE((COALESCE((COALESCE(?opened_segment__key, COALESCE(IF(isIRI(?opened_segment), REPLACE(STR(?opened_segment), "^.*[#/]", ""), STR(?opened_segment)), "")) = ""), false) && COALESCE((COALESCE(?opened_projection__key, COALESCE(IF(isIRI(?opened_projection), REPLACE(STR(?opened_projection), "^.*[#/]", ""), STR(?opened_projection)), "")) = ""), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeSearchEvents_GaveUpAfterSeeingResults" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:gaveUpAfterSeeingResults ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeSearchEvents .
    OPTIONAL { $this effortless-ntwf:resultCount ?result_count . }
    OPTIONAL { $this effortless-ntwf:wasAbandoned ?was_abandoned . }
                BIND((COALESCE(?was_abandoned, false) && COALESCE((COALESCE(?result_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeSearchEvents_IsUnlinkedFailedSearch" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnlinkedFailedSearch ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeSearchEvents .
    OPTIONAL { $this effortless-ntwf:foundNothingUseful ?found_nothing_useful . }
    OPTIONAL { $this effortless-ntwf:linkedKnowledgeGap ?linked_knowledge_gap . OPTIONAL { ?linked_knowledge_gap effortless-ntwf:__key ?linked_knowledge_gap__key . } }
    OPTIONAL { $this effortless-ntwf:linkedUsabilityBarrier ?linked_usability_barrier . OPTIONAL { ?linked_usability_barrier effortless-ntwf:__key ?linked_usability_barrier__key . } }
                BIND((COALESCE(?found_nothing_useful, false) && COALESCE((COALESCE(?linked_knowledge_gap__key, COALESCE(IF(isIRI(?linked_knowledge_gap), REPLACE(STR(?linked_knowledge_gap), "^.*[#/]", ""), STR(?linked_knowledge_gap)), "")) = ""), false) && COALESCE((COALESCE(?linked_usability_barrier__key, COALESCE(IF(isIRI(?linked_usability_barrier), REPLACE(STR(?linked_usability_barrier), "^.*[#/]", ""), STR(?linked_usability_barrier)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeTestOutcomes ===
effortless-ntwf:KnowledgeTestOutcomesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeTestOutcomes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTestOutcomes_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTestOutcomes .
    OPTIONAL { $this effortless-ntwf:outcomeArea ?outcome_area . OPTIONAL { ?outcome_area effortless-ntwf:__key ?outcome_area__key . } }
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . OPTIONAL { ?procedure effortless-ntwf:__key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), ": ", COALESCE(COALESCE(?outcome_area__key, IF(isIRI(?outcome_area), REPLACE(STR(?outcome_area), "^.*[#/]", ""), STR(?outcome_area))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTestOutcomes_IsImproved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isImproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTestOutcomes .
    OPTIONAL { $this effortless-ntwf:afterTestValue ?after_test_value . }
    OPTIONAL { $this effortless-ntwf:baselineValue ?baseline_value . }
    OPTIONAL { $this effortless-ntwf:higherIsBetter ?higher_is_better . }
                BIND((COALESCE((COALESCE(?higher_is_better, false) && COALESCE((COALESCE(?after_test_value, 0) > COALESCE(?baseline_value, 0)), false)), false) || COALESCE((COALESCE((!(COALESCE(?higher_is_better, false))), false) && COALESCE((COALESCE(?after_test_value, 0) < COALESCE(?baseline_value, 0)), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeTraces ===
