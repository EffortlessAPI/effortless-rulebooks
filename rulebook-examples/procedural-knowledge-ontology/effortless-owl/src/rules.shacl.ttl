    OPTIONAL { $this effortless-ntwf:intendedUsers ?intended_users . OPTIONAL { ?intended_users effortless-ntwf:__key ?intended_users__key . } }
    OPTIONAL { $this effortless-ntwf:requirementsPurpose ?requirements_purpose . OPTIONAL { ?requirements_purpose effortless-ntwf:__key ?requirements_purpose__key . } }
                BIND((COALESCE((COALESCE(?requirements_purpose__key, COALESCE(IF(isIRI(?requirements_purpose), REPLACE(STR(?requirements_purpose), "^.*[#/]", ""), STR(?requirements_purpose)), "")) = ""), false) || COALESCE((COALESCE(?intended_users__key, COALESCE(IF(isIRI(?intended_users), REPLACE(STR(?intended_users), "^.*[#/]", ""), STR(?intended_users)), "")) = ""), false) || COALESCE((COALESCE(?baseline_question_count, 0) = 0), false)) AS ?_result)
            }
