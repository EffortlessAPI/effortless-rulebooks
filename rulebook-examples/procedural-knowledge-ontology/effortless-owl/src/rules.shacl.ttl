pko-native-procedural-knowledge-rulebook-shapes:StepVariables_IsInputFromAiArtifact a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepVariables ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_IsInputFromAiArtifact" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isInputFromAiArtifact ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepVariables .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:direction ?direction . OPTIONAL { ?direction erb:key ?direction__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceStepAgentKind ?source_step_agent_kind . OPTIONAL { ?source_step_agent_kind erb:key ?source_step_agent_kind__key . } }
                BIND((COALESCE((COALESCE(?direction__key, COALESCE(IF(isIRI(?direction), REPLACE(STR(?direction), "^.*[#/]", ""), STR(?direction)), "")) = "Input"), false) && COALESCE((COALESCE(?source_step_agent_kind__key, COALESCE(IF(isIRI(?source_step_agent_kind), REPLACE(STR(?source_step_agent_kind), "^.*[#/]", ""), STR(?source_step_agent_kind)), "")) = "AIAgent"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepVariables_AiArtifactConsumerHasNoAccountableAgent a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepVariables ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_AiArtifactConsumerHasNoAccountableAgent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:aiArtifactConsumerHasNoAccountableAgent ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepVariables .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isInputFromAiArtifact ?is_input_from_ai_artifact . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepAccountableAgent ?step_accountable_agent . OPTIONAL { ?step_accountable_agent erb:key ?step_accountable_agent__key . } }
                BIND((COALESCE(?is_input_from_ai_artifact, false) && COALESCE((COALESCE(?step_accountable_agent__key, COALESCE(IF(isIRI(?step_accountable_agent), REPLACE(STR(?step_accountable_agent), "^.*[#/]", ""), STR(?step_accountable_agent)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepVariables_AiBlastRadiusPath a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepVariables ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_AiBlastRadiusPath" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:aiBlastRadiusPath ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepVariables .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:consumerRole ?consumer_role . OPTIONAL { ?consumer_role erb:key ?consumer_role__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:consumerWorkflow ?consumer_workflow . OPTIONAL { ?consumer_workflow erb:key ?consumer_workflow__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isInputFromAiArtifact ?is_input_from_ai_artifact . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . OPTIONAL { ?label erb:key ?label__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceStepAgent ?source_step_agent . OPTIONAL { ?source_step_agent erb:key ?source_step_agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepAccountableAgent ?step_accountable_agent . OPTIONAL { ?step_accountable_agent erb:key ?step_accountable_agent__key . } }
                BIND(IF(COALESCE(?is_input_from_ai_artifact, false), CONCAT(COALESCE(COALESCE(?source_step_agent__key, IF(isIRI(?source_step_agent), REPLACE(STR(?source_step_agent), "^.*[#/]", ""), STR(?source_step_agent))), ""), " produces ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), ""), " for ", COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), "; role ", COALESCE(COALESCE(?consumer_role__key, IF(isIRI(?consumer_role), REPLACE(STR(?consumer_role), "^.*[#/]", ""), STR(?consumer_role))), ""), "; agent ", COALESCE(COALESCE(?step_accountable_agent__key, IF(isIRI(?step_accountable_agent), REPLACE(STR(?step_accountable_agent), "^.*[#/]", ""), STR(?step_accountable_agent))), ""), "; workflow ", COALESCE(COALESCE(?consumer_workflow__key, IF(isIRI(?consumer_workflow), REPLACE(STR(?consumer_workflow), "^.*[#/]", ""), STR(?consumer_workflow))), "")), "") AS ?_result)
            }
        """ ;
    ] .

