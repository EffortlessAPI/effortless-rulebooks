                $this pko-native-procedural-knowledge-rulebook:aiFailsForLackOfCapturedKnowledge ?_result .
            }
            WHERE {
    $this a pko-industry:Department .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:failedAiInitiativeCount ?failed_ai_initiative_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ownedProcedureCount ?owned_procedure_count . }
                BIND((COALESCE((COALESCE(?failed_ai_initiative_count, 0) > 0), false) && COALESCE((COALESCE(?owned_procedure_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Organizations_ProductDeliveryFunctionCount a sh:NodeShape ;
    sh:targetClass pko-industry:Department ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_ProductDeliveryFunctionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:productDeliveryFunctionCount ?_result .
            }
            WHERE {
    $this a pko-industry:Department .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-industry:Department .
                    ?child a pko-extension:SourcingFunction .
                    ?child pko-native-procedural-knowledge-rulebook:clientOrganization $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:deliversOwnProduct ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Organizations_ProviderHeldDeliveryMethodCount a sh:NodeShape ;
    sh:targetClass pko-industry:Department ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_ProviderHeldDeliveryMethodCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:providerHeldDeliveryMethodCount ?_result .
            }
            WHERE {
    $this a pko-industry:Department .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-industry:Department .
                    ?child a pko-extension:SourcingFunction .
                    ?child pko-native-procedural-knowledge-rulebook:clientOrganization $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:deliversOwnProduct ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isMethodKnowledgeHeldOutside ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER(BOUND(?c4) && ?c4 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Organizations_IsHollowedOutFirm a sh:NodeShape ;
    sh:targetClass pko-industry:Department ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_IsHollowedOutFirm" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isHollowedOutFirm ?_result .
            }
            WHERE {
    $this a pko-industry:Department .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:productDeliveryFunctionCount ?product_delivery_function_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:providerHeldDeliveryMethodCount ?provider_held_delivery_method_count . }
                BIND((COALESCE((COALESCE(?product_delivery_function_count, 0) > 0), false) && COALESCE((COALESCE(?provider_held_delivery_method_count, 0) = COALESCE(?product_delivery_function_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Organizations_AuditFindingCount a sh:NodeShape ;
    sh:targetClass pko-industry:Department ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_AuditFindingCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:auditFindingCount ?_result .
            }
            WHERE {
    $this a pko-industry:Department .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-industry:Department .
                    ?child a pko-extension:KnowledgeAuditItem .
                    ?child pko-native-procedural-knowledge-rulebook:clientOrganization ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:organizationId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:hasInternalShortfall ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Organizations_FilledKnowledgePositionCount a sh:NodeShape ;
