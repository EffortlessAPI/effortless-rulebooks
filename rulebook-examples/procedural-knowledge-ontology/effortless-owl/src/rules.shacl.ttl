            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:StakeholderLens .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StakeholderLenses_GranularityRank a sh:NodeShape ;
    sh:targetClass pko-extension:StakeholderLens ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderLenses_GranularityRank" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:granularityRank ?_result .
            }
            WHERE {
    $this a pko-extension:StakeholderLens .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requiredGranularity ?required_granularity . OPTIONAL { ?required_granularity erb:key ?required_granularity__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?required_granularity__key, COALESCE(IF(isIRI(?required_granularity), REPLACE(STR(?required_granularity), "^.*[#/]", ""), STR(?required_granularity)), "")) = "Step"), false), 3, IF(COALESCE((COALESCE(?required_granularity__key, COALESCE(IF(isIRI(?required_granularity), REPLACE(STR(?required_granularity), "^.*[#/]", ""), STR(?required_granularity)), "")) = "Stage"), false), 2, IF(COALESCE((COALESCE(?required_granularity__key, COALESCE(IF(isIRI(?required_granularity), REPLACE(STR(?required_granularity), "^.*[#/]", ""), STR(?required_granularity)), "")) = "Category"), false), 1, 0)))) AS ?_result)
            }
        """ ;
    ] .

# === Rules for StakeholderPerspectives ===
pko-native-procedural-knowledge-rulebook-shapes:StakeholderPerspectives_Name a sh:NodeShape ;
    sh:targetClass pko-extension:StakeholderPerspective ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderPerspectives_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:StakeholderPerspective .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holderRole ?holder_role . OPTIONAL { ?holder_role erb:key ?holder_role__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?holder_role__key, IF(isIRI(?holder_role), REPLACE(STR(?holder_role), "^.*[#/]", ""), STR(?holder_role))), ""), " on ", COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StakeholderPerspectives_SourceMaterialKind a sh:NodeShape ;
    sh:targetClass pko-extension:StakeholderPerspective ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderPerspectives_SourceMaterialKind" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:sourceMaterialKind ?_result .
            }
            WHERE {
    $this a pko-extension:StakeholderPerspective .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceMaterial ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:CollectedSourceMaterial . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:materialKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StakeholderPerspectives_ConflictPartnerCount a sh:NodeShape ;
    sh:targetClass pko-extension:StakeholderPerspective ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderPerspectives_ConflictPartnerCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:conflictPartnerCount ?_result .
            }
            WHERE {
    $this a pko-extension:StakeholderPerspective .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:StakeholderPerspective .
                    ?child a pko-extension:StakeholderPerspective .
                    ?child pko-native-procedural-knowledge-rulebook:conflictsWithPerspective $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StakeholderPerspectives_IsInConflict a sh:NodeShape ;
    sh:targetClass pko-extension:StakeholderPerspective ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderPerspectives_IsInConflict" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isInConflict ?_result .
            }
            WHERE {
    $this a pko-extension:StakeholderPerspective .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conflictPartnerCount ?conflict_partner_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conflictsWithPerspective ?conflicts_with_perspective . OPTIONAL { ?conflicts_with_perspective erb:key ?conflicts_with_perspective__key . } }
                BIND((COALESCE((COALESCE(?conflicts_with_perspective__key, COALESCE(IF(isIRI(?conflicts_with_perspective), REPLACE(STR(?conflicts_with_perspective), "^.*[#/]", ""), STR(?conflicts_with_perspective)), "")) != ""), false) || COALESCE((COALESCE(?conflict_partner_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StakeholderPerspectives_IsDissentingViewNotKeptWithSource a sh:NodeShape ;
    sh:targetClass pko-extension:StakeholderPerspective ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderPerspectives_IsDissentingViewNotKeptWithSource" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDissentingViewNotKeptWithSource ?_result .
            }
            WHERE {
    $this a pko-extension:StakeholderPerspective .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:disposition ?disposition . OPTIONAL { ?disposition erb:key ?disposition__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isInConflict ?is_in_conflict . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceMaterial ?source_material . OPTIONAL { ?source_material erb:key ?source_material__key . } }
                BIND((COALESCE(?is_in_conflict, false) && COALESCE((COALESCE((COALESCE(?disposition__key, COALESCE(IF(isIRI(?disposition), REPLACE(STR(?disposition), "^.*[#/]", ""), STR(?disposition)), "")) = "OverriddenByConsensus"), false) || COALESCE((COALESCE(?source_material__key, COALESCE(IF(isIRI(?source_material), REPLACE(STR(?source_material), "^.*[#/]", ""), STR(?source_material)), "")) = ""), false)), false)) AS ?_result)
            }
        """ ;
    ] .

