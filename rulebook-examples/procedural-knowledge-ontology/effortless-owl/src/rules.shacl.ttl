pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_CountOfOpenKnowledgeGaps a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfOpenKnowledgeGaps" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:countOfOpenKnowledgeGaps ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                    ?child a pko-extension:KnowledgeGap .
                    ?child pko-native-procedural-knowledge-rulebook:procedureVersion $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:status_KnowledgeGaps ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Open"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_IsReadyForExecution a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsReadyForExecution" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isReadyForExecution ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:countOfOpenKnowledgeGaps ?count_of_open_knowledge_gaps . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:countOfSteps ?count_of_steps . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) && COALESCE((COALESCE(?count_of_steps, 0) > 0), false) && COALESCE((COALESCE(?count_of_open_knowledge_gaps, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
