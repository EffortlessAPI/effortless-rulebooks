                BIND((COALESCE(?capability_scheme_dimension__key, COALESCE(IF(isIRI(?capability_scheme_dimension), REPLACE(STR(?capability_scheme_dimension), "^.*[#/]", ""), STR(?capability_scheme_dimension)), "")) != "AgentCapability") AS ?_result)
            }
        """ ;
    ] .

# === Rules for RoleQuestions ===
pko-native-procedural-knowledge-rulebook-shapes:RoleQuestions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:RoleQuestion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleQuestions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:RoleQuestion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:askingRole ?asking_role . OPTIONAL { ?asking_role erb:key ?asking_role__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:questionText ?question_text . }
                BIND(CONCAT(COALESCE(COALESCE(?asking_role__key, IF(isIRI(?asking_role), REPLACE(STR(?asking_role), "^.*[#/]", ""), STR(?asking_role))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?question_text), 1, 60)), REPLACE(STR(SUBSTR(STR(?question_text), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?question_text), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleQuestions_PredicateCount a sh:NodeShape ;
    sh:targetClass pko-extension:RoleQuestion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleQuestions_PredicateCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:predicateCount ?_result .
            }
            WHERE {
    $this a pko-extension:RoleQuestion .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:RoleQuestion .
                    ?child a pko-extension:RulebookField .
                    ?child pko-native-procedural-knowledge-rulebook:inventedForQuestion $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleQuestions_IsAnswered a sh:NodeShape ;
    sh:targetClass pko-extension:RoleQuestion ;
    sh:order 2 ;
