                $this effortless-ntwf:isProductionReleaseApprover ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:releaseApprovalStepCount ?release_approval_step_count . }
                BIND((COALESCE(?release_approval_step_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_ApprovalStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approvalStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:assignedRole $this .
                    OPTIONAL { ?child effortless-ntwf:controlKind ?c2 . }
                    FILTER((STR(?c2) = "Approval"))
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for RulebookFields ===
effortless-ntwf:RulebookFieldsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RulebookFields ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:fieldName ?field_name . OPTIONAL { ?field_name effortless-ntwf:__key ?field_name__key . } }
    OPTIONAL { $this effortless-ntwf:targetTable ?target_table . OPTIONAL { ?target_table effortless-ntwf:__key ?target_table__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?target_table__key, IF(isIRI(?target_table), REPLACE(STR(?target_table), "^.*[#/]", ""), STR(?target_table))), ""), ".", COALESCE(COALESCE(?field_name__key, IF(isIRI(?field_name), REPLACE(STR(?field_name), "^.*[#/]", ""), STR(?field_name))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_IsDerived" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDerived ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:fieldType ?field_type . OPTIONAL { ?field_type effortless-ntwf:__key ?field_type__key . } }
                BIND((COALESCE((COALESCE(?field_type__key, COALESCE(IF(isIRI(?field_type), REPLACE(STR(?field_type), "^.*[#/]", ""), STR(?field_type)), "")) = "calculated"), false) || COALESCE((COALESCE(?field_type__key, COALESCE(IF(isIRI(?field_type), REPLACE(STR(?field_type), "^.*[#/]", ""), STR(?field_type)), "")) = "lookup"), false) || COALESCE((COALESCE(?field_type__key, COALESCE(IF(isIRI(?field_type), REPLACE(STR(?field_type), "^.*[#/]", ""), STR(?field_type)), "")) = "aggregation"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_IsWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:inventedForQuestion ?invented_for_question . OPTIONAL { ?invented_for_question effortless-ntwf:__key ?invented_for_question__key . } }
                BIND((COALESCE(?invented_for_question__key, COALESCE(IF(isIRI(?invented_for_question), REPLACE(STR(?invented_for_question), "^.*[#/]", ""), STR(?invented_for_question)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_DisagreeingSubstrateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:disagreeingSubstrateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FieldDisagreements .
                    ?child effortless-ntwf:rulebookField $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_IsSubstrateContested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSubstrateContested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:disagreeingSubstrateCount ?disagreeing_substrate_count . }
                BIND((COALESCE(?disagreeing_substrate_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_HasMeasuredData" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasMeasuredData ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:measuredSubstantiveCount ?measured_substantive_count . }
                BIND((COALESCE(?measured_substantive_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_IsDiscriminating" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDiscriminating ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:measuredDistinctValueCount ?measured_distinct_value_count . }
                BIND((COALESCE(?measured_distinct_value_count, 0) >= 2) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RulebookReleases ===
effortless-ntwf:RulebookReleasesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RulebookReleases ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:pkoCoreVersionIri ?pko_core_version_iri . OPTIONAL { ?pko_core_version_iri effortless-ntwf:__key ?pko_core_version_iri__key . } }
    OPTIONAL { $this effortless-ntwf:rulebookVersion ?rulebook_version . OPTIONAL { ?rulebook_version effortless-ntwf:__key ?rulebook_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?rulebook_version__key, IF(isIRI(?rulebook_version), REPLACE(STR(?rulebook_version), "^.*[#/]", ""), STR(?rulebook_version))), ""), " / PKO ", COALESCE(COALESCE(?pko_core_version_iri__key, IF(isIRI(?pko_core_version_iri), REPLACE(STR(?pko_core_version_iri), "^.*[#/]", ""), STR(?pko_core_version_iri))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_PrevMajor" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:prevMajor ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
                OPTIONAL { $this effortless-ntwf:previousRelease ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookReleases ; effortless-ntwf:rulebookReleaseId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:versionMajor ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
