pko-native-procedural-knowledge-rulebook-shapes:AgentDecisionRecords_BoundaryMatchKey a sh:NodeShape ;
    sh:targetClass pko-extension:AgentDecisionRecord ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_BoundaryMatchKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
