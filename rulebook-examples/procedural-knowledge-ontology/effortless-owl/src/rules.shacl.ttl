    $this a pko-extension:ProcedureLensView .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:granularity ?granularity . OPTIONAL { ?granularity erb:key ?granularity__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?granularity__key, COALESCE(IF(isIRI(?granularity), REPLACE(STR(?granularity), "^.*[#/]", ""), STR(?granularity)), "")) = "Step"), false), 3, IF(COALESCE((COALESCE(?granularity__key, COALESCE(IF(isIRI(?granularity), REPLACE(STR(?granularity), "^.*[#/]", ""), STR(?granularity)), "")) = "Stage"), false), 2, IF(COALESCE((COALESCE(?granularity__key, COALESCE(IF(isIRI(?granularity), REPLACE(STR(?granularity), "^.*[#/]", ""), STR(?granularity)), "")) = "Category"), false), 1, 0)))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureLensViews_IsGranularityMisfit a sh:NodeShape ;
    sh:targetClass pko-extension:ProcedureLensView ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureLensViews_IsGranularityMisfit" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isGranularityMisfit ?_result .
            }
            WHERE {
    $this a pko-extension:ProcedureLensView .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lensGranularityRank ?lens_granularity_rank . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:viewGranularityRank ?view_granularity_rank . }
                BIND((COALESCE((COALESCE(?lens_granularity_rank, 0) > 0), false) && COALESCE((COALESCE(?view_granularity_rank, 0) != COALESCE(?lens_granularity_rank, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureLensViews_IsDisconnectedSilo a sh:NodeShape ;
    sh:targetClass pko-extension:ProcedureLensView ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureLensViews_IsDisconnectedSilo" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDisconnectedSilo ?_result .
            }
            WHERE {
    $this a pko-extension:ProcedureLensView .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureCurrentVersion ?procedure_current_version . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:projectsVersion ?projects_version . OPTIONAL { ?projects_version erb:key ?projects_version__key . } }
                BIND((COALESCE((COALESCE(?projects_version__key, COALESCE(IF(isIRI(?projects_version), REPLACE(STR(?projects_version), "^.*[#/]", ""), STR(?projects_version)), "")) = ""), false) || COALESCE(COALESCE((?projects_version != ?procedure_current_version), !((!BOUND(?projects_version) || STR(?projects_version) = "") && (!BOUND(?procedure_current_version) || STR(?procedure_current_version) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureLensViews_StepLevelProcedureKey a sh:NodeShape ;
    sh:targetClass pko-extension:ProcedureLensView ;
    sh:order 3 ;
    sh:rule [
