    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:approvalStepCount ?approval_step_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:preparationStepCount ?preparation_step_count . }
                BIND((COALESCE((COALESCE(?preparation_step_count, 0) > 0), false) && COALESCE((COALESCE(?approval_step_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
