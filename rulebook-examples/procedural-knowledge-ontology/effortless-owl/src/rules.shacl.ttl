        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:cleanRunCount ?_result .
            }
            WHERE {
    $this a pko-industry:Site .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-industry:Site .
                    ?child a pko:ProcedureExecution .
                    ?child pko-native-procedural-knowledge-rulebook:cleanFacilityKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:facilityId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Facilities_IsDeviationOnlyFacility a sh:NodeShape ;
    sh:targetClass pko-industry:Site ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Facilities_IsDeviationOnlyFacility" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDeviationOnlyFacility ?_result .
            }
            WHERE {
    $this a pko-industry:Site .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cleanRunCount ?clean_run_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deviatingRunCount ?deviating_run_count . }
                BIND((COALESCE((COALESCE(?deviating_run_count, 0) > 0), false) && COALESCE((COALESCE(?clean_run_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for FailureModes ===
pko-native-procedural-knowledge-rulebook-shapes:FailureModes_Name a sh:NodeShape ;
    sh:targetClass pko-extension:FailureMode ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FailureModes_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:FailureMode .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:description ?description . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?description), 1, 40)), REPLACE(STR(SUBSTR(STR(?description), 1, 40)), "^.*[#/]", ""), STR(SUBSTR(STR(?description), 1, 40))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:FailureModes_EscalationRoleHasNoHolder a sh:NodeShape ;
    sh:targetClass pko-extension:FailureMode ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FailureModes_EscalationRoleHasNoHolder" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:escalationRoleHasNoHolder ?_result .
            }
            WHERE {
    $this a pko-extension:FailureMode .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:escalateToRole ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:Role . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:hasNoCurrentHolder ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:FailureModes_EscalatesToVacantRole a sh:NodeShape ;
    sh:targetClass pko-extension:FailureMode ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FailureModes_EscalatesToVacantRole" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:escalatesToVacantRole ?_result .
            }
            WHERE {
    $this a pko-extension:FailureMode .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:escalationRoleHasNoHolder ?escalation_role_has_no_holder . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requiresEscalation ?requires_escalation . }
                BIND((COALESCE(?requires_escalation, false) && COALESCE(?escalation_role_has_no_holder, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:FailureModes_HasNoResponse a sh:NodeShape ;
    sh:targetClass pko-extension:FailureMode ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FailureModes_HasNoResponse" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasNoResponse ?_result .
            }
            WHERE {
    $this a pko-extension:FailureMode .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:response ?response . OPTIONAL { ?response erb:key ?response__key . } }
                BIND((COALESCE(?response__key, COALESCE(IF(isIRI(?response), REPLACE(STR(?response), "^.*[#/]", ""), STR(?response)), "")) = "") AS ?_result)
            }
        """ ;
    ] .

