            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:missesALayer ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeQueryDefinition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:needsOntologyAndInstances ?needs_ontology_and_instances . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:traversesInstanceLayer ?traverses_instance_layer . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:traversesOntologyLayer ?traverses_ontology_layer . }
                BIND((COALESCE(?needs_ontology_and_instances, false) && COALESCE((COALESCE((COALESCE(?traverses_ontology_layer, false) = false), false) || COALESCE((COALESCE(?traverses_instance_layer, false) = false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
