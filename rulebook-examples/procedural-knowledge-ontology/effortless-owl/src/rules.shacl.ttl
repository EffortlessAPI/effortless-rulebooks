                BIND((COALESCE(?organization_type__key, COALESCE(IF(isIRI(?organization_type), REPLACE(STR(?organization_type), "^.*[#/]", ""), STR(?organization_type)), "")) != "Department") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
