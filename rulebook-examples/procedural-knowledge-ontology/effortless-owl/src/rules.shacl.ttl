    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_HasInstructionOnly" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasInstructionOnly ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:cueCount ?cue_count . }
    OPTIONAL { $this effortless-ntwf:decisionPointCount ?decision_point_count . }
    OPTIONAL { $this effortless-ntwf:failureModeCount ?failure_mode_count . }
    OPTIONAL { $this effortless-ntwf:invariantCount ?invariant_count . }
    OPTIONAL { $this effortless-ntwf:knowledgeFragmentCount ?knowledge_fragment_count . }
    OPTIONAL { $this effortless-ntwf:postconditionCount ?postcondition_count . }
    OPTIONAL { $this effortless-ntwf:preconditionCount ?precondition_count . }
                BIND((COALESCE((COALESCE(((?precondition_count + ?postcondition_count) + ?invariant_count), 0) = 0), false) && COALESCE((COALESCE(?cue_count, 0) = 0), false) && COALESCE((COALESCE(?failure_mode_count, 0) = 0), false) && COALESCE((COALESCE(?decision_point_count, 0) = 0), false) && COALESCE((COALESCE(?knowledge_fragment_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
