    $this a effortless-ntwf:ModelCharters .
    OPTIONAL { $this effortless-ntwf:daysSinceDriftWatch ?days_since_drift_watch . }
    OPTIONAL { $this effortless-ntwf:isCurrent ?is_current . }
                BIND((COALESCE(?is_current, false) && COALESCE((COALESCE(?days_since_drift_watch, 0) > 90), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelCharters_ProcedureDecisionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:procedureDecisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelCharters .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeRequests .
                    ?child effortless-ntwf:authorityRole ?backfk .
                    $this effortless-ntwf:authorityRole ?backpv .
                    OPTIONAL { ?child effortless-ntwf:isDecided ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelCharters_ModelReviewCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:modelReviewCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelCharters .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelChangeRequests .
                    ?child effortless-ntwf:governedModel ?backfk .
                    $this effortless-ntwf:governedModel ?backpv .
                    OPTIONAL { ?child effortless-ntwf:hasAuthorityReview ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelCharters_IsNamedButUnexercised" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNamedButUnexercised ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelCharters .
    OPTIONAL { $this effortless-ntwf:isCurrent ?is_current . }
    OPTIONAL { $this effortless-ntwf:modelReviewCount ?model_review_count . }
    OPTIONAL { $this effortless-ntwf:procedureDecisionCount ?procedure_decision_count . }
    OPTIONAL { $this effortless-ntwf:stewardActivityCount ?steward_activity_count . }
                BIND((COALESCE(?is_current, false) && COALESCE((COALESCE((COALESCE(?steward_activity_count, 0) = 0), false) || COALESCE((COALESCE((?procedure_decision_count + ?model_review_count), 0) = 0), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelCharters_StewardIsOutsideTooling" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stewardIsOutsideTooling ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelCharters .
    OPTIONAL { $this effortless-ntwf:modelKind ?model_kind . OPTIONAL { ?model_kind effortless-ntwf:__key ?model_kind__key . } }
    OPTIONAL { $this effortless-ntwf:modelToolingOwnerRole ?model_tooling_owner_role . OPTIONAL { ?model_tooling_owner_role effortless-ntwf:__key ?model_tooling_owner_role__key . } }
    OPTIONAL { $this effortless-ntwf:stewardRole ?steward_role . }
                BIND((COALESCE((COALESCE(?model_kind__key, COALESCE(IF(isIRI(?model_kind), REPLACE(STR(?model_kind), "^.*[#/]", ""), STR(?model_kind)), "")) = "Ontology"), false) && COALESCE((COALESCE(?model_tooling_owner_role__key, COALESCE(IF(isIRI(?model_tooling_owner_role), REPLACE(STR(?model_tooling_owner_role), "^.*[#/]", ""), STR(?model_tooling_owner_role)), "")) != ""), false) && COALESCE(COALESCE((?steward_role != ?model_tooling_owner_role), !((!BOUND(?steward_role) || STR(?steward_role) = "") && (!BOUND(?model_tooling_owner_role) || STR(?model_tooling_owner_role) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelCharters_AdoptedTemplateWithoutAdaptation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:adoptedTemplateWithoutAdaptation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelCharters .
    OPTIONAL { $this effortless-ntwf:charterTemplate ?charter_template . OPTIONAL { ?charter_template effortless-ntwf:__key ?charter_template__key . } }
    OPTIONAL { $this effortless-ntwf:localAdaptation ?local_adaptation . OPTIONAL { ?local_adaptation effortless-ntwf:__key ?local_adaptation__key . } }
                BIND((COALESCE((COALESCE(?charter_template__key, COALESCE(IF(isIRI(?charter_template), REPLACE(STR(?charter_template), "^.*[#/]", ""), STR(?charter_template)), "")) != ""), false) && COALESCE((COALESCE(?local_adaptation__key, COALESCE(IF(isIRI(?local_adaptation), REPLACE(STR(?local_adaptation), "^.*[#/]", ""), STR(?local_adaptation)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ModelConsumers ===
effortless-ntwf:ModelConsumersShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelConsumers ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelConsumers_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelConsumers .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ModelDataMappingRuns ===
effortless-ntwf:ModelDataMappingRunsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelDataMappingRuns ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelDataMappingRuns_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelDataMappingRuns .
    OPTIONAL { $this effortless-ntwf:dataOrigin ?data_origin . OPTIONAL { ?data_origin effortless-ntwf:__key ?data_origin__key . } }
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " mapping ", COALESCE(COALESCE(?data_origin__key, IF(isIRI(?data_origin), REPLACE(STR(?data_origin), "^.*[#/]", ""), STR(?data_origin))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ModelDocuments ===
effortless-ntwf:ModelDocumentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelDocuments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelDocuments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelDocuments .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelDocuments_ModelCurrentRelease" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:modelCurrentRelease ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelDocuments .
                OPTIONAL { $this effortless-ntwf:governedModel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:GovernedModels ; effortless-ntwf:governedModelId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:currentRelease ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelDocuments_IsBehindCurrentRelease" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBehindCurrentRelease ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelDocuments .
    OPTIONAL { $this effortless-ntwf:documentedRelease ?documented_release . OPTIONAL { ?documented_release effortless-ntwf:__key ?documented_release__key . } }
    OPTIONAL { $this effortless-ntwf:modelCurrentRelease ?model_current_release . OPTIONAL { ?model_current_release effortless-ntwf:__key ?model_current_release__key . } }
                BIND((COALESCE((COALESCE(?documented_release__key, COALESCE(IF(isIRI(?documented_release), REPLACE(STR(?documented_release), "^.*[#/]", ""), STR(?documented_release)), "")) != ""), false) && COALESCE((COALESCE(?model_current_release__key, COALESCE(IF(isIRI(?model_current_release), REPLACE(STR(?model_current_release), "^.*[#/]", ""), STR(?model_current_release)), "")) != ""), false) && COALESCE(COALESCE((?documented_release != ?model_current_release), !((!BOUND(?documented_release) || STR(?documented_release) = "") && (!BOUND(?model_current_release) || STR(?model_current_release) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ModelExpansionRequests ===
effortless-ntwf:ModelExpansionRequestsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelExpansionRequests ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelExpansionRequests_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelExpansionRequests .
    OPTIONAL { $this effortless-ntwf:workflowDescription ?workflow_description . }
                BIND(SUBSTR(STR(?workflow_description), 1, 60) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelExpansionRequests_ModelDomainOwner" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:modelDomainOwner ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelExpansionRequests .
                OPTIONAL { $this effortless-ntwf:governedModel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:GovernedModels ; effortless-ntwf:governedModelId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:domainOwningOrganization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelExpansionRequests_ConceptCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:conceptCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelExpansionRequests .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ExpansionConceptFits .
                    ?child effortless-ntwf:modelExpansionRequest $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelExpansionRequests_UncoveredConceptCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:uncoveredConceptCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelExpansionRequests .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ExpansionConceptFits .
                    ?child effortless-ntwf:modelExpansionRequest $this .
                    OPTIONAL { ?child effortless-ntwf:isUncovered ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelExpansionRequests_IsCrossFunctionExpansion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCrossFunctionExpansion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelExpansionRequests .
    OPTIONAL { $this effortless-ntwf:modelDomainOwner ?model_domain_owner . OPTIONAL { ?model_domain_owner effortless-ntwf:__key ?model_domain_owner__key . } }
    OPTIONAL { $this effortless-ntwf:requestingOrganization ?requesting_organization . OPTIONAL { ?requesting_organization effortless-ntwf:__key ?requesting_organization__key . } }
                BIND((COALESCE((COALESCE(?requesting_organization__key, COALESCE(IF(isIRI(?requesting_organization), REPLACE(STR(?requesting_organization), "^.*[#/]", ""), STR(?requesting_organization)), "")) != ""), false) && COALESCE((COALESCE(?model_domain_owner__key, COALESCE(IF(isIRI(?model_domain_owner), REPLACE(STR(?model_domain_owner), "^.*[#/]", ""), STR(?model_domain_owner)), "")) != ""), false) && COALESCE(COALESCE((?requesting_organization != ?model_domain_owner), !((!BOUND(?requesting_organization) || STR(?requesting_organization) = "") && (!BOUND(?model_domain_owner) || STR(?model_domain_owner) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelExpansionRequests_RequiresSchemaExtension" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requiresSchemaExtension ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelExpansionRequests .
    OPTIONAL { $this effortless-ntwf:uncoveredConceptCount ?uncovered_concept_count . }
                BIND((COALESCE(?uncovered_concept_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelExpansionRequests_FitDecisionContradictsConceptFit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fitDecisionContradictsConceptFit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelExpansionRequests .
    OPTIONAL { $this effortless-ntwf:fitDecision ?fit_decision . OPTIONAL { ?fit_decision effortless-ntwf:__key ?fit_decision__key . } }
    OPTIONAL { $this effortless-ntwf:uncoveredConceptCount ?uncovered_concept_count . }
                BIND((COALESCE((COALESCE(?fit_decision__key, COALESCE(IF(isIRI(?fit_decision), REPLACE(STR(?fit_decision), "^.*[#/]", ""), STR(?fit_decision)), "")) = "FitsExistingSchema"), false) && COALESCE((COALESCE(?uncovered_concept_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ModelPilots ===
effortless-ntwf:ModelPilotsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelPilots ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelPilots_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelPilots .
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
    OPTIONAL { $this effortless-ntwf:site ?site . OPTIONAL { ?site effortless-ntwf:__key ?site__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " pilot: ", COALESCE(COALESCE(?site__key, IF(isIRI(?site), REPLACE(STR(?site), "^.*[#/]", ""), STR(?site))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ModelProposals ===
effortless-ntwf:ModelProposalsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelProposals ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelProposals_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelProposals .
    OPTIONAL { $this effortless-ntwf:content ?content . }
    OPTIONAL { $this effortless-ntwf:proposalKind ?proposal_kind . OPTIONAL { ?proposal_kind effortless-ntwf:__key ?proposal_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?proposal_kind__key, IF(isIRI(?proposal_kind), REPLACE(STR(?proposal_kind), "^.*[#/]", ""), STR(?proposal_kind))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?content), 1, 50)), REPLACE(STR(SUBSTR(STR(?content), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?content), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelProposals_ProposerKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:proposerKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelProposals .
                OPTIONAL { $this effortless-ntwf:proposedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelProposals_ReviewerKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reviewerKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelProposals .
                OPTIONAL { $this effortless-ntwf:reviewedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelProposals_CommitterKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
