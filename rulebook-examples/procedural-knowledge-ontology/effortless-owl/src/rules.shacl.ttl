pko-native-procedural-knowledge-rulebook-shapes:ConformanceSubstrates_DisagreeingTableCount a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceSubstrate ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_DisagreeingTableCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:disagreeingTableCount ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceSubstrate .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ConformanceSubstrate .
                    ?child a pko-extension:TableConformance .
                    ?child pko-native-procedural-knowledge-rulebook:imperfectSubstrateKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:conformanceSubstrateId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConformanceSubstrates_IsFullyConformant a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceSubstrate ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_IsFullyConformant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFullyConformant ?_result .
            }
            WHERE {
    $this a pko-extension:ConformanceSubstrate .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:latestCellsFailed ?latest_cells_failed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:latestCellsTested ?latest_cells_tested . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:latestHarnessErrors ?latest_harness_errors . }
                BIND((COALESCE((COALESCE(?latest_cells_tested, 0) > 0), false) && COALESCE((COALESCE(?latest_cells_failed, 0) = 0), false) && COALESCE((COALESCE(?latest_harness_errors, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ConsumerRevalidations ===
pko-native-procedural-knowledge-rulebook-shapes:ConsumerRevalidations_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ConsumerRevalidation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerRevalidations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ConsumerRevalidation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelConsumer ?model_consumer . OPTIONAL { ?model_consumer erb:key ?model_consumer__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rulebookRelease ?rulebook_release . OPTIONAL { ?rulebook_release erb:key ?rulebook_release__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?rulebook_release__key, IF(isIRI(?rulebook_release), REPLACE(STR(?rulebook_release), "^.*[#/]", ""), STR(?rulebook_release))), ""), " / ", COALESCE(COALESCE(?model_consumer__key, IF(isIRI(?model_consumer), REPLACE(STR(?model_consumer), "^.*[#/]", ""), STR(?model_consumer))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ConsumerSystemSyncs ===
pko-native-procedural-knowledge-rulebook-shapes:ConsumerSystemSyncs_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ConsumerSystemSync ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ConsumerSystemSync .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:consumerSystem ?consumer_system . OPTIONAL { ?consumer_system erb:key ?consumer_system__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:loadedVersion ?loaded_version . OPTIONAL { ?loaded_version erb:key ?loaded_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?consumer_system__key, IF(isIRI(?consumer_system), REPLACE(STR(?consumer_system), "^.*[#/]", ""), STR(?consumer_system))), ""), " holds ", COALESCE(COALESCE(?loaded_version__key, IF(isIRI(?loaded_version), REPLACE(STR(?loaded_version), "^.*[#/]", ""), STR(?loaded_version))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConsumerSystemSyncs_SystemAudience a sh:NodeShape ;
