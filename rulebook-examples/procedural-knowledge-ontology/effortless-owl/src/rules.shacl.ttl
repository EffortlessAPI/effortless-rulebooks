    sh:targetClass pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_CqCoveragePercent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:cqCoveragePercent ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:RulebookReleases .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:answerableCqRunCount ?answerable_cq_run_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cqRunCount ?cq_run_count . }
                BIND(IF(COALESCE((COALESCE(?cq_run_count, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?answerable_cq_run_count) / ?cq_run_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
