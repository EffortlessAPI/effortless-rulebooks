            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:wouldNotSurviveRestatement ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Attestations .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:assuranceGradeHasDrifted ?assurance_grade_has_drifted . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fitnessVerdictHasDrifted ?fitness_verdict_has_drifted . }
                BIND((COALESCE(?fitness_verdict_has_drifted, false) || COALESCE(?assurance_grade_has_drifted, false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for AuthoringSubmissions ===
pko-native-procedural-knowledge-rulebook-shapes:AuthoringSubmissions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AuthoringSubmission ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthoringSubmissions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AuthoringSubmission .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version erb:key ?procedure_version__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:submittedByAgent ?submitted_by_agent . OPTIONAL { ?submitted_by_agent erb:key ?submitted_by_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " by ", COALESCE(COALESCE(?submitted_by_agent__key, IF(isIRI(?submitted_by_agent), REPLACE(STR(?submitted_by_agent), "^.*[#/]", ""), STR(?submitted_by_agent))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AuthoringSubmissions_IsExpertAuthoredConforming a sh:NodeShape ;
    sh:targetClass pko-extension:AuthoringSubmission ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthoringSubmissions_IsExpertAuthoredConforming" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isExpertAuthoredConforming ?_result .
            }
            WHERE {
    $this a pko-extension:AuthoringSubmission .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:profileValidationPassed ?profile_validation_passed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:submitterExpertise ?submitter_expertise . OPTIONAL { ?submitter_expertise erb:key ?submitter_expertise__key . } }
                BIND((COALESCE((COALESCE(?submitter_expertise__key, COALESCE(IF(isIRI(?submitter_expertise), REPLACE(STR(?submitter_expertise), "^.*[#/]", ""), STR(?submitter_expertise)), "")) = "DomainExpert"), false) && COALESCE(?profile_validation_passed, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AuthoringSubmissions_IsNonConformingAccepted a sh:NodeShape ;
    sh:targetClass pko-extension:AuthoringSubmission ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthoringSubmissions_IsNonConformingAccepted" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isNonConformingAccepted ?_result .
            }
            WHERE {
    $this a pko-extension:AuthoringSubmission .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:profileValidationPassed ?profile_validation_passed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wasAccepted ?was_accepted . }
                BIND((COALESCE(?was_accepted, false) && COALESCE((COALESCE(?profile_validation_passed, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for AuthorityBoundaries ===
pko-native-procedural-knowledge-rulebook-shapes:AuthorityBoundaries_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AuthorityBoundary ;
