            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:staleAuthoritativeBindingCount ?stale_authoritative_binding_count . }
                BIND((COALESCE(?stale_authoritative_binding_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsSoftwareAssigned" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSoftwareAssigned ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:assignedAgentKind ?assigned_agent_kind . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?assigned_agent_kind), ""), "^.*#", "") = "AIAgent"), false) || COALESCE((REPLACE(COALESCE(STR(?assigned_agent_kind), ""), "^.*#", "") = "AutomatedPipeline"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsHumanApprovalGate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isHumanApprovalGate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:isSoftwareAssigned ?is_software_assigned . }
    OPTIONAL { $this effortless-ntwf:stepId ?step_id . }
                BIND((COALESCE((!(COALESCE(?is_software_assigned, false))), false) && COALESCE((COALESCE((REPLACE(COALESCE(STR(?step_id), ""), "^.*#", "") = "policy-05"), false) || COALESCE((REPLACE(COALESCE(STR(?step_id), ""), "^.*#", "") = "close-06"), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_GateHeldByHuman" ;
        sh:prefixes effortless-ntwf: ;
