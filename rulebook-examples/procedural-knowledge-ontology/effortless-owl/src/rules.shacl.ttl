                BIND((COALESCE((!(COALESCE(?is_software_assigned, false))), false) && COALESCE((COALESCE((COALESCE(?step_id__key, COALESCE(IF(isIRI(?step_id), REPLACE(STR(?step_id), "^.*[#/]", ""), STR(?step_id)), "")) = "policy-05"), false) || COALESCE((COALESCE(?step_id__key, COALESCE(IF(isIRI(?step_id), REPLACE(STR(?step_id), "^.*[#/]", ""), STR(?step_id)), "")) = "close-06"), false)), false)) AS ?_result)
