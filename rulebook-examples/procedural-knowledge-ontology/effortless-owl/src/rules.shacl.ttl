pko-native-procedural-knowledge-rulebook-shapes:MessageDeliveries_ApprovalPrecededSend a sh:NodeShape ;
    sh:targetClass pko-extension:MessageDelivery ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_ApprovalPrecededSend" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:approvalPrecededSend ?_result .
            }
            WHERE {
    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:approvalDecidedAtSend ?approval_decided_at_send . OPTIONAL { ?approval_decided_at_send erb:key ?approval_decided_at_send__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sentAt ?sent_at . }
                BIND((COALESCE((COALESCE(?approval_decided_at_send__key, COALESCE(IF(isIRI(?approval_decided_at_send), REPLACE(STR(?approval_decided_at_send), "^.*[#/]", ""), STR(?approval_decided_at_send)), "")) != ""), false) && COALESCE(COALESCE((?sent_at > ?approval_decided_at_send), false), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageDeliveries_HasFrozenApprovalEvidence a sh:NodeShape ;
