# === Rules for DeliveredCommunications ===
pko-native-procedural-knowledge-rulebook-shapes:DeliveredCommunications_Name a sh:NodeShape ;
    sh:targetClass pko-extension:DeliveredCommunication ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:DeliveredCommunication .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:channel ?channel . OPTIONAL { ?channel erb:key ?channel__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recipientKey ?recipient_key . OPTIONAL { ?recipient_key erb:key ?recipient_key__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sentAt ?sent_at . OPTIONAL { ?sent_at erb:key ?sent_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?channel__key, IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel))), ""), " -> ", COALESCE(COALESCE(?recipient_key__key, IF(isIRI(?recipient_key), REPLACE(STR(?recipient_key), "^.*[#/]", ""), STR(?recipient_key))), ""), " @ ", COALESCE(REPLACE(COALESCE(?sent_at__key, IF(isIRI(?sent_at), REPLACE(STR(?sent_at), "^.*[#/]", ""), STR(?sent_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .
