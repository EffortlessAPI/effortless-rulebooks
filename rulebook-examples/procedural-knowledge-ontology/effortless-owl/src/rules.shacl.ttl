            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOwnerlessOpenGap ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOpen ?is_open . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ownerRoleIsVacated ?owner_role_is_vacated . }
                BIND((COALESCE(?is_open, false) && COALESCE(?owner_role_is_vacated, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_IsKnownAndUnresolved a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsKnownAndUnresolved" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isKnownAndUnresolved ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:identifiedAt ?identified_at . OPTIONAL { ?identified_at erb:key ?identified_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOpen ?is_open . }
                BIND((COALESCE((COALESCE(?identified_at__key, COALESCE(IF(isIRI(?identified_at), REPLACE(STR(?identified_at), "^.*[#/]", ""), STR(?identified_at)), "")) != ""), false) && COALESCE(?is_open, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_IsGatekeepingOrSabotage a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsGatekeepingOrSabotage" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isGatekeepingOrSabotage ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:gapCause ?gap_cause . OPTIONAL { ?gap_cause erb:key ?gap_cause__key . } }
                BIND((COALESCE((COALESCE(?gap_cause__key, COALESCE(IF(isIRI(?gap_cause), REPLACE(STR(?gap_cause), "^.*[#/]", ""), STR(?gap_cause)), "")) = "Gatekeeping"), false) || COALESCE((COALESCE(?gap_cause__key, COALESCE(IF(isIRI(?gap_cause), REPLACE(STR(?gap_cause), "^.*[#/]", ""), STR(?gap_cause)), "")) = "Sabotage"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_IsUnattributedGatekeeping a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsUnattributedGatekeeping" ;
