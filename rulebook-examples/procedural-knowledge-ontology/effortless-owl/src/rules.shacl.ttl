            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isKnowledgeDependency ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeAuditItem .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasInternalShortfall ?has_internal_shortfall . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:neededLevel ?needed_level . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:providerHeldLevel ?provider_held_level . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:providerHoldingKnowledge ?provider_holding_knowledge . OPTIONAL { ?provider_holding_knowledge erb:key ?provider_holding_knowledge__key . } }
                BIND((COALESCE(?has_internal_shortfall, false) && COALESCE((COALESCE(?provider_holding_knowledge__key, COALESCE(IF(isIRI(?provider_holding_knowledge), REPLACE(STR(?provider_holding_knowledge), "^.*[#/]", ""), STR(?provider_holding_knowledge)), "")) != ""), false) && COALESCE((COALESCE(?provider_held_level, 0) >= COALESCE(?needed_level, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeAuditItems_IsCoverageGap a sh:NodeShape ;
