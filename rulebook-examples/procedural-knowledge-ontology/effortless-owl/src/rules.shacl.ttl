    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsInconsistentAcrossShifts" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInconsistentAcrossShifts ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:dayDeviatingRunCount ?day_deviating_run_count . }
    OPTIONAL { $this effortless-ntwf:dayRunCount ?day_run_count . }
    OPTIONAL { $this effortless-ntwf:nightDeviatingRunCount ?night_deviating_run_count . }
    OPTIONAL { $this effortless-ntwf:nightRunCount ?night_run_count . }
                BIND((COALESCE((COALESCE(?day_run_count, 0) > 0), false) && COALESCE((COALESCE(?night_run_count, 0) > 0), false) && COALESCE((COALESCE((COALESCE((COALESCE(?day_deviating_run_count, 0) = 0), false) && COALESCE((COALESCE(?night_deviating_run_count, 0) > 0), false)), false) || COALESCE((COALESCE((COALESCE(?day_deviating_run_count, 0) > 0), false) && COALESCE((COALESCE(?night_deviating_run_count, 0) = 0), false)), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
