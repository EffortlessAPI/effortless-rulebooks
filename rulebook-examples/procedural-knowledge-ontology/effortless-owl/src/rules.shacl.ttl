    OPTIONAL { $this effortless-ntwf:isReliedUpon ?is_relied_upon . }
                BIND((COALESCE(?is_relied_upon, false) && COALESCE(?is_attached_to_live_version, false) && COALESCE((!(COALESCE(?is_approved, false))), false)) AS ?_result)
            }
