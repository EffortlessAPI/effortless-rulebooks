pko-native-procedural-knowledge-rulebook-shapes:ProcedureTypes_NarrowerTypeCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureType ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_NarrowerTypeCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:narrowerTypeCount ?_result .
            }
            WHERE {
    $this a pko:ProcedureType .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:ProcedureType .
                    ?child a pko:ProcedureType .
                    ?child pko-native-procedural-knowledge-rulebook:broaderProcedureType $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureTypes_HasNarrowerTypes a sh:NodeShape ;
    sh:targetClass pko:ProcedureType ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_HasNarrowerTypes" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasNarrowerTypes ?_result .
            }
            WHERE {
    $this a pko:ProcedureType .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:narrowerTypeCount ?narrower_type_count . }
                BIND((COALESCE(?narrower_type_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureTypes_IsDetachedFromTaxonomy a sh:NodeShape ;
    sh:targetClass pko:ProcedureType ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_IsDetachedFromTaxonomy" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDetachedFromTaxonomy ?_result .
            }
            WHERE {
    $this a pko:ProcedureType .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:broaderProcedureType ?broader_procedure_type . OPTIONAL { ?broader_procedure_type erb:key ?broader_procedure_type__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:taxonomyRank ?taxonomy_rank . OPTIONAL { ?taxonomy_rank erb:key ?taxonomy_rank__key . } }
                BIND((COALESCE((COALESCE(?taxonomy_rank__key, COALESCE(IF(isIRI(?taxonomy_rank), REPLACE(STR(?taxonomy_rank), "^.*[#/]", ""), STR(?taxonomy_rank)), "")) != "FunctionalDomain"), false) && COALESCE((COALESCE(?broader_procedure_type__key, COALESCE(IF(isIRI(?broader_procedure_type), REPLACE(STR(?broader_procedure_type), "^.*[#/]", ""), STR(?broader_procedure_type)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureTypes_BroaderIsDetached a sh:NodeShape ;
    sh:targetClass pko:ProcedureType ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_BroaderIsDetached" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:broaderIsDetached ?_result .
            }
            WHERE {
    $this a pko:ProcedureType .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:broaderProcedureType ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:ProcedureType . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isDetachedFromTaxonomy ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureTypes_IsUnreachableByNavigation a sh:NodeShape ;
    sh:targetClass pko:ProcedureType ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_IsUnreachableByNavigation" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnreachableByNavigation ?_result .
            }
            WHERE {
    $this a pko:ProcedureType .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:broaderIsDetached ?broader_is_detached . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:broaderProcedureType ?broader_procedure_type . OPTIONAL { ?broader_procedure_type erb:key ?broader_procedure_type__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isDetachedFromTaxonomy ?is_detached_from_taxonomy . }
                BIND((COALESCE(?is_detached_from_taxonomy, false) || COALESCE((COALESCE((COALESCE(?broader_procedure_type__key, COALESCE(IF(isIRI(?broader_procedure_type), REPLACE(STR(?broader_procedure_type), "^.*[#/]", ""), STR(?broader_procedure_type)), "")) != ""), false) && COALESCE((COALESCE(?broader_is_detached, false) = true), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureTypes_MemberCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureType ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_MemberCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:memberCount ?_result .
            }
            WHERE {
    $this a pko:ProcedureType .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:ProcedureType .
                    ?child a pko-native-procedural-knowledge-rulebook:Procedures .
                    ?child pko-native-procedural-knowledge-rulebook:procedureType $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureTypes_MembersLackingDistinctionCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureType ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_MembersLackingDistinctionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:membersLackingDistinctionCount ?_result .
            }
            WHERE {
    $this a pko:ProcedureType .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:ProcedureType .
                    ?child a pko-native-procedural-knowledge-rulebook:Procedures .
                    ?child pko-native-procedural-knowledge-rulebook:lacksDistinctionTypeKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:procedureTypeId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureTypes_IsArbitraryGrouping a sh:NodeShape ;
    sh:targetClass pko:ProcedureType ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_IsArbitraryGrouping" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isArbitraryGrouping ?_result .
            }
            WHERE {
    $this a pko:ProcedureType .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:distinguishingFacet ?distinguishing_facet . OPTIONAL { ?distinguishing_facet erb:key ?distinguishing_facet__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:memberCount ?member_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:membersLackingDistinctionCount ?members_lacking_distinction_count . }
                BIND((COALESCE((COALESCE(?member_count, 0) > 0), false) && COALESCE((COALESCE((COALESCE(?distinguishing_facet__key, COALESCE(IF(isIRI(?distinguishing_facet), REPLACE(STR(?distinguishing_facet), "^.*[#/]", ""), STR(?distinguishing_facet)), "")) = ""), false) || COALESCE((COALESCE(?members_lacking_distinction_count, 0) = COALESCE(?member_count, 0)), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcedureVersionLinks ===
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersionLinks_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersionLinks ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersionLinks_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersionLinks .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:nextProcedureVersion ?next_procedure_version . OPTIONAL { ?next_procedure_version erb:key ?next_procedure_version__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:previousProcedureVersion ?previous_procedure_version . OPTIONAL { ?previous_procedure_version erb:key ?previous_procedure_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?previous_procedure_version__key, IF(isIRI(?previous_procedure_version), REPLACE(STR(?previous_procedure_version), "^.*[#/]", ""), STR(?previous_procedure_version))), ""), " -> ", COALESCE(COALESCE(?next_procedure_version__key, IF(isIRI(?next_procedure_version), REPLACE(STR(?next_procedure_version), "^.*[#/]", ""), STR(?next_procedure_version))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersionLinks_SupersededVersionKey a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersionLinks ;
