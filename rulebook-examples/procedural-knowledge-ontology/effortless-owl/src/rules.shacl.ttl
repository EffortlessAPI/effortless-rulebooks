            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isGenuinelyOverdue ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeFragment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceActualReview ?days_since_actual_review . }
