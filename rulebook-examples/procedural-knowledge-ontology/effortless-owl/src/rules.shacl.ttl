pko-native-procedural-knowledge-rulebook-shapes:ProviderEngagements_ToClientDeliveredCount a sh:NodeShape ;
    sh:targetClass pko-extension:ProviderEngagement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProviderEngagements_ToClientDeliveredCount" ;
