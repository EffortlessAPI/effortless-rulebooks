    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?is_ungoverned_divergence, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_SelfAttestedApprovalExecutionKey a sh:NodeShape ;
