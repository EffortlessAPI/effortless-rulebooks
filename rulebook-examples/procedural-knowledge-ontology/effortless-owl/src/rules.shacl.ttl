            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isAmbiguousLabel ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conceptsSharingWording ?concepts_sharing_wording . }
                BIND((COALESCE(?concepts_sharing_wording, 0) > 1) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TermLabelVariants_PractitionerMentionCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:TermLabelVariants ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_PractitionerMentionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:practitionerMentionCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
                    ?child a pko-extension:SourceTermMention .
                    ?child pko-native-procedural-knowledge-rulebook:wordingKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:wordingKey ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:mentionOrigin ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Practitioner"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TermLabelVariants_PrefWording a sh:NodeShape ;
