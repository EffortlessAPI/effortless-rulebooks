    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:observerIsNonHuman ?observer_is_non_human . }
                BIND((COALESCE((!(COALESCE(?observer_is_non_human, false))), false) && COALESCE((!(COALESCE(?is_self_witnessed, false))), false) && COALESCE(?has_evidence, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VerificationOutcomes_IndependentObservationExecutionKey a sh:NodeShape ;
    sh:targetClass pko-extension:VerificationOutcome ;
