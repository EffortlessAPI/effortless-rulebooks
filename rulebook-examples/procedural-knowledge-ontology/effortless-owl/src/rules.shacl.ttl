pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_AssuranceChainIsCircular a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AssuranceChainIsCircular" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:assuranceChainIsCircular ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasAnyIndependentObservation ?has_any_independent_observation . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:selfAttestedApprovalCount ?self_attested_approval_count . }
                BIND((COALESCE((COALESCE(?self_attested_approval_count, 0) > 0), false) && COALESCE((!(COALESCE(?has_any_independent_observation, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_LatestAttestationInstant a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_LatestAttestationInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:latestAttestationInstant ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko:ProcedureExecution .
                    ?child a pko-native-procedural-knowledge-rulebook:Attestations .
                    ?child pko-native-procedural-knowledge-rulebook:procedureExecution $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:signedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_HasBeenAttested a sh:NodeShape ;
