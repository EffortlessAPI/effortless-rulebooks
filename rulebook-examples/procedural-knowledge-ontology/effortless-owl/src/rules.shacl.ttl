                BIND((COALESCE(?is_omitted_from_own_account, false) && COALESCE((COALESCE(?captured_as_fragment__key, COALESCE(IF(isIRI(?captured_as_fragment), REPLACE(STR(?captured_as_fragment), "^.*[#/]", ""), STR(?captured_as_fragment)), "")) = ""), false)) AS ?_result)
