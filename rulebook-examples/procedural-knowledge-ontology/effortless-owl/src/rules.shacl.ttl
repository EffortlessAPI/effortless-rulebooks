pko-native-procedural-knowledge-rulebook-shapes:VerificationOutcomes_SignalMatchesExpected a sh:NodeShape ;
    sh:targetClass pko-extension:VerificationOutcome ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_SignalMatchesExpected" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:signalMatchesExpected ?_result .
            }
            WHERE {
    $this a pko-extension:VerificationOutcome .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:expectedSignalValue ?expected_signal_value . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:observedSignalValue ?observed_signal_value . }
                BIND(COALESCE((?observed_signal_value = ?expected_signal_value), ((!BOUND(?observed_signal_value) || STR(?observed_signal_value) = "") && (!BOUND(?expected_signal_value) || STR(?expected_signal_value) = ""))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VerificationOutcomes_HasEvidence a sh:NodeShape ;
    sh:targetClass pko-extension:VerificationOutcome ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_HasEvidence" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasEvidence ?_result .
            }
            WHERE {
    $this a pko-extension:VerificationOutcome .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evidenceUri ?evidence_uri . OPTIONAL { ?evidence_uri erb:key ?evidence_uri__key . } }
                BIND((COALESCE(?evidence_uri__key, COALESCE(IF(isIRI(?evidence_uri), REPLACE(STR(?evidence_uri), "^.*[#/]", ""), STR(?evidence_uri)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VerificationOutcomes_IsUnbackedObservation a sh:NodeShape ;
    sh:targetClass pko-extension:VerificationOutcome ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IsUnbackedObservation" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnbackedObservation ?_result .
            }
            WHERE {
    $this a pko-extension:VerificationOutcome .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasEvidence ?has_evidence . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:signalMatchesExpected ?signal_matches_expected . }
                BIND((COALESCE(?signal_matches_expected, false) && COALESCE((!(COALESCE(?has_evidence, false))), false)) AS ?_result)
            }
        """ ;
    ] .
