            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:invokerAlsoPreparedKey ?_result .
            }
            WHERE {
    $this a pko-extension:ExceptionInvocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:approvedByAgent ?approved_by_agent . OPTIONAL { ?approved_by_agent erb:key ?approved_by_agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:parentProcedureExecution ?parent_procedure_execution . OPTIONAL { ?parent_procedure_execution erb:key ?parent_procedure_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_procedure_execution__key, IF(isIRI(?parent_procedure_execution), REPLACE(STR(?parent_procedure_execution), "^.*[#/]", ""), STR(?parent_procedure_execution))), ""), "|", COALESCE(COALESCE(?approved_by_agent__key, IF(isIRI(?approved_by_agent), REPLACE(STR(?approved_by_agent), "^.*[#/]", ""), STR(?approved_by_agent))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExceptionInvocations_ParentProcedureExecution a sh:NodeShape ;
    sh:targetClass pko-extension:ExceptionInvocation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ParentProcedureExecution" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:parentProcedureExecution ?_result .
            }
            WHERE {
    $this a pko-extension:ExceptionInvocation .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:StepExecution . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:procedureExecution ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExceptionInvocations_ApproverPreparedCount a sh:NodeShape ;
    sh:targetClass pko-extension:ExceptionInvocation ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ApproverPreparedCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:approverPreparedCount ?_result .
            }
            WHERE {
    $this a pko-extension:ExceptionInvocation .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ExceptionInvocation .
                    ?child a pko:StepExecution .
                    ?child pko-native-procedural-knowledge-rulebook:preparerAgentKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:invokerAlsoPreparedKey ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExceptionInvocations_DelegatedToPreparer a sh:NodeShape ;
    sh:targetClass pko-extension:ExceptionInvocation ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_DelegatedToPreparer" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:delegatedToPreparer ?_result .
            }
            WHERE {
    $this a pko-extension:ExceptionInvocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:approverPreparedCount ?approver_prepared_count . }
                BIND((COALESCE(?approver_prepared_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExceptionInvocations_IsUngovernedInvocation a sh:NodeShape ;
    sh:targetClass pko-extension:ExceptionInvocation ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_IsUngovernedInvocation" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUngovernedInvocation ?_result .
            }
            WHERE {
    $this a pko-extension:ExceptionInvocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:delegatedToPreparer ?delegated_to_preparer . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isImproperlyApproved ?is_improperly_approved . }
                BIND((COALESCE(?is_improperly_approved, false) || COALESCE(?delegated_to_preparer, false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Exceptions ===
pko-native-procedural-knowledge-rulebook-shapes:Exceptions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:Exception ;
