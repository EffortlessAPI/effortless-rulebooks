                BIND((COALESCE((COALESCE(?change_operation__key, COALESCE(IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation)), "")) = "ReassignAgent"), false) && COALESCE((COALESCE(?classification__key, COALESCE(IF(isIRI(?classification), REPLACE(STR(?classification), "^.*[#/]", ""), STR(?classification)), "")) != "DataOperation"), false)) AS ?_result)
