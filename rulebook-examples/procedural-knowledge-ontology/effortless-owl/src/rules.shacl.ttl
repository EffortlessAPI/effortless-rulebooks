            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:stepWhenBinding ?_result .
            }
            WHERE {
    $this a pko-extension:AuthorityBoundary .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . }
                BIND(IF(COALESCE(?is_currently_binding, false), ?step, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AuthorityBoundaries_BoundaryMatchKey a sh:NodeShape ;
    sh:targetClass pko-extension:AuthorityBoundary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_BoundaryMatchKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:boundaryMatchKey ?_result .
            }
            WHERE {
    $this a pko-extension:AuthorityBoundary .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:forbiddenAgentKind ?forbidden_agent_kind . OPTIONAL { ?forbidden_agent_kind erb:key ?forbidden_agent_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:forbiddenDecisionKind ?forbidden_decision_kind . OPTIONAL { ?forbidden_decision_kind erb:key ?forbidden_decision_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), "|", COALESCE(COALESCE(?forbidden_agent_kind__key, IF(isIRI(?forbidden_agent_kind), REPLACE(STR(?forbidden_agent_kind), "^.*[#/]", ""), STR(?forbidden_agent_kind))), ""), "|", COALESCE(COALESCE(?forbidden_decision_kind__key, IF(isIRI(?forbidden_decision_kind), REPLACE(STR(?forbidden_decision_kind), "^.*[#/]", ""), STR(?forbidden_decision_kind))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AuthorityBoundaries_ViolationCount a sh:NodeShape ;
    sh:targetClass pko-extension:AuthorityBoundary ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_ViolationCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:violationCount ?_result .
            }
            WHERE {
    $this a pko-extension:AuthorityBoundary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AuthorityBoundary .
                    ?child a pko-extension:AgentDecisionRecord .
                    ?child pko-native-procedural-knowledge-rulebook:boundaryMatchKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:boundaryMatchKey ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
