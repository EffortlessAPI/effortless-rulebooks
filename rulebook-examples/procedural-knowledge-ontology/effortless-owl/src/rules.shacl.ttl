    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_IsSourceChangedSinceTaken" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSourceChangedSinceTaken ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:sourceCollectedAt ?source_collected_at . }
    OPTIONAL { $this effortless-ntwf:sourceRevisedAt ?source_revised_at . OPTIONAL { ?source_revised_at effortless-ntwf:__key ?source_revised_at__key . } }
                BIND((COALESCE((COALESCE(?source_revised_at__key, COALESCE(IF(isIRI(?source_revised_at), REPLACE(STR(?source_revised_at), "^.*[#/]", ""), STR(?source_revised_at)), "")) != ""), false) && COALESCE(COALESCE((?source_revised_at > ?source_collected_at), false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_ModeledDurationMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:modeledDurationMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:expectedDurationMinutes ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_IsUnfaithfulToSource" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnfaithfulToSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:modeledDurationMinutes ?modeled_duration_minutes . }
    OPTIONAL { $this effortless-ntwf:sourceStatedDurationMinutes ?source_stated_duration_minutes . }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND((COALESCE((COALESCE(?step__key, COALESCE(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step)), "")) != ""), false) && COALESCE((COALESCE(?source_stated_duration_minutes, 0) > 0), false) && COALESCE((COALESCE(?modeled_duration_minutes, 0) != COALESCE(?source_stated_duration_minutes, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_DerivedByAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:derivedByAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
                OPTIONAL { $this effortless-ntwf:derivedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_IsMachineDerived" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMachineDerived ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:derivedByAgent ?derived_by_agent . OPTIONAL { ?derived_by_agent effortless-ntwf:__key ?derived_by_agent__key . } }
    OPTIONAL { $this effortless-ntwf:derivedByAgentKind ?derived_by_agent_kind . OPTIONAL { ?derived_by_agent_kind effortless-ntwf:__key ?derived_by_agent_kind__key . } }
                BIND((COALESCE((COALESCE(?derived_by_agent__key, COALESCE(IF(isIRI(?derived_by_agent), REPLACE(STR(?derived_by_agent), "^.*[#/]", ""), STR(?derived_by_agent)), "")) != ""), false) && COALESCE((COALESCE(?derived_by_agent_kind__key, COALESCE(IF(isIRI(?derived_by_agent_kind), REPLACE(STR(?derived_by_agent_kind), "^.*[#/]", ""), STR(?derived_by_agent_kind)), "")) != "Human"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_IsSelfValidated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSelfValidated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:derivedByAgent ?derived_by_agent . }
    OPTIONAL { $this effortless-ntwf:validatedByAgent ?validated_by_agent . OPTIONAL { ?validated_by_agent effortless-ntwf:__key ?validated_by_agent__key . } }
                BIND((COALESCE((COALESCE(?validated_by_agent__key, COALESCE(IF(isIRI(?validated_by_agent), REPLACE(STR(?validated_by_agent), "^.*[#/]", ""), STR(?validated_by_agent)), "")) != ""), false) && COALESCE(COALESCE((?validated_by_agent = ?derived_by_agent), ((!BOUND(?validated_by_agent) || STR(?validated_by_agent) = "") && (!BOUND(?derived_by_agent) || STR(?derived_by_agent) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_HasIncompleteProvenance" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasIncompleteProvenance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:derivationRoute ?derivation_route . OPTIONAL { ?derivation_route effortless-ntwf:__key ?derivation_route__key . } }
    OPTIONAL { $this effortless-ntwf:sourceMaterial ?source_material . OPTIONAL { ?source_material effortless-ntwf:__key ?source_material__key . } }
    OPTIONAL { $this effortless-ntwf:validatedByAgent ?validated_by_agent . OPTIONAL { ?validated_by_agent effortless-ntwf:__key ?validated_by_agent__key . } }
                BIND((COALESCE((COALESCE(?source_material__key, COALESCE(IF(isIRI(?source_material), REPLACE(STR(?source_material), "^.*[#/]", ""), STR(?source_material)), "")) = ""), false) || COALESCE((COALESCE(?derivation_route__key, COALESCE(IF(isIRI(?derivation_route), REPLACE(STR(?derivation_route), "^.*[#/]", ""), STR(?derivation_route)), "")) = ""), false) || COALESCE((COALESCE(?validated_by_agent__key, COALESCE(IF(isIRI(?validated_by_agent), REPLACE(STR(?validated_by_agent), "^.*[#/]", ""), STR(?validated_by_agent)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_ProvenanceStatement" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:provenanceStatement ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:derivationRoute ?derivation_route . OPTIONAL { ?derivation_route effortless-ntwf:__key ?derivation_route__key . } }
    OPTIONAL { $this effortless-ntwf:derivedByAgent ?derived_by_agent . OPTIONAL { ?derived_by_agent effortless-ntwf:__key ?derived_by_agent__key . } }
    OPTIONAL { $this effortless-ntwf:sourceMaterial ?source_material . OPTIONAL { ?source_material effortless-ntwf:__key ?source_material__key . } }
    OPTIONAL { $this effortless-ntwf:validatedByAgent ?validated_by_agent . OPTIONAL { ?validated_by_agent effortless-ntwf:__key ?validated_by_agent__key . } }
                BIND(CONCAT("From ", COALESCE(COALESCE(?source_material__key, IF(isIRI(?source_material), REPLACE(STR(?source_material), "^.*[#/]", ""), STR(?source_material))), ""), "; route: ", COALESCE(COALESCE(?derivation_route__key, IF(isIRI(?derivation_route), REPLACE(STR(?derivation_route), "^.*[#/]", ""), STR(?derivation_route))), ""), "; derived by ", COALESCE(COALESCE(?derived_by_agent__key, IF(isIRI(?derived_by_agent), REPLACE(STR(?derived_by_agent), "^.*[#/]", ""), STR(?derived_by_agent))), ""), "; confirmed by ", COALESCE(COALESCE(?validated_by_agent__key, IF(isIRI(?validated_by_agent), REPLACE(STR(?validated_by_agent), "^.*[#/]", ""), STR(?validated_by_agent))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_IsAspectUnsupportedBySourceKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAspectUnsupportedBySourceKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:sourceMaterialKind ?source_material_kind . OPTIONAL { ?source_material_kind effortless-ntwf:__key ?source_material_kind__key . } }
    OPTIONAL { $this effortless-ntwf:tracedAspect ?traced_aspect . OPTIONAL { ?traced_aspect effortless-ntwf:__key ?traced_aspect__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?traced_aspect__key, COALESCE(IF(isIRI(?traced_aspect), REPLACE(STR(?traced_aspect), "^.*[#/]", ""), STR(?traced_aspect)), "")) = "Workaround"), false) && COALESCE((COALESCE(?source_material_kind__key, COALESCE(IF(isIRI(?source_material_kind), REPLACE(STR(?source_material_kind), "^.*[#/]", ""), STR(?source_material_kind)), "")) != "FieldNotes"), false)), false) || COALESCE((COALESCE((COALESCE(?traced_aspect__key, COALESCE(IF(isIRI(?traced_aspect), REPLACE(STR(?traced_aspect), "^.*[#/]", ""), STR(?traced_aspect)), "")) = "ActualExecution"), false) && COALESCE((COALESCE(?source_material_kind__key, COALESCE(IF(isIRI(?source_material_kind), REPLACE(STR(?source_material_kind), "^.*[#/]", ""), STR(?source_material_kind)), "")) != "MinedEventTrace"), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_IsDocumentOrigin" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDocumentOrigin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:sourceIsDocument ?source_is_document . }
    OPTIONAL { $this effortless-ntwf:traceRole ?trace_role . OPTIONAL { ?trace_role effortless-ntwf:__key ?trace_role__key . } }
                BIND((COALESCE((COALESCE(?trace_role__key, COALESCE(IF(isIRI(?trace_role), REPLACE(STR(?trace_role), "^.*[#/]", ""), STR(?trace_role)), "")) = "Origin"), false) && COALESCE(?source_is_document, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_StepElicitedValidationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepElicitedValidationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:elicitedValidationCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_StepElicitedExtensionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepElicitedExtensionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:elicitedExtensionCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_IsDocumentStartNeverValidated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDocumentStartNeverValidated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:isDocumentOrigin ?is_document_origin . }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
    OPTIONAL { $this effortless-ntwf:stepElicitedValidationCount ?step_elicited_validation_count . }
                BIND((COALESCE(?is_document_origin, false) && COALESCE((COALESCE(?step__key, COALESCE(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step)), "")) != ""), false) && COALESCE((COALESCE(?step_elicited_validation_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_IsDocumentStartNeverExtended" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDocumentStartNeverExtended ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:isDocumentOrigin ?is_document_origin . }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
    OPTIONAL { $this effortless-ntwf:stepElicitedExtensionCount ?step_elicited_extension_count . }
                BIND((COALESCE(?is_document_origin, false) && COALESCE((COALESCE(?step__key, COALESCE(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step)), "")) != ""), false) && COALESCE((COALESCE(?step_elicited_extension_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_ContradictedDocumentRevisedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:contradictedDocumentRevisedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
                OPTIONAL { $this effortless-ntwf:contradictedDocument ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Resources ; effortless-ntwf:resourceId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:modifiedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_IsDocumentTrailingPractice" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDocumentTrailingPractice ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:contradictedDocument ?contradicted_document . OPTIONAL { ?contradicted_document effortless-ntwf:__key ?contradicted_document__key . } }
    OPTIONAL { $this effortless-ntwf:contradictedDocumentRevisedAt ?contradicted_document_revised_at . }
    OPTIONAL { $this effortless-ntwf:sourceCollectedAt ?source_collected_at . }
    OPTIONAL { $this effortless-ntwf:sourceIsPracticeEvidence ?source_is_practice_evidence . }
    OPTIONAL { $this effortless-ntwf:traceRole ?trace_role . OPTIONAL { ?trace_role effortless-ntwf:__key ?trace_role__key . } }
                BIND((COALESCE((COALESCE(?trace_role__key, COALESCE(IF(isIRI(?trace_role), REPLACE(STR(?trace_role), "^.*[#/]", ""), STR(?trace_role)), "")) = "Contradicts"), false) && COALESCE((COALESCE(?contradicted_document__key, COALESCE(IF(isIRI(?contradicted_document), REPLACE(STR(?contradicted_document), "^.*[#/]", ""), STR(?contradicted_document)), "")) != ""), false) && COALESCE(?source_is_practice_evidence, false) && COALESCE(COALESCE((?source_collected_at > ?contradicted_document_revised_at), false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTraces_PrescribedVersusEnacted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:prescribedVersusEnacted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:contradictedDocument ?contradicted_document . OPTIONAL { ?contradicted_document effortless-ntwf:__key ?contradicted_document__key . } }
    OPTIONAL { $this effortless-ntwf:sourceMaterial ?source_material . OPTIONAL { ?source_material effortless-ntwf:__key ?source_material__key . } }
    OPTIONAL { $this effortless-ntwf:sourceStatement ?source_statement . OPTIONAL { ?source_statement effortless-ntwf:__key ?source_statement__key . } }
                BIND(IF(COALESCE((COALESCE(?contradicted_document__key, COALESCE(IF(isIRI(?contradicted_document), REPLACE(STR(?contradicted_document), "^.*[#/]", ""), STR(?contradicted_document)), "")) = ""), false), "", CONCAT("Prescribed in ", COALESCE(COALESCE(?contradicted_document__key, IF(isIRI(?contradicted_document), REPLACE(STR(?contradicted_document), "^.*[#/]", ""), STR(?contradicted_document))), ""), "; enacted per ", COALESCE(COALESCE(?source_material__key, IF(isIRI(?source_material), REPLACE(STR(?source_material), "^.*[#/]", ""), STR(?source_material))), ""), ": ", COALESCE(COALESCE(?source_statement__key, IF(isIRI(?source_statement), REPLACE(STR(?source_statement), "^.*[#/]", ""), STR(?source_statement))), ""))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeTransfers ===
effortless-ntwf:KnowledgeTransfersShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeTransfers ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTransfers .
    OPTIONAL { $this effortless-ntwf:channel ?channel . OPTIONAL { ?channel effortless-ntwf:__key ?channel__key . } }
    OPTIONAL { $this effortless-ntwf:knowHow ?know_how . OPTIONAL { ?know_how effortless-ntwf:__key ?know_how__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?know_how__key, IF(isIRI(?know_how), REPLACE(STR(?know_how), "^.*[#/]", ""), STR(?know_how))), ""), " via ", COALESCE(COALESCE(?channel__key, IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_FromOrganization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fromOrganization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTransfers .
                OPTIONAL { $this effortless-ntwf:fromAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_RecipientRoleCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientRoleCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTransfers .
                OPTIONAL { $this effortless-ntwf:recipientAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:countOfCurrentRoleAssignments ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_IsTraditionalChannel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isTraditionalChannel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTransfers .
    OPTIONAL { $this effortless-ntwf:channel ?channel . OPTIONAL { ?channel effortless-ntwf:__key ?channel__key . } }
                BIND((COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "Document"), false) || COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "TrainingProgram"), false) || COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "Mentoring"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_IsSocialNetworkChannel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSocialNetworkChannel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTransfers .
    OPTIONAL { $this effortless-ntwf:channel ?channel . OPTIONAL { ?channel effortless-ntwf:__key ?channel__key . } }
                BIND((COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "PersonalRelationship"), false) || COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "Collaboration"), false) || COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "DesignProductionIteration"), false) || COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "EmployerChange"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_IsAmbientAbsorptionByNonPractitioner" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAmbientAbsorptionByNonPractitioner ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTransfers .
    OPTIONAL { $this effortless-ntwf:channel ?channel . OPTIONAL { ?channel effortless-ntwf:__key ?channel__key . } }
    OPTIONAL { $this effortless-ntwf:recipientAgent ?recipient_agent . OPTIONAL { ?recipient_agent effortless-ntwf:__key ?recipient_agent__key . } }
    OPTIONAL { $this effortless-ntwf:recipientRoleCount ?recipient_role_count . }
                BIND((COALESCE((COALESCE(?recipient_agent__key, COALESCE(IF(isIRI(?recipient_agent), REPLACE(STR(?recipient_agent), "^.*[#/]", ""), STR(?recipient_agent)), "")) != ""), false) && COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "AmbientExposure"), false) && COALESCE((COALESCE(?recipient_role_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeWorkforcePositions ===
effortless-ntwf:KnowledgeWorkforcePositionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeWorkforcePositions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeWorkforcePositions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeWorkforcePositions .
    OPTIONAL { $this effortless-ntwf:discipline ?discipline . OPTIONAL { ?discipline effortless-ntwf:__key ?discipline__key . } }
    OPTIONAL { $this effortless-ntwf:organization ?organization . OPTIONAL { ?organization effortless-ntwf:__key ?organization__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?organization__key, IF(isIRI(?organization), REPLACE(STR(?organization), "^.*[#/]", ""), STR(?organization))), ""), " ", COALESCE(COALESCE(?discipline__key, IF(isIRI(?discipline), REPLACE(STR(?discipline), "^.*[#/]", ""), STR(?discipline))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for LearningActivities ===
effortless-ntwf:LearningActivitiesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:LearningActivities ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LearningActivities_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:LearningActivities .
    OPTIONAL { $this effortless-ntwf:activityKind ?activity_kind . OPTIONAL { ?activity_kind effortless-ntwf:__key ?activity_kind__key . } }
    OPTIONAL { $this effortless-ntwf:occurredAt ?occurred_at . OPTIONAL { ?occurred_at effortless-ntwf:__key ?occurred_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?activity_kind__key, IF(isIRI(?activity_kind), REPLACE(STR(?activity_kind), "^.*[#/]", ""), STR(?activity_kind))), ""), " / ", COALESCE(REPLACE(COALESCE(?occurred_at__key, IF(isIRI(?occurred_at), REPLACE(STR(?occurred_at), "^.*[#/]", ""), STR(?occurred_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for LevelCaptureStrategies ===
effortless-ntwf:LevelCaptureStrategiesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:LevelCaptureStrategies ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LevelCaptureStrategies_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:LevelCaptureStrategies .
    OPTIONAL { $this effortless-ntwf:description ?description . }
    OPTIONAL { $this effortless-ntwf:knowledgeForm ?knowledge_form . OPTIONAL { ?knowledge_form effortless-ntwf:__key ?knowledge_form__key . } }
    OPTIONAL { $this effortless-ntwf:level ?level . OPTIONAL { ?level effortless-ntwf:__key ?level__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?level__key, IF(isIRI(?level), REPLACE(STR(?level), "^.*[#/]", ""), STR(?level))), ""), " ", COALESCE(COALESCE(?knowledge_form__key, IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?description), 1, 40)), REPLACE(STR(SUBSTR(STR(?description), 1, 40)), "^.*[#/]", ""), STR(SUBSTR(STR(?description), 1, 40))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LevelCaptureStrategies_ContradictsKnowledgeForm" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:contradictsKnowledgeForm ?_result .
            }
            WHERE {
    $this a effortless-ntwf:LevelCaptureStrategies .
    OPTIONAL { $this effortless-ntwf:knowledgeForm ?knowledge_form . OPTIONAL { ?knowledge_form effortless-ntwf:__key ?knowledge_form__key . } }
    OPTIONAL { $this effortless-ntwf:transferMode ?transfer_mode . OPTIONAL { ?transfer_mode effortless-ntwf:__key ?transfer_mode__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?knowledge_form__key, COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), "")) = "Tacit"), false) && COALESCE((COALESCE(?transfer_mode__key, COALESCE(IF(isIRI(?transfer_mode), REPLACE(STR(?transfer_mode), "^.*[#/]", ""), STR(?transfer_mode)), "")) = "Codified"), false)), false) || COALESCE((COALESCE((COALESCE(?knowledge_form__key, COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), "")) = "Explicit"), false) && COALESCE((COALESCE(?transfer_mode__key, COALESCE(IF(isIRI(?transfer_mode), REPLACE(STR(?transfer_mode), "^.*[#/]", ""), STR(?transfer_mode)), "")) = "InPerson"), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for LevelPyramidQuestions ===
effortless-ntwf:LevelPyramidQuestionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:LevelPyramidQuestions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LevelPyramidQuestions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:LevelPyramidQuestions .
    OPTIONAL { $this effortless-ntwf:level ?level . OPTIONAL { ?level effortless-ntwf:__key ?level__key . } }
    OPTIONAL { $this effortless-ntwf:questionKind ?question_kind . OPTIONAL { ?question_kind effortless-ntwf:__key ?question_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?level__key, IF(isIRI(?level), REPLACE(STR(?level), "^.*[#/]", ""), STR(?level))), ""), " answers ", COALESCE(COALESCE(?question_kind__key, IF(isIRI(?question_kind), REPLACE(STR(?question_kind), "^.*[#/]", ""), STR(?question_kind))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for LifecycleStatuses ===
effortless-ntwf:LifecycleStatusesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:LifecycleStatuses ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LifecycleStatuses_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:LifecycleStatuses .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LifecycleStatuses_VersionUseCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:versionUseCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:LifecycleStatuses .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureVersions .
                    ?child effortless-ntwf:status $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LifecycleStatuses_ExecutionUseCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:executionUseCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:LifecycleStatuses .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureExecutions .
                    ?child effortless-ntwf:executionStatus $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LifecycleStatuses_IsNonPkoStatusInUse" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNonPkoStatusInUse ?_result .
            }
            WHERE {
    $this a effortless-ntwf:LifecycleStatuses .
    OPTIONAL { $this effortless-ntwf:executionUseCount ?execution_use_count . }
    OPTIONAL { $this effortless-ntwf:isPkoStatus ?is_pko_status . }
    OPTIONAL { $this effortless-ntwf:versionUseCount ?version_use_count . }
                BIND((COALESCE((COALESCE(?is_pko_status, false) = false), false) && COALESCE((COALESCE((?version_use_count + ?execution_use_count), 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for LockDevices ===
effortless-ntwf:LockDevicesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:LockDevices ;
