    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceAgentIsStillEngaged ?source_agent_is_still_engaged . }
                BIND((COALESCE(?is_currently_valid, false) && COALESCE((!(COALESCE(?source_agent_is_still_engaged, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeFragments_IsUndefendableTacitClaim a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeFragment ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsUndefendableTacitClaim" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUndefendableTacitClaim ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeFragment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasOrphanedProvenance ?has_orphaned_provenance . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeForm ?knowledge_form . OPTIONAL { ?knowledge_form erb:key ?knowledge_form__key . } }
                BIND((COALESCE(?has_orphaned_provenance, false) && COALESCE((COALESCE((COALESCE(?knowledge_form__key, COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), "")) = "Tacit"), false) || COALESCE((COALESCE(?knowledge_form__key, COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), "")) = "SituatedJudgment"), false)), false)) AS ?_result)
            }
        """ ;
    ] .
