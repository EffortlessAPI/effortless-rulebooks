                BIND(ROUND(IF(COALESCE((COALESCE((COALESCE(?started_at__key, COALESCE(IF(isIRI(?started_at), REPLACE(STR(?started_at), "^.*[#/]", ""), STR(?started_at)), "")) = ""), false) || COALESCE((COALESCE(?proficient_at__key, COALESCE(IF(isIRI(?proficient_at), REPLACE(STR(?proficient_at), "^.*[#/]", ""), STR(?proficient_at)), "")) = ""), false)), false), 0, ((DAY(?proficient_at) + FLOOR((153 * (MONTH(?proficient_at) + 12 * FLOOR((14 - MONTH(?proficient_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?proficient_at) + 4800 - FLOOR((14 - MONTH(?proficient_at)) / 12)) + FLOOR((YEAR(?proficient_at) + 4800 - FLOOR((14 - MONTH(?proficient_at)) / 12)) / 4) - FLOOR((YEAR(?proficient_at) + 4800 - FLOOR((14 - MONTH(?proficient_at)) / 12)) / 100) + FLOOR((YEAR(?proficient_at) + 4800 - FLOOR((14 - MONTH(?proficient_at)) / 12)) / 400) - 32045) - (DAY(?started_at) + FLOOR((153 * (MONTH(?started_at) + 12 * FLOOR((14 - MONTH(?started_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 4) - FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 100) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OnboardingRecords_DaysSinceStart a sh:NodeShape ;
    sh:targetClass pko-extension:OnboardingRecord ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OnboardingRecords_DaysSinceStart" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceStart ?_result .
            }
            WHERE {
    $this a pko-extension:OnboardingRecord .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:startedAt ?started_at . OPTIONAL { ?started_at erb:key ?started_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?started_at__key, COALESCE(IF(isIRI(?started_at), REPLACE(STR(?started_at), "^.*[#/]", ""), STR(?started_at)), "")) = ""), false), 99999, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?started_at) + FLOOR((153 * (MONTH(?started_at) + 12 * FLOOR((14 - MONTH(?started_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 4) - FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 100) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OnboardingRecords_IsRecentStart a sh:NodeShape ;
    sh:targetClass pko-extension:OnboardingRecord ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OnboardingRecords_IsRecentStart" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
