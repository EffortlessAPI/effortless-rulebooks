# === Rules for InterviewProbes ===
pko-native-procedural-knowledge-rulebook-shapes:InterviewProbes_Name a sh:NodeShape ;
    sh:targetClass pko-extension:InterviewProbe ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InterviewProbes_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:InterviewProbe .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:probeKind ?probe_kind . OPTIONAL { ?probe_kind erb:key ?probe_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:prompt ?prompt . }
                BIND(CONCAT(COALESCE(COALESCE(?probe_kind__key, IF(isIRI(?probe_kind), REPLACE(STR(?probe_kind), "^.*[#/]", ""), STR(?probe_kind))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?prompt), 1, 60)), REPLACE(STR(SUBSTR(STR(?prompt), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?prompt), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:InterviewProbes_WhyAnswer a sh:NodeShape ;
    sh:targetClass pko-extension:InterviewProbe ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InterviewProbes_WhyAnswer" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:whyAnswer ?_result .
            }
            WHERE {
    $this a pko-extension:InterviewProbe .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:answer ?answer . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:probeKind ?probe_kind . OPTIONAL { ?probe_kind erb:key ?probe_kind__key . } }
                BIND(IF(COALESCE((COALESCE(?probe_kind__key, COALESCE(IF(isIRI(?probe_kind), REPLACE(STR(?probe_kind), "^.*[#/]", ""), STR(?probe_kind)), "")) = "Why"), false), ?answer, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:InterviewProbes_ShortfallAnswer a sh:NodeShape ;
    sh:targetClass pko-extension:InterviewProbe ;
