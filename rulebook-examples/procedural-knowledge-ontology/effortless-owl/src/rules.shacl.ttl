    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_UsesAiInOneDirectionOnly" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:usesAiInOneDirectionOnly ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:aiConsumptionCount ?ai_consumption_count . }
    OPTIONAL { $this effortless-ntwf:aiContributionCount ?ai_contribution_count . }
                BIND((COALESCE((COALESCE((COALESCE(?ai_contribution_count, 0) > 0), false) && COALESCE((COALESCE(?ai_consumption_count, 0) = 0), false)), false) || COALESCE((COALESCE((COALESCE(?ai_contribution_count, 0) = 0), false) && COALESCE((COALESCE(?ai_consumption_count, 0) > 0), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsUnmodifiedForTwelveMonths" ;
        sh:prefixes effortless-ntwf: ;
