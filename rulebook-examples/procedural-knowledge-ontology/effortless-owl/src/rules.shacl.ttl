                    ?child effortless-ntwf:sourceAgent ?backfk .
                    $this effortless-ntwf:holderAgent ?backpv .
                    OPTIONAL { ?child effortless-ntwf:procedure ?c2 . }
                    OPTIONAL { $this effortless-ntwf:procedure ?p2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(REPLACE(STR(?c2), "^.*[#/]", "") = REPLACE(STR(?p2), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
