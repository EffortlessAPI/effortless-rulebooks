    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_SegmentCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:segmentCount ?_result .
            }
            WHERE {
    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:policyMaxMessageLengthAtSend ?policy_max_message_length_at_send . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:renderedBodyLength ?rendered_body_length . }
                BIND(ROUND(IF(COALESCE((COALESCE(?rendered_body_length, 0) = 0), false), 0, IF(COALESCE((COALESCE(?rendered_body_length, 0) <= COALESCE(?policy_max_message_length_at_send, 0)), false), 1, (CEIL(xsd:double(?rendered_body_length / ?policy_max_message_length_at_send) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double))))) AS ?_result)
            }
        """ ;
    ] .
