            CONSTRUCT {
                $this effortless-ntwf:refusedOnOptOutOnly ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:lengthGatePassed ?length_gate_passed . }
    OPTIONAL { $this effortless-ntwf:optOutGatePassed ?opt_out_gate_passed . }
                BIND((COALESCE((!(COALESCE(?opt_out_gate_passed, false))), false) && COALESCE(?length_gate_passed, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RefusalWasOnMyRules" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:refusalWasOnMyRules ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:contentGatePassed ?content_gate_passed . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
    OPTIONAL { $this effortless-ntwf:timingGatePassed ?timing_gate_passed . }
                BIND((COALESCE((!(COALESCE(?is_cleared_to_send, false))), false) && COALESCE((COALESCE((!(COALESCE(?content_gate_passed, false))), false) || COALESCE((!(COALESCE(?timing_gate_passed, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RefusalWasOutsideMyControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:refusalWasOutsideMyControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:authorizationGatePassed ?authorization_gate_passed . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
    OPTIONAL { $this effortless-ntwf:permissionGatePassed ?permission_gate_passed . }
                BIND((COALESCE((!(COALESCE(?is_cleared_to_send, false))), false) && COALESCE((COALESCE((!(COALESCE(?permission_gate_passed, false))), false) || COALESCE((!(COALESCE(?authorization_gate_passed, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsUnreportedRefusalOnMyRules" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnreportedRefusalOnMyRules ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:approverWasNotified ?approver_was_notified . }
    OPTIONAL { $this effortless-ntwf:refusalWasOnMyRules ?refusal_was_on_my_rules . }
                BIND((COALESCE(?refusal_was_on_my_rules, false) && COALESCE((!(COALESCE(?approver_was_notified, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsApprovalOverriddenSilently" ;
        sh:prefixes effortless-ntwf: ;
