pko-native-procedural-knowledge-rulebook-shapes:OntologyProfiles_RecentDeprecationCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:OntologyProfiles ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_RecentDeprecationCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:recentDeprecationCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:OntologyProfiles .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:OntologyProfiles .
                    ?child a pko-extension:ExternalStandardTerm .
                    ?child pko-native-procedural-knowledge-rulebook:ontologyProfile $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isRecentDeprecation ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OntologyProfiles_RequiresFrequentReview a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:OntologyProfiles ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_RequiresFrequentReview" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:requiresFrequentReview ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:OntologyProfiles .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceMajorRevision ?days_since_major_revision . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastMajorRevisionAt ?last_major_revision_at . OPTIONAL { ?last_major_revision_at erb:key ?last_major_revision_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recentDeprecationCount ?recent_deprecation_count . }
                BIND((COALESCE((COALESCE(?recent_deprecation_count, 0) >= 2), false) || COALESCE((COALESCE((COALESCE(?last_major_revision_at__key, COALESCE(IF(isIRI(?last_major_revision_at), REPLACE(STR(?last_major_revision_at), "^.*[#/]", ""), STR(?last_major_revision_at)), "")) != ""), false) && COALESCE((COALESCE(?days_since_major_revision, 0) < 730), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OntologyProfiles_ChangeRateProfile a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:OntologyProfiles ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_ChangeRateProfile" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:changeRateProfile ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:OntologyProfiles .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceLastRevision ?days_since_last_revision . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceMajorRevision ?days_since_major_revision . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastMajorRevisionAt ?last_major_revision_at . OPTIONAL { ?last_major_revision_at erb:key ?last_major_revision_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastRevisedAt ?last_revised_at . OPTIONAL { ?last_revised_at erb:key ?last_revised_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recentDeprecationCount ?recent_deprecation_count . }
                BIND(IF(COALESCE((COALESCE(?recent_deprecation_count, 0) >= 2), false), "FrequentDeprecation", IF(COALESCE((COALESCE((COALESCE(?last_major_revision_at__key, COALESCE(IF(isIRI(?last_major_revision_at), REPLACE(STR(?last_major_revision_at), "^.*[#/]", ""), STR(?last_major_revision_at)), "")) != ""), false) && COALESCE((COALESCE(?days_since_major_revision, 0) < 730), false)), false), "RecentMajorRevision", IF(COALESCE((COALESCE((COALESCE(?last_revised_at__key, COALESCE(IF(isIRI(?last_revised_at), REPLACE(STR(?last_revised_at), "^.*[#/]", ""), STR(?last_revised_at)), "")) != ""), false) && COALESCE((COALESCE(?days_since_last_revision, 0) > 3650), false)), false), "Dormant", "Unassessed"))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OntologyProfiles_IsReviewOverdueForChangeRate a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:OntologyProfiles ;
    sh:order 6 ;
    sh:rule [
