            }
            WHERE {
    $this a pko-extension:CueObservation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isUnescalatedDangerCue ?is_unescalated_danger_cue . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . }
