            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:roleMentionCount ?_result .
            }
            WHERE {
    $this a pro:Role .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pro:Role .
                    ?child a pko-extension:SourceTermMention .
                    ?child pko-native-procedural-knowledge-rulebook:intendedTermRole ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:roleId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
