    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_IsReleaseWithoutRecordedChanges" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isReleaseWithoutRecordedChanges ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:logEntryCount ?log_entry_count . }
    OPTIONAL { $this effortless-ntwf:previousRelease ?previous_release . OPTIONAL { ?previous_release effortless-ntwf:__key ?previous_release__key . } }
                BIND((COALESCE((COALESCE(?previous_release__key, COALESCE(IF(isIRI(?previous_release), REPLACE(STR(?previous_release), "^.*[#/]", ""), STR(?previous_release)), "")) != ""), false) && COALESCE((COALESCE(?log_entry_count, 0) = 0), false)) AS ?_result)
            }
