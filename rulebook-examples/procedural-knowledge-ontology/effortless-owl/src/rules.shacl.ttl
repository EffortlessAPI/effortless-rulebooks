pko-native-procedural-knowledge-rulebook-shapes:ReviewEvents_DaysSinceReviewed a sh:NodeShape ;
    sh:targetClass pko:ReviewEvent ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_DaysSinceReviewed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceReviewed ?_result .
            }
            WHERE {
    $this a pko:ReviewEvent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reviewedAt ?reviewed_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?reviewed_at) + FLOOR((153 * (MONTH(?reviewed_at) + 12 * FLOOR((14 - MONTH(?reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ReviewEvents_ExceedsPromisedCadence a sh:NodeShape ;
    sh:targetClass pko:ReviewEvent ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_ExceedsPromisedCadence" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:exceedsPromisedCadence ?_result .
            }
            WHERE {
    $this a pko:ReviewEvent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceReviewed ?days_since_reviewed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:promisedCadenceDays ?promised_cadence_days . }
                BIND((COALESCE(?days_since_reviewed, 0) > COALESCE(?promised_cadence_days, 0)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ReviewEvents_CadenceDriftDays a sh:NodeShape ;
