# === Rules for PractitionerExpertise ===
pko-native-procedural-knowledge-rulebook-shapes:PractitionerExpertise_Name a sh:NodeShape ;
    sh:targetClass pko-extension:PractitionerExpertise ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PractitionerExpertise_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:PractitionerExpertise .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:agent ?agent . OPTIONAL { ?agent erb:key ?agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cue ?cue . OPTIONAL { ?cue erb:key ?cue__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?agent__key, IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent))), ""), ": ", COALESCE(COALESCE(?cue__key, IF(isIRI(?cue), REPLACE(STR(?cue), "^.*[#/]", ""), STR(?cue))), "")) AS ?_result)
            }
        """ ;
