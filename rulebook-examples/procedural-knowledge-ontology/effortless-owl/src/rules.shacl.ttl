    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:publishedAt ?published_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?published_at) + FLOOR((153 * (MONTH(?published_at) + 12 * FLOOR((14 - MONTH(?published_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?published_at) + 4800 - FLOOR((14 - MONTH(?published_at)) / 12)) + FLOOR((YEAR(?published_at) + 4800 - FLOOR((14 - MONTH(?published_at)) / 12)) / 4) - FLOOR((YEAR(?published_at) + 4800 - FLOOR((14 - MONTH(?published_at)) / 12)) / 100) + FLOOR((YEAR(?published_at) + 4800 - FLOOR((14 - MONTH(?published_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExternalDependencyRevisions_IsUntrackedRevision a sh:NodeShape ;
    sh:targetClass pko-extension:ExternalDependencyRevision ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalDependencyRevisions_IsUntrackedRevision" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUntrackedRevision ?_result .
            }
            WHERE {
    $this a pko-extension:ExternalDependencyRevision .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:affectedMappingCount ?affected_mapping_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSincePublished ?days_since_published . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:trackedAt ?tracked_at . OPTIONAL { ?tracked_at erb:key ?tracked_at__key . } }
                BIND((COALESCE((COALESCE(?tracked_at__key, COALESCE(IF(isIRI(?tracked_at), REPLACE(STR(?tracked_at), "^.*[#/]", ""), STR(?tracked_at)), "")) = ""), false) && COALESCE((COALESCE(?affected_mapping_count, 0) > 0), false) && COALESCE((COALESCE(?days_since_published, 0) > 30), false)) AS ?_result)
            }
        """ ;
    ] .

