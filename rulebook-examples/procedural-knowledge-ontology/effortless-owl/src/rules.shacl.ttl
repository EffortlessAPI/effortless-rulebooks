    OPTIONAL { $this effortless-ntwf:refusalCitedAnException ?refusal_cited_an_exception . }
                BIND((COALESCE(?is_silently_dropped, false) && COALESCE((COALESCE((!(COALESCE(?has_durable_refusal_record, false))), false) && COALESCE((!(COALESCE(?refusal_cited_an_exception, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
