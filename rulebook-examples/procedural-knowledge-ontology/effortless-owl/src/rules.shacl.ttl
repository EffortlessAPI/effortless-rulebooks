    OPTIONAL { $this effortless-ntwf:isRetentionBreach ?is_retention_breach . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?is_retention_breach, false), ?procedure_execution, "") AS ?_result)
