                $this pko-native-procedural-knowledge-rulebook:childTemplateCount ?_result .
            }
            WHERE {
    $this a pko-extension:PromptTemplate .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:PromptTemplate .
                    ?child a pko-extension:PromptTemplate .
                    ?child pko-native-procedural-knowledge-rulebook:parentTemplate $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:PromptTemplates_IsDisconnectedPromptKnowledge a sh:NodeShape ;
    sh:targetClass pko-extension:PromptTemplate ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PromptTemplates_IsDisconnectedPromptKnowledge" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDisconnectedPromptKnowledge ?_result .
            }
            WHERE {
    $this a pko-extension:PromptTemplate .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:carriesProcedureInstructions ?carries_procedure_instructions . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceProcedureVersion ?source_procedure_version . OPTIONAL { ?source_procedure_version erb:key ?source_procedure_version__key . } }
                BIND((COALESCE(?carries_procedure_instructions, false) && COALESCE((COALESCE(?source_procedure_version__key, COALESCE(IF(isIRI(?source_procedure_version), REPLACE(STR(?source_procedure_version), "^.*[#/]", ""), STR(?source_procedure_version)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:PromptTemplates_IsUnmanagedPromptInUse a sh:NodeShape ;
    sh:targetClass pko-extension:PromptTemplate ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PromptTemplates_IsUnmanagedPromptInUse" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnmanagedPromptInUse ?_result .
            }
            WHERE {
    $this a pko-extension:PromptTemplate .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:libraryStatus ?library_status . OPTIONAL { ?library_status erb:key ?library_status__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:maintainedByRole ?maintained_by_role . OPTIONAL { ?maintained_by_role erb:key ?maintained_by_role__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usedByAgent ?used_by_agent . OPTIONAL { ?used_by_agent erb:key ?used_by_agent__key . } }
                BIND((COALESCE((COALESCE(?used_by_agent__key, COALESCE(IF(isIRI(?used_by_agent), REPLACE(STR(?used_by_agent), "^.*[#/]", ""), STR(?used_by_agent)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?library_status__key, COALESCE(IF(isIRI(?library_status), REPLACE(STR(?library_status), "^.*[#/]", ""), STR(?library_status)), "")) != "Maintained"), false) || COALESCE((COALESCE(?maintained_by_role__key, COALESCE(IF(isIRI(?maintained_by_role), REPLACE(STR(?maintained_by_role), "^.*[#/]", ""), STR(?maintained_by_role)), "")) = ""), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:PromptTemplates_SpendsBudgetOnRareDetail a sh:NodeShape ;
    sh:targetClass pko-extension:PromptTemplate ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PromptTemplates_SpendsBudgetOnRareDetail" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:spendsBudgetOnRareDetail ?_result .
            }
            WHERE {
    $this a pko-extension:PromptTemplate .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:estimatedTokens ?estimated_tokens . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:includesRareDetail ?includes_rare_detail . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:tokenBudget ?token_budget . }
                BIND((COALESCE(?includes_rare_detail, false) && COALESCE((COALESCE(?estimated_tokens, 0) > COALESCE(?token_budget, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:PromptTemplates_CondensationPercent a sh:NodeShape ;
    sh:targetClass pko-extension:PromptTemplate ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PromptTemplates_CondensationPercent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:condensationPercent ?_result .
            }
            WHERE {
    $this a pko-extension:PromptTemplate .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:estimatedTokens ?estimated_tokens . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceTokenCount ?source_token_count . }
                BIND(IF(COALESCE((COALESCE(?source_token_count, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?estimated_tokens) / ?source_token_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:PromptTemplates_IsVerbatimDump a sh:NodeShape ;
    sh:targetClass pko-extension:PromptTemplate ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PromptTemplates_IsVerbatimDump" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isVerbatimDump ?_result .
            }
            WHERE {
    $this a pko-extension:PromptTemplate .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:condensationPercent ?condensation_percent . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceTokenCount ?source_token_count . }
                BIND((COALESCE((COALESCE(?source_token_count, 0) > 0), false) && COALESCE((COALESCE(?condensation_percent, 0) >= 90), false)) AS ?_result)
            }
        """ ;
    ] .

