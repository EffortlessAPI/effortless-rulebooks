            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeImpactFindings .
    OPTIONAL { $this effortless-ntwf:findingKind ?finding_kind . OPTIONAL { ?finding_kind effortless-ntwf:__key ?finding_kind__key . } }
    OPTIONAL { $this effortless-ntwf:findingStage ?finding_stage . OPTIONAL { ?finding_stage effortless-ntwf:__key ?finding_stage__key . } }
    OPTIONAL { $this effortless-ntwf:modelChangeRequest ?model_change_request . OPTIONAL { ?model_change_request effortless-ntwf:__key ?model_change_request__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_change_request__key, IF(isIRI(?model_change_request), REPLACE(STR(?model_change_request), "^.*[#/]", ""), STR(?model_change_request))), ""), " ", COALESCE(COALESCE(?finding_kind__key, IF(isIRI(?finding_kind), REPLACE(STR(?finding_kind), "^.*[#/]", ""), STR(?finding_kind))), ""), " ", COALESCE(COALESCE(?finding_stage__key, IF(isIRI(?finding_stage), REPLACE(STR(?finding_stage), "^.*[#/]", ""), STR(?finding_stage))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ChangeIntegrityChecks ===
effortless-ntwf:ChangeIntegrityChecksShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ChangeIntegrityChecks ;
