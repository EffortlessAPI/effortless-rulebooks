    $this a effortless-ntwf:RulebookReleases .
                OPTIONAL { $this effortless-ntwf:previousRelease ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookReleases ; effortless-ntwf:rulebookReleaseId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:cqCoveragePercent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
