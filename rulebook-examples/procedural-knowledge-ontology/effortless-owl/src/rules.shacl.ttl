    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetIri ?target_iri . }
                BIND((COALESCE((SUBSTR(STR(?target_iri), 1, 4) != "http"), false) || COALESCE((COALESCE((COALESCE(?ontology_profile__key, COALESCE(IF(isIRI(?ontology_profile), REPLACE(STR(?ontology_profile), "^.*[#/]", ""), STR(?ontology_profile)), "")) != ""), false) && COALESCE((COALESCE(?profile_namespace_dereferences, false) = false), false)), false)) AS ?_result)
