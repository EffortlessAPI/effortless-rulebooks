                $this pko-native-procedural-knowledge-rulebook:hasUnengagedStakeholder ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Procedures .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:unengagedStakeholderCount ?unengaged_stakeholder_count . }
                BIND((COALESCE(?unengaged_stakeholder_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
