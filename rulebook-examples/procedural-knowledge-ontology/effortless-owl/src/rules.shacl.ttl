            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:driftFollowsCleanRelease ?_result .
            }
            WHERE {
    $this a pko-extension:DriftObservation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:observedAt ?observed_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:releaseIssuedAt ?release_issued_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:releasePassedValidation ?release_passed_validation . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sinceRelease ?since_release . OPTIONAL { ?since_release erb:key ?since_release__key . } }
                BIND((COALESCE((COALESCE(?since_release__key, COALESCE(IF(isIRI(?since_release), REPLACE(STR(?since_release), "^.*[#/]", ""), STR(?since_release)), "")) != ""), false) && COALESCE(?release_passed_validation, false) && COALESCE(COALESCE((?observed_at > ?release_issued_at), false), false)) AS ?_result)
            }
        """ ;
    ] .

