            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeTestOutcome .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:outcomeArea ?outcome_area . OPTIONAL { ?outcome_area erb:key ?outcome_area__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?procedure . OPTIONAL { ?procedure erb:key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), ": ", COALESCE(COALESCE(?outcome_area__key, IF(isIRI(?outcome_area), REPLACE(STR(?outcome_area), "^.*[#/]", ""), STR(?outcome_area))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeTestOutcomes_IsImproved a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeTestOutcome ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTestOutcomes_IsImproved" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isImproved ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeTestOutcome .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:afterTestValue ?after_test_value . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:baselineValue ?baseline_value . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:higherIsBetter ?higher_is_better . }
                BIND((COALESCE((COALESCE(?higher_is_better, false) && COALESCE((COALESCE(?after_test_value, 0) > COALESCE(?baseline_value, 0)), false)), false) || COALESCE((COALESCE((!(COALESCE(?higher_is_better, false))), false) && COALESCE((COALESCE(?after_test_value, 0) < COALESCE(?baseline_value, 0)), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for KnowledgeTraces ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeTraces_Name a sh:NodeShape ;
