# === Rules for RoleAssignmentUpdateTasks ===
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignmentUpdateTasks_Name a sh:NodeShape ;
    sh:targetClass pko-extension:RoleAssignmentUpdateTask ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignmentUpdateTasks_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:RoleAssignmentUpdateTask .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:role ?role . OPTIONAL { ?role erb:key ?role__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:triggerEvent ?trigger_event . OPTIONAL { ?trigger_event erb:key ?trigger_event__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:triggerOccurredAt ?trigger_occurred_at . OPTIONAL { ?trigger_occurred_at erb:key ?trigger_occurred_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?role__key, IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role))), ""), " ", COALESCE(COALESCE(?trigger_event__key, IF(isIRI(?trigger_event), REPLACE(STR(?trigger_event), "^.*[#/]", ""), STR(?trigger_event))), ""), " @ ", COALESCE(REPLACE(COALESCE(?trigger_occurred_at__key, IF(isIRI(?trigger_occurred_at), REPLACE(STR(?trigger_occurred_at), "^.*[#/]", ""), STR(?trigger_occurred_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .
