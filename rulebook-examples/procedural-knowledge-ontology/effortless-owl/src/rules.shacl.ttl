            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:decisionLatencyDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . }
    OPTIONAL { $this effortless-ntwf:isDecided ?is_decided . }
    OPTIONAL { $this effortless-ntwf:requestedAt ?requested_at . }
                BIND(ROUND(IF(COALESCE(?is_decided, false), ((DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
