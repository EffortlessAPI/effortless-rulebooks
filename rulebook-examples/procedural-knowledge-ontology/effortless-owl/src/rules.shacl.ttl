pko-native-procedural-knowledge-rulebook-shapes:KnowledgeBrokerLinks_PointedHolder a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeBrokerLink ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_PointedHolder" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:pointedHolder ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeBrokerLink .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:pointsToKnowHow ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:KnowHowCarrier . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:holderAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeBrokerLinks_LocatesOtherHolder a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeBrokerLink ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_LocatesOtherHolder" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:locatesOtherHolder ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeBrokerLink .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:broker ?broker . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:pointedHolder ?pointed_holder . OPTIONAL { ?pointed_holder erb:key ?pointed_holder__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:pointsToKnowHow ?points_to_know_how . OPTIONAL { ?points_to_know_how erb:key ?points_to_know_how__key . } }
                BIND((COALESCE((COALESCE(?points_to_know_how__key, COALESCE(IF(isIRI(?points_to_know_how), REPLACE(STR(?points_to_know_how), "^.*[#/]", ""), STR(?points_to_know_how)), "")) != ""), false) && COALESCE((COALESCE(?pointed_holder__key, COALESCE(IF(isIRI(?pointed_holder), REPLACE(STR(?pointed_holder), "^.*[#/]", ""), STR(?pointed_holder)), "")) != ""), false) && COALESCE(COALESCE((?pointed_holder != ?broker), !((!BOUND(?pointed_holder) || STR(?pointed_holder) = "") && (!BOUND(?broker) || STR(?broker) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeBrokerLinks_TranslationBetweenVocabularies a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeBrokerLink ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_TranslationBetweenVocabularies" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:translationBetweenVocabularies ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeBrokerLink .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holderVocabulary ?holder_vocabulary . OPTIONAL { ?holder_vocabulary erb:key ?holder_vocabulary__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holderWording ?holder_wording . OPTIONAL { ?holder_wording erb:key ?holder_wording__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:seekerVocabulary ?seeker_vocabulary . OPTIONAL { ?seeker_vocabulary erb:key ?seeker_vocabulary__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:seekerWording ?seeker_wording . OPTIONAL { ?seeker_wording erb:key ?seeker_wording__key . } }
                BIND(IF(COALESCE((COALESCE((COALESCE(?seeker_vocabulary__key, COALESCE(IF(isIRI(?seeker_vocabulary), REPLACE(STR(?seeker_vocabulary), "^.*[#/]", ""), STR(?seeker_vocabulary)), "")) != ""), false) && COALESCE((COALESCE(?holder_vocabulary__key, COALESCE(IF(isIRI(?holder_vocabulary), REPLACE(STR(?holder_vocabulary), "^.*[#/]", ""), STR(?holder_vocabulary)), "")) != ""), false) && COALESCE(COALESCE((?seeker_vocabulary != ?holder_vocabulary), !((!BOUND(?seeker_vocabulary) || STR(?seeker_vocabulary) = "") && (!BOUND(?holder_vocabulary) || STR(?holder_vocabulary) = ""))), false)), false), CONCAT(COALESCE(COALESCE(?seeker_wording__key, IF(isIRI(?seeker_wording), REPLACE(STR(?seeker_wording), "^.*[#/]", ""), STR(?seeker_wording))), ""), " (", COALESCE(COALESCE(?seeker_vocabulary__key, IF(isIRI(?seeker_vocabulary), REPLACE(STR(?seeker_vocabulary), "^.*[#/]", ""), STR(?seeker_vocabulary))), ""), ") = ", COALESCE(COALESCE(?holder_wording__key, IF(isIRI(?holder_wording), REPLACE(STR(?holder_wording), "^.*[#/]", ""), STR(?holder_wording))), ""), " (", COALESCE(COALESCE(?holder_vocabulary__key, IF(isIRI(?holder_vocabulary), REPLACE(STR(?holder_vocabulary), "^.*[#/]", ""), STR(?holder_vocabulary))), ""), ")"), "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for KnowledgeCaptureInitiatives ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeCaptureInitiatives_Name a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeCaptureInitiative ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeCaptureInitiatives_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeCaptureInitiative .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeMethod ?knowledge_method . OPTIONAL { ?knowledge_method erb:key ?knowledge_method__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourcingFunction ?sourcing_function . OPTIONAL { ?sourcing_function erb:key ?sourcing_function__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?sourcing_function__key, IF(isIRI(?sourcing_function), REPLACE(STR(?sourcing_function), "^.*[#/]", ""), STR(?sourcing_function))), ""), " by ", COALESCE(COALESCE(?knowledge_method__key, IF(isIRI(?knowledge_method), REPLACE(STR(?knowledge_method), "^.*[#/]", ""), STR(?knowledge_method))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for KnowledgeConsumerSystems ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeConsumerSystems_Name a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeConsumerSystem ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeConsumerSystem .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeConsumerSystems_ModelSyncCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeConsumerSystem ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_ModelSyncCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:modelSyncCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeConsumerSystem .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:KnowledgeConsumerSystem .
                    ?child a pko-extension:ConsumerSystemSync .
                    ?child pko-native-procedural-knowledge-rulebook:consumerSystem $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeConsumerSystems_IntegrationCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeConsumerSystem ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
