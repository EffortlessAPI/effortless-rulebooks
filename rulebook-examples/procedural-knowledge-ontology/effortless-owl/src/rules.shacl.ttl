            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isAdoptedButDeprecated ?_result .
            }
            WHERE {
    $this a pko-extension:ExternalStandardTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deprecatedBySource ?deprecated_by_source . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rehomedAsTerm ?rehomed_as_term . OPTIONAL { ?rehomed_as_term erb:key ?rehomed_as_term__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usingMappingCount ?using_mapping_count . }
                BIND((COALESCE(?deprecated_by_source, false) && COALESCE((COALESCE((COALESCE(?using_mapping_count, 0) > 0), false) || COALESCE((COALESCE(?rehomed_as_term__key, COALESCE(IF(isIRI(?rehomed_as_term), REPLACE(STR(?rehomed_as_term), "^.*[#/]", ""), STR(?rehomed_as_term)), "")) != ""), false)), false)) AS ?_result)
            }
        """ ;
    ] .
