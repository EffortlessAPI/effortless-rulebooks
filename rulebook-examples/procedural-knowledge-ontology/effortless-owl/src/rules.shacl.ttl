    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((!(COALESCE(?execution_has_cleared_legal_review, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_RenderedBodyLength" ;
        sh:prefixes effortless-ntwf: ;
