    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:declaredScale ?declared_scale . OPTIONAL { ?declared_scale effortless-ntwf:__key ?declared_scale__key . } }
    OPTIONAL { $this effortless-ntwf:prevMinor ?prev_minor . }
                BIND(ROUND(IF(COALESCE((COALESCE(?declared_scale__key, COALESCE(IF(isIRI(?declared_scale), REPLACE(STR(?declared_scale), "^.*[#/]", ""), STR(?declared_scale)), "")) = "Major"), false), 0, IF(COALESCE((COALESCE(?declared_scale__key, COALESCE(IF(isIRI(?declared_scale), REPLACE(STR(?declared_scale), "^.*[#/]", ""), STR(?declared_scale)), "")) = "Minor"), false), (?prev_minor + 1), ?prev_minor))) AS ?_result)
            }
