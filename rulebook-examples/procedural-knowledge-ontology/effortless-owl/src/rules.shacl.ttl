# === Rules for StewardshipAssignments ===
pko-native-procedural-knowledge-rulebook-shapes:StewardshipAssignments_Name a sh:NodeShape ;
    sh:targetClass pko-extension:StewardshipAssignment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:StewardshipAssignment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version erb:key ?procedure_version__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stewardRole ?steward_role . OPTIONAL { ?steward_role erb:key ?steward_role__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " / steward=", COALESCE(COALESCE(?steward_role__key, IF(isIRI(?steward_role), REPLACE(STR(?steward_role), "^.*[#/]", ""), STR(?steward_role))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StewardshipAssignments_CountOfReviewEvents a sh:NodeShape ;
    sh:targetClass pko-extension:StewardshipAssignment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_CountOfReviewEvents" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:countOfReviewEvents ?_result .
            }
            WHERE {
    $this a pko-extension:StewardshipAssignment .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:StewardshipAssignment .
                    ?child a pko:ReviewEvent .
                    ?child pko-native-procedural-knowledge-rulebook:procedureVersion ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:procedureVersion ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StewardshipAssignments_HasEverBeenReviewed a sh:NodeShape ;
    sh:targetClass pko-extension:StewardshipAssignment ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_HasEverBeenReviewed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasEverBeenReviewed ?_result .
            }
            WHERE {
    $this a pko-extension:StewardshipAssignment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:countOfReviewEvents ?count_of_review_events . }
                BIND((COALESCE(?count_of_review_events, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StewardshipAssignments_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-extension:StewardshipAssignment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_AsOfInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-extension:StewardshipAssignment .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StewardshipAssignments_IsCurrentAssignment a sh:NodeShape ;
    sh:targetClass pko-extension:StewardshipAssignment ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_IsCurrentAssignment" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isCurrentAssignment ?_result .
            }
            WHERE {
    $this a pko-extension:StewardshipAssignment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validFrom ?valid_from . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validTo ?valid_to . OPTIONAL { ?valid_to erb:key ?valid_to__key . } }
                BIND((COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for SubstrateRunScores ===
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_Name a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:SubstrateRunScore .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:run ?run . OPTIONAL { ?run erb:key ?run__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:substrate ?substrate . OPTIONAL { ?substrate erb:key ?substrate__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?run__key, IF(isIRI(?run), REPLACE(STR(?run), "^.*[#/]", ""), STR(?run))), ""), " / ", COALESCE(COALESCE(?substrate__key, IF(isIRI(?substrate), REPLACE(STR(?substrate), "^.*[#/]", ""), STR(?substrate))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_CellsFailed a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_CellsFailed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:cellsFailed ?_result .
            }
            WHERE {
    $this a pko-extension:SubstrateRunScore .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsPassed ?cells_passed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsTested ?cells_tested . }
                BIND((?cells_tested - ?cells_passed) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_Score a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_Score" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:score ?_result .
            }
            WHERE {
    $this a pko-extension:SubstrateRunScore .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsPassed ?cells_passed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cellsTested ?cells_tested . }
                BIND(IF(COALESCE((COALESCE(?cells_tested, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?cells_passed) / ?cells_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SubstrateRunScores_CalculatedScore a sh:NodeShape ;
    sh:targetClass pko-extension:SubstrateRunScore ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
