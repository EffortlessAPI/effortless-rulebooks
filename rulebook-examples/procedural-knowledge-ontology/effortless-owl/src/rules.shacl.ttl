            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:blockingSatisfactionStepKey ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requirementIsBlocking ?requirement_is_blocking . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?requirement_is_blocking, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_NegativeOutcomeRequirementKey a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_NegativeOutcomeRequirementKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:negativeOutcomeRequirementKey ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requirement ?requirement . }
                BIND(IF(COALESCE((!(COALESCE(?is_fully_satisfied, false))), false), ?requirement, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_EvaluatorAgentKind a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_EvaluatorAgentKind" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:evaluatorAgentKind ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluatedByAgent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
