# === Rules for ActivityRelations ===
pko-native-procedural-knowledge-rulebook-shapes:ActivityRelations_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ActivityRelation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ActivityRelations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ActivityRelation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fromStep ?from_step . OPTIONAL { ?from_step erb:key ?from_step__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:relationType ?relation_type . OPTIONAL { ?relation_type erb:key ?relation_type__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toStep ?to_step . OPTIONAL { ?to_step erb:key ?to_step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_step__key, IF(isIRI(?from_step), REPLACE(STR(?from_step), "^.*[#/]", ""), STR(?from_step))), ""), " ", COALESCE(COALESCE(?relation_type__key, IF(isIRI(?relation_type), REPLACE(STR(?relation_type), "^.*[#/]", ""), STR(?relation_type))), ""), " ", COALESCE(COALESCE(?to_step__key, IF(isIRI(?to_step), REPLACE(STR(?to_step), "^.*[#/]", ""), STR(?to_step))), "")) AS ?_result)
            }
        """ ;
    ] .
