pko-native-procedural-knowledge-rulebook-shapes:StepRequirements_SatisfactionCountForBinding a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepRequirements ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_SatisfactionCountForBinding" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:satisfactionCountForBinding ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepRequirements .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:StepRequirements .
                    ?child a pko:RequirementSatisfaction .
                    ?child pko-native-procedural-knowledge-rulebook:bindingKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:stepRequirementId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepRequirements_BindingWasEverExercised a sh:NodeShape ;
