            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:loadBearingUnapprovedCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                    ?child a pko-extension:KnowledgeFragment .
                    ?child pko-native-procedural-knowledge-rulebook:unapprovedLoadBearingVersionKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
