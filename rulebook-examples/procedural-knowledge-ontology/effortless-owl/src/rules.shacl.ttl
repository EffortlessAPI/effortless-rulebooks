            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:separationOfDutiesHeld ?separation_of_duties_held . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:separationWasTestable ?separation_was_testable . }
                BIND((COALESCE(?separation_of_duties_held, false) && COALESCE((!(COALESCE(?separation_was_testable, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_SeparationAssuranceNote a sh:NodeShape ;
