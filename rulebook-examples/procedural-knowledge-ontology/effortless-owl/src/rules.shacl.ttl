# === Filtered closure edges for vw_step_transitions_closure_where_avoids_human_approval_gate ===
effortless-ntwf:leadsWithoutHumanGateEdgeShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Steps ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_leadsWithoutHumanGate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:leadsWithoutHumanGate ?_to .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    ?_edge a effortless-ntwf:StepTransitions ; effortless-ntwf:fromStep $this ; effortless-ntwf:toStep ?_to ; effortless-ntwf:avoidsHumanApprovalGate true .
            }
        """ ;
    ] .

