pko-native-procedural-knowledge-rulebook-shapes:ModelChangeRequests_AssessedInconsistentCount a sh:NodeShape ;
    sh:targetClass pko-extension:ModelChangeRequest ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_AssessedInconsistentCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:assessedInconsistentCount ?_result .
            }
            WHERE {
    $this a pko-extension:ModelChangeRequest .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ModelChangeRequest .
                    ?child a pko-extension:ChangeImpactFinding .
                    ?child pko-native-procedural-knowledge-rulebook:modelChangeRequest $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:findingKind ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:findingStage ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "InconsistentInstance"))
                    FILTER((COALESCE(?c4__key, STR(?c4)) = "Assessment"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
