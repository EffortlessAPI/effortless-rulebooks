            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:predatesVersionChange ?_result .
            }
            WHERE {
    $this a pko-extension:ConsumerSystemSync .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:canonicalVersion ?canonical_version . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:canonicalVersionModifiedAt ?canonical_version_modified_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:loadedVersion ?loaded_version . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:syncedAt ?synced_at . }
                BIND((COALESCE(COALESCE((?loaded_version = ?canonical_version), ((!BOUND(?loaded_version) || STR(?loaded_version) = "") && (!BOUND(?canonical_version) || STR(?canonical_version) = ""))), false) && COALESCE(COALESCE((?synced_at < ?canonical_version_modified_at), false), false)) AS ?_result)
            }
        """ ;
    ] .
