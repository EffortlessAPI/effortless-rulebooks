pko-native-procedural-knowledge-rulebook-shapes:RoleSchemaViews_GrantKey a sh:NodeShape ;
    sh:targetClass pko-extension:RoleSchemaView ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_GrantKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:grantKey ?_result .
            }
            WHERE {
    $this a pko-extension:RoleSchemaView .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:principal ?principal . OPTIONAL { ?principal erb:key ?principal__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetTable ?target_table . OPTIONAL { ?target_table erb:key ?target_table__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), ""), "|", COALESCE(COALESCE(?target_table__key, IF(isIRI(?target_table), REPLACE(STR(?target_table), "^.*[#/]", ""), STR(?target_table))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleSchemaViews_ColumnCount a sh:NodeShape ;
    sh:targetClass pko-extension:RoleSchemaView ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_ColumnCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:columnCount ?_result .
            }
            WHERE {
    $this a pko-extension:RoleSchemaView .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:RoleSchemaView .
                    ?child a pko-extension:FieldGrant .
                    ?child pko-native-procedural-knowledge-rulebook:principal ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:principal ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:canRead ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:fieldTable ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetTable ?p4 . OPTIONAL { ?p4 erb:key ?p4__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER(COALESCE(?c4__key, STR(?c4)) = COALESCE(?p4__key, STR(?p4)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleSchemaViews_TableFieldCount a sh:NodeShape ;
    sh:targetClass pko-extension:RoleSchemaView ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
