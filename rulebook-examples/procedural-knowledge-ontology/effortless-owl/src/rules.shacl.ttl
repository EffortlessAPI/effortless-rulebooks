    $this a pko-extension:FieldGrant .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:principal ?principal . OPTIONAL { ?principal erb:key ?principal__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetField ?target_field . OPTIONAL { ?target_field erb:key ?target_field__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), ""), " -> ", COALESCE(COALESCE(?target_field__key, IF(isIRI(?target_field), REPLACE(STR(?target_field), "^.*[#/]", ""), STR(?target_field))), "")) AS ?_result)
            }
        """ ;
