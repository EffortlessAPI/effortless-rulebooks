        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reachedFromStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(*) AS ?_result) WHERE {
                        ?a effortless-ntwf:leadsTo+ $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_SelfReachCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:selfReachCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(*) AS ?_result) WHERE {
                        $this effortless-ntwf:leadsTo+ $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsOnReworkLoop" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOnReworkLoop ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:selfReachCount ?self_reach_count . }
                BIND((COALESCE(?self_reach_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsBlockingControlOnReworkLoop" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBlockingControlOnReworkLoop ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:blockingRequirementCount ?blocking_requirement_count . }
    OPTIONAL { $this effortless-ntwf:isOnReworkLoop ?is_on_rework_loop . }
                BIND((COALESCE(?is_on_rework_loop, false) && COALESCE((COALESCE(?blocking_requirement_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IncomingTransitionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:incomingTransitionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepTransitions .
                    ?child effortless-ntwf:toStep $this .
