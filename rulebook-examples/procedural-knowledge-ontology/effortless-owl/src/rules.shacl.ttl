    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:probeKind ?probe_kind . OPTIONAL { ?probe_kind erb:key ?probe_kind__key . } }
                BIND(IF(COALESCE((COALESCE(?probe_kind__key, COALESCE(IF(isIRI(?probe_kind), REPLACE(STR(?probe_kind), "^.*[#/]", ""), STR(?probe_kind)), "")) = "ProcedureFallsShort"), false), ?answer, "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for IssueOccurrences ===
pko-native-procedural-knowledge-rulebook-shapes:IssueOccurrences_Name a sh:NodeShape ;
    sh:targetClass pko:IssueOccurrence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:IssueOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:error ?error . OPTIONAL { ?error erb:key ?error__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:occurredAt ?occurred_at . OPTIONAL { ?occurred_at erb:key ?occurred_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?error__key, IF(isIRI(?error), REPLACE(STR(?error), "^.*[#/]", ""), STR(?error))), ""), " @ ", COALESCE(REPLACE(COALESCE(?occurred_at__key, IF(isIRI(?occurred_at), REPLACE(STR(?occurred_at), "^.*[#/]", ""), STR(?occurred_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:IssueOccurrences_IsUnresolved a sh:NodeShape ;
    sh:targetClass pko:IssueOccurrence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_IsUnresolved" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnresolved ?_result .
            }
            WHERE {
    $this a pko:IssueOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status_IssueOccurrences ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Open"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Investigating"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Monitoring"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:IssueOccurrences_StepExecutionWhenUnresolved a sh:NodeShape ;
    sh:targetClass pko:IssueOccurrence ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_StepExecutionWhenUnresolved" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:stepExecutionWhenUnresolved ?_result .
            }
            WHERE {
    $this a pko:IssueOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isUnresolved ?is_unresolved . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_unresolved, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:IssueOccurrences_ExecutedStep a sh:NodeShape ;
    sh:targetClass pko:IssueOccurrence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_ExecutedStep" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:executedStep ?_result .
            }
            WHERE {
    $this a pko:IssueOccurrence .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:StepExecution . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:IssueOccurrences_FailedConditionCountOnRun a sh:NodeShape ;
    sh:targetClass pko:IssueOccurrence ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_FailedConditionCountOnRun" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:failedConditionCountOnRun ?_result .
            }
            WHERE {
    $this a pko:IssueOccurrence .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko:IssueOccurrence .
                    ?child a pko:StepExecution .
                    ?child pko-native-procedural-knowledge-rulebook:stepExecutionId ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:stepExecution ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:failedPreconditionCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:IssueOccurrences_CoincidedWithFailedCondition a sh:NodeShape ;
    sh:targetClass pko:IssueOccurrence ;
    sh:order 6 ;
    sh:rule [
