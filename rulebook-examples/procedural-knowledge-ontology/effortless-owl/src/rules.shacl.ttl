                BIND(COALESCE((?requested_by_agent = ?authority_agent), ((!BOUND(?requested_by_agent) || STR(?requested_by_agent) = "") && (!BOUND(?authority_agent) || STR(?authority_agent) = ""))) AS ?_result)
