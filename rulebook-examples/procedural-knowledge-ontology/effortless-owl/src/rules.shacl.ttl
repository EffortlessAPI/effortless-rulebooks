                BIND((COALESCE((COALESCE(?assumed_current_step__key, COALESCE(IF(isIRI(?assumed_current_step), REPLACE(STR(?assumed_current_step), "^.*[#/]", ""), STR(?assumed_current_step)), "")) != ""), false) && COALESCE((COALESCE(?execution_of_context__key, COALESCE(IF(isIRI(?execution_of_context), REPLACE(STR(?execution_of_context), "^.*[#/]", ""), STR(?execution_of_context)), "")) != ""), false) && COALESCE((COALESCE(?assumed_step_completed_count, 0) = 0), false)) AS ?_result)
