            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:sharingEventCount ?_result .
            }
            WHERE {
    $this a pko-extension:CommunityOfPractice .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:CommunityOfPractice .
                    ?child a pko-extension:KnowledgeTransfer .
                    ?child pko-native-procedural-knowledge-rulebook:communityOfPractice $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
