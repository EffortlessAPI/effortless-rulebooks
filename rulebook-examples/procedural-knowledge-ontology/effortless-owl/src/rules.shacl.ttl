    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignmentUpdateTasks_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignmentUpdateTasks .
    OPTIONAL { $this effortless-ntwf:role ?role . OPTIONAL { ?role effortless-ntwf:__key ?role__key . } }
    OPTIONAL { $this effortless-ntwf:triggerEvent ?trigger_event . OPTIONAL { ?trigger_event effortless-ntwf:__key ?trigger_event__key . } }
    OPTIONAL { $this effortless-ntwf:triggerOccurredAt ?trigger_occurred_at . OPTIONAL { ?trigger_occurred_at effortless-ntwf:__key ?trigger_occurred_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?role__key, IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role))), ""), " ", COALESCE(COALESCE(?trigger_event__key, IF(isIRI(?trigger_event), REPLACE(STR(?trigger_event), "^.*[#/]", ""), STR(?trigger_event))), ""), " @ ", COALESCE(REPLACE(COALESCE(?trigger_occurred_at__key, IF(isIRI(?trigger_occurred_at), REPLACE(STR(?trigger_occurred_at), "^.*[#/]", ""), STR(?trigger_occurred_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] ;
