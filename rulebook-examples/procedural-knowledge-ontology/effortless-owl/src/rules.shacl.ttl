    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:failureCriterionCount ?failure_criterion_count . }
                BIND((COALESCE(?failure_criterion_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Procedures_LensViewCount a sh:NodeShape ;
