                $this effortless-ntwf:isApprovedWithoutSmeSignoff ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:smeApprovalCount ?sme_approval_count . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) && COALESCE((COALESCE(?sme_approval_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
