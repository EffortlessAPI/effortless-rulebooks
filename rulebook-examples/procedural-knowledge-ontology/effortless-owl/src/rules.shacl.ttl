    OPTIONAL { $this effortless-ntwf:refusalRecordedAt ?refusal_recorded_at . OPTIONAL { ?refusal_recorded_at effortless-ntwf:__key ?refusal_recorded_at__key . } }
                BIND((COALESCE(?refusal_recorded_at__key, COALESCE(IF(isIRI(?refusal_recorded_at), REPLACE(STR(?refusal_recorded_at), "^.*[#/]", ""), STR(?refusal_recorded_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RefusalWasEscalated" ;
        sh:prefixes effortless-ntwf: ;
