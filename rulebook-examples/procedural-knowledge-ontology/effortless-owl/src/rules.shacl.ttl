                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:step ?backfk .
                    $this effortless-ntwf:step ?backpv .
                    OPTIONAL { ?child effortless-ntwf:procedureExecution ?c2 . }
                    OPTIONAL { $this effortless-ntwf:procedureExecution ?p2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(REPLACE(STR(?c2), "^.*[#/]", "") = REPLACE(STR(?p2), "^.*[#/]", ""))
                    }
                }
            }
