            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:dependentTraceCount ?_result .
            }
            WHERE {
    $this a pko-extension:CollectedSourceMaterial .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:CollectedSourceMaterial .
                    ?child a pko-native-procedural-knowledge-rulebook:KnowledgeTraces .
                    ?child pko-native-procedural-knowledge-rulebook:sourceMaterial $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CollectedSourceMaterials_IsDependencyInvisibleToChange a sh:NodeShape ;
    sh:targetClass pko-extension:CollectedSourceMaterial ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_IsDependencyInvisibleToChange" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
