    OPTIONAL { $this effortless-ntwf:recordId ?record_id . OPTIONAL { ?record_id effortless-ntwf:__key ?record_id__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?field_disagreement__key, IF(isIRI(?field_disagreement), REPLACE(STR(?field_disagreement), "^.*[#/]", ""), STR(?field_disagreement))), ""), " @ ", COALESCE(COALESCE(?record_id__key, IF(isIRI(?record_id), REPLACE(STR(?record_id), "^.*[#/]", ""), STR(?record_id))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CellDisagreements_Substrate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:substrate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CellDisagreements .
                OPTIONAL { $this effortless-ntwf:fieldDisagreement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:FieldDisagreements ; effortless-ntwf:fieldDisagreementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:substrate ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CellDisagreements_RulebookField" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:rulebookField ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CellDisagreements .
                OPTIONAL { $this effortless-ntwf:fieldDisagreement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:FieldDisagreements ; effortless-ntwf:fieldDisagreementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:rulebookField ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ChangeAuthorityRules ===
effortless-ntwf:ChangeAuthorityRulesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ChangeAuthorityRules ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeAuthorityRules_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeAuthorityRules .
    OPTIONAL { $this effortless-ntwf:changeLayer ?change_layer . OPTIONAL { ?change_layer effortless-ntwf:__key ?change_layer__key . } }
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " ", COALESCE(COALESCE(?change_layer__key, IF(isIRI(?change_layer), REPLACE(STR(?change_layer), "^.*[#/]", ""), STR(?change_layer))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeAuthorityRules_MisroutedRequestCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:misroutedRequestCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeAuthorityRules .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelChangeRequests .
                    ?child effortless-ntwf:ruleKey ?backfk .
                    $this effortless-ntwf:changeAuthorityRuleId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:isMisrouted ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeAuthorityRules_IsRuleBypassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRuleBypassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeAuthorityRules .
    OPTIONAL { $this effortless-ntwf:misroutedRequestCount ?misrouted_request_count . }
                BIND((COALESCE(?misrouted_request_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ChangeImpactFindings ===
effortless-ntwf:ChangeImpactFindingsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ChangeImpactFindings ;
