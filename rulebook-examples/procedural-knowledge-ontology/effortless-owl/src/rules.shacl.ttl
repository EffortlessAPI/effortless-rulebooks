pko-native-procedural-knowledge-rulebook-shapes:GovernedModels_LastStewardActivityAt a sh:NodeShape ;
    sh:targetClass pko-extension:GovernedModel ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_LastStewardActivityAt" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:lastStewardActivityAt ?_result .
            }
            WHERE {
    $this a pko-extension:GovernedModel .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:GovernedModel .
                    ?child a pko-extension:StewardActivity .
                    ?child pko-native-procedural-knowledge-rulebook:activityModel ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:governedModelId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:performedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:GovernedModels_DaysSinceStewardActivity a sh:NodeShape ;
    sh:targetClass pko-extension:GovernedModel ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_DaysSinceStewardActivity" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceStewardActivity ?_result .
            }
            WHERE {
    $this a pko-extension:GovernedModel .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceRegistered ?days_since_registered . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastStewardActivityAt ?last_steward_activity_at . OPTIONAL { ?last_steward_activity_at erb:key ?last_steward_activity_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?last_steward_activity_at__key, COALESCE(IF(isIRI(?last_steward_activity_at), REPLACE(STR(?last_steward_activity_at), "^.*[#/]", ""), STR(?last_steward_activity_at)), "")) = ""), false), ?days_since_registered, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_steward_activity_at) + FLOOR((153 * (MONTH(?last_steward_activity_at) + 12 * FLOOR((14 - MONTH(?last_steward_activity_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_steward_activity_at) + 4800 - FLOOR((14 - MONTH(?last_steward_activity_at)) / 12)) + FLOOR((YEAR(?last_steward_activity_at) + 4800 - FLOOR((14 - MONTH(?last_steward_activity_at)) / 12)) / 4) - FLOOR((YEAR(?last_steward_activity_at) + 4800 - FLOOR((14 - MONTH(?last_steward_activity_at)) / 12)) / 100) + FLOOR((YEAR(?last_steward_activity_at) + 4800 - FLOOR((14 - MONTH(?last_steward_activity_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] .
