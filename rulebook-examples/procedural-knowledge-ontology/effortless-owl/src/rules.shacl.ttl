    ] .
pko-native-procedural-knowledge-rulebook-shapes:VerificationOutcomes_ParentProcedureExecutionOfOutcome a sh:NodeShape ;
    sh:targetClass pko-extension:VerificationOutcome ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_ParentProcedureExecutionOfOutcome" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:parentProcedureExecutionOfOutcome ?_result .
            }
            WHERE {
    $this a pko-extension:VerificationOutcome .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:StepExecution . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:procedureExecution ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for Vocabularies ===
pko-native-procedural-knowledge-rulebook-shapes:Vocabularies_Name a sh:NodeShape ;
    sh:targetClass pko-extension:Vocabulary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:Vocabulary .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Vocabularies_TermCount a sh:NodeShape ;
    sh:targetClass pko-extension:Vocabulary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_TermCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:termCount ?_result .
            }
            WHERE {
    $this a pko-extension:Vocabulary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:Vocabulary .
                    ?child a pko-extension:VocabularyTerm .
                    ?child pko-native-procedural-knowledge-rulebook:vocabulary $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Vocabularies_OrphanTermCount a sh:NodeShape ;
    sh:targetClass pko-extension:Vocabulary ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_OrphanTermCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:orphanTermCount ?_result .
            }
            WHERE {
    $this a pko-extension:Vocabulary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:Vocabulary .
                    ?child a pko-extension:VocabularyTerm .
                    ?child pko-native-procedural-knowledge-rulebook:orphanTermVocabularyKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:vocabularyId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Vocabularies_HasOrphanTerms a sh:NodeShape ;
    sh:targetClass pko-extension:Vocabulary ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_HasOrphanTerms" ;
