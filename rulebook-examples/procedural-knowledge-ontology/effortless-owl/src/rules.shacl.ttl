pko-native-procedural-knowledge-rulebook-shapes:Organizations_TreatsKnowledgeWorkAsUnvalued a sh:NodeShape ;
    sh:targetClass pko-industry:Department ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_TreatsKnowledgeWorkAsUnvalued" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:treatsKnowledgeWorkAsUnvalued ?_result .
            }
            WHERE {
    $this a pko-industry:Department .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:documentationEntryCount ?documentation_entry_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:transferGivenCount ?transfer_given_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:unallocatedDocumentationCount ?unallocated_documentation_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:unallocatedTransferCount ?unallocated_transfer_count . }
                BIND((COALESCE((COALESCE((?documentation_entry_count + ?transfer_given_count), 0) > 0), false) && COALESCE(COALESCE(((2 * (?unallocated_documentation_count + ?unallocated_transfer_count)) > (?documentation_entry_count + ?transfer_given_count)), false), false)) AS ?_result)
            }
        """ ;
    ] .
