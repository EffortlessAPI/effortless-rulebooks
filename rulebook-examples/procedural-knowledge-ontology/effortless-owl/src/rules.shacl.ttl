    $this a pko-native-procedural-knowledge-rulebook:OntologyProfiles .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:adoptedAt ?adopted_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:adoptionStage ?adoption_stage . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:prerequisiteAdoptedAt ?prerequisite_adopted_at . OPTIONAL { ?prerequisite_adopted_at erb:key ?prerequisite_adopted_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:prerequisiteProfile ?prerequisite_profile . OPTIONAL { ?prerequisite_profile erb:key ?prerequisite_profile__key . } }
                BIND((COALESCE((COALESCE(?adoption_stage, 0) > 1), false) && COALESCE((COALESCE((COALESCE(?prerequisite_profile__key, COALESCE(IF(isIRI(?prerequisite_profile), REPLACE(STR(?prerequisite_profile), "^.*[#/]", ""), STR(?prerequisite_profile)), "")) = ""), false) || COALESCE((COALESCE(?prerequisite_adopted_at__key, COALESCE(IF(isIRI(?prerequisite_adopted_at), REPLACE(STR(?prerequisite_adopted_at), "^.*[#/]", ""), STR(?prerequisite_adopted_at)), "")) = ""), false) || COALESCE(COALESCE((?prerequisite_adopted_at > ?adopted_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OntologyProfiles_NamespaceIsHttp a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:OntologyProfiles ;
    sh:order 1 ;
