            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:QualityAssessment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:qualityCriterion ?quality_criterion . OPTIONAL { ?quality_criterion erb:key ?quality_criterion__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rulebookRelease ?rulebook_release . OPTIONAL { ?rulebook_release erb:key ?rulebook_release__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?rulebook_release__key, IF(isIRI(?rulebook_release), REPLACE(STR(?rulebook_release), "^.*[#/]", ""), STR(?rulebook_release))), ""), " / ", COALESCE(COALESCE(?quality_criterion__key, IF(isIRI(?quality_criterion), REPLACE(STR(?quality_criterion), "^.*[#/]", ""), STR(?quality_criterion))), "")) AS ?_result)
            }
        """ ;
    ] .

