pko-native-procedural-knowledge-rulebook-shapes:RoleAssignmentUpdateTasks_ChangedRoleInsteadOfAssignment a sh:NodeShape ;
    sh:targetClass pko-extension:RoleAssignmentUpdateTask ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignmentUpdateTasks_ChangedRoleInsteadOfAssignment" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:changedRoleInsteadOfAssignment ?_result .
            }
            WHERE {
    $this a pko-extension:RoleAssignmentUpdateTask .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:endingRole ?ending_role . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:replacementAssignment ?replacement_assignment . OPTIONAL { ?replacement_assignment erb:key ?replacement_assignment__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:replacementRole ?replacement_role . }
                BIND((COALESCE((COALESCE(?replacement_assignment__key, COALESCE(IF(isIRI(?replacement_assignment), REPLACE(STR(?replacement_assignment), "^.*[#/]", ""), STR(?replacement_assignment)), "")) != ""), false) && COALESCE(COALESCE((?replacement_role != ?ending_role), !((!BOUND(?replacement_role) || STR(?replacement_role) = "") && (!BOUND(?ending_role) || STR(?ending_role) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .
