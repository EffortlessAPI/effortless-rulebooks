    OPTIONAL { $this effortless-ntwf:mentionedInOwnAccount ?mentioned_in_own_account . }
                BIND((COALESCE((COALESCE(?elicitation_session__key, COALESCE(IF(isIRI(?elicitation_session), REPLACE(STR(?elicitation_session), "^.*[#/]", ""), STR(?elicitation_session)), "")) != ""), false) && COALESCE((!(COALESCE(?mentioned_in_own_account, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ObservedActions_IsMissedStepLeftUncaptured" ;
