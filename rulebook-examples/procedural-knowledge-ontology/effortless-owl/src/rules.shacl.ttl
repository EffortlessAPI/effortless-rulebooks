    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IncidentSessionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:incidentSessionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ElicitationSessions .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:elicitationMode ?c2 . }
                    FILTER((STR(?c2) = "Incident"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ReconciledDivergenceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reconciledDivergenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:WorkflowViewDivergences .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:isReconciled ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ComplementaryMethodCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:complementaryMethodCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:incidentSessionCount ?incident_session_count . }
    OPTIONAL { $this effortless-ntwf:interviewSessionCount ?interview_session_count . }
    OPTIONAL { $this effortless-ntwf:observationSessionCount ?observation_session_count . }
    OPTIONAL { $this effortless-ntwf:protocolSessionCount ?protocol_session_count . }
    OPTIONAL { $this effortless-ntwf:workshopSessionCount ?workshop_session_count . }
                BIND(ROUND(((((IF(COALESCE((COALESCE(?interview_session_count, 0) > 0), false), 1, 0) + IF(COALESCE((COALESCE(?observation_session_count, 0) > 0), false), 1, 0)) + IF(COALESCE((COALESCE(?workshop_session_count, 0) > 0), false), 1, 0)) + IF(COALESCE((COALESCE(?protocol_session_count, 0) > 0), false), 1, 0)) + IF(COALESCE((COALESCE(?incident_session_count, 0) > 0), false), 1, 0))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ReliesOnSingleMethod" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reliesOnSingleMethod ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:complementaryMethodCount ?complementary_method_count . }
                BIND((COALESCE(?complementary_method_count, 0) = 1) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_MissesARequiredElicitationMode" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:missesARequiredElicitationMode ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:complementaryMethodCount ?complementary_method_count . }
    OPTIONAL { $this effortless-ntwf:interviewSessionCount ?interview_session_count . }
    OPTIONAL { $this effortless-ntwf:observationSessionCount ?observation_session_count . }
    OPTIONAL { $this effortless-ntwf:reconciledDivergenceCount ?reconciled_divergence_count . }
    OPTIONAL { $this effortless-ntwf:workshopSessionCount ?workshop_session_count . }
                BIND((COALESCE((COALESCE(?complementary_method_count, 0) > 0), false) && COALESCE((COALESCE((COALESCE(?workshop_session_count, 0) = 0), false) || COALESCE((COALESCE(?interview_session_count, 0) = 0), false) || COALESCE((COALESCE(?observation_session_count, 0) = 0), false) || COALESCE((COALESCE(?reconciled_divergence_count, 0) = 0), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CriticalIncidentCount" ;
        sh:prefixes effortless-ntwf: ;
