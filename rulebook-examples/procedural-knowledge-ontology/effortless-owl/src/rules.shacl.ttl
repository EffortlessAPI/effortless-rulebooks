pko-native-procedural-knowledge-rulebook-shapes:Agents_RequiredMentoringHoursPerWeek a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_RequiredMentoringHoursPerWeek" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:requiredMentoringHoursPerWeek ?_result .
            }
            WHERE {
    $this a prov:Agent .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a prov:Agent .
                    ?child a pko-extension:Mentorship .
                    ?child pko-native-procedural-knowledge-rulebook:mentorAgent $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isActive ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:expectedWeeklyHours ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(BOUND(?c2) && ?c2 = true)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
