            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:labelKind ?label_kind . OPTIONAL { ?label_kind erb:key ?label_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wording ?wording . }
                BIND(IF(COALESCE((COALESCE(?label_kind__key, COALESCE(IF(isIRI(?label_kind), REPLACE(STR(?label_kind), "^.*[#/]", ""), STR(?label_kind)), "")) = "pref"), false), ?wording, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TermLabelVariants_SamePrefWordingCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:TermLabelVariants ;
