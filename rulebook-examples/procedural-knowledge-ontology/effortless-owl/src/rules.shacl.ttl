    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isHumanApprovalGate ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsVerified" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isVerified ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:verificationResult ?verification_result . OPTIONAL { ?verification_result effortless-ntwf:__key ?verification_result__key . } }
                BIND((COALESCE((COALESCE(?verification_result__key, COALESCE(IF(isIRI(?verification_result), REPLACE(STR(?verification_result), "^.*[#/]", ""), STR(?verification_result)), "")) != ""), false) && COALESCE((COALESCE(?verification_result__key, COALESCE(IF(isIRI(?verification_result), REPLACE(STR(?verification_result), "^.*[#/]", ""), STR(?verification_result)), "")) != "PENDING"), false) && COALESCE((COALESCE(?verification_result__key, COALESCE(IF(isIRI(?verification_result), REPLACE(STR(?verification_result), "^.*[#/]", ""), STR(?verification_result)), "")) != "FAIL"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_UnconfirmedNonHumanDecisionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unconfirmedNonHumanDecisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:stepExecutionWhenUnconfirmed ?backfk .
                    $this effortless-ntwf:stepExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_RequiresHumanConfirmation" ;
