    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationSampleSize ?evaluation_sample_size . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:minimumSampleForAssurance ?minimum_sample_for_assurance . }
                BIND((COALESCE(?evaluation_sample_size, 0) >= COALESCE(?minimum_sample_for_assurance, 0)) AS ?_result)
            }
        """ ;
    ] .
