        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isAiOutcomeUnmeasured ?_result .
            }
            WHERE {
    $this a pko-extension:AiAdoptionInitiative .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceOutcomeMeasured ?days_since_outcome_measured . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastOutcomeMeasuredAt ?last_outcome_measured_at . OPTIONAL { ?last_outcome_measured_at erb:key ?last_outcome_measured_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status_AiAdoptionInitiatives ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Pilot"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "InProduction"), false)), false) && COALESCE((COALESCE((COALESCE(?last_outcome_measured_at__key, COALESCE(IF(isIRI(?last_outcome_measured_at), REPLACE(STR(?last_outcome_measured_at), "^.*[#/]", ""), STR(?last_outcome_measured_at)), "")) = ""), false) || COALESCE((COALESCE(?days_since_outcome_measured, 0) > 30), false)), false)) AS ?_result)
            }
        """ ;
    ] .
