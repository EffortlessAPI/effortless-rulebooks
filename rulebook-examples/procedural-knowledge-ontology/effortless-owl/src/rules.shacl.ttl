    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelKind ?model_kind . OPTIONAL { ?model_kind erb:key ?model_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedure ?procedure . OPTIONAL { ?procedure erb:key ?procedure__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureHasNoExplicitSteps ?procedure_has_no_explicit_steps . }
                BIND((COALESCE((COALESCE(?model_kind__key, COALESCE(IF(isIRI(?model_kind), REPLACE(STR(?model_kind), "^.*[#/]", ""), STR(?model_kind)), "")) = "ProcedureFamily"), false) && COALESCE((COALESCE(?procedure__key, COALESCE(IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure)), "")) != ""), false) && COALESCE(?procedure_has_no_explicit_steps, false)) AS ?_result)
            }
        """ ;
    ] .
