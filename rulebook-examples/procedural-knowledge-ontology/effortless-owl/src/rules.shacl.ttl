            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:executorIsDesignatedAgent ?_result .
            }
            WHERE {
    $this a pko:StepExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:executedByAgent ?executed_by_agent . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:roleCurrentAgent ?role_current_agent . }
                BIND(COALESCE((?executed_by_agent = ?role_current_agent), ((!BOUND(?executed_by_agent) || STR(?executed_by_agent) = "") && (!BOUND(?role_current_agent) || STR(?role_current_agent) = ""))) AS ?_result)
            }
        """ ;
    ] .
