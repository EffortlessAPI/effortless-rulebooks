    OPTIONAL { $this effortless-ntwf:isCurrent ?is_current . }
    OPTIONAL { $this effortless-ntwf:outcomeMeasurementCount ?outcome_measurement_count . }
                BIND((COALESCE(?is_current, false) && COALESCE((COALESCE(?execution_count, 0) > 0), false) && COALESCE((COALESCE(?outcome_measurement_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_AiContributionCount" ;
