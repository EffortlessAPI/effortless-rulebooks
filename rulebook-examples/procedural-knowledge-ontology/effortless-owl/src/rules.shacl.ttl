    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SeparationWasTestable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:separationWasTestable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:approvalStepCount ?approval_step_count . }
    OPTIONAL { $this effortless-ntwf:preparationStepCount ?preparation_step_count . }
                BIND((COALESCE((COALESCE(?preparation_step_count, 0) > 0), false) && COALESCE((COALESCE(?approval_step_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SeparationHeldUnderTest" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:separationHeldUnderTest ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:separationOfDutiesHeld ?separation_of_duties_held . }
    OPTIONAL { $this effortless-ntwf:separationWasTestable ?separation_was_testable . }
                BIND((COALESCE(?separation_was_testable, false) && COALESCE(?separation_of_duties_held, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SeparationIsVacuouslyGreen" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:separationIsVacuouslyGreen ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:separationOfDutiesHeld ?separation_of_duties_held . }
    OPTIONAL { $this effortless-ntwf:separationWasTestable ?separation_was_testable . }
                BIND((COALESCE(?separation_of_duties_held, false) && COALESCE((!(COALESCE(?separation_was_testable, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SeparationAssuranceNote" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:separationAssuranceNote ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:separationIsVacuouslyGreen ?separation_is_vacuously_green . }
    OPTIONAL { $this effortless-ntwf:separationViolationCount ?separation_violation_count . }
                BIND(IF(COALESCE((COALESCE(?separation_violation_count, 0) > 0), false), "Violated: same agent prepared and approved.", IF(COALESCE(?separation_is_vacuously_green, false), "Not tested: this run had no preparation/approval pair.", "Held under test.")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_UngovernedDivergenceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ungovernedDivergenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:ungovernedDivergenceExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_DivergenceWasFullyGoverned" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:divergenceWasFullyGoverned ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:divergedFromSpecification ?diverged_from_specification . }
    OPTIONAL { $this effortless-ntwf:ungovernedDivergenceCount ?ungoverned_divergence_count . }
                BIND((COALESCE(?diverged_from_specification, false) && COALESCE((COALESCE(?ungoverned_divergence_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ComputedlyWitnessedControlCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:computedlyWitnessedControlCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:computedWitnessExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_EvaluatedControlCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:evaluatedControlCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:assertedOnlyControlCount ?asserted_only_control_count . }
    OPTIONAL { $this effortless-ntwf:computedlyWitnessedControlCount ?computedly_witnessed_control_count . }
                BIND((?computedly_witnessed_control_count + ?asserted_only_control_count) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ComputedAssuranceRatio" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:computedAssuranceRatio ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:computedlyWitnessedControlCount ?computedly_witnessed_control_count . }
    OPTIONAL { $this effortless-ntwf:evaluatedControlCount ?evaluated_control_count . }
                BIND(IF(COALESCE((COALESCE(?evaluated_control_count, 0) = 0), false), 0, (?computedly_witnessed_control_count / ?evaluated_control_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_InterestedPartyAssertionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:interestedPartyAssertionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:interestedAssertionExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AssuranceGrade" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assuranceGrade ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:computedAssuranceRatio ?computed_assurance_ratio . }
    OPTIONAL { $this effortless-ntwf:evaluatedControlCount ?evaluated_control_count . }
    OPTIONAL { $this effortless-ntwf:interestedPartyAssertionCount ?interested_party_assertion_count . }
                BIND(IF(COALESCE((COALESCE(?evaluated_control_count, 0) = 0), false), "None: no blocking control was evaluated.", IF(COALESCE((COALESCE(?interested_party_assertion_count, 0) > 0), false), "Weak: at least one control rests on an interested-party assertion.", IF(COALESCE((COALESCE(?computed_assurance_ratio, 0) < 0.5), false), "Thin: most controls rest on human assertion.", IF(COALESCE((COALESCE(?computed_assurance_ratio, 0) < 1), false), "Mixed: computed and asserted controls.", "Computed: every evaluated control has a witness.")))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AttestationWouldBeWeaklyBased" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:attestationWouldBeWeaklyBased ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:computedAssuranceRatio ?computed_assurance_ratio . }
    OPTIONAL { $this effortless-ntwf:interestedPartyAssertionCount ?interested_party_assertion_count . }
    OPTIONAL { $this effortless-ntwf:isAttestationReady ?is_attestation_ready . }
                BIND((COALESCE(?is_attestation_ready, false) && COALESCE((COALESCE((COALESCE(?interested_party_assertion_count, 0) > 0), false) || COALESCE((COALESCE(?computed_assurance_ratio, 0) < 0.5), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_IndependentHumanObservationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:independentHumanObservationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:VerificationOutcomes .
                    ?child effortless-ntwf:independentObservationExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_HasAnyIndependentObservation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasAnyIndependentObservation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:independentHumanObservationCount ?independent_human_observation_count . }
                BIND((COALESCE(?independent_human_observation_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SelfAttestedApprovalCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:selfAttestedApprovalCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:selfAttestedApprovalExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AssuranceChainIsCircular" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assuranceChainIsCircular ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:hasAnyIndependentObservation ?has_any_independent_observation . }
    OPTIONAL { $this effortless-ntwf:selfAttestedApprovalCount ?self_attested_approval_count . }
                BIND((COALESCE((COALESCE(?self_attested_approval_count, 0) > 0), false) && COALESCE((!(COALESCE(?has_any_independent_observation, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_LatestAttestationInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestAttestationInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:Attestations .
                    ?child effortless-ntwf:procedureExecution $this .
                    OPTIONAL { ?child effortless-ntwf:signedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_HasBeenAttested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasBeenAttested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:attestationCount ?attestation_count . }
                BIND((COALESCE(?attestation_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AttestationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:attestationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Attestations .
                    ?child effortless-ntwf:procedureExecution $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_PostAttestationScoreCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:postAttestationScoreCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:postAttestationScoreExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_BasisChangedAfterSignature" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:basisChangedAfterSignature ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:hasBeenAttested ?has_been_attested . }
    OPTIONAL { $this effortless-ntwf:postAttestationScoreCount ?post_attestation_score_count . }
                BIND((COALESCE(?has_been_attested, false) && COALESCE((COALESCE(?post_attestation_score_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_RequiresReAttestation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requiresReAttestation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:basisChangedAfterSignature ?basis_changed_after_signature . }
    OPTIONAL { $this effortless-ntwf:isAttestationReady ?is_attestation_ready . }
                BIND((COALESCE(?basis_changed_after_signature, false) && COALESCE((!(COALESCE(?is_attestation_ready, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_IntendedRecipientCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intendedRecipientCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SendIntents .
                    ?child effortless-ntwf:intentExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ReachedRecipientCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reachedRecipientCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SendIntents .
                    ?child effortless-ntwf:deliveredIntentExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SilentlyDroppedCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:silentlyDroppedCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SendIntents .
                    ?child effortless-ntwf:droppedIntentExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_DeliveryYieldPercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:deliveryYieldPercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:intendedRecipientCount ?intended_recipient_count . }
    OPTIONAL { $this effortless-ntwf:reachedRecipientCount ?reached_recipient_count . }
                BIND(IF(COALESCE((COALESCE(?intended_recipient_count, 0) > 0), false), ((?reached_recipient_count * 100) / ?intended_recipient_count), 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_CampaignSilentlyLostAudience" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:campaignSilentlyLostAudience ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:silentlyDroppedCount ?silently_dropped_count . }
                BIND((COALESCE(?silently_dropped_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_UnrecordedRefusalCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unrecordedRefusalCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SendIntents .
                    ?child effortless-ntwf:unrecordedRefusalExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_HasUnrecordedRefusals" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasUnrecordedRefusals ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:unrecordedRefusalCount ?unrecorded_refusal_count . }
                BIND((COALESCE(?unrecorded_refusal_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_IndependentlyConfirmedIntentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:independentlyConfirmedIntentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SendIntents .
                    ?child effortless-ntwf:independentlyConfirmedExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SendDecisionsAreEntirelySelfWitnessed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sendDecisionsAreEntirelySelfWitnessed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:independentlyConfirmedIntentCount ?independently_confirmed_intent_count . }
    OPTIONAL { $this effortless-ntwf:intendedRecipientCount ?intended_recipient_count . }
                BIND((COALESCE((COALESCE(?intended_recipient_count, 0) > 0), false) && COALESCE((COALESCE(?independently_confirmed_intent_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ParticipantCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:participantCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ExecutionParticipants .
                    ?child effortless-ntwf:procedureExecution $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_DeviatingStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:deviatingStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:deviationExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_HasStepDeviation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasStepDeviation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:deviatingStepCount ?deviating_step_count . }
                BIND((COALESCE(?deviating_step_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_DeviatingFacilityKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:deviatingFacilityKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:facility ?facility . }
    OPTIONAL { $this effortless-ntwf:hasStepDeviation ?has_step_deviation . }
                BIND(IF(COALESCE(?has_step_deviation, false), ?facility, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_CleanFacilityKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cleanFacilityKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:facility ?facility . OPTIONAL { ?facility effortless-ntwf:__key ?facility__key . } }
    OPTIONAL { $this effortless-ntwf:hasStepDeviation ?has_step_deviation . }
                BIND(IF(COALESCE((COALESCE((COALESCE(?facility__key, COALESCE(IF(isIRI(?facility), REPLACE(STR(?facility), "^.*[#/]", ""), STR(?facility)), "")) != ""), false) && COALESCE((COALESCE(?has_step_deviation, false) = false), false)), false), ?facility, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_DeviatingDayVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:deviatingDayVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:hasStepDeviation ?has_step_deviation . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
    OPTIONAL { $this effortless-ntwf:shift ?shift . OPTIONAL { ?shift effortless-ntwf:__key ?shift__key . } }
                BIND(IF(COALESCE((COALESCE(?has_step_deviation, false) && COALESCE((COALESCE(?shift__key, COALESCE(IF(isIRI(?shift), REPLACE(STR(?shift), "^.*[#/]", ""), STR(?shift)), "")) = "Day"), false)), false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_DeviatingNightVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:deviatingNightVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:hasStepDeviation ?has_step_deviation . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
    OPTIONAL { $this effortless-ntwf:shift ?shift . OPTIONAL { ?shift effortless-ntwf:__key ?shift__key . } }
                BIND(IF(COALESCE((COALESCE(?has_step_deviation, false) && COALESCE((COALESCE(?shift__key, COALESCE(IF(isIRI(?shift), REPLACE(STR(?shift), "^.*[#/]", ""), STR(?shift)), "")) = "Night"), false)), false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_StatusChangeCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:statusChangeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureStatusChanges .
                    ?child effortless-ntwf:procedureExecution $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ClaimsCompletionWithoutAllSteps" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:claimsCompletionWithoutAllSteps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:completedStepCount ?completed_step_count . }
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . OPTIONAL { ?execution_status effortless-ntwf:__key ?execution_status__key . } }
    OPTIONAL { $this effortless-ntwf:expectedStepCount ?expected_step_count . }
                BIND((COALESCE((COALESCE(?execution_status__key, COALESCE(IF(isIRI(?execution_status), REPLACE(STR(?execution_status), "^.*[#/]", ""), STR(?execution_status)), "")) = "Completed"), false) && COALESCE((COALESCE(?completed_step_count, 0) < COALESCE(?expected_step_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_IsUnconfirmedCompletion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnconfirmedCompletion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:confirmedByAgent ?confirmed_by_agent . OPTIONAL { ?confirmed_by_agent effortless-ntwf:__key ?confirmed_by_agent__key . } }
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . OPTIONAL { ?execution_status effortless-ntwf:__key ?execution_status__key . } }
                BIND((COALESCE((COALESCE(?execution_status__key, COALESCE(IF(isIRI(?execution_status), REPLACE(STR(?execution_status), "^.*[#/]", ""), STR(?execution_status)), "")) = "Completed"), false) && COALESCE((COALESCE(?confirmed_by_agent__key, COALESCE(IF(isIRI(?confirmed_by_agent), REPLACE(STR(?confirmed_by_agent), "^.*[#/]", ""), STR(?confirmed_by_agent)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_HasNoRecordedOutcome" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoRecordedOutcome ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:outcome ?outcome . OPTIONAL { ?outcome effortless-ntwf:__key ?outcome__key . } }
                BIND((COALESCE(?outcome__key, COALESCE(IF(isIRI(?outcome), REPLACE(STR(?outcome), "^.*[#/]", ""), STR(?outcome)), "")) = "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_FeedbackCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:feedbackCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:UserFeedback .
                    ?child effortless-ntwf:procedureExecution $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_IsUnreportedMistake" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnreportedMistake ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:feedbackCount ?feedback_count . }
    OPTIONAL { $this effortless-ntwf:hasStepDeviation ?has_step_deviation . }
                BIND((COALESCE(?has_step_deviation, false) && COALESCE((COALESCE(?feedback_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureFacetAssignments ===
effortless-ntwf:ProcedureFacetAssignmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureFacetAssignments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureFacetAssignments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureFacetAssignments .
    OPTIONAL { $this effortless-ntwf:facet ?facet . OPTIONAL { ?facet effortless-ntwf:__key ?facet__key . } }
    OPTIONAL { $this effortless-ntwf:facetValue ?facet_value . OPTIONAL { ?facet_value effortless-ntwf:__key ?facet_value__key . } }
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . OPTIONAL { ?procedure effortless-ntwf:__key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), " ", COALESCE(COALESCE(?facet__key, IF(isIRI(?facet), REPLACE(STR(?facet), "^.*[#/]", ""), STR(?facet))), ""), "=", COALESCE(COALESCE(?facet_value__key, IF(isIRI(?facet_value), REPLACE(STR(?facet_value), "^.*[#/]", ""), STR(?facet_value))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureLensViews ===
effortless-ntwf:ProcedureLensViewsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureLensViews ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureLensViews_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureLensViews .
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . OPTIONAL { ?procedure effortless-ntwf:__key ?procedure__key . } }
    OPTIONAL { $this effortless-ntwf:stakeholderLens ?stakeholder_lens . OPTIONAL { ?stakeholder_lens effortless-ntwf:__key ?stakeholder_lens__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), " for ", COALESCE(COALESCE(?stakeholder_lens__key, IF(isIRI(?stakeholder_lens), REPLACE(STR(?stakeholder_lens), "^.*[#/]", ""), STR(?stakeholder_lens))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureLensViews_ProcedureCurrentVersion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:procedureCurrentVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureLensViews .
                OPTIONAL { $this effortless-ntwf:procedure ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Procedures ; effortless-ntwf:procedureId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:currentVersionKey ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureLensViews_LensGranularityRank" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lensGranularityRank ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureLensViews .
                OPTIONAL { $this effortless-ntwf:stakeholderLens ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StakeholderLenses ; effortless-ntwf:stakeholderLensId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:granularityRank ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureLensViews_ViewGranularityRank" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:viewGranularityRank ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureLensViews .
    OPTIONAL { $this effortless-ntwf:granularity ?granularity . OPTIONAL { ?granularity effortless-ntwf:__key ?granularity__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?granularity__key, COALESCE(IF(isIRI(?granularity), REPLACE(STR(?granularity), "^.*[#/]", ""), STR(?granularity)), "")) = "Step"), false), 3, IF(COALESCE((COALESCE(?granularity__key, COALESCE(IF(isIRI(?granularity), REPLACE(STR(?granularity), "^.*[#/]", ""), STR(?granularity)), "")) = "Stage"), false), 2, IF(COALESCE((COALESCE(?granularity__key, COALESCE(IF(isIRI(?granularity), REPLACE(STR(?granularity), "^.*[#/]", ""), STR(?granularity)), "")) = "Category"), false), 1, 0)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureLensViews_IsGranularityMisfit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isGranularityMisfit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureLensViews .
    OPTIONAL { $this effortless-ntwf:lensGranularityRank ?lens_granularity_rank . }
    OPTIONAL { $this effortless-ntwf:viewGranularityRank ?view_granularity_rank . }
                BIND((COALESCE((COALESCE(?lens_granularity_rank, 0) > 0), false) && COALESCE((COALESCE(?view_granularity_rank, 0) != COALESCE(?lens_granularity_rank, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureLensViews_IsDisconnectedSilo" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDisconnectedSilo ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureLensViews .
    OPTIONAL { $this effortless-ntwf:procedureCurrentVersion ?procedure_current_version . }
    OPTIONAL { $this effortless-ntwf:projectsVersion ?projects_version . OPTIONAL { ?projects_version effortless-ntwf:__key ?projects_version__key . } }
                BIND((COALESCE((COALESCE(?projects_version__key, COALESCE(IF(isIRI(?projects_version), REPLACE(STR(?projects_version), "^.*[#/]", ""), STR(?projects_version)), "")) = ""), false) || COALESCE(COALESCE((?projects_version != ?procedure_current_version), !((!BOUND(?projects_version) || STR(?projects_version) = "") && (!BOUND(?procedure_current_version) || STR(?procedure_current_version) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureLensViews_StepLevelProcedureKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepLevelProcedureKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureLensViews .
    OPTIONAL { $this effortless-ntwf:lensGranularityRank ?lens_granularity_rank . }
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . }
                BIND(IF(COALESCE((COALESCE(?lens_granularity_rank, 0) = 3), false), ?procedure, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureLensViews_CategoryLevelProcedureKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:categoryLevelProcedureKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureLensViews .
    OPTIONAL { $this effortless-ntwf:lensGranularityRank ?lens_granularity_rank . }
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . }
                BIND(IF(COALESCE((COALESCE(?lens_granularity_rank, 0) = 1), false), ?procedure, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureOutcomeCriteria ===
effortless-ntwf:ProcedureOutcomeCriteriaShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureOutcomeCriteria ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureOutcomeCriteria_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureOutcomeCriteria .
    OPTIONAL { $this effortless-ntwf:polarity ?polarity . OPTIONAL { ?polarity effortless-ntwf:__key ?polarity__key . } }
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . OPTIONAL { ?procedure effortless-ntwf:__key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), ""), " ", COALESCE(COALESCE(?polarity__key, IF(isIRI(?polarity), REPLACE(STR(?polarity), "^.*[#/]", ""), STR(?polarity))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureOutcomeCriteria_FailureProcedureKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:failureProcedureKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureOutcomeCriteria .
    OPTIONAL { $this effortless-ntwf:polarity ?polarity . OPTIONAL { ?polarity effortless-ntwf:__key ?polarity__key . } }
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . }
                BIND(IF(COALESCE((COALESCE(?polarity__key, COALESCE(IF(isIRI(?polarity), REPLACE(STR(?polarity), "^.*[#/]", ""), STR(?polarity)), "")) = "Failure"), false), ?procedure, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureResources ===
effortless-ntwf:ProcedureResourcesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureResources ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureResources_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureResources .
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version effortless-ntwf:__key ?procedure_version__key . } }
    OPTIONAL { $this effortless-ntwf:resource ?resource . OPTIONAL { ?resource effortless-ntwf:__key ?resource__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " / ", COALESCE(COALESCE(?resource__key, IF(isIRI(?resource), REPLACE(STR(?resource), "^.*[#/]", ""), STR(?resource))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureResources_RelationIri" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:relationIri ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureResources .
    OPTIONAL { $this effortless-ntwf:relation ?relation . OPTIONAL { ?relation effortless-ntwf:__key ?relation__key . } }
                BIND(IF(COALESCE((COALESCE(?relation__key, COALESCE(IF(isIRI(?relation), REPLACE(STR(?relation), "^.*[#/]", ""), STR(?relation)), "")) = "wasExtractedFrom"), false), "https://w3id.org/pko#wasExtractedFrom", "http://purl.org/dc/terms/references") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureResources_ResourceModifiedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:resourceModifiedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureResources .
                OPTIONAL { $this effortless-ntwf:resource ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Resources ; effortless-ntwf:resourceId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:modifiedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureStatusChanges ===
effortless-ntwf:ProcedureStatusChangesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureStatusChanges ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureStatusChanges_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureStatusChanges .
    OPTIONAL { $this effortless-ntwf:fromStatus ?from_status . OPTIONAL { ?from_status effortless-ntwf:__key ?from_status__key . } }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version effortless-ntwf:__key ?procedure_version__key . } }
    OPTIONAL { $this effortless-ntwf:toStatus ?to_status . OPTIONAL { ?to_status effortless-ntwf:__key ?to_status__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), ": ", COALESCE(COALESCE(?from_status__key, IF(isIRI(?from_status), REPLACE(STR(?from_status), "^.*[#/]", ""), STR(?from_status))), ""), " -> ", COALESCE(COALESCE(?to_status__key, IF(isIRI(?to_status), REPLACE(STR(?to_status), "^.*[#/]", ""), STR(?to_status))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureStatusChanges_IsUnattributedChange" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnattributedChange ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureStatusChanges .
    OPTIONAL { $this effortless-ntwf:changedByAgent ?changed_by_agent . OPTIONAL { ?changed_by_agent effortless-ntwf:__key ?changed_by_agent__key . } }
                BIND((COALESCE(?changed_by_agent__key, COALESCE(IF(isIRI(?changed_by_agent), REPLACE(STR(?changed_by_agent), "^.*[#/]", ""), STR(?changed_by_agent)), "")) = "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureStatusChanges_ChangeKindContradictsTarget" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:changeKindContradictsTarget ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureStatusChanges .
    OPTIONAL { $this effortless-ntwf:changeKind ?change_kind . OPTIONAL { ?change_kind effortless-ntwf:__key ?change_kind__key . } }
    OPTIONAL { $this effortless-ntwf:toStatus ?to_status . OPTIONAL { ?to_status effortless-ntwf:__key ?to_status__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?change_kind__key, COALESCE(IF(isIRI(?change_kind), REPLACE(STR(?change_kind), "^.*[#/]", ""), STR(?change_kind)), "")) = "Approve"), false) && COALESCE((COALESCE(?to_status__key, COALESCE(IF(isIRI(?to_status), REPLACE(STR(?to_status), "^.*[#/]", ""), STR(?to_status)), "")) != "Approved"), false)), false) || COALESCE((COALESCE((COALESCE(?change_kind__key, COALESCE(IF(isIRI(?change_kind), REPLACE(STR(?change_kind), "^.*[#/]", ""), STR(?change_kind)), "")) = "Validate"), false) && COALESCE((COALESCE(?to_status__key, COALESCE(IF(isIRI(?to_status), REPLACE(STR(?to_status), "^.*[#/]", ""), STR(?to_status)), "")) != "Validation"), false)), false) || COALESCE((COALESCE((COALESCE(?change_kind__key, COALESCE(IF(isIRI(?change_kind), REPLACE(STR(?change_kind), "^.*[#/]", ""), STR(?change_kind)), "")) = "Archive"), false) && COALESCE((COALESCE(?to_status__key, COALESCE(IF(isIRI(?to_status), REPLACE(STR(?to_status), "^.*[#/]", ""), STR(?to_status)), "")) != "Archived"), false) && COALESCE((COALESCE(?to_status__key, COALESCE(IF(isIRI(?to_status), REPLACE(STR(?to_status), "^.*[#/]", ""), STR(?to_status)), "")) != "Deprecated"), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureTargets ===
effortless-ntwf:ProcedureTargetsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureTargets ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTargets_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTargets .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTargets_MachineIsNonStandard" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:machineIsNonStandard ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTargets .
                OPTIONAL { $this effortless-ntwf:machine ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Machines ; effortless-ntwf:machineId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isNonStandardConfiguration ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTargets_HandlingFailureModeCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:handlingFailureModeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTargets .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FailureModes .
                    ?child effortless-ntwf:procedureTarget $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTargets_IsUnhandledNonStandardTarget" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnhandledNonStandardTarget ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTargets .
    OPTIONAL { $this effortless-ntwf:handlingFailureModeCount ?handling_failure_mode_count . }
    OPTIONAL { $this effortless-ntwf:machineIsNonStandard ?machine_is_non_standard . }
                BIND((COALESCE(?machine_is_non_standard, false) && COALESCE((COALESCE(?handling_failure_mode_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureTypes ===
effortless-ntwf:ProcedureTypesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureTypes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTypes .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_NarrowerTypeCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:narrowerTypeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTypes .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureTypes .
                    ?child effortless-ntwf:broaderProcedureType $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_HasNarrowerTypes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNarrowerTypes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTypes .
    OPTIONAL { $this effortless-ntwf:narrowerTypeCount ?narrower_type_count . }
                BIND((COALESCE(?narrower_type_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_IsDetachedFromTaxonomy" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDetachedFromTaxonomy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTypes .
    OPTIONAL { $this effortless-ntwf:broaderProcedureType ?broader_procedure_type . OPTIONAL { ?broader_procedure_type effortless-ntwf:__key ?broader_procedure_type__key . } }
    OPTIONAL { $this effortless-ntwf:taxonomyRank ?taxonomy_rank . OPTIONAL { ?taxonomy_rank effortless-ntwf:__key ?taxonomy_rank__key . } }
                BIND((COALESCE((COALESCE(?taxonomy_rank__key, COALESCE(IF(isIRI(?taxonomy_rank), REPLACE(STR(?taxonomy_rank), "^.*[#/]", ""), STR(?taxonomy_rank)), "")) != "FunctionalDomain"), false) && COALESCE((COALESCE(?broader_procedure_type__key, COALESCE(IF(isIRI(?broader_procedure_type), REPLACE(STR(?broader_procedure_type), "^.*[#/]", ""), STR(?broader_procedure_type)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_BroaderIsDetached" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:broaderIsDetached ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTypes .
                OPTIONAL { $this effortless-ntwf:broaderProcedureType ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureTypes ; effortless-ntwf:procedureTypeId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isDetachedFromTaxonomy ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_IsUnreachableByNavigation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnreachableByNavigation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTypes .
    OPTIONAL { $this effortless-ntwf:broaderIsDetached ?broader_is_detached . }
    OPTIONAL { $this effortless-ntwf:broaderProcedureType ?broader_procedure_type . OPTIONAL { ?broader_procedure_type effortless-ntwf:__key ?broader_procedure_type__key . } }
    OPTIONAL { $this effortless-ntwf:isDetachedFromTaxonomy ?is_detached_from_taxonomy . }
                BIND((COALESCE(?is_detached_from_taxonomy, false) || COALESCE((COALESCE((COALESCE(?broader_procedure_type__key, COALESCE(IF(isIRI(?broader_procedure_type), REPLACE(STR(?broader_procedure_type), "^.*[#/]", ""), STR(?broader_procedure_type)), "")) != ""), false) && COALESCE((COALESCE(?broader_is_detached, false) = true), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_MemberCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:memberCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTypes .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Procedures .
                    ?child effortless-ntwf:procedureType $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_MembersLackingDistinctionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:membersLackingDistinctionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTypes .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Procedures .
                    ?child effortless-ntwf:lacksDistinctionTypeKey ?backfk .
                    $this effortless-ntwf:procedureTypeId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTypes_IsArbitraryGrouping" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isArbitraryGrouping ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureTypes .
    OPTIONAL { $this effortless-ntwf:distinguishingFacet ?distinguishing_facet . OPTIONAL { ?distinguishing_facet effortless-ntwf:__key ?distinguishing_facet__key . } }
    OPTIONAL { $this effortless-ntwf:memberCount ?member_count . }
    OPTIONAL { $this effortless-ntwf:membersLackingDistinctionCount ?members_lacking_distinction_count . }
                BIND((COALESCE((COALESCE(?member_count, 0) > 0), false) && COALESCE((COALESCE((COALESCE(?distinguishing_facet__key, COALESCE(IF(isIRI(?distinguishing_facet), REPLACE(STR(?distinguishing_facet), "^.*[#/]", ""), STR(?distinguishing_facet)), "")) = ""), false) || COALESCE((COALESCE(?members_lacking_distinction_count, 0) = COALESCE(?member_count, 0)), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureVersionLinks ===
effortless-ntwf:ProcedureVersionLinksShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureVersionLinks ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersionLinks_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersionLinks .
    OPTIONAL { $this effortless-ntwf:nextProcedureVersion ?next_procedure_version . OPTIONAL { ?next_procedure_version effortless-ntwf:__key ?next_procedure_version__key . } }
    OPTIONAL { $this effortless-ntwf:previousProcedureVersion ?previous_procedure_version . OPTIONAL { ?previous_procedure_version effortless-ntwf:__key ?previous_procedure_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?previous_procedure_version__key, IF(isIRI(?previous_procedure_version), REPLACE(STR(?previous_procedure_version), "^.*[#/]", ""), STR(?previous_procedure_version))), ""), " -> ", COALESCE(COALESCE(?next_procedure_version__key, IF(isIRI(?next_procedure_version), REPLACE(STR(?next_procedure_version), "^.*[#/]", ""), STR(?next_procedure_version))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersionLinks_SupersededVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:supersededVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersionLinks .
    OPTIONAL { $this effortless-ntwf:previousProcedureVersion ?previous_procedure_version . }
    OPTIONAL { $this effortless-ntwf:relationIri ?relation_iri . OPTIONAL { ?relation_iri effortless-ntwf:__key ?relation_iri__key . } }
                BIND(IF(COALESCE((COALESCE(?relation_iri__key, COALESCE(IF(isIRI(?relation_iri), REPLACE(STR(?relation_iri), "^.*[#/]", ""), STR(?relation_iri)), "")) = "https://w3id.org/pko#nextVersion"), false), ?previous_procedure_version, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureVersions ===
effortless-ntwf:ProcedureVersionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureVersions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfSteps" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfSteps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:procedureVersion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfOpenKnowledgeGaps" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfOpenKnowledgeGaps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeGaps .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:status ?c2 . }
                    FILTER((STR(?c2) = "Open"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsReadyForExecution" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isReadyForExecution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:countOfOpenKnowledgeGaps ?count_of_open_knowledge_gaps . }
    OPTIONAL { $this effortless-ntwf:countOfSteps ?count_of_steps . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) && COALESCE((COALESCE(?count_of_steps, 0) > 0), false) && COALESCE((COALESCE(?count_of_open_knowledge_gaps, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_SpecifiedStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:specifiedStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:procedureVersion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_OverdueReviewCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overdueReviewCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ReviewEvents .
                    ?child effortless-ntwf:overdueVersionKey ?backfk .
                    $this effortless-ntwf:procedureVersionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_OpenChangeRequestCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:openChangeRequestCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeRequests .
                    ?child effortless-ntwf:openChangeVersionKey ?backfk .
                    $this effortless-ntwf:procedureVersionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_OpenHighSeverityGapCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:openHighSeverityGapCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeGaps .
                    ?child effortless-ntwf:openGapVersionKey ?backfk .
                    $this effortless-ntwf:procedureVersionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsFitToExecute" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFitToExecute ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:openChangeRequestCount ?open_change_request_count . }
    OPTIONAL { $this effortless-ntwf:openHighSeverityGapCount ?open_high_severity_gap_count . }
    OPTIONAL { $this effortless-ntwf:overdueReviewCount ?overdue_review_count . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) && COALESCE((COALESCE(?overdue_review_count, 0) = 0), false) && COALESCE((COALESCE(?open_change_request_count, 0) = 0), false) && COALESCE((COALESCE(?open_high_severity_gap_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_StewardReviewCadenceDays" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stewardReviewCadenceDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:StewardshipAssignments .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:reviewCadenceDays ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfStewardshipAssignments" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfStewardshipAssignments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StewardshipAssignments .
                    ?child effortless-ntwf:procedureVersion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HasAnySteward" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasAnySteward ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:countOfStewardshipAssignments ?count_of_stewardship_assignments . }
                BIND((COALESCE(?count_of_stewardship_assignments, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsLive" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Published"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsUnstewarded" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnstewarded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:hasAnySteward ?has_any_steward . }
                BIND((!(COALESCE(?has_any_steward, false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsLiveAndUnstewarded" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLiveAndUnstewarded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:isLive ?is_live . }
    OPTIONAL { $this effortless-ntwf:isUnstewarded ?is_unstewarded . }
                BIND((COALESCE(?is_live, false) && COALESCE(?is_unstewarded, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfOpenBlockingGaps" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfOpenBlockingGaps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeGaps .
                    OPTIONAL { ?child effortless-ntwf:isOpenAndBlocking ?c0 . }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HasOpenBlockingGap" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasOpenBlockingGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:countOfOpenBlockingGaps ?count_of_open_blocking_gaps . }
                BIND((COALESCE(?count_of_open_blocking_gaps, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsLiveWithBlockingGap" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLiveWithBlockingGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:hasOpenBlockingGap ?has_open_blocking_gap . }
    OPTIONAL { $this effortless-ntwf:isLive ?is_live . }
                BIND((COALESCE(?is_live, false) && COALESCE(?has_open_blocking_gap, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ShouldNotBeExecutable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:shouldNotBeExecutable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:hasOpenBlockingGap ?has_open_blocking_gap . }
    OPTIONAL { $this effortless-ntwf:isReadyForExecution ?is_ready_for_execution . }
                BIND((COALESCE(?is_ready_for_execution, false) && COALESCE(?has_open_blocking_gap, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfUnapprovedRelianceFragments" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfUnapprovedRelianceFragments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeFragments .
                    OPTIONAL { ?child effortless-ntwf:isUnapprovedButReliedOn ?c0 . }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_RunsOnUnapprovedKnowledge" ;
