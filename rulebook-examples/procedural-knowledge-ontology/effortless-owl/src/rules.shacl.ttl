    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:softwareExecutionStepKey ?backfk .
                    $this effortless-ntwf:stepId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_HasBeenApproachedBySoftware" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasBeenApproachedBySoftware ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:softwareExecutionCount ?software_execution_count . }
                BIND((COALESCE(?software_execution_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsUnexercisedHumanGate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnexercisedHumanGate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:hasBeenApproachedBySoftware ?has_been_approached_by_software . }
    OPTIONAL { $this effortless-ntwf:isHumanApprovalGate ?is_human_approval_gate . }
                BIND((COALESCE(?is_human_approval_gate, false) && COALESCE((!(COALESCE(?has_been_approached_by_software, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsDemonstratedHumanGate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDemonstratedHumanGate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:gateHeldByHuman ?gate_held_by_human . }
    OPTIONAL { $this effortless-ntwf:hasBeenApproachedBySoftware ?has_been_approached_by_software . }
    OPTIONAL { $this effortless-ntwf:isHumanApprovalGate ?is_human_approval_gate . }
                BIND((COALESCE(?is_human_approval_gate, false) && COALESCE(?has_been_approached_by_software, false) && COALESCE(?gate_held_by_human, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_UnexercisedGateVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unexercisedGateVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:isUnexercisedHumanGate ?is_unexercised_human_gate . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_unexercised_human_gate, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_HasDeclaredControlKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
