    OPTIONAL { $this effortless-ntwf:outcomeMeasureCount ?outcome_measure_count . }
    OPTIONAL { $this effortless-ntwf:unlinkedMeasureCount ?unlinked_measure_count . }
                BIND((COALESCE((COALESCE(?outcome_measure_count, 0) > 0), false) && COALESCE((COALESCE(?unlinked_measure_count, 0) = COALESCE(?outcome_measure_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
