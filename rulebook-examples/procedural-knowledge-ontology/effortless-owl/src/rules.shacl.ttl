            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:substrateLabel ?_result .
            }
            WHERE {
    $this a pko-extension:TableConformance .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:substrate ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:ConformanceSubstrate . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TableConformance_SubjectArea a sh:NodeShape ;
    sh:targetClass pko-extension:TableConformance ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_SubjectArea" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:subjectArea ?_result .
            }
            WHERE {
    $this a pko-extension:TableConformance .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rulebookTable ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:RulebookTable . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:subjectArea ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for TacticalResourceAllocations ===
pko-native-procedural-knowledge-rulebook-shapes:TacticalResourceAllocations_Name a sh:NodeShape ;
    sh:targetClass pko-extension:TacticalResourceAllocation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TacticalResourceAllocations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:TacticalResourceAllocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resourceLabel ?resource_label . OPTIONAL { ?resource_label erb:key ?resource_label__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?resource_label__key, IF(isIRI(?resource_label), REPLACE(STR(?resource_label), "^.*[#/]", ""), STR(?resource_label))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TacticalResourceAllocations_UtilizationPercent a sh:NodeShape ;
    sh:targetClass pko-extension:TacticalResourceAllocation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TacticalResourceAllocations_UtilizationPercent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:utilizationPercent ?_result .
            }
            WHERE {
    $this a pko-extension:TacticalResourceAllocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:availableUnitsPerWeek ?available_units_per_week . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:demandedUnitsPerWeek ?demanded_units_per_week . }
                BIND(IF(COALESCE((COALESCE(?available_units_per_week, 0) = 0), false), 0, (ROUND(xsd:double((?demanded_units_per_week * 100) / ?available_units_per_week) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TacticalResourceAllocations_IsBottleneck a sh:NodeShape ;
    sh:targetClass pko-extension:TacticalResourceAllocation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TacticalResourceAllocations_IsBottleneck" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isBottleneck ?_result .
            }
            WHERE {
    $this a pko-extension:TacticalResourceAllocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:availableUnitsPerWeek ?available_units_per_week . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:demandedUnitsPerWeek ?demanded_units_per_week . }
                BIND((COALESCE(?demanded_units_per_week, 0) > COALESCE(?available_units_per_week, 0)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for TemplateApprovals ===
pko-native-procedural-knowledge-rulebook-shapes:TemplateApprovals_Name a sh:NodeShape ;
    sh:targetClass pko-extension:TemplateApproval ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:TemplateApproval .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decidedAt ?decided_at . OPTIONAL { ?decided_at erb:key ?decided_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decision ?decision . OPTIONAL { ?decision erb:key ?decision__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:messageTemplate ?message_template . OPTIONAL { ?message_template erb:key ?message_template__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?message_template__key, IF(isIRI(?message_template), REPLACE(STR(?message_template), "^.*[#/]", ""), STR(?message_template))), ""), " / ", COALESCE(COALESCE(?decision__key, IF(isIRI(?decision), REPLACE(STR(?decision), "^.*[#/]", ""), STR(?decision))), ""), " / ", COALESCE(REPLACE(COALESCE(?decided_at__key, IF(isIRI(?decided_at), REPLACE(STR(?decided_at), "^.*[#/]", ""), STR(?decided_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TemplateApprovals_IsApprovalDecision a sh:NodeShape ;
    sh:targetClass pko-extension:TemplateApproval ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_IsApprovalDecision" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isApprovalDecision ?_result .
            }
            WHERE {
    $this a pko-extension:TemplateApproval .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decision ?decision . OPTIONAL { ?decision erb:key ?decision__key . } }
                BIND((COALESCE(?decision__key, COALESCE(IF(isIRI(?decision), REPLACE(STR(?decision), "^.*[#/]", ""), STR(?decision)), "")) = "Approved") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TemplateApprovals_TemplatePolicy a sh:NodeShape ;
    sh:targetClass pko-extension:TemplateApproval ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_TemplatePolicy" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:templatePolicy ?_result .
            }
            WHERE {
    $this a pko-extension:TemplateApproval .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:messageTemplate ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:MessageTemplates . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:communicationPolicy ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TemplateApprovals_RequiredApprovalRole a sh:NodeShape ;
    sh:targetClass pko-extension:TemplateApproval ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_RequiredApprovalRole" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:requiredApprovalRole ?_result .
            }
            WHERE {
    $this a pko-extension:TemplateApproval .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:templatePolicy ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:CommunicationPolicies . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:approvalRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TemplateApprovals_IsDecidedByRequiredRole a sh:NodeShape ;
    sh:targetClass pko-extension:TemplateApproval ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_IsDecidedByRequiredRole" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDecidedByRequiredRole ?_result .
            }
            WHERE {
    $this a pko-extension:TemplateApproval .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decidedInRole ?decided_in_role . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requiredApprovalRole ?required_approval_role . }
                BIND(COALESCE((?decided_in_role = ?required_approval_role), ((!BOUND(?decided_in_role) || STR(?decided_in_role) = "") && (!BOUND(?required_approval_role) || STR(?required_approval_role) = ""))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TemplateApprovals_ValidApprovalTemplateKey a sh:NodeShape ;
    sh:targetClass pko-extension:TemplateApproval ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_ValidApprovalTemplateKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:validApprovalTemplateKey ?_result .
            }
            WHERE {
    $this a pko-extension:TemplateApproval .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isApprovalDecision ?is_approval_decision . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isDecidedByRequiredRole ?is_decided_by_required_role . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:messageTemplate ?message_template . }
                BIND(IF(COALESCE((COALESCE(?is_approval_decision, false) && COALESCE(?is_decided_by_required_role, false)), false), ?message_template, "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for TermDefinitions ===
pko-native-procedural-knowledge-rulebook-shapes:TermDefinitions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:TermDefinition ;
