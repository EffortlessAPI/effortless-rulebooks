                $this effortless-ntwf:isSilentlyDropped ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:hasResultingDelivery ?has_resulting_delivery . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
                BIND((COALESCE((!(COALESCE(?is_cleared_to_send, false))), false) && COALESCE((!(COALESCE(?has_resulting_delivery, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ResultingDeliveryException" ;
