pko-native-procedural-knowledge-rulebook-shapes:RulebookFields_IsDiscriminating a sh:NodeShape ;
    sh:targetClass pko-extension:RulebookField ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_IsDiscriminating" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDiscriminating ?_result .
            }
            WHERE {
    $this a pko-extension:RulebookField .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:measuredDistinctValueCount ?measured_distinct_value_count . }
                BIND((COALESCE(?measured_distinct_value_count, 0) >= 2) AS ?_result)
            }
        """ ;
    ] .

# === Rules for RulebookReleases ===
pko-native-procedural-knowledge-rulebook-shapes:RulebookReleases_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:RulebookReleases ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:RulebookReleases .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:pkoCoreVersionIri ?pko_core_version_iri . OPTIONAL { ?pko_core_version_iri erb:key ?pko_core_version_iri__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rulebookVersion ?rulebook_version . OPTIONAL { ?rulebook_version erb:key ?rulebook_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?rulebook_version__key, IF(isIRI(?rulebook_version), REPLACE(STR(?rulebook_version), "^.*[#/]", ""), STR(?rulebook_version))), ""), " / PKO ", COALESCE(COALESCE(?pko_core_version_iri__key, IF(isIRI(?pko_core_version_iri), REPLACE(STR(?pko_core_version_iri), "^.*[#/]", ""), STR(?pko_core_version_iri))), "")) AS ?_result)
