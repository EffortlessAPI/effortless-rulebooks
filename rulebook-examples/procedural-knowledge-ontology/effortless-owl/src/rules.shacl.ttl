# === Rules for GroundingSnapshots ===
pko-native-procedural-knowledge-rulebook-shapes:GroundingSnapshots_Name a sh:NodeShape ;
    sh:targetClass pko-extension:GroundingSnapshot ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:GroundingSnapshot .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:GroundingSnapshots_IsGoverned a sh:NodeShape ;
    sh:targetClass pko-extension:GroundingSnapshot ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_IsGoverned" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isGoverned ?_result .
            }
            WHERE {
    $this a pko-extension:GroundingSnapshot .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:governanceReviewedAt ?governance_reviewed_at . OPTIONAL { ?governance_reviewed_at erb:key ?governance_reviewed_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:servedFrom ?served_from . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stewardRole ?steward_role . OPTIONAL { ?steward_role erb:key ?steward_role__key . } }
                BIND((COALESCE((COALESCE(?steward_role__key, COALESCE(IF(isIRI(?steward_role), REPLACE(STR(?steward_role), "^.*[#/]", ""), STR(?steward_role)), "")) != ""), false) && COALESCE((COALESCE(?governance_reviewed_at__key, COALESCE(IF(isIRI(?governance_reviewed_at), REPLACE(STR(?governance_reviewed_at), "^.*[#/]", ""), STR(?governance_reviewed_at)), "")) != ""), false) && COALESCE(COALESCE((?governance_reviewed_at <= ?served_from), ((!BOUND(?governance_reviewed_at) || STR(?governance_reviewed_at) = "") && (!BOUND(?served_from) || STR(?served_from) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:GroundingSnapshots_ReasonerRunCount a sh:NodeShape ;
    sh:targetClass pko-extension:GroundingSnapshot ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_ReasonerRunCount" ;
