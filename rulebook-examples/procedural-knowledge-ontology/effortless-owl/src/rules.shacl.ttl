    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_ControlAssuranceState a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_ControlAssuranceState" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:controlAssuranceState ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasEverBeenEvaluated ?has_ever_been_evaluated . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasMeaningfulSample ?has_meaningful_sample . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isBoundToAnyStep ?is_bound_to_any_step . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:witnessFireCount ?witness_fire_count . }
                BIND(IF(COALESCE((!(COALESCE(?is_bound_to_any_step, false))), false), "Decorative", IF(COALESCE((!(COALESCE(?has_ever_been_evaluated, false))), false), "Inoperative", IF(COALESCE((!(COALESCE(?has_computed_witness, false))), false), "Asserted", IF(COALESCE((COALESCE(?witness_fire_count, 0) > 0), false), "Demonstrated", IF(COALESCE(?has_meaningful_sample, false), "Holding", "Untested"))))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_UnexercisedBindingCount a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_UnexercisedBindingCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:unexercisedBindingCount ?_result .
            }
            WHERE {
    $this a pko:Requirement .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:Requirement .
                    ?child a pko-native-procedural-knowledge-rulebook:StepRequirements .
                    ?child pko-native-procedural-knowledge-rulebook:unexercisedBindingRequirementKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:requirementId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
