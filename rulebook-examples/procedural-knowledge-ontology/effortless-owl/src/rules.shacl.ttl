            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AiModelDeployment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:environment ?environment . OPTIONAL { ?environment erb:key ?environment__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelVersion ?model_version . OPTIONAL { ?model_version erb:key ?model_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_version__key, IF(isIRI(?model_version), REPLACE(STR(?model_version), "^.*[#/]", ""), STR(?model_version))), ""), " @ ", COALESCE(COALESCE(?environment__key, IF(isIRI(?environment), REPLACE(STR(?environment), "^.*[#/]", ""), STR(?environment))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiModelDeployments_AsOfInstant a sh:NodeShape ;
