            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:cleanFacilityKey ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:facility ?facility . OPTIONAL { ?facility erb:key ?facility__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasStepDeviation ?has_step_deviation . }
                BIND(IF(COALESCE((COALESCE((COALESCE(?facility__key, COALESCE(IF(isIRI(?facility), REPLACE(STR(?facility), "^.*[#/]", ""), STR(?facility)), "")) != ""), false) && COALESCE((COALESCE(?has_step_deviation, false) = false), false)), false), ?facility, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_DeviatingDayVersionKey a sh:NodeShape ;
