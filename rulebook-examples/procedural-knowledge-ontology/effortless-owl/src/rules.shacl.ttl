                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:status_ModelAnnotations ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Question"))
                    FILTER((COALESCE(?c4__key, STR(?c4)) = "Open"))
