                BIND(CONCAT(COALESCE(COALESCE(?app_action__key, IF(isIRI(?app_action), REPLACE(STR(?app_action), "^.*[#/]", ""), STR(?app_action))), ""), " / ", COALESCE(COALESCE(?field_label__key, IF(isIRI(?field_label), REPLACE(STR(?field_label), "^.*[#/]", ""), STR(?field_label))), "")) AS ?_result)
