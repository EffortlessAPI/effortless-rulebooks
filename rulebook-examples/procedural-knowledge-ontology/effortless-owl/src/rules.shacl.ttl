                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isAmbientAbsorptionByNonPractitioner ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
