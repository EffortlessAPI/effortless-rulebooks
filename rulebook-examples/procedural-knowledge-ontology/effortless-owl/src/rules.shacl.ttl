pko-native-procedural-knowledge-rulebook-shapes:ChangeValidationRuns_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeValidationRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeValidationRuns_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeValidationRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelChangeRequest ?model_change_request . OPTIONAL { ?model_change_request erb:key ?model_change_request__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:runPurpose ?run_purpose . OPTIONAL { ?run_purpose erb:key ?run_purpose__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_change_request__key, IF(isIRI(?model_change_request), REPLACE(STR(?model_change_request), "^.*[#/]", ""), STR(?model_change_request))), ""), " ", COALESCE(COALESCE(?run_purpose__key, IF(isIRI(?run_purpose), REPLACE(STR(?run_purpose), "^.*[#/]", ""), STR(?run_purpose))), ""), " run") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeValidationRuns_Release a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeValidationRun ;
    sh:order 1 ;
