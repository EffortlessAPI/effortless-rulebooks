pko-native-procedural-knowledge-rulebook-shapes:Vocabularies_OrganizedKindCount a sh:NodeShape ;
    sh:targetClass pko-extension:Vocabulary ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_OrganizedKindCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:organizedKindCount ?_result .
            }
            WHERE {
    $this a pko-extension:Vocabulary .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:organizedDocumentExcerptCount ?organized_document_excerpt_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:organizedFieldNotesCount ?organized_field_notes_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:organizedMinedEventTraceCount ?organized_mined_event_trace_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:organizedProcessMapCount ?organized_process_map_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:organizedTranscriptCount ?organized_transcript_count . }
                BIND(ROUND(((((IF(COALESCE((COALESCE(?organized_transcript_count, 0) > 0), false), 1, 0) + IF(COALESCE((COALESCE(?organized_field_notes_count, 0) > 0), false), 1, 0)) + IF(COALESCE((COALESCE(?organized_process_map_count, 0) > 0), false), 1, 0)) + IF(COALESCE((COALESCE(?organized_mined_event_trace_count, 0) > 0), false), 1, 0)) + IF(COALESCE((COALESCE(?organized_document_excerpt_count, 0) > 0), false), 1, 0))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Vocabularies_IsSingleKindFrame a sh:NodeShape ;
    sh:targetClass pko-extension:Vocabulary ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_IsSingleKindFrame" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isSingleKindFrame ?_result .
            }
            WHERE {
    $this a pko-extension:Vocabulary .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:organizedKindCount ?organized_kind_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:organizedMaterialCount ?organized_material_count . }
                BIND((COALESCE((COALESCE(?organized_material_count, 0) >= 2), false) && COALESCE((COALESCE(?organized_kind_count, 0) = 1), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Vocabularies_LatestOrganizedMaterialAt a sh:NodeShape ;
    sh:targetClass pko-extension:Vocabulary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_LatestOrganizedMaterialAt" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:latestOrganizedMaterialAt ?_result .
            }
            WHERE {
    $this a pko-extension:Vocabulary .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:Vocabulary .
                    ?child a pko-extension:CollectedSourceMaterial .
                    ?child pko-native-procedural-knowledge-rulebook:organizedIntoScheme $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:collectedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
