                $this effortless-ntwf:notAnchoredInProcessKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAdoptionInitiatives .
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
    OPTIONAL { $this effortless-ntwf:targetProcedure ?target_procedure . OPTIONAL { ?target_procedure effortless-ntwf:__key ?target_procedure__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) != "Proposed"), false) && COALESCE((COALESCE(?target_procedure__key, COALESCE(IF(isIRI(?target_procedure), REPLACE(STR(?target_procedure), "^.*[#/]", ""), STR(?target_procedure)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
