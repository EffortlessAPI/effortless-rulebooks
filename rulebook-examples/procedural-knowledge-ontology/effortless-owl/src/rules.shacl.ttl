            }
            WHERE {
    $this a pko:ProcedureExecution .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:ProcedureExecution .
                    ?child a pko:UserFeedbackOccurrence .
                    ?child pko-native-procedural-knowledge-rulebook:procedureExecution $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
