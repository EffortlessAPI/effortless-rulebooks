            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:broaderTermParent ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:broaderTerm ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:VocabularyTerm . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:broaderTerm ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
