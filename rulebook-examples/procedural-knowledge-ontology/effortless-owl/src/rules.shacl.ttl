            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:escalationBackupRole ?escalation_backup_role . OPTIONAL { ?escalation_backup_role effortless-ntwf:__key ?escalation_backup_role__key . } }
                BIND((COALESCE(?escalation_backup_role__key, COALESCE(IF(isIRI(?escalation_backup_role), REPLACE(STR(?escalation_backup_role), "^.*[#/]", ""), STR(?escalation_backup_role)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_HasUnfilledEscalationBackup" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasUnfilledEscalationBackup ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:backupRoleHolder ?backup_role_holder . OPTIONAL { ?backup_role_holder effortless-ntwf:__key ?backup_role_holder__key . } }
    OPTIONAL { $this effortless-ntwf:escalationBackupRole ?escalation_backup_role . OPTIONAL { ?escalation_backup_role effortless-ntwf:__key ?escalation_backup_role__key . } }
                BIND((COALESCE((COALESCE(?escalation_backup_role__key, COALESCE(IF(isIRI(?escalation_backup_role), REPLACE(STR(?escalation_backup_role), "^.*[#/]", ""), STR(?escalation_backup_role)), "")) != ""), false) && COALESCE((COALESCE(?backup_role_holder__key, COALESCE(IF(isIRI(?backup_role_holder), REPLACE(STR(?backup_role_holder), "^.*[#/]", ""), STR(?backup_role_holder)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_ReleaseApprovalStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:releaseApprovalStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:assignedRole $this .
                    OPTIONAL { ?child effortless-ntwf:isReleaseApprovalGate ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsProductionReleaseApprover" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
