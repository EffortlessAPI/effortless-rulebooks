    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authorAgentKind ?author_agent_kind . OPTIONAL { ?author_agent_kind erb:key ?author_agent_kind__key . } }
                BIND((COALESCE((COALESCE(?author_agent__key, COALESCE(IF(isIRI(?author_agent), REPLACE(STR(?author_agent), "^.*[#/]", ""), STR(?author_agent)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?author_agent_kind__key, COALESCE(IF(isIRI(?author_agent_kind), REPLACE(STR(?author_agent_kind), "^.*[#/]", ""), STR(?author_agent_kind)), "")) = "AIAgent"), false) || COALESCE((COALESCE(?author_agent_kind__key, COALESCE(IF(isIRI(?author_agent_kind), REPLACE(STR(?author_agent_kind), "^.*[#/]", ""), STR(?author_agent_kind)), "")) = "AutomatedPipeline"), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeRepositoryEntries_OutlivesAuthorTenure a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeRepositoryEntry ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeRepositoryEntries_OutlivesAuthorTenure" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:outlivesAuthorTenure ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeRepositoryEntry .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authorAgent ?author_agent . OPTIONAL { ?author_agent erb:key ?author_agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authorIsStillEngaged ?author_is_still_engaged . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isStale ?is_stale . }
                BIND((COALESCE((COALESCE(?author_agent__key, COALESCE(IF(isIRI(?author_agent), REPLACE(STR(?author_agent), "^.*[#/]", ""), STR(?author_agent)), "")) != ""), false) && COALESCE((COALESCE(?author_is_still_engaged, false) = false), false) && COALESCE((COALESCE(?is_stale, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .
