    OPTIONAL { $this effortless-ntwf:modelKind ?model_kind . OPTIONAL { ?model_kind effortless-ntwf:__key ?model_kind__key . } }
    OPTIONAL { $this effortless-ntwf:originatingUseCase ?originating_use_case . OPTIONAL { ?originating_use_case effortless-ntwf:__key ?originating_use_case__key . } }
                BIND((COALESCE((COALESCE(?model_kind__key, COALESCE(IF(isIRI(?model_kind), REPLACE(STR(?model_kind), "^.*[#/]", ""), STR(?model_kind)), "")) != "Vocabulary"), false) && COALESCE((COALESCE(?originating_use_case__key, COALESCE(IF(isIRI(?originating_use_case), REPLACE(STR(?originating_use_case), "^.*[#/]", ""), STR(?originating_use_case)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
