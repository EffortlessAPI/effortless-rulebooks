pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_DecisionLatencyDays a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_DecisionLatencyDays" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:decisionLatencyDays ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decidedAt ?decided_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isDecided ?is_decided . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requestedAt ?requested_at . }
                BIND(ROUND(IF(COALESCE(?is_decided, false), ((DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_ImplementationLatencyDays a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_ImplementationLatencyDays" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:implementationLatencyDays ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decidedAt ?decided_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:implementedAt ?implemented_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isImplemented ?is_implemented . }
                BIND(ROUND(IF(COALESCE(?is_implemented, false), ((DAY(?implemented_at) + FLOOR((153 * (MONTH(?implemented_at) + 12 * FLOOR((14 - MONTH(?implemented_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) + FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 4) - FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 100) + FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] .
