        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeSearchEvent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:queryText ?query_text . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:searchedByAgent ?searched_by_agent . OPTIONAL { ?searched_by_agent erb:key ?searched_by_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?searched_by_agent__key, IF(isIRI(?searched_by_agent), REPLACE(STR(?searched_by_agent), "^.*[#/]", ""), STR(?searched_by_agent))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?query_text), 1, 40)), REPLACE(STR(SUBSTR(STR(?query_text), 1, 40)), "^.*[#/]", ""), STR(SUBSTR(STR(?query_text), 1, 40))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeSearchEvents_FoundNothingUseful a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeSearchEvent ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeSearchEvents_FoundNothingUseful" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:foundNothingUseful ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeSearchEvent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:openedProjection ?opened_projection . OPTIONAL { ?opened_projection erb:key ?opened_projection__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:openedSegment ?opened_segment . OPTIONAL { ?opened_segment erb:key ?opened_segment__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resultCount ?result_count . }
                BIND((COALESCE((COALESCE(?result_count, 0) = 0), false) || COALESCE((COALESCE((COALESCE(?opened_segment__key, COALESCE(IF(isIRI(?opened_segment), REPLACE(STR(?opened_segment), "^.*[#/]", ""), STR(?opened_segment)), "")) = ""), false) && COALESCE((COALESCE(?opened_projection__key, COALESCE(IF(isIRI(?opened_projection), REPLACE(STR(?opened_projection), "^.*[#/]", ""), STR(?opened_projection)), "")) = ""), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeSearchEvents_GaveUpAfterSeeingResults a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeSearchEvent ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeSearchEvents_GaveUpAfterSeeingResults" ;
