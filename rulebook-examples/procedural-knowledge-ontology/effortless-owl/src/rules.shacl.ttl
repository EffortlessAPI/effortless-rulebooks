    $this a pko-extension:ExceptionInvocation .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:exception ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:Exception . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:approvalRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExceptionInvocations_RequiredApprovalRoleHolder a sh:NodeShape ;
    sh:targetClass pko-extension:ExceptionInvocation ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_RequiredApprovalRoleHolder" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:requiredApprovalRoleHolder ?_result .
            }
            WHERE {
    $this a pko-extension:ExceptionInvocation .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requiredApprovalRole ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:Role . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:currentAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExceptionInvocations_ApprovalRoleMatches a sh:NodeShape ;
    sh:targetClass pko-extension:ExceptionInvocation ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ApprovalRoleMatches" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:approvalRoleMatches ?_result .
            }
            WHERE {
    $this a pko-extension:ExceptionInvocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:approvedByAgent ?approved_by_agent . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requiredApprovalRoleHolder ?required_approval_role_holder . }
                BIND(COALESCE((?approved_by_agent = ?required_approval_role_holder), ((!BOUND(?approved_by_agent) || STR(?approved_by_agent) = "") && (!BOUND(?required_approval_role_holder) || STR(?required_approval_role_holder) = ""))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExceptionInvocations_IsApproved a sh:NodeShape ;
    sh:targetClass pko-extension:ExceptionInvocation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_IsApproved" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isApproved ?_result .
            }
            WHERE {
    $this a pko-extension:ExceptionInvocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:approvedByAgent ?approved_by_agent . OPTIONAL { ?approved_by_agent erb:key ?approved_by_agent__key . } }
                BIND((COALESCE(?approved_by_agent__key, COALESCE(IF(isIRI(?approved_by_agent), REPLACE(STR(?approved_by_agent), "^.*[#/]", ""), STR(?approved_by_agent)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExceptionInvocations_IsImproperlyApproved a sh:NodeShape ;
    sh:targetClass pko-extension:ExceptionInvocation ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_IsImproperlyApproved" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isImproperlyApproved ?_result .
            }
            WHERE {
    $this a pko-extension:ExceptionInvocation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:approvalRoleMatches ?approval_role_matches . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isApproved ?is_approved . }
                BIND((COALESCE((!(COALESCE(?is_approved, false))), false) || COALESCE((!(COALESCE(?approval_role_matches, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExceptionInvocations_InvokerAgentKind a sh:NodeShape ;
    sh:targetClass pko-extension:ExceptionInvocation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_InvokerAgentKind" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:invokerAgentKind ?_result .
            }
            WHERE {
    $this a pko-extension:ExceptionInvocation .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:invokedByAgent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExceptionInvocations_InvokerAlsoPreparedKey a sh:NodeShape ;
    sh:targetClass pko-extension:ExceptionInvocation ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
