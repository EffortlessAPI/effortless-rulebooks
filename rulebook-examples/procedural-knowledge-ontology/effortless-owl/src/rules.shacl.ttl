                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Roles_HasEscalationBackup a sh:NodeShape ;
    sh:targetClass pro:Role ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_HasEscalationBackup" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasEscalationBackup ?_result .
            }
            WHERE {
    $this a pro:Role .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:escalationBackupRole ?escalation_backup_role . OPTIONAL { ?escalation_backup_role erb:key ?escalation_backup_role__key . } }
                BIND((COALESCE(?escalation_backup_role__key, COALESCE(IF(isIRI(?escalation_backup_role), REPLACE(STR(?escalation_backup_role), "^.*[#/]", ""), STR(?escalation_backup_role)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Roles_HasUnfilledEscalationBackup a sh:NodeShape ;
    sh:targetClass pro:Role ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_HasUnfilledEscalationBackup" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasUnfilledEscalationBackup ?_result .
            }
            WHERE {
    $this a pro:Role .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:backupRoleHolder ?backup_role_holder . OPTIONAL { ?backup_role_holder erb:key ?backup_role_holder__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:escalationBackupRole ?escalation_backup_role . OPTIONAL { ?escalation_backup_role erb:key ?escalation_backup_role__key . } }
                BIND((COALESCE((COALESCE(?escalation_backup_role__key, COALESCE(IF(isIRI(?escalation_backup_role), REPLACE(STR(?escalation_backup_role), "^.*[#/]", ""), STR(?escalation_backup_role)), "")) != ""), false) && COALESCE((COALESCE(?backup_role_holder__key, COALESCE(IF(isIRI(?backup_role_holder), REPLACE(STR(?backup_role_holder), "^.*[#/]", ""), STR(?backup_role_holder)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Roles_ReleaseApprovalStepCount a sh:NodeShape ;
    sh:targetClass pro:Role ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_ReleaseApprovalStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:releaseApprovalStepCount ?_result .
            }
            WHERE {
    $this a pro:Role .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pro:Role .
                    ?child a p-plan:Step .
                    ?child pko-native-procedural-knowledge-rulebook:assignedRole $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isReleaseApprovalGate ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
