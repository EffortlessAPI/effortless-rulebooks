            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyMaxMessageLengthAtSend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:policyChannel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:maxMessageLength ?j3 . } }
                BIND(?j3 AS ?_result)
            }
