            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:storesProcedureKnowledgeWithoutComputationalAccess ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeConsumerSystem .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holdsComputationallyEncodedProcedureKnowledge ?holds_computationally_encoded_procedure_knowledge . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holdsProcedureKnowledge ?holds_procedure_knowledge . }
                BIND((COALESCE(?holds_procedure_knowledge, false) && COALESCE((COALESCE(?holds_computationally_encoded_procedure_knowledge, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for KnowledgeConversions ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeConversions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeConversion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConversions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeConversion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conversionMode ?conversion_mode . OPTIONAL { ?conversion_mode erb:key ?conversion_mode__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:description ?description . }
                BIND(CONCAT(COALESCE(COALESCE(?conversion_mode__key, IF(isIRI(?conversion_mode), REPLACE(STR(?conversion_mode), "^.*[#/]", ""), STR(?conversion_mode))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?description), 1, 60)), REPLACE(STR(SUBSTR(STR(?description), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?description), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeConversions_IsModeInconsistentWithForms a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeConversion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConversions_IsModeInconsistentWithForms" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isModeInconsistentWithForms ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeConversion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conversionMode ?conversion_mode . OPTIONAL { ?conversion_mode erb:key ?conversion_mode__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fromForm ?from_form . OPTIONAL { ?from_form erb:key ?from_form__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toForm ?to_form . OPTIONAL { ?to_form erb:key ?to_form__key . } }
                BIND((!(COALESCE((COALESCE((COALESCE((COALESCE(?conversion_mode__key, COALESCE(IF(isIRI(?conversion_mode), REPLACE(STR(?conversion_mode), "^.*[#/]", ""), STR(?conversion_mode)), "")) = "Socialization"), false) && COALESCE((COALESCE(?from_form__key, COALESCE(IF(isIRI(?from_form), REPLACE(STR(?from_form), "^.*[#/]", ""), STR(?from_form)), "")) = "Tacit"), false) && COALESCE((COALESCE(?to_form__key, COALESCE(IF(isIRI(?to_form), REPLACE(STR(?to_form), "^.*[#/]", ""), STR(?to_form)), "")) = "Tacit"), false)), false) || COALESCE((COALESCE((COALESCE(?conversion_mode__key, COALESCE(IF(isIRI(?conversion_mode), REPLACE(STR(?conversion_mode), "^.*[#/]", ""), STR(?conversion_mode)), "")) = "Externalization"), false) && COALESCE((COALESCE(?from_form__key, COALESCE(IF(isIRI(?from_form), REPLACE(STR(?from_form), "^.*[#/]", ""), STR(?from_form)), "")) = "Tacit"), false) && COALESCE((COALESCE(?to_form__key, COALESCE(IF(isIRI(?to_form), REPLACE(STR(?to_form), "^.*[#/]", ""), STR(?to_form)), "")) = "Explicit"), false)), false) || COALESCE((COALESCE((COALESCE(?conversion_mode__key, COALESCE(IF(isIRI(?conversion_mode), REPLACE(STR(?conversion_mode), "^.*[#/]", ""), STR(?conversion_mode)), "")) = "Combination"), false) && COALESCE((COALESCE(?from_form__key, COALESCE(IF(isIRI(?from_form), REPLACE(STR(?from_form), "^.*[#/]", ""), STR(?from_form)), "")) = "Explicit"), false) && COALESCE((COALESCE(?to_form__key, COALESCE(IF(isIRI(?to_form), REPLACE(STR(?to_form), "^.*[#/]", ""), STR(?to_form)), "")) = "Explicit"), false)), false) || COALESCE((COALESCE((COALESCE(?conversion_mode__key, COALESCE(IF(isIRI(?conversion_mode), REPLACE(STR(?conversion_mode), "^.*[#/]", ""), STR(?conversion_mode)), "")) = "Internalization"), false) && COALESCE((COALESCE(?from_form__key, COALESCE(IF(isIRI(?from_form), REPLACE(STR(?from_form), "^.*[#/]", ""), STR(?from_form)), "")) = "Explicit"), false) && COALESCE((COALESCE(?to_form__key, COALESCE(IF(isIRI(?to_form), REPLACE(STR(?to_form), "^.*[#/]", ""), STR(?to_form)), "")) = "Tacit"), false)), false)), false))) AS ?_result)
            }
        """ ;
    ] .

# === Rules for KnowledgeDeliverables ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeDeliverables_Name a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeDeliverable ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeDeliverables_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeDeliverable .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:direction ?direction . OPTIONAL { ?direction erb:key ?direction__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:providerEngagement ?provider_engagement . OPTIONAL { ?provider_engagement erb:key ?provider_engagement__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:title ?title . OPTIONAL { ?title erb:key ?title__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?provider_engagement__key, IF(isIRI(?provider_engagement), REPLACE(STR(?provider_engagement), "^.*[#/]", ""), STR(?provider_engagement))), ""), " ", COALESCE(COALESCE(?direction__key, IF(isIRI(?direction), REPLACE(STR(?direction), "^.*[#/]", ""), STR(?direction))), ""), ": ", COALESCE(COALESCE(?title__key, IF(isIRI(?title), REPLACE(STR(?title), "^.*[#/]", ""), STR(?title))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeDeliverables_IsDelivered a sh:NodeShape ;
