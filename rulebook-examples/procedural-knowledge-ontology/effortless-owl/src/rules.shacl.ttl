    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HasNoExceptionHandling" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoExceptionHandling ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:alternativeTransitionCount ?alternative_transition_count . }
    OPTIONAL { $this effortless-ntwf:countOfSteps ?count_of_steps . }
    OPTIONAL { $this effortless-ntwf:exceptionCount ?exception_count . }
    OPTIONAL { $this effortless-ntwf:fallbackTransitionCount ?fallback_transition_count . }
                BIND((COALESCE((COALESCE(?count_of_steps, 0) > 0), false) && COALESCE((COALESCE(?exception_count, 0) = 0), false) && COALESCE((COALESCE(?fallback_transition_count, 0) = 0), false) && COALESCE((COALESCE(?alternative_transition_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_LatestSourceDocumentModifiedAt" ;
        sh:prefixes effortless-ntwf: ;
