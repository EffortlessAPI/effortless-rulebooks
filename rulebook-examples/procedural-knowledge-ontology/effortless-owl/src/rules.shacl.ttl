            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:dangerCueStepKey ?_result .
            }
            WHERE {
    $this a pko-extension:StepCue .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requiresEscalation ?requires_escalation . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . }
                BIND(IF(COALESCE(?requires_escalation, false), ?step, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepCues_IncompleteCueStepKey a sh:NodeShape ;
