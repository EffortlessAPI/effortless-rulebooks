            }
            WHERE {
    $this a pko-extension:CollectedSourceMaterial .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:dependentTraceCount ?dependent_trace_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:encodedIntoVersion ?encoded_into_version . OPTIONAL { ?encoded_into_version erb:key ?encoded_into_version__key . } }
                BIND((COALESCE((COALESCE(?encoded_into_version__key, COALESCE(IF(isIRI(?encoded_into_version), REPLACE(STR(?encoded_into_version), "^.*[#/]", ""), STR(?encoded_into_version)), "")) != ""), false) && COALESCE((COALESCE(?dependent_trace_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CollectedSourceMaterials_ChangedDependentCount a sh:NodeShape ;
    sh:targetClass pko-extension:CollectedSourceMaterial ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_ChangedDependentCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:changedDependentCount ?_result .
            }
            WHERE {
    $this a pko-extension:CollectedSourceMaterial .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:CollectedSourceMaterial .
                    ?child a pko-native-procedural-knowledge-rulebook:KnowledgeTraces .
                    ?child pko-native-procedural-knowledge-rulebook:sourceMaterial $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isSourceChangedSinceTaken ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CollectedSourceMaterials_HasKnowledgeAffectedBySourceChange a sh:NodeShape ;
