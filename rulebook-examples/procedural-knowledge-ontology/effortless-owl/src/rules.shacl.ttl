    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExecutionEntities_IsUsageDirectionMismatch a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ExecutionEntities ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_IsUsageDirectionMismatch" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUsageDirectionMismatch ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ExecutionEntities .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usage ?usage . OPTIONAL { ?usage erb:key ?usage__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:variableDirection ?variable_direction . OPTIONAL { ?variable_direction erb:key ?variable_direction__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?usage__key, COALESCE(IF(isIRI(?usage), REPLACE(STR(?usage), "^.*[#/]", ""), STR(?usage)), "")) = "Used"), false) && COALESCE((COALESCE(?variable_direction__key, COALESCE(IF(isIRI(?variable_direction), REPLACE(STR(?variable_direction), "^.*[#/]", ""), STR(?variable_direction)), "")) != "Input"), false)), false) || COALESCE((COALESCE((COALESCE(?usage__key, COALESCE(IF(isIRI(?usage), REPLACE(STR(?usage), "^.*[#/]", ""), STR(?usage)), "")) = "Generated"), false) && COALESCE((COALESCE(?variable_direction__key, COALESCE(IF(isIRI(?variable_direction), REPLACE(STR(?variable_direction), "^.*[#/]", ""), STR(?variable_direction)), "")) != "Output"), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExecutionEntities_IsForeignVariable a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ExecutionEntities ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_IsForeignVariable" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isForeignVariable ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ExecutionEntities .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:executedStep ?executed_step . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:variableStep ?variable_step . }
                BIND(COALESCE((?variable_step != ?executed_step), !((!BOUND(?variable_step) || STR(?variable_step) = "") && (!BOUND(?executed_step) || STR(?executed_step) = ""))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExecutionEntities_UsedExecutionKey a sh:NodeShape ;
