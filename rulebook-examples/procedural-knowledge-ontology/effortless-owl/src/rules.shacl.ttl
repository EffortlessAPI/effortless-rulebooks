@prefix pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#> .
@prefix pko-native-procedural-knowledge-rulebook-shapes: <https://example.org/pko-native-procedural-knowledge-rulebook/shapes#> .
@prefix erb: <https://effortlessapi.com/ns/erb#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pko: <https://w3id.org/pko#> .
@prefix pko-industry: <https://w3id.org/pko/industry#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pro: <http://purl.org/spar/pro/> .
@prefix nfdi4ing-metadata4ing: <http://w3id.org/nfdi4ing/metadata4ing#> .
@prefix pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#> .

# === Rules for AbundantKnowledgeGaps ===
pko-native-procedural-knowledge-rulebook-shapes:AbundantKnowledgeGaps_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AbundantKnowledgeGap ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AbundantKnowledgeGaps_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AbundantKnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AbundantKnowledgeGaps_RepresentingTableRowCount a sh:NodeShape ;
    sh:targetClass pko-extension:AbundantKnowledgeGap ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AbundantKnowledgeGaps_RepresentingTableRowCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:representingTableRowCount ?_result .
            }
            WHERE {
    $this a pko-extension:AbundantKnowledgeGap .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:representedByTable ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:RulebookTable . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:measuredRowCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for AccessDenialTests ===
pko-native-procedural-knowledge-rulebook-shapes:AccessDenialTests_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AccessDenialTest ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AccessDenialTest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:forbiddenRowId ?forbidden_row_id . OPTIONAL { ?forbidden_row_id erb:key ?forbidden_row_id__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:principal ?principal . OPTIONAL { ?principal erb:key ?principal__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), ""), " must not see ", COALESCE(COALESCE(?forbidden_row_id__key, IF(isIRI(?forbidden_row_id), REPLACE(STR(?forbidden_row_id), "^.*[#/]", ""), STR(?forbidden_row_id))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessDenialTests_HasRun a sh:NodeShape ;
    sh:targetClass pko-extension:AccessDenialTest ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_HasRun" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasRun ?_result .
            }
            WHERE {
    $this a pko-extension:AccessDenialTest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastRunAt ?last_run_at . OPTIONAL { ?last_run_at erb:key ?last_run_at__key . } }
                BIND((COALESCE(?last_run_at__key, COALESCE(IF(isIRI(?last_run_at), REPLACE(STR(?last_run_at), "^.*[#/]", ""), STR(?last_run_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessDenialTests_IsPassing a sh:NodeShape ;
    sh:targetClass pko-extension:AccessDenialTest ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsPassing" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isPassing ?_result .
            }
            WHERE {
    $this a pko-extension:AccessDenialTest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:expectedVisible ?expected_visible . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:observedVisible ?observed_visible . }
                BIND((COALESCE(?observed_visible, false) = COALESCE(?expected_visible, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessDenialTests_IsLeak a sh:NodeShape ;
    sh:targetClass pko-extension:AccessDenialTest ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsLeak" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isLeak ?_result .
            }
            WHERE {
    $this a pko-extension:AccessDenialTest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:expectedVisible ?expected_visible . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:observedVisible ?observed_visible . }
                BIND((COALESCE((!(COALESCE(?expected_visible, false))), false) && COALESCE(?observed_visible, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessDenialTests_IsUnproven a sh:NodeShape ;
    sh:targetClass pko-extension:AccessDenialTest ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsUnproven" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnproven ?_result .
            }
            WHERE {
    $this a pko-extension:AccessDenialTest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasRun ?has_run . }
                BIND((!(COALESCE(?has_run, false))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessDenialTests_IsPositiveControl a sh:NodeShape ;
    sh:targetClass pko-extension:AccessDenialTest ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsPositiveControl" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isPositiveControl ?_result .
            }
            WHERE {
    $this a pko-extension:AccessDenialTest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:expectedVisible ?expected_visible . }
                BIND(?expected_visible AS ?_result)
            }
        """ ;
    ] .

# === Rules for AccessPolicies ===
pko-native-procedural-knowledge-rulebook-shapes:AccessPolicies_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPolicy ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPolicy .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:command ?command . OPTIONAL { ?command erb:key ?command__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:principal ?principal . OPTIONAL { ?principal erb:key ?principal__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetTable ?target_table . OPTIONAL { ?target_table erb:key ?target_table__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), ""), " ", COALESCE(COALESCE(?command__key, IF(isIRI(?command), REPLACE(STR(?command), "^.*[#/]", ""), STR(?command))), ""), " ", COALESCE(COALESCE(?target_table__key, IF(isIRI(?target_table), REPLACE(STR(?target_table), "^.*[#/]", ""), STR(?target_table))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPolicies_IsWriteCommand a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPolicy ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsWriteCommand" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isWriteCommand ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPolicy .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:command ?command . OPTIONAL { ?command erb:key ?command__key . } }
                BIND((COALESCE((COALESCE(?command__key, COALESCE(IF(isIRI(?command), REPLACE(STR(?command), "^.*[#/]", ""), STR(?command)), "")) = "INSERT"), false) || COALESCE((COALESCE(?command__key, COALESCE(IF(isIRI(?command), REPLACE(STR(?command), "^.*[#/]", ""), STR(?command)), "")) = "UPDATE"), false) || COALESCE((COALESCE(?command__key, COALESCE(IF(isIRI(?command), REPLACE(STR(?command), "^.*[#/]", ""), STR(?command)), "")) = "DELETE"), false) || COALESCE((COALESCE(?command__key, COALESCE(IF(isIRI(?command), REPLACE(STR(?command), "^.*[#/]", ""), STR(?command)), "")) = "ALL"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPolicies_IsUnrestricted a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPolicy ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsUnrestricted" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnrestricted ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPolicy .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rowPredicate ?row_predicate . OPTIONAL { ?row_predicate erb:key ?row_predicate__key . } }
                BIND((COALESCE(?row_predicate__key, COALESCE(IF(isIRI(?row_predicate), REPLACE(STR(?row_predicate), "^.*[#/]", ""), STR(?row_predicate)), "")) = "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPolicies_PrincipalIsAdmin a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPolicy ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_PrincipalIsAdmin" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:principalIsAdmin ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPolicy .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:principal ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:AccessPrincipal . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isAdministrator ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPolicies_IsUnrestrictedNonAdminGrant a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPolicy ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsUnrestrictedNonAdminGrant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnrestrictedNonAdminGrant ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPolicy .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isUnrestricted ?is_unrestricted . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:principalIsAdmin ?principal_is_admin . }
                BIND((COALESCE(?is_unrestricted, false) && COALESCE((!(COALESCE(?principal_is_admin, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPolicies_IsUnwitnessedWrite a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPolicy ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsUnwitnessedWrite" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnwitnessedWrite ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPolicy .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:denialTestCount ?denial_test_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isWriteCommand ?is_write_command . }
                BIND((COALESCE(?is_write_command, false) && COALESCE((COALESCE(?denial_test_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPolicies_DenialTestCount a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPolicy ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_DenialTestCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:denialTestCount ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPolicy .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AccessPolicy .
                    ?child a pko-extension:AccessDenialTest .
                    ?child pko-native-procedural-knowledge-rulebook:targetPolicy $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for AccessPrincipals ===
pko-native-procedural-knowledge-rulebook-shapes:AccessPrincipals_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPrincipal ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPrincipal .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPrincipals_OrganizationScope a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPrincipal ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_OrganizationScope" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:organizationScope ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPrincipal .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:domainRole ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:Role . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPrincipals_RoleLabel a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPrincipal ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_RoleLabel" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:roleLabel ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPrincipal .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:domainRole ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:Role . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPrincipals_PolicyCount a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPrincipal ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_PolicyCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:policyCount ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPrincipal .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AccessPrincipal .
                    ?child a pko-extension:AccessPolicy .
                    ?child pko-native-procedural-knowledge-rulebook:principal $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPrincipals_GrantCount a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPrincipal ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_GrantCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:grantCount ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPrincipal .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AccessPrincipal .
                    ?child a pko-extension:FieldGrant .
                    ?child pko-native-procedural-knowledge-rulebook:principal $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPrincipals_VisibleTableCount a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPrincipal ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_VisibleTableCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:visibleTableCount ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPrincipal .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AccessPrincipal .
                    ?child a pko-extension:RoleSchemaView .
                    ?child pko-native-procedural-knowledge-rulebook:principal $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPrincipals_HasNoAccess a sh:NodeShape ;
