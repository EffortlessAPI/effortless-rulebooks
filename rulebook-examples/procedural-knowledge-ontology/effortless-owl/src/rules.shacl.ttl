            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDecided ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decidedAt ?decided_at . OPTIONAL { ?decided_at erb:key ?decided_at__key . } }
                BIND((COALESCE(?decided_at__key, COALESCE(IF(isIRI(?decided_at), REPLACE(STR(?decided_at), "^.*[#/]", ""), STR(?decided_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_AsOfInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_DaysPending a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_DaysPending" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysPending ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decidedAt ?decided_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isDecided ?is_decided . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requestedAt ?requested_at . }
                BIND(ROUND(IF(COALESCE(?is_decided, false), ((DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_IsStillPending a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsStillPending" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isStillPending ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isDecided ?is_decided . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOpen ?is_open . }
                BIND((COALESCE(?is_open, false) && COALESCE((!(COALESCE(?is_decided, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_IsStalled a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsStalled" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isStalled ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysPending ?days_pending . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isStillPending ?is_still_pending . }
                BIND((COALESCE(?is_still_pending, false) && COALESCE((COALESCE(?days_pending, 0) > 14), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_AuthorityAgent a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
