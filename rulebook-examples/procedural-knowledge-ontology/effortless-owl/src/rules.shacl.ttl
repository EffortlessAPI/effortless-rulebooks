            CONSTRUCT {
                $this effortless-ntwf:freshMiningRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcessMiningRuns .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:isStaleMiningEvidence ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = false)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_LacksContinuousDriftDetection" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lacksContinuousDriftDetection ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:executionCount ?execution_count . }
    OPTIONAL { $this effortless-ntwf:freshMiningRunCount ?fresh_mining_run_count . }
    OPTIONAL { $this effortless-ntwf:isCurrent ?is_current . }
                BIND((COALESCE(?is_current, false) && COALESCE((COALESCE(?execution_count, 0) > 0), false) && COALESCE((COALESCE(?fresh_mining_run_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
