        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExpansionConceptFits .
    OPTIONAL { $this effortless-ntwf:conceptLabel ?concept_label . OPTIONAL { ?concept_label effortless-ntwf:__key ?concept_label__key . } }
    OPTIONAL { $this effortless-ntwf:modelExpansionRequest ?model_expansion_request . OPTIONAL { ?model_expansion_request effortless-ntwf:__key ?model_expansion_request__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_expansion_request__key, IF(isIRI(?model_expansion_request), REPLACE(STR(?model_expansion_request), "^.*[#/]", ""), STR(?model_expansion_request))), ""), ": ", COALESCE(COALESCE(?concept_label__key, IF(isIRI(?concept_label), REPLACE(STR(?concept_label), "^.*[#/]", ""), STR(?concept_label))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExpansionConceptFits_IsUncovered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUncovered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExpansionConceptFits .
    OPTIONAL { $this effortless-ntwf:coveringTable ?covering_table . OPTIONAL { ?covering_table effortless-ntwf:__key ?covering_table__key . } }
                BIND((COALESCE(?covering_table__key, COALESCE(IF(isIRI(?covering_table), REPLACE(STR(?covering_table), "^.*[#/]", ""), STR(?covering_table)), "")) = "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ExpectedInferenceChecks ===
effortless-ntwf:ExpectedInferenceChecksShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ExpectedInferenceChecks ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExpectedInferenceChecks_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExpectedInferenceChecks .
    OPTIONAL { $this effortless-ntwf:chainDescription ?chain_description . }
    OPTIONAL { $this effortless-ntwf:changeValidationRun ?change_validation_run . OPTIONAL { ?change_validation_run effortless-ntwf:__key ?change_validation_run__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?change_validation_run__key, IF(isIRI(?change_validation_run), REPLACE(STR(?change_validation_run), "^.*[#/]", ""), STR(?change_validation_run))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?chain_description), 1, 50)), REPLACE(STR(SUBSTR(STR(?chain_description), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?chain_description), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExpectedInferenceChecks_IsUnproduced" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnproduced ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExpectedInferenceChecks .
    OPTIONAL { $this effortless-ntwf:expectedValue ?expected_value . }
    OPTIONAL { $this effortless-ntwf:producedValue ?produced_value . }
                BIND(COALESCE((?produced_value != ?expected_value), !((!BOUND(?produced_value) || STR(?produced_value) = "") && (!BOUND(?expected_value) || STR(?expected_value) = ""))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ExpertCognitions ===
effortless-ntwf:ExpertCognitionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ExpertCognitions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExpertCognitions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExpertCognitions .
    OPTIONAL { $this effortless-ntwf:cognitionKind ?cognition_kind . OPTIONAL { ?cognition_kind effortless-ntwf:__key ?cognition_kind__key . } }
    OPTIONAL { $this effortless-ntwf:statement ?statement . }
                BIND(CONCAT(COALESCE(COALESCE(?cognition_kind__key, IF(isIRI(?cognition_kind), REPLACE(STR(?cognition_kind), "^.*[#/]", ""), STR(?cognition_kind))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?statement), 1, 60)), REPLACE(STR(SUBSTR(STR(?statement), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?statement), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExpertCognitions_IsMentalModel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMentalModel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExpertCognitions .
    OPTIONAL { $this effortless-ntwf:cognitionKind ?cognition_kind . OPTIONAL { ?cognition_kind effortless-ntwf:__key ?cognition_kind__key . } }
                BIND((COALESCE(?cognition_kind__key, COALESCE(IF(isIRI(?cognition_kind), REPLACE(STR(?cognition_kind), "^.*[#/]", ""), STR(?cognition_kind)), "")) = "MentalModel") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExpertCognitions_IsAutomaticHeuristic" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAutomaticHeuristic ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExpertCognitions .
    OPTIONAL { $this effortless-ntwf:appliedAutomatically ?applied_automatically . }
    OPTIONAL { $this effortless-ntwf:cognitionKind ?cognition_kind . OPTIONAL { ?cognition_kind effortless-ntwf:__key ?cognition_kind__key . } }
                BIND((COALESCE((COALESCE(?cognition_kind__key, COALESCE(IF(isIRI(?cognition_kind), REPLACE(STR(?cognition_kind), "^.*[#/]", ""), STR(?cognition_kind)), "")) = "DecisionHeuristic"), false) && COALESCE(?applied_automatically, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExpertCognitions_IsHeuristicOversimplified" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isHeuristicOversimplified ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExpertCognitions .
    OPTIONAL { $this effortless-ntwf:capturedExceptions ?captured_exceptions . OPTIONAL { ?captured_exceptions effortless-ntwf:__key ?captured_exceptions__key . } }
    OPTIONAL { $this effortless-ntwf:cognitionKind ?cognition_kind . OPTIONAL { ?cognition_kind effortless-ntwf:__key ?cognition_kind__key . } }
    OPTIONAL { $this effortless-ntwf:expertStatedExceptions ?expert_stated_exceptions . }
                BIND((COALESCE((COALESCE(?cognition_kind__key, COALESCE(IF(isIRI(?cognition_kind), REPLACE(STR(?cognition_kind), "^.*[#/]", ""), STR(?cognition_kind)), "")) = "DecisionHeuristic"), false) && COALESCE(?expert_stated_exceptions, false) && COALESCE((COALESCE(?captured_exceptions__key, COALESCE(IF(isIRI(?captured_exceptions), REPLACE(STR(?captured_exceptions), "^.*[#/]", ""), STR(?captured_exceptions)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Explanations ===
effortless-ntwf:ExplanationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Explanations ;
    sh:rule [
