                $this effortless-ntwf:missedNextDependentRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignmentUpdateTasks .
    OPTIONAL { $this effortless-ntwf:completedAt ?completed_at . OPTIONAL { ?completed_at effortless-ntwf:__key ?completed_at__key . } }
    OPTIONAL { $this effortless-ntwf:dependentRunRoleStepCount ?dependent_run_role_step_count . }
    OPTIONAL { $this effortless-ntwf:dependentRunStartedAt ?dependent_run_started_at . }
    OPTIONAL { $this effortless-ntwf:triggerOccurredAt ?trigger_occurred_at . }
                BIND((COALESCE((COALESCE(?dependent_run_role_step_count, 0) > 0), false) && COALESCE(COALESCE((?dependent_run_started_at > ?trigger_occurred_at), false), false) && COALESCE((COALESCE((COALESCE(?completed_at__key, COALESCE(IF(isIRI(?completed_at), REPLACE(STR(?completed_at), "^.*[#/]", ""), STR(?completed_at)), "")) = ""), false) || COALESCE(COALESCE((?completed_at > ?dependent_run_started_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
