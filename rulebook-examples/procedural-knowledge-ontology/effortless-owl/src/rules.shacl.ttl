        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_WordingKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:wordingKey ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:termScheme ?term_scheme . OPTIONAL { ?term_scheme erb:key ?term_scheme__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wording ?wording . OPTIONAL { ?wording erb:key ?wording__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?term_scheme__key, IF(isIRI(?term_scheme), REPLACE(STR(?term_scheme), "^.*[#/]", ""), STR(?term_scheme))), ""), "|", COALESCE(COALESCE(?wording__key, IF(isIRI(?wording), REPLACE(STR(?wording), "^.*[#/]", ""), STR(?wording))), "")) AS ?_result)
            }
        """ ;
    ] .
