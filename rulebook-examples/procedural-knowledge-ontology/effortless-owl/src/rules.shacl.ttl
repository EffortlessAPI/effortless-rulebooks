            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeTraces .
    OPTIONAL { $this effortless-ntwf:sourceMaterial ?source_material . OPTIONAL { ?source_material effortless-ntwf:__key ?source_material__key . } }
    OPTIONAL { $this effortless-ntwf:targetKind ?target_kind . OPTIONAL { ?target_kind effortless-ntwf:__key ?target_kind__key . } }
    OPTIONAL { $this effortless-ntwf:traceRole ?trace_role . OPTIONAL { ?trace_role effortless-ntwf:__key ?trace_role__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?target_kind__key, IF(isIRI(?target_kind), REPLACE(STR(?target_kind), "^.*[#/]", ""), STR(?target_kind))), ""), " <- ", COALESCE(COALESCE(?source_material__key, IF(isIRI(?source_material), REPLACE(STR(?source_material), "^.*[#/]", ""), STR(?source_material))), ""), " (", COALESCE(COALESCE(?trace_role__key, IF(isIRI(?trace_role), REPLACE(STR(?trace_role), "^.*[#/]", ""), STR(?trace_role))), ""), ")") AS ?_result)
            }
