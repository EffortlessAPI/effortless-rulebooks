    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_StepWhenBlocking" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:stepWhenBlocking ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepRequirements .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requirementIsBlocking ?requirement_is_blocking . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . }
                BIND(IF(COALESCE(?requirement_is_blocking, false), ?step, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepRequirements_RequirementLacksWitness a sh:NodeShape ;
