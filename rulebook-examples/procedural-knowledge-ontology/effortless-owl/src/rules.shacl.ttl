pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_OverrideRatePercent a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_OverrideRatePercent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:overrideRatePercent ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decisionCount ?decision_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:overriddenDecisionCount ?overridden_decision_count . }
                BIND(IF(COALESCE((COALESCE(?decision_count, 0) = 0), false), 0, xsd:double((?overridden_decision_count * 100) / ?decision_count)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_PredecessorOverrideRatePercent a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
