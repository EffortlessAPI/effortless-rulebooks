            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOverPrivileged ?_result .
            }
            WHERE {
    $this a pko-extension:AccessPrincipal .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAdministrator ?is_administrator . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:visibleTableCount ?visible_table_count . }
                BIND((COALESCE((!(COALESCE(?is_administrator, false))), false) && COALESCE((COALESCE(?visible_table_count, 0) >= 74), false)) AS ?_result)
            }
        """ ;
    ] .

