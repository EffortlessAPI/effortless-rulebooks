                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:entryStepKey ?sumraw . }
                    BIND(STR(?sumraw) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ExecutionCount" ;
