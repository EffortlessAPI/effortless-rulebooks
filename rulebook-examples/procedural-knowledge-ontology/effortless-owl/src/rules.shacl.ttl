    $this a pko-extension:ModelChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:disjointnessCheckCount ?disjointness_check_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAccepted ?is_accepted . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isSchemaChange ?is_schema_change . }
                BIND((COALESCE(?is_accepted, false) && COALESCE(?is_schema_change, false) && COALESCE((COALESCE(?disjointness_check_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
