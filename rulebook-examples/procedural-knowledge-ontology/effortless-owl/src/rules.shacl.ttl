    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:consistencyCheckOutcome ?consistency_check_outcome . OPTIONAL { ?consistency_check_outcome erb:key ?consistency_check_outcome__key . } }
                BIND((COALESCE(?consistency_check_outcome__key, COALESCE(IF(isIRI(?consistency_check_outcome), REPLACE(STR(?consistency_check_outcome), "^.*[#/]", ""), STR(?consistency_check_outcome)), "")) != "Consistent") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeValidationRuns_MissesExpectedInference a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeValidationRun ;
