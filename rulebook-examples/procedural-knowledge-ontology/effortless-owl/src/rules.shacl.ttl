                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isUnrestrictedNonAdminGrant ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:principalIsAdmin ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER(BOUND(?c2) && ?c2 = false)
                    FILTER(BOUND(?c4) && ?c4 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
