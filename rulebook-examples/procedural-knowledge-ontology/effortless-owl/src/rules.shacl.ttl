                        $this a pko-extension:ConformanceSubstrate .
                    ?child a pko-extension:SubstrateRunScore .
                    ?child pko-native-procedural-knowledge-rulebook:substrate $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:latestCellsPassed ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
