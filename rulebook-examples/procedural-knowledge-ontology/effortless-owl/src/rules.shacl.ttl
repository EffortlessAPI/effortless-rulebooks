            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:derivedHasComputedWitness ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:claimsAWitnessField ?claims_a_witness_field . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:namedWitnessFieldExists ?named_witness_field_exists . }
                BIND((COALESCE(?claims_a_witness_field, false) && COALESCE(?named_witness_field_exists, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_WitnessClaimIsUnverified a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
