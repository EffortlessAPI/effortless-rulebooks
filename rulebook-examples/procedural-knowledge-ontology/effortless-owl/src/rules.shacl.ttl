            }
            WHERE {
    $this a pko-extension:CollectedSourceMaterial .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:changedDependentCount ?changed_dependent_count . }
                BIND((COALESCE(?changed_dependent_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for CollectionOccasions ===
pko-native-procedural-knowledge-rulebook-shapes:CollectionOccasions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:CollectionOccasion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectionOccasions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:CollectionOccasion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . OPTIONAL { ?label erb:key ?label__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:occasionKind ?occasion_kind . OPTIONAL { ?occasion_kind erb:key ?occasion_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?occasion_kind__key, IF(isIRI(?occasion_kind), REPLACE(STR(?occasion_kind), "^.*[#/]", ""), STR(?occasion_kind))), ""), ": ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CollectionOccasions_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-extension:CollectionOccasion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectionOccasions_AsOfInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-extension:CollectionOccasion .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CollectionOccasions_DaysSinceHeld a sh:NodeShape ;
    sh:targetClass pko-extension:CollectionOccasion ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectionOccasions_DaysSinceHeld" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceHeld ?_result .
            }
            WHERE {
    $this a pko-extension:CollectionOccasion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastHeldAt ?last_held_at . OPTIONAL { ?last_held_at erb:key ?last_held_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?last_held_at__key, COALESCE(IF(isIRI(?last_held_at), REPLACE(STR(?last_held_at), "^.*[#/]", ""), STR(?last_held_at)), "")) = ""), false), 0, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_held_at) + FLOOR((153 * (MONTH(?last_held_at) + 12 * FLOOR((14 - MONTH(?last_held_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_held_at) + 4800 - FLOOR((14 - MONTH(?last_held_at)) / 12)) + FLOOR((YEAR(?last_held_at) + 4800 - FLOOR((14 - MONTH(?last_held_at)) / 12)) / 4) - FLOOR((YEAR(?last_held_at) + 4800 - FLOOR((14 - MONTH(?last_held_at)) / 12)) / 100) + FLOOR((YEAR(?last_held_at) + 4800 - FLOOR((14 - MONTH(?last_held_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CollectionOccasions_IsLapsed a sh:NodeShape ;
    sh:targetClass pko-extension:CollectionOccasion ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectionOccasions_IsLapsed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isLapsed ?_result .
            }
            WHERE {
    $this a pko-extension:CollectionOccasion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cadenceDays ?cadence_days . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceHeld ?days_since_held . }
                BIND((COALESCE(?days_since_held, 0) > COALESCE(?cadence_days, 0)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CollectionOccasions_CapturedMaterialCount a sh:NodeShape ;
    sh:targetClass pko-extension:CollectionOccasion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectionOccasions_CapturedMaterialCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:capturedMaterialCount ?_result .
            }
            WHERE {
    $this a pko-extension:CollectionOccasion .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:CollectionOccasion .
                    ?child a pko-extension:CollectedSourceMaterial .
                    ?child pko-native-procedural-knowledge-rulebook:collectedAtOccasion $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CollectionOccasions_IsHeldWithoutCapture a sh:NodeShape ;
    sh:targetClass pko-extension:CollectionOccasion ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectionOccasions_IsHeldWithoutCapture" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isHeldWithoutCapture ?_result .
            }
            WHERE {
    $this a pko-extension:CollectionOccasion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:capturedMaterialCount ?captured_material_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastHeldAt ?last_held_at . OPTIONAL { ?last_held_at erb:key ?last_held_at__key . } }
                BIND((COALESCE((COALESCE(?last_held_at__key, COALESCE(IF(isIRI(?last_held_at), REPLACE(STR(?last_held_at), "^.*[#/]", ""), STR(?last_held_at)), "")) != ""), false) && COALESCE((COALESCE(?captured_material_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for CommunicationPolicies ===
pko-native-procedural-knowledge-rulebook-shapes:CommunicationPolicies_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:CommunicationPolicies ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:CommunicationPolicies .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:channel ?channel . OPTIONAL { ?channel erb:key ?channel__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version erb:key ?procedure_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?channel__key, IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel))), ""), " policy / ", COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CommunicationPolicies_ConsentViolationCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:CommunicationPolicies ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_ConsentViolationCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:consentViolationCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:CommunicationPolicies .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:CommunicationPolicies .
                    ?child a pko-extension:MessageDelivery .
                    ?child pko-native-procedural-knowledge-rulebook:policyChannel ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:communicationPolicyId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isConsentViolation ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CommunicationPolicies_QuietHoursViolationCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:CommunicationPolicies ;
