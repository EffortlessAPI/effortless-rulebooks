pko-native-procedural-knowledge-rulebook-shapes:Vocabularies_IsFrozenDespiteNewCollection a sh:NodeShape ;
    sh:targetClass pko-extension:Vocabulary ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_IsFrozenDespiteNewCollection" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFrozenDespiteNewCollection ?_result .
            }
            WHERE {
    $this a pko-extension:Vocabulary .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:establishedAt ?established_at . OPTIONAL { ?established_at erb:key ?established_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:latestOrganizedMaterialAt ?latest_organized_material_at . OPTIONAL { ?latest_organized_material_at erb:key ?latest_organized_material_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:refinementCount ?refinement_count . }
                BIND((COALESCE((COALESCE(?established_at__key, COALESCE(IF(isIRI(?established_at), REPLACE(STR(?established_at), "^.*[#/]", ""), STR(?established_at)), "")) != ""), false) && COALESCE((COALESCE(?latest_organized_material_at__key, COALESCE(IF(isIRI(?latest_organized_material_at), REPLACE(STR(?latest_organized_material_at), "^.*[#/]", ""), STR(?latest_organized_material_at)), "")) != ""), false) && COALESCE(COALESCE((?latest_organized_material_at > ?established_at), false), false) && COALESCE((COALESCE(?refinement_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Vocabularies_OntologyPrecededVocabularyControl a sh:NodeShape ;
