        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:StepCondition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conditionKind ?condition_kind . OPTIONAL { ?condition_kind erb:key ?condition_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " ", COALESCE(COALESCE(?condition_kind__key, IF(isIRI(?condition_kind), REPLACE(STR(?condition_kind), "^.*[#/]", ""), STR(?condition_kind))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepConditions_CheckCount a sh:NodeShape ;
    sh:targetClass pko-extension:StepCondition ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepConditions_CheckCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:checkCount ?_result .
            }
            WHERE {
    $this a pko-extension:StepCondition .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:StepCondition .
                    ?child a pko-extension:ConditionCheck .
                    ?child pko-native-procedural-knowledge-rulebook:stepCondition $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepConditions_IsNeverChecked a sh:NodeShape ;
