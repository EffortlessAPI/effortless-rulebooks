pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_IsNeverExercised a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsNeverExercised" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isNeverExercised ?_result .
            }
            WHERE {
    $this a pko:Transition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasReachableOrigin ?has_reachable_origin . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasReachableTarget ?has_reachable_target . }
                BIND((!(COALESCE((COALESCE(?has_reachable_origin, false) && COALESCE(?has_reachable_target, false)), false))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_IsUntestedRecoveryPath a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
