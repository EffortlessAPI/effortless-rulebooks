            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:machineConsumedUnapprovedVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isUnapprovedAndMachineConsumed ?is_unapproved_and_machine_consumed . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_unapproved_and_machine_consumed, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_HasReviewRecord" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasReviewRecord ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:lastReviewedAt ?last_reviewed_at . OPTIONAL { ?last_reviewed_at effortless-ntwf:__key ?last_reviewed_at__key . } }
                BIND((COALESCE(?last_reviewed_at__key, COALESCE(IF(isIRI(?last_reviewed_at), REPLACE(STR(?last_reviewed_at), "^.*[#/]", ""), STR(?last_reviewed_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_DaysSinceActualReview" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceActualReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:hasReviewRecord ?has_review_record . }
    OPTIONAL { $this effortless-ntwf:lastReviewedAt ?last_reviewed_at . }
                BIND(ROUND(IF(COALESCE(?has_review_record, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_reviewed_at) + FLOOR((153 * (MONTH(?last_reviewed_at) + 12 * FLOOR((14 - MONTH(?last_reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) + FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsUnreviewedSinceAuthoring" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnreviewedSinceAuthoring ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:hasReviewRecord ?has_review_record . }
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
                BIND((COALESCE(?is_currently_valid, false) && COALESCE((!(COALESCE(?has_review_record, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsGenuinelyOverdue" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isGenuinelyOverdue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:daysSinceActualReview ?days_since_actual_review . }
    OPTIONAL { $this effortless-ntwf:hasReviewRecord ?has_review_record . }
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this effortless-ntwf:reviewCadenceDays ?review_cadence_days . }
                BIND((COALESCE(?is_currently_valid, false) && COALESCE(?has_review_record, false) && COALESCE((COALESCE(?days_since_actual_review, 0) > COALESCE(?review_cadence_days, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_ReviewRecencyIsInferred" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reviewRecencyIsInferred ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:hasReviewRecord ?has_review_record . }
    OPTIONAL { $this effortless-ntwf:isOverdueForReview ?is_overdue_for_review . }
                BIND((COALESCE(?is_overdue_for_review, false) && COALESCE((!(COALESCE(?has_review_record, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_InferenceDisagreesWithRecord" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:inferenceDisagreesWithRecord ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:hasReviewRecord ?has_review_record . }
    OPTIONAL { $this effortless-ntwf:isGenuinelyOverdue ?is_genuinely_overdue . }
    OPTIONAL { $this effortless-ntwf:isOverdueForReview ?is_overdue_for_review . }
                BIND((COALESCE(?has_review_record, false) && COALESCE(?is_overdue_for_review, false) && COALESCE((!(COALESCE(?is_genuinely_overdue, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_GenuinelyOverdueVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:genuinelyOverdueVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isGenuinelyOverdue ?is_genuinely_overdue . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_genuinely_overdue, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_RatifiedBoundaryCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratifiedBoundaryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AuthorityBoundaries .
                    ?child effortless-ntwf:ratifyingFragmentKey ?backfk .
                    $this effortless-ntwf:knowledgeFragmentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_RelianceSurfaceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:relianceSurfaceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isInvokedByAnException ?is_invoked_by_an_exception . }
    OPTIONAL { $this effortless-ntwf:ratifiedBoundaryCount ?ratified_boundary_count . }
                BIND(ROUND((?is_invoked_by_an_exception + ?ratified_boundary_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_DaysAwaitingMyApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysAwaitingMyApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:isMyUnfinishedApproval ?is_my_unfinished_approval . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
                BIND(ROUND(IF(COALESCE(?is_my_unfinished_approval, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?valid_from) + FLOOR((153 * (MONTH(?valid_from) + 12 * FLOOR((14 - MONTH(?valid_from)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 4) - FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 100) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsHighBlastRadiusUnapproved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isHighBlastRadiusUnapproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isUnapprovedAndOperationallyLive ?is_unapproved_and_operationally_live . }
    OPTIONAL { $this effortless-ntwf:relianceSurfaceCount ?reliance_surface_count . }
                BIND((COALESCE(?is_unapproved_and_operationally_live, false) && COALESCE((COALESCE(?reliance_surface_count, 0) > 1), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsLongUnapproved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLongUnapproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:daysAwaitingMyApproval ?days_awaiting_my_approval . }
    OPTIONAL { $this effortless-ntwf:isMyUnfinishedApproval ?is_my_unfinished_approval . }
                BIND((COALESCE(?is_my_unfinished_approval, false) && COALESCE((COALESCE(?days_awaiting_my_approval, 0) > 30), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_UnapprovedLoadBearingVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unapprovedLoadBearingVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isHighBlastRadiusUnapproved ?is_high_blast_radius_unapproved . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_high_blast_radius_unapproved, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_OwnerRoleIsVacated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ownerRoleIsVacated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:ownerRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isVacatedRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsOrphanedByRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOrphanedByRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this effortless-ntwf:ownerRoleIsVacated ?owner_role_is_vacated . }
                BIND((COALESCE(?is_currently_valid, false) && COALESCE(?owner_role_is_vacated, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_ValidFragmentVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:validFragmentVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_currently_valid, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsFlattenedToBrittleRule" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFlattenedToBrittleRule ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:encodedAs ?encoded_as . OPTIONAL { ?encoded_as effortless-ntwf:__key ?encoded_as__key . } }
    OPTIONAL { $this effortless-ntwf:knowledgeForm ?knowledge_form . OPTIONAL { ?knowledge_form effortless-ntwf:__key ?knowledge_form__key . } }
    OPTIONAL { $this effortless-ntwf:statedConditions ?stated_conditions . OPTIONAL { ?stated_conditions effortless-ntwf:__key ?stated_conditions__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?knowledge_form__key, COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), "")) = "Tacit"), false) || COALESCE((COALESCE(?knowledge_form__key, COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), "")) = "SituatedJudgment"), false)), false) && COALESCE((COALESCE(?encoded_as__key, COALESCE(IF(isIRI(?encoded_as), REPLACE(STR(?encoded_as), "^.*[#/]", ""), STR(?encoded_as)), "")) = "HardRule"), false) && COALESCE((COALESCE(?stated_conditions__key, COALESCE(IF(isIRI(?stated_conditions), REPLACE(STR(?stated_conditions), "^.*[#/]", ""), STR(?stated_conditions)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_CorroborationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:corroborationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FragmentCorroborations .
                    ?child effortless-ntwf:knowledgeFragment $this .
                    OPTIONAL { ?child effortless-ntwf:agrees ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_RestsOnSingleDataPoint" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:restsOnSingleDataPoint ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:corroborationCount ?corroboration_count . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) && COALESCE((COALESCE(?corroboration_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeGaps ===
effortless-ntwf:KnowledgeGapsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeGaps ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:severity ?severity . OPTIONAL { ?severity effortless-ntwf:__key ?severity__key . } }
    OPTIONAL { $this effortless-ntwf:statement ?statement . }
                BIND(CONCAT(COALESCE(COALESCE(?severity__key, IF(isIRI(?severity), REPLACE(STR(?severity), "^.*[#/]", ""), STR(?severity))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?statement), 1, 60)), REPLACE(STR(SUBSTR(STR(?statement), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?statement), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsOpen" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOpen ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Open"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Investigating"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OpenGapVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:openGapVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:isOpen ?is_open . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
    OPTIONAL { $this effortless-ntwf:severity ?severity . OPTIONAL { ?severity effortless-ntwf:__key ?severity__key . } }
                BIND(IF(COALESCE((COALESCE(?is_open, false) && COALESCE((COALESCE(?severity__key, COALESCE(IF(isIRI(?severity), REPLACE(STR(?severity), "^.*[#/]", ""), STR(?severity)), "")) = "High"), false)), false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsBlocking" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:blockingKind ?blocking_kind . OPTIONAL { ?blocking_kind effortless-ntwf:__key ?blocking_kind__key . } }
                BIND((COALESCE(?blocking_kind__key, COALESCE(IF(isIRI(?blocking_kind), REPLACE(STR(?blocking_kind), "^.*[#/]", ""), STR(?blocking_kind)), "")) = "Blocking") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsOpenAndBlocking" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOpenAndBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
    OPTIONAL { $this effortless-ntwf:isOpen ?is_open . }
                BIND((COALESCE(?is_open, false) && COALESCE(?is_blocking, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_DaysOpen" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysOpen ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:identifiedAt ?identified_at . }
    OPTIONAL { $this effortless-ntwf:isOpen ?is_open . }
                BIND(ROUND(IF(COALESCE(?is_open, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?identified_at) + FLOOR((153 * (MONTH(?identified_at) + 12 * FLOOR((14 - MONTH(?identified_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) + FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 4) - FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 100) + FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_ToleranceDays" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:toleranceDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:severity ?severity . OPTIONAL { ?severity effortless-ntwf:__key ?severity__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?severity__key, COALESCE(IF(isIRI(?severity), REPLACE(STR(?severity), "^.*[#/]", ""), STR(?severity)), "")) = "High"), false), 30, IF(COALESCE((COALESCE(?severity__key, COALESCE(IF(isIRI(?severity), REPLACE(STR(?severity), "^.*[#/]", ""), STR(?severity)), "")) = "Medium"), false), 90, 180))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsOverdueGap" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOverdueGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:daysOpen ?days_open . }
    OPTIONAL { $this effortless-ntwf:toleranceDays ?tolerance_days . }
                BIND((COALESCE(?days_open, 0) > COALESCE(?tolerance_days, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OwnerAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ownerAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
                OPTIONAL { $this effortless-ntwf:ownerRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:currentAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OwnerIsStillEngaged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ownerIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
                OPTIONAL { $this effortless-ntwf:ownerAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isStillEngaged ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_HasResolutionPlan" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasResolutionPlan ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:resolutionPlan ?resolution_plan . OPTIONAL { ?resolution_plan effortless-ntwf:__key ?resolution_plan__key . } }
                BIND((COALESCE(?resolution_plan__key, COALESCE(IF(isIRI(?resolution_plan), REPLACE(STR(?resolution_plan), "^.*[#/]", ""), STR(?resolution_plan)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsAbandonedUnknown" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAbandonedUnknown ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:hasResolutionPlan ?has_resolution_plan . }
    OPTIONAL { $this effortless-ntwf:isOverdueGap ?is_overdue_gap . }
    OPTIONAL { $this effortless-ntwf:ownerIsStillEngaged ?owner_is_still_engaged . }
                BIND((COALESCE(?is_overdue_gap, false) && COALESCE((COALESCE((!(COALESCE(?has_resolution_plan, false))), false) || COALESCE((!(COALESCE(?owner_is_still_engaged, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OpenBlockingGapVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:openBlockingGapVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:isOpenAndBlocking ?is_open_and_blocking . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_open_and_blocking, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OwnerRoleIsVacated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ownerRoleIsVacated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
                OPTIONAL { $this effortless-ntwf:ownerRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isVacatedRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsOwnerlessOpenGap" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOwnerlessOpenGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:isOpen ?is_open . }
    OPTIONAL { $this effortless-ntwf:ownerRoleIsVacated ?owner_role_is_vacated . }
                BIND((COALESCE(?is_open, false) && COALESCE(?owner_role_is_vacated, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsKnownAndUnresolved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isKnownAndUnresolved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:identifiedAt ?identified_at . OPTIONAL { ?identified_at effortless-ntwf:__key ?identified_at__key . } }
    OPTIONAL { $this effortless-ntwf:isOpen ?is_open . }
                BIND((COALESCE((COALESCE(?identified_at__key, COALESCE(IF(isIRI(?identified_at), REPLACE(STR(?identified_at), "^.*[#/]", ""), STR(?identified_at)), "")) != ""), false) && COALESCE(?is_open, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsGatekeepingOrSabotage" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isGatekeepingOrSabotage ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:gapCause ?gap_cause . OPTIONAL { ?gap_cause effortless-ntwf:__key ?gap_cause__key . } }
                BIND((COALESCE((COALESCE(?gap_cause__key, COALESCE(IF(isIRI(?gap_cause), REPLACE(STR(?gap_cause), "^.*[#/]", ""), STR(?gap_cause)), "")) = "Gatekeeping"), false) || COALESCE((COALESCE(?gap_cause__key, COALESCE(IF(isIRI(?gap_cause), REPLACE(STR(?gap_cause), "^.*[#/]", ""), STR(?gap_cause)), "")) = "Sabotage"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsUnattributedGatekeeping" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnattributedGatekeeping ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:holderDeclinedToShare ?holder_declined_to_share . }
    OPTIONAL { $this effortless-ntwf:isGatekeepingOrSabotage ?is_gatekeeping_or_sabotage . }
                BIND((COALESCE(?holder_declined_to_share, false) && COALESCE((!(COALESCE(?is_gatekeeping_or_sabotage, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsRequiredGatekeptUncodified" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRequiredGatekeptUncodified ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:blockingKind ?blocking_kind . OPTIONAL { ?blocking_kind effortless-ntwf:__key ?blocking_kind__key . } }
    OPTIONAL { $this effortless-ntwf:codifiedAsFragment ?codified_as_fragment . OPTIONAL { ?codified_as_fragment effortless-ntwf:__key ?codified_as_fragment__key . } }
    OPTIONAL { $this effortless-ntwf:isGatekeepingOrSabotage ?is_gatekeeping_or_sabotage . }
                BIND((COALESCE(?is_gatekeeping_or_sabotage, false) && COALESCE((COALESCE(?blocking_kind__key, COALESCE(IF(isIRI(?blocking_kind), REPLACE(STR(?blocking_kind), "^.*[#/]", ""), STR(?blocking_kind)), "")) = "Blocking"), false) && COALESCE((COALESCE(?codified_as_fragment__key, COALESCE(IF(isIRI(?codified_as_fragment), REPLACE(STR(?codified_as_fragment), "^.*[#/]", ""), STR(?codified_as_fragment)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeHoldings ===
effortless-ntwf:KnowledgeHoldingsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeHoldings ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeHoldings_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeHoldings .
    OPTIONAL { $this effortless-ntwf:carrier ?carrier . OPTIONAL { ?carrier effortless-ntwf:__key ?carrier__key . } }
    OPTIONAL { $this effortless-ntwf:snapshot ?snapshot . OPTIONAL { ?snapshot effortless-ntwf:__key ?snapshot__key . } }
    OPTIONAL { $this effortless-ntwf:statement ?statement . }
                BIND(CONCAT(COALESCE(COALESCE(?snapshot__key, IF(isIRI(?snapshot), REPLACE(STR(?snapshot), "^.*[#/]", ""), STR(?snapshot))), ""), " ", COALESCE(COALESCE(?carrier__key, IF(isIRI(?carrier), REPLACE(STR(?carrier), "^.*[#/]", ""), STR(?carrier))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?statement), 1, 50)), REPLACE(STR(SUBSTR(STR(?statement), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?statement), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeHoldings_FormalizedFragmentSession" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:formalizedFragmentSession ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeHoldings .
                OPTIONAL { $this effortless-ntwf:formalizedAs ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:elicitationSession ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeHoldings_IsUnformalizedProcessKnowledge" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnformalizedProcessKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeHoldings .
    OPTIONAL { $this effortless-ntwf:carrier ?carrier . OPTIONAL { ?carrier effortless-ntwf:__key ?carrier__key . } }
    OPTIONAL { $this effortless-ntwf:formalizedAs ?formalized_as . OPTIONAL { ?formalized_as effortless-ntwf:__key ?formalized_as__key . } }
                BIND((COALESCE((COALESCE(?formalized_as__key, COALESCE(IF(isIRI(?formalized_as), REPLACE(STR(?formalized_as), "^.*[#/]", ""), STR(?formalized_as)), "")) = ""), false) && COALESCE((COALESCE(?carrier__key, COALESCE(IF(isIRI(?carrier), REPLACE(STR(?carrier), "^.*[#/]", ""), STR(?carrier)), "")) != "ProcedureRulebook"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeHoldings_IsProceduralKnowledge" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isProceduralKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeHoldings .
    OPTIONAL { $this effortless-ntwf:formalizedAs ?formalized_as . OPTIONAL { ?formalized_as effortless-ntwf:__key ?formalized_as__key . } }
                BIND((COALESCE(?formalized_as__key, COALESCE(IF(isIRI(?formalized_as), REPLACE(STR(?formalized_as), "^.*[#/]", ""), STR(?formalized_as)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeHoldings_IsJudgmentOutsideDocument" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isJudgmentOutsideDocument ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeHoldings .
    OPTIONAL { $this effortless-ntwf:isUnformalizedProcessKnowledge ?is_unformalized_process_knowledge . }
    OPTIONAL { $this effortless-ntwf:isUnsaidInSop ?is_unsaid_in_sop . }
                BIND((COALESCE(?is_unsaid_in_sop, false) && COALESCE(?is_unformalized_process_knowledge, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeHoldings_IsVeteranDiscretion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isVeteranDiscretion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeHoldings .
    OPTIONAL { $this effortless-ntwf:handlesExceptionOrDiscretion ?handles_exception_or_discretion . }
    OPTIONAL { $this effortless-ntwf:holderIsVeteran ?holder_is_veteran . }
    OPTIONAL { $this effortless-ntwf:isUnformalizedProcessKnowledge ?is_unformalized_process_knowledge . }
                BIND((COALESCE(?holder_is_veteran, false) && COALESCE(?handles_exception_or_discretion, false) && COALESCE(?is_unformalized_process_knowledge, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeHoldings_IsFormalizedWithoutElicitationWork" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFormalizedWithoutElicitationWork ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeHoldings .
    OPTIONAL { $this effortless-ntwf:formalizedAs ?formalized_as . OPTIONAL { ?formalized_as effortless-ntwf:__key ?formalized_as__key . } }
    OPTIONAL { $this effortless-ntwf:formalizedFragmentSession ?formalized_fragment_session . OPTIONAL { ?formalized_fragment_session effortless-ntwf:__key ?formalized_fragment_session__key . } }
                BIND((COALESCE((COALESCE(?formalized_as__key, COALESCE(IF(isIRI(?formalized_as), REPLACE(STR(?formalized_as), "^.*[#/]", ""), STR(?formalized_as)), "")) != ""), false) && COALESCE((COALESCE(?formalized_fragment_session__key, COALESCE(IF(isIRI(?formalized_fragment_session), REPLACE(STR(?formalized_fragment_session), "^.*[#/]", ""), STR(?formalized_fragment_session)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeMethods ===
effortless-ntwf:KnowledgeMethodsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeMethods ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeMethods_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeMethods .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeMethods_ElicitationUseCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:elicitationUseCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeMethods .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ElicitationSessions .
                    ?child effortless-ntwf:method $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeMethods_ApplicationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:applicationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeMethods .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MethodApplications .
                    ?child effortless-ntwf:knowledgeMethod $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeMethods_UsageCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:usageCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeMethods .
    OPTIONAL { $this effortless-ntwf:applicationCount ?application_count . }
    OPTIONAL { $this effortless-ntwf:elicitationUseCount ?elicitation_use_count . }
                BIND(ROUND((?elicitation_use_count + ?application_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeMethods_IsApplied" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isApplied ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeMethods .
    OPTIONAL { $this effortless-ntwf:usageCount ?usage_count . }
                BIND((COALESCE(?usage_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeOutcomeMeasurements ===
effortless-ntwf:KnowledgeOutcomeMeasurementsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeOutcomeMeasurements ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeOutcomeMeasurements .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_BaselineAccessScore" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:baselineAccessScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeOutcomeMeasurements .
                OPTIONAL { $this effortless-ntwf:comparisonBaseline ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeOutcomeMeasurements ; effortless-ntwf:knowledgeOutcomeMeasurementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:knowledgeAccessScore ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_BaselineErrorRate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:baselineErrorRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeOutcomeMeasurements .
                OPTIONAL { $this effortless-ntwf:comparisonBaseline ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeOutcomeMeasurements ; effortless-ntwf:knowledgeOutcomeMeasurementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:errorRatePercent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_BaselineMinutesPerRun" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:baselineMinutesPerRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeOutcomeMeasurements .
                OPTIONAL { $this effortless-ntwf:comparisonBaseline ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeOutcomeMeasurements ; effortless-ntwf:knowledgeOutcomeMeasurementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:minutesPerRun ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_BaselineSatisfaction" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:baselineSatisfaction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeOutcomeMeasurements .
                OPTIONAL { $this effortless-ntwf:comparisonBaseline ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeOutcomeMeasurements ; effortless-ntwf:knowledgeOutcomeMeasurementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:satisfactionScore ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_HigherAccessFewerErrors" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:higherAccessFewerErrors ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeOutcomeMeasurements .
    OPTIONAL { $this effortless-ntwf:baselineAccessScore ?baseline_access_score . }
    OPTIONAL { $this effortless-ntwf:baselineErrorRate ?baseline_error_rate . }
    OPTIONAL { $this effortless-ntwf:comparisonBaseline ?comparison_baseline . OPTIONAL { ?comparison_baseline effortless-ntwf:__key ?comparison_baseline__key . } }
    OPTIONAL { $this effortless-ntwf:errorRatePercent ?error_rate_percent . }
    OPTIONAL { $this effortless-ntwf:knowledgeAccessScore ?knowledge_access_score . }
                BIND((COALESCE((COALESCE(?comparison_baseline__key, COALESCE(IF(isIRI(?comparison_baseline), REPLACE(STR(?comparison_baseline), "^.*[#/]", ""), STR(?comparison_baseline)), "")) != ""), false) && COALESCE((COALESCE(?knowledge_access_score, 0) > COALESCE(?baseline_access_score, 0)), false) && COALESCE((COALESCE(?error_rate_percent, 0) < COALESCE(?baseline_error_rate, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_HigherAccessMoreEfficient" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:higherAccessMoreEfficient ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeOutcomeMeasurements .
    OPTIONAL { $this effortless-ntwf:baselineAccessScore ?baseline_access_score . }
    OPTIONAL { $this effortless-ntwf:baselineMinutesPerRun ?baseline_minutes_per_run . }
    OPTIONAL { $this effortless-ntwf:comparisonBaseline ?comparison_baseline . OPTIONAL { ?comparison_baseline effortless-ntwf:__key ?comparison_baseline__key . } }
    OPTIONAL { $this effortless-ntwf:knowledgeAccessScore ?knowledge_access_score . }
    OPTIONAL { $this effortless-ntwf:minutesPerRun ?minutes_per_run . }
                BIND((COALESCE((COALESCE(?comparison_baseline__key, COALESCE(IF(isIRI(?comparison_baseline), REPLACE(STR(?comparison_baseline), "^.*[#/]", ""), STR(?comparison_baseline)), "")) != ""), false) && COALESCE((COALESCE(?knowledge_access_score, 0) > COALESCE(?baseline_access_score, 0)), false) && COALESCE((COALESCE(?minutes_per_run, 0) < COALESCE(?baseline_minutes_per_run, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_HigherAccessMoreSatisfied" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:higherAccessMoreSatisfied ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeOutcomeMeasurements .
    OPTIONAL { $this effortless-ntwf:baselineAccessScore ?baseline_access_score . }
    OPTIONAL { $this effortless-ntwf:baselineSatisfaction ?baseline_satisfaction . }
    OPTIONAL { $this effortless-ntwf:comparisonBaseline ?comparison_baseline . OPTIONAL { ?comparison_baseline effortless-ntwf:__key ?comparison_baseline__key . } }
    OPTIONAL { $this effortless-ntwf:knowledgeAccessScore ?knowledge_access_score . }
    OPTIONAL { $this effortless-ntwf:satisfactionScore ?satisfaction_score . }
                BIND((COALESCE((COALESCE(?comparison_baseline__key, COALESCE(IF(isIRI(?comparison_baseline), REPLACE(STR(?comparison_baseline), "^.*[#/]", ""), STR(?comparison_baseline)), "")) != ""), false) && COALESCE((COALESCE(?knowledge_access_score, 0) > COALESCE(?baseline_access_score, 0)), false) && COALESCE((COALESCE(?satisfaction_score, 0) > COALESCE(?baseline_satisfaction, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_IsUnactedAdverseOutcome" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnactedAdverseOutcome ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeOutcomeMeasurements .
    OPTIONAL { $this effortless-ntwf:errorRatePercent ?error_rate_percent . }
    OPTIONAL { $this effortless-ntwf:informedChangeRequest ?informed_change_request . OPTIONAL { ?informed_change_request effortless-ntwf:__key ?informed_change_request__key . } }
    OPTIONAL { $this effortless-ntwf:informedInvestmentDecision ?informed_investment_decision . OPTIONAL { ?informed_investment_decision effortless-ntwf:__key ?informed_investment_decision__key . } }
    OPTIONAL { $this effortless-ntwf:targetErrorRatePercent ?target_error_rate_percent . }
                BIND((COALESCE((COALESCE(?error_rate_percent, 0) > COALESCE(?target_error_rate_percent, 0)), false) && COALESCE((COALESCE(?informed_change_request__key, COALESCE(IF(isIRI(?informed_change_request), REPLACE(STR(?informed_change_request), "^.*[#/]", ""), STR(?informed_change_request)), "")) = ""), false) && COALESCE((COALESCE(?informed_investment_decision__key, COALESCE(IF(isIRI(?informed_investment_decision), REPLACE(STR(?informed_investment_decision), "^.*[#/]", ""), STR(?informed_investment_decision)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_IsGainOutsideProceduralScope" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isGainOutsideProceduralScope ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeOutcomeMeasurements .
    OPTIONAL { $this effortless-ntwf:efficiencyGainPercent ?efficiency_gain_percent . }
    OPTIONAL { $this effortless-ntwf:knowledgeScope ?knowledge_scope . OPTIONAL { ?knowledge_scope effortless-ntwf:__key ?knowledge_scope__key . } }
                BIND((COALESCE((COALESCE(?efficiency_gain_percent, 0) > 0), false) && COALESCE((COALESCE(?knowledge_scope__key, COALESCE(IF(isIRI(?knowledge_scope), REPLACE(STR(?knowledge_scope), "^.*[#/]", ""), STR(?knowledge_scope)), "")) != "Procedural"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeProjections ===
effortless-ntwf:KnowledgeProjectionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeProjections ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeProjections_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeProjections .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeProjections_VersionModifiedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:versionModifiedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeProjections .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:modifiedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeProjections_OpenCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:openCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeProjections .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeSearchEvents .
                    ?child effortless-ntwf:openedProjection $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeProjections_DiagramCanDivergeFromModel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:diagramCanDivergeFromModel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeProjections .
    OPTIONAL { $this effortless-ntwf:generatedAt ?generated_at . }
    OPTIONAL { $this effortless-ntwf:generatedByTool ?generated_by_tool . OPTIONAL { ?generated_by_tool effortless-ntwf:__key ?generated_by_tool__key . } }
    OPTIONAL { $this effortless-ntwf:projectionKind ?projection_kind . OPTIONAL { ?projection_kind effortless-ntwf:__key ?projection_kind__key . } }
    OPTIONAL { $this effortless-ntwf:versionModifiedAt ?version_modified_at . }
                BIND((COALESCE((COALESCE(?projection_kind__key, COALESCE(IF(isIRI(?projection_kind), REPLACE(STR(?projection_kind), "^.*[#/]", ""), STR(?projection_kind)), "")) = "Diagram"), false) && COALESCE((COALESCE((COALESCE(?generated_by_tool__key, COALESCE(IF(isIRI(?generated_by_tool), REPLACE(STR(?generated_by_tool), "^.*[#/]", ""), STR(?generated_by_tool)), "")) = ""), false) || COALESCE(COALESCE((?generated_at < ?version_modified_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeProjections_NarrativeNotGeneratedFromModel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:narrativeNotGeneratedFromModel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeProjections .
    OPTIONAL { $this effortless-ntwf:generatedAt ?generated_at . }
    OPTIONAL { $this effortless-ntwf:generatedByTool ?generated_by_tool . OPTIONAL { ?generated_by_tool effortless-ntwf:__key ?generated_by_tool__key . } }
    OPTIONAL { $this effortless-ntwf:projectionKind ?projection_kind . OPTIONAL { ?projection_kind effortless-ntwf:__key ?projection_kind__key . } }
    OPTIONAL { $this effortless-ntwf:versionModifiedAt ?version_modified_at . }
                BIND((COALESCE((COALESCE(?projection_kind__key, COALESCE(IF(isIRI(?projection_kind), REPLACE(STR(?projection_kind), "^.*[#/]", ""), STR(?projection_kind)), "")) = "Narrative"), false) && COALESCE((COALESCE((COALESCE(?generated_by_tool__key, COALESCE(IF(isIRI(?generated_by_tool), REPLACE(STR(?generated_by_tool), "^.*[#/]", ""), STR(?generated_by_tool)), "")) = ""), false) || COALESCE(COALESCE((?generated_at < ?version_modified_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeProjections_NarrativeUnreachable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:narrativeUnreachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeProjections .
    OPTIONAL { $this effortless-ntwf:openCount ?open_count . }
    OPTIONAL { $this effortless-ntwf:projectionKind ?projection_kind . OPTIONAL { ?projection_kind effortless-ntwf:__key ?projection_kind__key . } }
    OPTIONAL { $this effortless-ntwf:publishedUri ?published_uri . OPTIONAL { ?published_uri effortless-ntwf:__key ?published_uri__key . } }
                BIND((COALESCE((COALESCE(?projection_kind__key, COALESCE(IF(isIRI(?projection_kind), REPLACE(STR(?projection_kind), "^.*[#/]", ""), STR(?projection_kind)), "")) = "Narrative"), false) && COALESCE((COALESCE(?published_uri__key, COALESCE(IF(isIRI(?published_uri), REPLACE(STR(?published_uri), "^.*[#/]", ""), STR(?published_uri)), "")) = ""), false) && COALESCE((COALESCE(?open_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeProjections_IsPublished" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPublished ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeProjections .
    OPTIONAL { $this effortless-ntwf:publishedUri ?published_uri . OPTIONAL { ?published_uri effortless-ntwf:__key ?published_uri__key . } }
                BIND((COALESCE(?published_uri__key, COALESCE(IF(isIRI(?published_uri), REPLACE(STR(?published_uri), "^.*[#/]", ""), STR(?published_uri)), "")) != "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeQueryDefinitions ===
effortless-ntwf:KnowledgeQueryDefinitionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeQueryDefinitions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeQueryDefinitions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeQueryDefinitions .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeQueryDefinitions_SourceSystemCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceSystemCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeQueryDefinitions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeQuerySources .
                    ?child effortless-ntwf:queryDefinition $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeQueryDefinitions_MissesALayer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:missesALayer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeQueryDefinitions .
    OPTIONAL { $this effortless-ntwf:needsOntologyAndInstances ?needs_ontology_and_instances . }
    OPTIONAL { $this effortless-ntwf:traversesInstanceLayer ?traverses_instance_layer . }
    OPTIONAL { $this effortless-ntwf:traversesOntologyLayer ?traverses_ontology_layer . }
                BIND((COALESCE(?needs_ontology_and_instances, false) && COALESCE((COALESCE((COALESCE(?traverses_ontology_layer, false) = false), false) || COALESCE((COALESCE(?traverses_instance_layer, false) = false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeQueryDefinitions_ConsolidatedDistributedSources" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:consolidatedDistributedSources ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeQueryDefinitions .
    OPTIONAL { $this effortless-ntwf:ranOverConsolidatedCopy ?ran_over_consolidated_copy . }
    OPTIONAL { $this effortless-ntwf:sourceSystemCount ?source_system_count . }
                BIND((COALESCE((COALESCE(?source_system_count, 0) > 1), false) && COALESCE(?ran_over_consolidated_copy, false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeQuerySources ===
effortless-ntwf:KnowledgeQuerySourcesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeQuerySources ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeQuerySources_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeQuerySources .
    OPTIONAL { $this effortless-ntwf:consumerSystem ?consumer_system . OPTIONAL { ?consumer_system effortless-ntwf:__key ?consumer_system__key . } }
    OPTIONAL { $this effortless-ntwf:queryDefinition ?query_definition . OPTIONAL { ?query_definition effortless-ntwf:__key ?query_definition__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?query_definition__key, IF(isIRI(?query_definition), REPLACE(STR(?query_definition), "^.*[#/]", ""), STR(?query_definition))), ""), " reads ", COALESCE(COALESCE(?consumer_system__key, IF(isIRI(?consumer_system), REPLACE(STR(?consumer_system), "^.*[#/]", ""), STR(?consumer_system))), "")) AS ?_result)
            }
        """ ;
    ] .

