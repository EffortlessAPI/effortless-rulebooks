    $this a pko-extension:ModelCharter .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stewardResponsibilities ?steward_responsibilities . OPTIONAL { ?steward_responsibilities erb:key ?steward_responsibilities__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stewardRole ?steward_role . OPTIONAL { ?steward_role erb:key ?steward_role__key . } }
                BIND((COALESCE((COALESCE(?steward_role__key, COALESCE(IF(isIRI(?steward_role), REPLACE(STR(?steward_role), "^.*[#/]", ""), STR(?steward_role)), "")) = ""), false) || COALESCE((COALESCE(?steward_responsibilities__key, COALESCE(IF(isIRI(?steward_responsibilities), REPLACE(STR(?steward_responsibilities), "^.*[#/]", ""), STR(?steward_responsibilities)), "")) = ""), false)) AS ?_result)
