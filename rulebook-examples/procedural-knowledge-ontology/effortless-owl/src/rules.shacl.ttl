        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:integrationCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeConsumerSystem .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:KnowledgeConsumerSystem .
                    ?child a pko-extension:AgentIntegration .
                    ?child pko-native-procedural-knowledge-rulebook:knowledgeSystem $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeConsumerSystems_IsKnowledgeSilo a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeConsumerSystem ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_IsKnowledgeSilo" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isKnowledgeSilo ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeConsumerSystem .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:exportsStandardFormat ?exports_standard_format . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holdsProcedureKnowledge ?holds_procedure_knowledge . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelSyncCount ?model_sync_count . }
                BIND((COALESCE(?holds_procedure_knowledge, false) && COALESCE((COALESCE(?exports_standard_format, false) = false), false) && COALESCE((COALESCE(?model_sync_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeConsumerSystems_IsUnlinkedToolchainComponent a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeConsumerSystem ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_IsUnlinkedToolchainComponent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnlinkedToolchainComponent ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeConsumerSystem .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:integrationCount ?integration_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelSyncCount ?model_sync_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:systemKind ?system_kind . OPTIONAL { ?system_kind erb:key ?system_kind__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?system_kind__key, COALESCE(IF(isIRI(?system_kind), REPLACE(STR(?system_kind), "^.*[#/]", ""), STR(?system_kind)), "")) = "ProcessModelingTool"), false) || COALESCE((COALESCE(?system_kind__key, COALESCE(IF(isIRI(?system_kind), REPLACE(STR(?system_kind), "^.*[#/]", ""), STR(?system_kind)), "")) = "SemanticRepository"), false) || COALESCE((COALESCE(?system_kind__key, COALESCE(IF(isIRI(?system_kind), REPLACE(STR(?system_kind), "^.*[#/]", ""), STR(?system_kind)), "")) = "AIPlatform"), false)), false) && COALESCE((COALESCE((?model_sync_count + ?integration_count), 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeConsumerSystems_SemanticLayerComponentCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeConsumerSystem ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_SemanticLayerComponentCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:semanticLayerComponentCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeConsumerSystem .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasMetadataSchema ?has_metadata_schema . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasOntology ?has_ontology . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasReasoner ?has_reasoner . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasTaxonomy ?has_taxonomy . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasThesaurus ?has_thesaurus . }
                BIND(ROUND(((((IF(COALESCE(?has_taxonomy, false), 1, 0) + IF(COALESCE(?has_thesaurus, false), 1, 0)) + IF(COALESCE(?has_ontology, false), 1, 0)) + IF(COALESCE(?has_metadata_schema, false), 1, 0)) + IF(COALESCE(?has_reasoner, false), 1, 0))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeConsumerSystems_PlatformCapabilityCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeConsumerSystem ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_PlatformCapabilityCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:platformCapabilityCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeConsumerSystem .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasGraphAlgorithms ?has_graph_algorithms . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasMachineLearning ?has_machine_learning . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasReasoner ?has_reasoner . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasSemanticStorage ?has_semantic_storage . }
                BIND(ROUND((((IF(COALESCE(?has_reasoner, false), 1, 0) + IF(COALESCE(?has_semantic_storage, false), 1, 0)) + IF(COALESCE(?has_graph_algorithms, false), 1, 0)) + IF(COALESCE(?has_machine_learning, false), 1, 0))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeConsumerSystems_IsImmatureGraphPlatform a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeConsumerSystem ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_IsImmatureGraphPlatform" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isImmatureGraphPlatform ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeConsumerSystem .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:platformCapabilityCount ?platform_capability_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:systemKind ?system_kind . OPTIONAL { ?system_kind erb:key ?system_kind__key . } }
                BIND((COALESCE((COALESCE(?system_kind__key, COALESCE(IF(isIRI(?system_kind), REPLACE(STR(?system_kind), "^.*[#/]", ""), STR(?system_kind)), "")) = "KnowledgeGraphPlatform"), false) && COALESCE((COALESCE(?platform_capability_count, 0) < 4), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeConsumerSystems_HoldsComputationallyEncodedProcedureKnowledge a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeConsumerSystem ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_HoldsComputationallyEncodedProcedureKnowledge" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:holdsComputationallyEncodedProcedureKnowledge ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeConsumerSystem .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasReasoner ?has_reasoner . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holdsProcedureKnowledge ?holds_procedure_knowledge . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isComputationallyQueryable ?is_computationally_queryable . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isComputationallyValidatable ?is_computationally_validatable . }
                BIND((COALESCE(?holds_procedure_knowledge, false) && COALESCE(?is_computationally_queryable, false) && COALESCE(?is_computationally_validatable, false) && COALESCE(?has_reasoner, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeConsumerSystems_StoresProcedureKnowledgeWithoutComputationalAccess a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeConsumerSystem ;
