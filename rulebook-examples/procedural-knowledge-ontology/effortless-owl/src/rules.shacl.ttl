pko-native-procedural-knowledge-rulebook-shapes:StepRequirements_BlockingStepKey a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepRequirements ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_BlockingStepKey" ;
