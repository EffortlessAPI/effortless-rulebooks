            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasSentReminder ?_result .
            }
            WHERE {
    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reminderCount ?reminder_count . }
                BIND((COALESCE(?reminder_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageDeliveries_AcknowledgementIsOutstanding a sh:NodeShape ;
    sh:targetClass pko-extension:MessageDelivery ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_AcknowledgementIsOutstanding" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:acknowledgementIsOutstanding ?_result .
            }
            WHERE {
    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAcknowledged ?is_acknowledged . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isEvidenceRequired ?is_evidence_required . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((COALESCE(?is_evidence_required, false) && COALESCE((!(COALESCE(?is_acknowledged, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageDeliveries_OutstandingAgeDays a sh:NodeShape ;
    sh:targetClass pko-extension:MessageDelivery ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_OutstandingAgeDays" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:outstandingAgeDays ?_result .
            }
            WHERE {
    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:acknowledgementIsOutstanding ?acknowledgement_is_outstanding . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sentAt ?sent_at . }
                BIND(ROUND(IF(COALESCE(?acknowledgement_is_outstanding, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?sent_at) + FLOOR((153 * (MONTH(?sent_at) + 12 * FLOOR((14 - MONTH(?sent_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 4) - FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 100) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageDeliveries_IsUnchasedAcknowledgement a sh:NodeShape ;
    sh:targetClass pko-extension:MessageDelivery ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsUnchasedAcknowledgement" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnchasedAcknowledgement ?_result .
            }
            WHERE {
    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:acknowledgementIsOutstanding ?acknowledgement_is_outstanding . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasSentReminder ?has_sent_reminder . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:outstandingAgeDays ?outstanding_age_days . }
                BIND((COALESCE(?acknowledgement_is_outstanding, false) && COALESCE((COALESCE((COALESCE(?outstanding_age_days, 0) > 7), false) && COALESCE((!(COALESCE(?has_sent_reminder, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageDeliveries_IsExhaustedFollowUp a sh:NodeShape ;
    sh:targetClass pko-extension:MessageDelivery ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsExhaustedFollowUp" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isExhaustedFollowUp ?_result .
            }
            WHERE {
    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:acknowledgementIsOutstanding ?acknowledgement_is_outstanding . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reminderCount ?reminder_count . }
                BIND((COALESCE(?acknowledgement_is_outstanding, false) && COALESCE((COALESCE(?reminder_count, 0) >= 3), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageDeliveries_NeedsHumanEscalation a sh:NodeShape ;
    sh:targetClass pko-extension:MessageDelivery ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_NeedsHumanEscalation" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:needsHumanEscalation ?_result .
            }
            WHERE {
    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasUnreachableExceptionInvoked ?has_unreachable_exception_invoked . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isExhaustedFollowUp ?is_exhausted_follow_up . }
                BIND((COALESCE(?is_exhausted_follow_up, false) && COALESCE((!(COALESCE(?has_unreachable_exception_invoked, false))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for MessageTemplates ===
pko-native-procedural-knowledge-rulebook-shapes:MessageTemplates_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:MessageTemplates .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:communicationPolicy ?communication_policy . OPTIONAL { ?communication_policy erb:key ?communication_policy__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:locale ?locale . OPTIONAL { ?locale erb:key ?locale__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?communication_policy__key, IF(isIRI(?communication_policy), REPLACE(STR(?communication_policy), "^.*[#/]", ""), STR(?communication_policy))), ""), " / ", COALESCE(COALESCE(?locale__key, IF(isIRI(?locale), REPLACE(STR(?locale), "^.*[#/]", ""), STR(?locale))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageTemplates_PolicyMaxMessageLength a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_PolicyMaxMessageLength" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:policyMaxMessageLength ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:MessageTemplates .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:communicationPolicy ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:CommunicationPolicies . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:maxMessageLength ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageTemplates_PolicyMaxSegments a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_PolicyMaxSegments" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:policyMaxSegments ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:MessageTemplates .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:communicationPolicy ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:CommunicationPolicies . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:maxSegments ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageTemplates_BodyTemplateLength a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_BodyTemplateLength" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:bodyTemplateLength ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:MessageTemplates .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:bodyTemplate ?body_template . }
                BIND(ROUND(STRLEN(STR(?body_template))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageTemplates_IsTemplateOverLength a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_IsTemplateOverLength" ;
