            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnattributedGatekeeping ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holderDeclinedToShare ?holder_declined_to_share . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isGatekeepingOrSabotage ?is_gatekeeping_or_sabotage . }
                BIND((COALESCE(?holder_declined_to_share, false) && COALESCE((!(COALESCE(?is_gatekeeping_or_sabotage, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_IsRequiredGatekeptUncodified a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsRequiredGatekeptUncodified" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isRequiredGatekeptUncodified ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:blockingKind ?blocking_kind . OPTIONAL { ?blocking_kind erb:key ?blocking_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:codifiedAsFragment ?codified_as_fragment . OPTIONAL { ?codified_as_fragment erb:key ?codified_as_fragment__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isGatekeepingOrSabotage ?is_gatekeeping_or_sabotage . }
                BIND((COALESCE(?is_gatekeeping_or_sabotage, false) && COALESCE((COALESCE(?blocking_kind__key, COALESCE(IF(isIRI(?blocking_kind), REPLACE(STR(?blocking_kind), "^.*[#/]", ""), STR(?blocking_kind)), "")) = "Blocking"), false) && COALESCE((COALESCE(?codified_as_fragment__key, COALESCE(IF(isIRI(?codified_as_fragment), REPLACE(STR(?codified_as_fragment), "^.*[#/]", ""), STR(?codified_as_fragment)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
