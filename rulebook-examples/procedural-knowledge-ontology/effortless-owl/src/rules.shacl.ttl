                $this pko-native-procedural-knowledge-rulebook:staleAtRunStepKey ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:BindingObservations .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wasStaleAtRun ?was_stale_at_run . }
                BIND(IF(COALESCE(?was_stale_at_run, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .

