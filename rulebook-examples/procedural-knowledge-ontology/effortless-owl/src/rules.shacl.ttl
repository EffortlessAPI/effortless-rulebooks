            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VerificationOutcomes_IsIndependentHumanObservation a sh:NodeShape ;
    sh:targetClass pko-extension:VerificationOutcome ;
    sh:order 3 ;
