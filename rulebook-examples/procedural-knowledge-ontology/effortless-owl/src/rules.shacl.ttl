            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:contradictedIsIndexed ?_result .
            }
            WHERE {
    $this a pko-extension:RetrievalSegment .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:contradictsSegment ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:RetrievalSegment . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isIndexed ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RetrievalSegments_IsInconsistentGrounding a sh:NodeShape ;
    sh:targetClass pko-extension:RetrievalSegment ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RetrievalSegments_IsInconsistentGrounding" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isInconsistentGrounding ?_result .
            }
            WHERE {
    $this a pko-extension:RetrievalSegment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:contradictedIsIndexed ?contradicted_is_indexed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:contradictsSegment ?contradicts_segment . OPTIONAL { ?contradicts_segment erb:key ?contradicts_segment__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isIndexed ?is_indexed . }
                BIND((COALESCE(?is_indexed, false) && COALESCE((COALESCE(?contradicts_segment__key, COALESCE(IF(isIRI(?contradicts_segment), REPLACE(STR(?contradicts_segment), "^.*[#/]", ""), STR(?contradicts_segment)), "")) != ""), false) && COALESCE(?contradicted_is_indexed, false)) AS ?_result)
            }
        """ ;
    ] .
