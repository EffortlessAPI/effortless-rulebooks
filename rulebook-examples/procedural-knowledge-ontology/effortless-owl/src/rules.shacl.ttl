# === Rules for GovernanceStageControls ===
pko-native-procedural-knowledge-rulebook-shapes:GovernanceStageControls_Name a sh:NodeShape ;
    sh:targetClass pko-extension:GovernanceStageControl ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernanceStageControls_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:GovernanceStageControl .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:governedModel ?governed_model . OPTIONAL { ?governed_model erb:key ?governed_model__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stage_GovernanceStageControls ?stage . OPTIONAL { ?stage erb:key ?stage__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " ", COALESCE(COALESCE(?stage__key, IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:GovernanceStageControls_IsContinuousPipelineStage a sh:NodeShape ;
    sh:targetClass pko-extension:GovernanceStageControl ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernanceStageControls_IsContinuousPipelineStage" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isContinuousPipelineStage ?_result .
            }
            WHERE {
    $this a pko-extension:GovernanceStageControl .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isContinuous ?is_continuous . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stage_GovernanceStageControls ?stage . OPTIONAL { ?stage erb:key ?stage__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?stage__key, COALESCE(IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage)), "")) = "Collection"), false) || COALESCE((COALESCE(?stage__key, COALESCE(IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage)), "")) = "Organization"), false) || COALESCE((COALESCE(?stage__key, COALESCE(IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage)), "")) = "Encoding"), false)), false) && COALESCE(?is_continuous, false)) AS ?_result)
            }
        """ ;
    ] .

