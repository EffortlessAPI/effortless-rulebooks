                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_LastCqReviewAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lastCqReviewAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:CompetencyQuestionReviews .
                    ?child effortless-ntwf:governedModel $this .
                    OPTIONAL { ?child effortless-ntwf:reviewedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_DaysSinceCqReview" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceCqReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:daysSinceRegistered ?days_since_registered . }
    OPTIONAL { $this effortless-ntwf:lastCqReviewAt ?last_cq_review_at . OPTIONAL { ?last_cq_review_at effortless-ntwf:__key ?last_cq_review_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?last_cq_review_at__key, COALESCE(IF(isIRI(?last_cq_review_at), REPLACE(STR(?last_cq_review_at), "^.*[#/]", ""), STR(?last_cq_review_at)), "")) = ""), false), ?days_since_registered, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_cq_review_at) + FLOOR((153 * (MONTH(?last_cq_review_at) + 12 * FLOOR((14 - MONTH(?last_cq_review_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_cq_review_at) + 4800 - FLOOR((14 - MONTH(?last_cq_review_at)) / 12)) + FLOOR((YEAR(?last_cq_review_at) + 4800 - FLOOR((14 - MONTH(?last_cq_review_at)) / 12)) / 4) - FLOOR((YEAR(?last_cq_review_at) + 4800 - FLOOR((14 - MONTH(?last_cq_review_at)) / 12)) / 100) + FLOOR((YEAR(?last_cq_review_at) + 4800 - FLOOR((14 - MONTH(?last_cq_review_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_CqReviewOverdue" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cqReviewOverdue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:daysSinceCqReview ?days_since_cq_review . }
                BIND((COALESCE(?days_since_cq_review, 0) > 92) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
