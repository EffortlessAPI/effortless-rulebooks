    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
                BIND((COALESCE(?requirement_is_blocking, false) && COALESCE((COALESCE(?evaluator_agent_kind__key, COALESCE(IF(isIRI(?evaluator_agent_kind), REPLACE(STR(?evaluator_agent_kind), "^.*[#/]", ""), STR(?evaluator_agent_kind)), "")) != "Human"), false)) AS ?_result)
            }
        """ ;
    ] ;
