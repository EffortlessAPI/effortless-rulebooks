            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isSmsReachable ?_result .
            }
            WHERE {
    $this a pko-extension:Recipient .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:mobileNumber ?mobile_number . OPTIONAL { ?mobile_number erb:key ?mobile_number__key . } }
                BIND((COALESCE(?mobile_number__key, COALESCE(IF(isIRI(?mobile_number), REPLACE(STR(?mobile_number), "^.*[#/]", ""), STR(?mobile_number)), "")) != "") AS ?_result)
            }
