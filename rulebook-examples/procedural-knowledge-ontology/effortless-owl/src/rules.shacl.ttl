pko-native-procedural-knowledge-rulebook-shapes:AiAdoptionInitiatives_LastOutcomeMeasuredAt a sh:NodeShape ;
    sh:targetClass pko-extension:AiAdoptionInitiative ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_LastOutcomeMeasuredAt" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:lastOutcomeMeasuredAt ?_result .
            }
            WHERE {
    $this a pko-extension:AiAdoptionInitiative .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:AiAdoptionInitiative .
                    ?child a pko-extension:KnowledgeOutcomeMeasurement .
                    ?child pko-native-procedural-knowledge-rulebook:aiInitiative $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:measuredAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiAdoptionInitiatives_DaysSinceOutcomeMeasured a sh:NodeShape ;
    sh:targetClass pko-extension:AiAdoptionInitiative ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_DaysSinceOutcomeMeasured" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceOutcomeMeasured ?_result .
            }
            WHERE {
    $this a pko-extension:AiAdoptionInitiative .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastOutcomeMeasuredAt ?last_outcome_measured_at . OPTIONAL { ?last_outcome_measured_at erb:key ?last_outcome_measured_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?last_outcome_measured_at__key, COALESCE(IF(isIRI(?last_outcome_measured_at), REPLACE(STR(?last_outcome_measured_at), "^.*[#/]", ""), STR(?last_outcome_measured_at)), "")) = ""), false), 0, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_outcome_measured_at) + FLOOR((153 * (MONTH(?last_outcome_measured_at) + 12 * FLOOR((14 - MONTH(?last_outcome_measured_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_outcome_measured_at) + 4800 - FLOOR((14 - MONTH(?last_outcome_measured_at)) / 12)) + FLOOR((YEAR(?last_outcome_measured_at) + 4800 - FLOOR((14 - MONTH(?last_outcome_measured_at)) / 12)) / 4) - FLOOR((YEAR(?last_outcome_measured_at) + 4800 - FLOOR((14 - MONTH(?last_outcome_measured_at)) / 12)) / 100) + FLOOR((YEAR(?last_outcome_measured_at) + 4800 - FLOOR((14 - MONTH(?last_outcome_measured_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiAdoptionInitiatives_AiInsightCount a sh:NodeShape ;
    sh:targetClass pko-extension:AiAdoptionInitiative ;
    sh:order 1 ;
