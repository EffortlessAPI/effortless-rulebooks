    OPTIONAL { $this effortless-ntwf:nonAdditiveChangeCount ?non_additive_change_count . }
                BIND((COALESCE((COALESCE(?declared_scale__key, COALESCE(IF(isIRI(?declared_scale), REPLACE(STR(?declared_scale), "^.*[#/]", ""), STR(?declared_scale)), "")) = "Major"), false) || COALESCE((COALESCE(?non_additive_change_count, 0) > 0), false)) AS ?_result)
            }
