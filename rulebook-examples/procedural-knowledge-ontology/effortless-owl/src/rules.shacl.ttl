    $this a effortless-ntwf:ElicitationSessions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ElicitationParticipants .
                    ?child effortless-ntwf:elicitationSession $this .
                    OPTIONAL { ?child effortless-ntwf:processStake ?c2 . }
                    FILTER((STR(?c2) = "Executes"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_DependentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:dependentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ElicitationParticipants .
                    ?child effortless-ntwf:elicitationSession $this .
                    OPTIONAL { ?child effortless-ntwf:processStake ?c2 . }
                    FILTER((STR(?c2) = "DependsOnResults"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_UninvitedParticipantCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:uninvitedParticipantCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ElicitationParticipants .
                    ?child effortless-ntwf:elicitationSession $this .
                    OPTIONAL { ?child effortless-ntwf:isUsuallyInvited ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = false)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_GathersWholeProcessChain" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:gathersWholeProcessChain ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:dependentCount ?dependent_count . }
    OPTIONAL { $this effortless-ntwf:executorCount ?executor_count . }
    OPTIONAL { $this effortless-ntwf:initiatorCount ?initiator_count . }
    OPTIONAL { $this effortless-ntwf:isWorkshop ?is_workshop . }
                BIND((COALESCE(?is_workshop, false) && COALESCE((COALESCE(?initiator_count, 0) > 0), false) && COALESCE((COALESCE(?executor_count, 0) > 0), false) && COALESCE((COALESCE(?dependent_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsWorkshopWithoutUsualOutsiders" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWorkshopWithoutUsualOutsiders ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:isWorkshop ?is_workshop . }
    OPTIONAL { $this effortless-ntwf:uninvitedParticipantCount ?uninvited_participant_count . }
                BIND((COALESCE(?is_workshop, false) && COALESCE((COALESCE(?uninvited_participant_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_MethodFamily" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:methodFamily ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                OPTIONAL { $this effortless-ntwf:method ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeMethods ; effortless-ntwf:knowledgeMethodId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:methodFamily ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_FacilitatorKnowledgeEngineerRoleCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:facilitatorKnowledgeEngineerRoleCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Roles .
                    ?child effortless-ntwf:currentAgent ?backfk .
                    $this effortless-ntwf:facilitatorAgent ?backpv .
                    OPTIONAL { ?child effortless-ntwf:roleId ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER((STR(?c2) = "knowledge-engineer"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_FacilitatorIsKnowledgeEngineer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:facilitatorIsKnowledgeEngineer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:facilitatorKnowledgeEngineerRoleCount ?facilitator_knowledge_engineer_role_count . }
                BIND((COALESCE(?facilitator_knowledge_engineer_role_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsGenericOrUnskilledCapture" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isGenericOrUnskilledCapture ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:facilitatorIsKnowledgeEngineer ?facilitator_is_knowledge_engineer . }
    OPTIONAL { $this effortless-ntwf:method ?method . OPTIONAL { ?method effortless-ntwf:__key ?method__key . } }
    OPTIONAL { $this effortless-ntwf:methodFamily ?method_family . OPTIONAL { ?method_family effortless-ntwf:__key ?method_family__key . } }
                BIND((COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?method_family__key, COALESCE(IF(isIRI(?method_family), REPLACE(STR(?method_family), "^.*[#/]", ""), STR(?method_family)), "")) != "Elicitation"), false) || COALESCE((!(COALESCE(?facilitator_is_knowledge_engineer, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsKeFieldSession" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isKeFieldSession ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:facilitatorIsKnowledgeEngineer ?facilitator_is_knowledge_engineer . }
    OPTIONAL { $this effortless-ntwf:setting ?setting . OPTIONAL { ?setting effortless-ntwf:__key ?setting__key . } }
                BIND((COALESCE(?facilitator_is_knowledge_engineer, false) && COALESCE((COALESCE(?setting__key, COALESCE(IF(isIRI(?setting), REPLACE(STR(?setting), "^.*[#/]", ""), STR(?setting)), "")) = "InSitu"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsReviewedRecording" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isReviewedRecording ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:practitionerReviewedAt ?practitioner_reviewed_at . OPTIONAL { ?practitioner_reviewed_at effortless-ntwf:__key ?practitioner_reviewed_at__key . } }
    OPTIONAL { $this effortless-ntwf:recordingReference ?recording_reference . OPTIONAL { ?recording_reference effortless-ntwf:__key ?recording_reference__key . } }
                BIND((COALESCE((COALESCE(?recording_reference__key, COALESCE(IF(isIRI(?recording_reference), REPLACE(STR(?recording_reference), "^.*[#/]", ""), STR(?recording_reference)), "")) != ""), false) && COALESCE((COALESCE(?practitioner_reviewed_at__key, COALESCE(IF(isIRI(?practitioner_reviewed_at), REPLACE(STR(?practitioner_reviewed_at), "^.*[#/]", ""), STR(?practitioner_reviewed_at)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for EmbeddingProbes ===
effortless-ntwf:EmbeddingProbesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EmbeddingProbes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EmbeddingProbes_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EmbeddingProbes .
    OPTIONAL { $this effortless-ntwf:embeddingModel ?embedding_model . OPTIONAL { ?embedding_model effortless-ntwf:__key ?embedding_model__key . } }
    OPTIONAL { $this effortless-ntwf:termA ?term_a . OPTIONAL { ?term_a effortless-ntwf:__key ?term_a__key . } }
    OPTIONAL { $this effortless-ntwf:termB ?term_b . OPTIONAL { ?term_b effortless-ntwf:__key ?term_b__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?term_a__key, IF(isIRI(?term_a), REPLACE(STR(?term_a), "^.*[#/]", ""), STR(?term_a))), ""), " / ", COALESCE(COALESCE(?term_b__key, IF(isIRI(?term_b), REPLACE(STR(?term_b), "^.*[#/]", ""), STR(?term_b))), ""), " @ ", COALESCE(COALESCE(?embedding_model__key, IF(isIRI(?embedding_model), REPLACE(STR(?embedding_model), "^.*[#/]", ""), STR(?embedding_model))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EmbeddingProbes_SynonymsNotSimilar" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:synonymsNotSimilar ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EmbeddingProbes .
    OPTIONAL { $this effortless-ntwf:cosineSimilarity ?cosine_similarity . }
    OPTIONAL { $this effortless-ntwf:expectedRelation ?expected_relation . OPTIONAL { ?expected_relation effortless-ntwf:__key ?expected_relation__key . } }
                BIND((COALESCE((COALESCE(?expected_relation__key, COALESCE(IF(isIRI(?expected_relation), REPLACE(STR(?expected_relation), "^.*[#/]", ""), STR(?expected_relation)), "")) = "NearSynonym"), false) && COALESCE((COALESCE(?cosine_similarity, 0) < 0.7), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EmbeddingProbes_OppositesNotOpposed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:oppositesNotOpposed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EmbeddingProbes .
    OPTIONAL { $this effortless-ntwf:cosineSimilarity ?cosine_similarity . }
    OPTIONAL { $this effortless-ntwf:expectedRelation ?expected_relation . OPTIONAL { ?expected_relation effortless-ntwf:__key ?expected_relation__key . } }
                BIND((COALESCE((COALESCE(?expected_relation__key, COALESCE(IF(isIRI(?expected_relation), REPLACE(STR(?expected_relation), "^.*[#/]", ""), STR(?expected_relation)), "")) = "Opposite"), false) && COALESCE((COALESCE(?cosine_similarity, 0) > 0.3), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for EncodingLifecycleStages ===
effortless-ntwf:EncodingLifecycleStagesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EncodingLifecycleStages ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EncodingLifecycleStages_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EncodingLifecycleStages .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EncodingLifecycleStages_AnnotationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:annotationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EncodingLifecycleStages .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelAnnotations .
                    ?child effortless-ntwf:lifecycleStage $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EncodingLifecycleStages_IsStageWithoutFeedback" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStageWithoutFeedback ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EncodingLifecycleStages .
    OPTIONAL { $this effortless-ntwf:annotationCount ?annotation_count . }
                BIND((COALESCE(?annotation_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for EnergySources ===
effortless-ntwf:EnergySourcesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EnergySources ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EnergySources_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EnergySources .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Errors ===
effortless-ntwf:ErrorsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Errors ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Errors_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Errors .
    OPTIONAL { $this effortless-ntwf:errorCode ?error_code . OPTIONAL { ?error_code effortless-ntwf:__key ?error_code__key . } }
    OPTIONAL { $this effortless-ntwf:label ?label . OPTIONAL { ?label effortless-ntwf:__key ?label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?error_code__key, IF(isIRI(?error_code), REPLACE(STR(?error_code), "^.*[#/]", ""), STR(?error_code))), ""), " - ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Errors_RemedyStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:remedyStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Errors .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:remedyForError $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Errors_OccurrenceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:occurrenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Errors .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:IssueOccurrences .
                    ?child effortless-ntwf:error $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Errors_HasNoRemedyStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoRemedyStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Errors .
    OPTIONAL { $this effortless-ntwf:occurrenceCount ?occurrence_count . }
    OPTIONAL { $this effortless-ntwf:remedyStepCount ?remedy_step_count . }
                BIND((COALESCE((COALESCE(?occurrence_count, 0) > 0), false) && COALESCE((COALESCE(?remedy_step_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for EvaluationContexts ===
effortless-ntwf:EvaluationContextsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EvaluationContexts ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EvaluationContexts_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EvaluationContexts .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . OPTIONAL { ?as_of_instant effortless-ntwf:__key ?as_of_instant__key . } }
    OPTIONAL { $this effortless-ntwf:label ?label . OPTIONAL { ?label effortless-ntwf:__key ?label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), ""), " @ ", COALESCE(REPLACE(COALESCE(?as_of_instant__key, IF(isIRI(?as_of_instant), REPLACE(STR(?as_of_instant), "^.*[#/]", ""), STR(?as_of_instant))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ExceptionInvocations ===
effortless-ntwf:ExceptionInvocationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ExceptionInvocations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:exception ?exception . OPTIONAL { ?exception effortless-ntwf:__key ?exception__key . } }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . OPTIONAL { ?step_execution effortless-ntwf:__key ?step_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_execution__key, IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution))), ""), " / ", COALESCE(COALESCE(?exception__key, IF(isIRI(?exception), REPLACE(STR(?exception), "^.*[#/]", ""), STR(?exception))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ExpectedHandling" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expectedHandling ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:exception ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Exceptions ; effortless-ntwf:exceptionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:handling ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_RequiredApprovalRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requiredApprovalRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:exception ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Exceptions ; effortless-ntwf:exceptionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:approvalRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_RequiredApprovalRoleHolder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requiredApprovalRoleHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:requiredApprovalRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:currentAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ApprovalRoleMatches" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approvalRoleMatches ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approvedByAgent ?approved_by_agent . }
    OPTIONAL { $this effortless-ntwf:requiredApprovalRoleHolder ?required_approval_role_holder . }
                BIND(COALESCE((?approved_by_agent = ?required_approval_role_holder), ((!BOUND(?approved_by_agent) || STR(?approved_by_agent) = "") && (!BOUND(?required_approval_role_holder) || STR(?required_approval_role_holder) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_IsApproved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isApproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approvedByAgent ?approved_by_agent . OPTIONAL { ?approved_by_agent effortless-ntwf:__key ?approved_by_agent__key . } }
                BIND((COALESCE(?approved_by_agent__key, COALESCE(IF(isIRI(?approved_by_agent), REPLACE(STR(?approved_by_agent), "^.*[#/]", ""), STR(?approved_by_agent)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_IsImproperlyApproved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isImproperlyApproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approvalRoleMatches ?approval_role_matches . }
    OPTIONAL { $this effortless-ntwf:isApproved ?is_approved . }
                BIND((COALESCE((!(COALESCE(?is_approved, false))), false) || COALESCE((!(COALESCE(?approval_role_matches, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_InvokerAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:invokerAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:invokedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_InvokerAlsoPreparedKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:invokerAlsoPreparedKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approvedByAgent ?approved_by_agent . OPTIONAL { ?approved_by_agent effortless-ntwf:__key ?approved_by_agent__key . } }
    OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?parent_procedure_execution . OPTIONAL { ?parent_procedure_execution effortless-ntwf:__key ?parent_procedure_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_procedure_execution__key, IF(isIRI(?parent_procedure_execution), REPLACE(STR(?parent_procedure_execution), "^.*[#/]", ""), STR(?parent_procedure_execution))), ""), "|", COALESCE(COALESCE(?approved_by_agent__key, IF(isIRI(?approved_by_agent), REPLACE(STR(?approved_by_agent), "^.*[#/]", ""), STR(?approved_by_agent))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ParentProcedureExecution" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:parentProcedureExecution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:procedureExecution ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ApproverPreparedCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approverPreparedCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:preparerAgentKey ?backfk .
                    $this effortless-ntwf:invokerAlsoPreparedKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_DelegatedToPreparer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:delegatedToPreparer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approverPreparedCount ?approver_prepared_count . }
                BIND((COALESCE(?approver_prepared_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_IsUngovernedInvocation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUngovernedInvocation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:delegatedToPreparer ?delegated_to_preparer . }
    OPTIONAL { $this effortless-ntwf:isImproperlyApproved ?is_improperly_approved . }
                BIND((COALESCE(?is_improperly_approved, false) || COALESCE(?delegated_to_preparer, false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Exceptions ===
effortless-ntwf:ExceptionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Exceptions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Exceptions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Exceptions .
    OPTIONAL { $this effortless-ntwf:condition ?condition . }
                BIND(?condition AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Exceptions_ActiveExceptionStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:activeExceptionStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Exceptions .
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
    OPTIONAL { $this effortless-ntwf:triggerStep ?trigger_step . }
                BIND(IF(COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Active"), false), ?trigger_step, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ExecutionEntities ===
effortless-ntwf:ExecutionEntitiesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ExecutionEntities ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
    OPTIONAL { $this effortless-ntwf:entityLabel ?entity_label . OPTIONAL { ?entity_label effortless-ntwf:__key ?entity_label__key . } }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . OPTIONAL { ?step_execution effortless-ntwf:__key ?step_execution__key . } }
    OPTIONAL { $this effortless-ntwf:usage ?usage . OPTIONAL { ?usage effortless-ntwf:__key ?usage__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_execution__key, IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution))), ""), " ", COALESCE(COALESCE(?usage__key, IF(isIRI(?usage), REPLACE(STR(?usage), "^.*[#/]", ""), STR(?usage))), ""), " ", COALESCE(COALESCE(?entity_label__key, IF(isIRI(?entity_label), REPLACE(STR(?entity_label), "^.*[#/]", ""), STR(?entity_label))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_VariableDirection" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:variableDirection ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
                OPTIONAL { $this effortless-ntwf:stepVariable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepVariables ; effortless-ntwf:stepVariableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:direction ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_VariableStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:variableStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
                OPTIONAL { $this effortless-ntwf:stepVariable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepVariables ; effortless-ntwf:stepVariableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_ExecutedStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:executedStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_IsUsageDirectionMismatch" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUsageDirectionMismatch ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
    OPTIONAL { $this effortless-ntwf:usage ?usage . OPTIONAL { ?usage effortless-ntwf:__key ?usage__key . } }
    OPTIONAL { $this effortless-ntwf:variableDirection ?variable_direction . OPTIONAL { ?variable_direction effortless-ntwf:__key ?variable_direction__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?usage__key, COALESCE(IF(isIRI(?usage), REPLACE(STR(?usage), "^.*[#/]", ""), STR(?usage)), "")) = "Used"), false) && COALESCE((COALESCE(?variable_direction__key, COALESCE(IF(isIRI(?variable_direction), REPLACE(STR(?variable_direction), "^.*[#/]", ""), STR(?variable_direction)), "")) != "Input"), false)), false) || COALESCE((COALESCE((COALESCE(?usage__key, COALESCE(IF(isIRI(?usage), REPLACE(STR(?usage), "^.*[#/]", ""), STR(?usage)), "")) = "Generated"), false) && COALESCE((COALESCE(?variable_direction__key, COALESCE(IF(isIRI(?variable_direction), REPLACE(STR(?variable_direction), "^.*[#/]", ""), STR(?variable_direction)), "")) != "Output"), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_IsForeignVariable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isForeignVariable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
    OPTIONAL { $this effortless-ntwf:executedStep ?executed_step . }
    OPTIONAL { $this effortless-ntwf:variableStep ?variable_step . }
                BIND(COALESCE((?variable_step != ?executed_step), !((!BOUND(?variable_step) || STR(?variable_step) = "") && (!BOUND(?executed_step) || STR(?executed_step) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_UsedExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:usedExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
    OPTIONAL { $this effortless-ntwf:usage ?usage . OPTIONAL { ?usage effortless-ntwf:__key ?usage__key . } }
                BIND(IF(COALESCE((COALESCE(?usage__key, COALESCE(IF(isIRI(?usage), REPLACE(STR(?usage), "^.*[#/]", ""), STR(?usage)), "")) = "Used"), false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_GeneratedExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:generatedExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
    OPTIONAL { $this effortless-ntwf:usage ?usage . OPTIONAL { ?usage effortless-ntwf:__key ?usage__key . } }
                BIND(IF(COALESCE((COALESCE(?usage__key, COALESCE(IF(isIRI(?usage), REPLACE(STR(?usage), "^.*[#/]", ""), STR(?usage)), "")) = "Generated"), false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_VariableDatatype" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:variableDatatype ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
                OPTIONAL { $this effortless-ntwf:stepVariable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepVariables ; effortless-ntwf:stepVariableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:datatype ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_VariableExpectedFormat" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:variableExpectedFormat ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
                OPTIONAL { $this effortless-ntwf:stepVariable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepVariables ; effortless-ntwf:stepVariableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:expectedFormat ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_ViolatesDeclaredDatatypeOrFormat" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:violatesDeclaredDatatypeOrFormat ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
    OPTIONAL { $this effortless-ntwf:recordedDatatype ?recorded_datatype . OPTIONAL { ?recorded_datatype effortless-ntwf:__key ?recorded_datatype__key . } }
    OPTIONAL { $this effortless-ntwf:recordedFormat ?recorded_format . OPTIONAL { ?recorded_format effortless-ntwf:__key ?recorded_format__key . } }
    OPTIONAL { $this effortless-ntwf:variableDatatype ?variable_datatype . }
    OPTIONAL { $this effortless-ntwf:variableExpectedFormat ?variable_expected_format . OPTIONAL { ?variable_expected_format effortless-ntwf:__key ?variable_expected_format__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?recorded_datatype__key, COALESCE(IF(isIRI(?recorded_datatype), REPLACE(STR(?recorded_datatype), "^.*[#/]", ""), STR(?recorded_datatype)), "")) != ""), false) && COALESCE(COALESCE((?recorded_datatype != ?variable_datatype), !((!BOUND(?recorded_datatype) || STR(?recorded_datatype) = "") && (!BOUND(?variable_datatype) || STR(?variable_datatype) = ""))), false)), false) || COALESCE((COALESCE((COALESCE(?recorded_format__key, COALESCE(IF(isIRI(?recorded_format), REPLACE(STR(?recorded_format), "^.*[#/]", ""), STR(?recorded_format)), "")) != ""), false) && COALESCE((COALESCE(?variable_expected_format__key, COALESCE(IF(isIRI(?variable_expected_format), REPLACE(STR(?variable_expected_format), "^.*[#/]", ""), STR(?variable_expected_format)), "")) != ""), false) && COALESCE(COALESCE((?recorded_format != ?variable_expected_format), !((!BOUND(?recorded_format) || STR(?recorded_format) = "") && (!BOUND(?variable_expected_format) || STR(?variable_expected_format) = ""))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_GeneratingAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:generatingAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:executedByAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_AttributedToAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:attributedToAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionEntities .
    OPTIONAL { $this effortless-ntwf:generatingAgent ?generating_agent . }
    OPTIONAL { $this effortless-ntwf:usage ?usage . OPTIONAL { ?usage effortless-ntwf:__key ?usage__key . } }
                BIND(IF(COALESCE((COALESCE(?usage__key, COALESCE(IF(isIRI(?usage), REPLACE(STR(?usage), "^.*[#/]", ""), STR(?usage)), "")) = "Generated"), false), ?generating_agent, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ExecutionParticipants ===
effortless-ntwf:ExecutionParticipantsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ExecutionParticipants ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionParticipants_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExecutionParticipants .
    OPTIONAL { $this effortless-ntwf:agent ?agent . OPTIONAL { ?agent effortless-ntwf:__key ?agent__key . } }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . OPTIONAL { ?procedure_execution effortless-ntwf:__key ?procedure_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_execution__key, IF(isIRI(?procedure_execution), REPLACE(STR(?procedure_execution), "^.*[#/]", ""), STR(?procedure_execution))), ""), " / ", COALESCE(COALESCE(?agent__key, IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ExpansionConceptFits ===
effortless-ntwf:ExpansionConceptFitsShape a sh:NodeShape ;
