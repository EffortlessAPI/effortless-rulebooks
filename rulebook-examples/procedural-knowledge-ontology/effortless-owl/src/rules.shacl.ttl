    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyMaxMessageLengthAtSend ?policy_max_message_length_at_send . }
    OPTIONAL { $this effortless-ntwf:renderedBodyLength ?rendered_body_length . }
                BIND(ROUND(IF(COALESCE((COALESCE(?rendered_body_length, 0) = 0), false), 0, IF(COALESCE((COALESCE(?rendered_body_length, 0) <= COALESCE(?policy_max_message_length_at_send, 0)), false), 1, (CEIL((?rendered_body_length / ?policy_max_message_length_at_send) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double))))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyMaxSegmentsAtSend" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyMaxSegmentsAtSend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:policyChannel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:maxSegments ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsOverSegmentLimit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOverSegmentLimit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyMaxSegmentsAtSend ?policy_max_segments_at_send . }
    OPTIONAL { $this effortless-ntwf:segmentCount ?segment_count . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((COALESCE(?segment_count, 0) > COALESCE(?policy_max_segments_at_send, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_TemplateHasValidApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:templateHasValidApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:hasValidApproval ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsUnapprovedSend" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnapprovedSend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:templateHasValidApproval ?template_has_valid_approval . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((!(COALESCE(?template_has_valid_approval, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyRequiredOptOutPhrase" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyRequiredOptOutPhrase ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:policyChannel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:requiredOptOutPhrase ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyRequiresOptOut" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyRequiresOptOut ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyRequiredOptOutPhrase ?policy_required_opt_out_phrase . OPTIONAL { ?policy_required_opt_out_phrase effortless-ntwf:__key ?policy_required_opt_out_phrase__key . } }
                BIND((COALESCE(?policy_required_opt_out_phrase__key, COALESCE(IF(isIRI(?policy_required_opt_out_phrase), REPLACE(STR(?policy_required_opt_out_phrase), "^.*[#/]", ""), STR(?policy_required_opt_out_phrase)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_OptOutPhrasePosition" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:optOutPhrasePosition ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyRequiredOptOutPhrase ?policy_required_opt_out_phrase . }
    OPTIONAL { $this effortless-ntwf:renderedBody ?rendered_body . }
                BIND(ROUND(IF(CONTAINS(STR(?rendered_body), STR(?policy_required_opt_out_phrase)), STRLEN(STRBEFORE(STR(?rendered_body), STR(?policy_required_opt_out_phrase))) + 1, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_HasOptOutPhrase" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasOptOutPhrase ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:optOutPhrasePosition ?opt_out_phrase_position . }
                BIND((COALESCE(?opt_out_phrase_position, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsOptOutInFirstSegment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOptOutInFirstSegment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:hasOptOutPhrase ?has_opt_out_phrase . }
    OPTIONAL { $this effortless-ntwf:optOutPhrasePosition ?opt_out_phrase_position . }
    OPTIONAL { $this effortless-ntwf:policyMaxMessageLengthAtSend ?policy_max_message_length_at_send . }
                BIND((COALESCE(?has_opt_out_phrase, false) && COALESCE((COALESCE(?opt_out_phrase_position, 0) <= COALESCE(?policy_max_message_length_at_send, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsMissingRequiredOptOut" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMissingRequiredOptOut ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:hasOptOutPhrase ?has_opt_out_phrase . }
    OPTIONAL { $this effortless-ntwf:policyRequiresOptOut ?policy_requires_opt_out . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((COALESCE(?policy_requires_opt_out, false) && COALESCE((!(COALESCE(?has_opt_out_phrase, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsOptOutAtRiskOfTruncation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOptOutAtRiskOfTruncation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:hasOptOutPhrase ?has_opt_out_phrase . }
    OPTIONAL { $this effortless-ntwf:isOptOutInFirstSegment ?is_opt_out_in_first_segment . }
    OPTIONAL { $this effortless-ntwf:policyRequiresOptOut ?policy_requires_opt_out . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((COALESCE(?policy_requires_opt_out, false) && COALESCE((COALESCE(?has_opt_out_phrase, false) && COALESCE((!(COALESCE(?is_opt_out_in_first_segment, false))), false)), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsFailedDelivery" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFailedDelivery ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:deliveryStatus ?delivery_status . OPTIONAL { ?delivery_status effortless-ntwf:__key ?delivery_status__key . } }
                BIND((COALESCE((COALESCE(?delivery_status__key, COALESCE(IF(isIRI(?delivery_status), REPLACE(STR(?delivery_status), "^.*[#/]", ""), STR(?delivery_status)), "")) = "Failed"), false) || COALESCE((COALESCE(?delivery_status__key, COALESCE(IF(isIRI(?delivery_status), REPLACE(STR(?delivery_status), "^.*[#/]", ""), STR(?delivery_status)), "")) = "Bounced"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsSuppressed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSuppressed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:deliveryStatus ?delivery_status . OPTIONAL { ?delivery_status effortless-ntwf:__key ?delivery_status__key . } }
                BIND((COALESCE(?delivery_status__key, COALESCE(IF(isIRI(?delivery_status), REPLACE(STR(?delivery_status), "^.*[#/]", ""), STR(?delivery_status)), "")) = "Suppressed") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsTriaged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isTriaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:invokedException ?invoked_exception . OPTIONAL { ?invoked_exception effortless-ntwf:__key ?invoked_exception__key . } }
                BIND((COALESCE(?invoked_exception__key, COALESCE(IF(isIRI(?invoked_exception), REPLACE(STR(?invoked_exception), "^.*[#/]", ""), STR(?invoked_exception)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsAbandonedFailure" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAbandonedFailure ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isFailedDelivery ?is_failed_delivery . }
    OPTIONAL { $this effortless-ntwf:isTriaged ?is_triaged . }
                BIND((COALESCE(?is_failed_delivery, false) && COALESCE((!(COALESCE(?is_triaged, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_AbandonedFailureExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:abandonedFailureExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isAbandonedFailure ?is_abandoned_failure . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?is_abandoned_failure, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_ReachedExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reachedExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:deliveryStatus ?delivery_status . OPTIONAL { ?delivery_status effortless-ntwf:__key ?delivery_status__key . } }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE((COALESCE(?delivery_status__key, COALESCE(IF(isIRI(?delivery_status), REPLACE(STR(?delivery_status), "^.*[#/]", ""), STR(?delivery_status)), "")) = "Delivered"), false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_TemplateWasSendable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:templateWasSendable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isSendableUnderApproval ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsDriftedSend" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDriftedSend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:templateWasSendable ?template_was_sendable . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((!(COALESCE(?template_was_sendable, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_DriftedSendTemplateKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:driftedSendTemplateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isDriftedSend ?is_drifted_send . }
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . }
                BIND(IF(COALESCE(?is_drifted_send, false), ?message_template, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_WasSentOutsideBusinessHours" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasSentOutsideBusinessHours ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:sentAtLocalHour ?sent_at_local_hour . }
                BIND((COALESCE((COALESCE(?sent_at_local_hour, 0) < 8), false) || COALESCE((COALESCE(?sent_at_local_hour, 0) > 18), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_WasDeliveredAndUnanswered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasDeliveredAndUnanswered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isAcknowledged ?is_acknowledged . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((!(COALESCE(?is_acknowledged, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsPoorlyTimedUnanswered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPoorlyTimedUnanswered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:wasDeliveredAndUnanswered ?was_delivered_and_unanswered . }
    OPTIONAL { $this effortless-ntwf:wasSentOutsideBusinessHours ?was_sent_outside_business_hours . }
                BIND((COALESCE(?was_delivered_and_unanswered, false) && COALESCE(?was_sent_outside_business_hours, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsWellTimedUnanswered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWellTimedUnanswered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:wasDeliveredAndUnanswered ?was_delivered_and_unanswered . }
    OPTIONAL { $this effortless-ntwf:wasSentOutsideBusinessHours ?was_sent_outside_business_hours . }
                BIND((COALESCE(?was_delivered_and_unanswered, false) && COALESCE((!(COALESCE(?was_sent_outside_business_hours, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_UnansweredTemplateKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unansweredTemplateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . }
    OPTIONAL { $this effortless-ntwf:wasDeliveredAndUnanswered ?was_delivered_and_unanswered . }
                BIND(IF(COALESCE(?was_delivered_and_unanswered, false), ?message_template, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_TransmittedTemplateKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:transmittedTemplateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND(IF(COALESCE(?was_actually_transmitted, false), ?message_template, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_ApprovalPrecededSend" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approvalPrecededSend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:approvalDecidedAtSend ?approval_decided_at_send . OPTIONAL { ?approval_decided_at_send effortless-ntwf:__key ?approval_decided_at_send__key . } }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND((COALESCE((COALESCE(?approval_decided_at_send__key, COALESCE(IF(isIRI(?approval_decided_at_send), REPLACE(STR(?approval_decided_at_send), "^.*[#/]", ""), STR(?approval_decided_at_send)), "")) != ""), false) && COALESCE(COALESCE((?sent_at > ?approval_decided_at_send), false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_HasFrozenApprovalEvidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasFrozenApprovalEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:approvalDecidedAtSend ?approval_decided_at_send . OPTIONAL { ?approval_decided_at_send effortless-ntwf:__key ?approval_decided_at_send__key . } }
    OPTIONAL { $this effortless-ntwf:approvingAgentAtSend ?approving_agent_at_send . OPTIONAL { ?approving_agent_at_send effortless-ntwf:__key ?approving_agent_at_send__key . } }
                BIND((COALESCE((COALESCE(?approving_agent_at_send__key, COALESCE(IF(isIRI(?approving_agent_at_send), REPLACE(STR(?approving_agent_at_send), "^.*[#/]", ""), STR(?approving_agent_at_send)), "")) != ""), false) && COALESCE((COALESCE(?approval_decided_at_send__key, COALESCE(IF(isIRI(?approval_decided_at_send), REPLACE(STR(?approval_decided_at_send), "^.*[#/]", ""), STR(?approval_decided_at_send)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_ProvenanceIsLiveDerived" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:provenanceIsLiveDerived ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:hasFrozenApprovalEvidence ?has_frozen_approval_evidence . }
                BIND((!(COALESCE(?has_frozen_approval_evidence, false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_CurrentLastApprovalAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentLastApprovalAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:lastApprovalAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_TemplateReapprovedSinceSend" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:templateReapprovedSinceSend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:currentLastApprovalAt ?current_last_approval_at . OPTIONAL { ?current_last_approval_at effortless-ntwf:__key ?current_last_approval_at__key . } }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND((COALESCE((COALESCE(?current_last_approval_at__key, COALESCE(IF(isIRI(?current_last_approval_at), REPLACE(STR(?current_last_approval_at), "^.*[#/]", ""), STR(?current_last_approval_at)), "")) != ""), false) && COALESCE(COALESCE((?current_last_approval_at > ?sent_at), false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsUnprovableApprovalClaim" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnprovableApprovalClaim ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:provenanceIsLiveDerived ?provenance_is_live_derived . }
    OPTIONAL { $this effortless-ntwf:templateHasValidApproval ?template_has_valid_approval . }
    OPTIONAL { $this effortless-ntwf:templateReapprovedSinceSend ?template_reapproved_since_send . }
                BIND((COALESCE(?provenance_is_live_derived, false) && COALESCE((COALESCE(?template_reapproved_since_send, false) && COALESCE(?template_has_valid_approval, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_HasSentReminder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasSentReminder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:reminderCount ?reminder_count . }
                BIND((COALESCE(?reminder_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_AcknowledgementIsOutstanding" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:acknowledgementIsOutstanding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isAcknowledged ?is_acknowledged . }
    OPTIONAL { $this effortless-ntwf:isEvidenceRequired ?is_evidence_required . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((COALESCE(?is_evidence_required, false) && COALESCE((!(COALESCE(?is_acknowledged, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_OutstandingAgeDays" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:outstandingAgeDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:acknowledgementIsOutstanding ?acknowledgement_is_outstanding . }
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND(ROUND(IF(COALESCE(?acknowledgement_is_outstanding, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?sent_at) + FLOOR((153 * (MONTH(?sent_at) + 12 * FLOOR((14 - MONTH(?sent_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 4) - FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 100) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsUnchasedAcknowledgement" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnchasedAcknowledgement ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:acknowledgementIsOutstanding ?acknowledgement_is_outstanding . }
    OPTIONAL { $this effortless-ntwf:hasSentReminder ?has_sent_reminder . }
    OPTIONAL { $this effortless-ntwf:outstandingAgeDays ?outstanding_age_days . }
                BIND((COALESCE(?acknowledgement_is_outstanding, false) && COALESCE((COALESCE((COALESCE(?outstanding_age_days, 0) > 7), false) && COALESCE((!(COALESCE(?has_sent_reminder, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsExhaustedFollowUp" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isExhaustedFollowUp ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:acknowledgementIsOutstanding ?acknowledgement_is_outstanding . }
    OPTIONAL { $this effortless-ntwf:reminderCount ?reminder_count . }
                BIND((COALESCE(?acknowledgement_is_outstanding, false) && COALESCE((COALESCE(?reminder_count, 0) >= 3), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_NeedsHumanEscalation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:needsHumanEscalation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:hasUnreachableExceptionInvoked ?has_unreachable_exception_invoked . }
    OPTIONAL { $this effortless-ntwf:isExhaustedFollowUp ?is_exhausted_follow_up . }
                BIND((COALESCE(?is_exhausted_follow_up, false) && COALESCE((!(COALESCE(?has_unreachable_exception_invoked, false))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for MessageTemplates ===
effortless-ntwf:MessageTemplatesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:MessageTemplates ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:communicationPolicy ?communication_policy . OPTIONAL { ?communication_policy effortless-ntwf:__key ?communication_policy__key . } }
    OPTIONAL { $this effortless-ntwf:locale ?locale . OPTIONAL { ?locale effortless-ntwf:__key ?locale__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?communication_policy__key, IF(isIRI(?communication_policy), REPLACE(STR(?communication_policy), "^.*[#/]", ""), STR(?communication_policy))), ""), " / ", COALESCE(COALESCE(?locale__key, IF(isIRI(?locale), REPLACE(STR(?locale), "^.*[#/]", ""), STR(?locale))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_PolicyMaxMessageLength" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyMaxMessageLength ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                OPTIONAL { $this effortless-ntwf:communicationPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:maxMessageLength ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_PolicyMaxSegments" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyMaxSegments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                OPTIONAL { $this effortless-ntwf:communicationPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:maxSegments ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_BodyTemplateLength" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:bodyTemplateLength ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:bodyTemplate ?body_template . }
                BIND(ROUND(STRLEN(STR(?body_template))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_IsTemplateOverLength" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isTemplateOverLength ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:bodyTemplateLength ?body_template_length . }
    OPTIONAL { $this effortless-ntwf:policyMaxMessageLength ?policy_max_message_length . }
                BIND((COALESCE(?body_template_length, 0) > COALESCE(?policy_max_message_length, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_ValidApprovalCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:validApprovalCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TemplateApprovals .
                    ?child effortless-ntwf:validApprovalTemplateKey ?backfk .
                    $this effortless-ntwf:messageTemplateId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_HasValidApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasValidApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:validApprovalCount ?valid_approval_count . }
                BIND((COALESCE(?valid_approval_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_IsClaimingUnbackedApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isClaimingUnbackedApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:hasValidApproval ?has_valid_approval . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) && COALESCE((!(COALESCE(?has_valid_approval, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_LastApprovedBodyHash" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lastApprovedBodyHash ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                OPTIONAL { $this effortless-ntwf:lastValidApproval ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:TemplateApprovals ; effortless-ntwf:templateApprovalId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:approvedBodyHash ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_HasBodyDrifted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasBodyDrifted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:currentBodyHash ?current_body_hash . }
    OPTIONAL { $this effortless-ntwf:lastApprovedBodyHash ?last_approved_body_hash . OPTIONAL { ?last_approved_body_hash effortless-ntwf:__key ?last_approved_body_hash__key . } }
                BIND((COALESCE((COALESCE(?last_approved_body_hash__key, COALESCE(IF(isIRI(?last_approved_body_hash), REPLACE(STR(?last_approved_body_hash), "^.*[#/]", ""), STR(?last_approved_body_hash)), "")) != ""), false) && COALESCE(COALESCE((?current_body_hash != ?last_approved_body_hash), !((!BOUND(?current_body_hash) || STR(?current_body_hash) = "") && (!BOUND(?last_approved_body_hash) || STR(?last_approved_body_hash) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_IsSendableUnderApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSendableUnderApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:hasBodyDrifted ?has_body_drifted . }
    OPTIONAL { $this effortless-ntwf:hasValidApproval ?has_valid_approval . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) && COALESCE((COALESCE(?has_valid_approval, false) && COALESCE((!(COALESCE(?has_body_drifted, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_DriftedSendCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:driftedSendCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MessageDeliveries .
                    ?child effortless-ntwf:driftedSendTemplateKey ?backfk .
                    $this effortless-ntwf:messageTemplateId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_UnansweredDeliveryCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unansweredDeliveryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MessageDeliveries .
                    ?child effortless-ntwf:unansweredTemplateKey ?backfk .
                    $this effortless-ntwf:messageTemplateId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_TransmittedDeliveryCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:transmittedDeliveryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MessageDeliveries .
                    ?child effortless-ntwf:transmittedTemplateKey ?backfk .
                    $this effortless-ntwf:messageTemplateId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_TemplateDrawsNoResponse" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:templateDrawsNoResponse ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:transmittedDeliveryCount ?transmitted_delivery_count . }
    OPTIONAL { $this effortless-ntwf:unansweredDeliveryCount ?unanswered_delivery_count . }
                BIND((COALESCE((COALESCE(?transmitted_delivery_count, 0) > 0), false) && COALESCE((COALESCE(?unanswered_delivery_count, 0) = COALESCE(?transmitted_delivery_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_LastApprovalAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lastApprovalAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                OPTIONAL { $this effortless-ntwf:lastValidApproval ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:TemplateApprovals ; effortless-ntwf:templateApprovalId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:decidedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for MethodApplications ===
effortless-ntwf:MethodApplicationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:MethodApplications ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MethodApplications_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MethodApplications .
    OPTIONAL { $this effortless-ntwf:appliedTo ?applied_to . }
    OPTIONAL { $this effortless-ntwf:knowledgeMethod ?knowledge_method . OPTIONAL { ?knowledge_method effortless-ntwf:__key ?knowledge_method__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?knowledge_method__key, IF(isIRI(?knowledge_method), REPLACE(STR(?knowledge_method), "^.*[#/]", ""), STR(?knowledge_method))), ""), " applied: ", COALESCE(IF(isIRI(SUBSTR(STR(?applied_to), 1, 50)), REPLACE(STR(SUBSTR(STR(?applied_to), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?applied_to), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for MinedFlowEdges ===
effortless-ntwf:MinedFlowEdgesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:MinedFlowEdges ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MinedFlowEdges_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MinedFlowEdges .
    OPTIONAL { $this effortless-ntwf:fromStep ?from_step . OPTIONAL { ?from_step effortless-ntwf:__key ?from_step__key . } }
    OPTIONAL { $this effortless-ntwf:toStep ?to_step . OPTIONAL { ?to_step effortless-ntwf:__key ?to_step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_step__key, IF(isIRI(?from_step), REPLACE(STR(?from_step), "^.*[#/]", ""), STR(?from_step))), ""), " -> ", COALESCE(COALESCE(?to_step__key, IF(isIRI(?to_step), REPLACE(STR(?to_step), "^.*[#/]", ""), STR(?to_step))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MinedFlowEdges_DocumentedTransitionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:documentedTransitionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MinedFlowEdges .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepTransitions .
                    ?child effortless-ntwf:fromStep ?backfk .
                    $this effortless-ntwf:fromStep ?backpv .
                    OPTIONAL { ?child effortless-ntwf:toStep ?c2 . }
                    OPTIONAL { $this effortless-ntwf:toStep ?p2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(REPLACE(STR(?c2), "^.*[#/]", "") = REPLACE(STR(?p2), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MinedFlowEdges_IsUndocumentedPath" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUndocumentedPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MinedFlowEdges .
    OPTIONAL { $this effortless-ntwf:documentedTransitionCount ?documented_transition_count . }
                BIND((COALESCE(?documented_transition_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MinedFlowEdges_ToStepExpectedMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:toStepExpectedMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MinedFlowEdges .
                OPTIONAL { $this effortless-ntwf:toStep ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:expectedDurationMinutes ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MinedFlowEdges_IsBottleneck" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBottleneck ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MinedFlowEdges .
    OPTIONAL { $this effortless-ntwf:medianWaitMinutes ?median_wait_minutes . }
    OPTIONAL { $this effortless-ntwf:toStepExpectedMinutes ?to_step_expected_minutes . }
                BIND((COALESCE((COALESCE(?to_step_expected_minutes, 0) > 0), false) && COALESCE((COALESCE(?median_wait_minutes, 0) > COALESCE((4 * ?to_step_expected_minutes), 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MinedFlowEdges_IsMinedPathRecordedAsIntentWithoutDecision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMinedPathRecordedAsIntentWithoutDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MinedFlowEdges .
    OPTIONAL { $this effortless-ntwf:intentDecisionBy ?intent_decision_by . OPTIONAL { ?intent_decision_by effortless-ntwf:__key ?intent_decision_by__key . } }
    OPTIONAL { $this effortless-ntwf:recordedStance ?recorded_stance . OPTIONAL { ?recorded_stance effortless-ntwf:__key ?recorded_stance__key . } }
                BIND((COALESCE((COALESCE(?recorded_stance__key, COALESCE(IF(isIRI(?recorded_stance), REPLACE(STR(?recorded_stance), "^.*[#/]", ""), STR(?recorded_stance)), "")) = "Intended"), false) && COALESCE((COALESCE(?intent_decision_by__key, COALESCE(IF(isIRI(?intent_decision_by), REPLACE(STR(?intent_decision_by), "^.*[#/]", ""), STR(?intent_decision_by)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ModelActivityExperts ===
effortless-ntwf:ModelActivityExpertsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelActivityExperts ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelActivityExperts_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelActivityExperts .
    OPTIONAL { $this effortless-ntwf:expert ?expert . OPTIONAL { ?expert effortless-ntwf:__key ?expert__key . } }
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
    OPTIONAL { $this effortless-ntwf:lotActivity ?lot_activity . OPTIONAL { ?lot_activity effortless-ntwf:__key ?lot_activity__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " ", COALESCE(COALESCE(?lot_activity__key, IF(isIRI(?lot_activity), REPLACE(STR(?lot_activity), "^.*[#/]", ""), STR(?lot_activity))), ""), " ", COALESCE(COALESCE(?expert__key, IF(isIRI(?expert), REPLACE(STR(?expert), "^.*[#/]", ""), STR(?expert))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ModelAnnotations ===
effortless-ntwf:ModelAnnotationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelAnnotations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelAnnotations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelAnnotations .
    OPTIONAL { $this effortless-ntwf:annotationKind ?annotation_kind . OPTIONAL { ?annotation_kind effortless-ntwf:__key ?annotation_kind__key . } }
    OPTIONAL { $this effortless-ntwf:body ?body . }
                BIND(CONCAT(COALESCE(COALESCE(?annotation_kind__key, IF(isIRI(?annotation_kind), REPLACE(STR(?annotation_kind), "^.*[#/]", ""), STR(?annotation_kind))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?body), 1, 50)), REPLACE(STR(SUBSTR(STR(?body), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?body), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelAnnotations_IsDiscussionInAuthoritativeModel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDiscussionInAuthoritativeModel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelAnnotations .
    OPTIONAL { $this effortless-ntwf:annotationKind ?annotation_kind . OPTIONAL { ?annotation_kind effortless-ntwf:__key ?annotation_kind__key . } }
    OPTIONAL { $this effortless-ntwf:storedIn ?stored_in . OPTIONAL { ?stored_in effortless-ntwf:__key ?stored_in__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?annotation_kind__key, COALESCE(IF(isIRI(?annotation_kind), REPLACE(STR(?annotation_kind), "^.*[#/]", ""), STR(?annotation_kind)), "")) = "Comment"), false) || COALESCE((COALESCE(?annotation_kind__key, COALESCE(IF(isIRI(?annotation_kind), REPLACE(STR(?annotation_kind), "^.*[#/]", ""), STR(?annotation_kind)), "")) = "Question"), false) || COALESCE((COALESCE(?annotation_kind__key, COALESCE(IF(isIRI(?annotation_kind), REPLACE(STR(?annotation_kind), "^.*[#/]", ""), STR(?annotation_kind)), "")) = "Suggestion"), false) || COALESCE((COALESCE(?annotation_kind__key, COALESCE(IF(isIRI(?annotation_kind), REPLACE(STR(?annotation_kind), "^.*[#/]", ""), STR(?annotation_kind)), "")) = "AlternativeInterpretation"), false)), false) && COALESCE((COALESCE(?stored_in__key, COALESCE(IF(isIRI(?stored_in), REPLACE(STR(?stored_in), "^.*[#/]", ""), STR(?stored_in)), "")) = "AuthoritativeRulebook"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelAnnotations_FlagBypassedAnnotationInterface" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:flagBypassedAnnotationInterface ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelAnnotations .
    OPTIONAL { $this effortless-ntwf:annotationKind ?annotation_kind . OPTIONAL { ?annotation_kind effortless-ntwf:__key ?annotation_kind__key . } }
    OPTIONAL { $this effortless-ntwf:enteredThrough ?entered_through . OPTIONAL { ?entered_through effortless-ntwf:__key ?entered_through__key . } }
                BIND((COALESCE((COALESCE(?annotation_kind__key, COALESCE(IF(isIRI(?annotation_kind), REPLACE(STR(?annotation_kind), "^.*[#/]", ""), STR(?annotation_kind)), "")) = "FlagOutdated"), false) && COALESCE((COALESCE(?entered_through__key, COALESCE(IF(isIRI(?entered_through), REPLACE(STR(?entered_through), "^.*[#/]", ""), STR(?entered_through)), "")) != "AnnotationPanel"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelAnnotations_IsLostNewKnowledge" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLostNewKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelAnnotations .
    OPTIONAL { $this effortless-ntwf:annotationKind ?annotation_kind . OPTIONAL { ?annotation_kind effortless-ntwf:__key ?annotation_kind__key . } }
    OPTIONAL { $this effortless-ntwf:promotedToFragment ?promoted_to_fragment . OPTIONAL { ?promoted_to_fragment effortless-ntwf:__key ?promoted_to_fragment__key . } }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?annotation_kind__key, COALESCE(IF(isIRI(?annotation_kind), REPLACE(STR(?annotation_kind), "^.*[#/]", ""), STR(?annotation_kind)), "")) = "NewKnowledge"), false) && COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) != "Declined"), false) && COALESCE((COALESCE(?promoted_to_fragment__key, COALESCE(IF(isIRI(?promoted_to_fragment), REPLACE(STR(?promoted_to_fragment), "^.*[#/]", ""), STR(?promoted_to_fragment)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelAnnotations_IsFrictionWithoutGap" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
