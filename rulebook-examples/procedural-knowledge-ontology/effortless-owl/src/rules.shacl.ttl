    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:humanIntegrityCheckCount ?human_integrity_check_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:integrityCheckCount ?integrity_check_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAccepted ?is_accepted . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isSchemaChange ?is_schema_change . }
                BIND((COALESCE(?is_accepted, false) && COALESCE(?is_schema_change, false) && COALESCE((COALESCE(?integrity_check_count, 0) > 0), false) && COALESCE((COALESCE(?human_integrity_check_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ModelChangeRequests_SkippedDisjointnessReview a sh:NodeShape ;
    sh:targetClass pko-extension:ModelChangeRequest ;
