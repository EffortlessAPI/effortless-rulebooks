            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnansweredPastDue ?_result .
            }
            WHERE {
    $this a pko-extension:StakeholderQuestion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:answeredAt ?answered_at . OPTIONAL { ?answered_at erb:key ?answered_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysOpen ?days_open . }
                BIND((COALESCE((COALESCE(?answered_at__key, COALESCE(IF(isIRI(?answered_at), REPLACE(STR(?answered_at), "^.*[#/]", ""), STR(?answered_at)), "")) = ""), false) && COALESCE((COALESCE(?days_open, 0) > 14), false)) AS ?_result)
            }
        """ ;
    ] .
