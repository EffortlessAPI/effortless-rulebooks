    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:incomingTransitionCount ?incoming_transition_count . }
                BIND((COALESCE(?incoming_transition_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_EntryStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
