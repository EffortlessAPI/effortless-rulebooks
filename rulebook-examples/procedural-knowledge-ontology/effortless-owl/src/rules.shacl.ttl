            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeBrokerLink .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeBrokerLinks_DaysSinceConsulted a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeBrokerLink ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_DaysSinceConsulted" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceConsulted ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeBrokerLink .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastConsultedAt ?last_consulted_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_consulted_at) + FLOOR((153 * (MONTH(?last_consulted_at) + 12 * FLOOR((14 - MONTH(?last_consulted_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) + FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 4) - FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 100) + FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeBrokerLinks_IsActiveReliance a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeBrokerLink ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_IsActiveReliance" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isActiveReliance ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeBrokerLink .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceConsulted ?days_since_consulted . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:frequency ?frequency . OPTIONAL { ?frequency erb:key ?frequency__key . } }
                BIND((COALESCE((!(COALESCE((COALESCE(?frequency__key, COALESCE(IF(isIRI(?frequency), REPLACE(STR(?frequency), "^.*[#/]", ""), STR(?frequency)), "")) = "Rarely"), false))), false) && COALESCE((COALESCE(?days_since_consulted, 0) <= 180), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeBrokerLinks_BrokerIsStillEngaged a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeBrokerLink ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_BrokerIsStillEngaged" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:brokerIsStillEngaged ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeBrokerLink .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:broker ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isStillEngaged ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeBrokerLinks_IsAtRiskReliance a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeBrokerLink ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_IsAtRiskReliance" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isAtRiskReliance ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeBrokerLink .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:brokerIsStillEngaged ?broker_is_still_engaged . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isActiveReliance ?is_active_reliance . }
                BIND((COALESCE(?is_active_reliance, false) && COALESCE((!(COALESCE(?broker_is_still_engaged, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeBrokerLinks_ActiveRelianceBrokerKey a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeBrokerLink ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_ActiveRelianceBrokerKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:activeRelianceBrokerKey ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeBrokerLink .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:broker ?broker . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isActiveReliance ?is_active_reliance . }
                BIND(IF(COALESCE(?is_active_reliance, false), ?broker, "") AS ?_result)
            }
        """ ;
    ] .
