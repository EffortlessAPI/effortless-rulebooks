            }
            WHERE {
    $this a pko-extension:OnboardingRecord .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceStart ?days_since_start . }
                BIND((COALESCE((COALESCE(?days_since_start, 0) >= 0), false) && COALESCE((COALESCE(?days_since_start, 0) <= 180), false)) AS ?_result)
            }
        """ ;
    ] .
