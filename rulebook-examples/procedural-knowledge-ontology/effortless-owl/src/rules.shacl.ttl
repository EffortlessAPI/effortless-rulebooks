pko-native-procedural-knowledge-rulebook-shapes:ReviewEvents_Name a sh:NodeShape ;
    sh:targetClass pko:ReviewEvent ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:ReviewEvent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version erb:key ?procedure_version__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reviewKind ?review_kind . OPTIONAL { ?review_kind erb:key ?review_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " / ", COALESCE(COALESCE(?review_kind__key, IF(isIRI(?review_kind), REPLACE(STR(?review_kind), "^.*[#/]", ""), STR(?review_kind))), "")) AS ?_result)
            }
        """ ;
    ] .
