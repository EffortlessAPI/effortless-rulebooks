                $this pko-native-procedural-knowledge-rulebook:coincidedWithFailedCondition ?_result .
            }
            WHERE {
    $this a pko:IssueOccurrence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:failedConditionCountOnRun ?failed_condition_count_on_run . }
                BIND((COALESCE(?failed_condition_count_on_run, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:IssueOccurrences_HasNoRecordedSolution a sh:NodeShape ;
    sh:targetClass pko:IssueOccurrence ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
