            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isVeteranDiscretion ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeHolding .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:handlesExceptionOrDiscretion ?handles_exception_or_discretion . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holderIsVeteran ?holder_is_veteran . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isUnformalizedProcessKnowledge ?is_unformalized_process_knowledge . }
                BIND((COALESCE(?holder_is_veteran, false) && COALESCE(?handles_exception_or_discretion, false) && COALESCE(?is_unformalized_process_knowledge, false)) AS ?_result)
            }
        """ ;
    ] .
