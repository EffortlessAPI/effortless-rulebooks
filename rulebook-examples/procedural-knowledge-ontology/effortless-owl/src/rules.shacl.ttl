            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isWritableDerivedField ?_result .
            }
            WHERE {
    $this a pko-extension:FieldGrant .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:canWrite ?can_write . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fieldIsDerived ?field_is_derived . }
                BIND((COALESCE(?can_write, false) && COALESCE(?field_is_derived, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:FieldGrants_IsMasked a sh:NodeShape ;
    sh:targetClass pko-extension:FieldGrant ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_IsMasked" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isMasked ?_result .
            }
            WHERE {
    $this a pko-extension:FieldGrant .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:maskStrategy ?mask_strategy . OPTIONAL { ?mask_strategy erb:key ?mask_strategy__key . } }
                BIND((COALESCE((COALESCE(?mask_strategy__key, COALESCE(IF(isIRI(?mask_strategy), REPLACE(STR(?mask_strategy), "^.*[#/]", ""), STR(?mask_strategy)), "")) != "plain"), false) && COALESCE((COALESCE(?mask_strategy__key, COALESCE(IF(isIRI(?mask_strategy), REPLACE(STR(?mask_strategy), "^.*[#/]", ""), STR(?mask_strategy)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:FieldGrants_GrantKeyWhenReadable a sh:NodeShape ;
    sh:targetClass pko-extension:FieldGrant ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_GrantKeyWhenReadable" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:grantKeyWhenReadable ?_result .
            }
            WHERE {
    $this a pko-extension:FieldGrant .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:canRead ?can_read . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fieldTable ?field_table . OPTIONAL { ?field_table erb:key ?field_table__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:principal ?principal . OPTIONAL { ?principal erb:key ?principal__key . } }
                BIND(IF(COALESCE(?can_read, false), CONCAT(COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), ""), "|", COALESCE(COALESCE(?field_table__key, IF(isIRI(?field_table), REPLACE(STR(?field_table), "^.*[#/]", ""), STR(?field_table))), "")), "") AS ?_result)
            }
        """ ;
    ] .

