            CONSTRUCT {
                $this effortless-ntwf:realDataMappingRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelDataMappingRuns .
                    ?child effortless-ntwf:governedModel $this .
                    OPTIONAL { ?child effortless-ntwf:dataOrigin ?c2 . }
                    FILTER((STR(?c2) = "Real"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_IsImplementedWithoutRealData" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
