    OPTIONAL { $this effortless-ntwf:procedureType ?procedure_type . OPTIONAL { ?procedure_type effortless-ntwf:__key ?procedure_type__key . } }
                BIND((COALESCE((COALESCE(?procedure_type__key, COALESCE(IF(isIRI(?procedure_type), REPLACE(STR(?procedure_type), "^.*[#/]", ""), STR(?procedure_type)), "")) != ""), false) && COALESCE((COALESCE(?matching_distinction_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
