pko-native-procedural-knowledge-rulebook-shapes:KnowHowCarriers_TransferCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowHowCarrier ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_TransferCount" ;
