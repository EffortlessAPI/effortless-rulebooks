            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isComplianceOnly ?_result .
            }
            WHERE {
    $this a pko-extension:CorporateGovernanceProgram .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:coversCompliance ?covers_compliance . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:coversDataQuality ?covers_data_quality . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:coversInformationManagement ?covers_information_management . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:coversKnowledgeManagement ?covers_knowledge_management . }
                BIND((COALESCE(?covers_compliance, false) && COALESCE((COALESCE(?covers_data_quality, false) = false), false) && COALESCE((COALESCE(?covers_information_management, false) = false), false) && COALESCE((COALESCE(?covers_knowledge_management, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for CriticalIncidents ===
pko-native-procedural-knowledge-rulebook-shapes:CriticalIncidents_Name a sh:NodeShape ;
    sh:targetClass pko-extension:CriticalIncident ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CriticalIncidents_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:CriticalIncident .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:account ?account . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:outcome ?outcome . OPTIONAL { ?outcome erb:key ?outcome__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?outcome__key, IF(isIRI(?outcome), REPLACE(STR(?outcome), "^.*[#/]", ""), STR(?outcome))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?account), 1, 60)), REPLACE(STR(SUBSTR(STR(?account), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?account), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CriticalIncidents_IsAdverseOrImprovised a sh:NodeShape ;
    sh:targetClass pko-extension:CriticalIncident ;
