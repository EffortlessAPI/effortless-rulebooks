            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
    OPTIONAL { $this effortless-ntwf:changeOperation ?change_operation . OPTIONAL { ?change_operation effortless-ntwf:__key ?change_operation__key . } }
    OPTIONAL { $this effortless-ntwf:postDeployInferenceCount ?post_deploy_inference_count . }
                BIND((COALESCE((COALESCE(?change_operation__key, COALESCE(IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation)), "")) = "ChangeDomainRange"), false) && COALESCE((COALESCE(?post_deploy_inference_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_IntuitiveDisjointnessBrokeIndividuals" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intuitiveDisjointnessBrokeIndividuals ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
    OPTIONAL { $this effortless-ntwf:assessedInconsistentCount ?assessed_inconsistent_count . }
    OPTIONAL { $this effortless-ntwf:changeOperation ?change_operation . OPTIONAL { ?change_operation effortless-ntwf:__key ?change_operation__key . } }
    OPTIONAL { $this effortless-ntwf:lacksMotivatingQuestion ?lacks_motivating_question . }
    OPTIONAL { $this effortless-ntwf:postDeployInconsistentCount ?post_deploy_inconsistent_count . }
                BIND((COALESCE((COALESCE(?change_operation__key, COALESCE(IF(isIRI(?change_operation), REPLACE(STR(?change_operation), "^.*[#/]", ""), STR(?change_operation)), "")) = "AddDisjointness"), false) && COALESCE(?lacks_motivating_question, false) && COALESCE((COALESCE((?assessed_inconsistent_count + ?post_deploy_inconsistent_count), 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_ValidationRunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:validationRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeValidationRuns .
                    ?child effortless-ntwf:modelChangeRequest $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_AcceptanceFailureTotal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:acceptanceFailureTotal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:ChangeValidationRuns .
                    ?child effortless-ntwf:modelChangeRequest $this .
                    OPTIONAL { ?child effortless-ntwf:runPurpose ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:failureCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER((STR(?c2) = "Acceptance"))
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_StructuralPassCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:structuralPassCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeValidationRuns .
                    ?child effortless-ntwf:modelChangeRequest $this .
                    OPTIONAL { ?child effortless-ntwf:structuralCheckOutcome ?c2 . }
                    FILTER((STR(?c2) = "Pass"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_VocabularyPassCount" ;
