pko-native-procedural-knowledge-rulebook-shapes:ModelExpansionRequests_ConceptCount a sh:NodeShape ;
    sh:targetClass pko-extension:ModelExpansionRequest ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelExpansionRequests_ConceptCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:conceptCount ?_result .
            }
            WHERE {
    $this a pko-extension:ModelExpansionRequest .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ModelExpansionRequest .
                    ?child a pko-extension:ExpansionConceptFit .
                    ?child pko-native-procedural-knowledge-rulebook:modelExpansionRequest $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ModelExpansionRequests_UncoveredConceptCount a sh:NodeShape ;
    sh:targetClass pko-extension:ModelExpansionRequest ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelExpansionRequests_UncoveredConceptCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:uncoveredConceptCount ?_result .
            }
            WHERE {
    $this a pko-extension:ModelExpansionRequest .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ModelExpansionRequest .
                    ?child a pko-extension:ExpansionConceptFit .
                    ?child pko-native-procedural-knowledge-rulebook:modelExpansionRequest $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isUncovered ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ModelExpansionRequests_IsCrossFunctionExpansion a sh:NodeShape ;
    sh:targetClass pko-extension:ModelExpansionRequest ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelExpansionRequests_IsCrossFunctionExpansion" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isCrossFunctionExpansion ?_result .
            }
            WHERE {
    $this a pko-extension:ModelExpansionRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelDomainOwner ?model_domain_owner . OPTIONAL { ?model_domain_owner erb:key ?model_domain_owner__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requestingOrganization ?requesting_organization . OPTIONAL { ?requesting_organization erb:key ?requesting_organization__key . } }
                BIND((COALESCE((COALESCE(?requesting_organization__key, COALESCE(IF(isIRI(?requesting_organization), REPLACE(STR(?requesting_organization), "^.*[#/]", ""), STR(?requesting_organization)), "")) != ""), false) && COALESCE((COALESCE(?model_domain_owner__key, COALESCE(IF(isIRI(?model_domain_owner), REPLACE(STR(?model_domain_owner), "^.*[#/]", ""), STR(?model_domain_owner)), "")) != ""), false) && COALESCE(COALESCE((?requesting_organization != ?model_domain_owner), !((!BOUND(?requesting_organization) || STR(?requesting_organization) = "") && (!BOUND(?model_domain_owner) || STR(?model_domain_owner) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ModelExpansionRequests_RequiresSchemaExtension a sh:NodeShape ;
    sh:targetClass pko-extension:ModelExpansionRequest ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelExpansionRequests_RequiresSchemaExtension" ;
