            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:declaredVerificationCount ?_result .
            }
            WHERE {
    $this a p-plan:Step .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a p-plan:Step .
                    ?child a pko-native-procedural-knowledge-rulebook:StepVerifications .
                    ?child pko-native-procedural-knowledge-rulebook:step $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Steps_IsPreparationStep a sh:NodeShape ;
    sh:targetClass p-plan:Step ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsPreparationStep" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isPreparationStep ?_result .
            }
            WHERE {
    $this a p-plan:Step .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:assignedRole ?assigned_role . OPTIONAL { ?assigned_role erb:key ?assigned_role__key . } }
                BIND((COALESCE((COALESCE(?assigned_role__key, COALESCE(IF(isIRI(?assigned_role), REPLACE(STR(?assigned_role), "^.*[#/]", ""), STR(?assigned_role)), "")) = "finance-analyst"), false) || COALESCE((COALESCE(?assigned_role__key, COALESCE(IF(isIRI(?assigned_role), REPLACE(STR(?assigned_role), "^.*[#/]", ""), STR(?assigned_role)), "")) = "variance-review-agent"), false)) AS ?_result)
            }
        """ ;
