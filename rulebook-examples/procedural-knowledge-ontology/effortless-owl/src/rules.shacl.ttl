                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for InterviewProbes ===
effortless-ntwf:InterviewProbesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InterviewProbes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InterviewProbes_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InterviewProbes .
    OPTIONAL { $this effortless-ntwf:probeKind ?probe_kind . OPTIONAL { ?probe_kind effortless-ntwf:__key ?probe_kind__key . } }
    OPTIONAL { $this effortless-ntwf:prompt ?prompt . }
                BIND(CONCAT(COALESCE(COALESCE(?probe_kind__key, IF(isIRI(?probe_kind), REPLACE(STR(?probe_kind), "^.*[#/]", ""), STR(?probe_kind))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?prompt), 1, 60)), REPLACE(STR(SUBSTR(STR(?prompt), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?prompt), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InterviewProbes_WhyAnswer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:whyAnswer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InterviewProbes .
    OPTIONAL { $this effortless-ntwf:answer ?answer . }
    OPTIONAL { $this effortless-ntwf:probeKind ?probe_kind . OPTIONAL { ?probe_kind effortless-ntwf:__key ?probe_kind__key . } }
                BIND(IF(COALESCE((COALESCE(?probe_kind__key, COALESCE(IF(isIRI(?probe_kind), REPLACE(STR(?probe_kind), "^.*[#/]", ""), STR(?probe_kind)), "")) = "Why"), false), ?answer, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InterviewProbes_ShortfallAnswer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:shortfallAnswer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InterviewProbes .
    OPTIONAL { $this effortless-ntwf:answer ?answer . }
    OPTIONAL { $this effortless-ntwf:probeKind ?probe_kind . OPTIONAL { ?probe_kind effortless-ntwf:__key ?probe_kind__key . } }
                BIND(IF(COALESCE((COALESCE(?probe_kind__key, COALESCE(IF(isIRI(?probe_kind), REPLACE(STR(?probe_kind), "^.*[#/]", ""), STR(?probe_kind)), "")) = "ProcedureFallsShort"), false), ?answer, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for IssueOccurrences ===
effortless-ntwf:IssueOccurrencesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IssueOccurrences ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:error ?error . OPTIONAL { ?error effortless-ntwf:__key ?error__key . } }
    OPTIONAL { $this effortless-ntwf:occurredAt ?occurred_at . OPTIONAL { ?occurred_at effortless-ntwf:__key ?occurred_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?error__key, IF(isIRI(?error), REPLACE(STR(?error), "^.*[#/]", ""), STR(?error))), ""), " @ ", COALESCE(REPLACE(COALESCE(?occurred_at__key, IF(isIRI(?occurred_at), REPLACE(STR(?occurred_at), "^.*[#/]", ""), STR(?occurred_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_IsUnresolved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnresolved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Open"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Investigating"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Monitoring"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_StepExecutionWhenUnresolved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepExecutionWhenUnresolved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:isUnresolved ?is_unresolved . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_unresolved, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_ExecutedStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:executedStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_FailedConditionCountOnRun" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:failedConditionCountOnRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:stepExecutionId ?backfk .
                    $this effortless-ntwf:stepExecution ?backpv .
                    OPTIONAL { ?child effortless-ntwf:failedPreconditionCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_CoincidedWithFailedCondition" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:coincidedWithFailedCondition ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:failedConditionCountOnRun ?failed_condition_count_on_run . }
                BIND((COALESCE(?failed_condition_count_on_run, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_HasNoRecordedSolution" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoRecordedSolution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:issueSolution ?issue_solution . OPTIONAL { ?issue_solution effortless-ntwf:__key ?issue_solution__key . } }
                BIND((COALESCE(?issue_solution__key, COALESCE(IF(isIRI(?issue_solution), REPLACE(STR(?issue_solution), "^.*[#/]", ""), STR(?issue_solution)), "")) = "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_RedesignImplementedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:redesignImplementedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
                OPTIONAL { $this effortless-ntwf:redesignChangeRequest ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ChangeRequests ; effortless-ntwf:changeRequestId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:implementedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_IsFailureWithoutLandedRedesign" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFailureWithoutLandedRedesign ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:redesignChangeRequest ?redesign_change_request . OPTIONAL { ?redesign_change_request effortless-ntwf:__key ?redesign_change_request__key . } }
    OPTIONAL { $this effortless-ntwf:redesignImplementedAt ?redesign_implemented_at . OPTIONAL { ?redesign_implemented_at effortless-ntwf:__key ?redesign_implemented_at__key . } }
                BIND((COALESCE((COALESCE(?redesign_change_request__key, COALESCE(IF(isIRI(?redesign_change_request), REPLACE(STR(?redesign_change_request), "^.*[#/]", ""), STR(?redesign_change_request)), "")) = ""), false) || COALESCE((COALESCE(?redesign_implemented_at__key, COALESCE(IF(isIRI(?redesign_implemented_at), REPLACE(STR(?redesign_implemented_at), "^.*[#/]", ""), STR(?redesign_implemented_at)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_ImprovementCyclePath" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:improvementCyclePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:encounteredByAgent ?encountered_by_agent . OPTIONAL { ?encountered_by_agent effortless-ntwf:__key ?encountered_by_agent__key . } }
    OPTIONAL { $this effortless-ntwf:error ?error . OPTIONAL { ?error effortless-ntwf:__key ?error__key . } }
    OPTIONAL { $this effortless-ntwf:executedStep ?executed_step . OPTIONAL { ?executed_step effortless-ntwf:__key ?executed_step__key . } }
    OPTIONAL { $this effortless-ntwf:issueCause ?issue_cause . OPTIONAL { ?issue_cause effortless-ntwf:__key ?issue_cause__key . } }
    OPTIONAL { $this effortless-ntwf:redesignChangeRequest ?redesign_change_request . OPTIONAL { ?redesign_change_request effortless-ntwf:__key ?redesign_change_request__key . } }
                BIND(IF(COALESCE((COALESCE(?redesign_change_request__key, COALESCE(IF(isIRI(?redesign_change_request), REPLACE(STR(?redesign_change_request), "^.*[#/]", ""), STR(?redesign_change_request)), "")) = ""), false), "", CONCAT("Observed at ", COALESCE(COALESCE(?executed_step__key, IF(isIRI(?executed_step), REPLACE(STR(?executed_step), "^.*[#/]", ""), STR(?executed_step))), ""), " by ", COALESCE(COALESCE(?encountered_by_agent__key, IF(isIRI(?encountered_by_agent), REPLACE(STR(?encountered_by_agent), "^.*[#/]", ""), STR(?encountered_by_agent))), ""), "; recorded as ", COALESCE(COALESCE(?error__key, IF(isIRI(?error), REPLACE(STR(?error), "^.*[#/]", ""), STR(?error))), ""), " (", COALESCE(COALESCE(?issue_cause__key, IF(isIRI(?issue_cause), REPLACE(STR(?issue_cause), "^.*[#/]", ""), STR(?issue_cause))), ""), "); redesigned by ", COALESCE(COALESCE(?redesign_change_request__key, IF(isIRI(?redesign_change_request), REPLACE(STR(?redesign_change_request), "^.*[#/]", ""), STR(?redesign_change_request))), ""))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for IssuedTokens ===
effortless-ntwf:IssuedTokensShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IssuedTokens ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssuedTokens_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssuedTokens .
    OPTIONAL { $this effortless-ntwf:appUser ?app_user . OPTIONAL { ?app_user effortless-ntwf:__key ?app_user__key . } }
    OPTIONAL { $this effortless-ntwf:issuedAt ?issued_at . OPTIONAL { ?issued_at effortless-ntwf:__key ?issued_at__key . } }
    OPTIONAL { $this effortless-ntwf:principal ?principal . OPTIONAL { ?principal effortless-ntwf:__key ?principal__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?app_user__key, IF(isIRI(?app_user), REPLACE(STR(?app_user), "^.*[#/]", ""), STR(?app_user))), ""), " as ", COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), ""), " @ ", COALESCE(REPLACE(COALESCE(?issued_at__key, IF(isIRI(?issued_at), REPLACE(STR(?issued_at), "^.*[#/]", ""), STR(?issued_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssuedTokens_IsDevMinted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDevMinted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssuedTokens .
    OPTIONAL { $this effortless-ntwf:issuer ?issuer . OPTIONAL { ?issuer effortless-ntwf:__key ?issuer__key . } }
                BIND((COALESCE(?issuer__key, COALESCE(IF(isIRI(?issuer), REPLACE(STR(?issuer), "^.*[#/]", ""), STR(?issuer)), "")) = "dev-mint") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for JwtClaimMappings ===
effortless-ntwf:JwtClaimMappingsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:JwtClaimMappings ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_JwtClaimMappings_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:JwtClaimMappings .
    OPTIONAL { $this effortless-ntwf:claimName ?claim_name . OPTIONAL { ?claim_name effortless-ntwf:__key ?claim_name__key . } }
    OPTIONAL { $this effortless-ntwf:sqlAccessor ?sql_accessor . OPTIONAL { ?sql_accessor effortless-ntwf:__key ?sql_accessor__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?claim_name__key, IF(isIRI(?claim_name), REPLACE(STR(?claim_name), "^.*[#/]", ""), STR(?claim_name))), ""), " -> ", COALESCE(COALESCE(?sql_accessor__key, IF(isIRI(?sql_accessor), REPLACE(STR(?sql_accessor), "^.*[#/]", ""), STR(?sql_accessor))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_JwtClaimMappings_UsageCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:usageCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:JwtClaimMappings .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AccessPolicies .
                    ?child effortless-ntwf:rowPredicate ?backfk .
                    $this effortless-ntwf:sqlAccessor ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for KnowHowCarriers ===
effortless-ntwf:KnowHowCarriersShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowHowCarriers ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowHowCarriers .
    OPTIONAL { $this effortless-ntwf:carrierKind ?carrier_kind . OPTIONAL { ?carrier_kind effortless-ntwf:__key ?carrier_kind__key . } }
    OPTIONAL { $this effortless-ntwf:topic ?topic . OPTIONAL { ?topic effortless-ntwf:__key ?topic__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?topic__key, IF(isIRI(?topic), REPLACE(STR(?topic), "^.*[#/]", ""), STR(?topic))), ""), " / ", COALESCE(COALESCE(?carrier_kind__key, IF(isIRI(?carrier_kind), REPLACE(STR(?carrier_kind), "^.*[#/]", ""), STR(?carrier_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowHowCarriers .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_HolderIsStillEngaged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:holderIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowHowCarriers .
                OPTIONAL { $this effortless-ntwf:holderAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isStillEngaged ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_HolderServiceStartedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:holderServiceStartedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowHowCarriers .
                OPTIONAL { $this effortless-ntwf:holderAgent ?j0 . }
