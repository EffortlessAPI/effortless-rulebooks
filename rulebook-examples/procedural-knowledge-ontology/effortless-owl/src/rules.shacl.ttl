    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_HasDecayedTransferChannel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasDecayedTransferChannel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:departedOnlyKnowHowCount ?departed_only_know_how_count . }
    OPTIONAL { $this effortless-ntwf:staleEntryCount ?stale_entry_count . }
                BIND((COALESCE((COALESCE(?stale_entry_count, 0) > 0), false) || COALESCE((COALESCE(?departed_only_know_how_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
