    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignmentUpdateTasks_ElapsedMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:elapsedMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignmentUpdateTasks .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:completedAt ?completed_at . OPTIONAL { ?completed_at effortless-ntwf:__key ?completed_at__key . } }
    OPTIONAL { $this effortless-ntwf:triggerOccurredAt ?trigger_occurred_at . }
                BIND(IF(COALESCE((COALESCE(?completed_at__key, COALESCE(IF(isIRI(?completed_at), REPLACE(STR(?completed_at), "^.*[#/]", ""), STR(?completed_at)), "")) = ""), false), ((((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?trigger_occurred_at) + FLOOR((153 * (MONTH(?trigger_occurred_at) + 12 * FLOOR((14 - MONTH(?trigger_occurred_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?trigger_occurred_at) + 4800 - FLOOR((14 - MONTH(?trigger_occurred_at)) / 12)) + FLOOR((YEAR(?trigger_occurred_at) + 4800 - FLOOR((14 - MONTH(?trigger_occurred_at)) / 12)) / 4) - FLOOR((YEAR(?trigger_occurred_at) + 4800 - FLOOR((14 - MONTH(?trigger_occurred_at)) / 12)) / 100) + FLOOR((YEAR(?trigger_occurred_at) + 4800 - FLOOR((14 - MONTH(?trigger_occurred_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?as_of_instant) * 3600 + MINUTES(?as_of_instant) * 60 + SECONDS(?as_of_instant)) - (HOURS(?trigger_occurred_at) * 3600 + MINUTES(?trigger_occurred_at) * 60 + SECONDS(?trigger_occurred_at))) / 60), ((((DAY(?completed_at) + FLOOR((153 * (MONTH(?completed_at) + 12 * FLOOR((14 - MONTH(?completed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?completed_at) + 4800 - FLOOR((14 - MONTH(?completed_at)) / 12)) + FLOOR((YEAR(?completed_at) + 4800 - FLOOR((14 - MONTH(?completed_at)) / 12)) / 4) - FLOOR((YEAR(?completed_at) + 4800 - FLOOR((14 - MONTH(?completed_at)) / 12)) / 100) + FLOOR((YEAR(?completed_at) + 4800 - FLOOR((14 - MONTH(?completed_at)) / 12)) / 400) - 32045) - (DAY(?trigger_occurred_at) + FLOOR((153 * (MONTH(?trigger_occurred_at) + 12 * FLOOR((14 - MONTH(?trigger_occurred_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?trigger_occurred_at) + 4800 - FLOOR((14 - MONTH(?trigger_occurred_at)) / 12)) + FLOOR((YEAR(?trigger_occurred_at) + 4800 - FLOOR((14 - MONTH(?trigger_occurred_at)) / 12)) / 4) - FLOOR((YEAR(?trigger_occurred_at) + 4800 - FLOOR((14 - MONTH(?trigger_occurred_at)) / 12)) / 100) + FLOOR((YEAR(?trigger_occurred_at) + 4800 - FLOOR((14 - MONTH(?trigger_occurred_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?completed_at) * 3600 + MINUTES(?completed_at) * 60 + SECONDS(?completed_at)) - (HOURS(?trigger_occurred_at) * 3600 + MINUTES(?trigger_occurred_at) * 60 + SECONDS(?trigger_occurred_at))) / 60)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignmentUpdateTasks_ExceededUpdateSla" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:exceededUpdateSla ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignmentUpdateTasks .
    OPTIONAL { $this effortless-ntwf:elapsedMinutes ?elapsed_minutes . }
    OPTIONAL { $this effortless-ntwf:policySlaHours ?policy_sla_hours . }
                BIND((COALESCE((COALESCE(?policy_sla_hours, 0) = 0), false) || COALESCE((COALESCE(?elapsed_minutes, 0) > COALESCE((?policy_sla_hours * 60), 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
