            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:maxSegments ?j3 . } }
                BIND(?j3 AS ?_result)
