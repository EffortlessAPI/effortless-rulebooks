                BIND((COALESCE((COALESCE(?assigned_agent_kind__key, COALESCE(IF(isIRI(?assigned_agent_kind), REPLACE(STR(?assigned_agent_kind), "^.*[#/]", ""), STR(?assigned_agent_kind)), "")) = "AIAgent"), false) || COALESCE((COALESCE(?assigned_agent_kind__key, COALESCE(IF(isIRI(?assigned_agent_kind), REPLACE(STR(?assigned_agent_kind), "^.*[#/]", ""), STR(?assigned_agent_kind)), "")) = "AutomatedPipeline"), false)) AS ?_result)
