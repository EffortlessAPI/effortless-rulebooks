            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:witnessClaimIsUnverified ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:derivedHasComputedWitness ?derived_has_computed_witness . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasComputedWitness ?has_computed_witness . }
                BIND((!(COALESCE((COALESCE(?has_computed_witness, false) = COALESCE(?derived_has_computed_witness, false)), false))) AS ?_result)
            }
        """ ;
    ] .
