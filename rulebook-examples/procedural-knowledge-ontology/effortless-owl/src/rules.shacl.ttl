    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:declaredScale ?declared_scale . OPTIONAL { ?declared_scale effortless-ntwf:__key ?declared_scale__key . } }
    OPTIONAL { $this effortless-ntwf:prevPatch ?prev_patch . }
                BIND(ROUND(IF(COALESCE((COALESCE(?declared_scale__key, COALESCE(IF(isIRI(?declared_scale), REPLACE(STR(?declared_scale), "^.*[#/]", ""), STR(?declared_scale)), "")) = "Patch"), false), (?prev_patch + 1), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_IsIncrementInconsistentWithScale" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isIncrementInconsistentWithScale ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:expectedMajor ?expected_major . }
    OPTIONAL { $this effortless-ntwf:expectedMinor ?expected_minor . }
    OPTIONAL { $this effortless-ntwf:expectedPatch ?expected_patch . }
    OPTIONAL { $this effortless-ntwf:previousRelease ?previous_release . OPTIONAL { ?previous_release effortless-ntwf:__key ?previous_release__key . } }
    OPTIONAL { $this effortless-ntwf:versionMajor ?version_major . }
    OPTIONAL { $this effortless-ntwf:versionMinor ?version_minor . }
    OPTIONAL { $this effortless-ntwf:versionPatch ?version_patch . }
                BIND((COALESCE((COALESCE(?previous_release__key, COALESCE(IF(isIRI(?previous_release), REPLACE(STR(?previous_release), "^.*[#/]", ""), STR(?previous_release)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?version_major, 0) != COALESCE(?expected_major, 0)), false) || COALESCE((COALESCE(?version_minor, 0) != COALESCE(?expected_minor, 0)), false) || COALESCE((COALESCE(?version_patch, 0) != COALESCE(?expected_patch, 0)), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_DaysSincePreviousRelease" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSincePreviousRelease ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:issuedAt ?issued_at . }
    OPTIONAL { $this effortless-ntwf:prevIssuedAt ?prev_issued_at . }
    OPTIONAL { $this effortless-ntwf:previousRelease ?previous_release . OPTIONAL { ?previous_release effortless-ntwf:__key ?previous_release__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?previous_release__key, COALESCE(IF(isIRI(?previous_release), REPLACE(STR(?previous_release), "^.*[#/]", ""), STR(?previous_release)), "")) = ""), false), 0, ((DAY(?issued_at) + FLOOR((153 * (MONTH(?issued_at) + 12 * FLOOR((14 - MONTH(?issued_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?issued_at) + 4800 - FLOOR((14 - MONTH(?issued_at)) / 12)) + FLOOR((YEAR(?issued_at) + 4800 - FLOOR((14 - MONTH(?issued_at)) / 12)) / 4) - FLOOR((YEAR(?issued_at) + 4800 - FLOOR((14 - MONTH(?issued_at)) / 12)) / 100) + FLOOR((YEAR(?issued_at) + 4800 - FLOOR((14 - MONTH(?issued_at)) / 12)) / 400) - 32045) - (DAY(?prev_issued_at) + FLOOR((153 * (MONTH(?prev_issued_at) + 12 * FLOOR((14 - MONTH(?prev_issued_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?prev_issued_at) + 4800 - FLOOR((14 - MONTH(?prev_issued_at)) / 12)) + FLOOR((YEAR(?prev_issued_at) + 4800 - FLOOR((14 - MONTH(?prev_issued_at)) / 12)) / 4) - FLOOR((YEAR(?prev_issued_at) + 4800 - FLOOR((14 - MONTH(?prev_issued_at)) / 12)) / 100) + FLOOR((YEAR(?prev_issued_at) + 4800 - FLOOR((14 - MONTH(?prev_issued_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_IsLongReleaseCycle" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLongReleaseCycle ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:daysSincePreviousRelease ?days_since_previous_release . }
                BIND((COALESCE(?days_since_previous_release, 0) > 60) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_IsDeclaredCurrentRelease" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
