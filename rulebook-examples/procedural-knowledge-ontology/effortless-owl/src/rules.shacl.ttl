    $this a pko-native-procedural-knowledge-rulebook:ExecutionEntities .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepVariable ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:StepVariables . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:direction ?j3 . } }
                BIND(?j3 AS ?_result)
            }
