    $this a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:labelKind ?label_kind . OPTIONAL { ?label_kind erb:key ?label_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wordingKey ?wording_key . }
                BIND(IF(COALESCE((COALESCE(?label_kind__key, COALESCE(IF(isIRI(?label_kind), REPLACE(STR(?label_kind), "^.*[#/]", ""), STR(?label_kind)), "")) = "pref"), false), ?wording_key, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TermLabelVariants_ConceptsSharingWording a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:TermLabelVariants ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_ConceptsSharingWording" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:conceptsSharingWording ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
                    ?child a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
                    ?child pko-native-procedural-knowledge-rulebook:wordingKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:wordingKey ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TermLabelVariants_IsAmbiguousLabel a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:TermLabelVariants ;
