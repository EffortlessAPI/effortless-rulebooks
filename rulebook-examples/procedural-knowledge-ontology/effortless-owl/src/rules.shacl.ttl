            }
            WHERE {
    $this a pko-extension:KnowledgeHolding .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:formalizedAs ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:KnowledgeFragment . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:elicitationSession ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeHoldings_IsUnformalizedProcessKnowledge a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeHolding ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeHoldings_IsUnformalizedProcessKnowledge" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnformalizedProcessKnowledge ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeHolding .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:carrier ?carrier . OPTIONAL { ?carrier erb:key ?carrier__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:formalizedAs ?formalized_as . OPTIONAL { ?formalized_as erb:key ?formalized_as__key . } }
                BIND((COALESCE((COALESCE(?formalized_as__key, COALESCE(IF(isIRI(?formalized_as), REPLACE(STR(?formalized_as), "^.*[#/]", ""), STR(?formalized_as)), "")) = ""), false) && COALESCE((COALESCE(?carrier__key, COALESCE(IF(isIRI(?carrier), REPLACE(STR(?carrier), "^.*[#/]", ""), STR(?carrier)), "")) != "ProcedureRulebook"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeHoldings_IsProceduralKnowledge a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeHolding ;
