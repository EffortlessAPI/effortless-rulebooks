            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:separationIsVacuouslyGreen ?separation_is_vacuously_green . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:separationViolationCount ?separation_violation_count . }
                BIND(IF(COALESCE((COALESCE(?separation_violation_count, 0) > 0), false), "Violated: same agent prepared and approved.", IF(COALESCE(?separation_is_vacuously_green, false), "Not tested: this run had no preparation/approval pair.", "Held under test.")) AS ?_result)
            }
        """ ;
    ] .
