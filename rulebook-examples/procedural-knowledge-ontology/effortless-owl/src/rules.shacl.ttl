            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:gaveUpAfterSeeingResults ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeSearchEvent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resultCount ?result_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wasAbandoned ?was_abandoned . }
                BIND((COALESCE(?was_abandoned, false) && COALESCE((COALESCE(?result_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeSearchEvents_IsUnlinkedFailedSearch a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeSearchEvent ;
