    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HumanChannelCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:humanChannelCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:humanSyncCount ?human_sync_count . }
    OPTIONAL { $this effortless-ntwf:publishedProjectionCount ?published_projection_count . }
                BIND(ROUND((?published_projection_count + ?human_sync_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_MachineChannelCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:machineChannelCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:machineSyncCount ?machine_sync_count . }
    OPTIONAL { $this effortless-ntwf:servedAssertionCount ?served_assertion_count . }
                BIND(ROUND((?machine_sync_count + ?served_assertion_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ServesOnlyHumansOrOnlyMachines" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:servesOnlyHumansOrOnlyMachines ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:humanChannelCount ?human_channel_count . }
    OPTIONAL { $this effortless-ntwf:isCurrent ?is_current . }
    OPTIONAL { $this effortless-ntwf:machineChannelCount ?machine_channel_count . }
                BIND((COALESCE(?is_current, false) && COALESCE((COALESCE((?human_channel_count + ?machine_channel_count), 0) > 0), false) && COALESCE((COALESCE((COALESCE(?human_channel_count, 0) = 0), false) || COALESCE((COALESCE(?machine_channel_count, 0) = 0), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_FreshMiningRunCount" ;
        sh:prefixes effortless-ntwf: ;
