pko-native-procedural-knowledge-rulebook-shapes:AssistantBenchmarks_AccuracyLiftPoints a sh:NodeShape ;
    sh:targetClass pko-extension:AssistantBenchmark ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantBenchmarks_AccuracyLiftPoints" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:accuracyLiftPoints ?_result .
            }
            WHERE {
    $this a pko-extension:AssistantBenchmark .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:graphGroundedAccuracyPercent ?graph_grounded_accuracy_percent . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ungroundedAccuracyPercent ?ungrounded_accuracy_percent . }
                BIND((?graph_grounded_accuracy_percent - ?ungrounded_accuracy_percent) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssistantBenchmarks_ShowsSpatialLiftFromGraphQueries a sh:NodeShape ;
    sh:targetClass pko-extension:AssistantBenchmark ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantBenchmarks_ShowsSpatialLiftFromGraphQueries" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:showsSpatialLiftFromGraphQueries ?_result .
            }
            WHERE {
    $this a pko-extension:AssistantBenchmark .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:accuracyLiftPoints ?accuracy_lift_points . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:generatesDatabaseQueries ?generates_database_queries . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:taskFamily ?task_family . OPTIONAL { ?task_family erb:key ?task_family__key . } }
                BIND((COALESCE((COALESCE(?task_family__key, COALESCE(IF(isIRI(?task_family), REPLACE(STR(?task_family), "^.*[#/]", ""), STR(?task_family)), "")) = "Spatial"), false) && COALESCE(?generates_database_queries, false) && COALESCE((COALESCE(?accuracy_lift_points, 0) >= 20), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssistantBenchmarks_ShowsGeospatialRetrievalLift a sh:NodeShape ;
