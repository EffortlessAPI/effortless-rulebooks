            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:declaredScale ?declared_scale . OPTIONAL { ?declared_scale effortless-ntwf:__key ?declared_scale__key . } }
    OPTIONAL { $this effortless-ntwf:logicalChangeCount ?logical_change_count . }
                BIND((COALESCE((COALESCE(?declared_scale__key, COALESCE(IF(isIRI(?declared_scale), REPLACE(STR(?declared_scale), "^.*[#/]", ""), STR(?declared_scale)), "")) = "Patch"), false) && COALESCE((COALESCE(?logical_change_count, 0) > 0), false)) AS ?_result)
            }
