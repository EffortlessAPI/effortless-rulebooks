            WHERE {
    $this a pko-extension:AgentDecisionRecord .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isErrorCorrection ?is_error_correction . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:underRoleAssignment ?under_role_assignment . }
                BIND(IF(COALESCE(?is_error_correction, false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AgentDecisionRecords_BoundaryViolationRoleAssignmentKey a sh:NodeShape ;
    sh:targetClass pko-extension:AgentDecisionRecord ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_BoundaryViolationRoleAssignmentKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:boundaryViolationRoleAssignmentKey ?_result .
            }
            WHERE {
    $this a pko-extension:AgentDecisionRecord .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:underRoleAssignment ?under_role_assignment . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:violatedAuthorityBoundary ?violated_authority_boundary . }
                BIND(IF(COALESCE(?violated_authority_boundary, false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for AgentIntegrations ===
pko-native-procedural-knowledge-rulebook-shapes:AgentIntegrations_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AgentIntegration ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AgentIntegration .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:agent ?agent . OPTIONAL { ?agent erb:key ?agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:pathway ?pathway . OPTIONAL { ?pathway erb:key ?pathway__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?agent__key, IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent))), ""), " via ", COALESCE(COALESCE(?pathway__key, IF(isIRI(?pathway), REPLACE(STR(?pathway), "^.*[#/]", ""), STR(?pathway))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AgentIntegrations_PathwayIntegrationCount a sh:NodeShape ;
    sh:targetClass pko-extension:AgentIntegration ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_PathwayIntegrationCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:pathwayIntegrationCount ?_result .
            }
            WHERE {
    $this a pko-extension:AgentIntegration .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:pathway ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:IntegrationPathway . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:integrationCountOnPathway ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AgentIntegrations_ObservedAnswerCount a sh:NodeShape ;
    sh:targetClass pko-extension:AgentIntegration ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_ObservedAnswerCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:observedAnswerCount ?_result .
            }
            WHERE {
    $this a pko-extension:AgentIntegration .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AgentIntegration .
                    ?child a pko-extension:AssistantAnswer .
                    ?child pko-native-procedural-knowledge-rulebook:viaIntegration $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AgentIntegrations_IsShadowIntegration a sh:NodeShape ;
    sh:targetClass pko-extension:AgentIntegration ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_IsShadowIntegration" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isShadowIntegration ?_result .
            }
            WHERE {
    $this a pko-extension:AgentIntegration .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:observedAnswerCount ?observed_answer_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:registryEntryKey ?registry_entry_key . OPTIONAL { ?registry_entry_key erb:key ?registry_entry_key__key . } }
                BIND((COALESCE((COALESCE(?observed_answer_count, 0) > 0), false) && COALESCE((COALESCE(?registry_entry_key__key, COALESCE(IF(isIRI(?registry_entry_key), REPLACE(STR(?registry_entry_key), "^.*[#/]", ""), STR(?registry_entry_key)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AgentIntegrations_IsOneOffConnection a sh:NodeShape ;
    sh:targetClass pko-extension:AgentIntegration ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_IsOneOffConnection" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOneOffConnection ?_result .
            }
            WHERE {
    $this a pko-extension:AgentIntegration .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:pathwayIntegrationCount ?pathway_integration_count . }
                BIND((COALESCE(?pathway_integration_count, 0) <= 1) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AgentIntegrations_SnapshotIsGoverned a sh:NodeShape ;
    sh:targetClass pko-extension:AgentIntegration ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_SnapshotIsGoverned" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:snapshotIsGoverned ?_result .
            }
            WHERE {
    $this a pko-extension:AgentIntegration .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:servesSnapshot ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:GroundingSnapshot . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isGoverned ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AgentIntegrations_IsDeployedOnUngovernedGraph a sh:NodeShape ;
    sh:targetClass pko-extension:AgentIntegration ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_IsDeployedOnUngovernedGraph" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDeployedOnUngovernedGraph ?_result .
            }
            WHERE {
    $this a pko-extension:AgentIntegration .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:servesSnapshot ?serves_snapshot . OPTIONAL { ?serves_snapshot erb:key ?serves_snapshot__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:snapshotIsGoverned ?snapshot_is_governed . }
                BIND((COALESCE((COALESCE(?serves_snapshot__key, COALESCE(IF(isIRI(?serves_snapshot), REPLACE(STR(?serves_snapshot), "^.*[#/]", ""), STR(?serves_snapshot)), "")) != ""), false) && COALESCE((COALESCE(?snapshot_is_governed, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for AgentUpgradeAssessments ===
pko-native-procedural-knowledge-rulebook-shapes:AgentUpgradeAssessments_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AgentUpgradeAssessment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentUpgradeAssessments_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AgentUpgradeAssessment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:assessmentMethod ?assessment_method . OPTIONAL { ?assessment_method erb:key ?assessment_method__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:candidateAgent ?candidate_agent . OPTIONAL { ?candidate_agent erb:key ?candidate_agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:currentAgent ?current_agent . OPTIONAL { ?current_agent erb:key ?current_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?current_agent__key, IF(isIRI(?current_agent), REPLACE(STR(?current_agent), "^.*[#/]", ""), STR(?current_agent))), ""), " -> ", COALESCE(COALESCE(?candidate_agent__key, IF(isIRI(?candidate_agent), REPLACE(STR(?candidate_agent), "^.*[#/]", ""), STR(?candidate_agent))), ""), " (", COALESCE(COALESCE(?assessment_method__key, IF(isIRI(?assessment_method), REPLACE(STR(?assessment_method), "^.*[#/]", ""), STR(?assessment_method))), ""), ")") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AgentUpgradeAssessments_AttributedArtifactCount a sh:NodeShape ;
    sh:targetClass pko-extension:AgentUpgradeAssessment ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentUpgradeAssessments_AttributedArtifactCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:attributedArtifactCount ?_result .
            }
            WHERE {
    $this a pko-extension:AgentUpgradeAssessment .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:currentAgent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:attributedArtifactCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AgentUpgradeAssessments_TraversedDownstreamStepCount a sh:NodeShape ;
    sh:targetClass pko-extension:AgentUpgradeAssessment ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentUpgradeAssessments_TraversedDownstreamStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:traversedDownstreamStepCount ?_result .
            }
            WHERE {
    $this a pko-extension:AgentUpgradeAssessment .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:currentAgent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:artifactBlastRadiusStepCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AgentUpgradeAssessments_MissedTraversedImpact a sh:NodeShape ;
    sh:targetClass pko-extension:AgentUpgradeAssessment ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentUpgradeAssessments_MissedTraversedImpact" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:missedTraversedImpact ?_result .
            }
            WHERE {
    $this a pko-extension:AgentUpgradeAssessment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:listedAffectedStepCount ?listed_affected_step_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:traversedDownstreamStepCount ?traversed_downstream_step_count . }
                BIND((COALESCE(?listed_affected_step_count, 0) < COALESCE(?traversed_downstream_step_count, 0)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Agents ===
pko-native-procedural-knowledge-rulebook-shapes:Agents_Name a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a prov:Agent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Agents_CountOfCurrentRoleAssignments a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_CountOfCurrentRoleAssignments" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:countOfCurrentRoleAssignments ?_result .
            }
            WHERE {
    $this a prov:Agent .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a prov:Agent .
                    ?child a pro:RoleInTime .
                    ?child pko-native-procedural-knowledge-rulebook:currentAgentKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:agentId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Agents_IsStillEngaged a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_IsStillEngaged" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isStillEngaged ?_result .
            }
            WHERE {
    $this a prov:Agent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:countOfCurrentRoleAssignments ?count_of_current_role_assignments . }
                BIND((COALESCE(?count_of_current_role_assignments, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Agents_DecisionCount a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_DecisionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:decisionCount ?_result .
            }
            WHERE {
    $this a prov:Agent .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a prov:Agent .
                    ?child a pko-extension:AgentDecisionRecord .
                    ?child pko-native-procedural-knowledge-rulebook:decidingAgent $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Agents_OverriddenDecisionCount a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_OverriddenDecisionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:overriddenDecisionCount ?_result .
            }
            WHERE {
    $this a prov:Agent .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a prov:Agent .
                    ?child a pko-extension:AgentDecisionRecord .
                    ?child pko-native-procedural-knowledge-rulebook:decidingAgentWhenOverridden ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:agentId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Agents_OverrideRatePercent a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_OverrideRatePercent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:overrideRatePercent ?_result .
            }
            WHERE {
    $this a prov:Agent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decisionCount ?decision_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:overriddenDecisionCount ?overridden_decision_count . }
                BIND(IF(COALESCE((COALESCE(?decision_count, 0) = 0), false), 0, xsd:double((?overridden_decision_count * 100) / ?decision_count)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Agents_IsNonHuman a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_IsNonHuman" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isNonHuman ?_result .
            }
            WHERE {
    $this a prov:Agent .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:agentKind ?agent_kind . OPTIONAL { ?agent_kind erb:key ?agent_kind__key . } }
                BIND((!(COALESCE((COALESCE(?agent_kind__key, COALESCE(IF(isIRI(?agent_kind), REPLACE(STR(?agent_kind), "^.*[#/]", ""), STR(?agent_kind)), "")) = "Human"), false))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Agents_BoundaryViolationCount a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_BoundaryViolationCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
