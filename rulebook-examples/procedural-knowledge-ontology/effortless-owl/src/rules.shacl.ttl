            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUncontrolledWording ?_result .
            }
            WHERE {
    $this a pko-extension:SourceTermMention .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:matchingLabelCount ?matching_label_count . }
                BIND((COALESCE(?matching_label_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceTermMentions_IsNonCanonicalGeneratedValue a sh:NodeShape ;
    sh:targetClass pko-extension:SourceTermMention ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_IsNonCanonicalGeneratedValue" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isNonCanonicalGeneratedValue ?_result .
            }
            WHERE {
    $this a pko-extension:SourceTermMention .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:matchingPrefLabelCount ?matching_pref_label_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:mentionOrigin ?mention_origin . OPTIONAL { ?mention_origin erb:key ?mention_origin__key . } }
                BIND((COALESCE((COALESCE(?mention_origin__key, COALESCE(IF(isIRI(?mention_origin), REPLACE(STR(?mention_origin), "^.*[#/]", ""), STR(?mention_origin)), "")) = "AIGenerated"), false) && COALESCE((COALESCE(?matching_pref_label_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceTermMentions_IntendedTermRole a sh:NodeShape ;
    sh:targetClass pko-extension:SourceTermMention ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_IntendedTermRole" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:intendedTermRole ?_result .
            }
            WHERE {
    $this a pko-extension:SourceTermMention .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:intendedTerm ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:VocabularyTerm . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:representsRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceTermMentions_UnresolvedIntendedTermKey a sh:NodeShape ;
    sh:targetClass pko-extension:SourceTermMention ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_UnresolvedIntendedTermKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:unresolvedIntendedTermKey ?_result .
            }
            WHERE {
    $this a pko-extension:SourceTermMention .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:intendedTerm ?intended_term . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:matchingLabelCount ?matching_label_count . }
                BIND(IF(COALESCE((COALESCE(?matching_label_count, 0) = 0), false), ?intended_term, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceTermMentions_UnresolvedRoleKey a sh:NodeShape ;
    sh:targetClass pko-extension:SourceTermMention ;
    sh:order 4 ;
