            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnauthorizedEnforcementAgent ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isEnforcementRole ?is_enforcement_role . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isUnauthorizedNonHumanAssignment ?is_unauthorized_non_human_assignment . }
                BIND((COALESCE(?is_enforcement_role, false) && COALESCE(?is_unauthorized_non_human_assignment, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_GovernanceEvidenceCount a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
    sh:order 2 ;
    sh:rule [
