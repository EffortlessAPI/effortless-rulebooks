    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasFrozenApprovalEvidence ?has_frozen_approval_evidence . }
                BIND((!(COALESCE(?has_frozen_approval_evidence, false))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageDeliveries_CurrentLastApprovalAt a sh:NodeShape ;
    sh:targetClass pko-extension:MessageDelivery ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
