            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:previousStepExecution ?previous_step_execution . OPTIONAL { ?previous_step_execution effortless-ntwf:__key ?previous_step_execution__key . } }
    OPTIONAL { $this effortless-ntwf:specifiedTransitionFromPreviousCount ?specified_transition_from_previous_count . }
                BIND((COALESCE((COALESCE(?previous_step_execution__key, COALESCE(IF(isIRI(?previous_step_execution), REPLACE(STR(?previous_step_execution), "^.*[#/]", ""), STR(?previous_step_execution)), "")) != ""), false) && COALESCE((COALESCE(?specified_transition_from_previous_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
