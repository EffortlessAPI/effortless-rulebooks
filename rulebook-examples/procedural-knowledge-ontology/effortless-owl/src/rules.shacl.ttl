    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:nonCanonicalOutputCount ?non_canonical_output_count . }
                BIND((COALESCE((COALESCE(?grounding_scheme__key, COALESCE(IF(isIRI(?grounding_scheme), REPLACE(STR(?grounding_scheme), "^.*[#/]", ""), STR(?grounding_scheme)), "")) = ""), false) && COALESCE((COALESCE(?non_canonical_output_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiLabelingRuns_GroundedInNonMachineReadableScheme a sh:NodeShape ;
