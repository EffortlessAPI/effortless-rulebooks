            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:driftedMiningRunCount ?drifted_mining_run_count . }
                BIND((COALESCE(?drifted_mining_run_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
