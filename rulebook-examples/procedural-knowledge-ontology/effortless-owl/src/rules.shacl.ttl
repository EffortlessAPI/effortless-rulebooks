    OPTIONAL { $this effortless-ntwf:procedureTypeDefinition ?procedure_type_definition . OPTIONAL { ?procedure_type_definition effortless-ntwf:__key ?procedure_type_definition__key . } }
    OPTIONAL { $this effortless-ntwf:procedureTypeRank ?procedure_type_rank . OPTIONAL { ?procedure_type_rank effortless-ntwf:__key ?procedure_type_rank__key . } }
                BIND((COALESCE((COALESCE(?procedure_type__key, COALESCE(IF(isIRI(?procedure_type), REPLACE(STR(?procedure_type), "^.*[#/]", ""), STR(?procedure_type)), "")) = ""), false) || COALESCE((COALESCE(?procedure_type_rank__key, COALESCE(IF(isIRI(?procedure_type_rank), REPLACE(STR(?procedure_type_rank), "^.*[#/]", ""), STR(?procedure_type_rank)), "")) != "ProcessType"), false) || COALESCE((COALESCE(?procedure_type_definition__key, COALESCE(IF(isIRI(?procedure_type_definition), REPLACE(STR(?procedure_type_definition), "^.*[#/]", ""), STR(?procedure_type_definition)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_StrategicAlignmentCount" ;
