    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ComplementaryMethodCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:complementaryMethodCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:incidentSessionCount ?incident_session_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:interviewSessionCount ?interview_session_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:observationSessionCount ?observation_session_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:protocolSessionCount ?protocol_session_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:workshopSessionCount ?workshop_session_count . }
                BIND(ROUND(((((IF(COALESCE((COALESCE(?interview_session_count, 0) > 0), false), 1, 0) + IF(COALESCE((COALESCE(?observation_session_count, 0) > 0), false), 1, 0)) + IF(COALESCE((COALESCE(?workshop_session_count, 0) > 0), false), 1, 0)) + IF(COALESCE((COALESCE(?protocol_session_count, 0) > 0), false), 1, 0)) + IF(COALESCE((COALESCE(?incident_session_count, 0) > 0), false), 1, 0))) AS ?_result)
            }
        """ ;
    ] .
