    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:displayLabel ?display_label . OPTIONAL { ?display_label erb:key ?display_label__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:roleKind ?role_kind . OPTIONAL { ?role_kind erb:key ?role_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?display_label__key, IF(isIRI(?display_label), REPLACE(STR(?display_label), "^.*[#/]", ""), STR(?display_label))), ""), " (", COALESCE(COALESCE(?role_kind__key, IF(isIRI(?role_kind), REPLACE(STR(?role_kind), "^.*[#/]", ""), STR(?role_kind))), ""), ")") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AppRoleProfiles_RouteCount a sh:NodeShape ;
    sh:targetClass pko-extension:AppRoleProfile ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoleProfiles_RouteCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:routeCount ?_result .
            }
            WHERE {
    $this a pko-extension:AppRoleProfile .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AppRoleProfile .
                    ?child a pko-extension:AppRoute .
                    ?child pko-native-procedural-knowledge-rulebook:owningRole ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:role ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

