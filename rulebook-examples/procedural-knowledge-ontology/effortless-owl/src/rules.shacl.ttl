                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:knowledgeForm ?knowledge_form . OPTIONAL { ?knowledge_form effortless-ntwf:__key ?knowledge_form__key . } }
    OPTIONAL { $this effortless-ntwf:statement ?statement . }
                BIND(CONCAT(COALESCE(COALESCE(?knowledge_form__key, IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?statement), 1, 60)), REPLACE(STR(SUBSTR(STR(?statement), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?statement), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
