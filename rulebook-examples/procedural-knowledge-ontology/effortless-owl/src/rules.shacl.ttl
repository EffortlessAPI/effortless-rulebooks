    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAgentic ?is_agentic . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status_AiAdoptionInitiatives ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE(?is_agentic, false) && COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) != "Proposed"), false) && COALESCE((COALESCE(?ai_insight_count, 0) = 0), false)) AS ?_result)
