            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:transferCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowHowCarrier .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:KnowHowCarrier .
                    ?child a pko-extension:KnowledgeTransfer .
                    ?child pko-native-procedural-knowledge-rulebook:knowHow $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
