    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:unexercisedBindingCount ?unexercised_binding_count . }
                BIND((COALESCE(?has_computed_witness, false) && COALESCE((COALESCE(?unexercised_binding_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_AccountableAgent a sh:NodeShape ;
