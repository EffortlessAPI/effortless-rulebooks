    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceMaterial ?source_material . OPTIONAL { ?source_material erb:key ?source_material__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceStatement ?source_statement . OPTIONAL { ?source_statement erb:key ?source_statement__key . } }
                BIND(IF(COALESCE((COALESCE(?contradicted_document__key, COALESCE(IF(isIRI(?contradicted_document), REPLACE(STR(?contradicted_document), "^.*[#/]", ""), STR(?contradicted_document)), "")) = ""), false), "", CONCAT("Prescribed in ", COALESCE(COALESCE(?contradicted_document__key, IF(isIRI(?contradicted_document), REPLACE(STR(?contradicted_document), "^.*[#/]", ""), STR(?contradicted_document))), ""), "; enacted per ", COALESCE(COALESCE(?source_material__key, IF(isIRI(?source_material), REPLACE(STR(?source_material), "^.*[#/]", ""), STR(?source_material))), ""), ": ", COALESCE(COALESCE(?source_statement__key, IF(isIRI(?source_statement), REPLACE(STR(?source_statement), "^.*[#/]", ""), STR(?source_statement))), ""))) AS ?_result)
            }
        """ ;
    ] .

# === Rules for KnowledgeTransfers ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeTransfers_Name a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeTransfer ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeTransfer .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:channel ?channel . OPTIONAL { ?channel erb:key ?channel__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowHow ?know_how . OPTIONAL { ?know_how erb:key ?know_how__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?know_how__key, IF(isIRI(?know_how), REPLACE(STR(?know_how), "^.*[#/]", ""), STR(?know_how))), ""), " via ", COALESCE(COALESCE(?channel__key, IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeTransfers_FromOrganization a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeTransfer ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_FromOrganization" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:fromOrganization ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeTransfer .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fromAgent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeTransfers_RecipientRoleCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeTransfer ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_RecipientRoleCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:recipientRoleCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeTransfer .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recipientAgent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:countOfCurrentRoleAssignments ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeTransfers_IsTraditionalChannel a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeTransfer ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_IsTraditionalChannel" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isTraditionalChannel ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeTransfer .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:channel ?channel . OPTIONAL { ?channel erb:key ?channel__key . } }
                BIND((COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "Document"), false) || COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "TrainingProgram"), false) || COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "Mentoring"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeTransfers_IsSocialNetworkChannel a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeTransfer ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_IsSocialNetworkChannel" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isSocialNetworkChannel ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeTransfer .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:channel ?channel . OPTIONAL { ?channel erb:key ?channel__key . } }
                BIND((COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "PersonalRelationship"), false) || COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "Collaboration"), false) || COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "DesignProductionIteration"), false) || COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "EmployerChange"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeTransfers_IsAmbientAbsorptionByNonPractitioner a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeTransfer ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_IsAmbientAbsorptionByNonPractitioner" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isAmbientAbsorptionByNonPractitioner ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeTransfer .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:channel ?channel . OPTIONAL { ?channel erb:key ?channel__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recipientAgent ?recipient_agent . OPTIONAL { ?recipient_agent erb:key ?recipient_agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recipientRoleCount ?recipient_role_count . }
                BIND((COALESCE((COALESCE(?recipient_agent__key, COALESCE(IF(isIRI(?recipient_agent), REPLACE(STR(?recipient_agent), "^.*[#/]", ""), STR(?recipient_agent)), "")) != ""), false) && COALESCE((COALESCE(?channel__key, COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), "")) = "AmbientExposure"), false) && COALESCE((COALESCE(?recipient_role_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeTransfers_KnowHowTopic a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeTransfer ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeTransfers_KnowHowTopic" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
