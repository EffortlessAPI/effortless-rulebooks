        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeIntegrityChecks_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeIntegrityCheck .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:checkKind ?check_kind . OPTIONAL { ?check_kind erb:key ?check_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelChangeRequest ?model_change_request . OPTIONAL { ?model_change_request erb:key ?model_change_request__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_change_request__key, IF(isIRI(?model_change_request), REPLACE(STR(?model_change_request), "^.*[#/]", ""), STR(?model_change_request))), ""), " ", COALESCE(COALESCE(?check_kind__key, IF(isIRI(?check_kind), REPLACE(STR(?check_kind), "^.*[#/]", ""), STR(?check_kind))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeIntegrityChecks_CheckerKind a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeIntegrityCheck ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeIntegrityChecks_CheckerKind" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:checkerKind ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeIntegrityCheck .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:checkedByAgent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for ChangeObjections ===
pko-native-procedural-knowledge-rulebook-shapes:ChangeObjections_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeObjection ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeObjections_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeObjection .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelChangeRequest ?model_change_request . OPTIONAL { ?model_change_request erb:key ?model_change_request__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:raisedByAgent ?raised_by_agent . OPTIONAL { ?raised_by_agent erb:key ?raised_by_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_change_request__key, IF(isIRI(?model_change_request), REPLACE(STR(?model_change_request), "^.*[#/]", ""), STR(?model_change_request))), ""), " objection by ", COALESCE(COALESCE(?raised_by_agent__key, IF(isIRI(?raised_by_agent), REPLACE(STR(?raised_by_agent), "^.*[#/]", ""), STR(?raised_by_agent))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeObjections_IsUnresolved a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeObjection ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeObjections_IsUnresolved" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnresolved ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeObjection .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resolvedAt ?resolved_at . OPTIONAL { ?resolved_at erb:key ?resolved_at__key . } }
                BIND((COALESCE(?resolved_at__key, COALESCE(IF(isIRI(?resolved_at), REPLACE(STR(?resolved_at), "^.*[#/]", ""), STR(?resolved_at)), "")) = "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for ChangeRequests ===
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_Name a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_IsOpen a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsOpen" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOpen ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:implementedAt ?implemented_at . OPTIONAL { ?implemented_at erb:key ?implemented_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status_ChangeRequests ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Draft"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "UnderReview"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false)), false) && COALESCE((COALESCE(?implemented_at__key, COALESCE(IF(isIRI(?implemented_at), REPLACE(STR(?implemented_at), "^.*[#/]", ""), STR(?implemented_at)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_OpenChangeVersionKey a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_OpenChangeVersionKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:openChangeVersionKey ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOpen ?is_open . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_open, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_IsDecided a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
