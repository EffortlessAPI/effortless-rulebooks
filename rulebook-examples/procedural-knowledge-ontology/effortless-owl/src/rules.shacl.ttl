            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isReviewOverdueForChangeRate ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:OntologyProfiles .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceDependencyReviewed ?days_since_dependency_reviewed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:dependencyReviewedAt ?dependency_reviewed_at . OPTIONAL { ?dependency_reviewed_at erb:key ?dependency_reviewed_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requiresFrequentReview ?requires_frequent_review . }
                BIND((COALESCE(?requires_frequent_review, false) && COALESCE((COALESCE((COALESCE(?dependency_reviewed_at__key, COALESCE(IF(isIRI(?dependency_reviewed_at), REPLACE(STR(?dependency_reviewed_at), "^.*[#/]", ""), STR(?dependency_reviewed_at)), "")) = ""), false) || COALESCE((COALESCE(?days_since_dependency_reviewed, 0) > 180), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OntologyProfiles_PrerequisiteAdoptedAt a sh:NodeShape ;
