            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:governanceEvidenceCount ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasApprovingAuthority ?has_approving_authority . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasAuthorizingChangeRequest ?has_authorizing_change_request . }
                BIND(ROUND((IF(COALESCE(?has_approving_authority, false), 1, 0) + IF(COALESCE(?has_authorizing_change_request, false), 1, 0))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_UnauthorizedEnforcementRoleKey a sh:NodeShape ;
