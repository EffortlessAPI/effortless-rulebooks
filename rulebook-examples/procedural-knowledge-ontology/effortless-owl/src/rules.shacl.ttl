pko-native-procedural-knowledge-rulebook-shapes:ApplicabilityScopes_DimensionCount a sh:NodeShape ;
    sh:targetClass pko-extension:ApplicabilityScope ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ApplicabilityScopes_DimensionCount" ;
