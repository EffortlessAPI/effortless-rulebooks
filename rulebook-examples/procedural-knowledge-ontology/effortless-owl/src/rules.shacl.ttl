            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:Exception .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:condition ?condition . }
                BIND(?condition AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Exceptions_ActiveExceptionStepKey a sh:NodeShape ;
    sh:targetClass pko-extension:Exception ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Exceptions_ActiveExceptionStepKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:activeExceptionStepKey ?_result .
            }
            WHERE {
    $this a pko-extension:Exception .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status_Exceptions ?status . OPTIONAL { ?status erb:key ?status__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:triggerStep ?trigger_step . }
                BIND(IF(COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Active"), false), ?trigger_step, "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for ExecutionEntities ===
pko-native-procedural-knowledge-rulebook-shapes:ExecutionEntities_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ExecutionEntities ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ExecutionEntities .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:entityLabel ?entity_label . OPTIONAL { ?entity_label erb:key ?entity_label__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . OPTIONAL { ?step_execution erb:key ?step_execution__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usage ?usage . OPTIONAL { ?usage erb:key ?usage__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_execution__key, IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution))), ""), " ", COALESCE(COALESCE(?usage__key, IF(isIRI(?usage), REPLACE(STR(?usage), "^.*[#/]", ""), STR(?usage))), ""), " ", COALESCE(COALESCE(?entity_label__key, IF(isIRI(?entity_label), REPLACE(STR(?entity_label), "^.*[#/]", ""), STR(?entity_label))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExecutionEntities_VariableDirection a sh:NodeShape ;
