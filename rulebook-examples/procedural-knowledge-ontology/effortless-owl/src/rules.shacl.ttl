    sh:targetClass pko-extension:AssistantAnswer ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_AssumedStepCompletedCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:assumedStepCompletedCount ?_result .
            }
            WHERE {
    $this a pko-extension:AssistantAnswer .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AssistantAnswer .
                    ?child a pko:StepExecution .
                    ?child pko-native-procedural-knowledge-rulebook:procedureExecution ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:executionOfContext ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:step ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:assumedCurrentStep ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:executionStatus_StepExecutions ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    FILTER((COALESCE(?c4__key, STR(?c4)) = "Completed"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
