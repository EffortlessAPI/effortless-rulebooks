    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:signalsIncompleteStep ?signals_incomplete_step . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . }
                BIND(IF(COALESCE(?signals_incomplete_step, false), ?step, "") AS ?_result)
            }
