    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:namedKnowledgeGap ?named_knowledge_gap . OPTIONAL { ?named_knowledge_gap erb:key ?named_knowledge_gap__key . } }
                BIND((COALESCE(?has_internal_shortfall, false) && COALESCE((COALESCE(?named_knowledge_gap__key, COALESCE(IF(isIRI(?named_knowledge_gap), REPLACE(STR(?named_knowledge_gap), "^.*[#/]", ""), STR(?named_knowledge_gap)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeAuditItems_IsSingleTeamSilo a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeAuditItem ;
    sh:order 1 ;
    sh:rule [
