        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:ClaimEvidence .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:articleClaim ?article_claim . OPTIONAL { ?article_claim erb:key ?article_claim__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evidenceKind ?evidence_kind . OPTIONAL { ?evidence_kind erb:key ?evidence_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?article_claim__key, IF(isIRI(?article_claim), REPLACE(STR(?article_claim), "^.*[#/]", ""), STR(?article_claim))), ""), " <- ", COALESCE(COALESCE(?evidence_kind__key, IF(isIRI(?evidence_kind), REPLACE(STR(?evidence_kind), "^.*[#/]", ""), STR(?evidence_kind))), "")) AS ?_result)
            }
        """ ;
    ] .
