pko-native-procedural-knowledge-rulebook-shapes:OperationalBindings_AgeMinutes a sh:NodeShape ;
    sh:targetClass pko-extension:OperationalBinding ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_AgeMinutes" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:ageMinutes ?_result .
            }
            WHERE {
    $this a pko-extension:OperationalBinding .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastObservedAt ?last_observed_at . }
                BIND(ROUND(((((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_observed_at) + FLOOR((153 * (MONTH(?last_observed_at) + 12 * FLOOR((14 - MONTH(?last_observed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_observed_at) + 4800 - FLOOR((14 - MONTH(?last_observed_at)) / 12)) + FLOOR((YEAR(?last_observed_at) + 4800 - FLOOR((14 - MONTH(?last_observed_at)) / 12)) / 4) - FLOOR((YEAR(?last_observed_at) + 4800 - FLOOR((14 - MONTH(?last_observed_at)) / 12)) / 100) + FLOOR((YEAR(?last_observed_at) + 4800 - FLOOR((14 - MONTH(?last_observed_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?as_of_instant) * 3600 + MINUTES(?as_of_instant) * 60 + SECONDS(?as_of_instant)) - (HOURS(?last_observed_at) * 3600 + MINUTES(?last_observed_at) * 60 + SECONDS(?last_observed_at))) / 60)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OperationalBindings_IsFresh a sh:NodeShape ;
    sh:targetClass pko-extension:OperationalBinding ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_IsFresh" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFresh ?_result .
            }
            WHERE {
    $this a pko-extension:OperationalBinding .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ageMinutes ?age_minutes . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:freshnessSlaMinutes ?freshness_sla_minutes . }
                BIND((COALESCE(?age_minutes, 0) <= COALESCE(?freshness_sla_minutes, 0)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OperationalBindings_StaleBindingStepKey a sh:NodeShape ;
    sh:targetClass pko-extension:OperationalBinding ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_StaleBindingStepKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:staleBindingStepKey ?_result .
            }
            WHERE {
    $this a pko-extension:OperationalBinding .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isFresh ?is_fresh . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . }
                BIND(IF(COALESCE((!(COALESCE(?is_fresh, false))), false), ?step, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OperationalBindings_AuthoritativeStaleStepKey a sh:NodeShape ;
    sh:targetClass pko-extension:OperationalBinding ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_AuthoritativeStaleStepKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:authoritativeStaleStepKey ?_result .
            }
            WHERE {
    $this a pko-extension:OperationalBinding .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAuthoritative ?is_authoritative . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isFresh ?is_fresh . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . }
                BIND(IF(COALESCE((COALESCE((!(COALESCE(?is_fresh, false))), false) && COALESCE(?is_authoritative, false)), false), ?step, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OperationalBindings_IsStaleAndAuthoritative a sh:NodeShape ;
    sh:targetClass pko-extension:OperationalBinding ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_IsStaleAndAuthoritative" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isStaleAndAuthoritative ?_result .
            }
            WHERE {
    $this a pko-extension:OperationalBinding .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAuthoritative ?is_authoritative . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isFresh ?is_fresh . }
                BIND((COALESCE(?is_authoritative, false) && COALESCE((!(COALESCE(?is_fresh, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OperationalBindings_StepWhenStale a sh:NodeShape ;
    sh:targetClass pko-extension:OperationalBinding ;
