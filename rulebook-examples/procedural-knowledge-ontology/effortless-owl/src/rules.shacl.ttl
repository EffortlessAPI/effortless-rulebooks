    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:controlKind ?control_kind . OPTIONAL { ?control_kind erb:key ?control_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isSoftwareAssigned ?is_software_assigned . }
                BIND((COALESCE((COALESCE(?control_kind__key, COALESCE(IF(isIRI(?control_kind), REPLACE(STR(?control_kind), "^.*[#/]", ""), STR(?control_kind)), "")) = "Approval"), false) && COALESCE(?is_software_assigned, false)) AS ?_result)
            }
