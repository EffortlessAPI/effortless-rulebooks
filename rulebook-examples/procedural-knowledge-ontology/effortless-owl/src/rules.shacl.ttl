            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:currentLastApprovalAt ?_result .
            }
            WHERE {
    $this a pko-extension:MessageDelivery .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:messageTemplate ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:MessageTemplates . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:lastApprovalAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageDeliveries_TemplateReapprovedSinceSend a sh:NodeShape ;
