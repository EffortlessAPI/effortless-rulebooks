            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:exceptionPrescribedAnAlternative ?exception_prescribed_an_alternative . }
    OPTIONAL { $this effortless-ntwf:prescribedHandlingWasPerformed ?prescribed_handling_was_performed . }
                BIND((COALESCE(?exception_prescribed_an_alternative, false) && COALESCE((!(COALESCE(?prescribed_handling_was_performed, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_HasDurableRefusalRecord" ;
