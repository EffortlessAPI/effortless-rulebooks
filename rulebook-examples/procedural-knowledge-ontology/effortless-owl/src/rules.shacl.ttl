            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:lastApprovedBodyHash ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:MessageTemplates .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastValidApproval ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:TemplateApproval . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:approvedBodyHash ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageTemplates_HasBodyDrifted a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_HasBodyDrifted" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasBodyDrifted ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:MessageTemplates .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:currentBodyHash ?current_body_hash . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:lastApprovedBodyHash ?last_approved_body_hash . OPTIONAL { ?last_approved_body_hash erb:key ?last_approved_body_hash__key . } }
                BIND((COALESCE((COALESCE(?last_approved_body_hash__key, COALESCE(IF(isIRI(?last_approved_body_hash), REPLACE(STR(?last_approved_body_hash), "^.*[#/]", ""), STR(?last_approved_body_hash)), "")) != ""), false) && COALESCE(COALESCE((?current_body_hash != ?last_approved_body_hash), !((!BOUND(?current_body_hash) || STR(?current_body_hash) = "") && (!BOUND(?last_approved_body_hash) || STR(?last_approved_body_hash) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageTemplates_IsSendableUnderApproval a sh:NodeShape ;
