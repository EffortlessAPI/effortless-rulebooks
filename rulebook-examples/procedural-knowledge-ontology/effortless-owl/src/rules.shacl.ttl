            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:hasUnreachableExceptionInvoked ?has_unreachable_exception_invoked . }
    OPTIONAL { $this effortless-ntwf:recipientIsUnreachable ?recipient_is_unreachable . }
                BIND((COALESCE(?recipient_is_unreachable, false) && COALESCE((!(COALESCE(?has_unreachable_exception_invoked, false))), false)) AS ?_result)
            }
