                BIND((COALESCE((COALESCE(?latest_source_document_modified_at__key, COALESCE(IF(isIRI(?latest_source_document_modified_at), REPLACE(STR(?latest_source_document_modified_at), "^.*[#/]", ""), STR(?latest_source_document_modified_at)), "")) != ""), false) && COALESCE((COALESCE(?days_document_trails_version, 0) > 60), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_HumanStepCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HumanStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:humanStepCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                    ?child a p-plan:Step .
                    ?child pko-native-procedural-knowledge-rulebook:procedureVersion $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:assignedAgentKind ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Human"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
