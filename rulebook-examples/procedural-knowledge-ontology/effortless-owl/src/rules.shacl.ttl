    $this a pko-native-procedural-knowledge-rulebook:Procedures .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:Procedures .
                    ?child a pko-extension:OnboardingRecord .
                    ?child pko-native-procedural-knowledge-rulebook:procedure $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isProficient ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:usedCapturedKnowledge ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:daysToProficiency ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER(BOUND(?c4) && ?c4 = false)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Procedures_AvgDaysToProficiencyWithCapture a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_AvgDaysToProficiencyWithCapture" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:avgDaysToProficiencyWithCapture ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Procedures .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysWithCaptureTotal ?days_with_capture_total . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:proficientWithCaptureCount ?proficient_with_capture_count . }
                BIND(IF(COALESCE((COALESCE(?proficient_with_capture_count, 0) = 0), false), 0, (ROUND(xsd:double(?days_with_capture_total / ?proficient_with_capture_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Procedures_AvgDaysToProficiencyWithoutCapture a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_AvgDaysToProficiencyWithoutCapture" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:avgDaysToProficiencyWithoutCapture ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Procedures .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysWithoutCaptureTotal ?days_without_capture_total . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:proficientWithoutCaptureCount ?proficient_without_capture_count . }
                BIND(IF(COALESCE((COALESCE(?proficient_without_capture_count, 0) = 0), false), 0, (ROUND(xsd:double(?days_without_capture_total / ?proficient_without_capture_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Procedures_FormalizationDoesNotEaseOnboarding a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_FormalizationDoesNotEaseOnboarding" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:formalizationDoesNotEaseOnboarding ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Procedures .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:avgDaysToProficiencyWithCapture ?avg_days_to_proficiency_with_capture . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:avgDaysToProficiencyWithoutCapture ?avg_days_to_proficiency_without_capture . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:proficientWithCaptureCount ?proficient_with_capture_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:proficientWithoutCaptureCount ?proficient_without_capture_count . }
                BIND((COALESCE((COALESCE(?proficient_with_capture_count, 0) > 0), false) && COALESCE((COALESCE(?proficient_without_capture_count, 0) > 0), false) && COALESCE((COALESCE(?avg_days_to_proficiency_with_capture, 0) >= COALESCE(?avg_days_to_proficiency_without_capture, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
