pko-native-procedural-knowledge-rulebook-shapes:SourcingFunctions_DesignsWhatItCannotBuild a sh:NodeShape ;
    sh:targetClass pko-extension:SourcingFunction ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_DesignsWhatItCannotBuild" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:designsWhatItCannotBuild ?_result .
            }
            WHERE {
    $this a pko-extension:SourcingFunction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deliversOwnProduct ?delivers_own_product . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOutsourced ?is_outsourced . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:methodShortfallCount ?method_shortfall_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:providerIpDocumentationCount ?provider_ip_documentation_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:specificationAuditCount ?specification_audit_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:specificationShortfallCount ?specification_shortfall_count . }
                BIND((COALESCE(?delivers_own_product, false) && COALESCE(?is_outsourced, false) && COALESCE((COALESCE(?provider_ip_documentation_count, 0) > 0), false) && COALESCE((COALESCE(?specification_audit_count, 0) > 0), false) && COALESCE((COALESCE(?specification_shortfall_count, 0) = 0), false) && COALESCE((COALESCE(?method_shortfall_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
