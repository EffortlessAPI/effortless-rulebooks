                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:hasValidApproval ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsUnapprovedSend" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnapprovedSend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:templateHasValidApproval ?template_has_valid_approval . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((!(COALESCE(?template_has_valid_approval, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyRequiredOptOutPhrase" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyRequiredOptOutPhrase ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:policyChannel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:requiredOptOutPhrase ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyRequiresOptOut" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyRequiresOptOut ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyRequiredOptOutPhrase ?policy_required_opt_out_phrase . }
                BIND((REPLACE(COALESCE(STR(?policy_required_opt_out_phrase), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_OptOutPhrasePosition" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:optOutPhrasePosition ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyRequiredOptOutPhrase ?policy_required_opt_out_phrase . }
    OPTIONAL { $this effortless-ntwf:renderedBody ?rendered_body . }
                BIND(ROUND(IF(CONTAINS(STR(?rendered_body), STR(?policy_required_opt_out_phrase)), STRLEN(STRBEFORE(STR(?rendered_body), STR(?policy_required_opt_out_phrase))) + 1, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_HasOptOutPhrase" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasOptOutPhrase ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:optOutPhrasePosition ?opt_out_phrase_position . }
                BIND((COALESCE(?opt_out_phrase_position, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsOptOutInFirstSegment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOptOutInFirstSegment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:hasOptOutPhrase ?has_opt_out_phrase . }
    OPTIONAL { $this effortless-ntwf:optOutPhrasePosition ?opt_out_phrase_position . }
    OPTIONAL { $this effortless-ntwf:policyMaxMessageLengthAtSend ?policy_max_message_length_at_send . }
                BIND((COALESCE(?has_opt_out_phrase, false) && COALESCE((COALESCE(?opt_out_phrase_position, 0) <= COALESCE(?policy_max_message_length_at_send, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsMissingRequiredOptOut" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMissingRequiredOptOut ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:hasOptOutPhrase ?has_opt_out_phrase . }
    OPTIONAL { $this effortless-ntwf:policyRequiresOptOut ?policy_requires_opt_out . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((COALESCE(?policy_requires_opt_out, false) && COALESCE((!(COALESCE(?has_opt_out_phrase, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsOptOutAtRiskOfTruncation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOptOutAtRiskOfTruncation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:hasOptOutPhrase ?has_opt_out_phrase . }
    OPTIONAL { $this effortless-ntwf:isOptOutInFirstSegment ?is_opt_out_in_first_segment . }
    OPTIONAL { $this effortless-ntwf:policyRequiresOptOut ?policy_requires_opt_out . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((COALESCE(?policy_requires_opt_out, false) && COALESCE((COALESCE(?has_opt_out_phrase, false) && COALESCE((!(COALESCE(?is_opt_out_in_first_segment, false))), false)), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsFailedDelivery" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFailedDelivery ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:deliveryStatus ?delivery_status . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?delivery_status), ""), "^.*#", "") = "Failed"), false) || COALESCE((REPLACE(COALESCE(STR(?delivery_status), ""), "^.*#", "") = "Bounced"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsSuppressed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSuppressed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:deliveryStatus ?delivery_status . }
                BIND((REPLACE(COALESCE(STR(?delivery_status), ""), "^.*#", "") = "Suppressed") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsTriaged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isTriaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:invokedException ?invoked_exception . }
                BIND((REPLACE(COALESCE(STR(?invoked_exception), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsAbandonedFailure" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAbandonedFailure ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isFailedDelivery ?is_failed_delivery . }
    OPTIONAL { $this effortless-ntwf:isTriaged ?is_triaged . }
                BIND((COALESCE(?is_failed_delivery, false) && COALESCE((!(COALESCE(?is_triaged, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_AbandonedFailureExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:abandonedFailureExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isAbandonedFailure ?is_abandoned_failure . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?is_abandoned_failure, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_ReachedExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reachedExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:deliveryStatus ?delivery_status . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE((REPLACE(COALESCE(STR(?delivery_status), ""), "^.*#", "") = "Delivered"), false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_TemplateWasSendable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:templateWasSendable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isSendableUnderApproval ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsDriftedSend" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDriftedSend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:templateWasSendable ?template_was_sendable . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((!(COALESCE(?template_was_sendable, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_DriftedSendTemplateKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:driftedSendTemplateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isDriftedSend ?is_drifted_send . }
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . }
                BIND(IF(COALESCE(?is_drifted_send, false), ?message_template, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_WasSentOutsideBusinessHours" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasSentOutsideBusinessHours ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:sentAtLocalHour ?sent_at_local_hour . }
                BIND((COALESCE((COALESCE(?sent_at_local_hour, 0) < 8), false) || COALESCE((COALESCE(?sent_at_local_hour, 0) > 18), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_WasDeliveredAndUnanswered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasDeliveredAndUnanswered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isAcknowledged ?is_acknowledged . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((!(COALESCE(?is_acknowledged, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsPoorlyTimedUnanswered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPoorlyTimedUnanswered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:wasDeliveredAndUnanswered ?was_delivered_and_unanswered . }
    OPTIONAL { $this effortless-ntwf:wasSentOutsideBusinessHours ?was_sent_outside_business_hours . }
                BIND((COALESCE(?was_delivered_and_unanswered, false) && COALESCE(?was_sent_outside_business_hours, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsWellTimedUnanswered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWellTimedUnanswered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:wasDeliveredAndUnanswered ?was_delivered_and_unanswered . }
    OPTIONAL { $this effortless-ntwf:wasSentOutsideBusinessHours ?was_sent_outside_business_hours . }
                BIND((COALESCE(?was_delivered_and_unanswered, false) && COALESCE((!(COALESCE(?was_sent_outside_business_hours, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_UnansweredTemplateKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unansweredTemplateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . }
    OPTIONAL { $this effortless-ntwf:wasDeliveredAndUnanswered ?was_delivered_and_unanswered . }
                BIND(IF(COALESCE(?was_delivered_and_unanswered, false), ?message_template, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_TransmittedTemplateKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:transmittedTemplateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND(IF(COALESCE(?was_actually_transmitted, false), ?message_template, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_ApprovalPrecededSend" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approvalPrecededSend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:approvalDecidedAtSend ?approval_decided_at_send . }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?approval_decided_at_send), ""), "^.*#", "") != ""), false) && COALESCE(COALESCE((?sent_at > ?approval_decided_at_send), false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_HasFrozenApprovalEvidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasFrozenApprovalEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:approvalDecidedAtSend ?approval_decided_at_send . }
    OPTIONAL { $this effortless-ntwf:approvingAgentAtSend ?approving_agent_at_send . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?approving_agent_at_send), ""), "^.*#", "") != ""), false) && COALESCE((REPLACE(COALESCE(STR(?approval_decided_at_send), ""), "^.*#", "") != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_ProvenanceIsLiveDerived" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:provenanceIsLiveDerived ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:hasFrozenApprovalEvidence ?has_frozen_approval_evidence . }
                BIND((!(COALESCE(?has_frozen_approval_evidence, false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_CurrentLastApprovalAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentLastApprovalAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:lastApprovalAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_TemplateReapprovedSinceSend" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:templateReapprovedSinceSend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:currentLastApprovalAt ?current_last_approval_at . }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?current_last_approval_at), ""), "^.*#", "") != ""), false) && COALESCE(COALESCE((?current_last_approval_at > ?sent_at), false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsUnprovableApprovalClaim" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnprovableApprovalClaim ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:provenanceIsLiveDerived ?provenance_is_live_derived . }
    OPTIONAL { $this effortless-ntwf:templateHasValidApproval ?template_has_valid_approval . }
    OPTIONAL { $this effortless-ntwf:templateReapprovedSinceSend ?template_reapproved_since_send . }
                BIND((COALESCE(?provenance_is_live_derived, false) && COALESCE((COALESCE(?template_reapproved_since_send, false) && COALESCE(?template_has_valid_approval, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_HasSentReminder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasSentReminder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:reminderCount ?reminder_count . }
                BIND((COALESCE(?reminder_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_AcknowledgementIsOutstanding" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:acknowledgementIsOutstanding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isAcknowledged ?is_acknowledged . }
    OPTIONAL { $this effortless-ntwf:isEvidenceRequired ?is_evidence_required . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((COALESCE(?is_evidence_required, false) && COALESCE((!(COALESCE(?is_acknowledged, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_OutstandingAgeDays" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:outstandingAgeDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:acknowledgementIsOutstanding ?acknowledgement_is_outstanding . }
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND(ROUND(IF(COALESCE(?acknowledgement_is_outstanding, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?sent_at) + FLOOR((153 * (MONTH(?sent_at) + 12 * FLOOR((14 - MONTH(?sent_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 4) - FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 100) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsUnchasedAcknowledgement" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnchasedAcknowledgement ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:acknowledgementIsOutstanding ?acknowledgement_is_outstanding . }
    OPTIONAL { $this effortless-ntwf:hasSentReminder ?has_sent_reminder . }
    OPTIONAL { $this effortless-ntwf:outstandingAgeDays ?outstanding_age_days . }
                BIND((COALESCE(?acknowledgement_is_outstanding, false) && COALESCE((COALESCE((COALESCE(?outstanding_age_days, 0) > 7), false) && COALESCE((!(COALESCE(?has_sent_reminder, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsExhaustedFollowUp" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isExhaustedFollowUp ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:acknowledgementIsOutstanding ?acknowledgement_is_outstanding . }
    OPTIONAL { $this effortless-ntwf:reminderCount ?reminder_count . }
                BIND((COALESCE(?acknowledgement_is_outstanding, false) && COALESCE((COALESCE(?reminder_count, 0) >= 3), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_NeedsHumanEscalation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:needsHumanEscalation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:hasUnreachableExceptionInvoked ?has_unreachable_exception_invoked . }
    OPTIONAL { $this effortless-ntwf:isExhaustedFollowUp ?is_exhausted_follow_up . }
                BIND((COALESCE(?is_exhausted_follow_up, false) && COALESCE((!(COALESCE(?has_unreachable_exception_invoked, false))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for MessageTemplates ===
effortless-ntwf:MessageTemplatesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:MessageTemplates ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:communicationPolicy ?communication_policy . }
    OPTIONAL { $this effortless-ntwf:locale ?locale . }
                BIND(CONCAT(IF(isIRI(?communication_policy), REPLACE(STR(?communication_policy), "^.*[#/]", ""), STR(?communication_policy)), " / ", IF(isIRI(?locale), REPLACE(STR(?locale), "^.*[#/]", ""), STR(?locale))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_PolicyMaxMessageLength" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyMaxMessageLength ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                OPTIONAL { $this effortless-ntwf:communicationPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:maxMessageLength ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_PolicyMaxSegments" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyMaxSegments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                OPTIONAL { $this effortless-ntwf:communicationPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:maxSegments ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_BodyTemplateLength" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:bodyTemplateLength ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:bodyTemplate ?body_template . }
                BIND(ROUND(STRLEN(STR(?body_template))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_IsTemplateOverLength" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isTemplateOverLength ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:bodyTemplateLength ?body_template_length . }
    OPTIONAL { $this effortless-ntwf:policyMaxMessageLength ?policy_max_message_length . }
                BIND((COALESCE(?body_template_length, 0) > COALESCE(?policy_max_message_length, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_ValidApprovalCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:validApprovalCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TemplateApprovals .
                    ?child effortless-ntwf:validApprovalTemplateKey ?backfk .
                    $this effortless-ntwf:messageTemplateId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_HasValidApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasValidApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:validApprovalCount ?valid_approval_count . }
                BIND((COALESCE(?valid_approval_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_IsClaimingUnbackedApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isClaimingUnbackedApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:hasValidApproval ?has_valid_approval . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved"), false) && COALESCE((!(COALESCE(?has_valid_approval, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_LastApprovedBodyHash" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lastApprovedBodyHash ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                OPTIONAL { $this effortless-ntwf:lastValidApproval ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:TemplateApprovals ; effortless-ntwf:templateApprovalId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:approvedBodyHash ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_HasBodyDrifted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasBodyDrifted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:currentBodyHash ?current_body_hash . }
    OPTIONAL { $this effortless-ntwf:lastApprovedBodyHash ?last_approved_body_hash . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?last_approved_body_hash), ""), "^.*#", "") != ""), false) && COALESCE(COALESCE((?current_body_hash != ?last_approved_body_hash), !((!BOUND(?current_body_hash) || STR(?current_body_hash) = "") && (!BOUND(?last_approved_body_hash) || STR(?last_approved_body_hash) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_IsSendableUnderApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSendableUnderApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:hasBodyDrifted ?has_body_drifted . }
    OPTIONAL { $this effortless-ntwf:hasValidApproval ?has_valid_approval . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved"), false) && COALESCE((COALESCE(?has_valid_approval, false) && COALESCE((!(COALESCE(?has_body_drifted, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_DriftedSendCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:driftedSendCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MessageDeliveries .
                    ?child effortless-ntwf:driftedSendTemplateKey ?backfk .
                    $this effortless-ntwf:messageTemplateId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_UnansweredDeliveryCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unansweredDeliveryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MessageDeliveries .
                    ?child effortless-ntwf:unansweredTemplateKey ?backfk .
                    $this effortless-ntwf:messageTemplateId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_TransmittedDeliveryCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:transmittedDeliveryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MessageDeliveries .
                    ?child effortless-ntwf:transmittedTemplateKey ?backfk .
                    $this effortless-ntwf:messageTemplateId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_TemplateDrawsNoResponse" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:templateDrawsNoResponse ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
    OPTIONAL { $this effortless-ntwf:transmittedDeliveryCount ?transmitted_delivery_count . }
    OPTIONAL { $this effortless-ntwf:unansweredDeliveryCount ?unanswered_delivery_count . }
                BIND((COALESCE((COALESCE(?transmitted_delivery_count, 0) > 0), false) && COALESCE((COALESCE(?unanswered_delivery_count, 0) = COALESCE(?transmitted_delivery_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageTemplates_LastApprovalAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lastApprovalAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageTemplates .
                OPTIONAL { $this effortless-ntwf:lastValidApproval ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:TemplateApprovals ; effortless-ntwf:templateApprovalId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:decidedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ObservedTransitions ===
effortless-ntwf:ObservedTransitionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ObservedTransitions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ObservedTransitions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ObservedTransitions .
    OPTIONAL { $this effortless-ntwf:observedAt ?observed_at . }
    OPTIONAL { $this effortless-ntwf:stepTransition ?step_transition . }
                BIND(CONCAT(IF(isIRI(?step_transition), REPLACE(STR(?step_transition), "^.*[#/]", ""), STR(?step_transition)), " @ ", REPLACE(IF(isIRI(?observed_at), REPLACE(STR(?observed_at), "^.*[#/]", ""), STR(?observed_at)), "Z$", "+00:00")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for OntologyProfiles ===
effortless-ntwf:OntologyProfilesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OntologyProfiles ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
    OPTIONAL { $this effortless-ntwf:label ?label . }
    OPTIONAL { $this effortless-ntwf:version ?version . }
                BIND(CONCAT(IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label)), " ", IF(isIRI(?version), REPLACE(STR(?version), "^.*[#/]", ""), STR(?version))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for OperationalBindings ===
effortless-ntwf:OperationalBindingsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OperationalBindings ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:recordOrSchemaKey ?record_or_schema_key . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(CONCAT(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step)), " / ", IF(isIRI(?record_or_schema_key), REPLACE(STR(?record_or_schema_key), "^.*[#/]", ""), STR(?record_or_schema_key))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_AgeMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ageMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:lastObservedAt ?last_observed_at . }
                BIND(ROUND(((((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_observed_at) + FLOOR((153 * (MONTH(?last_observed_at) + 12 * FLOOR((14 - MONTH(?last_observed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_observed_at) + 4800 - FLOOR((14 - MONTH(?last_observed_at)) / 12)) + FLOOR((YEAR(?last_observed_at) + 4800 - FLOOR((14 - MONTH(?last_observed_at)) / 12)) / 4) - FLOOR((YEAR(?last_observed_at) + 4800 - FLOOR((14 - MONTH(?last_observed_at)) / 12)) / 100) + FLOOR((YEAR(?last_observed_at) + 4800 - FLOOR((14 - MONTH(?last_observed_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?as_of_instant) * 3600 + MINUTES(?as_of_instant) * 60 + SECONDS(?as_of_instant)) - (HOURS(?last_observed_at) * 3600 + MINUTES(?last_observed_at) * 60 + SECONDS(?last_observed_at))) / 60)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_IsFresh" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFresh ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:ageMinutes ?age_minutes . }
    OPTIONAL { $this effortless-ntwf:freshnessSlaMinutes ?freshness_sla_minutes . }
                BIND((COALESCE(?age_minutes, 0) <= COALESCE(?freshness_sla_minutes, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_StaleBindingStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:staleBindingStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isFresh ?is_fresh . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE((!(COALESCE(?is_fresh, false))), false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_AuthoritativeStaleStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:authoritativeStaleStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isAuthoritative ?is_authoritative . }
    OPTIONAL { $this effortless-ntwf:isFresh ?is_fresh . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE((COALESCE((!(COALESCE(?is_fresh, false))), false) && COALESCE(?is_authoritative, false)), false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_IsStaleAndAuthoritative" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStaleAndAuthoritative ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isAuthoritative ?is_authoritative . }
    OPTIONAL { $this effortless-ntwf:isFresh ?is_fresh . }
                BIND((COALESCE(?is_authoritative, false) && COALESCE((!(COALESCE(?is_fresh, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_StepWhenStale" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepWhenStale ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isStaleAndAuthoritative ?is_stale_and_authoritative . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_stale_and_authoritative, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_ResourceIsApproved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:resourceIsApproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
                OPTIONAL { $this effortless-ntwf:resource ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Resources ; effortless-ntwf:resourceId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isApprovedSource ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_IsUsableForDrafting" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUsableForDrafting ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isFresh ?is_fresh . }
    OPTIONAL { $this effortless-ntwf:resourceIsApproved ?resource_is_approved . }
                BIND((COALESCE(?resource_is_approved, false) && COALESCE(?is_fresh, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_StepWhenUnusable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepWhenUnusable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isUsableForDrafting ?is_usable_for_drafting . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_usable_for_drafting, false), "", ?step) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Organizations ===
effortless-ntwf:OrganizationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Organizations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
    OPTIONAL { $this effortless-ntwf:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for PrincipalAssignments ===
effortless-ntwf:PrincipalAssignmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:PrincipalAssignments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
    OPTIONAL { $this effortless-ntwf:appUser ?app_user . }
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
                BIND(CONCAT(IF(isIRI(?app_user), REPLACE(STR(?app_user), "^.*[#/]", ""), STR(?app_user)), " as ", IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_PrincipalIsAdmin" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:principalIsAdmin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
                OPTIONAL { $this effortless-ntwf:principal ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AccessPrincipals ; effortless-ntwf:accessPrincipalId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isAdministrator ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_UserOrganization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:userOrganization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
                OPTIONAL { $this effortless-ntwf:appUser ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AppUsers ; effortless-ntwf:appUserId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_PrincipalOrganization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:principalOrganization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
                OPTIONAL { $this effortless-ntwf:principal ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AccessPrincipals ; effortless-ntwf:accessPrincipalId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organizationScope ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_IsCrossOrganizationGrant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCrossOrganizationGrant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
    OPTIONAL { $this effortless-ntwf:principalOrganization ?principal_organization . }
    OPTIONAL { $this effortless-ntwf:userOrganization ?user_organization . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?user_organization), ""), "^.*#", "") != ""), false) && COALESCE((REPLACE(COALESCE(STR(?principal_organization), ""), "^.*#", "") != ""), false) && COALESCE(COALESCE((?user_organization != ?principal_organization), !((!BOUND(?user_organization) || STR(?user_organization) = "") && (!BOUND(?principal_organization) || STR(?principal_organization) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureExecutions ===
effortless-ntwf:ProcedureExecutionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureExecutions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:context ?context . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(CONCAT(IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version)), " / ", IF(isIRI(?context), REPLACE(STR(?context), "^.*[#/]", ""), STR(?context))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ExpectedStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expectedStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:specifiedStepCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_CompletedStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:completedStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:completedExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ControlBreachCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:controlBreachCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:controlBreachExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_LateStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lateStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:lateExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_IsStructurallyComplete" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStructurallyComplete ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:completedStepCount ?completed_step_count . }
    OPTIONAL { $this effortless-ntwf:expectedStepCount ?expected_step_count . }
                BIND((COALESCE(?completed_step_count, 0) >= COALESCE(?expected_step_count, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_DivergedFromSpecification" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:divergedFromSpecification ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:controlBreachCount ?control_breach_count . }
    OPTIONAL { $this effortless-ntwf:isStructurallyComplete ?is_structurally_complete . }
                BIND((COALESCE((!(COALESCE(?is_structurally_complete, false))), false) || COALESCE((COALESCE(?control_breach_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AllBlockingControlsEvaluated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:allBlockingControlsEvaluated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:unevaluatedBlockingTotal ?unevaluated_blocking_total . }
                BIND((COALESCE(?unevaluated_blocking_total, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_UnevaluatedBlockingTotal" ;
