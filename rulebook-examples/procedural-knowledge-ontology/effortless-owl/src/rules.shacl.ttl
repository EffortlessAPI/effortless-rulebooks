            }
            WHERE {
    $this a pko-extension:Vocabulary .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:orphanTermCount ?orphan_term_count . }
                BIND((COALESCE(?orphan_term_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Vocabularies_IsMachineAccessible a sh:NodeShape ;
    sh:targetClass pko-extension:Vocabulary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_IsMachineAccessible" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isMachineAccessible ?_result .
            }
            WHERE {
    $this a pko-extension:Vocabulary .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:publicationFormat ?publication_format . OPTIONAL { ?publication_format erb:key ?publication_format__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:schemeUri ?scheme_uri . OPTIONAL { ?scheme_uri erb:key ?scheme_uri__key . } }
                BIND((COALESCE((COALESCE(?scheme_uri__key, COALESCE(IF(isIRI(?scheme_uri), REPLACE(STR(?scheme_uri), "^.*[#/]", ""), STR(?scheme_uri)), "")) != ""), false) && COALESCE((COALESCE(?publication_format__key, COALESCE(IF(isIRI(?publication_format), REPLACE(STR(?publication_format), "^.*[#/]", ""), STR(?publication_format)), "")) = "SKOS Turtle"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Vocabularies_ManagedSchemeProcedureKey a sh:NodeShape ;
    sh:targetClass pko-extension:Vocabulary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_ManagedSchemeProcedureKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:managedSchemeProcedureKey ?_result .
            }
            WHERE {
    $this a pko-extension:Vocabulary .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:establishedAt ?established_at . OPTIONAL { ?established_at erb:key ?established_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:governingRole ?governing_role . OPTIONAL { ?governing_role erb:key ?governing_role__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:governsProcedure ?governs_procedure . }
                BIND(IF(COALESCE((COALESCE((COALESCE(?governing_role__key, COALESCE(IF(isIRI(?governing_role), REPLACE(STR(?governing_role), "^.*[#/]", ""), STR(?governing_role)), "")) != ""), false) && COALESCE((COALESCE(?established_at__key, COALESCE(IF(isIRI(?established_at), REPLACE(STR(?established_at), "^.*[#/]", ""), STR(?established_at)), "")) != ""), false)), false), ?governs_procedure, "") AS ?_result)
            }
        """ ;
    ] .
