    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:specifiedStepTotal ?specified_step_total . }
                BIND((COALESCE(?specified_step_total, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Procedures_CalledByStepCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_CalledByStepCount" ;
