                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MachineTypes .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Machines ===
effortless-ntwf:MachinesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Machines ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Machines_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Machines .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Machines_EnergySourceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:energySourceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Machines .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MachineEnergySources .
                    ?child effortless-ntwf:machine $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Machines_UnisolatedEnergySourceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unisolatedEnergySourceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Machines .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MachineEnergySources .
                    ?child effortless-ntwf:unisolatedMachineKey ?backfk .
                    $this effortless-ntwf:machineId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Machines_IsNonStandardConfiguration" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNonStandardConfiguration ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Machines .
    OPTIONAL { $this effortless-ntwf:configurationKind ?configuration_kind . OPTIONAL { ?configuration_kind effortless-ntwf:__key ?configuration_kind__key . } }
                BIND((COALESCE(?configuration_kind__key, COALESCE(IF(isIRI(?configuration_kind), REPLACE(STR(?configuration_kind), "^.*[#/]", ""), STR(?configuration_kind)), "")) = "NonStandard") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Machines_HasUnisolatedEnergySource" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasUnisolatedEnergySource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Machines .
    OPTIONAL { $this effortless-ntwf:unisolatedEnergySourceCount ?unisolated_energy_source_count . }
                BIND((COALESCE(?unisolated_energy_source_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Mentorships ===
effortless-ntwf:MentorshipsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Mentorships ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Mentorships_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Mentorships .
    OPTIONAL { $this effortless-ntwf:learnerAgent ?learner_agent . OPTIONAL { ?learner_agent effortless-ntwf:__key ?learner_agent__key . } }
    OPTIONAL { $this effortless-ntwf:mentorAgent ?mentor_agent . OPTIONAL { ?mentor_agent effortless-ntwf:__key ?mentor_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?mentor_agent__key, IF(isIRI(?mentor_agent), REPLACE(STR(?mentor_agent), "^.*[#/]", ""), STR(?mentor_agent))), ""), " -> ", COALESCE(COALESCE(?learner_agent__key, IF(isIRI(?learner_agent), REPLACE(STR(?learner_agent), "^.*[#/]", ""), STR(?learner_agent))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Mentorships_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Mentorships .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Mentorships_IsActive" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isActive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Mentorships .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . OPTIONAL { ?valid_from effortless-ntwf:__key ?valid_from__key . } }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . OPTIONAL { ?valid_to effortless-ntwf:__key ?valid_to__key . } }
                BIND((COALESCE((COALESCE(?valid_from__key, COALESCE(IF(isIRI(?valid_from), REPLACE(STR(?valid_from), "^.*[#/]", ""), STR(?valid_from)), "")) != ""), false) && COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = ""), false) || COALESCE(COALESCE((?valid_to >= ?as_of_instant), ((!BOUND(?valid_to) || STR(?valid_to) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Mentorships_DaysSinceStarted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceStarted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Mentorships .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . OPTIONAL { ?valid_from effortless-ntwf:__key ?valid_from__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?valid_from__key, COALESCE(IF(isIRI(?valid_from), REPLACE(STR(?valid_from), "^.*[#/]", ""), STR(?valid_from)), "")) = ""), false), 99999, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?valid_from) + FLOOR((153 * (MONTH(?valid_from) + 12 * FLOOR((14 - MONTH(?valid_from)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 4) - FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 100) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Mentorships_IsRecentApprenticeship" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRecentApprenticeship ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Mentorships .
    OPTIONAL { $this effortless-ntwf:daysSinceStarted ?days_since_started . }
    OPTIONAL { $this effortless-ntwf:mentorshipForm ?mentorship_form . OPTIONAL { ?mentorship_form effortless-ntwf:__key ?mentorship_form__key . } }
                BIND((COALESCE((COALESCE(?mentorship_form__key, COALESCE(IF(isIRI(?mentorship_form), REPLACE(STR(?mentorship_form), "^.*[#/]", ""), STR(?mentorship_form)), "")) = "Apprenticeship"), false) && COALESCE((COALESCE(?days_since_started, 0) >= 0), false) && COALESCE((COALESCE(?days_since_started, 0) <= 1095), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for MessageDeliveries ===
effortless-ntwf:MessageDeliveriesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:MessageDeliveries ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . OPTIONAL { ?message_template effortless-ntwf:__key ?message_template__key . } }
    OPTIONAL { $this effortless-ntwf:recipient ?recipient . OPTIONAL { ?recipient effortless-ntwf:__key ?recipient__key . } }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . OPTIONAL { ?sent_at effortless-ntwf:__key ?sent_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?recipient__key, IF(isIRI(?recipient), REPLACE(STR(?recipient), "^.*[#/]", ""), STR(?recipient))), ""), " / ", COALESCE(COALESCE(?message_template__key, IF(isIRI(?message_template), REPLACE(STR(?message_template), "^.*[#/]", ""), STR(?message_template))), ""), " / ", COALESCE(REPLACE(COALESCE(?sent_at__key, IF(isIRI(?sent_at), REPLACE(STR(?sent_at), "^.*[#/]", ""), STR(?sent_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyChannel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyChannel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:communicationPolicy ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_ChannelName" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:channelName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:policyChannel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:channel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyRequiresConsent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyRequiresConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:policyChannel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:consentRequired ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_RecipientHasSmsConsent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientHasSmsConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:hasSmsConsent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_WasActuallyTransmitted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasActuallyTransmitted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:deliveryStatus ?delivery_status . OPTIONAL { ?delivery_status effortless-ntwf:__key ?delivery_status__key . } }
                BIND((COALESCE((COALESCE(?delivery_status__key, COALESCE(IF(isIRI(?delivery_status), REPLACE(STR(?delivery_status), "^.*[#/]", ""), STR(?delivery_status)), "")) = "Sent"), false) || COALESCE((COALESCE((COALESCE(?delivery_status__key, COALESCE(IF(isIRI(?delivery_status), REPLACE(STR(?delivery_status), "^.*[#/]", ""), STR(?delivery_status)), "")) = "Delivered"), false) || COALESCE((COALESCE(?delivery_status__key, COALESCE(IF(isIRI(?delivery_status), REPLACE(STR(?delivery_status), "^.*[#/]", ""), STR(?delivery_status)), "")) = "Bounced"), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsConsentViolation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isConsentViolation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyRequiresConsent ?policy_requires_consent . }
    OPTIONAL { $this effortless-ntwf:recipientHasSmsConsent ?recipient_has_sms_consent . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((COALESCE(?policy_requires_consent, false) && COALESCE((!(COALESCE(?recipient_has_sms_consent, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_ConsentViolationPolicyKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:consentViolationPolicyKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isConsentViolation ?is_consent_violation . }
    OPTIONAL { $this effortless-ntwf:policyChannel ?policy_channel . }
                BIND(IF(COALESCE(?is_consent_violation, false), ?policy_channel, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyQuietHoursStartHour" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyQuietHoursStartHour ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:policyChannel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:quietHoursStartHour ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyQuietHoursEndHour" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyQuietHoursEndHour ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:policyChannel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:quietHoursEndHour ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyHasQuietHours" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyHasQuietHours ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyQuietHoursEndHour ?policy_quiet_hours_end_hour . }
    OPTIONAL { $this effortless-ntwf:policyQuietHoursStartHour ?policy_quiet_hours_start_hour . }
                BIND((COALESCE(?policy_quiet_hours_start_hour, 0) != COALESCE(?policy_quiet_hours_end_hour, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_QuietWindowWrapsMidnight" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:quietWindowWrapsMidnight ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyQuietHoursEndHour ?policy_quiet_hours_end_hour . }
    OPTIONAL { $this effortless-ntwf:policyQuietHoursStartHour ?policy_quiet_hours_start_hour . }
                BIND((COALESCE(?policy_quiet_hours_start_hour, 0) > COALESCE(?policy_quiet_hours_end_hour, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsInsideQuietWindow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInsideQuietWindow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyQuietHoursEndHour ?policy_quiet_hours_end_hour . }
    OPTIONAL { $this effortless-ntwf:policyQuietHoursStartHour ?policy_quiet_hours_start_hour . }
    OPTIONAL { $this effortless-ntwf:quietWindowWrapsMidnight ?quiet_window_wraps_midnight . }
    OPTIONAL { $this effortless-ntwf:sentAtLocalHour ?sent_at_local_hour . }
                BIND(IF(COALESCE(?quiet_window_wraps_midnight, false), (COALESCE((COALESCE(?sent_at_local_hour, 0) >= COALESCE(?policy_quiet_hours_start_hour, 0)), false) || COALESCE((COALESCE(?sent_at_local_hour, 0) < COALESCE(?policy_quiet_hours_end_hour, 0)), false)), (COALESCE((COALESCE(?sent_at_local_hour, 0) >= COALESCE(?policy_quiet_hours_start_hour, 0)), false) && COALESCE((COALESCE(?sent_at_local_hour, 0) < COALESCE(?policy_quiet_hours_end_hour, 0)), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsQuietHoursViolation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isQuietHoursViolation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isInsideQuietWindow ?is_inside_quiet_window . }
    OPTIONAL { $this effortless-ntwf:policyHasQuietHours ?policy_has_quiet_hours . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((COALESCE(?was_actually_transmitted, false) && COALESCE((COALESCE(?policy_has_quiet_hours, false) && COALESCE(?is_inside_quiet_window, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_QuietHoursViolationPolicyKey" ;
