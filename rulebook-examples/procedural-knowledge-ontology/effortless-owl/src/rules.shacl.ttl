            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:LockDevices .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for MachineEnergySources ===
effortless-ntwf:MachineEnergySourcesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:MachineEnergySources ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineEnergySources_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MachineEnergySources .
    OPTIONAL { $this effortless-ntwf:energySource ?energy_source . OPTIONAL { ?energy_source effortless-ntwf:__key ?energy_source__key . } }
    OPTIONAL { $this effortless-ntwf:machine ?machine . OPTIONAL { ?machine effortless-ntwf:__key ?machine__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?machine__key, IF(isIRI(?machine), REPLACE(STR(?machine), "^.*[#/]", ""), STR(?machine))), ""), " / ", COALESCE(COALESCE(?energy_source__key, IF(isIRI(?energy_source), REPLACE(STR(?energy_source), "^.*[#/]", ""), STR(?energy_source))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineEnergySources_MachineProcedureVersion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:machineProcedureVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MachineEnergySources .
                OPTIONAL { $this effortless-ntwf:machine ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Machines ; effortless-ntwf:machineId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:governingProcedureVersion ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineEnergySources_IsolationStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isolationStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MachineEnergySources .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:isolatesEnergySource ?backfk .
                    $this effortless-ntwf:energySource ?backpv .
                    OPTIONAL { ?child effortless-ntwf:procedureVersion ?c2 . }
                    OPTIONAL { $this effortless-ntwf:machineProcedureVersion ?p2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(REPLACE(STR(?c2), "^.*[#/]", "") = REPLACE(STR(?p2), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineEnergySources_IsUnisolatedEnergySource" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnisolatedEnergySource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MachineEnergySources .
    OPTIONAL { $this effortless-ntwf:isolationStepCount ?isolation_step_count . }
                BIND((COALESCE(?isolation_step_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineEnergySources_UnisolatedMachineKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unisolatedMachineKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MachineEnergySources .
    OPTIONAL { $this effortless-ntwf:isUnisolatedEnergySource ?is_unisolated_energy_source . }
    OPTIONAL { $this effortless-ntwf:machine ?machine . }
                BIND(IF(COALESCE(?is_unisolated_energy_source, false), ?machine, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for MachineTypes ===
effortless-ntwf:MachineTypesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:MachineTypes ;
    sh:rule [
