            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysUntilHolderDeparture ?_result .
            }
            WHERE {
    $this a pko-extension:KnowHowCarrier .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holderDepartureAt ?holder_departure_at . OPTIONAL { ?holder_departure_at erb:key ?holder_departure_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?holder_departure_at__key, COALESCE(IF(isIRI(?holder_departure_at), REPLACE(STR(?holder_departure_at), "^.*[#/]", ""), STR(?holder_departure_at)), "")) = ""), false), 99999, ((DAY(?holder_departure_at) + FLOOR((153 * (MONTH(?holder_departure_at) + 12 * FLOOR((14 - MONTH(?holder_departure_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?holder_departure_at) + 4800 - FLOOR((14 - MONTH(?holder_departure_at)) / 12)) + FLOOR((YEAR(?holder_departure_at) + 4800 - FLOOR((14 - MONTH(?holder_departure_at)) / 12)) / 4) - FLOOR((YEAR(?holder_departure_at) + 4800 - FLOOR((14 - MONTH(?holder_departure_at)) / 12)) / 100) + FLOOR((YEAR(?holder_departure_at) + 4800 - FLOOR((14 - MONTH(?holder_departure_at)) / 12)) / 400) - 32045) - (DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045)))) AS ?_result)
            }
