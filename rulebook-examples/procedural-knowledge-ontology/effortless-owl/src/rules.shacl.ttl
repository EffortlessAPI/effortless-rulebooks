    ] .
pko-native-procedural-knowledge-rulebook-shapes:StakeholderQuestions_IsMisroutedAfterTriage a sh:NodeShape ;
    sh:targetClass pko-extension:StakeholderQuestion ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StakeholderQuestions_IsMisroutedAfterTriage" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isMisroutedAfterTriage ?_result .
            }
            WHERE {
    $this a pko-extension:StakeholderQuestion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resultRoute ?result_route . OPTIONAL { ?result_route erb:key ?result_route__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resultingChangeRequest ?resulting_change_request . OPTIONAL { ?resulting_change_request erb:key ?resulting_change_request__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:triageOutcome ?triage_outcome . OPTIONAL { ?triage_outcome erb:key ?triage_outcome__key . } }
                BIND((COALESCE((COALESCE(?resulting_change_request__key, COALESCE(IF(isIRI(?resulting_change_request), REPLACE(STR(?resulting_change_request), "^.*[#/]", ""), STR(?resulting_change_request)), "")) != ""), false) && COALESCE((COALESCE((COALESCE((COALESCE(?triage_outcome__key, COALESCE(IF(isIRI(?triage_outcome), REPLACE(STR(?triage_outcome), "^.*[#/]", ""), STR(?triage_outcome)), "")) = "MoreData"), false) && COALESCE((COALESCE(?result_route__key, COALESCE(IF(isIRI(?result_route), REPLACE(STR(?result_route), "^.*[#/]", ""), STR(?result_route)), "")) != "DataOperations"), false)), false) || COALESCE((COALESCE((COALESCE(?triage_outcome__key, COALESCE(IF(isIRI(?triage_outcome), REPLACE(STR(?triage_outcome), "^.*[#/]", ""), STR(?triage_outcome)), "")) != "MoreData"), false) && COALESCE((COALESCE(?triage_outcome__key, COALESCE(IF(isIRI(?triage_outcome), REPLACE(STR(?triage_outcome), "^.*[#/]", ""), STR(?triage_outcome)), "")) != ""), false) && COALESCE((COALESCE(?result_route__key, COALESCE(IF(isIRI(?result_route), REPLACE(STR(?result_route), "^.*[#/]", ""), STR(?result_route)), "")) != "Governance"), false)), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for StalenessQueryRuns ===
pko-native-procedural-knowledge-rulebook-shapes:StalenessQueryRuns_Name a sh:NodeShape ;
    sh:targetClass pko-extension:StalenessQueryRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StalenessQueryRuns_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:StalenessQueryRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:governedModel ?governed_model . OPTIONAL { ?governed_model erb:key ?governed_model__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " staleness run") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StalenessQueryRuns_RunnerKind a sh:NodeShape ;
    sh:targetClass pko-extension:StalenessQueryRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StalenessQueryRuns_RunnerKind" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:runnerKind ?_result .
            }
            WHERE {
    $this a pko-extension:StalenessQueryRun .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ranByAgent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StalenessQueryRuns_NotSurfacedToSteward a sh:NodeShape ;
    sh:targetClass pko-extension:StalenessQueryRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StalenessQueryRuns_NotSurfacedToSteward" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:notSurfacedToSteward ?_result .
            }
            WHERE {
    $this a pko-extension:StalenessQueryRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:staleWorkflowCount ?stale_workflow_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:surfacedToStewardAt ?surfaced_to_steward_at . OPTIONAL { ?surfaced_to_steward_at erb:key ?surfaced_to_steward_at__key . } }
                BIND((COALESCE((COALESCE(?stale_workflow_count, 0) > 0), false) && COALESCE((COALESCE(?surfaced_to_steward_at__key, COALESCE(IF(isIRI(?surfaced_to_steward_at), REPLACE(STR(?surfaced_to_steward_at), "^.*[#/]", ""), STR(?surfaced_to_steward_at)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

