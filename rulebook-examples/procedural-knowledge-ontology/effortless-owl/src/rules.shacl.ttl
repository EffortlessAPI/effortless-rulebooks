    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:seeker ?seeker . OPTIONAL { ?seeker erb:key ?seeker__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?seeker__key, IF(isIRI(?seeker), REPLACE(STR(?seeker), "^.*[#/]", ""), STR(?seeker))), ""), " -> ", COALESCE(COALESCE(?broker__key, IF(isIRI(?broker), REPLACE(STR(?broker), "^.*[#/]", ""), STR(?broker))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeBrokerLinks_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeBrokerLink ;
    sh:order 1 ;
    sh:rule [
