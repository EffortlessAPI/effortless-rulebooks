        rdfs:label "rule_ChangeRequests_IsApprovedNotImplemented" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isApprovedNotImplemented ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isImplemented ?is_implemented . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved"), false) && COALESCE((!(COALESCE(?is_implemented, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_DaysSinceApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . }
    OPTIONAL { $this effortless-ntwf:isDecided ?is_decided . }
                BIND(ROUND(IF(COALESCE(?is_decided, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsStalledImplementation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStalledImplementation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:daysSinceApproval ?days_since_approval . }
    OPTIONAL { $this effortless-ntwf:isApprovedNotImplemented ?is_approved_not_implemented . }
                BIND((COALESCE(?is_approved_not_implemented, false) && COALESCE((COALESCE(?days_since_approval, 0) > 14), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_StalledImplementationVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stalledImplementationVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isStalledImplementation ?is_stalled_implementation . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_stalled_implementation, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_ApprovedVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approvedVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isApprovedDecision ?is_approved_decision . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_approved_decision, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsApprovedDecision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isApprovedDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CommunicationPolicies ===
effortless-ntwf:CommunicationPoliciesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CommunicationPolicies ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunicationPolicies .
    OPTIONAL { $this effortless-ntwf:channel ?channel . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(CONCAT(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), " policy / ", IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_ConsentViolationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:consentViolationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunicationPolicies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MessageDeliveries .
                    ?child effortless-ntwf:policyChannel ?backfk .
                    $this effortless-ntwf:communicationPolicyId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:isConsentViolation ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_QuietHoursViolationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:quietHoursViolationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunicationPolicies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MessageDeliveries .
                    ?child effortless-ntwf:quietHoursViolationPolicyKey ?backfk .
                    $this effortless-ntwf:communicationPolicyId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_IsActivePolicy" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isActivePolicy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunicationPolicies .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Active") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CommunitiesOfPractice ===
effortless-ntwf:CommunitiesOfPracticeShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CommunitiesOfPractice ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ConformanceRuns ===
effortless-ntwf:ConformanceRunsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConformanceRuns ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
    OPTIONAL { $this effortless-ntwf:conformanceRunId ?conformance_run_id . }
                BIND(?conformance_run_id AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_SubstrateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:substrateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:run $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_PerfectSubstrateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:perfectSubstrateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:perfectRunKey ?backfk .
                    $this effortless-ntwf:conformanceRunId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_CellsTested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cellsTested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:run $this .
                    OPTIONAL { ?child effortless-ntwf:cellsTested ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_CellsPassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cellsPassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:run $this .
                    OPTIONAL { ?child effortless-ntwf:cellsPassed ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_CellsFailed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cellsFailed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
    OPTIONAL { $this effortless-ntwf:cellsPassed ?cells_passed . }
    OPTIONAL { $this effortless-ntwf:cellsTested ?cells_tested . }
                BIND((?cells_tested - ?cells_passed) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_OverallScore" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overallScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
    OPTIONAL { $this effortless-ntwf:cellsPassed ?cells_passed . }
    OPTIONAL { $this effortless-ntwf:cellsTested ?cells_tested . }
                BIND(IF(COALESCE((COALESCE(?cells_tested, 0) = 0), false), 0, (ROUND(((100 * ?cells_passed) / ?cells_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_ImperfectSubstrateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:imperfectSubstrateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
    OPTIONAL { $this effortless-ntwf:perfectSubstrateCount ?perfect_substrate_count . }
    OPTIONAL { $this effortless-ntwf:substrateCount ?substrate_count . }
                BIND((?substrate_count - ?perfect_substrate_count) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_IsFullyConformant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFullyConformant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
    OPTIONAL { $this effortless-ntwf:imperfectSubstrateCount ?imperfect_substrate_count . }
    OPTIONAL { $this effortless-ntwf:substrateCount ?substrate_count . }
                BIND((COALESCE((COALESCE(?substrate_count, 0) > 0), false) && COALESCE((COALESCE(?imperfect_substrate_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ConformanceSubstrates ===
effortless-ntwf:ConformanceSubstratesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConformanceSubstrates ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_IsGraded" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isGraded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
    OPTIONAL { $this effortless-ntwf:role ?role . }
                BIND((REPLACE(COALESCE(STR(?role), ""), "^.*#", "") = "graded") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_RunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:runCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:substrate $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_LatestCellsTested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestCellsTested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:substrate $this .
                    OPTIONAL { ?child effortless-ntwf:latestCellsTested ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_LatestCellsPassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestCellsPassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:substrate $this .
                    OPTIONAL { ?child effortless-ntwf:latestCellsPassed ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_LatestHarnessErrors" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestHarnessErrors ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:substrate $this .
                    OPTIONAL { ?child effortless-ntwf:latestErrorFlag ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_LatestCellsFailed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestCellsFailed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
    OPTIONAL { $this effortless-ntwf:latestCellsPassed ?latest_cells_passed . }
    OPTIONAL { $this effortless-ntwf:latestCellsTested ?latest_cells_tested . }
                BIND((?latest_cells_tested - ?latest_cells_passed) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_LatestScore" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
    OPTIONAL { $this effortless-ntwf:latestCellsPassed ?latest_cells_passed . }
    OPTIONAL { $this effortless-ntwf:latestCellsTested ?latest_cells_tested . }
                BIND(IF(COALESCE((COALESCE(?latest_cells_tested, 0) = 0), false), 0, (ROUND(((100 * ?latest_cells_passed) / ?latest_cells_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_DisagreeingFieldCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:disagreeingFieldCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FieldDisagreements .
                    ?child effortless-ntwf:substrate $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_DisagreeingTableCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:disagreeingTableCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TableConformance .
                    ?child effortless-ntwf:imperfectSubstrateKey ?backfk .
                    $this effortless-ntwf:conformanceSubstrateId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_IsFullyConformant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFullyConformant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
    OPTIONAL { $this effortless-ntwf:latestCellsFailed ?latest_cells_failed . }
    OPTIONAL { $this effortless-ntwf:latestCellsTested ?latest_cells_tested . }
    OPTIONAL { $this effortless-ntwf:latestHarnessErrors ?latest_harness_errors . }
                BIND((COALESCE((COALESCE(?latest_cells_tested, 0) > 0), false) && COALESCE((COALESCE(?latest_cells_failed, 0) = 0), false) && COALESCE((COALESCE(?latest_harness_errors, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for DeliveredCommunications ===
effortless-ntwf:DeliveredCommunicationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DeliveredCommunications ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:channel ?channel . }
    OPTIONAL { $this effortless-ntwf:recipientKey ?recipient_key . }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND(CONCAT(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel)), " -> ", IF(isIRI(?recipient_key), REPLACE(STR(?recipient_key), "^.*[#/]", ""), STR(?recipient_key)), " @ ", REPLACE(IF(isIRI(?sent_at), REPLACE(STR(?sent_at), "^.*[#/]", ""), STR(?sent_at)), "Z$", "+00:00")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_HasAuthorization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasAuthorization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:authorizingStepExecution ?authorizing_step_execution . }
                BIND((REPLACE(COALESCE(STR(?authorizing_step_execution), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_ContentMatchesApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:contentMatchesApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:approvedContentHash ?approved_content_hash . }
    OPTIONAL { $this effortless-ntwf:renderedContentHash ?rendered_content_hash . }
                BIND(COALESCE((?rendered_content_hash = ?approved_content_hash), ((!BOUND(?rendered_content_hash) || STR(?rendered_content_hash) = "") && (!BOUND(?approved_content_hash) || STR(?approved_content_hash) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_AuthorizedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:authorizedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
                OPTIONAL { $this effortless-ntwf:authorizingStepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:endedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_WasApprovedBeforeSending" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasApprovedBeforeSending ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:authorizedAt ?authorized_at . }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND(COALESCE((?authorized_at <= ?sent_at), ((!BOUND(?authorized_at) || STR(?authorized_at) = "") && (!BOUND(?sent_at) || STR(?sent_at) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_IsDefensible" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDefensible ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:contentMatchesApproval ?content_matches_approval . }
    OPTIONAL { $this effortless-ntwf:hasAuthorization ?has_authorization . }
    OPTIONAL { $this effortless-ntwf:wasApprovedBeforeSending ?was_approved_before_sending . }
                BIND((COALESCE(?has_authorization, false) && COALESCE(?content_matches_approval, false) && COALESCE(?was_approved_before_sending, false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ElicitationSessions ===
effortless-ntwf:ElicitationSessionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ElicitationSessions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:method ?method . }
    OPTIONAL { $this effortless-ntwf:startedAt ?started_at . }
                BIND(CONCAT(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), " / ", REPLACE(IF(isIRI(?started_at), REPLACE(STR(?started_at), "^.*[#/]", ""), STR(?started_at)), "Z$", "+00:00")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_DaysSinceElicited" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceElicited ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:endedAt ?ended_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?ended_at) + FLOOR((153 * (MONTH(?ended_at) + 12 * FLOOR((14 - MONTH(?ended_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 4) - FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 100) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsSingleWitnessMethod" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSingleWitnessMethod ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:method ?method . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?method), ""), "^.*#", "") = "Shadowing"), false) || COALESCE((REPLACE(COALESCE(STR(?method), ""), "^.*#", "") = "PractitionerInterview"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_PractitionerIsStillEngaged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:practitionerIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                OPTIONAL { $this effortless-ntwf:practitionerAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isStillEngaged ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_ValidFragmentsProduced" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:validFragmentsProduced ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeFragments .
                    ?child effortless-ntwf:validFragmentSessionKey ?backfk .
                    $this effortless-ntwf:elicitationSessionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsHighYieldSession" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isHighYieldSession ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:validFragmentsProduced ?valid_fragments_produced . }
                BIND((COALESCE(?valid_fragments_produced, 0) >= 3) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsConcentratedSingleWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isConcentratedSingleWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:isHighYieldSession ?is_high_yield_session . }
    OPTIONAL { $this effortless-ntwf:isSingleWitnessMethod ?is_single_witness_method . }
                BIND((COALESCE(?is_single_witness_method, false) && COALESCE(?is_high_yield_session, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsStaleConcentratedWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStaleConcentratedWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:daysSinceElicited ?days_since_elicited . }
    OPTIONAL { $this effortless-ntwf:isConcentratedSingleWitness ?is_concentrated_single_witness . }
                BIND((COALESCE(?is_concentrated_single_witness, false) && COALESCE((COALESCE(?days_since_elicited, 0) > 180), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_ConcentratedSessionVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:concentratedSessionVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:isConcentratedSingleWitness ?is_concentrated_single_witness . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_concentrated_single_witness, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Errors ===
effortless-ntwf:ErrorsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Errors ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Errors_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Errors .
    OPTIONAL { $this effortless-ntwf:errorCode ?error_code . }
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(CONCAT(IF(isIRI(?error_code), REPLACE(STR(?error_code), "^.*[#/]", ""), STR(?error_code)), " - ", IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for EvaluationContexts ===
effortless-ntwf:EvaluationContextsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EvaluationContexts ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EvaluationContexts_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EvaluationContexts .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(CONCAT(IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label)), " @ ", REPLACE(IF(isIRI(?as_of_instant), REPLACE(STR(?as_of_instant), "^.*[#/]", ""), STR(?as_of_instant)), "Z$", "+00:00")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ExceptionInvocations ===
effortless-ntwf:ExceptionInvocationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ExceptionInvocations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:exception ?exception . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(CONCAT(IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution)), " / ", IF(isIRI(?exception), REPLACE(STR(?exception), "^.*[#/]", ""), STR(?exception))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ExpectedHandling" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expectedHandling ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:exception ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Exceptions ; effortless-ntwf:exceptionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:handling ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_RequiredApprovalRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requiredApprovalRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:exception ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Exceptions ; effortless-ntwf:exceptionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:approvalRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_RequiredApprovalRoleHolder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requiredApprovalRoleHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:requiredApprovalRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:currentAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ApprovalRoleMatches" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approvalRoleMatches ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approvedByAgent ?approved_by_agent . }
    OPTIONAL { $this effortless-ntwf:requiredApprovalRoleHolder ?required_approval_role_holder . }
                BIND(COALESCE((?approved_by_agent = ?required_approval_role_holder), ((!BOUND(?approved_by_agent) || STR(?approved_by_agent) = "") && (!BOUND(?required_approval_role_holder) || STR(?required_approval_role_holder) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_IsApproved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isApproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approvedByAgent ?approved_by_agent . }
                BIND((REPLACE(COALESCE(STR(?approved_by_agent), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_IsImproperlyApproved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isImproperlyApproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approvalRoleMatches ?approval_role_matches . }
    OPTIONAL { $this effortless-ntwf:isApproved ?is_approved . }
                BIND((COALESCE((!(COALESCE(?is_approved, false))), false) || COALESCE((!(COALESCE(?approval_role_matches, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_InvokerAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:invokerAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:invokedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_InvokerAlsoPreparedKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:invokerAlsoPreparedKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approvedByAgent ?approved_by_agent . }
    OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?parent_procedure_execution . }
                BIND(CONCAT(IF(isIRI(?parent_procedure_execution), REPLACE(STR(?parent_procedure_execution), "^.*[#/]", ""), STR(?parent_procedure_execution)), "|", IF(isIRI(?approved_by_agent), REPLACE(STR(?approved_by_agent), "^.*[#/]", ""), STR(?approved_by_agent))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ParentProcedureExecution" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:parentProcedureExecution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:procedureExecution ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ApproverPreparedCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:approverPreparedCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:preparerAgentKey ?backfk .
                    $this effortless-ntwf:invokerAlsoPreparedKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_DelegatedToPreparer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:delegatedToPreparer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approverPreparedCount ?approver_prepared_count . }
                BIND((COALESCE(?approver_prepared_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_IsUngovernedInvocation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUngovernedInvocation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:delegatedToPreparer ?delegated_to_preparer . }
    OPTIONAL { $this effortless-ntwf:isImproperlyApproved ?is_improperly_approved . }
                BIND((COALESCE(?is_improperly_approved, false) || COALESCE(?delegated_to_preparer, false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Exceptions ===
effortless-ntwf:ExceptionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Exceptions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Exceptions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Exceptions .
    OPTIONAL { $this effortless-ntwf:condition ?condition . }
                BIND(?condition AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Exceptions_ActiveExceptionStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:activeExceptionStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Exceptions .
    OPTIONAL { $this effortless-ntwf:status ?status . }
    OPTIONAL { $this effortless-ntwf:triggerStep ?trigger_step . }
                BIND(IF(COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Active"), false), ?trigger_step, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Explanations ===
effortless-ntwf:ExplanationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Explanations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Explanations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Explanations .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for FAQs ===
effortless-ntwf:FAQsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FAQs ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FAQs_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FAQs .
    OPTIONAL { $this effortless-ntwf:question ?question . }
                BIND(?question AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for FieldDisagreements ===
effortless-ntwf:FieldDisagreementsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FieldDisagreements ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldDisagreements .
    OPTIONAL { $this effortless-ntwf:rulebookField ?rulebook_field . }
    OPTIONAL { $this effortless-ntwf:substrate ?substrate . }
                BIND(CONCAT(IF(isIRI(?substrate), REPLACE(STR(?substrate), "^.*[#/]", ""), STR(?substrate)), " / ", IF(isIRI(?rulebook_field), REPLACE(STR(?rulebook_field), "^.*[#/]", ""), STR(?rulebook_field))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_SampledCellCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sampledCellCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldDisagreements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CellDisagreements .
                    ?child effortless-ntwf:fieldDisagreement $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_IsFullySampled" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFullySampled ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldDisagreements .
    OPTIONAL { $this effortless-ntwf:cellsFailed ?cells_failed . }
    OPTIONAL { $this effortless-ntwf:sampledCellCount ?sampled_cell_count . }
                BIND((COALESCE(?sampled_cell_count, 0) = COALESCE(?cells_failed, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_Formula" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:formula ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldDisagreements .
                OPTIONAL { $this effortless-ntwf:rulebookField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:formula ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_SubstrateLabel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:substrateLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldDisagreements .
                OPTIONAL { $this effortless-ntwf:substrate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ConformanceSubstrates ; effortless-ntwf:conformanceSubstrateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for FieldGrants ===
effortless-ntwf:FieldGrantsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FieldGrants ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
    OPTIONAL { $this effortless-ntwf:targetField ?target_field . }
                BIND(CONCAT(IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal)), " -> ", IF(isIRI(?target_field), REPLACE(STR(?target_field), "^.*[#/]", ""), STR(?target_field))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_FieldTable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldTable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
                OPTIONAL { $this effortless-ntwf:targetField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:targetTable ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_FieldName" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
                OPTIONAL { $this effortless-ntwf:targetField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:fieldName ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_FieldIsDerived" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldIsDerived ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
                OPTIONAL { $this effortless-ntwf:targetField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isDerived ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_IsWritableDerivedField" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWritableDerivedField ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
    OPTIONAL { $this effortless-ntwf:canWrite ?can_write . }
    OPTIONAL { $this effortless-ntwf:fieldIsDerived ?field_is_derived . }
                BIND((COALESCE(?can_write, false) && COALESCE(?field_is_derived, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_IsMasked" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMasked ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
    OPTIONAL { $this effortless-ntwf:maskStrategy ?mask_strategy . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?mask_strategy), ""), "^.*#", "") != "plain"), false) && COALESCE((REPLACE(COALESCE(STR(?mask_strategy), ""), "^.*#", "") != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_GrantKeyWhenReadable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:grantKeyWhenReadable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
    OPTIONAL { $this effortless-ntwf:canRead ?can_read . }
    OPTIONAL { $this effortless-ntwf:fieldTable ?field_table . }
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
                BIND(IF(COALESCE(?can_read, false), CONCAT(IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal)), "|", IF(isIRI(?field_table), REPLACE(STR(?field_table), "^.*[#/]", ""), STR(?field_table))), "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Functions ===
effortless-ntwf:FunctionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Functions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Functions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Functions .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for IssueOccurrences ===
effortless-ntwf:IssueOccurrencesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IssueOccurrences ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:error ?error . }
    OPTIONAL { $this effortless-ntwf:occurredAt ?occurred_at . }
                BIND(CONCAT(IF(isIRI(?error), REPLACE(STR(?error), "^.*[#/]", ""), STR(?error)), " @ ", REPLACE(IF(isIRI(?occurred_at), REPLACE(STR(?occurred_at), "^.*[#/]", ""), STR(?occurred_at)), "Z$", "+00:00")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_IsUnresolved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnresolved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Open"), false) || COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Investigating"), false) || COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Monitoring"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_StepExecutionWhenUnresolved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepExecutionWhenUnresolved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:isUnresolved ?is_unresolved . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_unresolved, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for IssuedTokens ===
effortless-ntwf:IssuedTokensShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IssuedTokens ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssuedTokens_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssuedTokens .
    OPTIONAL { $this effortless-ntwf:appUser ?app_user . }
    OPTIONAL { $this effortless-ntwf:issuedAt ?issued_at . }
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
                BIND(CONCAT(IF(isIRI(?app_user), REPLACE(STR(?app_user), "^.*[#/]", ""), STR(?app_user)), " as ", IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal)), " @ ", REPLACE(IF(isIRI(?issued_at), REPLACE(STR(?issued_at), "^.*[#/]", ""), STR(?issued_at)), "Z$", "+00:00")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssuedTokens_IsDevMinted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDevMinted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssuedTokens .
    OPTIONAL { $this effortless-ntwf:issuer ?issuer . }
                BIND((REPLACE(COALESCE(STR(?issuer), ""), "^.*#", "") = "dev-mint") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for JwtClaimMappings ===
effortless-ntwf:JwtClaimMappingsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:JwtClaimMappings ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_JwtClaimMappings_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:JwtClaimMappings .
    OPTIONAL { $this effortless-ntwf:claimName ?claim_name . }
    OPTIONAL { $this effortless-ntwf:sqlAccessor ?sql_accessor . }
                BIND(CONCAT(IF(isIRI(?claim_name), REPLACE(STR(?claim_name), "^.*[#/]", ""), STR(?claim_name)), " -> ", IF(isIRI(?sql_accessor), REPLACE(STR(?sql_accessor), "^.*[#/]", ""), STR(?sql_accessor))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_JwtClaimMappings_UsageCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:usageCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:JwtClaimMappings .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AccessPolicies .
                    ?child effortless-ntwf:rowPredicate ?backfk .
                    $this effortless-ntwf:sqlAccessor ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeBrokerLinks ===
effortless-ntwf:KnowledgeBrokerLinksShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeBrokerLinks ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:broker ?broker . }
    OPTIONAL { $this effortless-ntwf:seeker ?seeker . }
                BIND(CONCAT(IF(isIRI(?seeker), REPLACE(STR(?seeker), "^.*[#/]", ""), STR(?seeker)), " -> ", IF(isIRI(?broker), REPLACE(STR(?broker), "^.*[#/]", ""), STR(?broker))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_DaysSinceConsulted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceConsulted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:lastConsultedAt ?last_consulted_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_consulted_at) + FLOOR((153 * (MONTH(?last_consulted_at) + 12 * FLOOR((14 - MONTH(?last_consulted_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) + FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 4) - FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 100) + FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_IsActiveReliance" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isActiveReliance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:daysSinceConsulted ?days_since_consulted . }
    OPTIONAL { $this effortless-ntwf:frequency ?frequency . }
                BIND((COALESCE((!(COALESCE((REPLACE(COALESCE(STR(?frequency), ""), "^.*#", "") = "Rarely"), false))), false) && COALESCE((COALESCE(?days_since_consulted, 0) <= 180), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_BrokerIsStillEngaged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:brokerIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
                OPTIONAL { $this effortless-ntwf:broker ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isStillEngaged ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_IsAtRiskReliance" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAtRiskReliance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:brokerIsStillEngaged ?broker_is_still_engaged . }
    OPTIONAL { $this effortless-ntwf:isActiveReliance ?is_active_reliance . }
                BIND((COALESCE(?is_active_reliance, false) && COALESCE((!(COALESCE(?broker_is_still_engaged, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_ActiveRelianceBrokerKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:activeRelianceBrokerKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:broker ?broker . }
    OPTIONAL { $this effortless-ntwf:isActiveReliance ?is_active_reliance . }
                BIND(IF(COALESCE(?is_active_reliance, false), ?broker, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_AtRiskBrokerKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:atRiskBrokerKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:broker ?broker . }
    OPTIONAL { $this effortless-ntwf:isAtRiskReliance ?is_at_risk_reliance . }
                BIND(IF(COALESCE(?is_at_risk_reliance, false), ?broker, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeFragments ===
effortless-ntwf:KnowledgeFragmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeFragments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:knowledgeForm ?knowledge_form . }
    OPTIONAL { $this effortless-ntwf:statement ?statement . }
                BIND(CONCAT(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), ": ", IF(isIRI(SUBSTR(STR(?statement), 1, 60)), REPLACE(STR(SUBSTR(STR(?statement), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?statement), 1, 60)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsCurrentlyValid" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrentlyValid ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND((COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false) && COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_SourceAgentIsStillEngaged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceAgentIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:sourceAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isStillEngaged ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_SourceAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:sourceAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_HasHumanSource" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasHumanSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:sourceAgentKind ?source_agent_kind . }
                BIND((REPLACE(COALESCE(STR(?source_agent_kind), ""), "^.*#", "") = "Human") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_HasOrphanedProvenance" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasOrphanedProvenance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this effortless-ntwf:sourceAgentIsStillEngaged ?source_agent_is_still_engaged . }
                BIND((COALESCE(?is_currently_valid, false) && COALESCE((!(COALESCE(?source_agent_is_still_engaged, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsUndefendableTacitClaim" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUndefendableTacitClaim ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:hasOrphanedProvenance ?has_orphaned_provenance . }
    OPTIONAL { $this effortless-ntwf:knowledgeForm ?knowledge_form . }
                BIND((COALESCE(?has_orphaned_provenance, false) && COALESCE((COALESCE((REPLACE(COALESCE(STR(?knowledge_form), ""), "^.*#", "") = "Tacit"), false) || COALESCE((REPLACE(COALESCE(STR(?knowledge_form), ""), "^.*#", "") = "SituatedJudgment"), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsApproved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isApproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsWithinValidityWindow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWithinValidityWindow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND((COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsReliedUpon" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isReliedUpon ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isWithinValidityWindow ?is_within_validity_window . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?step), ""), "^.*#", "") != ""), false) && COALESCE(?is_within_validity_window, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_StepProcedureVersionStatus" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepProcedureVersionStatus ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:procedureVersion ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsAttachedToLiveVersion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAttachedToLiveVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isLive ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsUnapprovedButReliedOn" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnapprovedButReliedOn ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isApproved ?is_approved . }
    OPTIONAL { $this effortless-ntwf:isAttachedToLiveVersion ?is_attached_to_live_version . }
    OPTIONAL { $this effortless-ntwf:isReliedUpon ?is_relied_upon . }
                BIND((COALESCE(?is_relied_upon, false) && COALESCE(?is_attached_to_live_version, false) && COALESCE((!(COALESCE(?is_approved, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_EvidenceAgeDays" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:evidenceAgeDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:elicitationSession ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ElicitationSessions ; effortless-ntwf:elicitationSessionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:daysSinceElicited ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_HasRecordedElicitation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasRecordedElicitation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:elicitationSession ?elicitation_session . }
                BIND((REPLACE(COALESCE(STR(?elicitation_session), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsFromSingleWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFromSingleWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:elicitationSession ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ElicitationSessions ; effortless-ntwf:elicitationSessionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isSingleWitnessMethod ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_EvidenceExpiryDays" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:evidenceExpiryDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isFromSingleWitness ?is_from_single_witness . }
                BIND(ROUND(IF(COALESCE(?is_from_single_witness, false), 180, 365)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_EvidenceHasExpired" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:evidenceHasExpired ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:evidenceAgeDays ?evidence_age_days . }
    OPTIONAL { $this effortless-ntwf:evidenceExpiryDays ?evidence_expiry_days . }
    OPTIONAL { $this effortless-ntwf:hasRecordedElicitation ?has_recorded_elicitation . }
                BIND((COALESCE(?has_recorded_elicitation, false) && COALESCE((COALESCE(?evidence_age_days, 0) > COALESCE(?evidence_expiry_days, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_OwnerAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ownerAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:ownerRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:currentAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsAwaitingApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAwaitingApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Reviewed") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_OwnerIsMe" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ownerIsMe ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:ownerRole ?owner_role . }
                BIND((REPLACE(COALESCE(STR(?owner_role), ""), "^.*#", "") = "hr-policy-owner") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsMyUnfinishedApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMyUnfinishedApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isAwaitingApproval ?is_awaiting_approval . }
    OPTIONAL { $this effortless-ntwf:ownerIsMe ?owner_is_me . }
                BIND((COALESCE(?owner_is_me, false) && COALESCE(?is_awaiting_approval, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsInvokedByAnException" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInvokedByAnException ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Exceptions .
                    ?child effortless-ntwf:triggerStep $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_HasOperationalReliance" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasOperationalReliance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isInvokedByAnException ?is_invoked_by_an_exception . }
                BIND((COALESCE(?is_invoked_by_an_exception, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsUnapprovedAndOperationallyLive" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnapprovedAndOperationallyLive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:hasOperationalReliance ?has_operational_reliance . }
    OPTIONAL { $this effortless-ntwf:isMyUnfinishedApproval ?is_my_unfinished_approval . }
                BIND((COALESCE(?is_my_unfinished_approval, false) && COALESCE(?has_operational_reliance, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_AgeDays" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ageDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?valid_from) + FLOOR((153 * (MONTH(?valid_from) + 12 * FLOOR((14 - MONTH(?valid_from)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 4) - FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 100) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsLowConfidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLowConfidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:confidence ?confidence . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?confidence), ""), "^.*#", "") = "Medium"), false) || COALESCE((REPLACE(COALESCE(STR(?confidence), ""), "^.*#", "") = "Low"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_OwningVersionCadenceDays" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:owningVersionCadenceDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:stewardReviewCadenceDays ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_ExceedsOwningCadence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:exceedsOwningCadence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:ageDays ?age_days . }
    OPTIONAL { $this effortless-ntwf:owningVersionCadenceDays ?owning_version_cadence_days . }
                BIND((COALESCE(?age_days, 0) > COALESCE(?owning_version_cadence_days, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsAgingLowConfidenceClaim" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
