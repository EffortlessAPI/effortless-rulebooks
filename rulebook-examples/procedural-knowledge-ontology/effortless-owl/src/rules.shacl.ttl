    OPTIONAL { $this effortless-ntwf:raisedKnowledgeGap ?raised_knowledge_gap . OPTIONAL { ?raised_knowledge_gap effortless-ntwf:__key ?raised_knowledge_gap__key . } }
                BIND((COALESCE((COALESCE(?annotation_kind__key, COALESCE(IF(isIRI(?annotation_kind), REPLACE(STR(?annotation_kind), "^.*[#/]", ""), STR(?annotation_kind)), "")) = "MissingKnowledge"), false) && COALESCE((COALESCE(?raised_knowledge_gap__key, COALESCE(IF(isIRI(?raised_knowledge_gap), REPLACE(STR(?raised_knowledge_gap), "^.*[#/]", ""), STR(?raised_knowledge_gap)), "")) = ""), false)) AS ?_result)
            }
