            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:drafterKind ?_result .
            }
            WHERE {
    $this a pko-extension:TermDefinition .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:draftedByAgent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:TermDefinitions_AiDraftAdoptedUnrevised a sh:NodeShape ;
    sh:targetClass pko-extension:TermDefinition ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermDefinitions_AiDraftAdoptedUnrevised" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:aiDraftAdoptedUnrevised ?_result .
            }
            WHERE {
    $this a pko-extension:TermDefinition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:drafterKind ?drafter_kind . OPTIONAL { ?drafter_kind erb:key ?drafter_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:revisedByAgent ?revised_by_agent . OPTIONAL { ?revised_by_agent erb:key ?revised_by_agent__key . } }
                BIND((COALESCE((COALESCE(?drafter_kind__key, COALESCE(IF(isIRI(?drafter_kind), REPLACE(STR(?drafter_kind), "^.*[#/]", ""), STR(?drafter_kind)), "")) = "AIAgent"), false) && COALESCE((COALESCE(?revised_by_agent__key, COALESCE(IF(isIRI(?revised_by_agent), REPLACE(STR(?revised_by_agent), "^.*[#/]", ""), STR(?revised_by_agent)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for TermLabelVariants ===
