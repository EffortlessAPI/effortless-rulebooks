    ] .

# === Rules for JwtClaimMappings ===
pko-native-procedural-knowledge-rulebook-shapes:JwtClaimMappings_Name a sh:NodeShape ;
    sh:targetClass pko-extension:JwtClaimMapping ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_JwtClaimMappings_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:JwtClaimMapping .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:claimName ?claim_name . OPTIONAL { ?claim_name erb:key ?claim_name__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sqlAccessor ?sql_accessor . OPTIONAL { ?sql_accessor erb:key ?sql_accessor__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?claim_name__key, IF(isIRI(?claim_name), REPLACE(STR(?claim_name), "^.*[#/]", ""), STR(?claim_name))), ""), " -> ", COALESCE(COALESCE(?sql_accessor__key, IF(isIRI(?sql_accessor), REPLACE(STR(?sql_accessor), "^.*[#/]", ""), STR(?sql_accessor))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:JwtClaimMappings_UsageCount a sh:NodeShape ;
    sh:targetClass pko-extension:JwtClaimMapping ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_JwtClaimMappings_UsageCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:usageCount ?_result .
            }
            WHERE {
    $this a pko-extension:JwtClaimMapping .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:JwtClaimMapping .
                    ?child a pko-extension:AccessPolicy .
                    ?child pko-native-procedural-knowledge-rulebook:rowPredicate ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:sqlAccessor ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

