    OPTIONAL { $this effortless-ntwf:targetProcedure ?target_procedure . OPTIONAL { ?target_procedure effortless-ntwf:__key ?target_procedure__key . } }
                BIND((COALESCE(?is_agentic, false) && COALESCE((COALESCE(?target_procedure__key, COALESCE(IF(isIRI(?target_procedure), REPLACE(STR(?target_procedure), "^.*[#/]", ""), STR(?target_procedure)), "")) != ""), false) && COALESCE(?target_has_no_explicit_steps, false)) AS ?_result)
