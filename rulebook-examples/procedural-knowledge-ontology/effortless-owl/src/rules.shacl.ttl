# === Rules for StepCues ===
pko-native-procedural-knowledge-rulebook-shapes:StepCues_Name a sh:NodeShape ;
    sh:targetClass pko-extension:StepCue ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepCues_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
