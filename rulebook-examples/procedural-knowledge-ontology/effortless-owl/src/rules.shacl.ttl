    $this a pko-extension:AssignmentInstantCheck .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:roleAssignment ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:RoleInTime . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:agentVersionKey ?j3 . } }
