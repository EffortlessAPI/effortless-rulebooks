    $this a pko-extension:Vocabulary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:Vocabulary .
                    ?child a pko-extension:CollectedSourceMaterial .
                    ?child pko-native-procedural-knowledge-rulebook:organizedIntoScheme $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:materialKind ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "Transcript"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
