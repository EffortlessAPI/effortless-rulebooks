                BIND((COALESCE((COALESCE((COALESCE(?action_kind__key, COALESCE(IF(isIRI(?action_kind), REPLACE(STR(?action_kind), "^.*[#/]", ""), STR(?action_kind)), "")) = "SmallChoice"), false) || COALESCE((COALESCE(?action_kind__key, COALESCE(IF(isIRI(?action_kind), REPLACE(STR(?action_kind), "^.*[#/]", ""), STR(?action_kind)), "")) = "Workaround"), false)), false) && COALESCE((COALESCE(?stated_reason__key, COALESCE(IF(isIRI(?stated_reason), REPLACE(STR(?stated_reason), "^.*[#/]", ""), STR(?stated_reason)), "")) = ""), false)) AS ?_result)
            }
