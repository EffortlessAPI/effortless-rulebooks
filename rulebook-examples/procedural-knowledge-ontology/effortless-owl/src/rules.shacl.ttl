            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:versionIsFitNow ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Attestations .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureExecution ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:ProcedureExecution . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:executedVersionIsFit ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Attestations_FitnessVerdictHasDrifted a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Attestations ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_FitnessVerdictHasDrifted" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:fitnessVerdictHasDrifted ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Attestations .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:versionIsFitNow ?version_is_fit_now . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:versionWasFitAtSigning ?version_was_fit_at_signing . }
                BIND((!(COALESCE((COALESCE(?version_was_fit_at_signing, false) = COALESCE(?version_is_fit_now, false)), false))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Attestations_AssuranceGradeNow a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Attestations ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_AssuranceGradeNow" ;
