    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isKnowledgeDependency ?is_knowledge_dependency . }
                BIND((COALESCE(?has_internal_shortfall, false) && COALESCE((!(COALESCE(?is_knowledge_dependency, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeAuditItems_IsUnnamedFinding a sh:NodeShape ;
