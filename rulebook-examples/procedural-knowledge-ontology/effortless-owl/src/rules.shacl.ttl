            }
            WHERE {
    $this a pko-extension:EncodingLifecycleStage .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:EncodingLifecycleStages_AnnotationCount a sh:NodeShape ;
    sh:targetClass pko-extension:EncodingLifecycleStage ;
    sh:order 1 ;
