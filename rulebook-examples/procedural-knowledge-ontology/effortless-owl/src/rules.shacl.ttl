    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:latestCellsTested ?latest_cells_tested . }
                BIND(IF(COALESCE((COALESCE(?latest_cells_tested, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?latest_cells_passed) / ?latest_cells_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
