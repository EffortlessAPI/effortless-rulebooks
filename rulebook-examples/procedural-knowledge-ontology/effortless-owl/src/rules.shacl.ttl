            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:invokedException ?invoked_exception . OPTIONAL { ?invoked_exception effortless-ntwf:__key ?invoked_exception__key . } }
                BIND((COALESCE(?invoked_exception__key, COALESCE(IF(isIRI(?invoked_exception), REPLACE(STR(?invoked_exception), "^.*[#/]", ""), STR(?invoked_exception)), "")) = "exc-unreachable") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsFabricatedAcknowledgement" ;
        sh:prefixes effortless-ntwf: ;
