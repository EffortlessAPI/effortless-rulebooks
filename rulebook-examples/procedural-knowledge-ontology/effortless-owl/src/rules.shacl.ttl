    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authorAgentKind ?author_agent_kind . OPTIONAL { ?author_agent_kind erb:key ?author_agent_kind__key . } }
                BIND((COALESCE((COALESCE(?author_agent_kind__key, COALESCE(IF(isIRI(?author_agent_kind), REPLACE(STR(?author_agent_kind), "^.*[#/]", ""), STR(?author_agent_kind)), "")) != ""), false) && COALESCE((COALESCE(?author_agent_kind__key, COALESCE(IF(isIRI(?author_agent_kind), REPLACE(STR(?author_agent_kind), "^.*[#/]", ""), STR(?author_agent_kind)), "")) != "Human"), false) && COALESCE((COALESCE(?accountable_role__key, COALESCE(IF(isIRI(?accountable_role), REPLACE(STR(?accountable_role), "^.*[#/]", ""), STR(?accountable_role)), "")) = ""), false)) AS ?_result)
            }
