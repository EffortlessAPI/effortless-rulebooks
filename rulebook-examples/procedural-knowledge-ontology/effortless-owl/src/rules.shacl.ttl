            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnmanageableUndocumentedWork ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:modelKind ?model_kind . OPTIONAL { ?model_kind effortless-ntwf:__key ?model_kind__key . } }
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . OPTIONAL { ?procedure effortless-ntwf:__key ?procedure__key . } }
    OPTIONAL { $this effortless-ntwf:procedureHasNoExplicitSteps ?procedure_has_no_explicit_steps . }
                BIND((COALESCE((COALESCE(?model_kind__key, COALESCE(IF(isIRI(?model_kind), REPLACE(STR(?model_kind), "^.*[#/]", ""), STR(?model_kind)), "")) = "ProcedureFamily"), false) && COALESCE((COALESCE(?procedure__key, COALESCE(IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure)), "")) != ""), false) && COALESCE(?procedure_has_no_explicit_steps, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
