    sh:targetClass pko:ProcedureExecution ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_DeliveryYieldPercent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:deliveryYieldPercent ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:intendedRecipientCount ?intended_recipient_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reachedRecipientCount ?reached_recipient_count . }
                BIND(IF(COALESCE((COALESCE(?intended_recipient_count, 0) > 0), false), xsd:double((?reached_recipient_count * 100) / ?intended_recipient_count), 0) AS ?_result)
            }
        """ ;
    ] .
