            }
        """ ;
    ] .

# === Shape with rules for ExternalDependencyRevisions ===
effortless-ntwf:ExternalDependencyRevisionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ExternalDependencyRevisions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalDependencyRevisions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalDependencyRevisions .
    OPTIONAL { $this effortless-ntwf:ontologyProfile ?ontology_profile . OPTIONAL { ?ontology_profile effortless-ntwf:__key ?ontology_profile__key . } }
    OPTIONAL { $this effortless-ntwf:revisionLabel ?revision_label . OPTIONAL { ?revision_label effortless-ntwf:__key ?revision_label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?ontology_profile__key, IF(isIRI(?ontology_profile), REPLACE(STR(?ontology_profile), "^.*[#/]", ""), STR(?ontology_profile))), ""), " ", COALESCE(COALESCE(?revision_label__key, IF(isIRI(?revision_label), REPLACE(STR(?revision_label), "^.*[#/]", ""), STR(?revision_label))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalDependencyRevisions_AffectedMappingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:affectedMappingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalDependencyRevisions .
                OPTIONAL { $this effortless-ntwf:ontologyProfile ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:OntologyProfiles ; effortless-ntwf:ontologyProfileId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:mappingCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalDependencyRevisions_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalDependencyRevisions .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalDependencyRevisions_DaysSincePublished" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSincePublished ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalDependencyRevisions .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:publishedAt ?published_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?published_at) + FLOOR((153 * (MONTH(?published_at) + 12 * FLOOR((14 - MONTH(?published_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?published_at) + 4800 - FLOOR((14 - MONTH(?published_at)) / 12)) + FLOOR((YEAR(?published_at) + 4800 - FLOOR((14 - MONTH(?published_at)) / 12)) / 4) - FLOOR((YEAR(?published_at) + 4800 - FLOOR((14 - MONTH(?published_at)) / 12)) / 100) + FLOOR((YEAR(?published_at) + 4800 - FLOOR((14 - MONTH(?published_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalDependencyRevisions_IsUntrackedRevision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUntrackedRevision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalDependencyRevisions .
    OPTIONAL { $this effortless-ntwf:affectedMappingCount ?affected_mapping_count . }
    OPTIONAL { $this effortless-ntwf:daysSincePublished ?days_since_published . }
    OPTIONAL { $this effortless-ntwf:trackedAt ?tracked_at . OPTIONAL { ?tracked_at effortless-ntwf:__key ?tracked_at__key . } }
                BIND((COALESCE((COALESCE(?tracked_at__key, COALESCE(IF(isIRI(?tracked_at), REPLACE(STR(?tracked_at), "^.*[#/]", ""), STR(?tracked_at)), "")) = ""), false) && COALESCE((COALESCE(?affected_mapping_count, 0) > 0), false) && COALESCE((COALESCE(?days_since_published, 0) > 30), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ExternalStandardTerms ===
effortless-ntwf:ExternalStandardTermsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ExternalStandardTerms ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
    OPTIONAL { $this effortless-ntwf:termIri ?term_iri . }
                BIND(?term_iri AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_RehomedTermSameAs" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:rehomedTermSameAs ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
                OPTIONAL { $this effortless-ntwf:rehomedAsTerm ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:VocabularyTerms ; effortless-ntwf:vocabularyTermId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:sameAsIri ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_RehomedTermNamespace" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
