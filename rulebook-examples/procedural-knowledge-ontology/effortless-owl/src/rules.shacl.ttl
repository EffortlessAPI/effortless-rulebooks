            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepVariables .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceVariable ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:StepVariables . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepVariables_IsDanglingInput a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepVariables ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_IsDanglingInput" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDanglingInput ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepVariables .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:direction ?direction . OPTIONAL { ?direction erb:key ?direction__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isExternalInput ?is_external_input . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceVariable ?source_variable . OPTIONAL { ?source_variable erb:key ?source_variable__key . } }
                BIND((COALESCE((COALESCE(?direction__key, COALESCE(IF(isIRI(?direction), REPLACE(STR(?direction), "^.*[#/]", ""), STR(?direction)), "")) = "Input"), false) && COALESCE((COALESCE(?source_variable__key, COALESCE(IF(isIRI(?source_variable), REPLACE(STR(?source_variable), "^.*[#/]", ""), STR(?source_variable)), "")) = ""), false) && COALESCE((COALESCE(?is_external_input, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepVariables_IsMiswiredSource a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepVariables ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_IsMiswiredSource" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isMiswiredSource ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepVariables .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceDirection ?source_direction . OPTIONAL { ?source_direction erb:key ?source_direction__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceVariable ?source_variable . OPTIONAL { ?source_variable erb:key ?source_variable__key . } }
                BIND((COALESCE((COALESCE(?source_variable__key, COALESCE(IF(isIRI(?source_variable), REPLACE(STR(?source_variable), "^.*[#/]", ""), STR(?source_variable)), "")) != ""), false) && COALESCE((COALESCE(?source_direction__key, COALESCE(IF(isIRI(?source_direction), REPLACE(STR(?source_direction), "^.*[#/]", ""), STR(?source_direction)), "")) != "Output"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepVariables_ConsumerCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepVariables ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_ConsumerCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:consumerCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepVariables .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:StepVariables .
                    ?child a pko-native-procedural-knowledge-rulebook:StepVariables .
                    ?child pko-native-procedural-knowledge-rulebook:sourceVariable $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
