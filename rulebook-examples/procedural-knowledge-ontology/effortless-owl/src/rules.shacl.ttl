    OPTIONAL { $this effortless-ntwf:replacementRole ?replacement_role . }
                BIND((COALESCE((COALESCE(?replacement_assignment__key, COALESCE(IF(isIRI(?replacement_assignment), REPLACE(STR(?replacement_assignment), "^.*[#/]", ""), STR(?replacement_assignment)), "")) != ""), false) && COALESCE(COALESCE((?replacement_role != ?ending_role), !((!BOUND(?replacement_role) || STR(?replacement_role) = "") && (!BOUND(?ending_role) || STR(?ending_role) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
