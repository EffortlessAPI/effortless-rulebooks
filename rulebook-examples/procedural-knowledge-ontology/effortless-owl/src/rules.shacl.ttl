            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isSingleWitnessMethod ?_result .
            }
            WHERE {
    $this a pko-extension:ElicitationSession .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:method ?method . OPTIONAL { ?method erb:key ?method__key . } }
                BIND((COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) = "Shadowing"), false) || COALESCE((COALESCE(?method__key, COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), STR(?method)), "")) = "PractitionerInterview"), false)) AS ?_result)
            }
        """ ;
    ] .
