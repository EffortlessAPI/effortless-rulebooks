            CONSTRUCT {
                $this effortless-ntwf:gateFreeReachFromEntryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(*) AS ?_result) WHERE {
                        $this effortless-ntwf:versionEntryStepId ?_from_id_key . ?_from_id a effortless-ntwf:Steps ; effortless-ntwf:stepId ?_from_id_key_pk . FILTER( REPLACE(STR(?_from_id_key_pk), "^.*[#/]", "") = REPLACE(STR(?_from_id_key), "^.*[#/]", "") )
                        ?_from_id effortless-ntwf:leadsWithoutHumanGate+ $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsReachableFromEntryWithoutHumanGate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isReachableFromEntryWithoutHumanGate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:gateFreeReachFromEntryCount ?gate_free_reach_from_entry_count . }
                BIND((COALESCE(?gate_free_reach_from_entry_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsGateBypassedPublication" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isGateBypassedPublication ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:controlKind ?control_kind . OPTIONAL { ?control_kind effortless-ntwf:__key ?control_kind__key . } }
    OPTIONAL { $this effortless-ntwf:isReachableFromEntryWithoutHumanGate ?is_reachable_from_entry_without_human_gate . }
                BIND((COALESCE((COALESCE(?control_kind__key, COALESCE(IF(isIRI(?control_kind), REPLACE(STR(?control_kind), "^.*[#/]", ""), STR(?control_kind)), "")) = "Publication"), false) && COALESCE(?is_reachable_from_entry_without_human_gate, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_ChildStepCount" ;
