    $this a effortless-ntwf:ProcedureVersions .
                OPTIONAL { $this effortless-ntwf:status ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:LifecycleStatuses ; effortless-ntwf:lifecycleStatusId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isPkoStatus ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_UsesNonPkoStatus" ;
