pko-native-procedural-knowledge-rulebook-shapes:AssignmentInstantChecks_HeldStepAtInstant a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentInstantCheck ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_HeldStepAtInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:heldStepAtInstant ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentInstantCheck .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:assignmentRole ?assignment_role . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:assignmentValidFrom ?assignment_valid_from . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:assignmentValidTo ?assignment_valid_to . OPTIONAL { ?assignment_valid_to erb:key ?assignment_valid_to__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:auditInstant ?audit_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepRole ?step_role . }
                BIND((COALESCE(COALESCE((?assignment_role = ?step_role), ((!BOUND(?assignment_role) || STR(?assignment_role) = "") && (!BOUND(?step_role) || STR(?step_role) = ""))), false) && COALESCE(COALESCE((?assignment_valid_from <= ?audit_instant), ((!BOUND(?assignment_valid_from) || STR(?assignment_valid_from) = "") && (!BOUND(?audit_instant) || STR(?audit_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?assignment_valid_to__key, COALESCE(IF(isIRI(?assignment_valid_to), REPLACE(STR(?assignment_valid_to), "^.*[#/]", ""), STR(?assignment_valid_to)), "")) = ""), false) || COALESCE(COALESCE((?assignment_valid_to > ?audit_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for AssignmentRoutedNotices ===
pko-native-procedural-knowledge-rulebook-shapes:AssignmentRoutedNotices_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentRoutedNotice ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentRoutedNotice .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:noticeStep ?notice_step . OPTIONAL { ?notice_step erb:key ?notice_step__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureExecution ?procedure_execution . OPTIONAL { ?procedure_execution erb:key ?procedure_execution__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:routedToAgent ?routed_to_agent . OPTIONAL { ?routed_to_agent erb:key ?routed_to_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_execution__key, IF(isIRI(?procedure_execution), REPLACE(STR(?procedure_execution), "^.*[#/]", ""), STR(?procedure_execution))), ""), " / ", COALESCE(COALESCE(?notice_step__key, IF(isIRI(?notice_step), REPLACE(STR(?notice_step), "^.*[#/]", ""), STR(?notice_step))), ""), " -> ", COALESCE(COALESCE(?routed_to_agent__key, IF(isIRI(?routed_to_agent), REPLACE(STR(?routed_to_agent), "^.*[#/]", ""), STR(?routed_to_agent))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentRoutedNotices_NoticeRole a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentRoutedNotice ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_NoticeRole" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:noticeRole ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentRoutedNotice .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:noticeStep ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a p-plan:Step . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:assignedRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentRoutedNotices_RecipientRoleKey a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentRoutedNotice ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RecipientRoleKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:recipientRoleKey ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentRoutedNotice .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:noticeRole ?notice_role . OPTIONAL { ?notice_role erb:key ?notice_role__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:routedToAgent ?routed_to_agent . OPTIONAL { ?routed_to_agent erb:key ?routed_to_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?routed_to_agent__key, IF(isIRI(?routed_to_agent), REPLACE(STR(?routed_to_agent), "^.*[#/]", ""), STR(?routed_to_agent))), ""), "|", COALESCE(COALESCE(?notice_role__key, IF(isIRI(?notice_role), REPLACE(STR(?notice_role), "^.*[#/]", ""), STR(?notice_role))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentRoutedNotices_RecipientPairAssignmentCount a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentRoutedNotice ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RecipientPairAssignmentCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:recipientPairAssignmentCount ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentRoutedNotice .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AssignmentRoutedNotice .
                    ?child a pro:RoleInTime .
                    ?child pko-native-procedural-knowledge-rulebook:agentRolePairKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:recipientRoleKey ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentRoutedNotices_RecipientValidFrom a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentRoutedNotice ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RecipientValidFrom" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:recipientValidFrom ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentRoutedNotice .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:AssignmentRoutedNotice .
                    ?child a pro:RoleInTime .
                    ?child pko-native-procedural-knowledge-rulebook:agentRolePairKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:recipientRoleKey ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:validFrom ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentRoutedNotices_RecipientLatestValidTo a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentRoutedNotice ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RecipientLatestValidTo" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:recipientLatestValidTo ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentRoutedNotice .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a pko-extension:AssignmentRoutedNotice .
                    ?child a pro:RoleInTime .
                    ?child pko-native-procedural-knowledge-rulebook:agentRolePairKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:recipientRoleKey ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:validTo ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentRoutedNotices_RecipientOpenEndedCount a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentRoutedNotice ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RecipientOpenEndedCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:recipientOpenEndedCount ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentRoutedNotice .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AssignmentRoutedNotice .
                    ?child a pro:RoleInTime .
                    ?child pko-native-procedural-knowledge-rulebook:agentRolePairKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:recipientRoleKey ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isOpenEnded ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentRoutedNotices_RecipientHeldRoleWhenSent a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentRoutedNotice ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RecipientHeldRoleWhenSent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:recipientHeldRoleWhenSent ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentRoutedNotice .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recipientLatestValidTo ?recipient_latest_valid_to . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recipientOpenEndedCount ?recipient_open_ended_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recipientPairAssignmentCount ?recipient_pair_assignment_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recipientValidFrom ?recipient_valid_from . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:routedToAgent ?routed_to_agent . OPTIONAL { ?routed_to_agent erb:key ?routed_to_agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sentAt ?sent_at . }
                BIND((COALESCE((COALESCE(?routed_to_agent__key, COALESCE(IF(isIRI(?routed_to_agent), REPLACE(STR(?routed_to_agent), "^.*[#/]", ""), STR(?routed_to_agent)), "")) != ""), false) && COALESCE((COALESCE(?recipient_pair_assignment_count, 0) > 0), false) && COALESCE(COALESCE((?recipient_valid_from <= ?sent_at), ((!BOUND(?recipient_valid_from) || STR(?recipient_valid_from) = "") && (!BOUND(?sent_at) || STR(?sent_at) = ""))), false) && COALESCE((COALESCE((COALESCE(?recipient_open_ended_count, 0) > 0), false) || COALESCE(COALESCE((?recipient_latest_valid_to > ?sent_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentRoutedNotices_ReachedWrongPersonOrNobody a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentRoutedNotice ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_ReachedWrongPersonOrNobody" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:reachedWrongPersonOrNobody ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentRoutedNotice .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recipientHeldRoleWhenSent ?recipient_held_role_when_sent . }
                BIND((!(COALESCE(?recipient_held_role_when_sent, false))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AssignmentRoutedNotices_RoutedAroundModel a sh:NodeShape ;
    sh:targetClass pko-extension:AssignmentRoutedNotice ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RoutedAroundModel" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:routedAroundModel ?_result .
            }
            WHERE {
    $this a pko-extension:AssignmentRoutedNotice .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recipientHeldRoleWhenSent ?recipient_held_role_when_sent . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:routingSource ?routing_source . OPTIONAL { ?routing_source erb:key ?routing_source__key . } }
                BIND((COALESCE((COALESCE(?routing_source__key, COALESCE(IF(isIRI(?routing_source), REPLACE(STR(?routing_source), "^.*[#/]", ""), STR(?routing_source)), "")) != "RoleAssignments"), false) && COALESCE((!(COALESCE(?recipient_held_role_when_sent, false))), false)) AS ?_result)
            }
        """ ;
    ] .

