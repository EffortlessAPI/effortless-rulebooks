            CONSTRUCT {
                $this effortless-ntwf:latestSourceDocumentModifiedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:ProcedureResources .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:resourceModifiedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_DaysDocumentTrailsVersion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysDocumentTrailsVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:latestSourceDocumentModifiedAt ?latest_source_document_modified_at . OPTIONAL { ?latest_source_document_modified_at effortless-ntwf:__key ?latest_source_document_modified_at__key . } }
    OPTIONAL { $this effortless-ntwf:modifiedAt ?modified_at . }
                BIND(ROUND(IF(COALESCE((COALESCE(?latest_source_document_modified_at__key, COALESCE(IF(isIRI(?latest_source_document_modified_at), REPLACE(STR(?latest_source_document_modified_at), "^.*[#/]", ""), STR(?latest_source_document_modified_at)), "")) = ""), false), 0, ((DAY(?modified_at) + FLOOR((153 * (MONTH(?modified_at) + 12 * FLOOR((14 - MONTH(?modified_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) + FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 4) - FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 100) + FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 400) - 32045) - (DAY(?latest_source_document_modified_at) + FLOOR((153 * (MONTH(?latest_source_document_modified_at) + 12 * FLOOR((14 - MONTH(?latest_source_document_modified_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?latest_source_document_modified_at) + 4800 - FLOOR((14 - MONTH(?latest_source_document_modified_at)) / 12)) + FLOOR((YEAR(?latest_source_document_modified_at) + 4800 - FLOOR((14 - MONTH(?latest_source_document_modified_at)) / 12)) / 4) - FLOOR((YEAR(?latest_source_document_modified_at) + 4800 - FLOOR((14 - MONTH(?latest_source_document_modified_at)) / 12)) / 100) + FLOOR((YEAR(?latest_source_document_modified_at) + 4800 - FLOOR((14 - MONTH(?latest_source_document_modified_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_DocumentLagsPractice" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:documentLagsPractice ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:daysDocumentTrailsVersion ?days_document_trails_version . }
    OPTIONAL { $this effortless-ntwf:latestSourceDocumentModifiedAt ?latest_source_document_modified_at . OPTIONAL { ?latest_source_document_modified_at effortless-ntwf:__key ?latest_source_document_modified_at__key . } }
                BIND((COALESCE((COALESCE(?latest_source_document_modified_at__key, COALESCE(IF(isIRI(?latest_source_document_modified_at), REPLACE(STR(?latest_source_document_modified_at), "^.*[#/]", ""), STR(?latest_source_document_modified_at)), "")) != ""), false) && COALESCE((COALESCE(?days_document_trails_version, 0) > 60), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HumanStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:humanStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:assignedAgentKind ?c2 . }
                    FILTER((STR(?c2) = "Human"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_NonHumanStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:nonHumanStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:countOfSteps ?count_of_steps . }
    OPTIONAL { $this effortless-ntwf:humanStepCount ?human_step_count . }
                BIND(ROUND((?count_of_steps - ?human_step_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_MixesHumanAndSoftwareSteps" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:mixesHumanAndSoftwareSteps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:humanStepCount ?human_step_count . }
    OPTIONAL { $this effortless-ntwf:nonHumanStepCount ?non_human_step_count . }
                BIND((COALESCE((COALESCE(?human_step_count, 0) > 0), false) && COALESCE((COALESCE(?non_human_step_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
