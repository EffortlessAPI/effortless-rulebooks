            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:unresolvedRoleKey ?_result .
            }
            WHERE {
    $this a pko-extension:SourceTermMention .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:intendedTermRole ?intended_term_role . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:matchingLabelCount ?matching_label_count . }
                BIND(IF(COALESCE((COALESCE(?matching_label_count, 0) = 0), false), ?intended_term_role, "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for SourcingFunctions ===
pko-native-procedural-knowledge-rulebook-shapes:SourcingFunctions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:SourcingFunction ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:SourcingFunction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:clientOrganization ?client_organization . OPTIONAL { ?client_organization erb:key ?client_organization__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . OPTIONAL { ?label erb:key ?label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?client_organization__key, IF(isIRI(?client_organization), REPLACE(STR(?client_organization), "^.*[#/]", ""), STR(?client_organization))), ""), ": ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourcingFunctions_IsOutsourced a sh:NodeShape ;
    sh:targetClass pko-extension:SourcingFunction ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsOutsourced" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOutsourced ?_result .
            }
            WHERE {
    $this a pko-extension:SourcingFunction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:clientOrganization ?client_organization . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:executingOrganization ?executing_organization . }
                BIND(COALESCE((?executing_organization != ?client_organization), !((!BOUND(?executing_organization) || STR(?executing_organization) = "") && (!BOUND(?client_organization) || STR(?client_organization) = ""))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourcingFunctions_IsBusinessProcessOutsourcing a sh:NodeShape ;
    sh:targetClass pko-extension:SourcingFunction ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourcingFunctions_IsBusinessProcessOutsourcing" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isBusinessProcessOutsourcing ?_result .
            }
            WHERE {
    $this a pko-extension:SourcingFunction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOutsourced ?is_outsourced . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:workNature ?work_nature . OPTIONAL { ?work_nature erb:key ?work_nature__key . } }
                BIND((COALESCE(?is_outsourced, false) && COALESCE((COALESCE(?work_nature__key, COALESCE(IF(isIRI(?work_nature), REPLACE(STR(?work_nature), "^.*[#/]", ""), STR(?work_nature)), "")) = "Transactional"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourcingFunctions_IsKnowledgeProcessOutsourcing a sh:NodeShape ;
    sh:targetClass pko-extension:SourcingFunction ;
    sh:order 2 ;
