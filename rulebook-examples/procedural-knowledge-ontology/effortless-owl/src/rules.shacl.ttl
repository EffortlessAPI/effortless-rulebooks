                BIND((COALESCE((COALESCE(?version_modified_at__key, COALESCE(IF(isIRI(?version_modified_at), REPLACE(STR(?version_modified_at), "^.*[#/]", ""), STR(?version_modified_at)), "")) != ""), false) && COALESCE(COALESCE((?reviewed_at > ?version_modified_at), false), false)) AS ?_result)
