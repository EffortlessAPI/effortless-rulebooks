# === Rules for AiLabelingRuns ===
pko-native-procedural-knowledge-rulebook-shapes:AiLabelingRuns_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AiLabelingRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiLabelingRuns_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AiLabelingRun .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:agent ?agent . OPTIONAL { ?agent erb:key ?agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:runAt ?run_at . OPTIONAL { ?run_at erb:key ?run_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?agent__key, IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent))), ""), " ", COALESCE(REPLACE(COALESCE(?run_at__key, IF(isIRI(?run_at), REPLACE(STR(?run_at), "^.*[#/]", ""), STR(?run_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiLabelingRuns_OutputCount a sh:NodeShape ;
    sh:targetClass pko-extension:AiLabelingRun ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiLabelingRuns_OutputCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:outputCount ?_result .
            }
            WHERE {
    $this a pko-extension:AiLabelingRun .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AiLabelingRun .
                    ?child a pko-extension:SourceTermMention .
                    ?child pko-native-procedural-knowledge-rulebook:aiLabelingRun $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiLabelingRuns_NonCanonicalOutputCount a sh:NodeShape ;
    sh:targetClass pko-extension:AiLabelingRun ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiLabelingRuns_NonCanonicalOutputCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:nonCanonicalOutputCount ?_result .
            }
            WHERE {
    $this a pko-extension:AiLabelingRun .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AiLabelingRun .
                    ?child a pko-extension:SourceTermMention .
                    ?child pko-native-procedural-knowledge-rulebook:aiLabelingRun $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isNonCanonicalGeneratedValue ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
