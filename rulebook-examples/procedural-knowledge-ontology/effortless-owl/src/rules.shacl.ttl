            CONSTRUCT {
                $this effortless-ntwf:usesNonPkoStatus ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:statusIsPko ?status_is_pko . }
                BIND((COALESCE(?status_is_pko, false) = false) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
