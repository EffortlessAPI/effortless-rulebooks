    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_ExpectedMajor" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expectedMajor ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:declaredScale ?declared_scale . OPTIONAL { ?declared_scale effortless-ntwf:__key ?declared_scale__key . } }
    OPTIONAL { $this effortless-ntwf:prevMajor ?prev_major . }
                BIND(ROUND(IF(COALESCE((COALESCE(?declared_scale__key, COALESCE(IF(isIRI(?declared_scale), REPLACE(STR(?declared_scale), "^.*[#/]", ""), STR(?declared_scale)), "")) = "Major"), false), (?prev_major + 1), ?prev_major)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
