            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:baselineSatisfaction ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeOutcomeMeasurement .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:comparisonBaseline ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:KnowledgeOutcomeMeasurement . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:satisfactionScore ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeOutcomeMeasurements_HigherAccessFewerErrors a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeOutcomeMeasurement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_HigherAccessFewerErrors" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:higherAccessFewerErrors ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeOutcomeMeasurement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:baselineAccessScore ?baseline_access_score . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:baselineErrorRate ?baseline_error_rate . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:comparisonBaseline ?comparison_baseline . OPTIONAL { ?comparison_baseline erb:key ?comparison_baseline__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:errorRatePercent ?error_rate_percent . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeAccessScore ?knowledge_access_score . }
                BIND((COALESCE((COALESCE(?comparison_baseline__key, COALESCE(IF(isIRI(?comparison_baseline), REPLACE(STR(?comparison_baseline), "^.*[#/]", ""), STR(?comparison_baseline)), "")) != ""), false) && COALESCE((COALESCE(?knowledge_access_score, 0) > COALESCE(?baseline_access_score, 0)), false) && COALESCE((COALESCE(?error_rate_percent, 0) < COALESCE(?baseline_error_rate, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeOutcomeMeasurements_HigherAccessMoreEfficient a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeOutcomeMeasurement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_HigherAccessMoreEfficient" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:higherAccessMoreEfficient ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeOutcomeMeasurement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:baselineAccessScore ?baseline_access_score . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:baselineMinutesPerRun ?baseline_minutes_per_run . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:comparisonBaseline ?comparison_baseline . OPTIONAL { ?comparison_baseline erb:key ?comparison_baseline__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeAccessScore ?knowledge_access_score . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:minutesPerRun ?minutes_per_run . }
                BIND((COALESCE((COALESCE(?comparison_baseline__key, COALESCE(IF(isIRI(?comparison_baseline), REPLACE(STR(?comparison_baseline), "^.*[#/]", ""), STR(?comparison_baseline)), "")) != ""), false) && COALESCE((COALESCE(?knowledge_access_score, 0) > COALESCE(?baseline_access_score, 0)), false) && COALESCE((COALESCE(?minutes_per_run, 0) < COALESCE(?baseline_minutes_per_run, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeOutcomeMeasurements_HigherAccessMoreSatisfied a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeOutcomeMeasurement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeOutcomeMeasurements_HigherAccessMoreSatisfied" ;
