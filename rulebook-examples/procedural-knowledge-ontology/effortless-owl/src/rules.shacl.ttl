            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnresolvedDisagreement ?_result .
            }
            WHERE {
    $this a pko-extension:DepartmentProcessAccount .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isConflictingAccount ?is_conflicting_account . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resolutionPractice ?resolution_practice . OPTIONAL { ?resolution_practice erb:key ?resolution_practice__key . } }
                BIND((COALESCE(?is_conflicting_account, false) && COALESCE((COALESCE(?resolution_practice__key, COALESCE(IF(isIRI(?resolution_practice), REPLACE(STR(?resolution_practice), "^.*[#/]", ""), STR(?resolution_practice)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

