                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_AiTaskCompletedCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:aiTaskCompletedCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AssistantAnswers .
                    ?child effortless-ntwf:answeringAgent $this .
                    OPTIONAL { ?child effortless-ntwf:taskOutcome ?c2 . }
                    FILTER((STR(?c2) = "Completed"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_AiTaskCompletionPercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:aiTaskCompletionPercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:aiTaskCompletedCount ?ai_task_completed_count . }
    OPTIONAL { $this effortless-ntwf:answerCount ?answer_count . }
                BIND(IF(COALESCE((COALESCE(?answer_count, 0) = 0), false), 0, (ROUND(((100 * ?ai_task_completed_count) / ?answer_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_IsBelowTaskCompletionTarget" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBelowTaskCompletionTarget ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:aiTaskCompletionPercent ?ai_task_completion_percent . }
    OPTIONAL { $this effortless-ntwf:answerCount ?answer_count . }
                BIND((COALESCE((COALESCE(?answer_count, 0) > 0), false) && COALESCE((COALESCE(?ai_task_completion_percent, 0) < 80), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_RuntimeIntegrationCount" ;
