pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_AvoidsHumanApprovalGate a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_AvoidsHumanApprovalGate" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:avoidsHumanApprovalGate ?_result .
            }
            WHERE {
    $this a pko:Transition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fromStepIsHumanApprovalGate ?from_step_is_human_approval_gate . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toStepIsHumanApprovalGate ?to_step_is_human_approval_gate . }
                BIND((COALESCE((!(COALESCE(?from_step_is_human_approval_gate, false))), false) && COALESCE((!(COALESCE(?to_step_is_human_approval_gate, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_DecisionPointCount a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_DecisionPointCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:decisionPointCount ?_result .
            }
            WHERE {
    $this a pko:Transition .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:Transition .
                    ?child a pko-native-procedural-knowledge-rulebook:DecisionPoints .
                    ?child pko-native-procedural-knowledge-rulebook:governingTransition $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_IsUndocumentedBranch a sh:NodeShape ;
    sh:targetClass pko:Transition ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsUndocumentedBranch" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUndocumentedBranch ?_result .
            }
            WHERE {
    $this a pko:Transition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decisionPointCount ?decision_point_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:transitionKind ?transition_kind . OPTIONAL { ?transition_kind erb:key ?transition_kind__key . } }
                BIND((COALESCE((COALESCE(?transition_kind__key, COALESCE(IF(isIRI(?transition_kind), REPLACE(STR(?transition_kind), "^.*[#/]", ""), STR(?transition_kind)), "")) != "Next"), false) && COALESCE((COALESCE(?decision_point_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for StepVariables ===
pko-native-procedural-knowledge-rulebook-shapes:StepVariables_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepVariables ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepVariables .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:direction ?direction . OPTIONAL { ?direction erb:key ?direction__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . OPTIONAL { ?label erb:key ?label__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " ", COALESCE(COALESCE(?direction__key, IF(isIRI(?direction), REPLACE(STR(?direction), "^.*[#/]", ""), STR(?direction))), ""), " ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepVariables_SourceDirection a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepVariables ;
    sh:order 1 ;
