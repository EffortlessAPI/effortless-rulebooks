    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RepresentationReviews_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:RepresentationReview .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version erb:key ?procedure_version__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reviewPurpose ?review_purpose . OPTIONAL { ?review_purpose erb:key ?review_purpose__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reviewerAgent ?reviewer_agent . OPTIONAL { ?reviewer_agent erb:key ?reviewer_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?review_purpose__key, IF(isIRI(?review_purpose), REPLACE(STR(?review_purpose), "^.*[#/]", ""), STR(?review_purpose))), ""), ": ", COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " by ", COALESCE(COALESCE(?reviewer_agent__key, IF(isIRI(?reviewer_agent), REPLACE(STR(?reviewer_agent), "^.*[#/]", ""), STR(?reviewer_agent))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for RequirementSatisfactions ===
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_Name a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requirement ?requirement . OPTIONAL { ?requirement erb:key ?requirement__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:satisfactionLevel ?satisfaction_level . OPTIONAL { ?satisfaction_level erb:key ?satisfaction_level__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?requirement__key, IF(isIRI(?requirement), REPLACE(STR(?requirement), "^.*[#/]", ""), STR(?requirement))), ""), " / ", COALESCE(COALESCE(?satisfaction_level__key, IF(isIRI(?satisfaction_level), REPLACE(STR(?satisfaction_level), "^.*[#/]", ""), STR(?satisfaction_level))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_RequirementIsBlocking a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RequirementIsBlocking" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:requirementIsBlocking ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requirement ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:Requirement . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isBlocking ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_IsFullySatisfied a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsFullySatisfied" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFullySatisfied ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:satisfactionLevel ?satisfaction_level . OPTIONAL { ?satisfaction_level erb:key ?satisfaction_level__key . } }
                BIND((COALESCE(?satisfaction_level__key, COALESCE(IF(isIRI(?satisfaction_level), REPLACE(STR(?satisfaction_level), "^.*[#/]", ""), STR(?satisfaction_level)), "")) = "Satisfied") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_IsBlockingAndUnmet a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsBlockingAndUnmet" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isBlockingAndUnmet ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requirementIsBlocking ?requirement_is_blocking . }
                BIND((COALESCE(?requirement_is_blocking, false) && COALESCE((!(COALESCE(?is_fully_satisfied, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_BlockingUnmetStepKey a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_BlockingUnmetStepKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:blockingUnmetStepKey ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isBlockingAndUnmet ?is_blocking_and_unmet . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_blocking_and_unmet, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_BlockingSatisfactionStepKey a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 2 ;
