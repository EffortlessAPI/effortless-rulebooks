    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?step_execution . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usage ?usage . OPTIONAL { ?usage erb:key ?usage__key . } }
                BIND(IF(COALESCE((COALESCE(?usage__key, COALESCE(IF(isIRI(?usage), REPLACE(STR(?usage), "^.*[#/]", ""), STR(?usage)), "")) = "Used"), false), ?step_execution, "") AS ?_result)
            }
