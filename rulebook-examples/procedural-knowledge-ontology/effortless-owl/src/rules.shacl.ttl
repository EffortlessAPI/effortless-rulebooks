# === Rules for Errors ===
pko-native-procedural-knowledge-rulebook-shapes:Errors_Name a sh:NodeShape ;
    sh:targetClass pko:Error ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Errors_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:Error .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:errorCode ?error_code . OPTIONAL { ?error_code erb:key ?error_code__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . OPTIONAL { ?label erb:key ?label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?error_code__key, IF(isIRI(?error_code), REPLACE(STR(?error_code), "^.*[#/]", ""), STR(?error_code))), ""), " - ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Errors_RemedyStepCount a sh:NodeShape ;
    sh:targetClass pko:Error ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Errors_RemedyStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:remedyStepCount ?_result .
            }
            WHERE {
    $this a pko:Error .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:Error .
                    ?child a p-plan:Step .
                    ?child pko:addressesError $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Errors_OccurrenceCount a sh:NodeShape ;
    sh:targetClass pko:Error ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Errors_OccurrenceCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:occurrenceCount ?_result .
            }
            WHERE {
    $this a pko:Error .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:Error .
                    ?child a pko:IssueOccurrence .
                    ?child pko-native-procedural-knowledge-rulebook:error $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Errors_HasNoRemedyStep a sh:NodeShape ;
    sh:targetClass pko:Error ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Errors_HasNoRemedyStep" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasNoRemedyStep ?_result .
            }
            WHERE {
    $this a pko:Error .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:occurrenceCount ?occurrence_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:remedyStepCount ?remedy_step_count . }
                BIND((COALESCE((COALESCE(?occurrence_count, 0) > 0), false) && COALESCE((COALESCE(?remedy_step_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for EvaluationContexts ===
pko-native-procedural-knowledge-rulebook-shapes:EvaluationContexts_Name a sh:NodeShape ;
    sh:targetClass pko-extension:EvaluationContext ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EvaluationContexts_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:EvaluationContext .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . OPTIONAL { ?as_of_instant erb:key ?as_of_instant__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . OPTIONAL { ?label erb:key ?label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), ""), " @ ", COALESCE(REPLACE(COALESCE(?as_of_instant__key, IF(isIRI(?as_of_instant), REPLACE(STR(?as_of_instant), "^.*[#/]", ""), STR(?as_of_instant))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:EvaluationContexts_ExplicitFragmentCount a sh:NodeShape ;
    sh:targetClass pko-extension:EvaluationContext ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EvaluationContexts_ExplicitFragmentCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:explicitFragmentCount ?_result .
            }
            WHERE {
    $this a pko-extension:EvaluationContext .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a pko-extension:KnowledgeFragment .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:knowledgeForm ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "Explicit"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:EvaluationContexts_TacitFragmentCount a sh:NodeShape ;
