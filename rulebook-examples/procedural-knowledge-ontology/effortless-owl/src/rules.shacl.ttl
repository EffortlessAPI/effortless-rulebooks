            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:fitDecisionContradictsConceptFit ?_result .
            }
            WHERE {
    $this a pko-extension:ModelExpansionRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fitDecision ?fit_decision . OPTIONAL { ?fit_decision erb:key ?fit_decision__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:uncoveredConceptCount ?uncovered_concept_count . }
                BIND((COALESCE((COALESCE(?fit_decision__key, COALESCE(IF(isIRI(?fit_decision), REPLACE(STR(?fit_decision), "^.*[#/]", ""), STR(?fit_decision)), "")) = "FitsExistingSchema"), false) && COALESCE((COALESCE(?uncovered_concept_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

