                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:reviewPurpose ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:reviewerIsAffectedSme ?c4 . }
                    OPTIONAL { ?child effortless-ntwf:decision ?c6 . }
                    FILTER((STR(?c2) = "RepresentationApproval"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    FILTER((STR(?c6) = "Approved"))
                    }
                }
            }
        """ ;
