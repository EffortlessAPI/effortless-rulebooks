            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepRequirements .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requirement ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:Requirement . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isRegulatoryRequirement ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepRequirements_PassCountOnStep a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepRequirements ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_PassCountOnStep" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:passCountOnStep ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepRequirements .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:StepRequirements .
                    ?child a pko:StepExecution .
                    ?child pko-native-procedural-knowledge-rulebook:step ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:step ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:verificationResult ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "PASS"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for StepResources ===
pko-native-procedural-knowledge-rulebook-shapes:StepResources_Name a sh:NodeShape ;
    sh:targetClass pko-extension:StepResource ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepResources_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:StepResource .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resource ?resource . OPTIONAL { ?resource erb:key ?resource__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?resource__key, IF(isIRI(?resource), REPLACE(STR(?resource), "^.*[#/]", ""), STR(?resource))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for StepTools ===
pko-native-procedural-knowledge-rulebook-shapes:StepTools_Name a sh:NodeShape ;
