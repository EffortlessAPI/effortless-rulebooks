                    ?child effortless-ntwf:stepWhenUnusable ?backfk .
                    $this effortless-ntwf:stepId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_AllSourcesUsable" ;
