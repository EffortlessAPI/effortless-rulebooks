            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:templateDrawsNoResponse ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:MessageTemplates .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:transmittedDeliveryCount ?transmitted_delivery_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:unansweredDeliveryCount ?unanswered_delivery_count . }
                BIND((COALESCE((COALESCE(?transmitted_delivery_count, 0) > 0), false) && COALESCE((COALESCE(?unanswered_delivery_count, 0) = COALESCE(?transmitted_delivery_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MessageTemplates_LastApprovalAt a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:MessageTemplates ;
    sh:order 1 ;
