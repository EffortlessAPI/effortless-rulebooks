    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:role ?role . }
                BIND(IF(COALESCE(?is_unauthorized_non_human_assignment, false), ?role, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_ScopedVersionStatus a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
