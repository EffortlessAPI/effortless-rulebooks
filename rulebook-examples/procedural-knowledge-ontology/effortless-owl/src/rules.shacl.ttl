            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executorIsHuman ?executor_is_human . }
    OPTIONAL { $this effortless-ntwf:stepIsApproval ?step_is_approval . }
                BIND((COALESCE(?step_is_approval, false) && COALESCE((!(COALESCE(?executor_is_human, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_UnevaluatedBlockingExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
