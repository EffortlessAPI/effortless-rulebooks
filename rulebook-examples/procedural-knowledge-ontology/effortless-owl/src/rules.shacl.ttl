                $this effortless-ntwf:isGovernedByUnwarrantedBoundary ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:unwarrantedBoundaryCount ?unwarranted_boundary_count . }
