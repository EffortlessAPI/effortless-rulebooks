            }
            WHERE {
    $this a pko-extension:StepCondition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:checkCount ?check_count . }
                BIND((COALESCE(?check_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
