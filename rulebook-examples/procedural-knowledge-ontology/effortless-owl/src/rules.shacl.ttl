    OPTIONAL { $this effortless-ntwf:repetitionCount ?repetition_count . }
    OPTIONAL { $this effortless-ntwf:stepMaxRepetitions ?step_max_repetitions . }
                BIND((COALESCE((COALESCE(?step_max_repetitions, 0) > 0), false) && COALESCE((COALESCE(?repetition_count, 0) > COALESCE(?step_max_repetitions, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_LacksRequiredConfirmation" ;
