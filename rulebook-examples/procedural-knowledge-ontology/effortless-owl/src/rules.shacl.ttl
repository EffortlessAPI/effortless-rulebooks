            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:quietHoursViolationCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:CommunicationPolicies .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:CommunicationPolicies .
                    ?child a pko-extension:MessageDelivery .
                    ?child pko-native-procedural-knowledge-rulebook:quietHoursViolationPolicyKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:communicationPolicyId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CommunicationPolicies_IsActivePolicy a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:CommunicationPolicies ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_IsActivePolicy" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isActivePolicy ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:CommunicationPolicies .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status_CommunicationPolicies ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Active") AS ?_result)
            }
        """ ;
    ] .

# === Rules for CommunitiesOfPractice ===
pko-native-procedural-knowledge-rulebook-shapes:CommunitiesOfPractice_Name a sh:NodeShape ;
    sh:targetClass pko-extension:CommunityOfPractice ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:CommunityOfPractice .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CommunitiesOfPractice_HasOwnVocabularyAndNorms a sh:NodeShape ;
    sh:targetClass pko-extension:CommunityOfPractice ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_HasOwnVocabularyAndNorms" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasOwnVocabularyAndNorms ?_result .
            }
            WHERE {
    $this a pko-extension:CommunityOfPractice .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:norms ?norms . OPTIONAL { ?norms erb:key ?norms__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ownVocabulary ?own_vocabulary . OPTIONAL { ?own_vocabulary erb:key ?own_vocabulary__key . } }
                BIND((COALESCE((COALESCE(?own_vocabulary__key, COALESCE(IF(isIRI(?own_vocabulary), REPLACE(STR(?own_vocabulary), "^.*[#/]", ""), STR(?own_vocabulary)), "")) != ""), false) && COALESCE((COALESCE(?norms__key, COALESCE(IF(isIRI(?norms), REPLACE(STR(?norms), "^.*[#/]", ""), STR(?norms)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CommunitiesOfPractice_SharingEventCount a sh:NodeShape ;
    sh:targetClass pko-extension:CommunityOfPractice ;
    sh:order 1 ;
    sh:rule [
