            WHERE {
    $this a pko-extension:AppRoute .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:surface ?surface . OPTIONAL { ?surface erb:key ?surface__key . } }
                BIND((COALESCE(?surface__key, COALESCE(IF(isIRI(?surface), REPLACE(STR(?surface), "^.*[#/]", ""), STR(?surface)), "")) = "maintainer") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AppRoutes_QuestionCount a sh:NodeShape ;
    sh:targetClass pko-extension:AppRoute ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_QuestionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:questionCount ?_result .
            }
            WHERE {
    $this a pko-extension:AppRoute .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AppRoute .
                    ?child a pko-extension:AppRouteQuestion .
                    ?child pko-native-procedural-knowledge-rulebook:route $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
