    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_WindowHasSinceReopened" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:windowHasSinceReopened ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:evaluatedAt ?evaluated_at . }
    OPTIONAL { $this effortless-ntwf:hoursUntilWindowOpens ?hours_until_window_opens . }
                BIND((COALESCE((COALESCE(?hours_until_window_opens, 0) > 0), false) && COALESCE((COALESCE(((((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?evaluated_at) + FLOOR((153 * (MONTH(?evaluated_at) + 12 * FLOOR((14 - MONTH(?evaluated_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 4) - FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 100) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?as_of_instant) * 3600 + MINUTES(?as_of_instant) * 60 + SECONDS(?as_of_instant)) - (HOURS(?evaluated_at) * 3600 + MINUTES(?evaluated_at) * 60 + SECONDS(?evaluated_at))) / 3600), 0) > COALESCE(?hours_until_window_opens, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_HasRetryAttempt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasRetryAttempt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:retryIntent ?retry_intent . }
                BIND((REPLACE(COALESCE(STR(?retry_intent), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RetryWasCleared" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:retryWasCleared ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:retryIntent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:SendIntents ; effortless-ntwf:sendIntentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isClearedToSend ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsAbandonedDeferral" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAbandonedDeferral ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:hasRetryAttempt ?has_retry_attempt . }
    OPTIONAL { $this effortless-ntwf:wasDeferredOnTiming ?was_deferred_on_timing . }
    OPTIONAL { $this effortless-ntwf:windowHasSinceReopened ?window_has_since_reopened . }
                BIND((COALESCE(?was_deferred_on_timing, false) && COALESCE((COALESCE(?window_has_since_reopened, false) && COALESCE((!(COALESCE(?has_retry_attempt, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_DeferralAgeHours" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:deferralAgeHours ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:evaluatedAt ?evaluated_at . }
                BIND(ROUND(((((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?evaluated_at) + FLOOR((153 * (MONTH(?evaluated_at) + 12 * FLOOR((14 - MONTH(?evaluated_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 4) - FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 100) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?as_of_instant) * 3600 + MINUTES(?as_of_instant) * 60 + SECONDS(?as_of_instant)) - (HOURS(?evaluated_at) * 3600 + MINUTES(?evaluated_at) * 60 + SECONDS(?evaluated_at))) / 3600)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsStaleDeferral" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStaleDeferral ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:deferralAgeHours ?deferral_age_hours . }
    OPTIONAL { $this effortless-ntwf:wasDeferredOnTiming ?was_deferred_on_timing . }
                BIND((COALESCE(?was_deferred_on_timing, false) && COALESCE((COALESCE(?deferral_age_hours, 0) > 24), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_EnforcedByUnauthorizedAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:enforcedByUnauthorizedAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:evaluatingRoleAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isUnauthorizedEnforcementAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ConsentInputWasResolvable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:consentInputWasResolvable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:recipientConsentStatusRaw ?recipient_consent_status_raw . }
                BIND((REPLACE(COALESCE(STR(?recipient_consent_status_raw), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RecipientConsentStatusRaw" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientConsentStatusRaw ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:smsConsentStatus ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_PolicyInputWasResolvable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyInputWasResolvable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentPolicy ?intent_policy . }
                BIND((REPLACE(COALESCE(STR(?intent_policy), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_AllGateInputsResolved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:allGateInputsResolved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:consentInputWasResolvable ?consent_input_was_resolvable . }
    OPTIONAL { $this effortless-ntwf:policyInputWasResolvable ?policy_input_was_resolvable . }
                BIND((COALESCE(?consent_input_was_resolvable, false) && COALESCE(?policy_input_was_resolvable, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsUnevaluableRefusal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnevaluableRefusal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:allGateInputsResolved ?all_gate_inputs_resolved . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
                BIND((COALESCE((!(COALESCE(?is_cleared_to_send, false))), false) && COALESCE((!(COALESCE(?all_gate_inputs_resolved, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsSelfWitnessedDecision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSelfWitnessedDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:gateResultWasIndependentlyConfirmed ?gate_result_was_independently_confirmed . }
                BIND((!(COALESCE(?gate_result_was_independently_confirmed, false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsIndependentlyConfirmed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isIndependentlyConfirmed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:hasResultingDelivery ?has_resulting_delivery . }
    OPTIONAL { $this effortless-ntwf:resultingDeliveryWasTransmitted ?resulting_delivery_was_transmitted . }
                BIND((COALESCE(?has_resulting_delivery, false) && COALESCE(?resulting_delivery_was_transmitted, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IndependentlyConfirmedExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:independentlyConfirmedExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:isIndependentlyConfirmed ?is_independently_confirmed . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?is_independently_confirmed, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepActions ===
effortless-ntwf:StepActionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepActions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepActions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepActions .
    OPTIONAL { $this effortless-ntwf:action ?action . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(CONCAT(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step)), " / ", IF(isIRI(?action), REPLACE(STR(?action), "^.*[#/]", ""), STR(?action))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepExecutions ===
effortless-ntwf:StepExecutionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepExecutions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(CONCAT(IF(isIRI(?procedure_execution), REPLACE(STR(?procedure_execution), "^.*[#/]", ""), STR(?procedure_execution)), " / ", IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ActualDurationMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:actualDurationMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:endedAt ?ended_at . }
    OPTIONAL { $this effortless-ntwf:startedAt ?started_at . }
                BIND(ROUND(IF(COALESCE((REPLACE(COALESCE(STR(?ended_at), ""), "^.*#", "") = ""), false), 0, ((((DAY(?ended_at) + FLOOR((153 * (MONTH(?ended_at) + 12 * FLOOR((14 - MONTH(?ended_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 4) - FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 100) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 400) - 32045) - (DAY(?started_at) + FLOOR((153 * (MONTH(?started_at) + 12 * FLOOR((14 - MONTH(?started_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 4) - FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 100) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?ended_at) * 3600 + MINUTES(?ended_at) * 60 + SECONDS(?ended_at)) - (HOURS(?started_at) * 3600 + MINUTES(?started_at) * 60 + SECONDS(?started_at))) / 60))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExpectedDurationMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expectedDurationMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:expectedDurationMinutes ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsLate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:actualDurationMinutes ?actual_duration_minutes . }
    OPTIONAL { $this effortless-ntwf:expectedDurationMinutes ?expected_duration_minutes . }
                BIND((COALESCE(?actual_duration_minutes, 0) > COALESCE(?expected_duration_minutes, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_BlockingUnmetCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:blockingUnmetCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:stepExecution $this .
                    OPTIONAL { ?child effortless-ntwf:isBlockingAndUnmet ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_BlockingUnmetCountSafe" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:blockingUnmetCountSafe ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:blockingUnmetStepKey ?backfk .
                    $this effortless-ntwf:stepExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ProceededPastBlockingControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:proceededPastBlockingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:blockingUnmetCountSafe ?blocking_unmet_count_safe . }
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?execution_status), ""), "^.*#", "") = "Completed"), false) && COALESCE((COALESCE(?blocking_unmet_count_safe, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExpectedBlockingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expectedBlockingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:blockingRequirementCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_EvaluatedBlockingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:evaluatedBlockingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:blockingSatisfactionStepKey ?backfk .
                    $this effortless-ntwf:stepExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_UnevaluatedBlockingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unevaluatedBlockingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:evaluatedBlockingCount ?evaluated_blocking_count . }
    OPTIONAL { $this effortless-ntwf:expectedBlockingCount ?expected_blocking_count . }
                BIND((?expected_blocking_count - ?evaluated_blocking_count) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasUnevaluatedBlockingControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasUnevaluatedBlockingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:unevaluatedBlockingCount ?unevaluated_blocking_count . }
                BIND((COALESCE(?unevaluated_blocking_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
