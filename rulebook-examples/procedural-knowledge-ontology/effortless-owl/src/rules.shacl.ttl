    OPTIONAL { $this effortless-ntwf:isCompoundFragile ?is_compound_fragile . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_compound_fragile, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_ValidFragmentSessionKey" ;
        sh:prefixes effortless-ntwf: ;
