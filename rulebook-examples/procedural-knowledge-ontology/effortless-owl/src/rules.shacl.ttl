            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-extension:OntologySupportProgramme .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OntologySupportProgrammes_SupportedProfileCount a sh:NodeShape ;
    sh:targetClass pko-extension:OntologySupportProgramme ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologySupportProgrammes_SupportedProfileCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:supportedProfileCount ?_result .
            }
            WHERE {
    $this a pko-extension:OntologySupportProgramme .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:OntologySupportProgramme .
                    ?child a pko-native-procedural-knowledge-rulebook:OntologyProfiles .
                    ?child pko-native-procedural-knowledge-rulebook:supportingProgramme $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OntologySupportProgrammes_HasEnded a sh:NodeShape ;
    sh:targetClass pko-extension:OntologySupportProgramme ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologySupportProgrammes_HasEnded" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasEnded ?_result .
            }
            WHERE {
    $this a pko-extension:OntologySupportProgramme .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:endsOn ?ends_on . OPTIONAL { ?ends_on erb:key ?ends_on__key . } }
                BIND((COALESCE((COALESCE(?ends_on__key, COALESCE(IF(isIRI(?ends_on), REPLACE(STR(?ends_on), "^.*[#/]", ""), STR(?ends_on)), "")) != ""), false) && COALESCE(COALESCE((?ends_on < ?as_of_instant), false), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OntologySupportProgrammes_DaysUntilProgrammeEnds a sh:NodeShape ;
    sh:targetClass pko-extension:OntologySupportProgramme ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologySupportProgrammes_DaysUntilProgrammeEnds" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysUntilProgrammeEnds ?_result .
            }
            WHERE {
    $this a pko-extension:OntologySupportProgramme .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:endsOn ?ends_on . OPTIONAL { ?ends_on erb:key ?ends_on__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?ends_on__key, COALESCE(IF(isIRI(?ends_on), REPLACE(STR(?ends_on), "^.*[#/]", ""), STR(?ends_on)), "")) = ""), false), 0, ((DAY(?ends_on) + FLOOR((153 * (MONTH(?ends_on) + 12 * FLOOR((14 - MONTH(?ends_on)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?ends_on) + 4800 - FLOOR((14 - MONTH(?ends_on)) / 12)) + FLOOR((YEAR(?ends_on) + 4800 - FLOOR((14 - MONTH(?ends_on)) / 12)) / 4) - FLOOR((YEAR(?ends_on) + 4800 - FLOOR((14 - MONTH(?ends_on)) / 12)) / 100) + FLOOR((YEAR(?ends_on) + 4800 - FLOOR((14 - MONTH(?ends_on)) / 12)) / 400) - 32045) - (DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OntologySupportProgrammes_IsEndedWithNoStewardNamed a sh:NodeShape ;
    sh:targetClass pko-extension:OntologySupportProgramme ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologySupportProgrammes_IsEndedWithNoStewardNamed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isEndedWithNoStewardNamed ?_result .
            }
            WHERE {
    $this a pko-extension:OntologySupportProgramme .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasEnded ?has_ended . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ourSuccessorSteward ?our_successor_steward . OPTIONAL { ?our_successor_steward erb:key ?our_successor_steward__key . } }
                BIND((COALESCE(?has_ended, false) && COALESCE((COALESCE(?our_successor_steward__key, COALESCE(IF(isIRI(?our_successor_steward), REPLACE(STR(?our_successor_steward), "^.*[#/]", ""), STR(?our_successor_steward)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OntologySupportProgrammes_IsEndingSoonWithNoStewardNamed a sh:NodeShape ;
    sh:targetClass pko-extension:OntologySupportProgramme ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologySupportProgrammes_IsEndingSoonWithNoStewardNamed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isEndingSoonWithNoStewardNamed ?_result .
            }
            WHERE {
    $this a pko-extension:OntologySupportProgramme .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysUntilProgrammeEnds ?days_until_programme_ends . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:endsOn ?ends_on . OPTIONAL { ?ends_on erb:key ?ends_on__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasEnded ?has_ended . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ourSuccessorSteward ?our_successor_steward . OPTIONAL { ?our_successor_steward erb:key ?our_successor_steward__key . } }
                BIND((COALESCE((COALESCE(?has_ended, false) = false), false) && COALESCE((COALESCE(?ends_on__key, COALESCE(IF(isIRI(?ends_on), REPLACE(STR(?ends_on), "^.*[#/]", ""), STR(?ends_on)), "")) != ""), false) && COALESCE((COALESCE(?days_until_programme_ends, 0) <= 180), false) && COALESCE((COALESCE(?our_successor_steward__key, COALESCE(IF(isIRI(?our_successor_steward), REPLACE(STR(?our_successor_steward), "^.*[#/]", ""), STR(?our_successor_steward)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for OperationalBindings ===
pko-native-procedural-knowledge-rulebook-shapes:OperationalBindings_Name a sh:NodeShape ;
    sh:targetClass pko-extension:OperationalBinding ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:OperationalBinding .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recordOrSchemaKey ?record_or_schema_key . OPTIONAL { ?record_or_schema_key erb:key ?record_or_schema_key__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?record_or_schema_key__key, IF(isIRI(?record_or_schema_key), REPLACE(STR(?record_or_schema_key), "^.*[#/]", ""), STR(?record_or_schema_key))), "")) AS ?_result)
            }
        """ ;
    ] .
