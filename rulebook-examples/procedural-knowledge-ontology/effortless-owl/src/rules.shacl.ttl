            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:sourceDirection ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:StepVariables .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceVariable ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:StepVariables . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:direction ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepVariables_SourceStep a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepVariables ;
    sh:order 1 ;
    sh:rule [
