            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnescalatedDangerCue ?_result .
            }
            WHERE {
    $this a pko-extension:CueObservation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cueRequiresEscalation ?cue_requires_escalation . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wasEscalated ?was_escalated . }
                BIND((COALESCE(?cue_requires_escalation, false) && COALESCE((COALESCE(?was_escalated, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CueObservations_UnescalatedCueKey a sh:NodeShape ;
    sh:targetClass pko-extension:CueObservation ;
