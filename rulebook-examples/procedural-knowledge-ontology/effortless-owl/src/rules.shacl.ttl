pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_UnevaluatedBlockingCount a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_UnevaluatedBlockingCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:unevaluatedBlockingCount ?_result .
            }
            WHERE {
    $this a pko:StepExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluatedBlockingCount ?evaluated_blocking_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:expectedBlockingCount ?expected_blocking_count . }
                BIND((?expected_blocking_count - ?evaluated_blocking_count) AS ?_result)
            }
        """ ;
    ] .
