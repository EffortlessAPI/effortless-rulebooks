                $this pko-native-procedural-knowledge-rulebook:isNestedProcedure ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Procedures .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:calledByStepCount ?called_by_step_count . }
                BIND((COALESCE(?called_by_step_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Procedures_FailureCriterionCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:Procedures ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_FailureCriterionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:failureCriterionCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:Procedures .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:Procedures .
                    ?child a pko-extension:OutcomeCriterion .
                    ?child pko-native-procedural-knowledge-rulebook:failureProcedureKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:procedureId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Procedures_HasNoFailureCriterion a sh:NodeShape ;
