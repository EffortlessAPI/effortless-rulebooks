    $this a pko-extension:PractitionerExpertise .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:expertKind ?expert_kind . OPTIONAL { ?expert_kind erb:key ?expert_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reliableCallCount ?reliable_call_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:unstatedBasis ?unstated_basis . OPTIONAL { ?unstated_basis erb:key ?unstated_basis__key . } }
                BIND((COALESCE((COALESCE(?expert_kind__key, COALESCE(IF(isIRI(?expert_kind), REPLACE(STR(?expert_kind), "^.*[#/]", ""), STR(?expert_kind)), "")) = "Detection"), false) && COALESCE((COALESCE(?unstated_basis__key, COALESCE(IF(isIRI(?unstated_basis), REPLACE(STR(?unstated_basis), "^.*[#/]", ""), STR(?unstated_basis)), "")) != ""), false) && COALESCE((COALESCE(?reliable_call_count, 0) >= 3), false)) AS ?_result)
            }
        """ ;
    ] .
