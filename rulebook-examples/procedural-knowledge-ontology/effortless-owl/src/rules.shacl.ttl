            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:relationIri ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureResources .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:relation ?relation . OPTIONAL { ?relation erb:key ?relation__key . } }
                BIND(IF(COALESCE((COALESCE(?relation__key, COALESCE(IF(isIRI(?relation), REPLACE(STR(?relation), "^.*[#/]", ""), STR(?relation)), "")) = "wasExtractedFrom"), false), "https://w3id.org/pko#wasExtractedFrom", "http://purl.org/dc/terms/references") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureResources_ResourceModifiedAt a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureResources ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureResources_ResourceModifiedAt" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:resourceModifiedAt ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureResources .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resource ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:Resources . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:modifiedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcedureStatusChanges ===
pko-native-procedural-knowledge-rulebook-shapes:ProcedureStatusChanges_Name a sh:NodeShape ;
    sh:targetClass pko:ChangeOfStatus ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureStatusChanges_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:ChangeOfStatus .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:fromStatus ?from_status . OPTIONAL { ?from_status erb:key ?from_status__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version erb:key ?procedure_version__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toStatus ?to_status . OPTIONAL { ?to_status erb:key ?to_status__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), ": ", COALESCE(COALESCE(?from_status__key, IF(isIRI(?from_status), REPLACE(STR(?from_status), "^.*[#/]", ""), STR(?from_status))), ""), " -> ", COALESCE(COALESCE(?to_status__key, IF(isIRI(?to_status), REPLACE(STR(?to_status), "^.*[#/]", ""), STR(?to_status))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureStatusChanges_IsUnattributedChange a sh:NodeShape ;
    sh:targetClass pko:ChangeOfStatus ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureStatusChanges_IsUnattributedChange" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnattributedChange ?_result .
            }
            WHERE {
    $this a pko:ChangeOfStatus .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:changedByAgent ?changed_by_agent . OPTIONAL { ?changed_by_agent erb:key ?changed_by_agent__key . } }
                BIND((COALESCE(?changed_by_agent__key, COALESCE(IF(isIRI(?changed_by_agent), REPLACE(STR(?changed_by_agent), "^.*[#/]", ""), STR(?changed_by_agent)), "")) = "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureStatusChanges_ChangeKindContradictsTarget a sh:NodeShape ;
    sh:targetClass pko:ChangeOfStatus ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureStatusChanges_ChangeKindContradictsTarget" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:changeKindContradictsTarget ?_result .
            }
            WHERE {
    $this a pko:ChangeOfStatus .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:changeKind ?change_kind . OPTIONAL { ?change_kind erb:key ?change_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toStatus ?to_status . OPTIONAL { ?to_status erb:key ?to_status__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?change_kind__key, COALESCE(IF(isIRI(?change_kind), REPLACE(STR(?change_kind), "^.*[#/]", ""), STR(?change_kind)), "")) = "Approve"), false) && COALESCE((COALESCE(?to_status__key, COALESCE(IF(isIRI(?to_status), REPLACE(STR(?to_status), "^.*[#/]", ""), STR(?to_status)), "")) != "Approved"), false)), false) || COALESCE((COALESCE((COALESCE(?change_kind__key, COALESCE(IF(isIRI(?change_kind), REPLACE(STR(?change_kind), "^.*[#/]", ""), STR(?change_kind)), "")) = "Validate"), false) && COALESCE((COALESCE(?to_status__key, COALESCE(IF(isIRI(?to_status), REPLACE(STR(?to_status), "^.*[#/]", ""), STR(?to_status)), "")) != "Validation"), false)), false) || COALESCE((COALESCE((COALESCE(?change_kind__key, COALESCE(IF(isIRI(?change_kind), REPLACE(STR(?change_kind), "^.*[#/]", ""), STR(?change_kind)), "")) = "Archive"), false) && COALESCE((COALESCE(?to_status__key, COALESCE(IF(isIRI(?to_status), REPLACE(STR(?to_status), "^.*[#/]", ""), STR(?to_status)), "")) != "Archived"), false) && COALESCE((COALESCE(?to_status__key, COALESCE(IF(isIRI(?to_status), REPLACE(STR(?to_status), "^.*[#/]", ""), STR(?to_status)), "")) != "Deprecated"), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ProcedureTargets ===
pko-native-procedural-knowledge-rulebook-shapes:ProcedureTargets_Name a sh:NodeShape ;
    sh:targetClass pko:ProcedureTarget ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTargets_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:ProcedureTarget .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureTargets_MachineIsNonStandard a sh:NodeShape ;
    sh:targetClass pko:ProcedureTarget ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTargets_MachineIsNonStandard" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:machineIsNonStandard ?_result .
            }
            WHERE {
    $this a pko:ProcedureTarget .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:machine ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-industry:Machine . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isNonStandardConfiguration ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureTargets_HandlingFailureModeCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureTarget ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTargets_HandlingFailureModeCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:handlingFailureModeCount ?_result .
            }
            WHERE {
    $this a pko:ProcedureTarget .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:ProcedureTarget .
                    ?child a pko-extension:FailureMode .
                    ?child pko-native-procedural-knowledge-rulebook:procedureTarget $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureTargets_IsUnhandledNonStandardTarget a sh:NodeShape ;
    sh:targetClass pko:ProcedureTarget ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureTargets_IsUnhandledNonStandardTarget" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnhandledNonStandardTarget ?_result .
            }
            WHERE {
    $this a pko:ProcedureTarget .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:handlingFailureModeCount ?handling_failure_mode_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:machineIsNonStandard ?machine_is_non_standard . }
                BIND((COALESCE(?machine_is_non_standard, false) && COALESCE((COALESCE(?handling_failure_mode_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

