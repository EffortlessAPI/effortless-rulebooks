                BIND((COALESCE(?acknowledged_at__key, COALESCE(IF(isIRI(?acknowledged_at), REPLACE(STR(?acknowledged_at), "^.*[#/]", ""), STR(?acknowledged_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_InvokedExceptionCondition" ;
