            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AuthorityBoundary .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:forbiddenAgentKind ?forbidden_agent_kind . OPTIONAL { ?forbidden_agent_kind erb:key ?forbidden_agent_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:forbiddenDecisionKind ?forbidden_decision_kind . OPTIONAL { ?forbidden_decision_kind erb:key ?forbidden_decision_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?forbidden_agent_kind__key, IF(isIRI(?forbidden_agent_kind), REPLACE(STR(?forbidden_agent_kind), "^.*[#/]", ""), STR(?forbidden_agent_kind))), ""), " may not ", COALESCE(COALESCE(?forbidden_decision_kind__key, IF(isIRI(?forbidden_decision_kind), REPLACE(STR(?forbidden_decision_kind), "^.*[#/]", ""), STR(?forbidden_decision_kind))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AuthorityBoundaries_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-extension:AuthorityBoundary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_AsOfInstant" ;
        sh:construct """
