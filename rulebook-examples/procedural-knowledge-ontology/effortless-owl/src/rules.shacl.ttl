            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:referenceCount ?_result .
            }
            WHERE {
    $this a pko-extension:AppRoute .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AppRoute .
                    ?child a pko-extension:AppRouteReference .
                    ?child pko-native-procedural-knowledge-rulebook:fromRoute $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AppRoutes_AnswersNoQuestion a sh:NodeShape ;
    sh:targetClass pko-extension:AppRoute ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_AnswersNoQuestion" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:answersNoQuestion ?_result .
            }
            WHERE {
    $this a pko-extension:AppRoute .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isMaintainer ?is_maintainer . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isShared ?is_shared . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:questionCount ?question_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:routeKind ?route_kind . OPTIONAL { ?route_kind erb:key ?route_kind__key . } }
                BIND((COALESCE((COALESCE(?question_count, 0) = 0), false) && COALESCE((COALESCE(?is_shared, false) = false), false) && COALESCE((COALESCE(?is_maintainer, false) = false), false) && COALESCE((COALESCE(?route_kind__key, COALESCE(IF(isIRI(?route_kind), REPLACE(STR(?route_kind), "^.*[#/]", ""), STR(?route_kind)), "")) != "index"), false)) AS ?_result)
            }
        """ ;
    ] .

