    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:previousRelease ?previous_release . OPTIONAL { ?previous_release erb:key ?previous_release__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:versionMajor ?version_major . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:versionMinor ?version_minor . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:versionPatch ?version_patch . }
                BIND((COALESCE((COALESCE(?previous_release__key, COALESCE(IF(isIRI(?previous_release), REPLACE(STR(?previous_release), "^.*[#/]", ""), STR(?previous_release)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?version_major, 0) != COALESCE(?expected_major, 0)), false) || COALESCE((COALESCE(?version_minor, 0) != COALESCE(?expected_minor, 0)), false) || COALESCE((COALESCE(?version_patch, 0) != COALESCE(?expected_patch, 0)), false)), false)) AS ?_result)
