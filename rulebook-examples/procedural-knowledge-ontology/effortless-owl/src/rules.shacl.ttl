    $this a pko-extension:CapabilityDecline .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:precedingStageDecline ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:CapabilityDecline . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:stage_CapabilityDeclines ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CapabilityDeclines_PrecedingDeclineStartedAt a sh:NodeShape ;
    sh:targetClass pko-extension:CapabilityDecline ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CapabilityDeclines_PrecedingDeclineStartedAt" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:precedingDeclineStartedAt ?_result .
            }
            WHERE {
    $this a pko-extension:CapabilityDecline .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:precedingStageDecline ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:CapabilityDecline . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:declineStartedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CapabilityDeclines_FollowsPrecedingStageDecline a sh:NodeShape ;
    sh:targetClass pko-extension:CapabilityDecline ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CapabilityDeclines_FollowsPrecedingStageDecline" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:followsPrecedingStageDecline ?_result .
            }
            WHERE {
    $this a pko-extension:CapabilityDecline .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:declineStartedAt ?decline_started_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:precedingDeclineStartedAt ?preceding_decline_started_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:precedingStage ?preceding_stage . OPTIONAL { ?preceding_stage erb:key ?preceding_stage__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:precedingStageDecline ?preceding_stage_decline . OPTIONAL { ?preceding_stage_decline erb:key ?preceding_stage_decline__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stage_CapabilityDeclines ?stage . OPTIONAL { ?stage erb:key ?stage__key . } }
                BIND((COALESCE((COALESCE(?preceding_stage_decline__key, COALESCE(IF(isIRI(?preceding_stage_decline), REPLACE(STR(?preceding_stage_decline), "^.*[#/]", ""), STR(?preceding_stage_decline)), "")) != ""), false) && COALESCE(COALESCE((?preceding_decline_started_at < ?decline_started_at), false), false) && COALESCE((COALESCE((COALESCE((COALESCE(?stage__key, COALESCE(IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage)), "")) = "EngineerTraining"), false) && COALESCE((COALESCE(?preceding_stage__key, COALESCE(IF(isIRI(?preceding_stage), REPLACE(STR(?preceding_stage), "^.*[#/]", ""), STR(?preceding_stage)), "")) = "FacilityInvestment"), false)), false) || COALESCE((COALESCE((COALESCE(?stage__key, COALESCE(IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage)), "")) = "KnowHowUpkeep"), false) && COALESCE((COALESCE(?preceding_stage__key, COALESCE(IF(isIRI(?preceding_stage), REPLACE(STR(?preceding_stage), "^.*[#/]", ""), STR(?preceding_stage)), "")) = "EngineerTraining"), false)), false)), false)) AS ?_result)
            }
        """ ;
    ] .

