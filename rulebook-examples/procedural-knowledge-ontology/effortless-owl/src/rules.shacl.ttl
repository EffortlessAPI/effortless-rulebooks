            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnrehearsedControlEntry ?_result .
            }
            WHERE {
    $this a pko:Transition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isUnwalkedRecoveryPath ?is_unwalked_recovery_path . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetCarriesBlockingControl ?target_carries_blocking_control . }
                BIND((COALESCE(?is_unwalked_recovery_path, false) && COALESCE(?target_carries_blocking_control, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepTransitions_UnrehearsedControlVersionKey a sh:NodeShape ;
