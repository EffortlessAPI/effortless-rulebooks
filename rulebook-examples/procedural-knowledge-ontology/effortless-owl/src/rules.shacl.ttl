            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:authorityAgent ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authorityRole ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:Role . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:currentAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_RequesterIsAuthority a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_RequesterIsAuthority" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:requesterIsAuthority ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:authorityAgent ?authority_agent . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requestedByAgent ?requested_by_agent . }
                BIND(COALESCE((?requested_by_agent = ?authority_agent), ((!BOUND(?requested_by_agent) || STR(?requested_by_agent) = "") && (!BOUND(?authority_agent) || STR(?authority_agent) = ""))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_AwaitsAuthorityDecision a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_AwaitsAuthorityDecision" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:awaitsAuthorityDecision ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isDecided ?is_decided . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status_ChangeRequests ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "UnderReview"), false) && COALESCE((!(COALESCE(?is_decided, false))), false)) AS ?_result)
            }
        """ ;
    ] .
