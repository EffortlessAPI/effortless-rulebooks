# === Rules for AgentDecisionRecords ===
pko-native-procedural-knowledge-rulebook-shapes:AgentDecisionRecords_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AgentDecisionRecord ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AgentDecisionRecord .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decidingAgent ?deciding_agent . OPTIONAL { ?deciding_agent erb:key ?deciding_agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decisionSummary ?decision_summary . }
                BIND(CONCAT(COALESCE(COALESCE(?deciding_agent__key, IF(isIRI(?deciding_agent), REPLACE(STR(?deciding_agent), "^.*[#/]", ""), STR(?deciding_agent))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?decision_summary), 1, 60)), REPLACE(STR(SUBSTR(STR(?decision_summary), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?decision_summary), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AgentDecisionRecords_WasOverridden a sh:NodeShape ;
    sh:targetClass pko-extension:AgentDecisionRecord ;
