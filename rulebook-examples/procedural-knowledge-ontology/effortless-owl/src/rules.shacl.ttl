    OPTIONAL { $this effortless-ntwf:violatesSeparationOfDuties ?violates_separation_of_duties . }
                BIND(IF(COALESCE(?violates_separation_of_duties, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_SelfWitnessedVerificationCount" ;
        sh:prefixes effortless-ntwf: ;
