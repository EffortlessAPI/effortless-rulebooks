                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_AgeDays" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ageDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?sent_at) + FLOOR((153 * (MONTH(?sent_at) + 12 * FLOOR((14 - MONTH(?sent_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 4) - FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 100) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsWithinRetentionWindow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWithinRetentionWindow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:ageDays ?age_days . }
    OPTIONAL { $this effortless-ntwf:policyRetentionDays ?policy_retention_days . }
                BIND((COALESCE(?age_days, 0) <= COALESCE(?policy_retention_days, 0)) AS ?_result)
            }
        """ ;
    ] ;
