    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:namespaceIsHttp ?namespace_is_http . }
                BIND((COALESCE(?namespace_is_http, false) && COALESCE((COALESCE(?namespace_http_status, 0) = 200), false)) AS ?_result)
            }
