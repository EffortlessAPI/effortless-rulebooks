            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:stepWhenStale ?_result .
            }
            WHERE {
    $this a pko-extension:OperationalBinding .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isStaleAndAuthoritative ?is_stale_and_authoritative . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . }
                BIND(IF(COALESCE(?is_stale_and_authoritative, false), ?step, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OperationalBindings_ResourceIsApproved a sh:NodeShape ;
    sh:targetClass pko-extension:OperationalBinding ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_ResourceIsApproved" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:resourceIsApproved ?_result .
            }
            WHERE {
    $this a pko-extension:OperationalBinding .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resource ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:Resources . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isApprovedSource ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OperationalBindings_IsUsableForDrafting a sh:NodeShape ;
    sh:targetClass pko-extension:OperationalBinding ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_IsUsableForDrafting" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUsableForDrafting ?_result .
            }
            WHERE {
    $this a pko-extension:OperationalBinding .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isFresh ?is_fresh . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resourceIsApproved ?resource_is_approved . }
                BIND((COALESCE(?resource_is_approved, false) && COALESCE(?is_fresh, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OperationalBindings_StepWhenUnusable a sh:NodeShape ;
    sh:targetClass pko-extension:OperationalBinding ;
