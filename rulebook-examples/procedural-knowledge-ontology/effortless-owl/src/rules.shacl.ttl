pko-native-procedural-knowledge-rulebook-shapes:AiAdoptionInitiatives_ReviewedOutputCount a sh:NodeShape ;
    sh:targetClass pko-extension:AiAdoptionInitiative ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_ReviewedOutputCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:reviewedOutputCount ?_result .
            }
            WHERE {
    $this a pko-extension:AiAdoptionInitiative .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AiAdoptionInitiative .
                    ?child a pko-extension:AssistantAnswer .
                    ?child pko-native-procedural-knowledge-rulebook:reviewedForInitiative $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
