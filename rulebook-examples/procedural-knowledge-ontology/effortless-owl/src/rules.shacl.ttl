                $this pko-native-procedural-knowledge-rulebook:controlBreachCount ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:ProcedureExecution .
                    ?child a pko:StepExecution .
                    ?child pko-native-procedural-knowledge-rulebook:controlBreachExecutionKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:procedureExecutionId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_LateStepCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_LateStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:lateStepCount ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:ProcedureExecution .
                    ?child a pko:StepExecution .
                    ?child pko-native-procedural-knowledge-rulebook:lateExecutionKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:procedureExecutionId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_IsStructurallyComplete a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_IsStructurallyComplete" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isStructurallyComplete ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:completedStepCount ?completed_step_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:expectedStepCount ?expected_step_count . }
                BIND((COALESCE(?completed_step_count, 0) >= COALESCE(?expected_step_count, 0)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_DivergedFromSpecification a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_DivergedFromSpecification" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:divergedFromSpecification ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:controlBreachCount ?control_breach_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isStructurallyComplete ?is_structurally_complete . }
                BIND((COALESCE((!(COALESCE(?is_structurally_complete, false))), false) || COALESCE((COALESCE(?control_breach_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_AllBlockingControlsEvaluated a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AllBlockingControlsEvaluated" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:allBlockingControlsEvaluated ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:unevaluatedBlockingTotal ?unevaluated_blocking_total . }
                BIND((COALESCE(?unevaluated_blocking_total, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_UnevaluatedBlockingTotal a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_UnevaluatedBlockingTotal" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:unevaluatedBlockingTotal ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:ProcedureExecution .
                    ?child a pko:StepExecution .
                    ?child pko-native-procedural-knowledge-rulebook:unevaluatedBlockingExecutionKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:procedureExecutionId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_SeparationOfDutiesHeld a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SeparationOfDutiesHeld" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:separationOfDutiesHeld ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:separationViolationCount ?separation_violation_count . }
                BIND((COALESCE(?separation_violation_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_SeparationViolationCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SeparationViolationCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:separationViolationCount ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:ProcedureExecution .
                    ?child a pko:StepExecution .
                    ?child pko-native-procedural-knowledge-rulebook:separationViolationExecutionKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:procedureExecutionId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_IsAttestationReady a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_IsAttestationReady" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isAttestationReady ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:allBlockingControlsEvaluated ?all_blocking_controls_evaluated . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:divergedFromSpecification ?diverged_from_specification . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isStructurallyComplete ?is_structurally_complete . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:separationOfDutiesHeld ?separation_of_duties_held . }
                BIND((COALESCE(?is_structurally_complete, false) && COALESCE((!(COALESCE(?diverged_from_specification, false))), false) && COALESCE(?all_blocking_controls_evaluated, false) && COALESCE(?separation_of_duties_held, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_AttestationBlockerSummary a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AttestationBlockerSummary" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:attestationBlockerSummary ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAttestationReady ?is_attestation_ready . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isStructurallyComplete ?is_structurally_complete . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:separationViolationCount ?separation_violation_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:unevaluatedBlockingTotal ?unevaluated_blocking_total . }
                BIND(IF(COALESCE(?is_attestation_ready, false), "", IF(COALESCE((!(COALESCE(?is_structurally_complete, false))), false), "Incomplete: specified steps did not all complete.", IF(COALESCE((COALESCE(?separation_violation_count, 0) > 0), false), "Segregation of duties violated.", IF(COALESCE((COALESCE(?unevaluated_blocking_total, 0) > 0), false), "Blocking controls were never evaluated.", "Control breach recorded on one or more steps.")))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_ExecutedVersionIsFit a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ExecutedVersionIsFit" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:executedVersionIsFit ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:ProcedureVersions . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isFitToExecute ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_SignedAgainstUnfitVersion a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SignedAgainstUnfitVersion" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:signedAgainstUnfitVersion ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:executedVersionIsFit ?executed_version_is_fit . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:executionStatus ?execution_status . OPTIONAL { ?execution_status erb:key ?execution_status__key . } }
                BIND((COALESCE((COALESCE(?execution_status__key, COALESCE(IF(isIRI(?execution_status), REPLACE(STR(?execution_status), "^.*[#/]", ""), STR(?execution_status)), "")) = "Completed"), false) && COALESCE((!(COALESCE(?executed_version_is_fit, false))), false)) AS ?_result)
            }
        """ ;
    ] .
