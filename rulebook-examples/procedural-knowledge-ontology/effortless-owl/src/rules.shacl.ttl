    $this a pko-extension:KnowHowCarrier .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holderDepartureAt ?holder_departure_at . OPTIONAL { ?holder_departure_at erb:key ?holder_departure_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holderServiceStartedAt ?holder_service_started_at . OPTIONAL { ?holder_service_started_at erb:key ?holder_service_started_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE((COALESCE(?holder_service_started_at__key, COALESCE(IF(isIRI(?holder_service_started_at), REPLACE(STR(?holder_service_started_at), "^.*[#/]", ""), STR(?holder_service_started_at)), "")) = ""), false) || COALESCE((COALESCE(?holder_departure_at__key, COALESCE(IF(isIRI(?holder_departure_at), REPLACE(STR(?holder_departure_at), "^.*[#/]", ""), STR(?holder_departure_at)), "")) = ""), false)), false), 0, ((DAY(?holder_departure_at) + FLOOR((153 * (MONTH(?holder_departure_at) + 12 * FLOOR((14 - MONTH(?holder_departure_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?holder_departure_at) + 4800 - FLOOR((14 - MONTH(?holder_departure_at)) / 12)) + FLOOR((YEAR(?holder_departure_at) + 4800 - FLOOR((14 - MONTH(?holder_departure_at)) / 12)) / 4) - FLOOR((YEAR(?holder_departure_at) + 4800 - FLOOR((14 - MONTH(?holder_departure_at)) / 12)) / 100) + FLOOR((YEAR(?holder_departure_at) + 4800 - FLOOR((14 - MONTH(?holder_departure_at)) / 12)) / 400) - 32045) - (DAY(?holder_service_started_at) + FLOOR((153 * (MONTH(?holder_service_started_at) + 12 * FLOOR((14 - MONTH(?holder_service_started_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?holder_service_started_at) + 4800 - FLOOR((14 - MONTH(?holder_service_started_at)) / 12)) + FLOOR((YEAR(?holder_service_started_at) + 4800 - FLOOR((14 - MONTH(?holder_service_started_at)) / 12)) / 4) - FLOOR((YEAR(?holder_service_started_at) + 4800 - FLOOR((14 - MONTH(?holder_service_started_at)) / 12)) / 100) + FLOOR((YEAR(?holder_service_started_at) + 4800 - FLOOR((14 - MONTH(?holder_service_started_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowHowCarriers_HolderTenureYears a sh:NodeShape ;
    sh:targetClass pko-extension:KnowHowCarrier ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_HolderTenureYears" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:holderTenureYears ?_result .
            }
            WHERE {
    $this a pko-extension:KnowHowCarrier .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysServedToAsOf ?days_served_to_as_of . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysServedToDeparture ?days_served_to_departure . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysUntilHolderDeparture ?days_until_holder_departure . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holderDepartureAt ?holder_departure_at . OPTIONAL { ?holder_departure_at erb:key ?holder_departure_at__key . } }
                BIND((ROUND(xsd:double(IF(COALESCE((COALESCE((COALESCE(?holder_departure_at__key, COALESCE(IF(isIRI(?holder_departure_at), REPLACE(STR(?holder_departure_at), "^.*[#/]", ""), STR(?holder_departure_at)), "")) != ""), false) && COALESCE((COALESCE(?days_until_holder_departure, 0) < 0), false)), false), ?days_served_to_departure, ?days_served_to_as_of) / 365) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double)) AS ?_result)
            }
        """ ;
    ] .
