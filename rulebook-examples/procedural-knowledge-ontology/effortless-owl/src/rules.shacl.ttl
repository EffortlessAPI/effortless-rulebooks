    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_SmeApprovalCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:smeApprovalCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                    ?child a pko-extension:RepresentationReview .
                    ?child pko-native-procedural-knowledge-rulebook:procedureVersion $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:reviewPurpose ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:reviewerIsAffectedSme ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:decision ?c6 . OPTIONAL { ?c6 erb:key ?c6__key . } }
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "RepresentationApproval"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    FILTER((COALESCE(?c6__key, STR(?c6)) = "Approved"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
