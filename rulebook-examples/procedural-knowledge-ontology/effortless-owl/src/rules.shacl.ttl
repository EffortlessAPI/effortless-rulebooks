    sh:targetClass pko-extension:ConsumerSystemSync ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_IsBehindCanonicalVersion" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isBehindCanonicalVersion ?_result .
            }
            WHERE {
    $this a pko-extension:ConsumerSystemSync .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:canonicalVersion ?canonical_version . OPTIONAL { ?canonical_version erb:key ?canonical_version__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:loadedVersion ?loaded_version . }
                BIND((COALESCE((COALESCE(?canonical_version__key, COALESCE(IF(isIRI(?canonical_version), REPLACE(STR(?canonical_version), "^.*[#/]", ""), STR(?canonical_version)), "")) != ""), false) && COALESCE(COALESCE((?loaded_version != ?canonical_version), !((!BOUND(?loaded_version) || STR(?loaded_version) = "") && (!BOUND(?canonical_version) || STR(?canonical_version) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ConsumerSystemSyncs_PredatesVersionChange a sh:NodeShape ;
