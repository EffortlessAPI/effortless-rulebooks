                $this pko-native-procedural-knowledge-rulebook:isNeededDeprecatedTermNotRehomed ?_result .
            }
            WHERE {
    $this a pko-extension:ExternalStandardTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deprecatedBySource ?deprecated_by_source . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelStillNeedsTerm ?model_still_needs_term . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rehomedAsTerm ?rehomed_as_term . OPTIONAL { ?rehomed_as_term erb:key ?rehomed_as_term__key . } }
                BIND((COALESCE(?deprecated_by_source, false) && COALESCE(?model_still_needs_term, false) && COALESCE((COALESCE(?rehomed_as_term__key, COALESCE(IF(isIRI(?rehomed_as_term), REPLACE(STR(?rehomed_as_term), "^.*[#/]", ""), STR(?rehomed_as_term)), "")) = ""), false)) AS ?_result)
            }
