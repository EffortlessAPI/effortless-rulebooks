    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceAgentKind ?source_agent_kind . OPTIONAL { ?source_agent_kind erb:key ?source_agent_kind__key . } }
                BIND((COALESCE(?source_agent_kind__key, COALESCE(IF(isIRI(?source_agent_kind), REPLACE(STR(?source_agent_kind), "^.*[#/]", ""), STR(?source_agent_kind)), "")) = "Human") AS ?_result)
            }
        """ ;
