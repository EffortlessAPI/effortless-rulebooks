            }
            WHERE {
    $this a pko-extension:KnowledgeTransfer .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowHow ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:KnowHowCarrier . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:topic_KnowHowCarriers ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for KnowledgeWorkforcePositions ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeWorkforcePositions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeWorkforcePosition ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeWorkforcePositions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeWorkforcePosition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:discipline ?discipline . OPTIONAL { ?discipline erb:key ?discipline__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:organization ?organization . OPTIONAL { ?organization erb:key ?organization__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?organization__key, IF(isIRI(?organization), REPLACE(STR(?organization), "^.*[#/]", ""), STR(?organization))), ""), " ", COALESCE(COALESCE(?discipline__key, IF(isIRI(?discipline), REPLACE(STR(?discipline), "^.*[#/]", ""), STR(?discipline))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for LearningActivities ===
pko-native-procedural-knowledge-rulebook-shapes:LearningActivities_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:LearningActivities ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LearningActivities_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:LearningActivities .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:activityKind ?activity_kind . OPTIONAL { ?activity_kind erb:key ?activity_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:occurredAt ?occurred_at . OPTIONAL { ?occurred_at erb:key ?occurred_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?activity_kind__key, IF(isIRI(?activity_kind), REPLACE(STR(?activity_kind), "^.*[#/]", ""), STR(?activity_kind))), ""), " / ", COALESCE(REPLACE(COALESCE(?occurred_at__key, IF(isIRI(?occurred_at), REPLACE(STR(?occurred_at), "^.*[#/]", ""), STR(?occurred_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for LevelCaptureStrategies ===
pko-native-procedural-knowledge-rulebook-shapes:LevelCaptureStrategies_Name a sh:NodeShape ;
    sh:targetClass pko-extension:LevelCaptureStrategy ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LevelCaptureStrategies_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:LevelCaptureStrategy .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:description ?description . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeForm ?knowledge_form . OPTIONAL { ?knowledge_form erb:key ?knowledge_form__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:level ?level . OPTIONAL { ?level erb:key ?level__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?level__key, IF(isIRI(?level), REPLACE(STR(?level), "^.*[#/]", ""), STR(?level))), ""), " ", COALESCE(COALESCE(?knowledge_form__key, IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?description), 1, 40)), REPLACE(STR(SUBSTR(STR(?description), 1, 40)), "^.*[#/]", ""), STR(SUBSTR(STR(?description), 1, 40))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:LevelCaptureStrategies_ContradictsKnowledgeForm a sh:NodeShape ;
    sh:targetClass pko-extension:LevelCaptureStrategy ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LevelCaptureStrategies_ContradictsKnowledgeForm" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:contradictsKnowledgeForm ?_result .
            }
            WHERE {
    $this a pko-extension:LevelCaptureStrategy .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeForm ?knowledge_form . OPTIONAL { ?knowledge_form erb:key ?knowledge_form__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:transferMode ?transfer_mode . OPTIONAL { ?transfer_mode erb:key ?transfer_mode__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?knowledge_form__key, COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), "")) = "Tacit"), false) && COALESCE((COALESCE(?transfer_mode__key, COALESCE(IF(isIRI(?transfer_mode), REPLACE(STR(?transfer_mode), "^.*[#/]", ""), STR(?transfer_mode)), "")) = "Codified"), false)), false) || COALESCE((COALESCE((COALESCE(?knowledge_form__key, COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), "")) = "Explicit"), false) && COALESCE((COALESCE(?transfer_mode__key, COALESCE(IF(isIRI(?transfer_mode), REPLACE(STR(?transfer_mode), "^.*[#/]", ""), STR(?transfer_mode)), "")) = "InPerson"), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for LevelPyramidQuestions ===
pko-native-procedural-knowledge-rulebook-shapes:LevelPyramidQuestions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:LevelPyramidQuestion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LevelPyramidQuestions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:LevelPyramidQuestion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:level ?level . OPTIONAL { ?level erb:key ?level__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:questionKind ?question_kind . OPTIONAL { ?question_kind erb:key ?question_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?level__key, IF(isIRI(?level), REPLACE(STR(?level), "^.*[#/]", ""), STR(?level))), ""), " answers ", COALESCE(COALESCE(?question_kind__key, IF(isIRI(?question_kind), REPLACE(STR(?question_kind), "^.*[#/]", ""), STR(?question_kind))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for LifecycleStatuses ===
pko-native-procedural-knowledge-rulebook-shapes:LifecycleStatuses_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:LifecycleStatuses ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LifecycleStatuses_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:LifecycleStatuses .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:LifecycleStatuses_VersionUseCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:LifecycleStatuses ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LifecycleStatuses_VersionUseCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:versionUseCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:LifecycleStatuses .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:LifecycleStatuses .
                    ?child a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
                    ?child pko-native-procedural-knowledge-rulebook:status $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:LifecycleStatuses_ExecutionUseCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:LifecycleStatuses ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LifecycleStatuses_ExecutionUseCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:executionUseCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:LifecycleStatuses .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-native-procedural-knowledge-rulebook:LifecycleStatuses .
                    ?child a pko:ProcedureExecution .
                    ?child pko-native-procedural-knowledge-rulebook:executionStatus $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:LifecycleStatuses_IsNonPkoStatusInUse a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:LifecycleStatuses ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LifecycleStatuses_IsNonPkoStatusInUse" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isNonPkoStatusInUse ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:LifecycleStatuses .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:executionUseCount ?execution_use_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isPkoStatus ?is_pko_status . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:versionUseCount ?version_use_count . }
                BIND((COALESCE((COALESCE(?is_pko_status, false) = false), false) && COALESCE((COALESCE((?version_use_count + ?execution_use_count), 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for LockDevices ===
pko-native-procedural-knowledge-rulebook-shapes:LockDevices_Name a sh:NodeShape ;
    sh:targetClass pko-industry:Lock ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LockDevices_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-industry:Lock .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Rules for MachineEnergySources ===
pko-native-procedural-knowledge-rulebook-shapes:MachineEnergySources_Name a sh:NodeShape ;
    sh:targetClass pko-extension:MachineEnergySource ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineEnergySources_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:MachineEnergySource .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:energySource ?energy_source . OPTIONAL { ?energy_source erb:key ?energy_source__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:machine ?machine . OPTIONAL { ?machine erb:key ?machine__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?machine__key, IF(isIRI(?machine), REPLACE(STR(?machine), "^.*[#/]", ""), STR(?machine))), ""), " / ", COALESCE(COALESCE(?energy_source__key, IF(isIRI(?energy_source), REPLACE(STR(?energy_source), "^.*[#/]", ""), STR(?energy_source))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MachineEnergySources_MachineProcedureVersion a sh:NodeShape ;
    sh:targetClass pko-extension:MachineEnergySource ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineEnergySources_MachineProcedureVersion" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:machineProcedureVersion ?_result .
            }
            WHERE {
    $this a pko-extension:MachineEnergySource .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:machine ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-industry:Machine . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:governingProcedureVersion ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MachineEnergySources_IsolationStepCount a sh:NodeShape ;
    sh:targetClass pko-extension:MachineEnergySource ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineEnergySources_IsolationStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isolationStepCount ?_result .
            }
            WHERE {
    $this a pko-extension:MachineEnergySource .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:MachineEnergySource .
                    ?child a p-plan:Step .
                    ?child pko-native-procedural-knowledge-rulebook:isolatesEnergySource ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:energySource ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:procedureVersion ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:machineProcedureVersion ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MachineEnergySources_IsUnisolatedEnergySource a sh:NodeShape ;
    sh:targetClass pko-extension:MachineEnergySource ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineEnergySources_IsUnisolatedEnergySource" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnisolatedEnergySource ?_result .
            }
            WHERE {
    $this a pko-extension:MachineEnergySource .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isolationStepCount ?isolation_step_count . }
                BIND((COALESCE(?isolation_step_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:MachineEnergySources_UnisolatedMachineKey a sh:NodeShape ;
    sh:targetClass pko-extension:MachineEnergySource ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineEnergySources_UnisolatedMachineKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:unisolatedMachineKey ?_result .
            }
            WHERE {
    $this a pko-extension:MachineEnergySource .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isUnisolatedEnergySource ?is_unisolated_energy_source . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:machine ?machine . }
                BIND(IF(COALESCE(?is_unisolated_energy_source, false), ?machine, "") AS ?_result)
            }
        """ ;
    ] .

