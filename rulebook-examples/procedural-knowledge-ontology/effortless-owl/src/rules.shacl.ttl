    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_SuiteLagsRelease" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:suiteLagsRelease ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:schemaAdditionCount ?schema_addition_count . }
    OPTIONAL { $this effortless-ntwf:suiteUpdateCount ?suite_update_count . }
                BIND((COALESCE((COALESCE(?schema_addition_count, 0) > 0), false) && COALESCE((COALESCE(?suite_update_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_IsUntaggedRelease" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUntaggedRelease ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
    OPTIONAL { $this effortless-ntwf:rulebookCommit ?rulebook_commit . OPTIONAL { ?rulebook_commit effortless-ntwf:__key ?rulebook_commit__key . } }
                BIND((COALESCE((COALESCE(?governed_model__key, COALESCE(IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model)), "")) != ""), false) && COALESCE((COALESCE(?rulebook_commit__key, COALESCE(IF(isIRI(?rulebook_commit), REPLACE(STR(?rulebook_commit), "^.*[#/]", ""), STR(?rulebook_commit)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_PublishedWithoutApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:publishedWithoutApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:approvedByAgent ?approved_by_agent . OPTIONAL { ?approved_by_agent effortless-ntwf:__key ?approved_by_agent__key . } }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Released"), false) && COALESCE((COALESCE(?approved_by_agent__key, COALESCE(IF(isIRI(?approved_by_agent), REPLACE(STR(?approved_by_agent), "^.*[#/]", ""), STR(?approved_by_agent)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_ReleasedDespiteFailedValidation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:releasedDespiteFailedValidation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:validationFailureTotal ?validation_failure_total . }
                BIND((COALESCE(?validation_failure_total, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_ReleasedWithoutConsistencyCheck" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:releasedWithoutConsistencyCheck ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:consistentRunCount ?consistent_run_count . }
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
                BIND((COALESCE((COALESCE(?governed_model__key, COALESCE(IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model)), "")) != ""), false) && COALESCE((COALESCE(?consistent_run_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_PassedValidationAtRelease" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:passedValidationAtRelease ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:validationFailureTotal ?validation_failure_total . }
    OPTIONAL { $this effortless-ntwf:validationRunCount ?validation_run_count . }
                BIND((COALESCE((COALESCE(?validation_run_count, 0) > 0), false) && COALESCE((COALESCE(?validation_failure_total, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_CqCoverageDeclined" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cqCoverageDeclined ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:cqCoveragePercent ?cq_coverage_percent . }
    OPTIONAL { $this effortless-ntwf:cqRunCount ?cq_run_count . }
    OPTIONAL { $this effortless-ntwf:prevCqCoveragePercent ?prev_cq_coverage_percent . }
    OPTIONAL { $this effortless-ntwf:prevCqRunCount ?prev_cq_run_count . }
    OPTIONAL { $this effortless-ntwf:previousRelease ?previous_release . OPTIONAL { ?previous_release effortless-ntwf:__key ?previous_release__key . } }
                BIND((COALESCE((COALESCE(?previous_release__key, COALESCE(IF(isIRI(?previous_release), REPLACE(STR(?previous_release), "^.*[#/]", ""), STR(?previous_release)), "")) != ""), false) && COALESCE((COALESCE(?prev_cq_run_count, 0) > 0), false) && COALESCE((COALESCE(?cq_run_count, 0) > 0), false) && COALESCE((COALESCE(?cq_coverage_percent, 0) < COALESCE(?prev_cq_coverage_percent, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_HasBaselineRegression" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasBaselineRegression ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:regressedBaselineCount ?regressed_baseline_count . }
                BIND((COALESCE(?regressed_baseline_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_ReleasedWithoutCqTaskTest" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:releasedWithoutCqTaskTest ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:cqRunCount ?cq_run_count . }
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
                BIND((COALESCE((COALESCE(?governed_model__key, COALESCE(IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model)), "")) != ""), false) && COALESCE((COALESCE(?cq_run_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_WellFormedButRequirementsUnshown" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wellFormedButRequirementsUnshown ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:cqRunCount ?cq_run_count . }
    OPTIONAL { $this effortless-ntwf:validationRunCount ?validation_run_count . }
                BIND((COALESCE((COALESCE(?validation_run_count, 0) > 0), false) && COALESCE((COALESCE(?cq_run_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_IsNotScoredAgainstCriteria" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNotScoredAgainstCriteria ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
    OPTIONAL { $this effortless-ntwf:scoredCriterionCount ?scored_criterion_count . }
    OPTIONAL { $this effortless-ntwf:statedCriterionCount ?stated_criterion_count . }
                BIND((COALESCE((COALESCE(?governed_model__key, COALESCE(IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model)), "")) != ""), false) && COALESCE((COALESCE(?scored_criterion_count, 0) < COALESCE(?stated_criterion_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_IsReleasedWithoutLicenceOrPermanentId" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isReleasedWithoutLicenceOrPermanentId ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
    OPTIONAL { $this effortless-ntwf:license ?license . OPTIONAL { ?license effortless-ntwf:__key ?license__key . } }
    OPTIONAL { $this effortless-ntwf:permanentIri ?permanent_iri . OPTIONAL { ?permanent_iri effortless-ntwf:__key ?permanent_iri__key . } }
                BIND((COALESCE((COALESCE(?governed_model__key, COALESCE(IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?license__key, COALESCE(IF(isIRI(?license), REPLACE(STR(?license), "^.*[#/]", ""), STR(?license)), "")) = ""), false) || COALESCE((COALESCE(?permanent_iri__key, COALESCE(IF(isIRI(?permanent_iri), REPLACE(STR(?permanent_iri), "^.*[#/]", ""), STR(?permanent_iri)), "")) = ""), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RulebookTables ===
effortless-ntwf:RulebookTablesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RulebookTables ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
    OPTIONAL { $this effortless-ntwf:tableName ?table_name . }
                BIND(?table_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_FieldCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RulebookFields .
                    ?child effortless-ntwf:targetTable ?backfk .
                    $this effortless-ntwf:rulebookTableId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_PolicyCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AccessPolicies .
                    ?child effortless-ntwf:targetTable $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_IsUnsecured" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnsecured ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
    OPTIONAL { $this effortless-ntwf:policyCount ?policy_count . }
                BIND((COALESCE(?policy_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_DisagreeingSubstrateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:disagreeingSubstrateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TableConformance .
                    ?child effortless-ntwf:imperfectTableKey ?backfk .
                    $this effortless-ntwf:rulebookTableId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_HasMeasuredRows" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasMeasuredRows ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
    OPTIONAL { $this effortless-ntwf:measuredRowCount ?measured_row_count . }
                BIND((COALESCE(?measured_row_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_SemanticMappingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:semanticMappingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SemanticMappings .
                    ?child effortless-ntwf:sourcePath ?backfk .
                    $this effortless-ntwf:rulebookTableId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_MeaningIsOnlyTabular" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:meaningIsOnlyTabular ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
    OPTIONAL { $this effortless-ntwf:semanticMappingCount ?semantic_mapping_count . }
                BIND((COALESCE(?semantic_mapping_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_ExactMappingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:exactMappingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SemanticMappings .
                    ?child effortless-ntwf:sourcePath ?backfk .
                    $this effortless-ntwf:rulebookTableId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:mappingRelation ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER((STR(?c2) = "exact"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_AlignedMappingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:alignedMappingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SemanticMappings .
                    ?child effortless-ntwf:sourcePath ?backfk .
                    $this effortless-ntwf:rulebookTableId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:mappingRelation ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER((STR(?c2) = "aligned"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_IsUnalignedToStandard" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnalignedToStandard ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
    OPTIONAL { $this effortless-ntwf:alignedMappingCount ?aligned_mapping_count . }
    OPTIONAL { $this effortless-ntwf:exactMappingCount ?exact_mapping_count . }
                BIND((COALESCE((?exact_mapping_count + ?aligned_mapping_count), 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_SemanticTypeIriFieldCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:semanticTypeIriFieldCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RulebookFields .
                    ?child effortless-ntwf:targetTable ?backfk .
                    $this effortless-ntwf:rulebookTableId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:fieldName ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER((STR(?c2) = "SemanticTypeIri"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_LacksSemanticTypeConvention" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lacksSemanticTypeConvention ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
    OPTIONAL { $this effortless-ntwf:semanticTypeIriFieldCount ?semantic_type_iri_field_count . }
                BIND((COALESCE(?semantic_type_iri_field_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_IsUnsecuredGovernanceRecord" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnsecuredGovernanceRecord ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
    OPTIONAL { $this effortless-ntwf:policyCount ?policy_count . }
    OPTIONAL { $this effortless-ntwf:subjectArea ?subject_area . OPTIONAL { ?subject_area effortless-ntwf:__key ?subject_area__key . } }
                BIND((COALESCE((COALESCE(?subject_area__key, COALESCE(IF(isIRI(?subject_area), REPLACE(STR(?subject_area), "^.*[#/]", ""), STR(?subject_area)), "")) = "governance"), false) && COALESCE((COALESCE(?policy_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SchemeRefinements ===
effortless-ntwf:SchemeRefinementsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SchemeRefinements ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SchemeRefinements_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SchemeRefinements .
    OPTIONAL { $this effortless-ntwf:refinedAt ?refined_at . OPTIONAL { ?refined_at effortless-ntwf:__key ?refined_at__key . } }
    OPTIONAL { $this effortless-ntwf:vocabulary ?vocabulary . OPTIONAL { ?vocabulary effortless-ntwf:__key ?vocabulary__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?vocabulary__key, IF(isIRI(?vocabulary), REPLACE(STR(?vocabulary), "^.*[#/]", ""), STR(?vocabulary))), ""), " refined ", COALESCE(REPLACE(COALESCE(?refined_at__key, IF(isIRI(?refined_at), REPLACE(STR(?refined_at), "^.*[#/]", ""), STR(?refined_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SemanticMappings ===
effortless-ntwf:SemanticMappingsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SemanticMappings ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SemanticMappings_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SemanticMappings .
    OPTIONAL { $this effortless-ntwf:sourcePath ?source_path . OPTIONAL { ?source_path effortless-ntwf:__key ?source_path__key . } }
    OPTIONAL { $this effortless-ntwf:targetIri ?target_iri . OPTIONAL { ?target_iri effortless-ntwf:__key ?target_iri__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?source_path__key, IF(isIRI(?source_path), REPLACE(STR(?source_path), "^.*[#/]", ""), STR(?source_path))), ""), " -> ", COALESCE(COALESCE(?target_iri__key, IF(isIRI(?target_iri), REPLACE(STR(?target_iri), "^.*[#/]", ""), STR(?target_iri))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SemanticMappings_ReinventsStandardTerm" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reinventsStandardTerm ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SemanticMappings .
    OPTIONAL { $this effortless-ntwf:availableStandardIri ?available_standard_iri . OPTIONAL { ?available_standard_iri effortless-ntwf:__key ?available_standard_iri__key . } }
    OPTIONAL { $this effortless-ntwf:mappingRelation ?mapping_relation . OPTIONAL { ?mapping_relation effortless-ntwf:__key ?mapping_relation__key . } }
                BIND((COALESCE((COALESCE(?mapping_relation__key, COALESCE(IF(isIRI(?mapping_relation), REPLACE(STR(?mapping_relation), "^.*[#/]", ""), STR(?mapping_relation)), "")) = "extension"), false) && COALESCE((COALESCE(?available_standard_iri__key, COALESCE(IF(isIRI(?available_standard_iri), REPLACE(STR(?available_standard_iri), "^.*[#/]", ""), STR(?available_standard_iri)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SemanticMappings_IsNonResolvableTermIri" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNonResolvableTermIri ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SemanticMappings .
    OPTIONAL { $this effortless-ntwf:mappingRelation ?mapping_relation . OPTIONAL { ?mapping_relation effortless-ntwf:__key ?mapping_relation__key . } }
    OPTIONAL { $this effortless-ntwf:targetIri ?target_iri . }
                BIND((COALESCE((COALESCE(?mapping_relation__key, COALESCE(IF(isIRI(?mapping_relation), REPLACE(STR(?mapping_relation), "^.*[#/]", ""), STR(?mapping_relation)), "")) = "extension"), false) && COALESCE((SUBSTR(STR(?target_iri), 1, 4) != "http"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SendIntents ===
effortless-ntwf:SendIntentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SendIntents ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . OPTIONAL { ?message_template effortless-ntwf:__key ?message_template__key . } }
    OPTIONAL { $this effortless-ntwf:recipient ?recipient . OPTIONAL { ?recipient effortless-ntwf:__key ?recipient__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?recipient__key, IF(isIRI(?recipient), REPLACE(STR(?recipient), "^.*[#/]", ""), STR(?recipient))), ""), " / ", COALESCE(COALESCE(?message_template__key, IF(isIRI(?message_template), REPLACE(STR(?message_template), "^.*[#/]", ""), STR(?message_template))), ""), " / intent") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentPolicy" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentPolicy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:communicationPolicy ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentChannel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentChannel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:channel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_PolicyIsActive" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyIsActive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isActivePolicy ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentRequiresConsent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentRequiresConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:consentRequired ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RecipientHasChannelConsent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientHasChannelConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:hasSmsConsent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ConsentGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:consentGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentRequiresConsent ?intent_requires_consent . }
    OPTIONAL { $this effortless-ntwf:recipientHasChannelConsent ?recipient_has_channel_consent . }
                BIND((COALESCE((!(COALESCE(?intent_requires_consent, false))), false) || COALESCE(?recipient_has_channel_consent, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RecipientIsSmsReachable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientIsSmsReachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isSmsReachable ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RecipientIsEmailReachable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientIsEmailReachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isEmailReachable ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ReachabilityGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reachabilityGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentChannel ?intent_channel . OPTIONAL { ?intent_channel effortless-ntwf:__key ?intent_channel__key . } }
    OPTIONAL { $this effortless-ntwf:recipientIsEmailReachable ?recipient_is_email_reachable . }
    OPTIONAL { $this effortless-ntwf:recipientIsSmsReachable ?recipient_is_sms_reachable . }
                BIND(IF(COALESCE((COALESCE(?intent_channel__key, COALESCE(IF(isIRI(?intent_channel), REPLACE(STR(?intent_channel), "^.*[#/]", ""), STR(?intent_channel)), "")) = "SMS"), false), ?recipient_is_sms_reachable, ?recipient_is_email_reachable) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_PermissionGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:permissionGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:consentGatePassed ?consent_gate_passed . }
    OPTIONAL { $this effortless-ntwf:policyIsActive ?policy_is_active . }
    OPTIONAL { $this effortless-ntwf:reachabilityGatePassed ?reachability_gate_passed . }
                BIND((COALESCE(?policy_is_active, false) && COALESCE((COALESCE(?consent_gate_passed, false) && COALESCE(?reachability_gate_passed, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentQuietStartHour" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentQuietStartHour ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:quietHoursStartHour ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentQuietEndHour" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentQuietEndHour ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:quietHoursEndHour ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentPolicyHasQuietHours" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentPolicyHasQuietHours ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentQuietEndHour ?intent_quiet_end_hour . }
    OPTIONAL { $this effortless-ntwf:intentQuietStartHour ?intent_quiet_start_hour . }
                BIND((COALESCE(?intent_quiet_start_hour, 0) != COALESCE(?intent_quiet_end_hour, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentQuietWindowWraps" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentQuietWindowWraps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentQuietEndHour ?intent_quiet_end_hour . }
    OPTIONAL { $this effortless-ntwf:intentQuietStartHour ?intent_quiet_start_hour . }
                BIND((COALESCE(?intent_quiet_start_hour, 0) > COALESCE(?intent_quiet_end_hour, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentIsInsideQuietWindow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:intentIsInsideQuietWindow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentQuietEndHour ?intent_quiet_end_hour . }
    OPTIONAL { $this effortless-ntwf:intentQuietStartHour ?intent_quiet_start_hour . }
    OPTIONAL { $this effortless-ntwf:intentQuietWindowWraps ?intent_quiet_window_wraps . }
    OPTIONAL { $this effortless-ntwf:proposedSendAtLocalHour ?proposed_send_at_local_hour . }
                BIND(IF(COALESCE(?intent_quiet_window_wraps, false), (COALESCE((COALESCE(?proposed_send_at_local_hour, 0) >= COALESCE(?intent_quiet_start_hour, 0)), false) || COALESCE((COALESCE(?proposed_send_at_local_hour, 0) < COALESCE(?intent_quiet_end_hour, 0)), false)), (COALESCE((COALESCE(?proposed_send_at_local_hour, 0) >= COALESCE(?intent_quiet_start_hour, 0)), false) && COALESCE((COALESCE(?proposed_send_at_local_hour, 0) < COALESCE(?intent_quiet_end_hour, 0)), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_TimingGatePassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:timingGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentIsInsideQuietWindow ?intent_is_inside_quiet_window . }
    OPTIONAL { $this effortless-ntwf:intentPolicyHasQuietHours ?intent_policy_has_quiet_hours . }
                BIND((COALESCE((!(COALESCE(?intent_policy_has_quiet_hours, false))), false) || COALESCE((!(COALESCE(?intent_is_inside_quiet_window, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_HoursUntilWindowOpens" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hoursUntilWindowOpens ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentQuietEndHour ?intent_quiet_end_hour . }
    OPTIONAL { $this effortless-ntwf:proposedSendAtLocalHour ?proposed_send_at_local_hour . }
    OPTIONAL { $this effortless-ntwf:timingGatePassed ?timing_gate_passed . }
                BIND(ROUND(IF(COALESCE(?timing_gate_passed, false), 0, IF(COALESCE((COALESCE(?proposed_send_at_local_hour, 0) < COALESCE(?intent_quiet_end_hour, 0)), false), (?intent_quiet_end_hour - ?proposed_send_at_local_hour), ((24 - ?proposed_send_at_local_hour) + ?intent_quiet_end_hour)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentMaxMessageLength" ;
