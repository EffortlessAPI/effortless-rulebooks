            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:feedbackCount ?feedback_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasStepDeviation ?has_step_deviation . }
                BIND((COALESCE(?has_step_deviation, false) && COALESCE((COALESCE(?feedback_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
