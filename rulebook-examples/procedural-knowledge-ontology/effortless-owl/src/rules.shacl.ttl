            WHERE {
    $this a effortless-ntwf:OnboardingRecords .
                OPTIONAL { $this effortless-ntwf:procedure ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Procedures ; effortless-ntwf:procedureId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:departedOnlyKnowHowCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OnboardingRecords_IsStartingFromNothing" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStartingFromNothing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OnboardingRecords .
    OPTIONAL { $this effortless-ntwf:procedureDepartedOnlyCount ?procedure_departed_only_count . }
    OPTIONAL { $this effortless-ntwf:procedureRepositoryEntryCount ?procedure_repository_entry_count . }
                BIND((COALESCE((COALESCE(?procedure_repository_entry_count, 0) = 0), false) && COALESCE((COALESCE(?procedure_departed_only_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for OntologyProfiles ===
effortless-ntwf:OntologyProfilesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OntologyProfiles ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
    OPTIONAL { $this effortless-ntwf:label ?label . OPTIONAL { ?label effortless-ntwf:__key ?label__key . } }
    OPTIONAL { $this effortless-ntwf:version ?version . OPTIONAL { ?version effortless-ntwf:__key ?version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), ""), " ", COALESCE(COALESCE(?version__key, IF(isIRI(?version), REPLACE(STR(?version), "^.*[#/]", ""), STR(?version))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_MappingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:mappingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SemanticMappings .
                    ?child effortless-ntwf:ontologyProfile $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_DaysSinceLastRevision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceLastRevision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:lastRevisedAt ?last_revised_at . OPTIONAL { ?last_revised_at effortless-ntwf:__key ?last_revised_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?last_revised_at__key, COALESCE(IF(isIRI(?last_revised_at), REPLACE(STR(?last_revised_at), "^.*[#/]", ""), STR(?last_revised_at)), "")) = ""), false), 0, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_revised_at) + FLOOR((153 * (MONTH(?last_revised_at) + 12 * FLOOR((14 - MONTH(?last_revised_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_revised_at) + 4800 - FLOOR((14 - MONTH(?last_revised_at)) / 12)) + FLOOR((YEAR(?last_revised_at) + 4800 - FLOOR((14 - MONTH(?last_revised_at)) / 12)) / 4) - FLOOR((YEAR(?last_revised_at) + 4800 - FLOOR((14 - MONTH(?last_revised_at)) / 12)) / 100) + FLOOR((YEAR(?last_revised_at) + 4800 - FLOOR((14 - MONTH(?last_revised_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_DaysSinceMajorRevision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceMajorRevision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:lastMajorRevisionAt ?last_major_revision_at . OPTIONAL { ?last_major_revision_at effortless-ntwf:__key ?last_major_revision_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?last_major_revision_at__key, COALESCE(IF(isIRI(?last_major_revision_at), REPLACE(STR(?last_major_revision_at), "^.*[#/]", ""), STR(?last_major_revision_at)), "")) = ""), false), 0, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_major_revision_at) + FLOOR((153 * (MONTH(?last_major_revision_at) + 12 * FLOOR((14 - MONTH(?last_major_revision_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_major_revision_at) + 4800 - FLOOR((14 - MONTH(?last_major_revision_at)) / 12)) + FLOOR((YEAR(?last_major_revision_at) + 4800 - FLOOR((14 - MONTH(?last_major_revision_at)) / 12)) / 4) - FLOOR((YEAR(?last_major_revision_at) + 4800 - FLOOR((14 - MONTH(?last_major_revision_at)) / 12)) / 100) + FLOOR((YEAR(?last_major_revision_at) + 4800 - FLOOR((14 - MONTH(?last_major_revision_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_DaysSinceDependencyReviewed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceDependencyReviewed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:dependencyReviewedAt ?dependency_reviewed_at . OPTIONAL { ?dependency_reviewed_at effortless-ntwf:__key ?dependency_reviewed_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?dependency_reviewed_at__key, COALESCE(IF(isIRI(?dependency_reviewed_at), REPLACE(STR(?dependency_reviewed_at), "^.*[#/]", ""), STR(?dependency_reviewed_at)), "")) = ""), false), 0, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?dependency_reviewed_at) + FLOOR((153 * (MONTH(?dependency_reviewed_at) + 12 * FLOOR((14 - MONTH(?dependency_reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?dependency_reviewed_at) + 4800 - FLOOR((14 - MONTH(?dependency_reviewed_at)) / 12)) + FLOOR((YEAR(?dependency_reviewed_at) + 4800 - FLOOR((14 - MONTH(?dependency_reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?dependency_reviewed_at) + 4800 - FLOOR((14 - MONTH(?dependency_reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?dependency_reviewed_at) + 4800 - FLOOR((14 - MONTH(?dependency_reviewed_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_RecentDeprecationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recentDeprecationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ExternalStandardTerms .
                    ?child effortless-ntwf:ontologyProfile $this .
                    OPTIONAL { ?child effortless-ntwf:isRecentDeprecation ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_RequiresFrequentReview" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requiresFrequentReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
    OPTIONAL { $this effortless-ntwf:daysSinceMajorRevision ?days_since_major_revision . }
    OPTIONAL { $this effortless-ntwf:lastMajorRevisionAt ?last_major_revision_at . OPTIONAL { ?last_major_revision_at effortless-ntwf:__key ?last_major_revision_at__key . } }
    OPTIONAL { $this effortless-ntwf:recentDeprecationCount ?recent_deprecation_count . }
                BIND((COALESCE((COALESCE(?recent_deprecation_count, 0) >= 2), false) || COALESCE((COALESCE((COALESCE(?last_major_revision_at__key, COALESCE(IF(isIRI(?last_major_revision_at), REPLACE(STR(?last_major_revision_at), "^.*[#/]", ""), STR(?last_major_revision_at)), "")) != ""), false) && COALESCE((COALESCE(?days_since_major_revision, 0) < 730), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_ChangeRateProfile" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:changeRateProfile ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
    OPTIONAL { $this effortless-ntwf:daysSinceLastRevision ?days_since_last_revision . }
    OPTIONAL { $this effortless-ntwf:daysSinceMajorRevision ?days_since_major_revision . }
    OPTIONAL { $this effortless-ntwf:lastMajorRevisionAt ?last_major_revision_at . OPTIONAL { ?last_major_revision_at effortless-ntwf:__key ?last_major_revision_at__key . } }
    OPTIONAL { $this effortless-ntwf:lastRevisedAt ?last_revised_at . OPTIONAL { ?last_revised_at effortless-ntwf:__key ?last_revised_at__key . } }
    OPTIONAL { $this effortless-ntwf:recentDeprecationCount ?recent_deprecation_count . }
                BIND(IF(COALESCE((COALESCE(?recent_deprecation_count, 0) >= 2), false), "FrequentDeprecation", IF(COALESCE((COALESCE((COALESCE(?last_major_revision_at__key, COALESCE(IF(isIRI(?last_major_revision_at), REPLACE(STR(?last_major_revision_at), "^.*[#/]", ""), STR(?last_major_revision_at)), "")) != ""), false) && COALESCE((COALESCE(?days_since_major_revision, 0) < 730), false)), false), "RecentMajorRevision", IF(COALESCE((COALESCE((COALESCE(?last_revised_at__key, COALESCE(IF(isIRI(?last_revised_at), REPLACE(STR(?last_revised_at), "^.*[#/]", ""), STR(?last_revised_at)), "")) != ""), false) && COALESCE((COALESCE(?days_since_last_revision, 0) > 3650), false)), false), "Dormant", "Unassessed"))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_IsReviewOverdueForChangeRate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isReviewOverdueForChangeRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
    OPTIONAL { $this effortless-ntwf:daysSinceDependencyReviewed ?days_since_dependency_reviewed . }
    OPTIONAL { $this effortless-ntwf:dependencyReviewedAt ?dependency_reviewed_at . OPTIONAL { ?dependency_reviewed_at effortless-ntwf:__key ?dependency_reviewed_at__key . } }
    OPTIONAL { $this effortless-ntwf:requiresFrequentReview ?requires_frequent_review . }
                BIND((COALESCE(?requires_frequent_review, false) && COALESCE((COALESCE((COALESCE(?dependency_reviewed_at__key, COALESCE(IF(isIRI(?dependency_reviewed_at), REPLACE(STR(?dependency_reviewed_at), "^.*[#/]", ""), STR(?dependency_reviewed_at)), "")) = ""), false) || COALESCE((COALESCE(?days_since_dependency_reviewed, 0) > 180), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_PrerequisiteAdoptedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:prerequisiteAdoptedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
                OPTIONAL { $this effortless-ntwf:prerequisiteProfile ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:OntologyProfiles ; effortless-ntwf:ontologyProfileId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:adoptedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_SkipsAdoptionPath" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:skipsAdoptionPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OntologyProfiles .
    OPTIONAL { $this effortless-ntwf:adoptedAt ?adopted_at . }
    OPTIONAL { $this effortless-ntwf:adoptionStage ?adoption_stage . }
    OPTIONAL { $this effortless-ntwf:prerequisiteAdoptedAt ?prerequisite_adopted_at . OPTIONAL { ?prerequisite_adopted_at effortless-ntwf:__key ?prerequisite_adopted_at__key . } }
    OPTIONAL { $this effortless-ntwf:prerequisiteProfile ?prerequisite_profile . OPTIONAL { ?prerequisite_profile effortless-ntwf:__key ?prerequisite_profile__key . } }
                BIND((COALESCE((COALESCE(?adoption_stage, 0) > 1), false) && COALESCE((COALESCE((COALESCE(?prerequisite_profile__key, COALESCE(IF(isIRI(?prerequisite_profile), REPLACE(STR(?prerequisite_profile), "^.*[#/]", ""), STR(?prerequisite_profile)), "")) = ""), false) || COALESCE((COALESCE(?prerequisite_adopted_at__key, COALESCE(IF(isIRI(?prerequisite_adopted_at), REPLACE(STR(?prerequisite_adopted_at), "^.*[#/]", ""), STR(?prerequisite_adopted_at)), "")) = ""), false) || COALESCE(COALESCE((?prerequisite_adopted_at > ?adopted_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for OperationalBindings ===
effortless-ntwf:OperationalBindingsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OperationalBindings ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:recordOrSchemaKey ?record_or_schema_key . OPTIONAL { ?record_or_schema_key effortless-ntwf:__key ?record_or_schema_key__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?record_or_schema_key__key, IF(isIRI(?record_or_schema_key), REPLACE(STR(?record_or_schema_key), "^.*[#/]", ""), STR(?record_or_schema_key))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_AgeMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ageMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:lastObservedAt ?last_observed_at . }
                BIND(ROUND(((((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_observed_at) + FLOOR((153 * (MONTH(?last_observed_at) + 12 * FLOOR((14 - MONTH(?last_observed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_observed_at) + 4800 - FLOOR((14 - MONTH(?last_observed_at)) / 12)) + FLOOR((YEAR(?last_observed_at) + 4800 - FLOOR((14 - MONTH(?last_observed_at)) / 12)) / 4) - FLOOR((YEAR(?last_observed_at) + 4800 - FLOOR((14 - MONTH(?last_observed_at)) / 12)) / 100) + FLOOR((YEAR(?last_observed_at) + 4800 - FLOOR((14 - MONTH(?last_observed_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?as_of_instant) * 3600 + MINUTES(?as_of_instant) * 60 + SECONDS(?as_of_instant)) - (HOURS(?last_observed_at) * 3600 + MINUTES(?last_observed_at) * 60 + SECONDS(?last_observed_at))) / 60)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_IsFresh" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFresh ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:ageMinutes ?age_minutes . }
    OPTIONAL { $this effortless-ntwf:freshnessSlaMinutes ?freshness_sla_minutes . }
                BIND((COALESCE(?age_minutes, 0) <= COALESCE(?freshness_sla_minutes, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_StaleBindingStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:staleBindingStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isFresh ?is_fresh . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE((!(COALESCE(?is_fresh, false))), false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_AuthoritativeStaleStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:authoritativeStaleStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isAuthoritative ?is_authoritative . }
    OPTIONAL { $this effortless-ntwf:isFresh ?is_fresh . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE((COALESCE((!(COALESCE(?is_fresh, false))), false) && COALESCE(?is_authoritative, false)), false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_IsStaleAndAuthoritative" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStaleAndAuthoritative ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isAuthoritative ?is_authoritative . }
    OPTIONAL { $this effortless-ntwf:isFresh ?is_fresh . }
                BIND((COALESCE(?is_authoritative, false) && COALESCE((!(COALESCE(?is_fresh, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_StepWhenStale" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepWhenStale ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isStaleAndAuthoritative ?is_stale_and_authoritative . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_stale_and_authoritative, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_ResourceIsApproved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:resourceIsApproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
                OPTIONAL { $this effortless-ntwf:resource ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Resources ; effortless-ntwf:resourceId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isApprovedSource ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_IsUsableForDrafting" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUsableForDrafting ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isFresh ?is_fresh . }
    OPTIONAL { $this effortless-ntwf:resourceIsApproved ?resource_is_approved . }
                BIND((COALESCE(?resource_is_approved, false) && COALESCE(?is_fresh, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_StepWhenUnusable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepWhenUnusable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isUsableForDrafting ?is_usable_for_drafting . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_usable_for_drafting, false), "", ?step) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Organizations ===
effortless-ntwf:OrganizationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Organizations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
    OPTIONAL { $this effortless-ntwf:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_FailedAiInitiativeCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:failedAiInitiativeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AiAdoptionInitiatives .
                    ?child effortless-ntwf:organization $this .
                    OPTIONAL { ?child effortless-ntwf:outcome ?c2 . }
                    FILTER((STR(?c2) = "Failed"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_OwnedProcedureCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ownedProcedureCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Procedures .
                    ?child effortless-ntwf:ownerOrganization $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_AiFailsForLackOfCapturedKnowledge" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:aiFailsForLackOfCapturedKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
    OPTIONAL { $this effortless-ntwf:failedAiInitiativeCount ?failed_ai_initiative_count . }
    OPTIONAL { $this effortless-ntwf:ownedProcedureCount ?owned_procedure_count . }
                BIND((COALESCE((COALESCE(?failed_ai_initiative_count, 0) > 0), false) && COALESCE((COALESCE(?owned_procedure_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_ProductDeliveryFunctionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:productDeliveryFunctionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SourcingFunctions .
                    ?child effortless-ntwf:clientOrganization $this .
                    OPTIONAL { ?child effortless-ntwf:deliversOwnProduct ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_ProviderHeldDeliveryMethodCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:providerHeldDeliveryMethodCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SourcingFunctions .
                    ?child effortless-ntwf:clientOrganization $this .
                    OPTIONAL { ?child effortless-ntwf:deliversOwnProduct ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:isMethodKnowledgeHeldOutside ?c4 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER(BOUND(?c4) && ?c4 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_IsHollowedOutFirm" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isHollowedOutFirm ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
    OPTIONAL { $this effortless-ntwf:productDeliveryFunctionCount ?product_delivery_function_count . }
    OPTIONAL { $this effortless-ntwf:providerHeldDeliveryMethodCount ?provider_held_delivery_method_count . }
                BIND((COALESCE((COALESCE(?product_delivery_function_count, 0) > 0), false) && COALESCE((COALESCE(?provider_held_delivery_method_count, 0) = COALESCE(?product_delivery_function_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_AuditFindingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:auditFindingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeAuditItems .
                    ?child effortless-ntwf:clientOrganization ?backfk .
                    $this effortless-ntwf:organizationId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:hasInternalShortfall ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_FilledKnowledgePositionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:filledKnowledgePositionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeWorkforcePositions .
                    ?child effortless-ntwf:organization $this .
                    OPTIONAL { ?child effortless-ntwf:status ?c2 . }
                    FILTER((STR(?c2) = "Filled"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_HasKnowledgeFindingsWithoutKnowledgeStaff" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasKnowledgeFindingsWithoutKnowledgeStaff ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
    OPTIONAL { $this effortless-ntwf:auditFindingCount ?audit_finding_count . }
    OPTIONAL { $this effortless-ntwf:filledKnowledgePositionCount ?filled_knowledge_position_count . }
                BIND((COALESCE((COALESCE(?audit_finding_count, 0) > 0), false) && COALESCE((COALESCE(?filled_knowledge_position_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_DepartedHolderKnowHowCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:departedHolderKnowHowCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowHowCarriers .
                    ?child effortless-ntwf:organization $this .
                    OPTIONAL { ?child effortless-ntwf:isHeldByDepartedHolder ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_LostDepartedKnowHowCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lostDepartedKnowHowCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowHowCarriers .
                    ?child effortless-ntwf:organization $this .
                    OPTIONAL { ?child effortless-ntwf:isHeldOnlyByDeparted ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_RetainedDepartedKnowHowPercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:retainedDepartedKnowHowPercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
    OPTIONAL { $this effortless-ntwf:departedHolderKnowHowCount ?departed_holder_know_how_count . }
    OPTIONAL { $this effortless-ntwf:lostDepartedKnowHowCount ?lost_departed_know_how_count . }
                BIND(IF(COALESCE((COALESCE(?departed_holder_know_how_count, 0) = 0), false), 100, (ROUND(((100 * (?departed_holder_know_how_count - ?lost_departed_know_how_count)) / ?departed_holder_know_how_count) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_MemoryLeavesWithStaff" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:memoryLeavesWithStaff ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
    OPTIONAL { $this effortless-ntwf:departedHolderKnowHowCount ?departed_holder_know_how_count . }
    OPTIONAL { $this effortless-ntwf:retainedDepartedKnowHowPercent ?retained_departed_know_how_percent . }
                BIND((COALESCE((COALESCE(?departed_holder_know_how_count, 0) > 0), false) && COALESCE((COALESCE(?retained_departed_know_how_percent, 0) < 100), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_CapturedOwnKnowHowCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:capturedOwnKnowHowCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowHowCarriers .
                    ?child effortless-ntwf:organization $this .
                    OPTIONAL { ?child effortless-ntwf:isCaptured ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_DocumentationEntryCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:documentationEntryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeRepositoryEntries .
                    ?child effortless-ntwf:ownerOrganization ?backfk .
                    $this effortless-ntwf:organizationId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_UnallocatedDocumentationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unallocatedDocumentationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeRepositoryEntries .
                    ?child effortless-ntwf:ownerOrganization ?backfk .
                    $this effortless-ntwf:organizationId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:authoredOnAllocatedTime ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(BOUND(?c2) && ?c2 = false)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_TransferGivenCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:transferGivenCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeTransfers .
                    ?child effortless-ntwf:fromOrganization ?backfk .
                    $this effortless-ntwf:organizationId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_UnallocatedTransferCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unallocatedTransferCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeTransfers .
                    ?child effortless-ntwf:fromOrganization ?backfk .
                    $this effortless-ntwf:organizationId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:onAllocatedTime ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(BOUND(?c2) && ?c2 = false)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_TreatsKnowledgeWorkAsUnvalued" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:treatsKnowledgeWorkAsUnvalued ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
    OPTIONAL { $this effortless-ntwf:documentationEntryCount ?documentation_entry_count . }
    OPTIONAL { $this effortless-ntwf:transferGivenCount ?transfer_given_count . }
    OPTIONAL { $this effortless-ntwf:unallocatedDocumentationCount ?unallocated_documentation_count . }
    OPTIONAL { $this effortless-ntwf:unallocatedTransferCount ?unallocated_transfer_count . }
                BIND((COALESCE((COALESCE((?documentation_entry_count + ?transfer_given_count), 0) > 0), false) && COALESCE(COALESCE(((2 * (?unallocated_documentation_count + ?unallocated_transfer_count)) > (?documentation_entry_count + ?transfer_given_count)), false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_PersonCarriedKnowHowCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:personCarriedKnowHowCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowHowCarriers .
                    ?child effortless-ntwf:organization $this .
                    OPTIONAL { ?child effortless-ntwf:carrierKind ?c2 . }
                    FILTER((STR(?c2) = "Person"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_FacilityCarriedKnowHowCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:facilityCarriedKnowHowCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowHowCarriers .
                    ?child effortless-ntwf:organization $this .
                    OPTIONAL { ?child effortless-ntwf:carrierKind ?c2 . }
                    FILTER((STR(?c2) = "Facility"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_SystemCarriedKnowHowCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:systemCarriedKnowHowCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowHowCarriers .
                    ?child effortless-ntwf:organization $this .
                    OPTIONAL { ?child effortless-ntwf:carrierKind ?c2 . }
                    FILTER((STR(?c2) = "System"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_HoldsKnowHowInPeoplePlantsAndSystems" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:holdsKnowHowInPeoplePlantsAndSystems ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
    OPTIONAL { $this effortless-ntwf:facilityCarriedKnowHowCount ?facility_carried_know_how_count . }
    OPTIONAL { $this effortless-ntwf:personCarriedKnowHowCount ?person_carried_know_how_count . }
    OPTIONAL { $this effortless-ntwf:systemCarriedKnowHowCount ?system_carried_know_how_count . }
                BIND((COALESCE((COALESCE(?person_carried_know_how_count, 0) > 0), false) && COALESCE((COALESCE(?facility_carried_know_how_count, 0) > 0), false) && COALESCE((COALESCE(?system_carried_know_how_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_StagedDeclineCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stagedDeclineCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CapabilityDeclines .
                    ?child effortless-ntwf:organization $this .
                    OPTIONAL { ?child effortless-ntwf:followsPrecedingStageDecline ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_ErodedInStages" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:erodedInStages ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
    OPTIONAL { $this effortless-ntwf:stagedDeclineCount ?staged_decline_count . }
                BIND((COALESCE(?staged_decline_count, 0) >= 2) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for PractitionerExpertise ===
effortless-ntwf:PractitionerExpertiseShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:PractitionerExpertise ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PractitionerExpertise_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PractitionerExpertise .
    OPTIONAL { $this effortless-ntwf:agent ?agent . OPTIONAL { ?agent effortless-ntwf:__key ?agent__key . } }
    OPTIONAL { $this effortless-ntwf:cue ?cue . OPTIONAL { ?cue effortless-ntwf:__key ?cue__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?agent__key, IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent))), ""), ": ", COALESCE(COALESCE(?cue__key, IF(isIRI(?cue), REPLACE(STR(?cue), "^.*[#/]", ""), STR(?cue))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PractitionerExpertise_KnowsMoreThanCanSay" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:knowsMoreThanCanSay ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PractitionerExpertise .
    OPTIONAL { $this effortless-ntwf:expertKind ?expert_kind . OPTIONAL { ?expert_kind effortless-ntwf:__key ?expert_kind__key . } }
    OPTIONAL { $this effortless-ntwf:reliableCallCount ?reliable_call_count . }
    OPTIONAL { $this effortless-ntwf:unstatedBasis ?unstated_basis . OPTIONAL { ?unstated_basis effortless-ntwf:__key ?unstated_basis__key . } }
                BIND((COALESCE((COALESCE(?expert_kind__key, COALESCE(IF(isIRI(?expert_kind), REPLACE(STR(?expert_kind), "^.*[#/]", ""), STR(?expert_kind)), "")) = "Detection"), false) && COALESCE((COALESCE(?unstated_basis__key, COALESCE(IF(isIRI(?unstated_basis), REPLACE(STR(?unstated_basis), "^.*[#/]", ""), STR(?unstated_basis)), "")) != ""), false) && COALESCE((COALESCE(?reliable_call_count, 0) >= 3), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PractitionerExpertise_IsUnexplainedForesight" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnexplainedForesight ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PractitionerExpertise .
    OPTIONAL { $this effortless-ntwf:expertKind ?expert_kind . OPTIONAL { ?expert_kind effortless-ntwf:__key ?expert_kind__key . } }
    OPTIONAL { $this effortless-ntwf:foresightConfirmed ?foresight_confirmed . }
    OPTIONAL { $this effortless-ntwf:unstatedBasis ?unstated_basis . OPTIONAL { ?unstated_basis effortless-ntwf:__key ?unstated_basis__key . } }
                BIND((COALESCE((COALESCE(?expert_kind__key, COALESCE(IF(isIRI(?expert_kind), REPLACE(STR(?expert_kind), "^.*[#/]", ""), STR(?expert_kind)), "")) = "DesignForesight"), false) && COALESCE((COALESCE(?unstated_basis__key, COALESCE(IF(isIRI(?unstated_basis), REPLACE(STR(?unstated_basis), "^.*[#/]", ""), STR(?unstated_basis)), "")) != ""), false) && COALESCE(?foresight_confirmed, false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for PrincipalAssignments ===
effortless-ntwf:PrincipalAssignmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:PrincipalAssignments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
    OPTIONAL { $this effortless-ntwf:appUser ?app_user . OPTIONAL { ?app_user effortless-ntwf:__key ?app_user__key . } }
    OPTIONAL { $this effortless-ntwf:principal ?principal . OPTIONAL { ?principal effortless-ntwf:__key ?principal__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?app_user__key, IF(isIRI(?app_user), REPLACE(STR(?app_user), "^.*[#/]", ""), STR(?app_user))), ""), " as ", COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_PrincipalIsAdmin" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:principalIsAdmin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
                OPTIONAL { $this effortless-ntwf:principal ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AccessPrincipals ; effortless-ntwf:accessPrincipalId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isAdministrator ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_UserOrganization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:userOrganization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
                OPTIONAL { $this effortless-ntwf:appUser ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AppUsers ; effortless-ntwf:appUserId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_PrincipalOrganization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:principalOrganization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
                OPTIONAL { $this effortless-ntwf:principal ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AccessPrincipals ; effortless-ntwf:accessPrincipalId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organizationScope ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_IsCrossOrganizationGrant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCrossOrganizationGrant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
    OPTIONAL { $this effortless-ntwf:principalOrganization ?principal_organization . OPTIONAL { ?principal_organization effortless-ntwf:__key ?principal_organization__key . } }
    OPTIONAL { $this effortless-ntwf:userOrganization ?user_organization . OPTIONAL { ?user_organization effortless-ntwf:__key ?user_organization__key . } }
                BIND((COALESCE((COALESCE(?user_organization__key, COALESCE(IF(isIRI(?user_organization), REPLACE(STR(?user_organization), "^.*[#/]", ""), STR(?user_organization)), "")) != ""), false) && COALESCE((COALESCE(?principal_organization__key, COALESCE(IF(isIRI(?principal_organization), REPLACE(STR(?principal_organization), "^.*[#/]", ""), STR(?principal_organization)), "")) != ""), false) && COALESCE(COALESCE((?user_organization != ?principal_organization), !((!BOUND(?user_organization) || STR(?user_organization) = "") && (!BOUND(?principal_organization) || STR(?principal_organization) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProblemOccurrences ===
effortless-ntwf:ProblemOccurrencesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProblemOccurrences ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProblemOccurrences .
    OPTIONAL { $this effortless-ntwf:problemOccurrenceId ?problem_occurrence_id . OPTIONAL { ?problem_occurrence_id effortless-ntwf:__key ?problem_occurrence_id__key . } }
    OPTIONAL { $this effortless-ntwf:problemSignature ?problem_signature . OPTIONAL { ?problem_signature effortless-ntwf:__key ?problem_signature__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?problem_signature__key, IF(isIRI(?problem_signature), REPLACE(STR(?problem_signature), "^.*[#/]", ""), STR(?problem_signature))), ""), " / ", COALESCE(COALESCE(?problem_occurrence_id__key, IF(isIRI(?problem_occurrence_id), REPLACE(STR(?problem_occurrence_id), "^.*[#/]", ""), STR(?problem_occurrence_id))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_SolverIsStillEngaged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:solverIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProblemOccurrences .
                OPTIONAL { $this effortless-ntwf:solvedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isStillEngaged ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_IsSolved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSolved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProblemOccurrences .
    OPTIONAL { $this effortless-ntwf:solvedAt ?solved_at . OPTIONAL { ?solved_at effortless-ntwf:__key ?solved_at__key . } }
                BIND((COALESCE(?solved_at__key, COALESCE(IF(isIRI(?solved_at), REPLACE(STR(?solved_at), "^.*[#/]", ""), STR(?solved_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_PriorWasSolved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:priorWasSolved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProblemOccurrences .
                OPTIONAL { $this effortless-ntwf:priorOccurrence ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProblemOccurrences ; effortless-ntwf:problemOccurrenceId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isSolved ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_PriorSolutionEntry" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:priorSolutionEntry ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProblemOccurrences .
                OPTIONAL { $this effortless-ntwf:priorOccurrence ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProblemOccurrences ; effortless-ntwf:problemOccurrenceId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:solutionEntry ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_PriorSolver" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:priorSolver ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProblemOccurrences .
                OPTIONAL { $this effortless-ntwf:priorOccurrence ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProblemOccurrences ; effortless-ntwf:problemOccurrenceId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:solvedByAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_PriorSolverIsStillEngaged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:priorSolverIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProblemOccurrences .
                OPTIONAL { $this effortless-ntwf:priorOccurrence ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProblemOccurrences ; effortless-ntwf:problemOccurrenceId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:solverIsStillEngaged ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_IsSolvedWithoutRecordedSolution" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSolvedWithoutRecordedSolution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProblemOccurrences .
    OPTIONAL { $this effortless-ntwf:isSolved ?is_solved . }
    OPTIONAL { $this effortless-ntwf:solutionEntry ?solution_entry . OPTIONAL { ?solution_entry effortless-ntwf:__key ?solution_entry__key . } }
                BIND((COALESCE(?is_solved, false) && COALESCE((COALESCE(?solution_entry__key, COALESCE(IF(isIRI(?solution_entry), REPLACE(STR(?solution_entry), "^.*[#/]", ""), STR(?solution_entry)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_HasBeenSolvedBefore" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasBeenSolvedBefore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProblemOccurrences .
    OPTIONAL { $this effortless-ntwf:priorOccurrence ?prior_occurrence . OPTIONAL { ?prior_occurrence effortless-ntwf:__key ?prior_occurrence__key . } }
    OPTIONAL { $this effortless-ntwf:priorWasSolved ?prior_was_solved . }
                BIND((COALESCE((COALESCE(?prior_occurrence__key, COALESCE(IF(isIRI(?prior_occurrence), REPLACE(STR(?prior_occurrence), "^.*[#/]", ""), STR(?prior_occurrence)), "")) != ""), false) && COALESCE((COALESCE(?prior_was_solved, false) = true), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_HasConsultableSpecialist" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasConsultableSpecialist ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProblemOccurrences .
    OPTIONAL { $this effortless-ntwf:hasBeenSolvedBefore ?has_been_solved_before . }
    OPTIONAL { $this effortless-ntwf:priorSolver ?prior_solver . OPTIONAL { ?prior_solver effortless-ntwf:__key ?prior_solver__key . } }
    OPTIONAL { $this effortless-ntwf:priorSolverIsStillEngaged ?prior_solver_is_still_engaged . }
                BIND((COALESCE(?has_been_solved_before, false) && COALESCE((COALESCE(?prior_solver__key, COALESCE(IF(isIRI(?prior_solver), REPLACE(STR(?prior_solver), "^.*[#/]", ""), STR(?prior_solver)), "")) != ""), false) && COALESCE((COALESCE(?prior_solver_is_still_engaged, false) = true), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_IsRelearnedSolvedProblem" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRelearnedSolvedProblem ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProblemOccurrences .
    OPTIONAL { $this effortless-ntwf:hasBeenSolvedBefore ?has_been_solved_before . }
    OPTIONAL { $this effortless-ntwf:priorSolutionEntry ?prior_solution_entry . OPTIONAL { ?prior_solution_entry effortless-ntwf:__key ?prior_solution_entry__key . } }
                BIND((COALESCE(?has_been_solved_before, false) && COALESCE((COALESCE(?prior_solution_entry__key, COALESCE(IF(isIRI(?prior_solution_entry), REPLACE(STR(?prior_solution_entry), "^.*[#/]", ""), STR(?prior_solution_entry)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProblemOccurrences_IsTurnoverRegression" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isTurnoverRegression ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProblemOccurrences .
    OPTIONAL { $this effortless-ntwf:isRelearnedSolvedProblem ?is_relearned_solved_problem . }
    OPTIONAL { $this effortless-ntwf:priorSolver ?prior_solver . OPTIONAL { ?prior_solver effortless-ntwf:__key ?prior_solver__key . } }
    OPTIONAL { $this effortless-ntwf:priorSolverIsStillEngaged ?prior_solver_is_still_engaged . }
                BIND((COALESCE(?is_relearned_solved_problem, false) && COALESCE((COALESCE(?prior_solver__key, COALESCE(IF(isIRI(?prior_solver), REPLACE(STR(?prior_solver), "^.*[#/]", ""), STR(?prior_solver)), "")) != ""), false) && COALESCE((COALESCE(?prior_solver_is_still_engaged, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureAdoptions ===
effortless-ntwf:ProcedureAdoptionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureAdoptions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureAdoptions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureAdoptions .
    OPTIONAL { $this effortless-ntwf:organization ?organization . OPTIONAL { ?organization effortless-ntwf:__key ?organization__key . } }
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . OPTIONAL { ?procedure effortless-ntwf:__key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?organization__key, IF(isIRI(?organization), REPLACE(STR(?organization), "^.*[#/]", ""), STR(?organization))), ""), " adopts ", COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureAdoptions_IsAdoptionModeUnstated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAdoptionModeUnstated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureAdoptions .
    OPTIONAL { $this effortless-ntwf:adoptionMode ?adoption_mode . OPTIONAL { ?adoption_mode effortless-ntwf:__key ?adoption_mode__key . } }
                BIND((COALESCE(?adoption_mode__key, COALESCE(IF(isIRI(?adoption_mode), REPLACE(STR(?adoption_mode), "^.*[#/]", ""), STR(?adoption_mode)), "")) = "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureExecutions ===
effortless-ntwf:ProcedureExecutionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureExecutions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:context ?context . OPTIONAL { ?context effortless-ntwf:__key ?context__key . } }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version effortless-ntwf:__key ?procedure_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " / ", COALESCE(COALESCE(?context__key, IF(isIRI(?context), REPLACE(STR(?context), "^.*[#/]", ""), STR(?context))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ExpectedStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expectedStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:specifiedStepCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_CompletedStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:completedStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:completedExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ControlBreachCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:controlBreachCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:controlBreachExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_LateStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lateStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:lateExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_IsStructurallyComplete" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStructurallyComplete ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:completedStepCount ?completed_step_count . }
    OPTIONAL { $this effortless-ntwf:expectedStepCount ?expected_step_count . }
                BIND((COALESCE(?completed_step_count, 0) >= COALESCE(?expected_step_count, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_DivergedFromSpecification" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:divergedFromSpecification ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:controlBreachCount ?control_breach_count . }
    OPTIONAL { $this effortless-ntwf:isStructurallyComplete ?is_structurally_complete . }
                BIND((COALESCE((!(COALESCE(?is_structurally_complete, false))), false) || COALESCE((COALESCE(?control_breach_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AllBlockingControlsEvaluated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:allBlockingControlsEvaluated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:unevaluatedBlockingTotal ?unevaluated_blocking_total . }
                BIND((COALESCE(?unevaluated_blocking_total, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_UnevaluatedBlockingTotal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unevaluatedBlockingTotal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:unevaluatedBlockingExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SeparationOfDutiesHeld" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:separationOfDutiesHeld ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:separationViolationCount ?separation_violation_count . }
                BIND((COALESCE(?separation_violation_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SeparationViolationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:separationViolationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:separationViolationExecutionKey ?backfk .
                    $this effortless-ntwf:procedureExecutionId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_IsAttestationReady" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAttestationReady ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:allBlockingControlsEvaluated ?all_blocking_controls_evaluated . }
    OPTIONAL { $this effortless-ntwf:divergedFromSpecification ?diverged_from_specification . }
    OPTIONAL { $this effortless-ntwf:isStructurallyComplete ?is_structurally_complete . }
    OPTIONAL { $this effortless-ntwf:separationOfDutiesHeld ?separation_of_duties_held . }
                BIND((COALESCE(?is_structurally_complete, false) && COALESCE((!(COALESCE(?diverged_from_specification, false))), false) && COALESCE(?all_blocking_controls_evaluated, false) && COALESCE(?separation_of_duties_held, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AttestationBlockerSummary" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:attestationBlockerSummary ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:isAttestationReady ?is_attestation_ready . }
    OPTIONAL { $this effortless-ntwf:isStructurallyComplete ?is_structurally_complete . }
    OPTIONAL { $this effortless-ntwf:separationViolationCount ?separation_violation_count . }
    OPTIONAL { $this effortless-ntwf:unevaluatedBlockingTotal ?unevaluated_blocking_total . }
                BIND(IF(COALESCE(?is_attestation_ready, false), "", IF(COALESCE((!(COALESCE(?is_structurally_complete, false))), false), "Incomplete: specified steps did not all complete.", IF(COALESCE((COALESCE(?separation_violation_count, 0) > 0), false), "Segregation of duties violated.", IF(COALESCE((COALESCE(?unevaluated_blocking_total, 0) > 0), false), "Blocking controls were never evaluated.", "Control breach recorded on one or more steps.")))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ExecutedVersionIsFit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:executedVersionIsFit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isFitToExecute ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SignedAgainstUnfitVersion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:signedAgainstUnfitVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:executedVersionIsFit ?executed_version_is_fit . }
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . OPTIONAL { ?execution_status effortless-ntwf:__key ?execution_status__key . } }
                BIND((COALESCE((COALESCE(?execution_status__key, COALESCE(IF(isIRI(?execution_status), REPLACE(STR(?execution_status), "^.*[#/]", ""), STR(?execution_status)), "")) = "Completed"), false) && COALESCE((!(COALESCE(?executed_version_is_fit, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
