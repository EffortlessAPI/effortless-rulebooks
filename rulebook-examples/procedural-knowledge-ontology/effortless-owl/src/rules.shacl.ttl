                    ?child a pko-native-procedural-knowledge-rulebook:Procedures .
                    ?child pko-native-procedural-knowledge-rulebook:requiredByRegulation $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

