    OPTIONAL { $this effortless-ntwf:versionProcedure ?version_procedure . }
                BIND(IF(COALESCE(?assigned_role_does_compliance_review, false), ?version_procedure, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_StepProcedureType" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepProcedureType ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:procedureTypeOfVersion ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsReleaseApprovalGate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isReleaseApprovalGate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:controlKind ?control_kind . OPTIONAL { ?control_kind effortless-ntwf:__key ?control_kind__key . } }
    OPTIONAL { $this effortless-ntwf:stepProcedureType ?step_procedure_type . OPTIONAL { ?step_procedure_type effortless-ntwf:__key ?step_procedure_type__key . } }
                BIND((COALESCE((COALESCE(?control_kind__key, COALESCE(IF(isIRI(?control_kind), REPLACE(STR(?control_kind), "^.*[#/]", ""), STR(?control_kind)), "")) = "Approval"), false) && COALESCE((COALESCE(?step_procedure_type__key, COALESCE(IF(isIRI(?step_procedure_type), REPLACE(STR(?step_procedure_type), "^.*[#/]", ""), STR(?step_procedure_type)), "")) = "software-release"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_RegulatoryRequirementCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:regulatoryRequirementCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepRequirements .
                    ?child effortless-ntwf:step $this .
                    OPTIONAL { ?child effortless-ntwf:requirementIsRegulatory ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_ToolFunctionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:toolFunctionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepFunctions .
                    ?child effortless-ntwf:step $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_ParseableConditionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:parseableConditionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepConditions .
                    ?child effortless-ntwf:step $this .
                    OPTIONAL { ?child effortless-ntwf:isMachineParseable ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_DmnDecisionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:dmnDecisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:DecisionPoints .
                    ?child effortless-ntwf:step $this .
                    OPTIONAL { ?child effortless-ntwf:isDmnEncoded ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_ToolUseRulesOnlyInProse" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:toolUseRulesOnlyInProse ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:dmnDecisionCount ?dmn_decision_count . }
    OPTIONAL { $this effortless-ntwf:parseableConditionCount ?parseable_condition_count . }
    OPTIONAL { $this effortless-ntwf:toolFunctionCount ?tool_function_count . }
                BIND((COALESCE((COALESCE(?tool_function_count, 0) > 0), false) && COALESCE((COALESCE(?parseable_condition_count, 0) = 0), false) && COALESCE((COALESCE(?dmn_decision_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_OpenOutdatedFlagCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:openOutdatedFlagCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelAnnotations .
                    ?child effortless-ntwf:step $this .
                    OPTIONAL { ?child effortless-ntwf:isOpenOutdatedFlag ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_HasReportedRealityMismatch" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasReportedRealityMismatch ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:openOutdatedFlagCount ?open_outdated_flag_count . }
                BIND((COALESCE(?open_outdated_flag_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_DeviatedRunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:deviatedRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:step $this .
                    OPTIONAL { ?child effortless-ntwf:hasDeviation ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsDriftedFromPractice" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDriftedFromPractice ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:deviatedRunCount ?deviated_run_count . }
    OPTIONAL { $this effortless-ntwf:openOutdatedFlagCount ?open_outdated_flag_count . }
                BIND((COALESCE((COALESCE(?deviated_run_count, 0) >= 2), false) || COALESCE((COALESCE((COALESCE(?deviated_run_count, 0) > 0), false) && COALESCE((COALESCE(?open_outdated_flag_count, 0) > 0), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_AiFailureCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:aiFailureCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AssistantAnswers .
                    ?child effortless-ntwf:contextStep ?backfk .
                    $this effortless-ntwf:stepId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:taskOutcome ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER((STR(?c2) = "Failed"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsAiFailurePoint" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAiFailurePoint ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:aiFailureCount ?ai_failure_count . }
                BIND((COALESCE(?ai_failure_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_AiArtifactInputCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:aiArtifactInputCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepVariables .
                    ?child effortless-ntwf:step $this .
                    OPTIONAL { ?child effortless-ntwf:isInputFromAiArtifact ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_ConsumesAiAgentArtifact" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:consumesAiAgentArtifact ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:aiArtifactInputCount ?ai_artifact_input_count . }
                BIND((COALESCE(?ai_artifact_input_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_CollectionEvidenceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:collectionEvidenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeTraces .
                    ?child effortless-ntwf:step $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_HasCollectionEvidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasCollectionEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:collectionEvidenceCount ?collection_evidence_count . }
                BIND((COALESCE(?collection_evidence_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_ActivityOriginTraceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:activityOriginTraceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeTraces .
                    ?child effortless-ntwf:step $this .
                    OPTIONAL { ?child effortless-ntwf:targetKind ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:traceRole ?c4 . }
                    FILTER((STR(?c2) = "ActivityDefinition"))
                    FILTER((STR(?c4) = "Origin"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_VersionModelTraceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:versionModelTraceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:processModelTraceCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsUntracedActivityInTracedModel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUntracedActivityInTracedModel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:activityOriginTraceCount ?activity_origin_trace_count . }
    OPTIONAL { $this effortless-ntwf:versionModelTraceCount ?version_model_trace_count . }
                BIND((COALESCE((COALESCE(?version_model_trace_count, 0) > 0), false) && COALESCE((COALESCE(?activity_origin_trace_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_ElicitedValidationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:elicitedValidationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeTraces .
                    ?child effortless-ntwf:step $this .
                    OPTIONAL { ?child effortless-ntwf:traceRole ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:sourceIsPeopleCapture ?c4 . }
                    FILTER((STR(?c2) = "Validates"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_ElicitedExtensionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:elicitedExtensionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeTraces .
                    ?child effortless-ntwf:step $this .
                    OPTIONAL { ?child effortless-ntwf:traceRole ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:sourceIsPeopleCapture ?c4 . }
                    FILTER((STR(?c2) = "Extends"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_DownstreamArtifactStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:downstreamArtifactStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(*) AS ?_result) WHERE {
                        $this effortless-ntwf:handoff+ ?b .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_DeclaredFirstStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:declaredFirstStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:isDeclaredFirstStep ?is_declared_first_step . }
    OPTIONAL { $this effortless-ntwf:stepId ?step_id . }
                BIND(IF(COALESCE(?is_declared_first_step, false), ?step_id, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_DeclaredFallbackStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:declaredFallbackStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:isDeclaredFallbackStep ?is_declared_fallback_step . }
    OPTIONAL { $this effortless-ntwf:stepId ?step_id . }
                BIND(IF(COALESCE(?is_declared_fallback_step, false), ?step_id, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StewardActivities ===
effortless-ntwf:StewardActivitiesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StewardActivities ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardActivities_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StewardActivities .
    OPTIONAL { $this effortless-ntwf:dutyKind ?duty_kind . OPTIONAL { ?duty_kind effortless-ntwf:__key ?duty_kind__key . } }
    OPTIONAL { $this effortless-ntwf:modelCharter ?model_charter . OPTIONAL { ?model_charter effortless-ntwf:__key ?model_charter__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_charter__key, IF(isIRI(?model_charter), REPLACE(STR(?model_charter), "^.*[#/]", ""), STR(?model_charter))), ""), " ", COALESCE(COALESCE(?duty_kind__key, IF(isIRI(?duty_kind), REPLACE(STR(?duty_kind), "^.*[#/]", ""), STR(?duty_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardActivities_ActivityModel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:activityModel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StewardActivities .
                OPTIONAL { $this effortless-ntwf:modelCharter ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ModelCharters ; effortless-ntwf:modelCharterId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:governedModel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StewardshipAssignments ===
effortless-ntwf:StewardshipAssignmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StewardshipAssignments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StewardshipAssignments .
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version effortless-ntwf:__key ?procedure_version__key . } }
    OPTIONAL { $this effortless-ntwf:stewardRole ?steward_role . OPTIONAL { ?steward_role effortless-ntwf:__key ?steward_role__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), ""), " / steward=", COALESCE(COALESCE(?steward_role__key, IF(isIRI(?steward_role), REPLACE(STR(?steward_role), "^.*[#/]", ""), STR(?steward_role))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_CountOfReviewEvents" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfReviewEvents ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StewardshipAssignments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ReviewEvents .
                    ?child effortless-ntwf:procedureVersion ?backfk .
                    $this effortless-ntwf:procedureVersion ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_HasEverBeenReviewed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasEverBeenReviewed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StewardshipAssignments .
    OPTIONAL { $this effortless-ntwf:countOfReviewEvents ?count_of_review_events . }
                BIND((COALESCE(?count_of_review_events, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StewardshipAssignments .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_IsCurrentAssignment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrentAssignment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StewardshipAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . OPTIONAL { ?valid_to effortless-ntwf:__key ?valid_to__key . } }
                BIND((COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SubstrateRunScores ===
effortless-ntwf:SubstrateRunScoresShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SubstrateRunScores ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
    OPTIONAL { $this effortless-ntwf:run ?run . OPTIONAL { ?run effortless-ntwf:__key ?run__key . } }
    OPTIONAL { $this effortless-ntwf:substrate ?substrate . OPTIONAL { ?substrate effortless-ntwf:__key ?substrate__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?run__key, IF(isIRI(?run), REPLACE(STR(?run), "^.*[#/]", ""), STR(?run))), ""), " / ", COALESCE(COALESCE(?substrate__key, IF(isIRI(?substrate), REPLACE(STR(?substrate), "^.*[#/]", ""), STR(?substrate))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_CellsFailed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cellsFailed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
    OPTIONAL { $this effortless-ntwf:cellsPassed ?cells_passed . }
    OPTIONAL { $this effortless-ntwf:cellsTested ?cells_tested . }
                BIND((?cells_tested - ?cells_passed) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_Score" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:score ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
    OPTIONAL { $this effortless-ntwf:cellsPassed ?cells_passed . }
    OPTIONAL { $this effortless-ntwf:cellsTested ?cells_tested . }
                BIND(IF(COALESCE((COALESCE(?cells_tested, 0) = 0), false), 0, (ROUND(((100 * ?cells_passed) / ?cells_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_CalculatedScore" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:calculatedScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
    OPTIONAL { $this effortless-ntwf:calculatedPassed ?calculated_passed . }
    OPTIONAL { $this effortless-ntwf:calculatedTested ?calculated_tested . }
                BIND(IF(COALESCE((COALESCE(?calculated_tested, 0) = 0), false), 0, (ROUND(((100 * ?calculated_passed) / ?calculated_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_LookupScore" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lookupScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
    OPTIONAL { $this effortless-ntwf:lookupPassed ?lookup_passed . }
    OPTIONAL { $this effortless-ntwf:lookupTested ?lookup_tested . }
                BIND(IF(COALESCE((COALESCE(?lookup_tested, 0) = 0), false), 0, (ROUND(((100 * ?lookup_passed) / ?lookup_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_AggregationScore" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:aggregationScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
    OPTIONAL { $this effortless-ntwf:aggregationPassed ?aggregation_passed . }
    OPTIONAL { $this effortless-ntwf:aggregationTested ?aggregation_tested . }
                BIND(IF(COALESCE((COALESCE(?aggregation_tested, 0) = 0), false), 0, (ROUND(((100 * ?aggregation_passed) / ?aggregation_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_IsPerfect" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPerfect ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
    OPTIONAL { $this effortless-ntwf:cellsFailed ?cells_failed . }
    OPTIONAL { $this effortless-ntwf:cellsTested ?cells_tested . }
    OPTIONAL { $this effortless-ntwf:harnessError ?harness_error . OPTIONAL { ?harness_error effortless-ntwf:__key ?harness_error__key . } }
                BIND((COALESCE((COALESCE(?harness_error__key, COALESCE(IF(isIRI(?harness_error), REPLACE(STR(?harness_error), "^.*[#/]", ""), STR(?harness_error)), "")) = ""), false) && COALESCE((COALESCE(?cells_tested, 0) > 0), false) && COALESCE((COALESCE(?cells_failed, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_PerfectRunKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:perfectRunKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
    OPTIONAL { $this effortless-ntwf:isPerfect ?is_perfect . }
    OPTIONAL { $this effortless-ntwf:run ?run . }
                BIND(IF(COALESCE(?is_perfect, false), ?run, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_IsInLatestRun" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInLatestRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
                OPTIONAL { $this effortless-ntwf:run ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ConformanceRuns ; effortless-ntwf:conformanceRunId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isLatest ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_LatestCellsTested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestCellsTested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
    OPTIONAL { $this effortless-ntwf:cellsTested ?cells_tested . }
    OPTIONAL { $this effortless-ntwf:isInLatestRun ?is_in_latest_run . }
                BIND(IF(COALESCE(?is_in_latest_run, false), ?cells_tested, 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_LatestCellsPassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestCellsPassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
    OPTIONAL { $this effortless-ntwf:cellsPassed ?cells_passed . }
    OPTIONAL { $this effortless-ntwf:isInLatestRun ?is_in_latest_run . }
                BIND(IF(COALESCE(?is_in_latest_run, false), ?cells_passed, 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_LatestErrorFlag" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestErrorFlag ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
    OPTIONAL { $this effortless-ntwf:harnessError ?harness_error . OPTIONAL { ?harness_error effortless-ntwf:__key ?harness_error__key . } }
    OPTIONAL { $this effortless-ntwf:isInLatestRun ?is_in_latest_run . }
                BIND(IF(COALESCE((COALESCE(?is_in_latest_run, false) && COALESCE((COALESCE(?harness_error__key, COALESCE(IF(isIRI(?harness_error), REPLACE(STR(?harness_error), "^.*[#/]", ""), STR(?harness_error)), "")) != ""), false)), false), 1, 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SubstrateRunScores_SubstrateLabel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:substrateLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SubstrateRunScores .
                OPTIONAL { $this effortless-ntwf:substrate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ConformanceSubstrates ; effortless-ntwf:conformanceSubstrateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for TableConformance ===
effortless-ntwf:TableConformanceShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TableConformance ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TableConformance .
    OPTIONAL { $this effortless-ntwf:rulebookTable ?rulebook_table . OPTIONAL { ?rulebook_table effortless-ntwf:__key ?rulebook_table__key . } }
    OPTIONAL { $this effortless-ntwf:substrate ?substrate . OPTIONAL { ?substrate effortless-ntwf:__key ?substrate__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?substrate__key, IF(isIRI(?substrate), REPLACE(STR(?substrate), "^.*[#/]", ""), STR(?substrate))), ""), " / ", COALESCE(COALESCE(?rulebook_table__key, IF(isIRI(?rulebook_table), REPLACE(STR(?rulebook_table), "^.*[#/]", ""), STR(?rulebook_table))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_CellsFailed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cellsFailed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TableConformance .
    OPTIONAL { $this effortless-ntwf:cellsPassed ?cells_passed . }
    OPTIONAL { $this effortless-ntwf:cellsTested ?cells_tested . }
                BIND((?cells_tested - ?cells_passed) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_Score" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:score ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TableConformance .
    OPTIONAL { $this effortless-ntwf:cellsPassed ?cells_passed . }
    OPTIONAL { $this effortless-ntwf:cellsTested ?cells_tested . }
                BIND(IF(COALESCE((COALESCE(?cells_tested, 0) = 0), false), 0, (ROUND(((100 * ?cells_passed) / ?cells_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_IsPerfect" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPerfect ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TableConformance .
    OPTIONAL { $this effortless-ntwf:cellsFailed ?cells_failed . }
                BIND((COALESCE(?cells_failed, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_ImperfectSubstrateKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:imperfectSubstrateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TableConformance .
    OPTIONAL { $this effortless-ntwf:isPerfect ?is_perfect . }
    OPTIONAL { $this effortless-ntwf:substrate ?substrate . }
                BIND(IF(COALESCE(?is_perfect, false), "", ?substrate) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_ImperfectTableKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:imperfectTableKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TableConformance .
    OPTIONAL { $this effortless-ntwf:isPerfect ?is_perfect . }
    OPTIONAL { $this effortless-ntwf:rulebookTable ?rulebook_table . }
                BIND(IF(COALESCE(?is_perfect, false), "", ?rulebook_table) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_DisagreeingFieldCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:disagreeingFieldCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TableConformance .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FieldDisagreements .
                    ?child effortless-ntwf:tableConformance $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_SubstrateLabel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:substrateLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TableConformance .
                OPTIONAL { $this effortless-ntwf:substrate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ConformanceSubstrates ; effortless-ntwf:conformanceSubstrateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TableConformance_SubjectArea" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:subjectArea ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TableConformance .
                OPTIONAL { $this effortless-ntwf:rulebookTable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookTables ; effortless-ntwf:rulebookTableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:subjectArea ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for TacticalResourceAllocations ===
effortless-ntwf:TacticalResourceAllocationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TacticalResourceAllocations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TacticalResourceAllocations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TacticalResourceAllocations .
    OPTIONAL { $this effortless-ntwf:resourceLabel ?resource_label . OPTIONAL { ?resource_label effortless-ntwf:__key ?resource_label__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?resource_label__key, IF(isIRI(?resource_label), REPLACE(STR(?resource_label), "^.*[#/]", ""), STR(?resource_label))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TacticalResourceAllocations_UtilizationPercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:utilizationPercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TacticalResourceAllocations .
    OPTIONAL { $this effortless-ntwf:availableUnitsPerWeek ?available_units_per_week . }
    OPTIONAL { $this effortless-ntwf:demandedUnitsPerWeek ?demanded_units_per_week . }
                BIND(IF(COALESCE((COALESCE(?available_units_per_week, 0) = 0), false), 0, (ROUND(((?demanded_units_per_week * 100) / ?available_units_per_week) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TacticalResourceAllocations_IsBottleneck" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBottleneck ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TacticalResourceAllocations .
    OPTIONAL { $this effortless-ntwf:availableUnitsPerWeek ?available_units_per_week . }
    OPTIONAL { $this effortless-ntwf:demandedUnitsPerWeek ?demanded_units_per_week . }
                BIND((COALESCE(?demanded_units_per_week, 0) > COALESCE(?available_units_per_week, 0)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for TemplateApprovals ===
effortless-ntwf:TemplateApprovalsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TemplateApprovals ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TemplateApprovals .
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . OPTIONAL { ?decided_at effortless-ntwf:__key ?decided_at__key . } }
    OPTIONAL { $this effortless-ntwf:decision ?decision . OPTIONAL { ?decision effortless-ntwf:__key ?decision__key . } }
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . OPTIONAL { ?message_template effortless-ntwf:__key ?message_template__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?message_template__key, IF(isIRI(?message_template), REPLACE(STR(?message_template), "^.*[#/]", ""), STR(?message_template))), ""), " / ", COALESCE(COALESCE(?decision__key, IF(isIRI(?decision), REPLACE(STR(?decision), "^.*[#/]", ""), STR(?decision))), ""), " / ", COALESCE(REPLACE(COALESCE(?decided_at__key, IF(isIRI(?decided_at), REPLACE(STR(?decided_at), "^.*[#/]", ""), STR(?decided_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_IsApprovalDecision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isApprovalDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TemplateApprovals .
    OPTIONAL { $this effortless-ntwf:decision ?decision . OPTIONAL { ?decision effortless-ntwf:__key ?decision__key . } }
                BIND((COALESCE(?decision__key, COALESCE(IF(isIRI(?decision), REPLACE(STR(?decision), "^.*[#/]", ""), STR(?decision)), "")) = "Approved") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_TemplatePolicy" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:templatePolicy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TemplateApprovals .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:communicationPolicy ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_RequiredApprovalRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requiredApprovalRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TemplateApprovals .
                OPTIONAL { $this effortless-ntwf:templatePolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:approvalRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_IsDecidedByRequiredRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDecidedByRequiredRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TemplateApprovals .
    OPTIONAL { $this effortless-ntwf:decidedInRole ?decided_in_role . }
    OPTIONAL { $this effortless-ntwf:requiredApprovalRole ?required_approval_role . }
                BIND(COALESCE((?decided_in_role = ?required_approval_role), ((!BOUND(?decided_in_role) || STR(?decided_in_role) = "") && (!BOUND(?required_approval_role) || STR(?required_approval_role) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_ValidApprovalTemplateKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:validApprovalTemplateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TemplateApprovals .
    OPTIONAL { $this effortless-ntwf:isApprovalDecision ?is_approval_decision . }
    OPTIONAL { $this effortless-ntwf:isDecidedByRequiredRole ?is_decided_by_required_role . }
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . }
                BIND(IF(COALESCE((COALESCE(?is_approval_decision, false) && COALESCE(?is_decided_by_required_role, false)), false), ?message_template, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for TermDefinitions ===
effortless-ntwf:TermDefinitionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TermDefinitions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermDefinitions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermDefinitions .
    OPTIONAL { $this effortless-ntwf:rulebookTable ?rulebook_table . OPTIONAL { ?rulebook_table effortless-ntwf:__key ?rulebook_table__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?rulebook_table__key, IF(isIRI(?rulebook_table), REPLACE(STR(?rulebook_table), "^.*[#/]", ""), STR(?rulebook_table))), ""), " definition") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermDefinitions_DrafterKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:drafterKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermDefinitions .
                OPTIONAL { $this effortless-ntwf:draftedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermDefinitions_AiDraftAdoptedUnrevised" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:aiDraftAdoptedUnrevised ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermDefinitions .
    OPTIONAL { $this effortless-ntwf:drafterKind ?drafter_kind . OPTIONAL { ?drafter_kind effortless-ntwf:__key ?drafter_kind__key . } }
    OPTIONAL { $this effortless-ntwf:revisedByAgent ?revised_by_agent . OPTIONAL { ?revised_by_agent effortless-ntwf:__key ?revised_by_agent__key . } }
                BIND((COALESCE((COALESCE(?drafter_kind__key, COALESCE(IF(isIRI(?drafter_kind), REPLACE(STR(?drafter_kind), "^.*[#/]", ""), STR(?drafter_kind)), "")) = "AIAgent"), false) && COALESCE((COALESCE(?revised_by_agent__key, COALESCE(IF(isIRI(?revised_by_agent), REPLACE(STR(?revised_by_agent), "^.*[#/]", ""), STR(?revised_by_agent)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for TermLabelVariants ===
effortless-ntwf:TermLabelVariantsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TermLabelVariants ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermLabelVariants .
    OPTIONAL { $this effortless-ntwf:labelKind ?label_kind . OPTIONAL { ?label_kind effortless-ntwf:__key ?label_kind__key . } }
    OPTIONAL { $this effortless-ntwf:vocabularyTerm ?vocabulary_term . OPTIONAL { ?vocabulary_term effortless-ntwf:__key ?vocabulary_term__key . } }
    OPTIONAL { $this effortless-ntwf:wording ?wording . OPTIONAL { ?wording effortless-ntwf:__key ?wording__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?vocabulary_term__key, IF(isIRI(?vocabulary_term), REPLACE(STR(?vocabulary_term), "^.*[#/]", ""), STR(?vocabulary_term))), ""), " ", COALESCE(COALESCE(?label_kind__key, IF(isIRI(?label_kind), REPLACE(STR(?label_kind), "^.*[#/]", ""), STR(?label_kind))), ""), ": ", COALESCE(COALESCE(?wording__key, IF(isIRI(?wording), REPLACE(STR(?wording), "^.*[#/]", ""), STR(?wording))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_TermScheme" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:termScheme ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermLabelVariants .
                OPTIONAL { $this effortless-ntwf:vocabularyTerm ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:VocabularyTerms ; effortless-ntwf:vocabularyTermId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:vocabulary ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_WordingKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wordingKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermLabelVariants .
    OPTIONAL { $this effortless-ntwf:termScheme ?term_scheme . OPTIONAL { ?term_scheme effortless-ntwf:__key ?term_scheme__key . } }
    OPTIONAL { $this effortless-ntwf:wording ?wording . OPTIONAL { ?wording effortless-ntwf:__key ?wording__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?term_scheme__key, IF(isIRI(?term_scheme), REPLACE(STR(?term_scheme), "^.*[#/]", ""), STR(?term_scheme))), ""), "|", COALESCE(COALESCE(?wording__key, IF(isIRI(?wording), REPLACE(STR(?wording), "^.*[#/]", ""), STR(?wording))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_PrefWordingKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:prefWordingKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermLabelVariants .
    OPTIONAL { $this effortless-ntwf:labelKind ?label_kind . OPTIONAL { ?label_kind effortless-ntwf:__key ?label_kind__key . } }
    OPTIONAL { $this effortless-ntwf:wordingKey ?wording_key . }
                BIND(IF(COALESCE((COALESCE(?label_kind__key, COALESCE(IF(isIRI(?label_kind), REPLACE(STR(?label_kind), "^.*[#/]", ""), STR(?label_kind)), "")) = "pref"), false), ?wording_key, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_ConceptsSharingWording" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:conceptsSharingWording ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermLabelVariants .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TermLabelVariants .
                    ?child effortless-ntwf:wordingKey ?backfk .
                    $this effortless-ntwf:wordingKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_IsAmbiguousLabel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAmbiguousLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermLabelVariants .
    OPTIONAL { $this effortless-ntwf:conceptsSharingWording ?concepts_sharing_wording . }
                BIND((COALESCE(?concepts_sharing_wording, 0) > 1) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_PractitionerMentionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:practitionerMentionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermLabelVariants .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SourceTermMentions .
                    ?child effortless-ntwf:wordingKey ?backfk .
                    $this effortless-ntwf:wordingKey ?backpv .
                    OPTIONAL { ?child effortless-ntwf:mentionOrigin ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER((STR(?c2) = "Practitioner"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_PrefWording" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:prefWording ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermLabelVariants .
    OPTIONAL { $this effortless-ntwf:labelKind ?label_kind . OPTIONAL { ?label_kind effortless-ntwf:__key ?label_kind__key . } }
    OPTIONAL { $this effortless-ntwf:wording ?wording . }
                BIND(IF(COALESCE((COALESCE(?label_kind__key, COALESCE(IF(isIRI(?label_kind), REPLACE(STR(?label_kind), "^.*[#/]", ""), STR(?label_kind)), "")) = "pref"), false), ?wording, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_SamePrefWordingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:samePrefWordingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermLabelVariants .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TermLabelVariants .
                    ?child effortless-ntwf:prefWording ?backfk .
                    $this effortless-ntwf:prefWording ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermLabelVariants_IsCrossSchemeDuplicatePref" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCrossSchemeDuplicatePref ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermLabelVariants .
    OPTIONAL { $this effortless-ntwf:labelKind ?label_kind . OPTIONAL { ?label_kind effortless-ntwf:__key ?label_kind__key . } }
    OPTIONAL { $this effortless-ntwf:samePrefWordingCount ?same_pref_wording_count . }
                BIND((COALESCE((COALESCE(?label_kind__key, COALESCE(IF(isIRI(?label_kind), REPLACE(STR(?label_kind), "^.*[#/]", ""), STR(?label_kind)), "")) = "pref"), false) && COALESCE((COALESCE(?same_pref_wording_count, 0) > 1), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for TermMeaningChanges ===
effortless-ntwf:TermMeaningChangesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TermMeaningChanges ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermMeaningChanges_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermMeaningChanges .
    OPTIONAL { $this effortless-ntwf:changedAt ?changed_at . OPTIONAL { ?changed_at effortless-ntwf:__key ?changed_at__key . } }
    OPTIONAL { $this effortless-ntwf:vocabularyTerm ?vocabulary_term . OPTIONAL { ?vocabulary_term effortless-ntwf:__key ?vocabulary_term__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?vocabulary_term__key, IF(isIRI(?vocabulary_term), REPLACE(STR(?vocabulary_term), "^.*[#/]", ""), STR(?vocabulary_term))), ""), " meaning changed ", COALESCE(REPLACE(COALESCE(?changed_at__key, IF(isIRI(?changed_at), REPLACE(STR(?changed_at), "^.*[#/]", ""), STR(?changed_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermMeaningChanges_SpanDays" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:spanDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermMeaningChanges .
    OPTIONAL { $this effortless-ntwf:changedAt ?changed_at . }
    OPTIONAL { $this effortless-ntwf:priorMeaningSince ?prior_meaning_since . OPTIONAL { ?prior_meaning_since effortless-ntwf:__key ?prior_meaning_since__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?prior_meaning_since__key, COALESCE(IF(isIRI(?prior_meaning_since), REPLACE(STR(?prior_meaning_since), "^.*[#/]", ""), STR(?prior_meaning_since)), "")) = ""), false), 0, ((DAY(?changed_at) + FLOOR((153 * (MONTH(?changed_at) + 12 * FLOOR((14 - MONTH(?changed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?changed_at) + 4800 - FLOOR((14 - MONTH(?changed_at)) / 12)) + FLOOR((YEAR(?changed_at) + 4800 - FLOOR((14 - MONTH(?changed_at)) / 12)) / 4) - FLOOR((YEAR(?changed_at) + 4800 - FLOOR((14 - MONTH(?changed_at)) / 12)) / 100) + FLOOR((YEAR(?changed_at) + 4800 - FLOOR((14 - MONTH(?changed_at)) / 12)) / 400) - 32045) - (DAY(?prior_meaning_since) + FLOOR((153 * (MONTH(?prior_meaning_since) + 12 * FLOOR((14 - MONTH(?prior_meaning_since)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?prior_meaning_since) + 4800 - FLOOR((14 - MONTH(?prior_meaning_since)) / 12)) + FLOOR((YEAR(?prior_meaning_since) + 4800 - FLOOR((14 - MONTH(?prior_meaning_since)) / 12)) / 4) - FLOOR((YEAR(?prior_meaning_since) + 4800 - FLOOR((14 - MONTH(?prior_meaning_since)) / 12)) / 100) + FLOOR((YEAR(?prior_meaning_since) + 4800 - FLOOR((14 - MONTH(?prior_meaning_since)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for TermRelations ===
effortless-ntwf:TermRelationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TermRelations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermRelations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermRelations .
    OPTIONAL { $this effortless-ntwf:fromTerm ?from_term . OPTIONAL { ?from_term effortless-ntwf:__key ?from_term__key . } }
    OPTIONAL { $this effortless-ntwf:relationKind ?relation_kind . OPTIONAL { ?relation_kind effortless-ntwf:__key ?relation_kind__key . } }
    OPTIONAL { $this effortless-ntwf:toTerm ?to_term . OPTIONAL { ?to_term effortless-ntwf:__key ?to_term__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_term__key, IF(isIRI(?from_term), REPLACE(STR(?from_term), "^.*[#/]", ""), STR(?from_term))), ""), " ", COALESCE(COALESCE(?relation_kind__key, IF(isIRI(?relation_kind), REPLACE(STR(?relation_kind), "^.*[#/]", ""), STR(?relation_kind))), ""), " ", COALESCE(COALESCE(?to_term__key, IF(isIRI(?to_term), REPLACE(STR(?to_term), "^.*[#/]", ""), STR(?to_term))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermRelations_FromTermGrandparent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fromTermGrandparent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermRelations .
                OPTIONAL { $this effortless-ntwf:fromTerm ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:VocabularyTerms ; effortless-ntwf:vocabularyTermId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:broaderTermParent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TermRelations_AssertsIndirectLinkAsDirect" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assertsIndirectLinkAsDirect ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TermRelations .
    OPTIONAL { $this effortless-ntwf:fromTermGrandparent ?from_term_grandparent . }
    OPTIONAL { $this effortless-ntwf:relationKind ?relation_kind . OPTIONAL { ?relation_kind effortless-ntwf:__key ?relation_kind__key . } }
    OPTIONAL { $this effortless-ntwf:toTerm ?to_term . }
                BIND((COALESCE((COALESCE(?relation_kind__key, COALESCE(IF(isIRI(?relation_kind), REPLACE(STR(?relation_kind), "^.*[#/]", ""), STR(?relation_kind)), "")) = "broader"), false) && COALESCE(COALESCE((?to_term = ?from_term_grandparent), ((!BOUND(?to_term) || STR(?to_term) = "") && (!BOUND(?from_term_grandparent) || STR(?from_term_grandparent) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for TestCases ===
effortless-ntwf:TestCasesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TestCases ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:subject ?subject . OPTIONAL { ?subject effortless-ntwf:__key ?subject__key . } }
    OPTIONAL { $this effortless-ntwf:testKind ?test_kind . OPTIONAL { ?test_kind effortless-ntwf:__key ?test_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?test_kind__key, IF(isIRI(?test_kind), REPLACE(STR(?test_kind), "^.*[#/]", ""), STR(?test_kind))), ""), ": ", COALESCE(COALESCE(?subject__key, IF(isIRI(?subject), REPLACE(STR(?subject), "^.*[#/]", ""), STR(?subject))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_IsBlocking" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:severity ?severity . OPTIONAL { ?severity effortless-ntwf:__key ?severity__key . } }
                BIND((COALESCE(?severity__key, COALESCE(IF(isIRI(?severity), REPLACE(STR(?severity), "^.*[#/]", ""), STR(?severity)), "")) = "blocking") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_IsPassing" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPassing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:lastOutcome ?last_outcome . OPTIONAL { ?last_outcome effortless-ntwf:__key ?last_outcome__key . } }
                BIND((COALESCE(?last_outcome__key, COALESCE(IF(isIRI(?last_outcome), REPLACE(STR(?last_outcome), "^.*[#/]", ""), STR(?last_outcome)), "")) = "PASS") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_IsFailing" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFailing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:lastOutcome ?last_outcome . OPTIONAL { ?last_outcome effortless-ntwf:__key ?last_outcome__key . } }
                BIND((COALESCE(?last_outcome__key, COALESCE(IF(isIRI(?last_outcome), REPLACE(STR(?last_outcome), "^.*[#/]", ""), STR(?last_outcome)), "")) = "FAIL") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_NeedsAttention" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:needsAttention ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
    OPTIONAL { $this effortless-ntwf:isFailing ?is_failing . }
                BIND((COALESCE(?is_failing, false) && COALESCE(?is_blocking, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_PassingSuiteKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:passingSuiteKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:isPassing ?is_passing . }
    OPTIONAL { $this effortless-ntwf:suite ?suite . }
                BIND(IF(COALESCE(?is_passing, false), ?suite, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_NeedsAttentionSuiteKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:needsAttentionSuiteKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:needsAttention ?needs_attention . }
    OPTIONAL { $this effortless-ntwf:suite ?suite . }
                BIND(IF(COALESCE(?needs_attention, false), ?suite, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for TestSuites ===
effortless-ntwf:TestSuitesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TestSuites ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestSuites .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_TestCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:testCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestSuites .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TestCases .
                    ?child effortless-ntwf:suite $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_PassCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:passCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestSuites .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TestCases .
                    ?child effortless-ntwf:passingSuiteKey ?backfk .
                    $this effortless-ntwf:testSuiteId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_BlockingFailCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:blockingFailCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestSuites .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TestCases .
                    ?child effortless-ntwf:needsAttentionSuiteKey ?backfk .
                    $this effortless-ntwf:testSuiteId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_IsGreen" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isGreen ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestSuites .
    OPTIONAL { $this effortless-ntwf:blockingFailCount ?blocking_fail_count . }
                BIND((COALESCE(?blocking_fail_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Tools ===
effortless-ntwf:ToolsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Tools ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Tools_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Tools .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for UserFeedback ===
effortless-ntwf:UserFeedbackShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:UserFeedback ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserFeedback_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UserFeedback .
    OPTIONAL { $this effortless-ntwf:disposition ?disposition . OPTIONAL { ?disposition effortless-ntwf:__key ?disposition__key . } }
    OPTIONAL { $this effortless-ntwf:feedbackText ?feedback_text . }
                BIND(CONCAT(COALESCE(COALESCE(?disposition__key, IF(isIRI(?disposition), REPLACE(STR(?disposition), "^.*[#/]", ""), STR(?disposition))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?feedback_text), 1, 60)), REPLACE(STR(SUBSTR(STR(?feedback_text), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?feedback_text), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserFeedback_IsUnactionedProcedureCritique" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnactionedProcedureCritique ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UserFeedback .
    OPTIONAL { $this effortless-ntwf:changeRequestKey ?change_request_key . OPTIONAL { ?change_request_key effortless-ntwf:__key ?change_request_key__key . } }
    OPTIONAL { $this effortless-ntwf:disposition ?disposition . OPTIONAL { ?disposition effortless-ntwf:__key ?disposition__key . } }
    OPTIONAL { $this effortless-ntwf:feedbackOnProcedure ?feedback_on_procedure . OPTIONAL { ?feedback_on_procedure effortless-ntwf:__key ?feedback_on_procedure__key . } }
                BIND((COALESCE((COALESCE(?feedback_on_procedure__key, COALESCE(IF(isIRI(?feedback_on_procedure), REPLACE(STR(?feedback_on_procedure), "^.*[#/]", ""), STR(?feedback_on_procedure)), "")) != ""), false) && COALESCE((COALESCE(?change_request_key__key, COALESCE(IF(isIRI(?change_request_key), REPLACE(STR(?change_request_key), "^.*[#/]", ""), STR(?change_request_key)), "")) = ""), false) && COALESCE((COALESCE(?disposition__key, COALESCE(IF(isIRI(?disposition), REPLACE(STR(?disposition), "^.*[#/]", ""), STR(?disposition)), "")) != "Declined"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserFeedback_CollectionFollowUpCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:collectionFollowUpCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UserFeedback .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CollectedSourceMaterials .
                    ?child effortless-ntwf:promptedByFeedback $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserFeedback_IsTacitSignalNotFedIntoCollection" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isTacitSignalNotFedIntoCollection ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UserFeedback .
    OPTIONAL { $this effortless-ntwf:collectionFollowUpCount ?collection_follow_up_count . }
    OPTIONAL { $this effortless-ntwf:revealsTacitKnowledge ?reveals_tacit_knowledge . }
                BIND((COALESCE(?reveals_tacit_knowledge, false) && COALESCE((COALESCE(?collection_follow_up_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for UserQuestions ===
effortless-ntwf:UserQuestionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:UserQuestions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserQuestions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UserQuestions .
    OPTIONAL { $this effortless-ntwf:questionText ?question_text . }
                BIND(SUBSTR(STR(?question_text), 1, 70) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserQuestions_IsUnaddressedQuestion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnaddressedQuestion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UserQuestions .
    OPTIONAL { $this effortless-ntwf:addressedByResource ?addressed_by_resource . OPTIONAL { ?addressed_by_resource effortless-ntwf:__key ?addressed_by_resource__key . } }
    OPTIONAL { $this effortless-ntwf:resolvedByFaq ?resolved_by_faq . OPTIONAL { ?resolved_by_faq effortless-ntwf:__key ?resolved_by_faq__key . } }
                BIND((COALESCE((COALESCE(?addressed_by_resource__key, COALESCE(IF(isIRI(?addressed_by_resource), REPLACE(STR(?addressed_by_resource), "^.*[#/]", ""), STR(?addressed_by_resource)), "")) = ""), false) && COALESCE((COALESCE(?resolved_by_faq__key, COALESCE(IF(isIRI(?resolved_by_faq), REPLACE(STR(?resolved_by_faq), "^.*[#/]", ""), STR(?resolved_by_faq)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for VerificationOutcomes ===
effortless-ntwf:VerificationOutcomesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:VerificationOutcomes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . OPTIONAL { ?step_execution effortless-ntwf:__key ?step_execution__key . } }
    OPTIONAL { $this effortless-ntwf:stepVerification ?step_verification . OPTIONAL { ?step_verification effortless-ntwf:__key ?step_verification__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_execution__key, IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution))), ""), " / ", COALESCE(COALESCE(?step_verification__key, IF(isIRI(?step_verification), REPLACE(STR(?step_verification), "^.*[#/]", ""), STR(?step_verification))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_ExpectedSignalValue" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expectedSignalValue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
                OPTIONAL { $this effortless-ntwf:stepVerification ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepVerifications ; effortless-ntwf:stepVerificationId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:expectedSignalValue ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_SignalIdentifier" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:signalIdentifier ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
                OPTIONAL { $this effortless-ntwf:stepVerification ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepVerifications ; effortless-ntwf:stepVerificationId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:signalIdentifier ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_SignalMatchesExpected" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:signalMatchesExpected ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:expectedSignalValue ?expected_signal_value . }
    OPTIONAL { $this effortless-ntwf:observedSignalValue ?observed_signal_value . }
                BIND(COALESCE((?observed_signal_value = ?expected_signal_value), ((!BOUND(?observed_signal_value) || STR(?observed_signal_value) = "") && (!BOUND(?expected_signal_value) || STR(?expected_signal_value) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_HasEvidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:evidenceUri ?evidence_uri . OPTIONAL { ?evidence_uri effortless-ntwf:__key ?evidence_uri__key . } }
                BIND((COALESCE(?evidence_uri__key, COALESCE(IF(isIRI(?evidence_uri), REPLACE(STR(?evidence_uri), "^.*[#/]", ""), STR(?evidence_uri)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IsUnbackedObservation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnbackedObservation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:hasEvidence ?has_evidence . }
    OPTIONAL { $this effortless-ntwf:signalMatchesExpected ?signal_matches_expected . }
                BIND((COALESCE(?signal_matches_expected, false) && COALESCE((!(COALESCE(?has_evidence, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IsSelfWitnessed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSelfWitnessed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:observedByAgent ?observed_by_agent . }
    OPTIONAL { $this effortless-ntwf:stepExecutorAgent ?step_executor_agent . }
                BIND(COALESCE((?observed_by_agent = ?step_executor_agent), ((!BOUND(?observed_by_agent) || STR(?observed_by_agent) = "") && (!BOUND(?step_executor_agent) || STR(?step_executor_agent) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_StepExecutorAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepExecutorAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:executedByAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_SelfWitnessedStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:selfWitnessedStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:isSelfWitnessed ?is_self_witnessed . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_self_witnessed, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_UnbackedStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unbackedStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:isUnbackedObservation ?is_unbacked_observation . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_unbacked_observation, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IsSelfWitnessedAndUnbacked" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSelfWitnessedAndUnbacked ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:hasEvidence ?has_evidence . }
    OPTIONAL { $this effortless-ntwf:isSelfWitnessed ?is_self_witnessed . }
                BIND((COALESCE(?is_self_witnessed, false) && COALESCE((!(COALESCE(?has_evidence, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IsUncorroboratedPass" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUncorroboratedPass ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:isSelfWitnessedAndUnbacked ?is_self_witnessed_and_unbacked . }
    OPTIONAL { $this effortless-ntwf:signalMatchesExpected ?signal_matches_expected . }
                BIND((COALESCE(?signal_matches_expected, false) && COALESCE(?is_self_witnessed_and_unbacked, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_UncorroboratedPassStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:uncorroboratedPassStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:isUncorroboratedPass ?is_uncorroborated_pass . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_uncorroborated_pass, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_ObserverIsNonHuman" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:observerIsNonHuman ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
                OPTIONAL { $this effortless-ntwf:observedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isNonHuman ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_ObserverIsIndependentOfExecutor" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:observerIsIndependentOfExecutor ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:isSelfWitnessed ?is_self_witnessed . }
                BIND((!(COALESCE(?is_self_witnessed, false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IsIndependentHumanObservation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isIndependentHumanObservation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:hasEvidence ?has_evidence . }
    OPTIONAL { $this effortless-ntwf:isSelfWitnessed ?is_self_witnessed . }
    OPTIONAL { $this effortless-ntwf:observerIsNonHuman ?observer_is_non_human . }
                BIND((COALESCE((!(COALESCE(?observer_is_non_human, false))), false) && COALESCE((!(COALESCE(?is_self_witnessed, false))), false) && COALESCE(?has_evidence, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IndependentObservationExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:independentObservationExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:isIndependentHumanObservation ?is_independent_human_observation . }
    OPTIONAL { $this effortless-ntwf:parentProcedureExecutionOfOutcome ?parent_procedure_execution_of_outcome . }
                BIND(IF(COALESCE(?is_independent_human_observation, false), ?parent_procedure_execution_of_outcome, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_ParentProcedureExecutionOfOutcome" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:parentProcedureExecutionOfOutcome ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:procedureExecution ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Vocabularies ===
effortless-ntwf:VocabulariesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Vocabularies ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_TermCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:termCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:VocabularyTerms .
                    ?child effortless-ntwf:vocabulary $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_OrphanTermCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:orphanTermCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:VocabularyTerms .
                    ?child effortless-ntwf:orphanTermVocabularyKey ?backfk .
                    $this effortless-ntwf:vocabularyId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_HasOrphanTerms" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasOrphanTerms ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
    OPTIONAL { $this effortless-ntwf:orphanTermCount ?orphan_term_count . }
                BIND((COALESCE(?orphan_term_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_IsMachineAccessible" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMachineAccessible ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
    OPTIONAL { $this effortless-ntwf:publicationFormat ?publication_format . OPTIONAL { ?publication_format effortless-ntwf:__key ?publication_format__key . } }
    OPTIONAL { $this effortless-ntwf:schemeUri ?scheme_uri . OPTIONAL { ?scheme_uri effortless-ntwf:__key ?scheme_uri__key . } }
                BIND((COALESCE((COALESCE(?scheme_uri__key, COALESCE(IF(isIRI(?scheme_uri), REPLACE(STR(?scheme_uri), "^.*[#/]", ""), STR(?scheme_uri)), "")) != ""), false) && COALESCE((COALESCE(?publication_format__key, COALESCE(IF(isIRI(?publication_format), REPLACE(STR(?publication_format), "^.*[#/]", ""), STR(?publication_format)), "")) = "SKOS Turtle"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_ManagedSchemeProcedureKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:managedSchemeProcedureKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
    OPTIONAL { $this effortless-ntwf:establishedAt ?established_at . OPTIONAL { ?established_at effortless-ntwf:__key ?established_at__key . } }
    OPTIONAL { $this effortless-ntwf:governingRole ?governing_role . OPTIONAL { ?governing_role effortless-ntwf:__key ?governing_role__key . } }
    OPTIONAL { $this effortless-ntwf:governsProcedure ?governs_procedure . }
                BIND(IF(COALESCE((COALESCE((COALESCE(?governing_role__key, COALESCE(IF(isIRI(?governing_role), REPLACE(STR(?governing_role), "^.*[#/]", ""), STR(?governing_role)), "")) != ""), false) && COALESCE((COALESCE(?established_at__key, COALESCE(IF(isIRI(?established_at), REPLACE(STR(?established_at), "^.*[#/]", ""), STR(?established_at)), "")) != ""), false)), false), ?governs_procedure, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_OrganizedTranscriptCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:organizedTranscriptCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CollectedSourceMaterials .
                    ?child effortless-ntwf:organizedIntoScheme $this .
                    OPTIONAL { ?child effortless-ntwf:materialKind ?c2 . }
                    FILTER((STR(?c2) = "Transcript"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_OrganizedFieldNotesCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:organizedFieldNotesCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CollectedSourceMaterials .
                    ?child effortless-ntwf:organizedIntoScheme $this .
                    OPTIONAL { ?child effortless-ntwf:materialKind ?c2 . }
                    FILTER((STR(?c2) = "FieldNotes"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_OrganizedProcessMapCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:organizedProcessMapCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CollectedSourceMaterials .
                    ?child effortless-ntwf:organizedIntoScheme $this .
                    OPTIONAL { ?child effortless-ntwf:materialKind ?c2 . }
                    FILTER((STR(?c2) = "ProcessMap"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_OrganizedMinedEventTraceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:organizedMinedEventTraceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CollectedSourceMaterials .
                    ?child effortless-ntwf:organizedIntoScheme $this .
                    OPTIONAL { ?child effortless-ntwf:materialKind ?c2 . }
                    FILTER((STR(?c2) = "MinedEventTrace"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_OrganizedDocumentExcerptCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:organizedDocumentExcerptCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CollectedSourceMaterials .
                    ?child effortless-ntwf:organizedIntoScheme $this .
                    OPTIONAL { ?child effortless-ntwf:materialKind ?c2 . }
                    FILTER((STR(?c2) = "DocumentExcerpt"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_OrganizedMaterialCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:organizedMaterialCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CollectedSourceMaterials .
                    ?child effortless-ntwf:organizedIntoScheme $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_OrganizedKindCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:organizedKindCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
    OPTIONAL { $this effortless-ntwf:organizedDocumentExcerptCount ?organized_document_excerpt_count . }
    OPTIONAL { $this effortless-ntwf:organizedFieldNotesCount ?organized_field_notes_count . }
    OPTIONAL { $this effortless-ntwf:organizedMinedEventTraceCount ?organized_mined_event_trace_count . }
    OPTIONAL { $this effortless-ntwf:organizedProcessMapCount ?organized_process_map_count . }
    OPTIONAL { $this effortless-ntwf:organizedTranscriptCount ?organized_transcript_count . }
                BIND(ROUND(((((IF(COALESCE((COALESCE(?organized_transcript_count, 0) > 0), false), 1, 0) + IF(COALESCE((COALESCE(?organized_field_notes_count, 0) > 0), false), 1, 0)) + IF(COALESCE((COALESCE(?organized_process_map_count, 0) > 0), false), 1, 0)) + IF(COALESCE((COALESCE(?organized_mined_event_trace_count, 0) > 0), false), 1, 0)) + IF(COALESCE((COALESCE(?organized_document_excerpt_count, 0) > 0), false), 1, 0))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_IsSingleKindFrame" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSingleKindFrame ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
    OPTIONAL { $this effortless-ntwf:organizedKindCount ?organized_kind_count . }
    OPTIONAL { $this effortless-ntwf:organizedMaterialCount ?organized_material_count . }
                BIND((COALESCE((COALESCE(?organized_material_count, 0) >= 2), false) && COALESCE((COALESCE(?organized_kind_count, 0) = 1), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_LatestOrganizedMaterialAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestOrganizedMaterialAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:CollectedSourceMaterials .
                    ?child effortless-ntwf:organizedIntoScheme $this .
                    OPTIONAL { ?child effortless-ntwf:collectedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_RefinementCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:refinementCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SchemeRefinements .
                    ?child effortless-ntwf:vocabulary $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_IsFrozenDespiteNewCollection" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFrozenDespiteNewCollection ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
    OPTIONAL { $this effortless-ntwf:establishedAt ?established_at . OPTIONAL { ?established_at effortless-ntwf:__key ?established_at__key . } }
    OPTIONAL { $this effortless-ntwf:latestOrganizedMaterialAt ?latest_organized_material_at . OPTIONAL { ?latest_organized_material_at effortless-ntwf:__key ?latest_organized_material_at__key . } }
    OPTIONAL { $this effortless-ntwf:refinementCount ?refinement_count . }
                BIND((COALESCE((COALESCE(?established_at__key, COALESCE(IF(isIRI(?established_at), REPLACE(STR(?established_at), "^.*[#/]", ""), STR(?established_at)), "")) != ""), false) && COALESCE((COALESCE(?latest_organized_material_at__key, COALESCE(IF(isIRI(?latest_organized_material_at), REPLACE(STR(?latest_organized_material_at), "^.*[#/]", ""), STR(?latest_organized_material_at)), "")) != ""), false) && COALESCE(COALESCE((?latest_organized_material_at > ?established_at), false), false) && COALESCE((COALESCE(?refinement_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_OntologyPrecededVocabularyControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ontologyPrecededVocabularyControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
    OPTIONAL { $this effortless-ntwf:establishedAt ?established_at . OPTIONAL { ?established_at effortless-ntwf:__key ?established_at__key . } }
    OPTIONAL { $this effortless-ntwf:ontologyModelingStartedAt ?ontology_modeling_started_at . OPTIONAL { ?ontology_modeling_started_at effortless-ntwf:__key ?ontology_modeling_started_at__key . } }
                BIND((COALESCE((COALESCE(?ontology_modeling_started_at__key, COALESCE(IF(isIRI(?ontology_modeling_started_at), REPLACE(STR(?ontology_modeling_started_at), "^.*[#/]", ""), STR(?ontology_modeling_started_at)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?established_at__key, COALESCE(IF(isIRI(?established_at), REPLACE(STR(?established_at), "^.*[#/]", ""), STR(?established_at)), "")) = ""), false) || COALESCE(COALESCE((?ontology_modeling_started_at < ?established_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for VocabularyTerms ===
effortless-ntwf:VocabularyTermsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:VocabularyTerms ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
    OPTIONAL { $this effortless-ntwf:prefLabel ?pref_label . }
                BIND(?pref_label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_UsageCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:usageCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Requirements .
                    ?child effortless-ntwf:controlledTerm $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_IsOrphanTerm" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOrphanTerm ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
    OPTIONAL { $this effortless-ntwf:usageCount ?usage_count . }
                BIND((COALESCE(?usage_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_IsWidelyAdoptedTerm" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWidelyAdoptedTerm ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
    OPTIONAL { $this effortless-ntwf:usageCount ?usage_count . }
                BIND((COALESCE(?usage_count, 0) >= 2) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_OrphanTermVocabularyKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:orphanTermVocabularyKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
    OPTIONAL { $this effortless-ntwf:isOrphanTerm ?is_orphan_term . }
    OPTIONAL { $this effortless-ntwf:vocabulary ?vocabulary . }
                BIND(IF(COALESCE(?is_orphan_term, false), ?vocabulary, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_BroaderTermParent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:broaderTermParent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
                OPTIONAL { $this effortless-ntwf:broaderTerm ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:VocabularyTerms ; effortless-ntwf:vocabularyTermId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:broaderTerm ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_SchemeGovernedDimension" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:schemeGovernedDimension ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
                OPTIONAL { $this effortless-ntwf:vocabulary ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Vocabularies ; effortless-ntwf:vocabularyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:governedDimension ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_IntroducedReleaseIssuedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:introducedReleaseIssuedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
                OPTIONAL { $this effortless-ntwf:introducedInRelease ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookReleases ; effortless-ntwf:rulebookReleaseId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:issuedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_LatestMeaningChangeAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestMeaningChangeAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:TermMeaningChanges .
                    ?child effortless-ntwf:vocabularyTerm $this .
                    OPTIONAL { ?child effortless-ntwf:changedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_HasStaleDefinition" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasStaleDefinition ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
    OPTIONAL { $this effortless-ntwf:definitionRevisedAt ?definition_revised_at . OPTIONAL { ?definition_revised_at effortless-ntwf:__key ?definition_revised_at__key . } }
    OPTIONAL { $this effortless-ntwf:latestMeaningChangeAt ?latest_meaning_change_at . OPTIONAL { ?latest_meaning_change_at effortless-ntwf:__key ?latest_meaning_change_at__key . } }
                BIND((COALESCE((COALESCE(?latest_meaning_change_at__key, COALESCE(IF(isIRI(?latest_meaning_change_at), REPLACE(STR(?latest_meaning_change_at), "^.*[#/]", ""), STR(?latest_meaning_change_at)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?definition_revised_at__key, COALESCE(IF(isIRI(?definition_revised_at), REPLACE(STR(?definition_revised_at), "^.*[#/]", ""), STR(?definition_revised_at)), "")) = ""), false) || COALESCE(COALESCE((?definition_revised_at < ?latest_meaning_change_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_StructuralShiftCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:structuralShiftCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TermMeaningChanges .
                    ?child effortless-ntwf:vocabularyTerm $this .
                    OPTIONAL { ?child effortless-ntwf:isStructuralChange ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:spanDays ?c4 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER((BOUND(?c4) && xsd:double(STR(?c4)) >= 700))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_HasStructuralSenseShiftAcrossYears" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasStructuralSenseShiftAcrossYears ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
    OPTIONAL { $this effortless-ntwf:structuralShiftCount ?structural_shift_count . }
                BIND((COALESCE(?structural_shift_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_PrefLabelPractitionerMentionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:prefLabelPractitionerMentionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:TermLabelVariants .
                    ?child effortless-ntwf:vocabularyTerm $this .
                    OPTIONAL { ?child effortless-ntwf:labelKind ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:practitionerMentionCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER((STR(?c2) = "pref"))
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_AltLabelPractitionerMentionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:altLabelPractitionerMentionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:TermLabelVariants .
                    ?child effortless-ntwf:vocabularyTerm $this .
                    OPTIONAL { ?child effortless-ntwf:labelKind ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:practitionerMentionCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER((STR(?c2) = "alt"))
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_IsOrganizedAroundOfficialTerm" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOrganizedAroundOfficialTerm ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
    OPTIONAL { $this effortless-ntwf:altLabelPractitionerMentionCount ?alt_label_practitioner_mention_count . }
    OPTIONAL { $this effortless-ntwf:prefLabelPractitionerMentionCount ?pref_label_practitioner_mention_count . }
                BIND((COALESCE((COALESCE(?alt_label_practitioner_mention_count, 0) >= 2), false) && COALESCE((COALESCE(?alt_label_practitioner_mention_count, 0) > COALESCE(?pref_label_practitioner_mention_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_SourcePhrasingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourcePhrasingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SourceTermMentions .
                    ?child effortless-ntwf:intendedTerm $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_UnreconciledPhrasingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unreconciledPhrasingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SourceTermMentions .
                    ?child effortless-ntwf:unresolvedIntendedTermKey ?backfk .
                    $this effortless-ntwf:vocabularyTermId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_HasUnreconciledVariantPhrasings" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasUnreconciledVariantPhrasings ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
    OPTIONAL { $this effortless-ntwf:sourcePhrasingCount ?source_phrasing_count . }
    OPTIONAL { $this effortless-ntwf:unreconciledPhrasingCount ?unreconciled_phrasing_count . }
                BIND((COALESCE((COALESCE(?source_phrasing_count, 0) >= 2), false) && COALESCE((COALESCE(?unreconciled_phrasing_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for WitnessLoops ===
effortless-ntwf:WitnessLoopsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:WitnessLoops ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WitnessLoops_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:WitnessLoops .
    OPTIONAL { $this effortless-ntwf:loopNumber ?loop_number . OPTIONAL { ?loop_number effortless-ntwf:__key ?loop_number__key . } }
    OPTIONAL { $this effortless-ntwf:title ?title . OPTIONAL { ?title effortless-ntwf:__key ?title__key . } }
                BIND(CONCAT("Loop ", COALESCE(COALESCE(?loop_number__key, IF(isIRI(?loop_number), REPLACE(STR(?loop_number), "^.*[#/]", ""), STR(?loop_number))), ""), ": ", COALESCE(COALESCE(?title__key, IF(isIRI(?title), REPLACE(STR(?title), "^.*[#/]", ""), STR(?title))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WitnessLoops_QuestionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:questionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:WitnessLoops .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleQuestions .
                    ?child effortless-ntwf:witnessLoop $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WitnessLoops_IsComplete" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isComplete ?_result .
            }
            WHERE {
    $this a effortless-ntwf:WitnessLoops .
    OPTIONAL { $this effortless-ntwf:completedAt ?completed_at . OPTIONAL { ?completed_at effortless-ntwf:__key ?completed_at__key . } }
                BIND((COALESCE(?completed_at__key, COALESCE(IF(isIRI(?completed_at), REPLACE(STR(?completed_at), "^.*[#/]", ""), STR(?completed_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for WorkflowViewDivergences ===
effortless-ntwf:WorkflowViewDivergencesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:WorkflowViewDivergences ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WorkflowViewDivergences_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:WorkflowViewDivergences .
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
    OPTIONAL { $this effortless-ntwf:viewA ?view_a . }
    OPTIONAL { $this effortless-ntwf:viewB ?view_b . }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?view_a), 1, 40)), REPLACE(STR(SUBSTR(STR(?view_a), 1, 40)), "^.*[#/]", ""), STR(SUBSTR(STR(?view_a), 1, 40))), ""), " / ", COALESCE(IF(isIRI(SUBSTR(STR(?view_b), 1, 40)), REPLACE(STR(SUBSTR(STR(?view_b), 1, 40)), "^.*[#/]", ""), STR(SUBSTR(STR(?view_b), 1, 40))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WorkflowViewDivergences_IsReconciled" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isReconciled ?_result .
            }
            WHERE {
    $this a effortless-ntwf:WorkflowViewDivergences .
    OPTIONAL { $this effortless-ntwf:reconciledStatement ?reconciled_statement . OPTIONAL { ?reconciled_statement effortless-ntwf:__key ?reconciled_statement__key . } }
                BIND((COALESCE(?reconciled_statement__key, COALESCE(IF(isIRI(?reconciled_statement), REPLACE(STR(?reconciled_statement), "^.*[#/]", ""), STR(?reconciled_statement)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WorkflowViewDivergences_IsSurfacedButUnreconciled" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSurfacedButUnreconciled ?_result .
            }
            WHERE {
    $this a effortless-ntwf:WorkflowViewDivergences .
    OPTIONAL { $this effortless-ntwf:reconciledStatement ?reconciled_statement . OPTIONAL { ?reconciled_statement effortless-ntwf:__key ?reconciled_statement__key . } }
    OPTIONAL { $this effortless-ntwf:viewA ?view_a . OPTIONAL { ?view_a effortless-ntwf:__key ?view_a__key . } }
    OPTIONAL { $this effortless-ntwf:viewB ?view_b . OPTIONAL { ?view_b effortless-ntwf:__key ?view_b__key . } }
                BIND((COALESCE((COALESCE(?view_a__key, COALESCE(IF(isIRI(?view_a), REPLACE(STR(?view_a), "^.*[#/]", ""), STR(?view_a)), "")) != ""), false) && COALESCE((COALESCE(?view_b__key, COALESCE(IF(isIRI(?view_b), REPLACE(STR(?view_b), "^.*[#/]", ""), STR(?view_b)), "")) != ""), false) && COALESCE((COALESCE(?reconciled_statement__key, COALESCE(IF(isIRI(?reconciled_statement), REPLACE(STR(?reconciled_statement), "^.*[#/]", ""), STR(?reconciled_statement)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Cardinality: single-valued forward FK properties ===
effortless-ntwf:AccessDenialTestsCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AccessDenialTests ;
    sh:property [ sh:path effortless-ntwf:principal ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:targetPolicy ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:targetTable ; sh:maxCount 1 ] .

effortless-ntwf:AccessPoliciesCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AccessPolicies ;
    sh:property [ sh:path effortless-ntwf:principal ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:targetTable ; sh:maxCount 1 ] .

effortless-ntwf:AccessPrincipalsCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AccessPrincipals ;
    sh:property [ sh:path effortless-ntwf:domainRole ; sh:maxCount 1 ] .

effortless-ntwf:ActivityRelationsCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ActivityRelations ;
    sh:property [ sh:path effortless-ntwf:fromStep ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:relationType ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:toStep ; sh:maxCount 1 ] .

effortless-ntwf:AgentDecisionRecordsCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AgentDecisionRecords ;
    sh:property [ sh:path effortless-ntwf:decidingAgent ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:reviewedByAgent ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:stepExecution ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:underRoleAssignment ; sh:maxCount 1 ] .

effortless-ntwf:AgentIntegrationsCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AgentIntegrations ;
    sh:property [ sh:path effortless-ntwf:agent ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:knowledgeSystem ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:pathway ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:servesSnapshot ; sh:maxCount 1 ] .

effortless-ntwf:AgentUpgradeAssessmentsCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AgentUpgradeAssessments ;
    sh:property [ sh:path effortless-ntwf:assessedByAgent ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:candidateAgent ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:currentAgent ; sh:maxCount 1 ] .

effortless-ntwf:AgentsCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Agents ;
    sh:property [ sh:path effortless-ntwf:organization ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:representsOrganization ; sh:maxCount 1 ] .

effortless-ntwf:AiAdoptionInitiativesCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AiAdoptionInitiatives ;
    sh:property [ sh:path effortless-ntwf:agent ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:evaluationContext ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:organization ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:precedingInitiative ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:targetProcedure ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:targetVersion ; sh:maxCount 1 ] .

effortless-ntwf:AiAgentAccountabilitiesCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AiAgentAccountabilities ;
