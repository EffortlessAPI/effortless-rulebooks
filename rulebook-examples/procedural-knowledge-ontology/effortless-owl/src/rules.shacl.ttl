            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:policyCommandDisagrees ?_result .
            }
            WHERE {
    $this a pko-extension:AppAction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:operation ?operation . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:policy ?policy . OPTIONAL { ?policy erb:key ?policy__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:policyCommand ?policy_command . }
                BIND((COALESCE((COALESCE(?policy__key, COALESCE(IF(isIRI(?policy), REPLACE(STR(?policy), "^.*[#/]", ""), STR(?policy)), "")) != ""), false) && COALESCE(COALESCE((?operation != ?policy_command), !((!BOUND(?operation) || STR(?operation) = "") && (!BOUND(?policy_command) || STR(?policy_command) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .
