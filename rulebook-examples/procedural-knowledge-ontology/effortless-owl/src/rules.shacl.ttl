            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:criticalIncidentCount ?critical_incident_count . }
    OPTIONAL { $this effortless-ntwf:tacitJudgmentFragmentCount ?tacit_judgment_fragment_count . }
                BIND((COALESCE((COALESCE(?tacit_judgment_fragment_count, 0) > 0), false) && COALESCE((COALESCE(?critical_incident_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_SmeApprovalCount" ;
