                BIND((COALESCE(?controlled_term__key, COALESCE(IF(isIRI(?controlled_term), REPLACE(STR(?controlled_term), "^.*[#/]", ""), STR(?controlled_term)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_IsRegulatoryRequirement a sh:NodeShape ;
