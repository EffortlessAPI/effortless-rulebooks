            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:vocabularyPassCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeValidationRuns .
                    ?child effortless-ntwf:modelChangeRequest $this .
                    OPTIONAL { ?child effortless-ntwf:vocabularyCheckOutcome ?c2 . }
                    FILTER((STR(?c2) = "Pass"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_AcceptedWithoutTestRun" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:acceptedWithoutTestRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
    OPTIONAL { $this effortless-ntwf:isAccepted ?is_accepted . }
    OPTIONAL { $this effortless-ntwf:isModelingChange ?is_modeling_change . }
    OPTIONAL { $this effortless-ntwf:validationRunCount ?validation_run_count . }
                BIND((COALESCE(?is_accepted, false) && COALESCE(?is_modeling_change, false) && COALESCE((COALESCE(?validation_run_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_AcceptedWithFailingSuite" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:acceptedWithFailingSuite ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelChangeRequests .
    OPTIONAL { $this effortless-ntwf:acceptanceFailureTotal ?acceptance_failure_total . }
    OPTIONAL { $this effortless-ntwf:isAccepted ?is_accepted . }
                BIND((COALESCE(?is_accepted, false) && COALESCE((COALESCE(?acceptance_failure_total, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_AcceptedWithoutStructuralCheck" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
