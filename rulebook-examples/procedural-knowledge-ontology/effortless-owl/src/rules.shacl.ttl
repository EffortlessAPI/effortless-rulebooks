    OPTIONAL { $this effortless-ntwf:isCompleted ?is_completed . }
    OPTIONAL { $this effortless-ntwf:stepRequiresHumanConfirmation ?step_requires_human_confirmation . }
                BIND((COALESCE(?step_requires_human_confirmation, false) && COALESCE(?is_completed, false) && COALESCE((COALESCE(?confirmed_by_agent__key, COALESCE(IF(isIRI(?confirmed_by_agent), REPLACE(STR(?confirmed_by_agent), "^.*[#/]", ""), STR(?confirmed_by_agent)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
