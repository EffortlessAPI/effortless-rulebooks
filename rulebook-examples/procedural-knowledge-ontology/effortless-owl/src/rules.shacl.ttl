    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:measuredBottomLineImpact ?measured_bottom_line_impact . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status_AiAdoptionInitiatives ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "InProduction"), false) && COALESCE((COALESCE(?measured_bottom_line_impact, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiAdoptionInitiatives_FailedWithoutFormalizedKnowledge a sh:NodeShape ;
    sh:targetClass pko-extension:AiAdoptionInitiative ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_FailedWithoutFormalizedKnowledge" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:failedWithoutFormalizedKnowledge ?_result .
            }
            WHERE {
    $this a pko-extension:AiAdoptionInitiative .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:approach ?approach . OPTIONAL { ?approach erb:key ?approach__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:outcome ?outcome . OPTIONAL { ?outcome erb:key ?outcome__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetHasNoExplicitSteps ?target_has_no_explicit_steps . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:targetProcedure ?target_procedure . OPTIONAL { ?target_procedure erb:key ?target_procedure__key . } }
                BIND((COALESCE((COALESCE(?outcome__key, COALESCE(IF(isIRI(?outcome), REPLACE(STR(?outcome), "^.*[#/]", ""), STR(?outcome)), "")) = "Failed"), false) && COALESCE((COALESCE(?approach__key, COALESCE(IF(isIRI(?approach), REPLACE(STR(?approach), "^.*[#/]", ""), STR(?approach)), "")) = "PromptOnly"), false) && COALESCE((COALESCE((COALESCE(?target_procedure__key, COALESCE(IF(isIRI(?target_procedure), REPLACE(STR(?target_procedure), "^.*[#/]", ""), STR(?target_procedure)), "")) = ""), false) || COALESCE((COALESCE((COALESCE(?target_procedure__key, COALESCE(IF(isIRI(?target_procedure), REPLACE(STR(?target_procedure), "^.*[#/]", ""), STR(?target_procedure)), "")) != ""), false) && COALESCE(?target_has_no_explicit_steps, false)), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for AiAgentAccountabilities ===
pko-native-procedural-knowledge-rulebook-shapes:AiAgentAccountabilities_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AiAgentAccountability ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAgentAccountabilities_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AiAgentAccountability .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:accountableAgent ?accountable_agent . OPTIONAL { ?accountable_agent erb:key ?accountable_agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:aiAgent ?ai_agent . OPTIONAL { ?ai_agent erb:key ?ai_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?ai_agent__key, IF(isIRI(?ai_agent), REPLACE(STR(?ai_agent), "^.*[#/]", ""), STR(?ai_agent))), ""), " accountable to ", COALESCE(COALESCE(?accountable_agent__key, IF(isIRI(?accountable_agent), REPLACE(STR(?accountable_agent), "^.*[#/]", ""), STR(?accountable_agent))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiAgentAccountabilities_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-extension:AiAgentAccountability ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAgentAccountabilities_AsOfInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-extension:AiAgentAccountability .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiAgentAccountabilities_IsCurrent a sh:NodeShape ;
    sh:targetClass pko-extension:AiAgentAccountability ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAgentAccountabilities_IsCurrent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isCurrent ?_result .
            }
            WHERE {
    $this a pko-extension:AiAgentAccountability .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validFrom ?valid_from . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validTo ?valid_to . OPTIONAL { ?valid_to erb:key ?valid_to__key . } }
                BIND((COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiAgentAccountabilities_AccountableAgentKind a sh:NodeShape ;
    sh:targetClass pko-extension:AiAgentAccountability ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAgentAccountabilities_AccountableAgentKind" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
