            WHERE {
    $this a pko-industry:Machine .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:unisolatedEnergySourceCount ?unisolated_energy_source_count . }
                BIND((COALESCE(?unisolated_energy_source_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Mentorships ===
pko-native-procedural-knowledge-rulebook-shapes:Mentorships_Name a sh:NodeShape ;
    sh:targetClass pko-extension:Mentorship ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Mentorships_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:Mentorship .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:learnerAgent ?learner_agent . OPTIONAL { ?learner_agent erb:key ?learner_agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:mentorAgent ?mentor_agent . OPTIONAL { ?mentor_agent erb:key ?mentor_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?mentor_agent__key, IF(isIRI(?mentor_agent), REPLACE(STR(?mentor_agent), "^.*[#/]", ""), STR(?mentor_agent))), ""), " -> ", COALESCE(COALESCE(?learner_agent__key, IF(isIRI(?learner_agent), REPLACE(STR(?learner_agent), "^.*[#/]", ""), STR(?learner_agent))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Mentorships_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-extension:Mentorship ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Mentorships_AsOfInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-extension:Mentorship .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Mentorships_IsActive a sh:NodeShape ;
    sh:targetClass pko-extension:Mentorship ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Mentorships_IsActive" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isActive ?_result .
            }
            WHERE {
    $this a pko-extension:Mentorship .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validFrom ?valid_from . OPTIONAL { ?valid_from erb:key ?valid_from__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validTo ?valid_to . OPTIONAL { ?valid_to erb:key ?valid_to__key . } }
                BIND((COALESCE((COALESCE(?valid_from__key, COALESCE(IF(isIRI(?valid_from), REPLACE(STR(?valid_from), "^.*[#/]", ""), STR(?valid_from)), "")) != ""), false) && COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = ""), false) || COALESCE(COALESCE((?valid_to >= ?as_of_instant), ((!BOUND(?valid_to) || STR(?valid_to) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Mentorships_DaysSinceStarted a sh:NodeShape ;
    sh:targetClass pko-extension:Mentorship ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Mentorships_DaysSinceStarted" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceStarted ?_result .
            }
            WHERE {
    $this a pko-extension:Mentorship .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validFrom ?valid_from . OPTIONAL { ?valid_from erb:key ?valid_from__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?valid_from__key, COALESCE(IF(isIRI(?valid_from), REPLACE(STR(?valid_from), "^.*[#/]", ""), STR(?valid_from)), "")) = ""), false), 99999, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?valid_from) + FLOOR((153 * (MONTH(?valid_from) + 12 * FLOOR((14 - MONTH(?valid_from)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 4) - FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 100) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Mentorships_IsRecentApprenticeship a sh:NodeShape ;
    sh:targetClass pko-extension:Mentorship ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Mentorships_IsRecentApprenticeship" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isRecentApprenticeship ?_result .
            }
            WHERE {
    $this a pko-extension:Mentorship .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceStarted ?days_since_started . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:mentorshipForm ?mentorship_form . OPTIONAL { ?mentorship_form erb:key ?mentorship_form__key . } }
                BIND((COALESCE((COALESCE(?mentorship_form__key, COALESCE(IF(isIRI(?mentorship_form), REPLACE(STR(?mentorship_form), "^.*[#/]", ""), STR(?mentorship_form)), "")) = "Apprenticeship"), false) && COALESCE((COALESCE(?days_since_started, 0) >= 0), false) && COALESCE((COALESCE(?days_since_started, 0) <= 1095), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Mentorships_CommunityLabel a sh:NodeShape ;
    sh:targetClass pko-extension:Mentorship ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Mentorships_CommunityLabel" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:communityLabel ?_result .
            }
            WHERE {
    $this a pko-extension:Mentorship .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:communityOfPractice ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:CommunityOfPractice . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for MessageDeliveries ===
pko-native-procedural-knowledge-rulebook-shapes:MessageDeliveries_Name a sh:NodeShape ;
    sh:targetClass pko-extension:MessageDelivery ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:messageTemplate ?message_template . OPTIONAL { ?message_template erb:key ?message_template__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recipient ?recipient . OPTIONAL { ?recipient erb:key ?recipient__key . } }
