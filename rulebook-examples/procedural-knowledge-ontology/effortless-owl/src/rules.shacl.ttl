            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersionLinks .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:previousProcedureVersion ?previous_procedure_version . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:relationIri ?relation_iri . OPTIONAL { ?relation_iri erb:key ?relation_iri__key . } }
                BIND(IF(COALESCE((COALESCE(?relation_iri__key, COALESCE(IF(isIRI(?relation_iri), REPLACE(STR(?relation_iri), "^.*[#/]", ""), STR(?relation_iri)), "")) = "https://w3id.org/pko#nextVersion"), false), ?previous_procedure_version, "") AS ?_result)
            }
        """ ;
    ] .

