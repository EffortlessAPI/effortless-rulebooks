                BIND((COALESCE((COALESCE(?authority_role__key, COALESCE(IF(isIRI(?authority_role), REPLACE(STR(?authority_role), "^.*[#/]", ""), STR(?authority_role)), "")) = "hr-policy-owner"), false) && COALESCE(?awaits_authority_decision, false)) AS ?_result)
