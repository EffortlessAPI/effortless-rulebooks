pko-native-procedural-knowledge-rulebook-shapes:ExecutionEntities_VariableExpectedFormat a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ExecutionEntities ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExecutionEntities_VariableExpectedFormat" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:variableExpectedFormat ?_result .
            }
            WHERE {
