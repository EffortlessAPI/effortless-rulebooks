                $this pko-native-procedural-knowledge-rulebook:hasSmsConsent ?_result .
            }
            WHERE {
    $this a pko-extension:Recipient .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:smsConsentStatus ?sms_consent_status . OPTIONAL { ?sms_consent_status erb:key ?sms_consent_status__key . } }
                BIND((COALESCE(?sms_consent_status__key, COALESCE(IF(isIRI(?sms_consent_status), REPLACE(STR(?sms_consent_status), "^.*[#/]", ""), STR(?sms_consent_status)), "")) = "Granted") AS ?_result)
            }
