    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), "|", COALESCE(COALESCE(?change_layer__key, IF(isIRI(?change_layer), REPLACE(STR(?change_layer), "^.*[#/]", ""), STR(?change_layer))), "")) AS ?_result)
            }
