pko-native-procedural-knowledge-rulebook-shapes:ExternalStandardTerms_IsRehomedWithoutIdentityLink a sh:NodeShape ;
    sh:targetClass pko-extension:ExternalStandardTerm ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_IsRehomedWithoutIdentityLink" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isRehomedWithoutIdentityLink ?_result .
            }
            WHERE {
    $this a pko-extension:ExternalStandardTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rehomedAsTerm ?rehomed_as_term . OPTIONAL { ?rehomed_as_term erb:key ?rehomed_as_term__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rehomedTermSameAs ?rehomed_term_same_as . OPTIONAL { ?rehomed_term_same_as erb:key ?rehomed_term_same_as__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:termIri ?term_iri . }
                BIND((COALESCE((COALESCE(?rehomed_as_term__key, COALESCE(IF(isIRI(?rehomed_as_term), REPLACE(STR(?rehomed_as_term), "^.*[#/]", ""), STR(?rehomed_as_term)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?rehomed_term_same_as__key, COALESCE(IF(isIRI(?rehomed_term_same_as), REPLACE(STR(?rehomed_term_same_as), "^.*[#/]", ""), STR(?rehomed_term_same_as)), "")) = ""), false) || COALESCE(COALESCE((?rehomed_term_same_as != ?term_iri), !((!BOUND(?rehomed_term_same_as) || STR(?rehomed_term_same_as) = "") && (!BOUND(?term_iri) || STR(?term_iri) = ""))), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExternalStandardTerms_IsRehomedWithoutNewRelease a sh:NodeShape ;
    sh:targetClass pko-extension:ExternalStandardTerm ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_IsRehomedWithoutNewRelease" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isRehomedWithoutNewRelease ?_result .
            }
            WHERE {
    $this a pko-extension:ExternalStandardTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deprecatedAt ?deprecated_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rehomedAsTerm ?rehomed_as_term . OPTIONAL { ?rehomed_as_term erb:key ?rehomed_as_term__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rehomedTermReleaseIssuedAt ?rehomed_term_release_issued_at . OPTIONAL { ?rehomed_term_release_issued_at erb:key ?rehomed_term_release_issued_at__key . } }
                BIND((COALESCE((COALESCE(?rehomed_as_term__key, COALESCE(IF(isIRI(?rehomed_as_term), REPLACE(STR(?rehomed_as_term), "^.*[#/]", ""), STR(?rehomed_as_term)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?rehomed_term_release_issued_at__key, COALESCE(IF(isIRI(?rehomed_term_release_issued_at), REPLACE(STR(?rehomed_term_release_issued_at), "^.*[#/]", ""), STR(?rehomed_term_release_issued_at)), "")) = ""), false) || COALESCE(COALESCE((?rehomed_term_release_issued_at < ?deprecated_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExternalStandardTerms_HasUnpropagatedIdentifierChange a sh:NodeShape ;
    sh:targetClass pko-extension:ExternalStandardTerm ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_HasUnpropagatedIdentifierChange" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasUnpropagatedIdentifierChange ?_result .
            }
            WHERE {
    $this a pko-extension:ExternalStandardTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:previousTermIri ?previous_term_iri . OPTIONAL { ?previous_term_iri erb:key ?previous_term_iri__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:staleIdentifierMappingCount ?stale_identifier_mapping_count . }
                BIND((COALESCE((COALESCE(?previous_term_iri__key, COALESCE(IF(isIRI(?previous_term_iri), REPLACE(STR(?previous_term_iri), "^.*[#/]", ""), STR(?previous_term_iri)), "")) != ""), false) && COALESCE((COALESCE(?stale_identifier_mapping_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExternalStandardTerms_RehomingKeptExternalNamespace a sh:NodeShape ;
    sh:targetClass pko-extension:ExternalStandardTerm ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_RehomingKeptExternalNamespace" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:rehomingKeptExternalNamespace ?_result .
            }
            WHERE {
    $this a pko-extension:ExternalStandardTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:profileNamespaceIri ?profile_namespace_iri . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rehomedAsTerm ?rehomed_as_term . OPTIONAL { ?rehomed_as_term erb:key ?rehomed_as_term__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:rehomedTermNamespace ?rehomed_term_namespace . }
                BIND((COALESCE((COALESCE(?rehomed_as_term__key, COALESCE(IF(isIRI(?rehomed_as_term), REPLACE(STR(?rehomed_as_term), "^.*[#/]", ""), STR(?rehomed_as_term)), "")) != ""), false) && COALESCE(COALESCE((?rehomed_term_namespace = ?profile_namespace_iri), ((!BOUND(?rehomed_term_namespace) || STR(?rehomed_term_namespace) = "") && (!BOUND(?profile_namespace_iri) || STR(?profile_namespace_iri) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for FAQs ===
pko-native-procedural-knowledge-rulebook-shapes:FAQs_Name a sh:NodeShape ;
    sh:targetClass pko:FrequentlyAskedQuestion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FAQs_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:FrequentlyAskedQuestion .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:question_FAQs ?question . }
                BIND(?question AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:FAQs_ResolutionCount a sh:NodeShape ;
    sh:targetClass pko:FrequentlyAskedQuestion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FAQs_ResolutionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:resolutionCount ?_result .
            }
            WHERE {
    $this a pko:FrequentlyAskedQuestion .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:FrequentlyAskedQuestion .
                    ?child a pko:UserQuestionOccurrence .
                    ?child pko-native-procedural-knowledge-rulebook:resolvedByFaq $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:FAQs_IsUnusedFaq a sh:NodeShape ;
    sh:targetClass pko:FrequentlyAskedQuestion ;
    sh:order 2 ;
    sh:rule [
