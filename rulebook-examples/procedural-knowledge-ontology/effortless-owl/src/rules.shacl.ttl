    $this a pko-native-procedural-knowledge-rulebook:StepRequirements .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:bindingWasEverExercised ?binding_was_ever_exercised . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requirementIsBlocking ?requirement_is_blocking . }
                BIND((COALESCE(?requirement_is_blocking, false) && COALESCE((!(COALESCE(?binding_was_ever_exercised, false))), false)) AS ?_result)
            }
        """ ;
    ] .
