    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:separationWasTestable ?separation_was_testable . }
                BIND((COALESCE(?separation_was_testable, false) && COALESCE(?separation_of_duties_held, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_SeparationIsVacuouslyGreen a sh:NodeShape ;
