        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:ownerOrganization ?_result .
            }
            WHERE {
    $this a p-plan:Step .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:ProcedureVersions . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:ownerOrganization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for StewardActivities ===
pko-native-procedural-knowledge-rulebook-shapes:StewardActivities_Name a sh:NodeShape ;
    sh:targetClass pko-extension:StewardActivity ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardActivities_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:StewardActivity .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:dutyKind ?duty_kind . OPTIONAL { ?duty_kind erb:key ?duty_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelCharter ?model_charter . OPTIONAL { ?model_charter erb:key ?model_charter__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_charter__key, IF(isIRI(?model_charter), REPLACE(STR(?model_charter), "^.*[#/]", ""), STR(?model_charter))), ""), " ", COALESCE(COALESCE(?duty_kind__key, IF(isIRI(?duty_kind), REPLACE(STR(?duty_kind), "^.*[#/]", ""), STR(?duty_kind))), "")) AS ?_result)
            }
        """ ;
    ] .
