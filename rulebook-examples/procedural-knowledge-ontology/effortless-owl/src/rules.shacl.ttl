    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:trailingPracticeTraceCount ?trailing_practice_trace_count . }
                BIND((COALESCE(?trailing_practice_trace_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_TacitFragmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:tacitFragmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeFragments .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:knowledgeForm ?c2 . }
                    FILTER((STR(?c2) = "Tacit"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsStandardizedWithoutTacitCapture" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStandardizedWithoutTacitCapture ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:standardizationDriver ?standardization_driver . OPTIONAL { ?standardization_driver effortless-ntwf:__key ?standardization_driver__key . } }
    OPTIONAL { $this effortless-ntwf:tacitFragmentCount ?tacit_fragment_count . }
                BIND((COALESCE((COALESCE(?standardization_driver__key, COALESCE(IF(isIRI(?standardization_driver), REPLACE(STR(?standardization_driver), "^.*[#/]", ""), STR(?standardization_driver)), "")) = "Compliance"), false) && COALESCE((COALESCE(?tacit_fragment_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_TacitFormFragmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:tacitFormFragmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeFragments .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:knowledgeForm ?c2 . }
                    FILTER((STR(?c2) = "Tacit"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_SituatedJudgmentFragmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:situatedJudgmentFragmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeFragments .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:knowledgeForm ?c2 . }
                    FILTER((STR(?c2) = "SituatedJudgment"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_TacitJudgmentFragmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:tacitJudgmentFragmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:situatedJudgmentFragmentCount ?situated_judgment_fragment_count . }
    OPTIONAL { $this effortless-ntwf:tacitFormFragmentCount ?tacit_form_fragment_count . }
                BIND(ROUND((?tacit_form_fragment_count + ?situated_judgment_fragment_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_FirstStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:firstStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:declaredFirstStepKey ?sumraw . }
                    BIND(STR(?sumraw) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_FallbackStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fallbackStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:declaredFallbackStepKey ?sumraw . }
                    BIND(STR(?sumraw) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_FirstStepDisagreesWithGraph" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:firstStepDisagreesWithGraph ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:declaredFirstStepCount ?declared_first_step_count . }
    OPTIONAL { $this effortless-ntwf:entryStepId ?entry_step_id . }
    OPTIONAL { $this effortless-ntwf:firstStep ?first_step . }
    OPTIONAL { $this effortless-ntwf:graphEntryStepCount ?graph_entry_step_count . }
                BIND((COALESCE((COALESCE(?declared_first_step_count, 0) > 0), false) && COALESCE((COALESCE(?graph_entry_step_count, 0) > 0), false) && COALESCE(COALESCE((?first_step != ?entry_step_id), !((!BOUND(?first_step) || STR(?first_step) = "") && (!BOUND(?entry_step_id) || STR(?entry_step_id) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_DeclaredFirstStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:declaredFirstStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:isDeclaredFirstStep ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_GraphEntryStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:graphEntryStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:isEntryStep ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for Procedures ===
effortless-ntwf:ProceduresShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Procedures ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_ExecutionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:executionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:ProcedureVersions .
                    ?child effortless-ntwf:procedure $this .
                    OPTIONAL { ?child effortless-ntwf:executionCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_IsTemplateInstance" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isTemplateInstance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:templateProcedure ?template_procedure . OPTIONAL { ?template_procedure effortless-ntwf:__key ?template_procedure__key . } }
                BIND((COALESCE(?template_procedure__key, COALESCE(IF(isIRI(?template_procedure), REPLACE(STR(?template_procedure), "^.*[#/]", ""), STR(?template_procedure)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_TargetCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:targetCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureTargets .
                    ?child effortless-ntwf:procedure $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_AdoptionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:adoptionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureAdoptions .
                    ?child effortless-ntwf:procedure $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_SpecifiedStepTotal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:specifiedStepTotal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:ProcedureVersions .
                    ?child effortless-ntwf:procedure $this .
                    OPTIONAL { ?child effortless-ntwf:countOfSteps ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_HasNoExplicitSteps" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoExplicitSteps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:specifiedStepTotal ?specified_step_total . }
                BIND((COALESCE(?specified_step_total, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_CalledByStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:calledByStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:callsProcedure $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_IsNestedProcedure" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNestedProcedure ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:calledByStepCount ?called_by_step_count . }
                BIND((COALESCE(?called_by_step_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_FailureCriterionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:failureCriterionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureOutcomeCriteria .
                    ?child effortless-ntwf:failureProcedureKey ?backfk .
                    $this effortless-ntwf:procedureId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_HasNoFailureCriterion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoFailureCriterion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:failureCriterionCount ?failure_criterion_count . }
                BIND((COALESCE(?failure_criterion_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_LensViewCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lensViewCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureLensViews .
                    ?child effortless-ntwf:procedure $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_PrivilegesSingleStakeholderView" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:privilegesSingleStakeholderView ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:lensViewCount ?lens_view_count . }
                BIND((COALESCE(?lens_view_count, 0) = 1) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_StepLevelViewCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepLevelViewCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureLensViews .
                    ?child effortless-ntwf:stepLevelProcedureKey ?backfk .
                    $this effortless-ntwf:procedureId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_CategoryLevelViewCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:categoryLevelViewCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureLensViews .
                    ?child effortless-ntwf:categoryLevelProcedureKey ?backfk .
                    $this effortless-ntwf:procedureId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_ProcedureTypeRank" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:procedureTypeRank ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                OPTIONAL { $this effortless-ntwf:procedureType ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureTypes ; effortless-ntwf:procedureTypeId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:taxonomyRank ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_ProcedureTypeDefinition" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:procedureTypeDefinition ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                OPTIONAL { $this effortless-ntwf:procedureType ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureTypes ; effortless-ntwf:procedureTypeId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:definition ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_HasStepAndCategoryResolutions" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasStepAndCategoryResolutions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:procedureTypeRank ?procedure_type_rank . OPTIONAL { ?procedure_type_rank effortless-ntwf:__key ?procedure_type_rank__key . } }
    OPTIONAL { $this effortless-ntwf:specifiedStepTotal ?specified_step_total . }
                BIND((COALESCE((COALESCE(?specified_step_total, 0) > 0), false) && COALESCE((COALESCE(?procedure_type_rank__key, COALESCE(IF(isIRI(?procedure_type_rank), REPLACE(STR(?procedure_type_rank), "^.*[#/]", ""), STR(?procedure_type_rank)), "")) = "ProcessType"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_IsMissingDemandedResolution" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMissingDemandedResolution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:categoryLevelViewCount ?category_level_view_count . }
    OPTIONAL { $this effortless-ntwf:hasNoExplicitSteps ?has_no_explicit_steps . }
    OPTIONAL { $this effortless-ntwf:procedureType ?procedure_type . OPTIONAL { ?procedure_type effortless-ntwf:__key ?procedure_type__key . } }
    OPTIONAL { $this effortless-ntwf:procedureTypeRank ?procedure_type_rank . OPTIONAL { ?procedure_type_rank effortless-ntwf:__key ?procedure_type_rank__key . } }
    OPTIONAL { $this effortless-ntwf:stepLevelViewCount ?step_level_view_count . }
                BIND((COALESCE((COALESCE((COALESCE(?step_level_view_count, 0) > 0), false) && COALESCE(?has_no_explicit_steps, false)), false) || COALESCE((COALESCE((COALESCE(?category_level_view_count, 0) > 0), false) && COALESCE((COALESCE((COALESCE(?procedure_type__key, COALESCE(IF(isIRI(?procedure_type), REPLACE(STR(?procedure_type), "^.*[#/]", ""), STR(?procedure_type)), "")) = ""), false) || COALESCE((COALESCE(?procedure_type_rank__key, COALESCE(IF(isIRI(?procedure_type_rank), REPLACE(STR(?procedure_type_rank), "^.*[#/]", ""), STR(?procedure_type_rank)), "")) != "ProcessType"), false)), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_IsInconsistentlyCategorized" ;
