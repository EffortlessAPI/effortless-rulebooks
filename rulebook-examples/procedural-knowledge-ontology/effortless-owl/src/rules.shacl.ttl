pko-native-procedural-knowledge-rulebook-shapes:BusinessOutcomes_LinkedMeasureCount a sh:NodeShape ;
    sh:targetClass pko-extension:BusinessOutcome ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BusinessOutcomes_LinkedMeasureCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:linkedMeasureCount ?_result .
            }
            WHERE {
    $this a pko-extension:BusinessOutcome .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:BusinessOutcome .
                    ?child a pko-extension:ProcessOutcomeMeasure .
                    ?child pko-native-procedural-knowledge-rulebook:businessOutcome $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for CapabilityDeclines ===
pko-native-procedural-knowledge-rulebook-shapes:CapabilityDeclines_Name a sh:NodeShape ;
    sh:targetClass pko-extension:CapabilityDecline ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CapabilityDeclines_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:CapabilityDecline .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:organization ?organization . OPTIONAL { ?organization erb:key ?organization__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stage_CapabilityDeclines ?stage . OPTIONAL { ?stage erb:key ?stage__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?organization__key, IF(isIRI(?organization), REPLACE(STR(?organization), "^.*[#/]", ""), STR(?organization))), ""), ": ", COALESCE(COALESCE(?stage__key, IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:CapabilityDeclines_PrecedingStage a sh:NodeShape ;
    sh:targetClass pko-extension:CapabilityDecline ;
