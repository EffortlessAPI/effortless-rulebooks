            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepLockRequirements .
    OPTIONAL { $this effortless-ntwf:lockDevice ?lock_device . OPTIONAL { ?lock_device effortless-ntwf:__key ?lock_device__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?lock_device__key, IF(isIRI(?lock_device), REPLACE(STR(?lock_device), "^.*[#/]", ""), STR(?lock_device))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepProtectiveEquipment ===
effortless-ntwf:StepProtectiveEquipmentShape a sh:NodeShape ;
