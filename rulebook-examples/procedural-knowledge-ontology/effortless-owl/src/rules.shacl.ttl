pko-native-procedural-knowledge-rulebook-shapes:AiModelDeployments_IsLiveInProduction a sh:NodeShape ;
    sh:targetClass pko-extension:AiModelDeployment ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelDeployments_IsLiveInProduction" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isLiveInProduction ?_result .
            }
            WHERE {
    $this a pko-extension:AiModelDeployment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deployedAt ?deployed_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:environment ?environment . OPTIONAL { ?environment erb:key ?environment__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:retiredAt ?retired_at . OPTIONAL { ?retired_at erb:key ?retired_at__key . } }
                BIND((COALESCE((COALESCE(?environment__key, COALESCE(IF(isIRI(?environment), REPLACE(STR(?environment), "^.*[#/]", ""), STR(?environment)), "")) = "Production"), false) && COALESCE(COALESCE((?deployed_at <= ?as_of_instant), ((!BOUND(?deployed_at) || STR(?deployed_at) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?retired_at__key, COALESCE(IF(isIRI(?retired_at), REPLACE(STR(?retired_at), "^.*[#/]", ""), STR(?retired_at)), "")) = ""), false) || COALESCE(COALESCE((?retired_at > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiModelDeployments_AgentIdentifier a sh:NodeShape ;
    sh:targetClass pko-extension:AiModelDeployment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelDeployments_AgentIdentifier" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:agentIdentifier ?_result .
            }
            WHERE {
    $this a pko-extension:AiModelDeployment .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelVersion ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:AiRegistryModelVersion . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:dcIdentifier ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiModelDeployments_AssignmentLinkCount a sh:NodeShape ;
    sh:targetClass pko-extension:AiModelDeployment ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelDeployments_AssignmentLinkCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:assignmentLinkCount ?_result .
            }
            WHERE {
    $this a pko-extension:AiModelDeployment .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AiModelDeployment .
                    ?child a pro:RoleInTime .
                    ?child pko-native-procedural-knowledge-rulebook:agent ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:agentIdentifier ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiModelDeployments_ArtifactLinkCount a sh:NodeShape ;
    sh:targetClass pko-extension:AiModelDeployment ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelDeployments_ArtifactLinkCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:artifactLinkCount ?_result .
            }
            WHERE {
    $this a pko-extension:AiModelDeployment .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:AiModelDeployment .
                    ?child a pko-native-procedural-knowledge-rulebook:ExecutionEntities .
                    ?child pko-native-procedural-knowledge-rulebook:attributedToAgent ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:agentIdentifier ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiModelDeployments_IsIsolatedRegistryFact a sh:NodeShape ;
    sh:targetClass pko-extension:AiModelDeployment ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelDeployments_IsIsolatedRegistryFact" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isIsolatedRegistryFact ?_result .
            }
            WHERE {
    $this a pko-extension:AiModelDeployment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:artifactLinkCount ?artifact_link_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:assignmentLinkCount ?assignment_link_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isLiveInProduction ?is_live_in_production . }
                BIND((COALESCE(?is_live_in_production, false) && COALESCE((COALESCE(?assignment_link_count, 0) = 0), false) && COALESCE((COALESCE(?artifact_link_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for AiModelEvaluations ===
pko-native-procedural-knowledge-rulebook-shapes:AiModelEvaluations_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AiModelEvaluation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelEvaluations_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AiModelEvaluation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:metric ?metric . OPTIONAL { ?metric erb:key ?metric__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelVersion ?model_version . OPTIONAL { ?model_version erb:key ?model_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_version__key, IF(isIRI(?model_version), REPLACE(STR(?model_version), "^.*[#/]", ""), STR(?model_version))), ""), " ", COALESCE(COALESCE(?metric__key, IF(isIRI(?metric), REPLACE(STR(?metric), "^.*[#/]", ""), STR(?metric))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiModelEvaluations_Passed a sh:NodeShape ;
    sh:targetClass pko-extension:AiModelEvaluation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelEvaluations_Passed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:passed ?_result .
            }
            WHERE {
    $this a pko-extension:AiModelEvaluation .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:passThreshold ?pass_threshold . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:score ?score . }
                BIND((COALESCE(?score, 0) >= COALESCE(?pass_threshold, 0)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for AiRegistryModelVersions ===
pko-native-procedural-knowledge-rulebook-shapes:AiRegistryModelVersions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AiRegistryModelVersion ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
