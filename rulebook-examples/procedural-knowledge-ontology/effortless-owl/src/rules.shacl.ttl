            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:approverWasNotified ?approver_was_notified . }
    OPTIONAL { $this effortless-ntwf:refusedOnApprovedContent ?refused_on_approved_content . }
                BIND((COALESCE(?refused_on_approved_content, false) && COALESCE((!(COALESCE(?approver_was_notified, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_HasAlternateChannelAttempt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasAlternateChannelAttempt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:alternateChannelIntent ?alternate_channel_intent . OPTIONAL { ?alternate_channel_intent effortless-ntwf:__key ?alternate_channel_intent__key . } }
                BIND((COALESCE(?alternate_channel_intent__key, COALESCE(IF(isIRI(?alternate_channel_intent), REPLACE(STR(?alternate_channel_intent), "^.*[#/]", ""), STR(?alternate_channel_intent)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_AlternateAttemptWasCleared" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:alternateAttemptWasCleared ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:alternateChannelIntent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:SendIntents ; effortless-ntwf:sendIntentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isClearedToSend ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsRefusedWithNoAlternative" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRefusedWithNoAlternative ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:hasAlternateChannelAttempt ?has_alternate_channel_attempt . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
                BIND((COALESCE((!(COALESCE(?is_cleared_to_send, false))), false) && COALESCE((!(COALESCE(?has_alternate_channel_attempt, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ExceptionPrescribedAnAlternative" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:exceptionPrescribedAnAlternative ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:refusalCitedAnException ?refusal_cited_an_exception . }
    OPTIONAL { $this effortless-ntwf:resultingDeliveryException ?resulting_delivery_exception . OPTIONAL { ?resulting_delivery_exception effortless-ntwf:__key ?resulting_delivery_exception__key . } }
                BIND((COALESCE(?refusal_cited_an_exception, false) && COALESCE((COALESCE(?resulting_delivery_exception__key, COALESCE(IF(isIRI(?resulting_delivery_exception), REPLACE(STR(?resulting_delivery_exception), "^.*[#/]", ""), STR(?resulting_delivery_exception)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_PrescribedHandlingWasPerformed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:prescribedHandlingWasPerformed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:alternateAttemptWasCleared ?alternate_attempt_was_cleared . }
    OPTIONAL { $this effortless-ntwf:exceptionPrescribedAnAlternative ?exception_prescribed_an_alternative . }
    OPTIONAL { $this effortless-ntwf:hasAlternateChannelAttempt ?has_alternate_channel_attempt . }
                BIND((COALESCE(?exception_prescribed_an_alternative, false) && COALESCE((COALESCE(?has_alternate_channel_attempt, false) && COALESCE(?alternate_attempt_was_cleared, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsSuppressionWithoutRemedy" ;
        sh:prefixes effortless-ntwf: ;
