    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recipientIsUnreachable ?recipient_is_unreachable . }
                BIND((COALESCE(?recipient_is_unreachable, false) && COALESCE(?is_acknowledged, false)) AS ?_result)
            }
        """ ;
    ] .
