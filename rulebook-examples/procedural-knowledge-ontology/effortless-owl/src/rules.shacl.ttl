    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsInterestedPartyAssertion" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isInterestedPartyAssertion ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluatorIsStepExecutor ?evaluator_is_step_executor . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluatorOwnsTheRun ?evaluator_owns_the_run . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAssertedOnly ?is_asserted_only . }
                BIND((COALESCE(?is_asserted_only, false) && COALESCE((COALESCE(?evaluator_is_step_executor, false) || COALESCE(?evaluator_owns_the_run, false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_HasWrittenEvidence a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_HasWrittenEvidence" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasWrittenEvidence ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evidence ?evidence . OPTIONAL { ?evidence erb:key ?evidence__key . } }
                BIND((COALESCE(?evidence__key, COALESCE(IF(isIRI(?evidence), REPLACE(STR(?evidence), "^.*[#/]", ""), STR(?evidence)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_IsBareAssertion a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsBareAssertion" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isBareAssertion ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasWrittenEvidence ?has_written_evidence . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAssertedOnly ?is_asserted_only . }
                BIND((COALESCE(?is_asserted_only, false) && COALESCE((!(COALESCE(?has_written_evidence, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_InterestedAssertionExecutionKey a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_InterestedAssertionExecutionKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:interestedAssertionExecutionKey ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isInterestedPartyAssertion ?is_interested_party_assertion . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:parentProcedureExecution ?parent_procedure_execution . }
                BIND(IF(COALESCE(?is_interested_party_assertion, false), ?parent_procedure_execution, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_IsComputedlyWitnessed a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsComputedlyWitnessed" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isComputedlyWitnessed ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requirementHasComputedWitness ?requirement_has_computed_witness . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:requirementIsBlocking ?requirement_is_blocking . }
                BIND((COALESCE(?requirement_is_blocking, false) && COALESCE(?requirement_has_computed_witness, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_ComputedWitnessExecutionKey a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_ComputedWitnessExecutionKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:computedWitnessExecutionKey ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isComputedlyWitnessed ?is_computedly_witnessed . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:parentProcedureExecution ?parent_procedure_execution . }
                BIND(IF(COALESCE(?is_computedly_witnessed, false), ?parent_procedure_execution, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_StepExecutorAgent a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_StepExecutorAgent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:stepExecutorAgent ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepExecution ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:StepExecution . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:executedByAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_WasScoredAfterAttestation a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_WasScoredAfterAttestation" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:wasScoredAfterAttestation ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:attestationInstantForRun ?attestation_instant_for_run . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluatedAt ?evaluated_at . }
                BIND((COALESCE(((((DAY(?evaluated_at) + FLOOR((153 * (MONTH(?evaluated_at) + 12 * FLOOR((14 - MONTH(?evaluated_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 4) - FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 100) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 400) - 32045) - (DAY(?attestation_instant_for_run) + FLOOR((153 * (MONTH(?attestation_instant_for_run) + 12 * FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?attestation_instant_for_run) + 4800 - FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12)) + FLOOR((YEAR(?attestation_instant_for_run) + 4800 - FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12)) / 4) - FLOOR((YEAR(?attestation_instant_for_run) + 4800 - FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12)) / 100) + FLOOR((YEAR(?attestation_instant_for_run) + 4800 - FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?evaluated_at) * 3600 + MINUTES(?evaluated_at) * 60 + SECONDS(?evaluated_at)) - (HOURS(?attestation_instant_for_run) * 3600 + MINUTES(?attestation_instant_for_run) * 60 + SECONDS(?attestation_instant_for_run))) / 60), 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_AttestationInstantForRun a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_AttestationInstantForRun" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:attestationInstantForRun ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:parentProcedureExecution ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko:ProcedureExecution . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:latestAttestationInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RequirementSatisfactions_PostAttestationScoreExecutionKey a sh:NodeShape ;
    sh:targetClass pko:RequirementSatisfaction ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_PostAttestationScoreExecutionKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:postAttestationScoreExecutionKey ?_result .
            }
            WHERE {
    $this a pko:RequirementSatisfaction .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:parentProcedureExecution ?parent_procedure_execution . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wasScoredAfterAttestation ?was_scored_after_attestation . }
                BIND(IF(COALESCE(?was_scored_after_attestation, false), ?parent_procedure_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Rules for Requirements ===
pko-native-procedural-knowledge-rulebook-shapes:Requirements_Name a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_SatisfactionRecordCount a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_SatisfactionRecordCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:satisfactionRecordCount ?_result .
            }
            WHERE {
    $this a pko:Requirement .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:Requirement .
                    ?child a pko:RequirementSatisfaction .
                    ?child pko-native-procedural-knowledge-rulebook:requirement $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_StepBindingCount a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_StepBindingCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:stepBindingCount ?_result .
            }
            WHERE {
    $this a pko:Requirement .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:Requirement .
                    ?child a pko-native-procedural-knowledge-rulebook:StepRequirements .
                    ?child pko-native-procedural-knowledge-rulebook:requirement $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_IsBoundToAnyStep a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsBoundToAnyStep" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isBoundToAnyStep ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:stepBindingCount ?step_binding_count . }
                BIND((COALESCE(?step_binding_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_HasEverBeenEvaluated a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_HasEverBeenEvaluated" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasEverBeenEvaluated ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:satisfactionRecordCount ?satisfaction_record_count . }
                BIND((COALESCE(?satisfaction_record_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_NegativeOutcomeCount a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_NegativeOutcomeCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:negativeOutcomeCount ?_result .
            }
            WHERE {
    $this a pko:Requirement .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:Requirement .
                    ?child a pko:RequirementSatisfaction .
                    ?child pko-native-procedural-knowledge-rulebook:negativeOutcomeRequirementKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:requirementId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_IsInoperativeControl a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsInoperativeControl" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isInoperativeControl ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasEverBeenEvaluated ?has_ever_been_evaluated . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isBlocking ?is_blocking . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isBoundToAnyStep ?is_bound_to_any_step . }
                BIND((COALESCE(?is_blocking, false) && COALESCE(?is_bound_to_any_step, false) && COALESCE((!(COALESCE(?has_ever_been_evaluated, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_IsDecorativeControl a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsDecorativeControl" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDecorativeControl ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isBlocking ?is_blocking . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isBoundToAnyStep ?is_bound_to_any_step . }
                BIND((COALESCE(?is_blocking, false) && COALESCE((!(COALESCE(?is_bound_to_any_step, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_HasEverProducedNegative a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_HasEverProducedNegative" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasEverProducedNegative ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:negativeOutcomeCount ?negative_outcome_count . }
                BIND((COALESCE(?negative_outcome_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_IsUnfalsifiedControl a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsUnfalsifiedControl" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnfalsifiedControl ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasEverBeenEvaluated ?has_ever_been_evaluated . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasEverProducedNegative ?has_ever_produced_negative . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isBlocking ?is_blocking . }
                BIND((COALESCE(?is_blocking, false) && COALESCE(?has_ever_been_evaluated, false) && COALESCE((!(COALESCE(?has_ever_produced_negative, false))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_ClaimsAWitnessField a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_ClaimsAWitnessField" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:claimsAWitnessField ?_result .
            }
            WHERE {
    $this a pko:Requirement .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:witnessFieldName ?witness_field_name . OPTIONAL { ?witness_field_name erb:key ?witness_field_name__key . } }
                BIND((COALESCE(?witness_field_name__key, COALESCE(IF(isIRI(?witness_field_name), REPLACE(STR(?witness_field_name), "^.*[#/]", ""), STR(?witness_field_name)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_NamedWitnessFieldExists a sh:NodeShape ;
    sh:targetClass pko:Requirement ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_NamedWitnessFieldExists" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:namedWitnessFieldExists ?_result .
            }
            WHERE {
    $this a pko:Requirement .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:witnessFieldName ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:RulebookField . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isDerived ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Requirements_DerivedHasComputedWitness a sh:NodeShape ;
