    $this a pko:ProcedureExecution .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:ProcedureExecution .
                    ?child a pko:RequirementSatisfaction .
                    ?child pko-native-procedural-knowledge-rulebook:interestedAssertionExecutionKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:procedureExecutionId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_AssuranceGrade a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AssuranceGrade" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:assuranceGrade ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:computedAssuranceRatio ?computed_assurance_ratio . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluatedControlCount ?evaluated_control_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:interestedPartyAssertionCount ?interested_party_assertion_count . }
                BIND(IF(COALESCE((COALESCE(?evaluated_control_count, 0) = 0), false), "None: no blocking control was evaluated.", IF(COALESCE((COALESCE(?interested_party_assertion_count, 0) > 0), false), "Weak: at least one control rests on an interested-party assertion.", IF(COALESCE((COALESCE(?computed_assurance_ratio, 0) < 0.5), false), "Thin: most controls rest on human assertion.", IF(COALESCE((COALESCE(?computed_assurance_ratio, 0) < 1), false), "Mixed: computed and asserted controls.", "Computed: every evaluated control has a witness.")))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_AttestationWouldBeWeaklyBased a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AttestationWouldBeWeaklyBased" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:attestationWouldBeWeaklyBased ?_result .
            }
            WHERE {
    $this a pko:ProcedureExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:computedAssuranceRatio ?computed_assurance_ratio . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:interestedPartyAssertionCount ?interested_party_assertion_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isAttestationReady ?is_attestation_ready . }
                BIND((COALESCE(?is_attestation_ready, false) && COALESCE((COALESCE((COALESCE(?interested_party_assertion_count, 0) > 0), false) || COALESCE((COALESCE(?computed_assurance_ratio, 0) < 0.5), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureExecutions_IndependentHumanObservationCount a sh:NodeShape ;
    sh:targetClass pko:ProcedureExecution ;
