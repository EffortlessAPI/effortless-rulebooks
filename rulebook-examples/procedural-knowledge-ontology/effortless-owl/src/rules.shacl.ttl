    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:witnessHasNeverFired ?witness_has_never_fired . }
                BIND((COALESCE(?witness_has_never_fired, false) && COALESCE(?has_meaningful_sample, false)) AS ?_result)
            }
