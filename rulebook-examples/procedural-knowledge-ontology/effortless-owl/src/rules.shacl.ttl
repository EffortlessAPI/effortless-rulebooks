    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:approvalDecidedAtSend ?approval_decided_at_send . OPTIONAL { ?approval_decided_at_send erb:key ?approval_decided_at_send__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:approvingAgentAtSend ?approving_agent_at_send . OPTIONAL { ?approving_agent_at_send erb:key ?approving_agent_at_send__key . } }
                BIND((COALESCE((COALESCE(?approving_agent_at_send__key, COALESCE(IF(isIRI(?approving_agent_at_send), REPLACE(STR(?approving_agent_at_send), "^.*[#/]", ""), STR(?approving_agent_at_send)), "")) != ""), false) && COALESCE((COALESCE(?approval_decided_at_send__key, COALESCE(IF(isIRI(?approval_decided_at_send), REPLACE(STR(?approval_decided_at_send), "^.*[#/]", ""), STR(?approval_decided_at_send)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] .
