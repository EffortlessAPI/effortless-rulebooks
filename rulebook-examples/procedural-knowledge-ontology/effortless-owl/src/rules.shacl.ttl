@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix effortless-ntwf: <https://w3id.org/effortless-ntwf#> .

# === Shape with rules for AccessDenialTests ===
effortless-ntwf:AccessDenialTestsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AccessDenialTests ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:forbiddenRowId ?forbidden_row_id . }
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
                BIND(CONCAT(IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal)), " must not see ", IF(isIRI(?forbidden_row_id), REPLACE(STR(?forbidden_row_id), "^.*[#/]", ""), STR(?forbidden_row_id))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_HasRun" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:lastRunAt ?last_run_at . }
                BIND((REPLACE(COALESCE(STR(?last_run_at), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsPassing" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPassing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:expectedVisible ?expected_visible . }
    OPTIONAL { $this effortless-ntwf:observedVisible ?observed_visible . }
                BIND((COALESCE(?observed_visible, false) = COALESCE(?expected_visible, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsLeak" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLeak ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:expectedVisible ?expected_visible . }
    OPTIONAL { $this effortless-ntwf:observedVisible ?observed_visible . }
                BIND((COALESCE((!(COALESCE(?expected_visible, false))), false) && COALESCE(?observed_visible, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsUnproven" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnproven ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:hasRun ?has_run . }
                BIND((!(COALESCE(?has_run, false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsPositiveControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPositiveControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:expectedVisible ?expected_visible . }
                BIND(?expected_visible AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AccessPolicies ===
effortless-ntwf:AccessPoliciesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AccessPolicies ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:command ?command . }
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
    OPTIONAL { $this effortless-ntwf:targetTable ?target_table . }
                BIND(CONCAT(IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal)), " ", IF(isIRI(?command), REPLACE(STR(?command), "^.*[#/]", ""), STR(?command)), " ", IF(isIRI(?target_table), REPLACE(STR(?target_table), "^.*[#/]", ""), STR(?target_table))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsWriteCommand" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWriteCommand ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:command ?command . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?command), ""), "^.*#", "") = "INSERT"), false) || COALESCE((REPLACE(COALESCE(STR(?command), ""), "^.*#", "") = "UPDATE"), false) || COALESCE((REPLACE(COALESCE(STR(?command), ""), "^.*#", "") = "DELETE"), false) || COALESCE((REPLACE(COALESCE(STR(?command), ""), "^.*#", "") = "ALL"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsUnrestricted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnrestricted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:rowPredicate ?row_predicate . }
                BIND((REPLACE(COALESCE(STR(?row_predicate), ""), "^.*#", "") = "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_PrincipalIsAdmin" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:principalIsAdmin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
                OPTIONAL { $this effortless-ntwf:principal ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AccessPrincipals ; effortless-ntwf:accessPrincipalId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isAdministrator ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsUnrestrictedNonAdminGrant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnrestrictedNonAdminGrant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:isUnrestricted ?is_unrestricted . }
    OPTIONAL { $this effortless-ntwf:principalIsAdmin ?principal_is_admin . }
                BIND((COALESCE(?is_unrestricted, false) && COALESCE((!(COALESCE(?principal_is_admin, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsUnwitnessedWrite" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwitnessedWrite ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:denialTestCount ?denial_test_count . }
    OPTIONAL { $this effortless-ntwf:isWriteCommand ?is_write_command . }
                BIND((COALESCE(?is_write_command, false) && COALESCE((COALESCE(?denial_test_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_DenialTestCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:denialTestCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AccessDenialTests .
                    ?child effortless-ntwf:targetPolicy $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for AccessPrincipals ===
effortless-ntwf:AccessPrincipalsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AccessPrincipals ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_OrganizationScope" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:organizationScope ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                OPTIONAL { $this effortless-ntwf:domainRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_RoleLabel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:roleLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                OPTIONAL { $this effortless-ntwf:domainRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_PolicyCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AccessPolicies .
                    ?child effortless-ntwf:principal $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_GrantCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:grantCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FieldGrants .
                    ?child effortless-ntwf:principal $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_VisibleTableCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:visibleTableCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleSchemaViews .
                    ?child effortless-ntwf:principal $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_HasNoAccess" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoAccess ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
    OPTIONAL { $this effortless-ntwf:policyCount ?policy_count . }
                BIND((COALESCE(?policy_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_IsOverPrivileged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOverPrivileged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
    OPTIONAL { $this effortless-ntwf:isAdministrator ?is_administrator . }
    OPTIONAL { $this effortless-ntwf:visibleTableCount ?visible_table_count . }
                BIND((COALESCE((!(COALESCE(?is_administrator, false))), false) && COALESCE((COALESCE(?visible_table_count, 0) >= 74), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Actions ===
effortless-ntwf:ActionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Actions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Actions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Actions .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AgentDecisionRecords ===
effortless-ntwf:AgentDecisionRecordsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AgentDecisionRecords ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:decisionSummary ?decision_summary . }
                BIND(CONCAT(IF(isIRI(?deciding_agent), REPLACE(STR(?deciding_agent), "^.*[#/]", ""), STR(?deciding_agent)), ": ", IF(isIRI(SUBSTR(STR(?decision_summary), 1, 60)), REPLACE(STR(SUBSTR(STR(?decision_summary), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?decision_summary), 1, 60)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_WasOverridden" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasOverridden ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:humanDisposition ?human_disposition . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?human_disposition), ""), "^.*#", "") = "Corrected"), false) || COALESCE((REPLACE(COALESCE(STR(?human_disposition), ""), "^.*#", "") = "Reversed"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_WasReviewed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasReviewed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:humanDisposition ?human_disposition . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?human_disposition), ""), "^.*#", "") != ""), false) && COALESCE((REPLACE(COALESCE(STR(?human_disposition), ""), "^.*#", "") != "NotReviewed"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_DecidingAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:decidingAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
                OPTIONAL { $this effortless-ntwf:decidingAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_DecidingAgentWhenOverridden" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:decidingAgentWhenOverridden ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND(IF(COALESCE(?was_overridden, false), ?deciding_agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_RoleAssignmentWhenScored" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:roleAssignmentWhenScored ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:underRoleAssignment ?under_role_assignment . }
                BIND(IF(COALESCE((REPLACE(COALESCE(STR(?under_role_assignment), ""), "^.*#", "") != ""), false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_RoleAssignmentWhenOverridden" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:roleAssignmentWhenOverridden ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:underRoleAssignment ?under_role_assignment . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND(IF(COALESCE(?was_overridden, false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_StepOfDecision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepOfDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_BoundaryMatchKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryMatchKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgentKind ?deciding_agent_kind . }
    OPTIONAL { $this effortless-ntwf:decisionKind ?decision_kind . }
    OPTIONAL { $this effortless-ntwf:stepOfDecision ?step_of_decision . }
                BIND(CONCAT(IF(isIRI(?step_of_decision), REPLACE(STR(?step_of_decision), "^.*[#/]", ""), STR(?step_of_decision)), "|", IF(isIRI(?deciding_agent_kind), REPLACE(STR(?deciding_agent_kind), "^.*[#/]", ""), STR(?deciding_agent_kind)), "|", IF(isIRI(?decision_kind), REPLACE(STR(?decision_kind), "^.*[#/]", ""), STR(?decision_kind))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_MatchingBoundaryCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:matchingBoundaryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AuthorityBoundaries .
                    ?child effortless-ntwf:boundaryMatchKey ?backfk .
                    $this effortless-ntwf:boundaryMatchKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_ViolatedAuthorityBoundary" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:violatedAuthorityBoundary ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:matchingBoundaryCount ?matching_boundary_count . }
                BIND((COALESCE(?matching_boundary_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_ReviewerAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reviewerAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
                OPTIONAL { $this effortless-ntwf:reviewedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_HasHumanConfirmation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasHumanConfirmation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:humanDisposition ?human_disposition . }
    OPTIONAL { $this effortless-ntwf:reviewerAgentKind ?reviewer_agent_kind . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?reviewer_agent_kind), ""), "^.*#", "") = "Human"), false) && COALESCE((REPLACE(COALESCE(STR(?human_disposition), ""), "^.*#", "") != ""), false) && COALESCE((REPLACE(COALESCE(STR(?human_disposition), ""), "^.*#", "") != "NotReviewed"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_NeedsHumanConfirmation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:needsHumanConfirmation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgentKind ?deciding_agent_kind . }
    OPTIONAL { $this effortless-ntwf:materialityBand ?materiality_band . }
                BIND((COALESCE((!(COALESCE((REPLACE(COALESCE(STR(?deciding_agent_kind), ""), "^.*#", "") = "Human"), false))), false) && COALESCE((COALESCE((REPLACE(COALESCE(STR(?materiality_band), ""), "^.*#", "") = "Material"), false) || COALESCE((REPLACE(COALESCE(STR(?materiality_band), ""), "^.*#", "") = "Escalated"), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsUnconfirmedNonHumanDecision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnconfirmedNonHumanDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:hasHumanConfirmation ?has_human_confirmation . }
    OPTIONAL { $this effortless-ntwf:needsHumanConfirmation ?needs_human_confirmation . }
                BIND((COALESCE(?needs_human_confirmation, false) && COALESCE((!(COALESCE(?has_human_confirmation, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_StepExecutionWhenUnconfirmed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepExecutionWhenUnconfirmed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:isUnconfirmedNonHumanDecision ?is_unconfirmed_non_human_decision . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_unconfirmed_non_human_decision, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_AgentWhenBoundaryViolated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentWhenBoundaryViolated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:violatedAuthorityBoundary ?violated_authority_boundary . }
                BIND(IF(COALESCE(?violated_authority_boundary, false), ?deciding_agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_ReviewLatencyMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reviewLatencyMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . }
    OPTIONAL { $this effortless-ntwf:reviewedAt ?reviewed_at . }
                BIND(IF(COALESCE((REPLACE(COALESCE(STR(?reviewed_at), ""), "^.*#", "") = ""), false), 0, ((((DAY(?reviewed_at) + FLOOR((153 * (MONTH(?reviewed_at) + 12 * FLOOR((14 - MONTH(?reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?reviewed_at) * 3600 + MINUTES(?reviewed_at) * 60 + SECONDS(?reviewed_at)) - (HOURS(?decided_at) * 3600 + MINUTES(?decided_at) * 60 + SECONDS(?decided_at))) / 60)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsDraftKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDraftKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decisionKind ?decision_kind . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?decision_kind), ""), "^.*#", "") = "Draft"), false) || COALESCE((REPLACE(COALESCE(STR(?decision_kind), ""), "^.*#", "") = "Commitment"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_AgentWhenDraftOverridden" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentWhenDraftOverridden ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:isDraftKind ?is_draft_kind . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND(IF(COALESCE((COALESCE(?is_draft_kind, false) && COALESCE(?was_overridden, false)), false), ?deciding_agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_AgentWhenDraft" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentWhenDraft ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:isDraftKind ?is_draft_kind . }
                BIND(IF(COALESCE(?is_draft_kind, false), ?deciding_agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsErrorCorrection" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isErrorCorrection ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:overrideReasonKind ?override_reason_kind . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND((COALESCE(?was_overridden, false) && COALESCE((REPLACE(COALESCE(STR(?override_reason_kind), ""), "^.*#", "") = "ErrorCorrection"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsReservedJudgmentOverride" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isReservedJudgmentOverride ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:overrideReasonKind ?override_reason_kind . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND((COALESCE(?was_overridden, false) && COALESCE((REPLACE(COALESCE(STR(?override_reason_kind), ""), "^.*#", "") = "JudgmentReserved"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_OverrideReasonIsRecorded" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overrideReasonIsRecorded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:overrideReasonKind ?override_reason_kind . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND((COALESCE(?was_overridden, false) && COALESCE((REPLACE(COALESCE(STR(?override_reason_kind), ""), "^.*#", "") != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsUnexplainedOverride" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnexplainedOverride ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:overrideReasonIsRecorded ?override_reason_is_recorded . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND((COALESCE(?was_overridden, false) && COALESCE((!(COALESCE(?override_reason_is_recorded, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_ErrorCorrectionRoleAssignmentKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:errorCorrectionRoleAssignmentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:isErrorCorrection ?is_error_correction . }
    OPTIONAL { $this effortless-ntwf:underRoleAssignment ?under_role_assignment . }
                BIND(IF(COALESCE(?is_error_correction, false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_BoundaryViolationRoleAssignmentKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryViolationRoleAssignmentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:underRoleAssignment ?under_role_assignment . }
    OPTIONAL { $this effortless-ntwf:violatedAuthorityBoundary ?violated_authority_boundary . }
                BIND(IF(COALESCE(?violated_authority_boundary, false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Agents ===
effortless-ntwf:AgentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Agents ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_CountOfCurrentRoleAssignments" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfCurrentRoleAssignments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:currentAgentKey ?backfk .
                    $this effortless-ntwf:agentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_IsStillEngaged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:countOfCurrentRoleAssignments ?count_of_current_role_assignments . }
                BIND((COALESCE(?count_of_current_role_assignments, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_DecisionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:decisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:decidingAgent $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_OverriddenDecisionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overriddenDecisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:decidingAgentWhenOverridden ?backfk .
                    $this effortless-ntwf:agentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_OverrideRatePercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overrideRatePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:decisionCount ?decision_count . }
    OPTIONAL { $this effortless-ntwf:overriddenDecisionCount ?overridden_decision_count . }
                BIND(IF(COALESCE((COALESCE(?decision_count, 0) = 0), false), 0, ((?overridden_decision_count * 100) / ?decision_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_IsNonHuman" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNonHuman ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:agentKind ?agent_kind . }
                BIND((!(COALESCE((REPLACE(COALESCE(STR(?agent_kind), ""), "^.*#", "") = "Human"), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_BoundaryViolationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryViolationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:agentWhenBoundaryViolated ?backfk .
                    $this effortless-ntwf:agentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_IsOperatingOutsideBoundary" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOperatingOutsideBoundary ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:boundaryViolationCount ?boundary_violation_count . }
                BIND((COALESCE(?boundary_violation_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_DraftDecisionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:draftDecisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:agentWhenDraft ?backfk .
                    $this effortless-ntwf:agentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_OverriddenDraftCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overriddenDraftCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:agentWhenDraftOverridden ?backfk .
                    $this effortless-ntwf:agentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_DraftRewriteRatePercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:draftRewriteRatePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:draftDecisionCount ?draft_decision_count . }
    OPTIONAL { $this effortless-ntwf:overriddenDraftCount ?overridden_draft_count . }
                BIND(IF(COALESCE((COALESCE(?draft_decision_count, 0) = 0), false), 0, ((?overridden_draft_count * 100) / ?draft_decision_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_TimesNamedAsBroker" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:timesNamedAsBroker ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeBrokerLinks .
                    ?child effortless-ntwf:activeRelianceBrokerKey ?backfk .
                    $this effortless-ntwf:agentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_IsRecognizedBroker" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRecognizedBroker ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:timesNamedAsBroker ?times_named_as_broker . }
                BIND((COALESCE(?times_named_as_broker, 0) >= 3) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_AtRiskRelianceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:atRiskRelianceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeBrokerLinks .
                    ?child effortless-ntwf:atRiskBrokerKey ?backfk .
                    $this effortless-ntwf:agentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_HasAtRiskKnowledgeReliance" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasAtRiskKnowledgeReliance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:atRiskRelianceCount ?at_risk_reliance_count . }
                BIND((COALESCE(?at_risk_reliance_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AppNavGroups ===
effortless-ntwf:AppNavGroupsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppNavGroups ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppNavGroups_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppNavGroups .
    OPTIONAL { $this effortless-ntwf:groupLabel ?group_label . }
                BIND(?group_label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppNavGroups_RouteCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:routeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppNavGroups .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AppRoutes .
                    ?child effortless-ntwf:navGroup $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for AppRoleProfiles ===
effortless-ntwf:AppRoleProfilesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppRoleProfiles ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoleProfiles_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoleProfiles .
    OPTIONAL { $this effortless-ntwf:displayLabel ?display_label . }
    OPTIONAL { $this effortless-ntwf:roleKind ?role_kind . }
                BIND(CONCAT(IF(isIRI(?display_label), REPLACE(STR(?display_label), "^.*[#/]", ""), STR(?display_label)), " (", IF(isIRI(?role_kind), REPLACE(STR(?role_kind), "^.*[#/]", ""), STR(?role_kind)), ")") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoleProfiles_RouteCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:routeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoleProfiles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AppRoutes .
                    ?child effortless-ntwf:owningRole $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for AppRouteQuestions ===
effortless-ntwf:AppRouteQuestionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppRouteQuestions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRouteQuestions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRouteQuestions .
    OPTIONAL { $this effortless-ntwf:question ?question . }
    OPTIONAL { $this effortless-ntwf:route ?route . }
                BIND(CONCAT(IF(isIRI(?route), REPLACE(STR(?route), "^.*[#/]", ""), STR(?route)), " answers ", IF(isIRI(?question), REPLACE(STR(?question), "^.*[#/]", ""), STR(?question))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AppRouteReferences ===
effortless-ntwf:AppRouteReferencesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppRouteReferences ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRouteReferences_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRouteReferences .
    OPTIONAL { $this effortless-ntwf:fromRoute ?from_route . }
    OPTIONAL { $this effortless-ntwf:toRoute ?to_route . }
                BIND(CONCAT(IF(isIRI(?from_route), REPLACE(STR(?from_route), "^.*[#/]", ""), STR(?from_route)), " -> ", IF(isIRI(?to_route), REPLACE(STR(?to_route), "^.*[#/]", ""), STR(?to_route))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AppRoutes ===
effortless-ntwf:AppRoutesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppRoutes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:routeName ?route_name . }
    OPTIONAL { $this effortless-ntwf:routePath ?route_path . }
                BIND(CONCAT(IF(isIRI(?route_name), REPLACE(STR(?route_name), "^.*[#/]", ""), STR(?route_name)), " — ", IF(isIRI(?route_path), REPLACE(STR(?route_path), "^.*[#/]", ""), STR(?route_path))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_IsInNav" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInNav ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:navGroup ?nav_group . }
                BIND((REPLACE(COALESCE(STR(?nav_group), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_IsShared" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isShared ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:owningRole ?owning_role . }
    OPTIONAL { $this effortless-ntwf:surface ?surface . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?owning_role), ""), "^.*#", "") = ""), false) && COALESCE((REPLACE(COALESCE(STR(?surface), ""), "^.*#", "") = "domain"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_IsMaintainer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMaintainer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:surface ?surface . }
                BIND((REPLACE(COALESCE(STR(?surface), ""), "^.*#", "") = "maintainer") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_QuestionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:questionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AppRouteQuestions .
                    ?child effortless-ntwf:route $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_ReferenceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:referenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AppRouteReferences .
                    ?child effortless-ntwf:fromRoute $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_AnswersNoQuestion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:answersNoQuestion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:isMaintainer ?is_maintainer . }
    OPTIONAL { $this effortless-ntwf:isShared ?is_shared . }
    OPTIONAL { $this effortless-ntwf:questionCount ?question_count . }
    OPTIONAL { $this effortless-ntwf:routeKind ?route_kind . }
                BIND((COALESCE((COALESCE(?question_count, 0) = 0), false) && COALESCE((COALESCE(?is_shared, false) = false), false) && COALESCE((COALESCE(?is_maintainer, false) = false), false) && COALESCE((REPLACE(COALESCE(STR(?route_kind), ""), "^.*#", "") != "index"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AppUsers ===
effortless-ntwf:AppUsersShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppUsers ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
    OPTIONAL { $this effortless-ntwf:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_AgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
                OPTIONAL { $this effortless-ntwf:linkedAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_Organization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:organization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
                OPTIONAL { $this effortless-ntwf:linkedAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_AssignmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:PrincipalAssignments .
                    ?child effortless-ntwf:appUser $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_HasNoPrincipal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoPrincipal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
    OPTIONAL { $this effortless-ntwf:assignmentCount ?assignment_count . }
                BIND((COALESCE(?assignment_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_HoldsMultiplePrincipals" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:holdsMultiplePrincipals ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
    OPTIONAL { $this effortless-ntwf:assignmentCount ?assignment_count . }
                BIND((COALESCE(?assignment_count, 0) > 1) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_IsNonHumanSignIn" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNonHumanSignIn ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
    OPTIONAL { $this effortless-ntwf:agentKind ?agent_kind . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?agent_kind), ""), "^.*#", "") = "AIAgent"), false) || COALESCE((REPLACE(COALESCE(STR(?agent_kind), ""), "^.*#", "") = "AutomatedPipeline"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Attestations ===
effortless-ntwf:AttestationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Attestations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
    OPTIONAL { $this effortless-ntwf:attestationId ?attestation_id . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(CONCAT(IF(isIRI(?procedure_execution), REPLACE(STR(?procedure_execution), "^.*[#/]", ""), STR(?procedure_execution)), " / ", IF(isIRI(?attestation_id), REPLACE(STR(?attestation_id), "^.*[#/]", ""), STR(?attestation_id))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_VersionIsFitNow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:versionIsFitNow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
                OPTIONAL { $this effortless-ntwf:procedureExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureExecutions ; effortless-ntwf:procedureExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:executedVersionIsFit ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_FitnessVerdictHasDrifted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fitnessVerdictHasDrifted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
    OPTIONAL { $this effortless-ntwf:versionIsFitNow ?version_is_fit_now . }
    OPTIONAL { $this effortless-ntwf:versionWasFitAtSigning ?version_was_fit_at_signing . }
                BIND((!(COALESCE((COALESCE(?version_was_fit_at_signing, false) = COALESCE(?version_is_fit_now, false)), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_AssuranceGradeNow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assuranceGradeNow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
                OPTIONAL { $this effortless-ntwf:procedureExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureExecutions ; effortless-ntwf:procedureExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:assuranceGrade ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_AssuranceGradeHasDrifted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assuranceGradeHasDrifted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
    OPTIONAL { $this effortless-ntwf:assuranceGradeAtSigning ?assurance_grade_at_signing . }
    OPTIONAL { $this effortless-ntwf:assuranceGradeNow ?assurance_grade_now . }
                BIND((!(COALESCE(COALESCE((?assurance_grade_at_signing = ?assurance_grade_now), ((!BOUND(?assurance_grade_at_signing) || STR(?assurance_grade_at_signing) = "") && (!BOUND(?assurance_grade_now) || STR(?assurance_grade_now) = ""))), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_WouldNotSurviveRestatement" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wouldNotSurviveRestatement ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
    OPTIONAL { $this effortless-ntwf:assuranceGradeHasDrifted ?assurance_grade_has_drifted . }
    OPTIONAL { $this effortless-ntwf:fitnessVerdictHasDrifted ?fitness_verdict_has_drifted . }
                BIND((COALESCE(?fitness_verdict_has_drifted, false) || COALESCE(?assurance_grade_has_drifted, false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AuthorityBoundaries ===
effortless-ntwf:AuthorityBoundariesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AuthorityBoundaries ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:forbiddenAgentKind ?forbidden_agent_kind . }
    OPTIONAL { $this effortless-ntwf:forbiddenDecisionKind ?forbidden_decision_kind . }
                BIND(CONCAT(IF(isIRI(?forbidden_agent_kind), REPLACE(STR(?forbidden_agent_kind), "^.*[#/]", ""), STR(?forbidden_agent_kind)), " may not ", IF(isIRI(?forbidden_decision_kind), REPLACE(STR(?forbidden_decision_kind), "^.*[#/]", ""), STR(?forbidden_decision_kind))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsCurrentlyBinding" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrentlyBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved"), false) && COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentIsValid" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentIsValid ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isCurrentlyValid ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_StepWhenBinding" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepWhenBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_currently_binding, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_BoundaryMatchKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryMatchKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:forbiddenAgentKind ?forbidden_agent_kind . }
    OPTIONAL { $this effortless-ntwf:forbiddenDecisionKind ?forbidden_decision_kind . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(CONCAT(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step)), "|", IF(isIRI(?forbidden_agent_kind), REPLACE(STR(?forbidden_agent_kind), "^.*[#/]", ""), STR(?forbidden_agent_kind)), "|", IF(isIRI(?forbidden_decision_kind), REPLACE(STR(?forbidden_decision_kind), "^.*[#/]", ""), STR(?forbidden_decision_kind))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_ViolationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:violationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    ?child effortless-ntwf:boundaryMatchKey ?backfk .
                    $this effortless-ntwf:boundaryMatchKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsUntested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUntested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:violationCount ?violation_count . }
                BIND((COALESCE(?is_currently_binding, false) && COALESCE((COALESCE(?violation_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_HasRatifyingFragment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasRatifyingFragment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?ratified_by_knowledge_fragment . }
                BIND((REPLACE(COALESCE(STR(?ratified_by_knowledge_fragment), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsUnwarranted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwarranted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:hasRatifyingFragment ?has_ratifying_fragment . }
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:ratifyingFragmentIsValid ?ratifying_fragment_is_valid . }
                BIND((COALESCE(?is_currently_binding, false) && COALESCE((COALESCE((!(COALESCE(?has_ratifying_fragment, false))), false) || COALESCE((!(COALESCE(?ratifying_fragment_is_valid, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentIsOverdue" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentIsOverdue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isOverdueForReview ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentIsSingleWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentIsSingleWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isFromSingleWitness ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_WarrantIsThin" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:warrantIsThin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:ratifyingFragmentIsOverdue ?ratifying_fragment_is_overdue . }
    OPTIONAL { $this effortless-ntwf:ratifyingFragmentIsSingleWitness ?ratifying_fragment_is_single_witness . }
                BIND((COALESCE(?is_currently_binding, false) && COALESCE((COALESCE(?ratifying_fragment_is_overdue, false) || COALESCE(?ratifying_fragment_is_single_witness, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsUnwarrantedAndUntested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwarrantedAndUntested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isUntested ?is_untested . }
    OPTIONAL { $this effortless-ntwf:isUnwarranted ?is_unwarranted . }
                BIND((COALESCE(?is_unwarranted, false) && COALESCE(?is_untested, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_UnwarrantedBoundaryStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unwarrantedBoundaryStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isUnwarranted ?is_unwarranted . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_unwarranted, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?ratified_by_knowledge_fragment . }
                BIND(IF(COALESCE(?is_currently_binding, false), ?ratified_by_knowledge_fragment, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentStatus" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentStatus ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:status ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatificationLapsed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ratificationLapsed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:hasRatifyingFragment ?has_ratifying_fragment . }
    OPTIONAL { $this effortless-ntwf:ratifyingFragmentIsValid ?ratifying_fragment_is_valid . }
                BIND((COALESCE(?has_ratifying_fragment, false) && COALESCE((!(COALESCE(?ratifying_fragment_is_valid, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_BindsDespiteLapsedRatification" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:bindsDespiteLapsedRatification ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:ratificationLapsed ?ratification_lapsed . }
                BIND((COALESCE(?is_currently_binding, false) && COALESCE(?ratification_lapsed, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsUngroundedAndUntested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUngroundedAndUntested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:bindsDespiteLapsedRatification ?binds_despite_lapsed_ratification . }
    OPTIONAL { $this effortless-ntwf:isUntested ?is_untested . }
                BIND((COALESCE(?binds_despite_lapsed_ratification, false) && COALESCE(?is_untested, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_ConstrainedRoleAssignmentKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:constrainedRoleAssignmentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:authorityRole ?authority_role . }
    OPTIONAL { $this effortless-ntwf:bindsDespiteLapsedRatification ?binds_despite_lapsed_ratification . }
                BIND(IF(COALESCE(?binds_despite_lapsed_ratification, false), ?authority_role, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for BindingObservations ===
effortless-ntwf:BindingObservationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:BindingObservations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
    OPTIONAL { $this effortless-ntwf:bindingObservationId ?binding_observation_id . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(CONCAT(IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution)), " / ", IF(isIRI(?binding_observation_id), REPLACE(STR(?binding_observation_id), "^.*[#/]", ""), STR(?binding_observation_id))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_SlaMinutesAtRun" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:slaMinutesAtRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
                OPTIONAL { $this effortless-ntwf:operationalBinding ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:OperationalBindings ; effortless-ntwf:operationalBindingId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:freshnessSlaMinutes ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_AgeAtRunMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ageAtRunMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
    OPTIONAL { $this effortless-ntwf:observedSourceTimestamp ?observed_source_timestamp . }
    OPTIONAL { $this effortless-ntwf:readAt ?read_at . }
                BIND(ROUND(((((DAY(?read_at) + FLOOR((153 * (MONTH(?read_at) + 12 * FLOOR((14 - MONTH(?read_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) + FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 4) - FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 100) + FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 400) - 32045) - (DAY(?observed_source_timestamp) + FLOOR((153 * (MONTH(?observed_source_timestamp) + 12 * FLOOR((14 - MONTH(?observed_source_timestamp)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) + FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 4) - FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 100) + FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?read_at) * 3600 + MINUTES(?read_at) * 60 + SECONDS(?read_at)) - (HOURS(?observed_source_timestamp) * 3600 + MINUTES(?observed_source_timestamp) * 60 + SECONDS(?observed_source_timestamp))) / 60)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_WasStaleAtRun" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasStaleAtRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
    OPTIONAL { $this effortless-ntwf:ageAtRunMinutes ?age_at_run_minutes . }
    OPTIONAL { $this effortless-ntwf:isAuthoritativeBinding ?is_authoritative_binding . }
    OPTIONAL { $this effortless-ntwf:slaMinutesAtRun ?sla_minutes_at_run . }
                BIND((COALESCE(?is_authoritative_binding, false) && COALESCE((COALESCE(?age_at_run_minutes, 0) > COALESCE(?sla_minutes_at_run, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_IsAuthoritativeBinding" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAuthoritativeBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
                OPTIONAL { $this effortless-ntwf:operationalBinding ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:OperationalBindings ; effortless-ntwf:operationalBindingId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isAuthoritative ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_StaleAtRunStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:staleAtRunStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
    OPTIONAL { $this effortless-ntwf:wasStaleAtRun ?was_stale_at_run . }
                BIND(IF(COALESCE(?was_stale_at_run, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CellDisagreements ===
effortless-ntwf:CellDisagreementsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CellDisagreements ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CellDisagreements_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CellDisagreements .
    OPTIONAL { $this effortless-ntwf:fieldDisagreement ?field_disagreement . }
    OPTIONAL { $this effortless-ntwf:recordId ?record_id . }
                BIND(CONCAT(IF(isIRI(?field_disagreement), REPLACE(STR(?field_disagreement), "^.*[#/]", ""), STR(?field_disagreement)), " @ ", IF(isIRI(?record_id), REPLACE(STR(?record_id), "^.*[#/]", ""), STR(?record_id))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CellDisagreements_Substrate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:substrate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CellDisagreements .
                OPTIONAL { $this effortless-ntwf:fieldDisagreement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:FieldDisagreements ; effortless-ntwf:fieldDisagreementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:substrate ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CellDisagreements_RulebookField" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:rulebookField ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CellDisagreements .
                OPTIONAL { $this effortless-ntwf:fieldDisagreement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:FieldDisagreements ; effortless-ntwf:fieldDisagreementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:rulebookField ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ChangeRequests ===
effortless-ntwf:ChangeRequestsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ChangeRequests ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsOpen" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOpen ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:implementedAt ?implemented_at . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((COALESCE((COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Draft"), false) || COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "UnderReview"), false) || COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved"), false)), false) && COALESCE((REPLACE(COALESCE(STR(?implemented_at), ""), "^.*#", "") = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_OpenChangeVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:openChangeVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isOpen ?is_open . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_open, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsDecided" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDecided ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . }
                BIND((REPLACE(COALESCE(STR(?decided_at), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_DaysPending" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysPending ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . }
    OPTIONAL { $this effortless-ntwf:isDecided ?is_decided . }
    OPTIONAL { $this effortless-ntwf:requestedAt ?requested_at . }
                BIND(ROUND(IF(COALESCE(?is_decided, false), ((DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsStillPending" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
