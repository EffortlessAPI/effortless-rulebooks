                $this pko-native-procedural-knowledge-rulebook:ratifyingFragmentIsValid ?_result .
            }
            WHERE {
    $this a pko-extension:AuthorityBoundary .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ratifiedByKnowledgeFragment ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:KnowledgeFragment . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isCurrentlyValid ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AuthorityBoundaries_StepWhenBinding a sh:NodeShape ;
    sh:targetClass pko-extension:AuthorityBoundary ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_StepWhenBinding" ;
        sh:construct """
