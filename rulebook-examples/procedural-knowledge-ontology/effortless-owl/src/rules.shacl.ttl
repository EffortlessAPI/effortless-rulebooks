    $this a pko-native-procedural-knowledge-rulebook:StepRequirements .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:satisfactionCountForBinding ?satisfaction_count_for_binding . }
                BIND((COALESCE(?satisfaction_count_for_binding, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepRequirements_IsUnexercisedBlockingBinding a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:StepRequirements ;
