            CONSTRUCT {
                $this effortless-ntwf:specifiedTransitionFromPreviousCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepTransitions .
                    ?child effortless-ntwf:fromStep ?backfk .
                    $this effortless-ntwf:previousExecutedStep ?backpv .
                    OPTIONAL { ?child effortless-ntwf:toStep ?c2 . }
                    OPTIONAL { $this effortless-ntwf:step ?p2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(REPLACE(STR(?c2), "^.*[#/]", "") = REPLACE(STR(?p2), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsOutOfSpecifiedOrder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
