    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?protective_equipment__key, IF(isIRI(?protective_equipment), REPLACE(STR(?protective_equipment), "^.*[#/]", ""), STR(?protective_equipment))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepRequirements ===
effortless-ntwf:StepRequirementsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepRequirements ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:requirement ?requirement . OPTIONAL { ?requirement effortless-ntwf:__key ?requirement__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?requirement__key, IF(isIRI(?requirement), REPLACE(STR(?requirement), "^.*[#/]", ""), STR(?requirement))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_RequirementIsBlocking" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requirementIsBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isBlocking ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_BlockingStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:blockingStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?requirement_is_blocking, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_StepWhenBlocking" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepWhenBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?requirement_is_blocking, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_RequirementLacksWitness" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requirementLacksWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isUnwitnessedBlockingControl ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_UnwitnessedStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unwitnessedStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:requirementLacksWitness ?requirement_lacks_witness . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?requirement_lacks_witness, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_SatisfactionCountForBinding" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:satisfactionCountForBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:bindingKey ?backfk .
                    $this effortless-ntwf:stepRequirementId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_BindingWasEverExercised" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:bindingWasEverExercised ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:satisfactionCountForBinding ?satisfaction_count_for_binding . }
                BIND((COALESCE(?satisfaction_count_for_binding, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_IsUnexercisedBlockingBinding" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnexercisedBlockingBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:bindingWasEverExercised ?binding_was_ever_exercised . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
                BIND((COALESCE(?requirement_is_blocking, false) && COALESCE((!(COALESCE(?binding_was_ever_exercised, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_UnexercisedBindingRequirementKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unexercisedBindingRequirementKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:isUnexercisedBlockingBinding ?is_unexercised_blocking_binding . }
    OPTIONAL { $this effortless-ntwf:requirement ?requirement . }
                BIND(IF(COALESCE(?is_unexercised_blocking_binding, false), ?requirement, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_RequirementIsRegulatory" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requirementIsRegulatory ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isRegulatoryRequirement ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepResources ===
effortless-ntwf:StepResourcesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepResources ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepResources_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepResources .
    OPTIONAL { $this effortless-ntwf:resource ?resource . OPTIONAL { ?resource effortless-ntwf:__key ?resource__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?resource__key, IF(isIRI(?resource), REPLACE(STR(?resource), "^.*[#/]", ""), STR(?resource))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepTools ===
effortless-ntwf:StepToolsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepTools ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTools_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTools .
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
    OPTIONAL { $this effortless-ntwf:tool ?tool . OPTIONAL { ?tool effortless-ntwf:__key ?tool__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?tool__key, IF(isIRI(?tool), REPLACE(STR(?tool), "^.*[#/]", ""), STR(?tool))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepTransitions ===
effortless-ntwf:StepTransitionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepTransitions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:fromStep ?from_step . OPTIONAL { ?from_step effortless-ntwf:__key ?from_step__key . } }
    OPTIONAL { $this effortless-ntwf:toStep ?to_step . OPTIONAL { ?to_step effortless-ntwf:__key ?to_step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_step__key, IF(isIRI(?from_step), REPLACE(STR(?from_step), "^.*[#/]", ""), STR(?from_step))), ""), " -> ", COALESCE(COALESCE(?to_step__key, IF(isIRI(?to_step), REPLACE(STR(?to_step), "^.*[#/]", ""), STR(?to_step))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsRecoveryPath" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRecoveryPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:transitionKind ?transition_kind . OPTIONAL { ?transition_kind effortless-ntwf:__key ?transition_kind__key . } }
                BIND((COALESCE((COALESCE(?transition_kind__key, COALESCE(IF(isIRI(?transition_kind), REPLACE(STR(?transition_kind), "^.*[#/]", ""), STR(?transition_kind)), "")) = "Fallback"), false) || COALESCE((COALESCE(?transition_kind__key, COALESCE(IF(isIRI(?transition_kind), REPLACE(STR(?transition_kind), "^.*[#/]", ""), STR(?transition_kind)), "")) = "Alternative"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_CountOfFromStepExecutions" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfFromStepExecutions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:step ?backfk .
                    $this effortless-ntwf:fromStep ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_CountOfToStepExecutions" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfToStepExecutions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    ?child effortless-ntwf:step ?backfk .
                    $this effortless-ntwf:toStep ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_HasReachableOrigin" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasReachableOrigin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:countOfFromStepExecutions ?count_of_from_step_executions . }
                BIND((COALESCE(?count_of_from_step_executions, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_HasReachableTarget" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasReachableTarget ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:countOfToStepExecutions ?count_of_to_step_executions . }
                BIND((COALESCE(?count_of_to_step_executions, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsNeverExercised" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNeverExercised ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:hasReachableOrigin ?has_reachable_origin . }
    OPTIONAL { $this effortless-ntwf:hasReachableTarget ?has_reachable_target . }
                BIND((!(COALESCE((COALESCE(?has_reachable_origin, false) && COALESCE(?has_reachable_target, false)), false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsUntestedRecoveryPath" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUntestedRecoveryPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:isNeverExercised ?is_never_exercised . }
    OPTIONAL { $this effortless-ntwf:isRecoveryPath ?is_recovery_path . }
                BIND((COALESCE(?is_recovery_path, false) && COALESCE(?is_never_exercised, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_CountOfObservedTraversals" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfObservedTraversals ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ObservedTransitions .
                    ?child effortless-ntwf:stepTransition $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_HasBeenTraversed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasBeenTraversed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:countOfObservedTraversals ?count_of_observed_traversals . }
                BIND((COALESCE(?count_of_observed_traversals, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsUnwalkedRecoveryPath" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwalkedRecoveryPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:hasBeenTraversed ?has_been_traversed . }
    OPTIONAL { $this effortless-ntwf:isRecoveryPath ?is_recovery_path . }
                BIND((COALESCE(?is_recovery_path, false) && COALESCE((!(COALESCE(?has_been_traversed, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_TargetBlockingRequirementCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:targetBlockingRequirementCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
                OPTIONAL { $this effortless-ntwf:toStep ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:blockingRequirementCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_TargetCarriesBlockingControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:targetCarriesBlockingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:targetBlockingRequirementCount ?target_blocking_requirement_count . }
                BIND((COALESCE(?target_blocking_requirement_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsUnrehearsedControlEntry" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnrehearsedControlEntry ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:isUnwalkedRecoveryPath ?is_unwalked_recovery_path . }
    OPTIONAL { $this effortless-ntwf:targetCarriesBlockingControl ?target_carries_blocking_control . }
                BIND((COALESCE(?is_unwalked_recovery_path, false) && COALESCE(?target_carries_blocking_control, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_UnrehearsedControlVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unrehearsedControlVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:isUnrehearsedControlEntry ?is_unrehearsed_control_entry . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_unrehearsed_control_entry, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_FromStepIsHumanApprovalGate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fromStepIsHumanApprovalGate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
                OPTIONAL { $this effortless-ntwf:fromStep ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isHumanApprovalGate ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_ToStepIsHumanApprovalGate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:toStepIsHumanApprovalGate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
                OPTIONAL { $this effortless-ntwf:toStep ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isHumanApprovalGate ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_AvoidsHumanApprovalGate" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:avoidsHumanApprovalGate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:fromStepIsHumanApprovalGate ?from_step_is_human_approval_gate . }
    OPTIONAL { $this effortless-ntwf:toStepIsHumanApprovalGate ?to_step_is_human_approval_gate . }
                BIND((COALESCE((!(COALESCE(?from_step_is_human_approval_gate, false))), false) && COALESCE((!(COALESCE(?to_step_is_human_approval_gate, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_DecisionPointCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:decisionPointCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:DecisionPoints .
                    ?child effortless-ntwf:governingTransition $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsUndocumentedBranch" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUndocumentedBranch ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:decisionPointCount ?decision_point_count . }
    OPTIONAL { $this effortless-ntwf:transitionKind ?transition_kind . OPTIONAL { ?transition_kind effortless-ntwf:__key ?transition_kind__key . } }
                BIND((COALESCE((COALESCE(?transition_kind__key, COALESCE(IF(isIRI(?transition_kind), REPLACE(STR(?transition_kind), "^.*[#/]", ""), STR(?transition_kind)), "")) != "Next"), false) && COALESCE((COALESCE(?decision_point_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepVariables ===
effortless-ntwf:StepVariablesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepVariables ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
    OPTIONAL { $this effortless-ntwf:direction ?direction . OPTIONAL { ?direction effortless-ntwf:__key ?direction__key . } }
    OPTIONAL { $this effortless-ntwf:label ?label . OPTIONAL { ?label effortless-ntwf:__key ?label__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " ", COALESCE(COALESCE(?direction__key, IF(isIRI(?direction), REPLACE(STR(?direction), "^.*[#/]", ""), STR(?direction))), ""), " ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_SourceDirection" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceDirection ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
                OPTIONAL { $this effortless-ntwf:sourceVariable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepVariables ; effortless-ntwf:stepVariableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:direction ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_SourceStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
                OPTIONAL { $this effortless-ntwf:sourceVariable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepVariables ; effortless-ntwf:stepVariableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_IsDanglingInput" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDanglingInput ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
    OPTIONAL { $this effortless-ntwf:direction ?direction . OPTIONAL { ?direction effortless-ntwf:__key ?direction__key . } }
    OPTIONAL { $this effortless-ntwf:isExternalInput ?is_external_input . }
    OPTIONAL { $this effortless-ntwf:sourceVariable ?source_variable . OPTIONAL { ?source_variable effortless-ntwf:__key ?source_variable__key . } }
                BIND((COALESCE((COALESCE(?direction__key, COALESCE(IF(isIRI(?direction), REPLACE(STR(?direction), "^.*[#/]", ""), STR(?direction)), "")) = "Input"), false) && COALESCE((COALESCE(?source_variable__key, COALESCE(IF(isIRI(?source_variable), REPLACE(STR(?source_variable), "^.*[#/]", ""), STR(?source_variable)), "")) = ""), false) && COALESCE((COALESCE(?is_external_input, false) = false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_IsMiswiredSource" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMiswiredSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
    OPTIONAL { $this effortless-ntwf:sourceDirection ?source_direction . OPTIONAL { ?source_direction effortless-ntwf:__key ?source_direction__key . } }
    OPTIONAL { $this effortless-ntwf:sourceVariable ?source_variable . OPTIONAL { ?source_variable effortless-ntwf:__key ?source_variable__key . } }
                BIND((COALESCE((COALESCE(?source_variable__key, COALESCE(IF(isIRI(?source_variable), REPLACE(STR(?source_variable), "^.*[#/]", ""), STR(?source_variable)), "")) != ""), false) && COALESCE((COALESCE(?source_direction__key, COALESCE(IF(isIRI(?source_direction), REPLACE(STR(?source_direction), "^.*[#/]", ""), STR(?source_direction)), "")) != "Output"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_ConsumerCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:consumerCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepVariables .
                    ?child effortless-ntwf:sourceVariable $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_InputStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:inputStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
    OPTIONAL { $this effortless-ntwf:direction ?direction . OPTIONAL { ?direction effortless-ntwf:__key ?direction__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE((COALESCE(?direction__key, COALESCE(IF(isIRI(?direction), REPLACE(STR(?direction), "^.*[#/]", ""), STR(?direction)), "")) = "Input"), false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_OutputStepKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:outputStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
    OPTIONAL { $this effortless-ntwf:direction ?direction . OPTIONAL { ?direction effortless-ntwf:__key ?direction__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE((COALESCE(?direction__key, COALESCE(IF(isIRI(?direction), REPLACE(STR(?direction), "^.*[#/]", ""), STR(?direction)), "")) = "Output"), false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_StepAccountableAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepAccountableAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:accountableAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_StepAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVariables .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:assignedAgentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVariables_ConsumerRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
