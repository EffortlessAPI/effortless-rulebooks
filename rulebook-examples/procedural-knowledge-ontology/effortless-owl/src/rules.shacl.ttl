    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this effortless-ntwf:sourceAgentIsStillEngaged ?source_agent_is_still_engaged . }
                BIND((COALESCE(?is_currently_valid, false) && COALESCE((!(COALESCE(?source_agent_is_still_engaged, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsUndefendableTacitClaim" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUndefendableTacitClaim ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:hasOrphanedProvenance ?has_orphaned_provenance . }
    OPTIONAL { $this effortless-ntwf:knowledgeForm ?knowledge_form . OPTIONAL { ?knowledge_form effortless-ntwf:__key ?knowledge_form__key . } }
                BIND((COALESCE(?has_orphaned_provenance, false) && COALESCE((COALESCE((COALESCE(?knowledge_form__key, COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), "")) = "Tacit"), false) || COALESCE((COALESCE(?knowledge_form__key, COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), "")) = "SituatedJudgment"), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsApproved" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
