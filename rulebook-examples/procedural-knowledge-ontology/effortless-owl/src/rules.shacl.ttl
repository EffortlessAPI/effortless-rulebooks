pko-native-procedural-knowledge-rulebook-shapes:SituationalVariants_DivergesWithoutStatedConditions a sh:NodeShape ;
    sh:targetClass pko-extension:SituationalVariant ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SituationalVariants_DivergesWithoutStatedConditions" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:divergesWithoutStatedConditions ?_result .
            }
            WHERE {
    $this a pko-extension:SituationalVariant .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:adaptation ?adaptation . OPTIONAL { ?adaptation erb:key ?adaptation__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:applicabilityScope ?applicability_scope . OPTIONAL { ?applicability_scope erb:key ?applicability_scope__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:scopeStatesConditions ?scope_states_conditions . }
                BIND((COALESCE((COALESCE(?adaptation__key, COALESCE(IF(isIRI(?adaptation), REPLACE(STR(?adaptation), "^.*[#/]", ""), STR(?adaptation)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?applicability_scope__key, COALESCE(IF(isIRI(?applicability_scope), REPLACE(STR(?applicability_scope), "^.*[#/]", ""), STR(?applicability_scope)), "")) = ""), false) || COALESCE((COALESCE(?scope_states_conditions, false) = false), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for SnapshotAssertions ===
pko-native-procedural-knowledge-rulebook-shapes:SnapshotAssertions_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:SnapshotAssertions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:objectValue ?object_value . OPTIONAL { ?object_value erb:key ?object_value__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:predicate ?predicate . OPTIONAL { ?predicate erb:key ?predicate__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:subjectIdentifier ?subject_identifier . OPTIONAL { ?subject_identifier erb:key ?subject_identifier__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?subject_identifier__key, IF(isIRI(?subject_identifier), REPLACE(STR(?subject_identifier), "^.*[#/]", ""), STR(?subject_identifier))), ""), " ", COALESCE(COALESCE(?predicate__key, IF(isIRI(?predicate), REPLACE(STR(?predicate), "^.*[#/]", ""), STR(?predicate))), ""), " ", COALESCE(COALESCE(?object_value__key, IF(isIRI(?object_value), REPLACE(STR(?object_value), "^.*[#/]", ""), STR(?object_value))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SnapshotAssertions_SourceVersionStatus a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_SourceVersionStatus" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:sourceVersionStatus ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:SnapshotAssertions .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceProcedureVersion ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:ProcedureVersions . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:status ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SnapshotAssertions_SourceAssignmentIsCurrent a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_SourceAssignmentIsCurrent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:sourceAssignmentIsCurrent ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:SnapshotAssertions .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceRoleAssignment ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:RoleInTime . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isCurrent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SnapshotAssertions_SnapshotConsistentRunCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_SnapshotConsistentRunCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:snapshotConsistentRunCount ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:SnapshotAssertions .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:snapshot ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:GroundingSnapshot . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:consistentReasonerRunCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SnapshotAssertions_SnapshotIsReasoned a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_SnapshotIsReasoned" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:snapshotIsReasoned ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:SnapshotAssertions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:snapshotConsistentRunCount ?snapshot_consistent_run_count . }
                BIND((COALESCE(?snapshot_consistent_run_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SnapshotAssertions_IsStaleRoleAssertion a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_IsStaleRoleAssertion" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isStaleRoleAssertion ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:SnapshotAssertions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceAssignmentIsCurrent ?source_assignment_is_current . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceRoleAssignment ?source_role_assignment . OPTIONAL { ?source_role_assignment erb:key ?source_role_assignment__key . } }
                BIND((COALESCE((COALESCE(?source_role_assignment__key, COALESCE(IF(isIRI(?source_role_assignment), REPLACE(STR(?source_role_assignment), "^.*[#/]", ""), STR(?source_role_assignment)), "")) != ""), false) && COALESCE((COALESCE(?source_assignment_is_current, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SnapshotAssertions_PresentsDeprecatedAsCurrent a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_PresentsDeprecatedAsCurrent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:presentsDeprecatedAsCurrent ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:SnapshotAssertions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:presentedStatus ?presented_status . OPTIONAL { ?presented_status erb:key ?presented_status__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceVersionStatus ?source_version_status . OPTIONAL { ?source_version_status erb:key ?source_version_status__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?source_version_status__key, COALESCE(IF(isIRI(?source_version_status), REPLACE(STR(?source_version_status), "^.*[#/]", ""), STR(?source_version_status)), "")) = "Deprecated"), false) || COALESCE((COALESCE(?source_version_status__key, COALESCE(IF(isIRI(?source_version_status), REPLACE(STR(?source_version_status), "^.*[#/]", ""), STR(?source_version_status)), "")) = "Archived"), false)), false) && COALESCE((COALESCE(?presented_status__key, COALESCE(IF(isIRI(?presented_status), REPLACE(STR(?presented_status), "^.*[#/]", ""), STR(?presented_status)), "")) = "Current"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SnapshotAssertions_LacksProvenance a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_LacksProvenance" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:lacksProvenance ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:SnapshotAssertions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:provenanceUri ?provenance_uri . OPTIONAL { ?provenance_uri erb:key ?provenance_uri__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceProcedureVersion ?source_procedure_version . OPTIONAL { ?source_procedure_version erb:key ?source_procedure_version__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceRoleAssignment ?source_role_assignment . OPTIONAL { ?source_role_assignment erb:key ?source_role_assignment__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceStep ?source_step . OPTIONAL { ?source_step erb:key ?source_step__key . } }
                BIND((COALESCE((COALESCE(?provenance_uri__key, COALESCE(IF(isIRI(?provenance_uri), REPLACE(STR(?provenance_uri), "^.*[#/]", ""), STR(?provenance_uri)), "")) = ""), false) && COALESCE((COALESCE(?source_procedure_version__key, COALESCE(IF(isIRI(?source_procedure_version), REPLACE(STR(?source_procedure_version), "^.*[#/]", ""), STR(?source_procedure_version)), "")) = ""), false) && COALESCE((COALESCE(?source_step__key, COALESCE(IF(isIRI(?source_step), REPLACE(STR(?source_step), "^.*[#/]", ""), STR(?source_step)), "")) = ""), false) && COALESCE((COALESCE(?source_role_assignment__key, COALESCE(IF(isIRI(?source_role_assignment), REPLACE(STR(?source_role_assignment), "^.*[#/]", ""), STR(?source_role_assignment)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SnapshotAssertions_HasOpaqueIdentifier a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_HasOpaqueIdentifier" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasOpaqueIdentifier ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:SnapshotAssertions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:subjectIdentifier ?subject_identifier . }
                BIND((COALESCE((SUBSTR(STR(?subject_identifier), 1, 9) = "urn:uuid:"), false) || COALESCE((SUBSTR(STR(?subject_identifier), 1, 2) = "_:"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SnapshotAssertions_LacksDublinCore a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:SnapshotAssertions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SnapshotAssertions_LacksDublinCore" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:lacksDublinCore ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:SnapshotAssertions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:dcDescription ?dc_description . OPTIONAL { ?dc_description erb:key ?dc_description__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:dcTitle ?dc_title . OPTIONAL { ?dc_title erb:key ?dc_title__key . } }
                BIND((COALESCE((COALESCE(?dc_title__key, COALESCE(IF(isIRI(?dc_title), REPLACE(STR(?dc_title), "^.*[#/]", ""), STR(?dc_title)), "")) = ""), false) || COALESCE((COALESCE(?dc_description__key, COALESCE(IF(isIRI(?dc_description), REPLACE(STR(?dc_description), "^.*[#/]", ""), STR(?dc_description)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for SourceArticles ===
pko-native-procedural-knowledge-rulebook-shapes:SourceArticles_Name a sh:NodeShape ;
    sh:targetClass pko-extension:SourceArticle ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:SourceArticle .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceArticles_ClaimCount a sh:NodeShape ;
    sh:targetClass pko-extension:SourceArticle ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_ClaimCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:claimCount ?_result .
            }
            WHERE {
    $this a pko-extension:SourceArticle .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:SourceArticle .
                    ?child a pko-extension:ArticleClaim .
                    ?child pko-native-procedural-knowledge-rulebook:sourceArticle $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceArticles_CoveredClaimCount a sh:NodeShape ;
    sh:targetClass pko-extension:SourceArticle ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_CoveredClaimCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:coveredClaimCount ?_result .
            }
            WHERE {
    $this a pko-extension:SourceArticle .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:SourceArticle .
                    ?child a pko-extension:ArticleClaim .
                    ?child pko-native-procedural-knowledge-rulebook:sourceArticle $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isCovered ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceArticles_AgreedClaimCount a sh:NodeShape ;
    sh:targetClass pko-extension:SourceArticle ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_AgreedClaimCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:agreedClaimCount ?_result .
            }
            WHERE {
    $this a pko-extension:SourceArticle .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:SourceArticle .
                    ?child a pko-extension:ArticleClaim .
                    ?child pko-native-procedural-knowledge-rulebook:sourceArticle $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isAgreed ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceArticles_UncoveredClaimCount a sh:NodeShape ;
    sh:targetClass pko-extension:SourceArticle ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_UncoveredClaimCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:uncoveredClaimCount ?_result .
            }
            WHERE {
    $this a pko-extension:SourceArticle .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:claimCount ?claim_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:coveredClaimCount ?covered_claim_count . }
                BIND(ROUND((?claim_count - ?covered_claim_count)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceArticles_CoveragePercent a sh:NodeShape ;
    sh:targetClass pko-extension:SourceArticle ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_CoveragePercent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:coveragePercent ?_result .
            }
            WHERE {
    $this a pko-extension:SourceArticle .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:claimCount ?claim_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:coveredClaimCount ?covered_claim_count . }
                BIND(IF(COALESCE((COALESCE(?claim_count, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?covered_claim_count) / ?claim_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceArticles_AgreedCoveragePercent a sh:NodeShape ;
    sh:targetClass pko-extension:SourceArticle ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_AgreedCoveragePercent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:agreedCoveragePercent ?_result .
            }
            WHERE {
    $this a pko-extension:SourceArticle .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:agreedClaimCount ?agreed_claim_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:claimCount ?claim_count . }
                BIND(IF(COALESCE((COALESCE(?claim_count, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?agreed_claim_count) / ?claim_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceArticles_IsFullyCovered a sh:NodeShape ;
    sh:targetClass pko-extension:SourceArticle ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceArticles_IsFullyCovered" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFullyCovered ?_result .
            }
            WHERE {
    $this a pko-extension:SourceArticle .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:claimCount ?claim_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:uncoveredClaimCount ?uncovered_claim_count . }
                BIND((COALESCE((COALESCE(?claim_count, 0) > 0), false) && COALESCE((COALESCE(?uncovered_claim_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for SourceRelationships ===
pko-native-procedural-knowledge-rulebook-shapes:SourceRelationships_Name a sh:NodeShape ;
    sh:targetClass pko-extension:SourceRelationship ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceRelationships_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:SourceRelationship .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeEngineer ?knowledge_engineer . OPTIONAL { ?knowledge_engineer erb:key ?knowledge_engineer__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceAgent ?source_agent . OPTIONAL { ?source_agent erb:key ?source_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?knowledge_engineer__key, IF(isIRI(?knowledge_engineer), REPLACE(STR(?knowledge_engineer), "^.*[#/]", ""), STR(?knowledge_engineer))), ""), " with ", COALESCE(COALESCE(?source_agent__key, IF(isIRI(?source_agent), REPLACE(STR(?source_agent), "^.*[#/]", ""), STR(?source_agent))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceRelationships_IsUnnegotiatedPowerGap a sh:NodeShape ;
    sh:targetClass pko-extension:SourceRelationship ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceRelationships_IsUnnegotiatedPowerGap" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnnegotiatedPowerGap ?_result .
            }
            WHERE {
    $this a pko-extension:SourceRelationship .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:negotiatedAgreement ?negotiated_agreement . OPTIONAL { ?negotiated_agreement erb:key ?negotiated_agreement__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:powerDynamic ?power_dynamic . OPTIONAL { ?power_dynamic erb:key ?power_dynamic__key . } }
                BIND((COALESCE((COALESCE(?power_dynamic__key, COALESCE(IF(isIRI(?power_dynamic), REPLACE(STR(?power_dynamic), "^.*[#/]", ""), STR(?power_dynamic)), "")) != ""), false) && COALESCE((COALESCE(?power_dynamic__key, COALESCE(IF(isIRI(?power_dynamic), REPLACE(STR(?power_dynamic), "^.*[#/]", ""), STR(?power_dynamic)), "")) != "Balanced"), false) && COALESCE((COALESCE(?negotiated_agreement__key, COALESCE(IF(isIRI(?negotiated_agreement), REPLACE(STR(?negotiated_agreement), "^.*[#/]", ""), STR(?negotiated_agreement)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceRelationships_IsExtractiveRelationship a sh:NodeShape ;
    sh:targetClass pko-extension:SourceRelationship ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceRelationships_IsExtractiveRelationship" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isExtractiveRelationship ?_result .
            }
            WHERE {
    $this a pko-extension:SourceRelationship .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:trustBuildingPractice ?trust_building_practice . OPTIONAL { ?trust_building_practice erb:key ?trust_building_practice__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:trustLevel ?trust_level . OPTIONAL { ?trust_level erb:key ?trust_level__key . } }
                BIND((COALESCE((COALESCE(?trust_level__key, COALESCE(IF(isIRI(?trust_level), REPLACE(STR(?trust_level), "^.*[#/]", ""), STR(?trust_level)), "")) != ""), false) && COALESCE((COALESCE(?trust_level__key, COALESCE(IF(isIRI(?trust_level), REPLACE(STR(?trust_level), "^.*[#/]", ""), STR(?trust_level)), "")) != "Established"), false) && COALESCE((COALESCE(?trust_building_practice__key, COALESCE(IF(isIRI(?trust_building_practice), REPLACE(STR(?trust_building_practice), "^.*[#/]", ""), STR(?trust_building_practice)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for SourceTermMentions ===
pko-native-procedural-knowledge-rulebook-shapes:SourceTermMentions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:SourceTermMention ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:SourceTermMention .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conceptScheme ?concept_scheme . OPTIONAL { ?concept_scheme erb:key ?concept_scheme__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wording ?wording . OPTIONAL { ?wording erb:key ?wording__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?concept_scheme__key, IF(isIRI(?concept_scheme), REPLACE(STR(?concept_scheme), "^.*[#/]", ""), STR(?concept_scheme))), ""), ": ", COALESCE(COALESCE(?wording__key, IF(isIRI(?wording), REPLACE(STR(?wording), "^.*[#/]", ""), STR(?wording))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceTermMentions_WordingKey a sh:NodeShape ;
    sh:targetClass pko-extension:SourceTermMention ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_WordingKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:wordingKey ?_result .
            }
            WHERE {
    $this a pko-extension:SourceTermMention .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:conceptScheme ?concept_scheme . OPTIONAL { ?concept_scheme erb:key ?concept_scheme__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:wording ?wording . OPTIONAL { ?wording erb:key ?wording__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?concept_scheme__key, IF(isIRI(?concept_scheme), REPLACE(STR(?concept_scheme), "^.*[#/]", ""), STR(?concept_scheme))), ""), "|", COALESCE(COALESCE(?wording__key, IF(isIRI(?wording), REPLACE(STR(?wording), "^.*[#/]", ""), STR(?wording))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceTermMentions_MatchingLabelCount a sh:NodeShape ;
    sh:targetClass pko-extension:SourceTermMention ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SourceTermMentions_MatchingLabelCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:matchingLabelCount ?_result .
            }
            WHERE {
    $this a pko-extension:SourceTermMention .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:SourceTermMention .
                    ?child a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
                    ?child pko-native-procedural-knowledge-rulebook:wordingKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:wordingKey ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:SourceTermMentions_MatchingPrefLabelCount a sh:NodeShape ;
    sh:targetClass pko-extension:SourceTermMention ;
