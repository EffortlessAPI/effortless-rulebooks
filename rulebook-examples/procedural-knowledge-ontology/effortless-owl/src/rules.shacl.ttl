    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ConsumerSystemSyncs .
                    ?child effortless-ntwf:loadedVersion $this .
                    }
                }
            }
