            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isCrossFirmPracticeCluster ?_result .
            }
            WHERE {
    $this a pko-extension:CommunityOfPractice .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:employerMoveCount ?employer_move_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:externalMemberCount ?external_member_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:specialistMemberCount ?specialist_member_count . }
                BIND((COALESCE((COALESCE(?external_member_count, 0) >= 2), false) && COALESCE((COALESCE(?employer_move_count, 0) >= 1), false) && COALESCE((COALESCE(?specialist_member_count, 0) >= 1), false)) AS ?_result)
            }
        """ ;
    ] .
