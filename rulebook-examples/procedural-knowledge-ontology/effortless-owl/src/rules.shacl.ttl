            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isHumanOwned ?is_human_owned . }
    OPTIONAL { $this effortless-ntwf:sourceAgentKind ?source_agent_kind . }
                BIND((COALESCE((!(COALESCE((REPLACE(COALESCE(STR(?source_agent_kind), ""), "^.*#", "") = "Human"), false))), false) && COALESCE((!(COALESCE(?is_human_owned, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_ReviewCadenceDays" ;
