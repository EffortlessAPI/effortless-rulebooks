    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:establishedAt ?established_at . OPTIONAL { ?established_at erb:key ?established_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ontologyModelingStartedAt ?ontology_modeling_started_at . OPTIONAL { ?ontology_modeling_started_at erb:key ?ontology_modeling_started_at__key . } }
                BIND((COALESCE((COALESCE(?ontology_modeling_started_at__key, COALESCE(IF(isIRI(?ontology_modeling_started_at), REPLACE(STR(?ontology_modeling_started_at), "^.*[#/]", ""), STR(?ontology_modeling_started_at)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?established_at__key, COALESCE(IF(isIRI(?established_at), REPLACE(STR(?established_at), "^.*[#/]", ""), STR(?established_at)), "")) = ""), false) || COALESCE(COALESCE((?ontology_modeling_started_at < ?established_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for VocabularyTerms ===
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_Name a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:prefLabel ?pref_label . }
                BIND(?pref_label AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_UsageCount a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_UsageCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:usageCount ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:VocabularyTerm .
                    ?child a pko:Requirement .
                    ?child pko-native-procedural-knowledge-rulebook:controlledTerm $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_IsOrphanTerm a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_IsOrphanTerm" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOrphanTerm ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usageCount ?usage_count . }
                BIND((COALESCE(?usage_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_IsWidelyAdoptedTerm a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
