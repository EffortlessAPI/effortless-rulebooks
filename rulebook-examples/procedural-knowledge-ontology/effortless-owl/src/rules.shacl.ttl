            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:currentlyCoveredAssignmentCount ?_result .
            }
            WHERE {
    $this a pro:Role .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pro:Role .
                    ?child a pro:RoleInTime .
                    ?child pko-native-procedural-knowledge-rulebook:roleWhenCovering ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:roleId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
