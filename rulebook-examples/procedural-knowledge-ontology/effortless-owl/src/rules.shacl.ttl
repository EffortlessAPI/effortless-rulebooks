            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isDelegatedToUnfitSource ?_result .
            }
            WHERE {
    $this a pko-extension:KnowHowCarrier .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isInPublicReferences ?is_in_public_references . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:replacementPlan ?replacement_plan . OPTIONAL { ?replacement_plan erb:key ?replacement_plan__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?replacement_plan__key, COALESCE(IF(isIRI(?replacement_plan), REPLACE(STR(?replacement_plan), "^.*[#/]", ""), STR(?replacement_plan)), "")) = "PublicReference"), false) || COALESCE((COALESCE(?replacement_plan__key, COALESCE(IF(isIRI(?replacement_plan), REPLACE(STR(?replacement_plan), "^.*[#/]", ""), STR(?replacement_plan)), "")) = "AiGeneration"), false)), false) && COALESCE((COALESCE(?is_in_public_references, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

