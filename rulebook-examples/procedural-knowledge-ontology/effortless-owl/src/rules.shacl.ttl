            WHERE {
    $this a effortless-ntwf:AiAdoptionInitiatives .
    OPTIONAL { $this effortless-ntwf:connectedToAiAt ?connected_to_ai_at . OPTIONAL { ?connected_to_ai_at effortless-ntwf:__key ?connected_to_ai_at__key . } }
    OPTIONAL { $this effortless-ntwf:targetElicitationEvidenceCount ?target_elicitation_evidence_count . }
    OPTIONAL { $this effortless-ntwf:targetVersion ?target_version . OPTIONAL { ?target_version effortless-ntwf:__key ?target_version__key . } }
    OPTIONAL { $this effortless-ntwf:targetVersionIssuedAt ?target_version_issued_at . }
                BIND((COALESCE((COALESCE(?connected_to_ai_at__key, COALESCE(IF(isIRI(?connected_to_ai_at), REPLACE(STR(?connected_to_ai_at), "^.*[#/]", ""), STR(?connected_to_ai_at)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?target_version__key, COALESCE(IF(isIRI(?target_version), REPLACE(STR(?target_version), "^.*[#/]", ""), STR(?target_version)), "")) = ""), false) || COALESCE((COALESCE(?target_elicitation_evidence_count, 0) = 0), false) || COALESCE(COALESCE((?connected_to_ai_at < ?target_version_issued_at), false), false)), false)) AS ?_result)
            }
