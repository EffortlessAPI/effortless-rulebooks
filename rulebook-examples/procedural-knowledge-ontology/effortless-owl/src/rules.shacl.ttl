                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:procedureVersion ?backfk .
                    $this effortless-ntwf:dependentRunVersion ?backpv .
                    OPTIONAL { ?child effortless-ntwf:assignedRole ?c2 . }
                    OPTIONAL { $this effortless-ntwf:role ?p2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(REPLACE(STR(?c2), "^.*[#/]", "") = REPLACE(STR(?p2), "^.*[#/]", ""))
                    }
                }
            }
