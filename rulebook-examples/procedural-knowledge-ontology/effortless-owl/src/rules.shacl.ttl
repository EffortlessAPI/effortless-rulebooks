    $this a pko-extension:ModelDocument .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:governedModel ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:GovernedModel . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:currentRelease ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ModelDocuments_IsBehindCurrentRelease a sh:NodeShape ;
    sh:targetClass pko-extension:ModelDocument ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelDocuments_IsBehindCurrentRelease" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isBehindCurrentRelease ?_result .
            }
            WHERE {
    $this a pko-extension:ModelDocument .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:documentedRelease ?documented_release . OPTIONAL { ?documented_release erb:key ?documented_release__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelCurrentRelease ?model_current_release . OPTIONAL { ?model_current_release erb:key ?model_current_release__key . } }
                BIND((COALESCE((COALESCE(?documented_release__key, COALESCE(IF(isIRI(?documented_release), REPLACE(STR(?documented_release), "^.*[#/]", ""), STR(?documented_release)), "")) != ""), false) && COALESCE((COALESCE(?model_current_release__key, COALESCE(IF(isIRI(?model_current_release), REPLACE(STR(?model_current_release), "^.*[#/]", ""), STR(?model_current_release)), "")) != ""), false) && COALESCE(COALESCE((?documented_release != ?model_current_release), !((!BOUND(?documented_release) || STR(?documented_release) = "") && (!BOUND(?model_current_release) || STR(?model_current_release) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .

