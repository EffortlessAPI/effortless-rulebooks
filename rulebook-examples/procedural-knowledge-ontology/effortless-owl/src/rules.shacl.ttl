@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix effortless-ntwf: <https://w3id.org/effortless-ntwf#> .

# === Shape with rules for AccessDenialTests ===
effortless-ntwf:AccessDenialTestsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AccessDenialTests ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:forbiddenRowId ?forbidden_row_id . OPTIONAL { ?forbidden_row_id effortless-ntwf:__key ?forbidden_row_id__key . } }
    OPTIONAL { $this effortless-ntwf:principal ?principal . OPTIONAL { ?principal effortless-ntwf:__key ?principal__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), ""), " must not see ", COALESCE(COALESCE(?forbidden_row_id__key, IF(isIRI(?forbidden_row_id), REPLACE(STR(?forbidden_row_id), "^.*[#/]", ""), STR(?forbidden_row_id))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_HasRun" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:lastRunAt ?last_run_at . OPTIONAL { ?last_run_at effortless-ntwf:__key ?last_run_at__key . } }
                BIND((COALESCE(?last_run_at__key, COALESCE(IF(isIRI(?last_run_at), REPLACE(STR(?last_run_at), "^.*[#/]", ""), STR(?last_run_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsPassing" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPassing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:expectedVisible ?expected_visible . }
    OPTIONAL { $this effortless-ntwf:observedVisible ?observed_visible . }
                BIND((COALESCE(?observed_visible, false) = COALESCE(?expected_visible, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsLeak" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLeak ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:expectedVisible ?expected_visible . }
    OPTIONAL { $this effortless-ntwf:observedVisible ?observed_visible . }
                BIND((COALESCE((!(COALESCE(?expected_visible, false))), false) && COALESCE(?observed_visible, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsUnproven" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnproven ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:hasRun ?has_run . }
                BIND((!(COALESCE(?has_run, false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsPositiveControl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPositiveControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:expectedVisible ?expected_visible . }
                BIND(?expected_visible AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AccessPolicies ===
effortless-ntwf:AccessPoliciesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AccessPolicies ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:command ?command . OPTIONAL { ?command effortless-ntwf:__key ?command__key . } }
    OPTIONAL { $this effortless-ntwf:principal ?principal . OPTIONAL { ?principal effortless-ntwf:__key ?principal__key . } }
    OPTIONAL { $this effortless-ntwf:targetTable ?target_table . OPTIONAL { ?target_table effortless-ntwf:__key ?target_table__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), ""), " ", COALESCE(COALESCE(?command__key, IF(isIRI(?command), REPLACE(STR(?command), "^.*[#/]", ""), STR(?command))), ""), " ", COALESCE(COALESCE(?target_table__key, IF(isIRI(?target_table), REPLACE(STR(?target_table), "^.*[#/]", ""), STR(?target_table))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsWriteCommand" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWriteCommand ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:command ?command . OPTIONAL { ?command effortless-ntwf:__key ?command__key . } }
                BIND((COALESCE((COALESCE(?command__key, COALESCE(IF(isIRI(?command), REPLACE(STR(?command), "^.*[#/]", ""), STR(?command)), "")) = "INSERT"), false) || COALESCE((COALESCE(?command__key, COALESCE(IF(isIRI(?command), REPLACE(STR(?command), "^.*[#/]", ""), STR(?command)), "")) = "UPDATE"), false) || COALESCE((COALESCE(?command__key, COALESCE(IF(isIRI(?command), REPLACE(STR(?command), "^.*[#/]", ""), STR(?command)), "")) = "DELETE"), false) || COALESCE((COALESCE(?command__key, COALESCE(IF(isIRI(?command), REPLACE(STR(?command), "^.*[#/]", ""), STR(?command)), "")) = "ALL"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsUnrestricted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnrestricted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:rowPredicate ?row_predicate . OPTIONAL { ?row_predicate effortless-ntwf:__key ?row_predicate__key . } }
                BIND((COALESCE(?row_predicate__key, COALESCE(IF(isIRI(?row_predicate), REPLACE(STR(?row_predicate), "^.*[#/]", ""), STR(?row_predicate)), "")) = "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_PrincipalIsAdmin" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:principalIsAdmin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
                OPTIONAL { $this effortless-ntwf:principal ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AccessPrincipals ; effortless-ntwf:accessPrincipalId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isAdministrator ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsUnrestrictedNonAdminGrant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnrestrictedNonAdminGrant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:isUnrestricted ?is_unrestricted . }
    OPTIONAL { $this effortless-ntwf:principalIsAdmin ?principal_is_admin . }
                BIND((COALESCE(?is_unrestricted, false) && COALESCE((!(COALESCE(?principal_is_admin, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsUnwitnessedWrite" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwitnessedWrite ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:denialTestCount ?denial_test_count . }
    OPTIONAL { $this effortless-ntwf:isWriteCommand ?is_write_command . }
                BIND((COALESCE(?is_write_command, false) && COALESCE((COALESCE(?denial_test_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_DenialTestCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:denialTestCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AccessDenialTests .
                    ?child effortless-ntwf:targetPolicy $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for AccessPrincipals ===
effortless-ntwf:AccessPrincipalsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AccessPrincipals ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_OrganizationScope" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:organizationScope ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                OPTIONAL { $this effortless-ntwf:domainRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_RoleLabel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:roleLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                OPTIONAL { $this effortless-ntwf:domainRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_PolicyCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:policyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AccessPolicies .
                    ?child effortless-ntwf:principal $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_GrantCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:grantCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FieldGrants .
                    ?child effortless-ntwf:principal $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_VisibleTableCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:visibleTableCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleSchemaViews .
                    ?child effortless-ntwf:principal $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_HasNoAccess" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoAccess ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
    OPTIONAL { $this effortless-ntwf:policyCount ?policy_count . }
                BIND((COALESCE(?policy_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_IsOverPrivileged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOverPrivileged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
    OPTIONAL { $this effortless-ntwf:isAdministrator ?is_administrator . }
    OPTIONAL { $this effortless-ntwf:visibleTableCount ?visible_table_count . }
                BIND((COALESCE((!(COALESCE(?is_administrator, false))), false) && COALESCE((COALESCE(?visible_table_count, 0) >= 74), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Actions ===
effortless-ntwf:ActionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Actions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Actions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Actions .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ActivityRelations ===
effortless-ntwf:ActivityRelationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ActivityRelations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ActivityRelations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ActivityRelations .
    OPTIONAL { $this effortless-ntwf:fromStep ?from_step . OPTIONAL { ?from_step effortless-ntwf:__key ?from_step__key . } }
    OPTIONAL { $this effortless-ntwf:relationType ?relation_type . OPTIONAL { ?relation_type effortless-ntwf:__key ?relation_type__key . } }
    OPTIONAL { $this effortless-ntwf:toStep ?to_step . OPTIONAL { ?to_step effortless-ntwf:__key ?to_step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_step__key, IF(isIRI(?from_step), REPLACE(STR(?from_step), "^.*[#/]", ""), STR(?from_step))), ""), " ", COALESCE(COALESCE(?relation_type__key, IF(isIRI(?relation_type), REPLACE(STR(?relation_type), "^.*[#/]", ""), STR(?relation_type))), ""), " ", COALESCE(COALESCE(?to_step__key, IF(isIRI(?to_step), REPLACE(STR(?to_step), "^.*[#/]", ""), STR(?to_step))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ActivityRelations_RelationTypeIsDefined" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:relationTypeIsDefined ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ActivityRelations .
                OPTIONAL { $this effortless-ntwf:relationType ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RelationTypes ; effortless-ntwf:relationTypeId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isDefined ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ActivityRelations_UsesUndefinedRelationType" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:usesUndefinedRelationType ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ActivityRelations .
    OPTIONAL { $this effortless-ntwf:relationTypeIsDefined ?relation_type_is_defined . }
                BIND((COALESCE(?relation_type_is_defined, false) = false) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ActivityRelations_FromStepVersion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fromStepVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ActivityRelations .
                OPTIONAL { $this effortless-ntwf:fromStep ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:procedureVersion ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ActivityRelations_OverlapsVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overlapsVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ActivityRelations .
    OPTIONAL { $this effortless-ntwf:fromStepVersion ?from_step_version . }
    OPTIONAL { $this effortless-ntwf:relationType ?relation_type . OPTIONAL { ?relation_type effortless-ntwf:__key ?relation_type__key . } }
                BIND(IF(COALESCE((COALESCE(?relation_type__key, COALESCE(IF(isIRI(?relation_type), REPLACE(STR(?relation_type), "^.*[#/]", ""), STR(?relation_type)), "")) = "Overlaps"), false), ?from_step_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ActivityRelations_EnablesVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:enablesVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ActivityRelations .
    OPTIONAL { $this effortless-ntwf:fromStepVersion ?from_step_version . }
    OPTIONAL { $this effortless-ntwf:relationType ?relation_type . OPTIONAL { ?relation_type effortless-ntwf:__key ?relation_type__key . } }
                BIND(IF(COALESCE((COALESCE(?relation_type__key, COALESCE(IF(isIRI(?relation_type), REPLACE(STR(?relation_type), "^.*[#/]", ""), STR(?relation_type)), "")) = "Enables"), false), ?from_step_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ActivityRelations_PreventsVersionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:preventsVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ActivityRelations .
    OPTIONAL { $this effortless-ntwf:fromStepVersion ?from_step_version . }
    OPTIONAL { $this effortless-ntwf:relationType ?relation_type . OPTIONAL { ?relation_type effortless-ntwf:__key ?relation_type__key . } }
                BIND(IF(COALESCE((COALESCE(?relation_type__key, COALESCE(IF(isIRI(?relation_type), REPLACE(STR(?relation_type), "^.*[#/]", ""), STR(?relation_type)), "")) = "Prevents"), false), ?from_step_version, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AgentDecisionRecords ===
effortless-ntwf:AgentDecisionRecordsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AgentDecisionRecords ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . OPTIONAL { ?deciding_agent effortless-ntwf:__key ?deciding_agent__key . } }
    OPTIONAL { $this effortless-ntwf:decisionSummary ?decision_summary . }
                BIND(CONCAT(COALESCE(COALESCE(?deciding_agent__key, IF(isIRI(?deciding_agent), REPLACE(STR(?deciding_agent), "^.*[#/]", ""), STR(?deciding_agent))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?decision_summary), 1, 60)), REPLACE(STR(SUBSTR(STR(?decision_summary), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?decision_summary), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_WasOverridden" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasOverridden ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:humanDisposition ?human_disposition . OPTIONAL { ?human_disposition effortless-ntwf:__key ?human_disposition__key . } }
                BIND((COALESCE((COALESCE(?human_disposition__key, COALESCE(IF(isIRI(?human_disposition), REPLACE(STR(?human_disposition), "^.*[#/]", ""), STR(?human_disposition)), "")) = "Corrected"), false) || COALESCE((COALESCE(?human_disposition__key, COALESCE(IF(isIRI(?human_disposition), REPLACE(STR(?human_disposition), "^.*[#/]", ""), STR(?human_disposition)), "")) = "Reversed"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_WasReviewed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasReviewed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:humanDisposition ?human_disposition . OPTIONAL { ?human_disposition effortless-ntwf:__key ?human_disposition__key . } }
                BIND((COALESCE((COALESCE(?human_disposition__key, COALESCE(IF(isIRI(?human_disposition), REPLACE(STR(?human_disposition), "^.*[#/]", ""), STR(?human_disposition)), "")) != ""), false) && COALESCE((COALESCE(?human_disposition__key, COALESCE(IF(isIRI(?human_disposition), REPLACE(STR(?human_disposition), "^.*[#/]", ""), STR(?human_disposition)), "")) != "NotReviewed"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_DecidingAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:decidingAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
                OPTIONAL { $this effortless-ntwf:decidingAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_DecidingAgentWhenOverridden" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:decidingAgentWhenOverridden ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND(IF(COALESCE(?was_overridden, false), ?deciding_agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_RoleAssignmentWhenScored" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:roleAssignmentWhenScored ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:underRoleAssignment ?under_role_assignment . OPTIONAL { ?under_role_assignment effortless-ntwf:__key ?under_role_assignment__key . } }
                BIND(IF(COALESCE((COALESCE(?under_role_assignment__key, COALESCE(IF(isIRI(?under_role_assignment), REPLACE(STR(?under_role_assignment), "^.*[#/]", ""), STR(?under_role_assignment)), "")) != ""), false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_RoleAssignmentWhenOverridden" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:roleAssignmentWhenOverridden ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:underRoleAssignment ?under_role_assignment . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND(IF(COALESCE(?was_overridden, false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_StepOfDecision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepOfDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_BoundaryMatchKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryMatchKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgentKind ?deciding_agent_kind . OPTIONAL { ?deciding_agent_kind effortless-ntwf:__key ?deciding_agent_kind__key . } }
    OPTIONAL { $this effortless-ntwf:decisionKind ?decision_kind . OPTIONAL { ?decision_kind effortless-ntwf:__key ?decision_kind__key . } }
    OPTIONAL { $this effortless-ntwf:stepOfDecision ?step_of_decision . OPTIONAL { ?step_of_decision effortless-ntwf:__key ?step_of_decision__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_of_decision__key, IF(isIRI(?step_of_decision), REPLACE(STR(?step_of_decision), "^.*[#/]", ""), STR(?step_of_decision))), ""), "|", COALESCE(COALESCE(?deciding_agent_kind__key, IF(isIRI(?deciding_agent_kind), REPLACE(STR(?deciding_agent_kind), "^.*[#/]", ""), STR(?deciding_agent_kind))), ""), "|", COALESCE(COALESCE(?decision_kind__key, IF(isIRI(?decision_kind), REPLACE(STR(?decision_kind), "^.*[#/]", ""), STR(?decision_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_MatchingBoundaryCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:matchingBoundaryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AuthorityBoundaries .
                    ?child effortless-ntwf:boundaryMatchKey ?backfk .
                    $this effortless-ntwf:boundaryMatchKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_ViolatedAuthorityBoundary" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:violatedAuthorityBoundary ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:matchingBoundaryCount ?matching_boundary_count . }
                BIND((COALESCE(?matching_boundary_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_ReviewerAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reviewerAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
                OPTIONAL { $this effortless-ntwf:reviewedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_HasHumanConfirmation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasHumanConfirmation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:humanDisposition ?human_disposition . OPTIONAL { ?human_disposition effortless-ntwf:__key ?human_disposition__key . } }
    OPTIONAL { $this effortless-ntwf:reviewerAgentKind ?reviewer_agent_kind . OPTIONAL { ?reviewer_agent_kind effortless-ntwf:__key ?reviewer_agent_kind__key . } }
                BIND((COALESCE((COALESCE(?reviewer_agent_kind__key, COALESCE(IF(isIRI(?reviewer_agent_kind), REPLACE(STR(?reviewer_agent_kind), "^.*[#/]", ""), STR(?reviewer_agent_kind)), "")) = "Human"), false) && COALESCE((COALESCE(?human_disposition__key, COALESCE(IF(isIRI(?human_disposition), REPLACE(STR(?human_disposition), "^.*[#/]", ""), STR(?human_disposition)), "")) != ""), false) && COALESCE((COALESCE(?human_disposition__key, COALESCE(IF(isIRI(?human_disposition), REPLACE(STR(?human_disposition), "^.*[#/]", ""), STR(?human_disposition)), "")) != "NotReviewed"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_NeedsHumanConfirmation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:needsHumanConfirmation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgentKind ?deciding_agent_kind . OPTIONAL { ?deciding_agent_kind effortless-ntwf:__key ?deciding_agent_kind__key . } }
    OPTIONAL { $this effortless-ntwf:materialityBand ?materiality_band . OPTIONAL { ?materiality_band effortless-ntwf:__key ?materiality_band__key . } }
                BIND((COALESCE((!(COALESCE((COALESCE(?deciding_agent_kind__key, COALESCE(IF(isIRI(?deciding_agent_kind), REPLACE(STR(?deciding_agent_kind), "^.*[#/]", ""), STR(?deciding_agent_kind)), "")) = "Human"), false))), false) && COALESCE((COALESCE((COALESCE(?materiality_band__key, COALESCE(IF(isIRI(?materiality_band), REPLACE(STR(?materiality_band), "^.*[#/]", ""), STR(?materiality_band)), "")) = "Material"), false) || COALESCE((COALESCE(?materiality_band__key, COALESCE(IF(isIRI(?materiality_band), REPLACE(STR(?materiality_band), "^.*[#/]", ""), STR(?materiality_band)), "")) = "Escalated"), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsUnconfirmedNonHumanDecision" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnconfirmedNonHumanDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:hasHumanConfirmation ?has_human_confirmation . }
    OPTIONAL { $this effortless-ntwf:needsHumanConfirmation ?needs_human_confirmation . }
                BIND((COALESCE(?needs_human_confirmation, false) && COALESCE((!(COALESCE(?has_human_confirmation, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_StepExecutionWhenUnconfirmed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepExecutionWhenUnconfirmed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:isUnconfirmedNonHumanDecision ?is_unconfirmed_non_human_decision . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_unconfirmed_non_human_decision, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_AgentWhenBoundaryViolated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentWhenBoundaryViolated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:violatedAuthorityBoundary ?violated_authority_boundary . }
                BIND(IF(COALESCE(?violated_authority_boundary, false), ?deciding_agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_ReviewLatencyMinutes" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reviewLatencyMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . }
    OPTIONAL { $this effortless-ntwf:reviewedAt ?reviewed_at . OPTIONAL { ?reviewed_at effortless-ntwf:__key ?reviewed_at__key . } }
                BIND(IF(COALESCE((COALESCE(?reviewed_at__key, COALESCE(IF(isIRI(?reviewed_at), REPLACE(STR(?reviewed_at), "^.*[#/]", ""), STR(?reviewed_at)), "")) = ""), false), 0, ((((DAY(?reviewed_at) + FLOOR((153 * (MONTH(?reviewed_at) + 12 * FLOOR((14 - MONTH(?reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?reviewed_at) * 3600 + MINUTES(?reviewed_at) * 60 + SECONDS(?reviewed_at)) - (HOURS(?decided_at) * 3600 + MINUTES(?decided_at) * 60 + SECONDS(?decided_at))) / 60)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsDraftKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDraftKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decisionKind ?decision_kind . OPTIONAL { ?decision_kind effortless-ntwf:__key ?decision_kind__key . } }
                BIND((COALESCE((COALESCE(?decision_kind__key, COALESCE(IF(isIRI(?decision_kind), REPLACE(STR(?decision_kind), "^.*[#/]", ""), STR(?decision_kind)), "")) = "Draft"), false) || COALESCE((COALESCE(?decision_kind__key, COALESCE(IF(isIRI(?decision_kind), REPLACE(STR(?decision_kind), "^.*[#/]", ""), STR(?decision_kind)), "")) = "Commitment"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_AgentWhenDraftOverridden" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentWhenDraftOverridden ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:isDraftKind ?is_draft_kind . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND(IF(COALESCE((COALESCE(?is_draft_kind, false) && COALESCE(?was_overridden, false)), false), ?deciding_agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_AgentWhenDraft" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentWhenDraft ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:isDraftKind ?is_draft_kind . }
                BIND(IF(COALESCE(?is_draft_kind, false), ?deciding_agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsErrorCorrection" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isErrorCorrection ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:overrideReasonKind ?override_reason_kind . OPTIONAL { ?override_reason_kind effortless-ntwf:__key ?override_reason_kind__key . } }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND((COALESCE(?was_overridden, false) && COALESCE((COALESCE(?override_reason_kind__key, COALESCE(IF(isIRI(?override_reason_kind), REPLACE(STR(?override_reason_kind), "^.*[#/]", ""), STR(?override_reason_kind)), "")) = "ErrorCorrection"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsReservedJudgmentOverride" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isReservedJudgmentOverride ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:overrideReasonKind ?override_reason_kind . OPTIONAL { ?override_reason_kind effortless-ntwf:__key ?override_reason_kind__key . } }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND((COALESCE(?was_overridden, false) && COALESCE((COALESCE(?override_reason_kind__key, COALESCE(IF(isIRI(?override_reason_kind), REPLACE(STR(?override_reason_kind), "^.*[#/]", ""), STR(?override_reason_kind)), "")) = "JudgmentReserved"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_OverrideReasonIsRecorded" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overrideReasonIsRecorded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:overrideReasonKind ?override_reason_kind . OPTIONAL { ?override_reason_kind effortless-ntwf:__key ?override_reason_kind__key . } }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND((COALESCE(?was_overridden, false) && COALESCE((COALESCE(?override_reason_kind__key, COALESCE(IF(isIRI(?override_reason_kind), REPLACE(STR(?override_reason_kind), "^.*[#/]", ""), STR(?override_reason_kind)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsUnexplainedOverride" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnexplainedOverride ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:overrideReasonIsRecorded ?override_reason_is_recorded . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND((COALESCE(?was_overridden, false) && COALESCE((!(COALESCE(?override_reason_is_recorded, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_ErrorCorrectionRoleAssignmentKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:errorCorrectionRoleAssignmentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:isErrorCorrection ?is_error_correction . }
    OPTIONAL { $this effortless-ntwf:underRoleAssignment ?under_role_assignment . }
                BIND(IF(COALESCE(?is_error_correction, false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_BoundaryViolationRoleAssignmentKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryViolationRoleAssignmentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:underRoleAssignment ?under_role_assignment . }
    OPTIONAL { $this effortless-ntwf:violatedAuthorityBoundary ?violated_authority_boundary . }
                BIND(IF(COALESCE(?violated_authority_boundary, false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AgentIntegrations ===
effortless-ntwf:AgentIntegrationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AgentIntegrations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentIntegrations .
    OPTIONAL { $this effortless-ntwf:agent ?agent . OPTIONAL { ?agent effortless-ntwf:__key ?agent__key . } }
    OPTIONAL { $this effortless-ntwf:pathway ?pathway . OPTIONAL { ?pathway effortless-ntwf:__key ?pathway__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?agent__key, IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent))), ""), " via ", COALESCE(COALESCE(?pathway__key, IF(isIRI(?pathway), REPLACE(STR(?pathway), "^.*[#/]", ""), STR(?pathway))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_PathwayIntegrationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:pathwayIntegrationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentIntegrations .
                OPTIONAL { $this effortless-ntwf:pathway ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:IntegrationPathways ; effortless-ntwf:integrationPathwayId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:integrationCountOnPathway ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_ObservedAnswerCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:observedAnswerCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentIntegrations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AssistantAnswers .
                    ?child effortless-ntwf:viaIntegration $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_IsShadowIntegration" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isShadowIntegration ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentIntegrations .
    OPTIONAL { $this effortless-ntwf:observedAnswerCount ?observed_answer_count . }
    OPTIONAL { $this effortless-ntwf:registryEntryKey ?registry_entry_key . OPTIONAL { ?registry_entry_key effortless-ntwf:__key ?registry_entry_key__key . } }
                BIND((COALESCE((COALESCE(?observed_answer_count, 0) > 0), false) && COALESCE((COALESCE(?registry_entry_key__key, COALESCE(IF(isIRI(?registry_entry_key), REPLACE(STR(?registry_entry_key), "^.*[#/]", ""), STR(?registry_entry_key)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_IsOneOffConnection" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOneOffConnection ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentIntegrations .
    OPTIONAL { $this effortless-ntwf:pathwayIntegrationCount ?pathway_integration_count . }
                BIND((COALESCE(?pathway_integration_count, 0) <= 1) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_SnapshotIsGoverned" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:snapshotIsGoverned ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentIntegrations .
                OPTIONAL { $this effortless-ntwf:servesSnapshot ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:GroundingSnapshots ; effortless-ntwf:groundingSnapshotId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isGoverned ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentIntegrations_IsDeployedOnUngovernedGraph" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDeployedOnUngovernedGraph ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentIntegrations .
    OPTIONAL { $this effortless-ntwf:servesSnapshot ?serves_snapshot . OPTIONAL { ?serves_snapshot effortless-ntwf:__key ?serves_snapshot__key . } }
    OPTIONAL { $this effortless-ntwf:snapshotIsGoverned ?snapshot_is_governed . }
                BIND((COALESCE((COALESCE(?serves_snapshot__key, COALESCE(IF(isIRI(?serves_snapshot), REPLACE(STR(?serves_snapshot), "^.*[#/]", ""), STR(?serves_snapshot)), "")) != ""), false) && COALESCE((COALESCE(?snapshot_is_governed, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AgentUpgradeAssessments ===
effortless-ntwf:AgentUpgradeAssessmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AgentUpgradeAssessments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentUpgradeAssessments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentUpgradeAssessments .
    OPTIONAL { $this effortless-ntwf:assessmentMethod ?assessment_method . OPTIONAL { ?assessment_method effortless-ntwf:__key ?assessment_method__key . } }
    OPTIONAL { $this effortless-ntwf:candidateAgent ?candidate_agent . OPTIONAL { ?candidate_agent effortless-ntwf:__key ?candidate_agent__key . } }
    OPTIONAL { $this effortless-ntwf:currentAgent ?current_agent . OPTIONAL { ?current_agent effortless-ntwf:__key ?current_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?current_agent__key, IF(isIRI(?current_agent), REPLACE(STR(?current_agent), "^.*[#/]", ""), STR(?current_agent))), ""), " -> ", COALESCE(COALESCE(?candidate_agent__key, IF(isIRI(?candidate_agent), REPLACE(STR(?candidate_agent), "^.*[#/]", ""), STR(?candidate_agent))), ""), " (", COALESCE(COALESCE(?assessment_method__key, IF(isIRI(?assessment_method), REPLACE(STR(?assessment_method), "^.*[#/]", ""), STR(?assessment_method))), ""), ")") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentUpgradeAssessments_AttributedArtifactCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:attributedArtifactCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentUpgradeAssessments .
                OPTIONAL { $this effortless-ntwf:currentAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:attributedArtifactCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentUpgradeAssessments_TraversedDownstreamStepCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:traversedDownstreamStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentUpgradeAssessments .
                OPTIONAL { $this effortless-ntwf:currentAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:artifactBlastRadiusStepCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentUpgradeAssessments_MissedTraversedImpact" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:missedTraversedImpact ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentUpgradeAssessments .
    OPTIONAL { $this effortless-ntwf:listedAffectedStepCount ?listed_affected_step_count . }
    OPTIONAL { $this effortless-ntwf:traversedDownstreamStepCount ?traversed_downstream_step_count . }
                BIND((COALESCE(?listed_affected_step_count, 0) < COALESCE(?traversed_downstream_step_count, 0)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Agents ===
effortless-ntwf:AgentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Agents ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_CountOfCurrentRoleAssignments" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfCurrentRoleAssignments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:currentAgentKey ?backfk .
                    $this effortless-ntwf:agentId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
