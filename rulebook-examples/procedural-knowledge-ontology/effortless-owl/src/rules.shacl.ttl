            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOutgrownBaselineQuestion ?_result .
            }
            WHERE {
    $this a pko-extension:CompetencyQuestionSetEntry .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceAdded ?days_since_added . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOriginalBaseline ?is_original_baseline . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:relevanceVerdict ?relevance_verdict . OPTIONAL { ?relevance_verdict erb:key ?relevance_verdict__key . } }
                BIND((COALESCE(?is_original_baseline, false) && COALESCE((COALESCE(?days_since_added, 0) > 365), false) && COALESCE((COALESCE(?relevance_verdict__key, COALESCE(IF(isIRI(?relevance_verdict), REPLACE(STR(?relevance_verdict), "^.*[#/]", ""), STR(?relevance_verdict)), "")) = "NoLongerRelevant"), false)) AS ?_result)
            }
        """ ;
    ] .
