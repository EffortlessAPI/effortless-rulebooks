pko-native-procedural-knowledge-rulebook-shapes:ConformanceSubstrates_DisagreeingFieldCount a sh:NodeShape ;
    sh:targetClass pko-extension:ConformanceSubstrate ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_DisagreeingFieldCount" ;
