# === Filtered closure edges for vw_step_transitions_closure_where_avoids_human_approval_gate ===
pko-native-procedural-knowledge-rulebook-shapes:leadsWithoutHumanGateEdge a sh:NodeShape ;
    sh:targetClass p-plan:Step ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_leadsWithoutHumanGate" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:leadsWithoutHumanGate ?_to .
            }
            WHERE {
    $this a p-plan:Step .
    ?_edge a pko:Transition ; pko:fromStep $this ; pko:toStep ?_to ; pko-native-procedural-knowledge-rulebook:avoidsHumanApprovalGate true .
            }
        """ ;
    ] .

