    OPTIONAL { $this effortless-ntwf:refusalNotifiedRole ?refusal_notified_role . OPTIONAL { ?refusal_notified_role effortless-ntwf:__key ?refusal_notified_role__key . } }
                BIND((COALESCE(?refusal_notified_role__key, COALESCE(IF(isIRI(?refusal_notified_role), REPLACE(STR(?refusal_notified_role), "^.*[#/]", ""), STR(?refusal_notified_role)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsUnrecordedRefusal" ;
        sh:prefixes effortless-ntwf: ;
