                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowHowCarriers_BuildsOnSameCommunityKnowHow a sh:NodeShape ;
    sh:targetClass pko-extension:KnowHowCarrier ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_BuildsOnSameCommunityKnowHow" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:buildsOnSameCommunityKnowHow ?_result .
            }
            WHERE {
    $this a pko-extension:KnowHowCarrier .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:buildsOnKnowHow ?builds_on_know_how . OPTIONAL { ?builds_on_know_how erb:key ?builds_on_know_how__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:communityOfPractice ?community_of_practice . OPTIONAL { ?community_of_practice erb:key ?community_of_practice__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:dependencyCommunity ?dependency_community . }
                BIND((COALESCE((COALESCE(?builds_on_know_how__key, COALESCE(IF(isIRI(?builds_on_know_how), REPLACE(STR(?builds_on_know_how), "^.*[#/]", ""), STR(?builds_on_know_how)), "")) != ""), false) && COALESCE((COALESCE(?community_of_practice__key, COALESCE(IF(isIRI(?community_of_practice), REPLACE(STR(?community_of_practice), "^.*[#/]", ""), STR(?community_of_practice)), "")) != ""), false) && COALESCE(COALESCE((?dependency_community = ?community_of_practice), ((!BOUND(?dependency_community) || STR(?dependency_community) = "") && (!BOUND(?community_of_practice) || STR(?community_of_practice) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowHowCarriers_LostAccumulationYears a sh:NodeShape ;
