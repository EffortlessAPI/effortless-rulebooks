    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:modelLayerBudget ?model_layer_budget . }
                BIND((COALESCE((COALESCE(?model_layer_budget, 0) > 0), false) && COALESCE((COALESCE(?knowledge_layer_budget, 0) < COALESCE(?model_layer_budget, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AiAdoptionInitiatives_NotAnchoredInProcessKnowledge a sh:NodeShape ;
