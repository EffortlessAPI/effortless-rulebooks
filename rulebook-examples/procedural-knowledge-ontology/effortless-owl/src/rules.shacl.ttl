    $this a pko-extension:StepCue .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:signalsFailureMode ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:FailureMode . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:response ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepCues_IsUnanswerableSign a sh:NodeShape ;
    sh:targetClass pko-extension:StepCue ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepCues_IsUnanswerableSign" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isUnanswerableSign ?_result .
            }
            WHERE {
    $this a pko-extension:StepCue .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:signalsFailureMode ?signals_failure_mode . OPTIONAL { ?signals_failure_mode erb:key ?signals_failure_mode__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:signalsIncompleteStep ?signals_incomplete_step . }
                BIND((COALESCE((COALESCE(?signals_incomplete_step, false) = true), false) && COALESCE((COALESCE(?signals_failure_mode__key, COALESCE(IF(isIRI(?signals_failure_mode), REPLACE(STR(?signals_failure_mode), "^.*[#/]", ""), STR(?signals_failure_mode)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for StepExecutions ===
pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_Name a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko:StepExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureExecution ?procedure_execution . OPTIONAL { ?procedure_execution erb:key ?procedure_execution__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?step . OPTIONAL { ?step erb:key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_execution__key, IF(isIRI(?procedure_execution), REPLACE(STR(?procedure_execution), "^.*[#/]", ""), STR(?procedure_execution))), ""), " / ", COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_ActualDurationMinutes a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ActualDurationMinutes" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:actualDurationMinutes ?_result .
            }
            WHERE {
    $this a pko:StepExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:endedAt ?ended_at . OPTIONAL { ?ended_at erb:key ?ended_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:startedAt ?started_at . }
                BIND(ROUND(IF(COALESCE((COALESCE(?ended_at__key, COALESCE(IF(isIRI(?ended_at), REPLACE(STR(?ended_at), "^.*[#/]", ""), STR(?ended_at)), "")) = ""), false), 0, ((((DAY(?ended_at) + FLOOR((153 * (MONTH(?ended_at) + 12 * FLOOR((14 - MONTH(?ended_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 4) - FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 100) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 400) - 32045) - (DAY(?started_at) + FLOOR((153 * (MONTH(?started_at) + 12 * FLOOR((14 - MONTH(?started_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 4) - FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 100) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 400) - 32045)) * 86400 + (HOURS(?ended_at) * 3600 + MINUTES(?ended_at) * 60 + SECONDS(?ended_at)) - (HOURS(?started_at) * 3600 + MINUTES(?started_at) * 60 + SECONDS(?started_at))) / 60))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_ExpectedDurationMinutes a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExpectedDurationMinutes" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:expectedDurationMinutes ?_result .
            }
            WHERE {
    $this a pko:StepExecution .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:step ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a p-plan:Step . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:expectedDurationMinutes ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_IsLate a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsLate" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isLate ?_result .
            }
            WHERE {
    $this a pko:StepExecution .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:actualDurationMinutes ?actual_duration_minutes . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:expectedDurationMinutes ?expected_duration_minutes . }
                BIND((COALESCE(?actual_duration_minutes, 0) > COALESCE(?expected_duration_minutes, 0)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_BlockingUnmetCount a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_BlockingUnmetCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko: <https://w3id.org/pko#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:blockingUnmetCount ?_result .
            }
            WHERE {
    $this a pko:StepExecution .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko:StepExecution .
                    ?child a pko:RequirementSatisfaction .
                    ?child pko-native-procedural-knowledge-rulebook:stepExecution $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isBlockingAndUnmet ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
