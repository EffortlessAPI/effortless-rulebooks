            PREFIX pko-industry: <https://w3id.org/pko/industry#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isNonStandardConfiguration ?_result .
            }
            WHERE {
    $this a pko-industry:Machine .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:configurationKind ?configuration_kind . OPTIONAL { ?configuration_kind erb:key ?configuration_kind__key . } }
                BIND((COALESCE(?configuration_kind__key, COALESCE(IF(isIRI(?configuration_kind), REPLACE(STR(?configuration_kind), "^.*[#/]", ""), STR(?configuration_kind)), "")) = "NonStandard") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Machines_HasUnisolatedEnergySource a sh:NodeShape ;
    sh:targetClass pko-industry:Machine ;
    sh:order 6 ;
    sh:rule [
