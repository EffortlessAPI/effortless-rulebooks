                $this effortless-ntwf:isPreparationStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:assignedRole ?assigned_role . }
                BIND((COALESCE((REPLACE(COALESCE(STR(?assigned_role), ""), "^.*#", "") = "finance-analyst"), false) || COALESCE((REPLACE(COALESCE(STR(?assigned_role), ""), "^.*#", "") = "variance-review-agent"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
