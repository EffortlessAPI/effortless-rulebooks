    OPTIONAL { $this effortless-ntwf:isFabricatedAcknowledgement ?is_fabricated_acknowledgement . }
    OPTIONAL { $this effortless-ntwf:isUnhandledUnreachable ?is_unhandled_unreachable . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE((COALESCE(?is_fabricated_acknowledgement, false) || COALESCE(?is_unhandled_unreachable, false)), false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyRetentionDays" ;
