    OPTIONAL { $this effortless-ntwf:designDecisionCount ?design_decision_count . }
    OPTIONAL { $this effortless-ntwf:isLive ?is_live . }
                BIND((COALESCE(?is_live, false) && COALESCE((COALESCE(?design_decision_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_AiArtifactConsumingInputCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:aiArtifactConsumingInputCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepVariables .
                    ?child effortless-ntwf:consumerWorkflow ?backfk .
                    $this effortless-ntwf:procedureVersionId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:isInputFromAiArtifact ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ContainsStepsAffectedByAiAgentChange" ;
