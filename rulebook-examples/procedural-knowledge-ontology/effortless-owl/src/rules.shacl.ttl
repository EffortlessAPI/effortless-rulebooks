pko-native-procedural-knowledge-rulebook-shapes:ModelChangeRequests_UnresolvedObjectionCount a sh:NodeShape ;
    sh:targetClass pko-extension:ModelChangeRequest ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_UnresolvedObjectionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:unresolvedObjectionCount ?_result .
            }
            WHERE {
    $this a pko-extension:ModelChangeRequest .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ModelChangeRequest .
                    ?child a pko-extension:ChangeObjection .
                    ?child pko-native-procedural-knowledge-rulebook:modelChangeRequest $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isUnresolved ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ModelChangeRequests_ApprovedOverUnresolvedObjection a sh:NodeShape ;
    sh:targetClass pko-extension:ModelChangeRequest ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelChangeRequests_ApprovedOverUnresolvedObjection" ;
