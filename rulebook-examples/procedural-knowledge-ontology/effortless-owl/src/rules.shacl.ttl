# === Rules for SharingRecognitions ===
pko-native-procedural-knowledge-rulebook-shapes:SharingRecognitions_Name a sh:NodeShape ;
    sh:targetClass pko-extension:SharingRecognition ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SharingRecognitions_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:SharingRecognition .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recognitionKind ?recognition_kind . OPTIONAL { ?recognition_kind erb:key ?recognition_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recognizedAgent ?recognized_agent . OPTIONAL { ?recognized_agent erb:key ?recognized_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?recognition_kind__key, IF(isIRI(?recognition_kind), REPLACE(STR(?recognition_kind), "^.*[#/]", ""), STR(?recognition_kind))), ""), ": ", COALESCE(COALESCE(?recognized_agent__key, IF(isIRI(?recognized_agent), REPLACE(STR(?recognized_agent), "^.*[#/]", ""), STR(?recognized_agent))), "")) AS ?_result)
            }
        """ ;
    ] .

