    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:employerMoveCount ?employer_move_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:openApprenticeshipPlaces ?open_apprenticeship_places . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:recentApprenticeshipCount ?recent_apprenticeship_count . }
                BIND((COALESCE((COALESCE(?employer_move_count, 0) >= 1), false) && COALESCE((COALESCE(?open_apprenticeship_places, 0) > 0), false) && COALESCE((COALESCE(?recent_apprenticeship_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
