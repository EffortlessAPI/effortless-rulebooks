            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isWidelyAdoptedTerm ?_result .
            }
            WHERE {
    $this a pko-extension:VocabularyTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:usageCount ?usage_count . }
                BIND((COALESCE(?usage_count, 0) >= 2) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:VocabularyTerms_OrphanTermVocabularyKey a sh:NodeShape ;
    sh:targetClass pko-extension:VocabularyTerm ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_OrphanTermVocabularyKey" ;
