pko-native-procedural-knowledge-rulebook-shapes:GovernedModels_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-extension:GovernedModel ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_AsOfInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-extension:GovernedModel .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:GovernedModels_DaysSinceRegistered a sh:NodeShape ;
    sh:targetClass pko-extension:GovernedModel ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_DaysSinceRegistered" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceRegistered ?_result .
            }
            WHERE {
    $this a pko-extension:GovernedModel .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:registeredAt ?registered_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?registered_at) + FLOOR((153 * (MONTH(?registered_at) + 12 * FLOOR((14 - MONTH(?registered_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?registered_at) + 4800 - FLOOR((14 - MONTH(?registered_at)) / 12)) + FLOOR((YEAR(?registered_at) + 4800 - FLOOR((14 - MONTH(?registered_at)) / 12)) / 4) - FLOOR((YEAR(?registered_at) + 4800 - FLOOR((14 - MONTH(?registered_at)) / 12)) / 100) + FLOOR((YEAR(?registered_at) + 4800 - FLOOR((14 - MONTH(?registered_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:GovernedModels_CharterCount a sh:NodeShape ;
    sh:targetClass pko-extension:GovernedModel ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_CharterCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:charterCount ?_result .
            }
            WHERE {
    $this a pko-extension:GovernedModel .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:GovernedModel .
                    ?child a pko-extension:ModelCharter .
                    ?child pko-native-procedural-knowledge-rulebook:governedModel $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:GovernedModels_CurrentCharterCount a sh:NodeShape ;
    sh:targetClass pko-extension:GovernedModel ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_CurrentCharterCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:currentCharterCount ?_result .
            }
            WHERE {
    $this a pko-extension:GovernedModel .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:GovernedModel .
                    ?child a pko-extension:ModelCharter .
                    ?child pko-native-procedural-knowledge-rulebook:governedModel $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:isCurrent ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
