    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureRepositoryEntryCount ?procedure_repository_entry_count . }
                BIND((COALESCE((COALESCE(?procedure_repository_entry_count, 0) = 0), false) && COALESCE((COALESCE(?procedure_departed_only_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for OntologyProfiles ===
pko-native-procedural-knowledge-rulebook-shapes:OntologyProfiles_Name a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:OntologyProfiles ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:OntologyProfiles .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:label ?label . OPTIONAL { ?label erb:key ?label__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:version ?version . OPTIONAL { ?version erb:key ?version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), ""), " ", COALESCE(COALESCE(?version__key, IF(isIRI(?version), REPLACE(STR(?version), "^.*[#/]", ""), STR(?version))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OntologyProfiles_MappingCount a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:OntologyProfiles ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OntologyProfiles_MappingCount" ;
        sh:construct """
