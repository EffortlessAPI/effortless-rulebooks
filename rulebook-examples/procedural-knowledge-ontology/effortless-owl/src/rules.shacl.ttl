pko-native-procedural-knowledge-rulebook-shapes:KnowHowCarriers_TransferStopsWithoutVeteran a sh:NodeShape ;
    sh:targetClass pko-extension:KnowHowCarrier ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_TransferStopsWithoutVeteran" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:transferStopsWithoutVeteran ?_result .
            }
            WHERE {
    $this a pko-extension:KnowHowCarrier .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:holderIsStillEngaged ?holder_is_still_engaged . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isVeteranHeld ?is_veteran_held . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:repositoryEntryCount ?repository_entry_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:transferCount ?transfer_count . }
                BIND((COALESCE(?is_veteran_held, false) && COALESCE((COALESCE(?holder_is_still_engaged, false) = true), false) && COALESCE((COALESCE(?transfer_count, 0) > 0), false) && COALESCE((COALESCE(?repository_entry_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
