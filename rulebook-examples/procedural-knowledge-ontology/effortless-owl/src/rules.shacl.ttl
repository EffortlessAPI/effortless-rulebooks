                BIND(CONCAT(COALESCE(COALESCE(?action_kind__key, IF(isIRI(?action_kind), REPLACE(STR(?action_kind), "^.*[#/]", ""), STR(?action_kind))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?action_description), 1, 60)), REPLACE(STR(SUBSTR(STR(?action_description), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?action_description), 1, 60))), "")) AS ?_result)
            }
