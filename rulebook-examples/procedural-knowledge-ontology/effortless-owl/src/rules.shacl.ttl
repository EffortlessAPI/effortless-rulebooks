pko-native-procedural-knowledge-rulebook-shapes:ExternalStandardTerms_DaysSinceDeprecated a sh:NodeShape ;
    sh:targetClass pko-extension:ExternalStandardTerm ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_DaysSinceDeprecated" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysSinceDeprecated ?_result .
            }
            WHERE {
    $this a pko-extension:ExternalStandardTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deprecatedAt ?deprecated_at . OPTIONAL { ?deprecated_at erb:key ?deprecated_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?deprecated_at__key, COALESCE(IF(isIRI(?deprecated_at), REPLACE(STR(?deprecated_at), "^.*[#/]", ""), STR(?deprecated_at)), "")) = ""), false), 0, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?deprecated_at) + FLOOR((153 * (MONTH(?deprecated_at) + 12 * FLOOR((14 - MONTH(?deprecated_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?deprecated_at) + 4800 - FLOOR((14 - MONTH(?deprecated_at)) / 12)) + FLOOR((YEAR(?deprecated_at) + 4800 - FLOOR((14 - MONTH(?deprecated_at)) / 12)) / 4) - FLOOR((YEAR(?deprecated_at) + 4800 - FLOOR((14 - MONTH(?deprecated_at)) / 12)) / 100) + FLOOR((YEAR(?deprecated_at) + 4800 - FLOOR((14 - MONTH(?deprecated_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExternalStandardTerms_IsRecentDeprecation a sh:NodeShape ;
    sh:targetClass pko-extension:ExternalStandardTerm ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_IsRecentDeprecation" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isRecentDeprecation ?_result .
            }
            WHERE {
    $this a pko-extension:ExternalStandardTerm .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceDeprecated ?days_since_deprecated . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deprecatedAt ?deprecated_at . OPTIONAL { ?deprecated_at erb:key ?deprecated_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:deprecatedBySource ?deprecated_by_source . }
                BIND((COALESCE(?deprecated_by_source, false) && COALESCE((COALESCE(?deprecated_at__key, COALESCE(IF(isIRI(?deprecated_at), REPLACE(STR(?deprecated_at), "^.*[#/]", ""), STR(?deprecated_at)), "")) != ""), false) && COALESCE((COALESCE(?days_since_deprecated, 0) <= 730), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExternalStandardTerms_UsingMappingCount a sh:NodeShape ;
    sh:targetClass pko-extension:ExternalStandardTerm ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_UsingMappingCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:usingMappingCount ?_result .
            }
            WHERE {
    $this a pko-extension:ExternalStandardTerm .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ExternalStandardTerm .
                    ?child a pko-native-procedural-knowledge-rulebook:SemanticMappings .
                    ?child pko-native-procedural-knowledge-rulebook:targetIri ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:termIri ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExternalStandardTerms_StaleIdentifierMappingCount a sh:NodeShape ;
    sh:targetClass pko-extension:ExternalStandardTerm ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_StaleIdentifierMappingCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:staleIdentifierMappingCount ?_result .
            }
            WHERE {
    $this a pko-extension:ExternalStandardTerm .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:ExternalStandardTerm .
                    ?child a pko-native-procedural-knowledge-rulebook:SemanticMappings .
                    ?child pko-native-procedural-knowledge-rulebook:targetIri ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:previousTermIri ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ExternalStandardTerms_IsAdoptedButDeprecated a sh:NodeShape ;
    sh:targetClass pko-extension:ExternalStandardTerm ;
