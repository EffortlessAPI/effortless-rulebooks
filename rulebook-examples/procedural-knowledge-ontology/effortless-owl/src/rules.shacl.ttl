    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsOrphanedByRole" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOrphanedByRole ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeFragment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ownerRoleIsVacated ?owner_role_is_vacated . }
                BIND((COALESCE(?is_currently_valid, false) && COALESCE(?owner_role_is_vacated, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeFragments_ValidFragmentVersionKey a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeFragment ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_ValidFragmentVersionKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:validFragmentVersionKey ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeFragment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_currently_valid, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeFragments_IsFlattenedToBrittleRule a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeFragment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsFlattenedToBrittleRule" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isFlattenedToBrittleRule ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeFragment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:encodedAs ?encoded_as . OPTIONAL { ?encoded_as erb:key ?encoded_as__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeForm ?knowledge_form . OPTIONAL { ?knowledge_form erb:key ?knowledge_form__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:statedConditions ?stated_conditions . OPTIONAL { ?stated_conditions erb:key ?stated_conditions__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?knowledge_form__key, COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), "")) = "Tacit"), false) || COALESCE((COALESCE(?knowledge_form__key, COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), STR(?knowledge_form)), "")) = "SituatedJudgment"), false)), false) && COALESCE((COALESCE(?encoded_as__key, COALESCE(IF(isIRI(?encoded_as), REPLACE(STR(?encoded_as), "^.*[#/]", ""), STR(?encoded_as)), "")) = "HardRule"), false) && COALESCE((COALESCE(?stated_conditions__key, COALESCE(IF(isIRI(?stated_conditions), REPLACE(STR(?stated_conditions), "^.*[#/]", ""), STR(?stated_conditions)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeFragments_CorroborationCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeFragment ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_CorroborationCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:corroborationCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeFragment .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:KnowledgeFragment .
                    ?child a pko-extension:FragmentCorroboration .
                    ?child pko-native-procedural-knowledge-rulebook:knowledgeFragment $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:agrees ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeFragments_RestsOnSingleDataPoint a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeFragment ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_RestsOnSingleDataPoint" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:restsOnSingleDataPoint ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeFragment .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:corroborationCount ?corroboration_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status_KnowledgeFragments ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Approved"), false) && COALESCE((COALESCE(?corroboration_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeFragments_OwnerOrganization a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeFragment ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_OwnerOrganization" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:ownerOrganization ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeFragment .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-native-procedural-knowledge-rulebook:ProcedureVersions . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:ownerOrganization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for KnowledgeGaps ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_Name a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:severity ?severity . OPTIONAL { ?severity erb:key ?severity__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:statement ?statement . }
                BIND(CONCAT(COALESCE(COALESCE(?severity__key, IF(isIRI(?severity), REPLACE(STR(?severity), "^.*[#/]", ""), STR(?severity))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?statement), 1, 60)), REPLACE(STR(SUBSTR(STR(?statement), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?statement), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_IsOpen a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsOpen" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOpen ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:status_KnowledgeGaps ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Open"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Investigating"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_OpenGapVersionKey a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OpenGapVersionKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:openGapVersionKey ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOpen ?is_open . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:severity ?severity . OPTIONAL { ?severity erb:key ?severity__key . } }
                BIND(IF(COALESCE((COALESCE(?is_open, false) && COALESCE((COALESCE(?severity__key, COALESCE(IF(isIRI(?severity), REPLACE(STR(?severity), "^.*[#/]", ""), STR(?severity)), "")) = "High"), false)), false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_IsBlocking a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsBlocking" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isBlocking ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:blockingKind ?blocking_kind . OPTIONAL { ?blocking_kind erb:key ?blocking_kind__key . } }
                BIND((COALESCE(?blocking_kind__key, COALESCE(IF(isIRI(?blocking_kind), REPLACE(STR(?blocking_kind), "^.*[#/]", ""), STR(?blocking_kind)), "")) = "Blocking") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_IsOpenAndBlocking a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsOpenAndBlocking" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOpenAndBlocking ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isBlocking ?is_blocking . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOpen ?is_open . }
                BIND((COALESCE(?is_open, false) && COALESCE(?is_blocking, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_AsOfInstant a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_AsOfInstant" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:asOfInstant ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:evaluationContext ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pko-extension:EvaluationContext . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_DaysOpen a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_DaysOpen" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:daysOpen ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:asOfInstant ?as_of_instant . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:identifiedAt ?identified_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOpen ?is_open . }
                BIND(ROUND(IF(COALESCE(?is_open, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?identified_at) + FLOOR((153 * (MONTH(?identified_at) + 12 * FLOOR((14 - MONTH(?identified_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) + FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 4) - FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 100) + FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_ToleranceDays a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_ToleranceDays" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:toleranceDays ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:severity ?severity . OPTIONAL { ?severity erb:key ?severity__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?severity__key, COALESCE(IF(isIRI(?severity), REPLACE(STR(?severity), "^.*[#/]", ""), STR(?severity)), "")) = "High"), false), 30, IF(COALESCE((COALESCE(?severity__key, COALESCE(IF(isIRI(?severity), REPLACE(STR(?severity), "^.*[#/]", ""), STR(?severity)), "")) = "Medium"), false), 90, 180))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_IsOverdueGap a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsOverdueGap" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isOverdueGap ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysOpen ?days_open . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:toleranceDays ?tolerance_days . }
                BIND((COALESCE(?days_open, 0) > COALESCE(?tolerance_days, 0)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_OwnerAgent a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OwnerAgent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:ownerAgent ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ownerRole ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:Role . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:currentAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_OwnerIsStillEngaged a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OwnerIsStillEngaged" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:ownerIsStillEngaged ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ownerAgent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isStillEngaged ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_HasResolutionPlan a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_HasResolutionPlan" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasResolutionPlan ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:resolutionPlan ?resolution_plan . OPTIONAL { ?resolution_plan erb:key ?resolution_plan__key . } }
                BIND((COALESCE(?resolution_plan__key, COALESCE(IF(isIRI(?resolution_plan), REPLACE(STR(?resolution_plan), "^.*[#/]", ""), STR(?resolution_plan)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_IsAbandonedUnknown a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsAbandonedUnknown" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isAbandonedUnknown ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:hasResolutionPlan ?has_resolution_plan . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOverdueGap ?is_overdue_gap . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ownerIsStillEngaged ?owner_is_still_engaged . }
                BIND((COALESCE(?is_overdue_gap, false) && COALESCE((COALESCE((!(COALESCE(?has_resolution_plan, false))), false) || COALESCE((!(COALESCE(?owner_is_still_engaged, false))), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_OpenBlockingGapVersionKey a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OpenBlockingGapVersionKey" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:openBlockingGapVersionKey ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isOpenAndBlocking ?is_open_and_blocking . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_open_and_blocking, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_OwnerRoleIsVacated a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OwnerRoleIsVacated" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:ownerRoleIsVacated ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeGap .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:ownerRole ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:Role . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isVacatedRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeGaps_IsOwnerlessOpenGap a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeGap ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsOwnerlessOpenGap" ;
