            CONSTRUCT {
                $this effortless-ntwf:procedureExecutionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
                OPTIONAL { $this effortless-ntwf:procedure ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Procedures ; effortless-ntwf:procedureId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:executionCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_HasJustification" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasJustification ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
    OPTIONAL { $this effortless-ntwf:justification ?justification . OPTIONAL { ?justification effortless-ntwf:__key ?justification__key . } }
                BIND((COALESCE(?justification__key, COALESCE(IF(isIRI(?justification), REPLACE(STR(?justification), "^.*[#/]", ""), STR(?justification)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_IsWitnessProof" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWitnessProof ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
    OPTIONAL { $this effortless-ntwf:evidenceKind ?evidence_kind . OPTIONAL { ?evidence_kind effortless-ntwf:__key ?evidence_kind__key . } }
    OPTIONAL { $this effortless-ntwf:fieldCatalogName ?field_catalog_name . OPTIONAL { ?field_catalog_name effortless-ntwf:__key ?field_catalog_name__key . } }
    OPTIONAL { $this effortless-ntwf:fieldIsDiscriminating ?field_is_discriminating . }
    OPTIONAL { $this effortless-ntwf:fieldIsWitness ?field_is_witness . }
                BIND((COALESCE((COALESCE(?evidence_kind__key, COALESCE(IF(isIRI(?evidence_kind), REPLACE(STR(?evidence_kind), "^.*[#/]", ""), STR(?evidence_kind)), "")) = "Field"), false) && COALESCE((COALESCE(?field_catalog_name__key, COALESCE(IF(isIRI(?field_catalog_name), REPLACE(STR(?field_catalog_name), "^.*[#/]", ""), STR(?field_catalog_name)), "")) != ""), false) && COALESCE(?field_is_witness, false) && COALESCE(?field_is_discriminating, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_IsStructuralProof" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStructuralProof ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
    OPTIONAL { $this effortless-ntwf:evidenceKind ?evidence_kind . OPTIONAL { ?evidence_kind effortless-ntwf:__key ?evidence_kind__key . } }
    OPTIONAL { $this effortless-ntwf:fieldCatalogName ?field_catalog_name . OPTIONAL { ?field_catalog_name effortless-ntwf:__key ?field_catalog_name__key . } }
    OPTIONAL { $this effortless-ntwf:fieldHasData ?field_has_data . }
    OPTIONAL { $this effortless-ntwf:tableHasRows ?table_has_rows . }
                BIND((COALESCE((COALESCE((COALESCE(?evidence_kind__key, COALESCE(IF(isIRI(?evidence_kind), REPLACE(STR(?evidence_kind), "^.*[#/]", ""), STR(?evidence_kind)), "")) = "Table"), false) && COALESCE(?table_has_rows, false)), false) || COALESCE((COALESCE((COALESCE(?evidence_kind__key, COALESCE(IF(isIRI(?evidence_kind), REPLACE(STR(?evidence_kind), "^.*[#/]", ""), STR(?evidence_kind)), "")) = "Field"), false) && COALESCE((COALESCE(?field_catalog_name__key, COALESCE(IF(isIRI(?field_catalog_name), REPLACE(STR(?field_catalog_name), "^.*[#/]", ""), STR(?field_catalog_name)), "")) != ""), false) && COALESCE(?field_has_data, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_IsQuestionProof" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isQuestionProof ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
    OPTIONAL { $this effortless-ntwf:evidenceKind ?evidence_kind . OPTIONAL { ?evidence_kind effortless-ntwf:__key ?evidence_kind__key . } }
    OPTIONAL { $this effortless-ntwf:questionIsAnswered ?question_is_answered . }
    OPTIONAL { $this effortless-ntwf:questionWitnessedAnswer ?question_witnessed_answer . OPTIONAL { ?question_witnessed_answer effortless-ntwf:__key ?question_witnessed_answer__key . } }
                BIND((COALESCE((COALESCE(?evidence_kind__key, COALESCE(IF(isIRI(?evidence_kind), REPLACE(STR(?evidence_kind), "^.*[#/]", ""), STR(?evidence_kind)), "")) = "RoleQuestion"), false) && COALESCE(?question_is_answered, false) && COALESCE((COALESCE(?question_witnessed_answer__key, COALESCE(IF(isIRI(?question_witnessed_answer), REPLACE(STR(?question_witnessed_answer), "^.*[#/]", ""), STR(?question_witnessed_answer)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_IsStandardProof" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isStandardProof ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
    OPTIONAL { $this effortless-ntwf:evidenceKind ?evidence_kind . OPTIONAL { ?evidence_kind effortless-ntwf:__key ?evidence_kind__key . } }
    OPTIONAL { $this effortless-ntwf:methodIsApplied ?method_is_applied . }
    OPTIONAL { $this effortless-ntwf:profileMappingCount ?profile_mapping_count . }
                BIND((COALESCE((COALESCE((COALESCE(?evidence_kind__key, COALESCE(IF(isIRI(?evidence_kind), REPLACE(STR(?evidence_kind), "^.*[#/]", ""), STR(?evidence_kind)), "")) = "OntologyProfile"), false) && COALESCE((COALESCE(?profile_mapping_count, 0) > 0), false)), false) || COALESCE((COALESCE((COALESCE(?evidence_kind__key, COALESCE(IF(isIRI(?evidence_kind), REPLACE(STR(?evidence_kind), "^.*[#/]", ""), STR(?evidence_kind)), "")) = "KnowledgeMethod"), false) && COALESCE(?method_is_applied, false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_IsScenarioProof" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isScenarioProof ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
    OPTIONAL { $this effortless-ntwf:evidenceKind ?evidence_kind . OPTIONAL { ?evidence_kind effortless-ntwf:__key ?evidence_kind__key . } }
    OPTIONAL { $this effortless-ntwf:procedureExecutionCount ?procedure_execution_count . }
                BIND((COALESCE((COALESCE(?evidence_kind__key, COALESCE(IF(isIRI(?evidence_kind), REPLACE(STR(?evidence_kind), "^.*[#/]", ""), STR(?evidence_kind)), "")) = "Procedure"), false) && COALESCE((COALESCE(?procedure_execution_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_IsValid" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isValid ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
    OPTIONAL { $this effortless-ntwf:claimKind ?claim_kind . OPTIONAL { ?claim_kind effortless-ntwf:__key ?claim_kind__key . } }
    OPTIONAL { $this effortless-ntwf:hasJustification ?has_justification . }
    OPTIONAL { $this effortless-ntwf:isQuestionProof ?is_question_proof . }
    OPTIONAL { $this effortless-ntwf:isScenarioProof ?is_scenario_proof . }
    OPTIONAL { $this effortless-ntwf:isStandardProof ?is_standard_proof . }
    OPTIONAL { $this effortless-ntwf:isStructuralProof ?is_structural_proof . }
    OPTIONAL { $this effortless-ntwf:isWitnessProof ?is_witness_proof . }
                BIND((COALESCE(?has_justification, false) && COALESCE((COALESCE((COALESCE((COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "Prescription"), false) || COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "Illustration"), false)), false) && COALESCE(?is_witness_proof, false)), false) || COALESCE((COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "Concept"), false) && COALESCE(?is_structural_proof, false)), false) || COALESCE((COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "CompetencyQuestion"), false) && COALESCE(?is_question_proof, false)), false) || COALESCE((COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "Standard"), false) && COALESCE(?is_standard_proof, false)), false) || COALESCE((COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "Scenario"), false) && COALESCE(?is_scenario_proof, false)), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_IsContested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isContested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
    OPTIONAL { $this effortless-ntwf:evidenceKind ?evidence_kind . OPTIONAL { ?evidence_kind effortless-ntwf:__key ?evidence_kind__key . } }
    OPTIONAL { $this effortless-ntwf:fieldIsContested ?field_is_contested . }
                BIND((COALESCE((COALESCE(?evidence_kind__key, COALESCE(IF(isIRI(?evidence_kind), REPLACE(STR(?evidence_kind), "^.*[#/]", ""), STR(?evidence_kind)), "")) = "Field"), false) && COALESCE(?field_is_contested, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClaimEvidence_IsAgreedEvidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAgreedEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClaimEvidence .
    OPTIONAL { $this effortless-ntwf:isContested ?is_contested . }
    OPTIONAL { $this effortless-ntwf:isValid ?is_valid . }
                BIND((COALESCE(?is_valid, false) && COALESCE((COALESCE(?is_contested, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ClassificationFacets ===
effortless-ntwf:ClassificationFacetsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ClassificationFacets ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClassificationFacets_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClassificationFacets .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClassificationFacets_AssignmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClassificationFacets .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureFacetAssignments .
                    ?child effortless-ntwf:facet $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for CollectedSourceMaterials ===
effortless-ntwf:CollectedSourceMaterialsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CollectedSourceMaterials ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectedSourceMaterials .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_IsModeledBeforeOrganized" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isModeledBeforeOrganized ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectedSourceMaterials .
    OPTIONAL { $this effortless-ntwf:encodedAt ?encoded_at . }
    OPTIONAL { $this effortless-ntwf:encodedIntoVersion ?encoded_into_version . OPTIONAL { ?encoded_into_version effortless-ntwf:__key ?encoded_into_version__key . } }
    OPTIONAL { $this effortless-ntwf:organizedAt ?organized_at . OPTIONAL { ?organized_at effortless-ntwf:__key ?organized_at__key . } }
                BIND((COALESCE((COALESCE(?encoded_into_version__key, COALESCE(IF(isIRI(?encoded_into_version), REPLACE(STR(?encoded_into_version), "^.*[#/]", ""), STR(?encoded_into_version)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?organized_at__key, COALESCE(IF(isIRI(?organized_at), REPLACE(STR(?organized_at), "^.*[#/]", ""), STR(?organized_at)), "")) = ""), false) || COALESCE(COALESCE((?encoded_at < ?organized_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_SourceDocumentRevisedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sourceDocumentRevisedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectedSourceMaterials .
                OPTIONAL { $this effortless-ntwf:sourceDocument ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Resources ; effortless-ntwf:resourceId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:modifiedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_IsDocumentSource" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDocumentSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectedSourceMaterials .
    OPTIONAL { $this effortless-ntwf:materialKind ?material_kind . OPTIONAL { ?material_kind effortless-ntwf:__key ?material_kind__key . } }
                BIND((COALESCE(?material_kind__key, COALESCE(IF(isIRI(?material_kind), REPLACE(STR(?material_kind), "^.*[#/]", ""), STR(?material_kind)), "")) = "DocumentExcerpt") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_IsPeopleCapture" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPeopleCapture ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectedSourceMaterials .
    OPTIONAL { $this effortless-ntwf:materialKind ?material_kind . OPTIONAL { ?material_kind effortless-ntwf:__key ?material_kind__key . } }
                BIND((COALESCE((COALESCE(?material_kind__key, COALESCE(IF(isIRI(?material_kind), REPLACE(STR(?material_kind), "^.*[#/]", ""), STR(?material_kind)), "")) = "Transcript"), false) || COALESCE((COALESCE(?material_kind__key, COALESCE(IF(isIRI(?material_kind), REPLACE(STR(?material_kind), "^.*[#/]", ""), STR(?material_kind)), "")) = "FieldNotes"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_IsPracticeEvidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isPracticeEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectedSourceMaterials .
    OPTIONAL { $this effortless-ntwf:materialKind ?material_kind . OPTIONAL { ?material_kind effortless-ntwf:__key ?material_kind__key . } }
                BIND((COALESCE((COALESCE(?material_kind__key, COALESCE(IF(isIRI(?material_kind), REPLACE(STR(?material_kind), "^.*[#/]", ""), STR(?material_kind)), "")) = "FieldNotes"), false) || COALESCE((COALESCE(?material_kind__key, COALESCE(IF(isIRI(?material_kind), REPLACE(STR(?material_kind), "^.*[#/]", ""), STR(?material_kind)), "")) = "MinedEventTrace"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_IsCapturedInFlowOfWork" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCapturedInFlowOfWork ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectedSourceMaterials .
    OPTIONAL { $this effortless-ntwf:capturedDuringExecution ?captured_during_execution . OPTIONAL { ?captured_during_execution effortless-ntwf:__key ?captured_during_execution__key . } }
                BIND((COALESCE(?captured_during_execution__key, COALESCE(IF(isIRI(?captured_during_execution), REPLACE(STR(?captured_during_execution), "^.*[#/]", ""), STR(?captured_during_execution)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_DependentTraceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:dependentTraceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectedSourceMaterials .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeTraces .
                    ?child effortless-ntwf:sourceMaterial $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_IsDependencyInvisibleToChange" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDependencyInvisibleToChange ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectedSourceMaterials .
    OPTIONAL { $this effortless-ntwf:dependentTraceCount ?dependent_trace_count . }
    OPTIONAL { $this effortless-ntwf:encodedIntoVersion ?encoded_into_version . OPTIONAL { ?encoded_into_version effortless-ntwf:__key ?encoded_into_version__key . } }
                BIND((COALESCE((COALESCE(?encoded_into_version__key, COALESCE(IF(isIRI(?encoded_into_version), REPLACE(STR(?encoded_into_version), "^.*[#/]", ""), STR(?encoded_into_version)), "")) != ""), false) && COALESCE((COALESCE(?dependent_trace_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_ChangedDependentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:changedDependentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectedSourceMaterials .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeTraces .
                    ?child effortless-ntwf:sourceMaterial $this .
                    OPTIONAL { ?child effortless-ntwf:isSourceChangedSinceTaken ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectedSourceMaterials_HasKnowledgeAffectedBySourceChange" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasKnowledgeAffectedBySourceChange ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectedSourceMaterials .
    OPTIONAL { $this effortless-ntwf:changedDependentCount ?changed_dependent_count . }
                BIND((COALESCE(?changed_dependent_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CollectionOccasions ===
effortless-ntwf:CollectionOccasionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CollectionOccasions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectionOccasions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectionOccasions .
    OPTIONAL { $this effortless-ntwf:label ?label . OPTIONAL { ?label effortless-ntwf:__key ?label__key . } }
    OPTIONAL { $this effortless-ntwf:occasionKind ?occasion_kind . OPTIONAL { ?occasion_kind effortless-ntwf:__key ?occasion_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?occasion_kind__key, IF(isIRI(?occasion_kind), REPLACE(STR(?occasion_kind), "^.*[#/]", ""), STR(?occasion_kind))), ""), ": ", COALESCE(COALESCE(?label__key, IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectionOccasions_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectionOccasions .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectionOccasions_DaysSinceHeld" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceHeld ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectionOccasions .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:lastHeldAt ?last_held_at . OPTIONAL { ?last_held_at effortless-ntwf:__key ?last_held_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?last_held_at__key, COALESCE(IF(isIRI(?last_held_at), REPLACE(STR(?last_held_at), "^.*[#/]", ""), STR(?last_held_at)), "")) = ""), false), 0, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_held_at) + FLOOR((153 * (MONTH(?last_held_at) + 12 * FLOOR((14 - MONTH(?last_held_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_held_at) + 4800 - FLOOR((14 - MONTH(?last_held_at)) / 12)) + FLOOR((YEAR(?last_held_at) + 4800 - FLOOR((14 - MONTH(?last_held_at)) / 12)) / 4) - FLOOR((YEAR(?last_held_at) + 4800 - FLOOR((14 - MONTH(?last_held_at)) / 12)) / 100) + FLOOR((YEAR(?last_held_at) + 4800 - FLOOR((14 - MONTH(?last_held_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectionOccasions_IsLapsed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLapsed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectionOccasions .
    OPTIONAL { $this effortless-ntwf:cadenceDays ?cadence_days . }
    OPTIONAL { $this effortless-ntwf:daysSinceHeld ?days_since_held . }
                BIND((COALESCE(?days_since_held, 0) > COALESCE(?cadence_days, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectionOccasions_CapturedMaterialCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:capturedMaterialCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectionOccasions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CollectedSourceMaterials .
                    ?child effortless-ntwf:collectedAtOccasion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CollectionOccasions_IsHeldWithoutCapture" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isHeldWithoutCapture ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CollectionOccasions .
    OPTIONAL { $this effortless-ntwf:capturedMaterialCount ?captured_material_count . }
    OPTIONAL { $this effortless-ntwf:lastHeldAt ?last_held_at . OPTIONAL { ?last_held_at effortless-ntwf:__key ?last_held_at__key . } }
                BIND((COALESCE((COALESCE(?last_held_at__key, COALESCE(IF(isIRI(?last_held_at), REPLACE(STR(?last_held_at), "^.*[#/]", ""), STR(?last_held_at)), "")) != ""), false) && COALESCE((COALESCE(?captured_material_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CommunicationPolicies ===
effortless-ntwf:CommunicationPoliciesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CommunicationPolicies ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunicationPolicies .
    OPTIONAL { $this effortless-ntwf:channel ?channel . OPTIONAL { ?channel effortless-ntwf:__key ?channel__key . } }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . OPTIONAL { ?procedure_version effortless-ntwf:__key ?procedure_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?channel__key, IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel))), ""), " policy / ", COALESCE(COALESCE(?procedure_version__key, IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), STR(?procedure_version))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_ConsentViolationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:consentViolationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunicationPolicies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MessageDeliveries .
                    ?child effortless-ntwf:policyChannel ?backfk .
                    $this effortless-ntwf:communicationPolicyId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:isConsentViolation ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_QuietHoursViolationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:quietHoursViolationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunicationPolicies .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MessageDeliveries .
                    ?child effortless-ntwf:quietHoursViolationPolicyKey ?backfk .
                    $this effortless-ntwf:communicationPolicyId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_IsActivePolicy" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isActivePolicy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunicationPolicies .
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Active") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CommunitiesOfPractice ===
effortless-ntwf:CommunitiesOfPracticeShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CommunitiesOfPractice ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_HasOwnVocabularyAndNorms" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasOwnVocabularyAndNorms ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
    OPTIONAL { $this effortless-ntwf:norms ?norms . OPTIONAL { ?norms effortless-ntwf:__key ?norms__key . } }
    OPTIONAL { $this effortless-ntwf:ownVocabulary ?own_vocabulary . OPTIONAL { ?own_vocabulary effortless-ntwf:__key ?own_vocabulary__key . } }
                BIND((COALESCE((COALESCE(?own_vocabulary__key, COALESCE(IF(isIRI(?own_vocabulary), REPLACE(STR(?own_vocabulary), "^.*[#/]", ""), STR(?own_vocabulary)), "")) != ""), false) && COALESCE((COALESCE(?norms__key, COALESCE(IF(isIRI(?norms), REPLACE(STR(?norms), "^.*[#/]", ""), STR(?norms)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_SharingEventCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sharingEventCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeTransfers .
                    ?child effortless-ntwf:communityOfPractice $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_IsMandatedWithoutSharingNorm" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMandatedWithoutSharingNorm ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
    OPTIONAL { $this effortless-ntwf:origin ?origin . OPTIONAL { ?origin effortless-ntwf:__key ?origin__key . } }
    OPTIONAL { $this effortless-ntwf:sharingEventCount ?sharing_event_count . }
                BIND((COALESCE((COALESCE(?origin__key, COALESCE(IF(isIRI(?origin), REPLACE(STR(?origin), "^.*[#/]", ""), STR(?origin)), "")) != ""), false) && COALESCE((COALESCE(?origin__key, COALESCE(IF(isIRI(?origin), REPLACE(STR(?origin), "^.*[#/]", ""), STR(?origin)), "")) != "Grassroots"), false) && COALESCE((COALESCE(?sharing_event_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_InterconnectedKnowHowCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:interconnectedKnowHowCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowHowCarriers .
                    ?child effortless-ntwf:communityOfPractice $this .
                    OPTIONAL { ?child effortless-ntwf:buildsOnSameCommunityKnowHow ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_PhysicalKnowHowCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:physicalKnowHowCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowHowCarriers .
                    ?child effortless-ntwf:communityOfPractice $this .
                    OPTIONAL { ?child effortless-ntwf:workMedium ?c2 . }
                    FILTER((STR(?c2) = "Physical"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_DigitalKnowHowCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:digitalKnowHowCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowHowCarriers .
                    ?child effortless-ntwf:communityOfPractice $this .
                    OPTIONAL { ?child effortless-ntwf:workMedium ?c2 . }
                    FILTER((STR(?c2) = "Digital"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_PersonCarriedKnowHowCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:personCarriedKnowHowCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowHowCarriers .
                    ?child effortless-ntwf:communityOfPractice $this .
                    OPTIONAL { ?child effortless-ntwf:carrierKind ?c2 . }
                    FILTER((STR(?c2) = "Person"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_SpansPhysicalAndDigitalWithHumans" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:spansPhysicalAndDigitalWithHumans ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
    OPTIONAL { $this effortless-ntwf:digitalKnowHowCount ?digital_know_how_count . }
    OPTIONAL { $this effortless-ntwf:personCarriedKnowHowCount ?person_carried_know_how_count . }
    OPTIONAL { $this effortless-ntwf:physicalKnowHowCount ?physical_know_how_count . }
                BIND((COALESCE((COALESCE(?physical_know_how_count, 0) > 0), false) && COALESCE((COALESCE(?digital_know_how_count, 0) > 0), false) && COALESCE((COALESCE(?person_carried_know_how_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_ExternalMemberCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:externalMemberCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CommunityMemberships .
                    ?child effortless-ntwf:communityOfPractice $this .
                    OPTIONAL { ?child effortless-ntwf:isExternalMember ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_SpecialistMemberCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:specialistMemberCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CommunityMemberships .
                    ?child effortless-ntwf:communityOfPractice $this .
                    OPTIONAL { ?child effortless-ntwf:isSpecialist ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_EmployerMoveCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:employerMoveCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeTransfers .
                    ?child effortless-ntwf:communityOfPractice $this .
                    OPTIONAL { ?child effortless-ntwf:channel ?c2 . }
                    FILTER((STR(?c2) = "EmployerChange"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_IsCrossFirmPracticeCluster" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCrossFirmPracticeCluster ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
    OPTIONAL { $this effortless-ntwf:employerMoveCount ?employer_move_count . }
    OPTIONAL { $this effortless-ntwf:externalMemberCount ?external_member_count . }
    OPTIONAL { $this effortless-ntwf:specialistMemberCount ?specialist_member_count . }
                BIND((COALESCE((COALESCE(?external_member_count, 0) >= 2), false) && COALESCE((COALESCE(?employer_move_count, 0) >= 1), false) && COALESCE((COALESCE(?specialist_member_count, 0) >= 1), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_RecentApprenticeshipCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recentApprenticeshipCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Mentorships .
                    ?child effortless-ntwf:communityOfPractice $this .
                    OPTIONAL { ?child effortless-ntwf:isRecentApprenticeship ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_IsCirculationEndingForLackOfApprentices" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCirculationEndingForLackOfApprentices ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
    OPTIONAL { $this effortless-ntwf:employerMoveCount ?employer_move_count . }
    OPTIONAL { $this effortless-ntwf:openApprenticeshipPlaces ?open_apprenticeship_places . }
    OPTIONAL { $this effortless-ntwf:recentApprenticeshipCount ?recent_apprenticeship_count . }
                BIND((COALESCE((COALESCE(?employer_move_count, 0) >= 1), false) && COALESCE((COALESCE(?open_apprenticeship_places, 0) > 0), false) && COALESCE((COALESCE(?recent_apprenticeship_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_AmbientAbsorptionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ambientAbsorptionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeTransfers .
                    ?child effortless-ntwf:communityOfPractice $this .
                    OPTIONAL { ?child effortless-ntwf:isAmbientAbsorptionByNonPractitioner ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_HasAmbientTradeKnowHow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasAmbientTradeKnowHow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
    OPTIONAL { $this effortless-ntwf:ambientAbsorptionCount ?ambient_absorption_count . }
    OPTIONAL { $this effortless-ntwf:isColocatedTrade ?is_colocated_trade . }
                BIND((COALESCE(?is_colocated_trade, false) && COALESCE((COALESCE(?ambient_absorption_count, 0) >= 1), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CommunityMemberships ===
effortless-ntwf:CommunityMembershipsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CommunityMemberships ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunityMemberships_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunityMemberships .
    OPTIONAL { $this effortless-ntwf:agent ?agent . OPTIONAL { ?agent effortless-ntwf:__key ?agent__key . } }
    OPTIONAL { $this effortless-ntwf:communityOfPractice ?community_of_practice . OPTIONAL { ?community_of_practice effortless-ntwf:__key ?community_of_practice__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?agent__key, IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent))), ""), " in ", COALESCE(COALESCE(?community_of_practice__key, IF(isIRI(?community_of_practice), REPLACE(STR(?community_of_practice), "^.*[#/]", ""), STR(?community_of_practice))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunityMemberships_MemberOrganization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:memberOrganization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunityMemberships .
                OPTIONAL { $this effortless-ntwf:agent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunityMemberships_CommunityOrganization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:communityOrganization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunityMemberships .
                OPTIONAL { $this effortless-ntwf:communityOfPractice ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunitiesOfPractice ; effortless-ntwf:communityOfPracticeId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunityMemberships_IsExternalMember" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isExternalMember ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunityMemberships .
    OPTIONAL { $this effortless-ntwf:communityOrganization ?community_organization . }
    OPTIONAL { $this effortless-ntwf:memberOrganization ?member_organization . OPTIONAL { ?member_organization effortless-ntwf:__key ?member_organization__key . } }
                BIND((COALESCE((COALESCE(?member_organization__key, COALESCE(IF(isIRI(?member_organization), REPLACE(STR(?member_organization), "^.*[#/]", ""), STR(?member_organization)), "")) != ""), false) && COALESCE(COALESCE((?member_organization != ?community_organization), !((!BOUND(?member_organization) || STR(?member_organization) = "") && (!BOUND(?community_organization) || STR(?community_organization) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CompetencyQuestionReviews ===
effortless-ntwf:CompetencyQuestionReviewsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CompetencyQuestionReviews ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionReviews_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionReviews .
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " question review") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CompetencyQuestionRuns ===
effortless-ntwf:CompetencyQuestionRunsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CompetencyQuestionRuns ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionRuns_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionRuns .
    OPTIONAL { $this effortless-ntwf:cqSetEntry ?cq_set_entry . OPTIONAL { ?cq_set_entry effortless-ntwf:__key ?cq_set_entry__key . } }
    OPTIONAL { $this effortless-ntwf:rulebookRelease ?rulebook_release . OPTIONAL { ?rulebook_release effortless-ntwf:__key ?rulebook_release__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?cq_set_entry__key, IF(isIRI(?cq_set_entry), REPLACE(STR(?cq_set_entry), "^.*[#/]", ""), STR(?cq_set_entry))), ""), " @ ", COALESCE(COALESCE(?rulebook_release__key, IF(isIRI(?rulebook_release), REPLACE(STR(?rulebook_release), "^.*[#/]", ""), STR(?rulebook_release))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionRuns_EntryIsOriginal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:entryIsOriginal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionRuns .
                OPTIONAL { $this effortless-ntwf:cqSetEntry ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CompetencyQuestionSetEntries ; effortless-ntwf:competencyQuestionSetEntryId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isOriginalBaseline ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionRuns_PriorWasAnswerable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:priorWasAnswerable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionRuns .
                OPTIONAL { $this effortless-ntwf:priorRun ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CompetencyQuestionRuns ; effortless-ntwf:competencyQuestionRunId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:wasAnswerable ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionRuns_IsBaselineRegression" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBaselineRegression ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionRuns .
    OPTIONAL { $this effortless-ntwf:entryIsOriginal ?entry_is_original . }
    OPTIONAL { $this effortless-ntwf:priorRun ?prior_run . OPTIONAL { ?prior_run effortless-ntwf:__key ?prior_run__key . } }
    OPTIONAL { $this effortless-ntwf:priorWasAnswerable ?prior_was_answerable . }
    OPTIONAL { $this effortless-ntwf:wasAnswerable ?was_answerable . }
                BIND((COALESCE(?entry_is_original, false) && COALESCE((COALESCE(?prior_run__key, COALESCE(IF(isIRI(?prior_run), REPLACE(STR(?prior_run), "^.*[#/]", ""), STR(?prior_run)), "")) != ""), false) && COALESCE(?prior_was_answerable, false) && COALESCE((COALESCE(?was_answerable, false) = false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionRuns_IsUnfixedWrongAnswer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnfixedWrongAnswer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionRuns .
    OPTIONAL { $this effortless-ntwf:answerOutcome ?answer_outcome . OPTIONAL { ?answer_outcome effortless-ntwf:__key ?answer_outcome__key . } }
    OPTIONAL { $this effortless-ntwf:defectChangeRequest ?defect_change_request . OPTIONAL { ?defect_change_request effortless-ntwf:__key ?defect_change_request__key . } }
                BIND((COALESCE((COALESCE(?answer_outcome__key, COALESCE(IF(isIRI(?answer_outcome), REPLACE(STR(?answer_outcome), "^.*[#/]", ""), STR(?answer_outcome)), "")) = "Wrong"), false) && COALESCE((COALESCE(?defect_change_request__key, COALESCE(IF(isIRI(?defect_change_request), REPLACE(STR(?defect_change_request), "^.*[#/]", ""), STR(?defect_change_request)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CompetencyQuestionSetEntries ===
effortless-ntwf:CompetencyQuestionSetEntriesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CompetencyQuestionSetEntries ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionSetEntries_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionSetEntries .
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
    OPTIONAL { $this effortless-ntwf:roleQuestion ?role_question . OPTIONAL { ?role_question effortless-ntwf:__key ?role_question__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " / ", COALESCE(COALESCE(?role_question__key, IF(isIRI(?role_question), REPLACE(STR(?role_question), "^.*[#/]", ""), STR(?role_question))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionSetEntries_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionSetEntries .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionSetEntries_DaysSinceAdded" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceAdded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionSetEntries .
    OPTIONAL { $this effortless-ntwf:addedAt ?added_at . }
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?added_at) + FLOOR((153 * (MONTH(?added_at) + 12 * FLOOR((14 - MONTH(?added_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?added_at) + 4800 - FLOOR((14 - MONTH(?added_at)) / 12)) + FLOOR((YEAR(?added_at) + 4800 - FLOOR((14 - MONTH(?added_at)) / 12)) / 4) - FLOOR((YEAR(?added_at) + 4800 - FLOOR((14 - MONTH(?added_at)) / 12)) / 100) + FLOOR((YEAR(?added_at) + 4800 - FLOOR((14 - MONTH(?added_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionSetEntries_IsOutgrownBaselineQuestion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOutgrownBaselineQuestion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionSetEntries .
    OPTIONAL { $this effortless-ntwf:daysSinceAdded ?days_since_added . }
    OPTIONAL { $this effortless-ntwf:isOriginalBaseline ?is_original_baseline . }
    OPTIONAL { $this effortless-ntwf:relevanceVerdict ?relevance_verdict . OPTIONAL { ?relevance_verdict effortless-ntwf:__key ?relevance_verdict__key . } }
                BIND((COALESCE(?is_original_baseline, false) && COALESCE((COALESCE(?days_since_added, 0) > 365), false) && COALESCE((COALESCE(?relevance_verdict__key, COALESCE(IF(isIRI(?relevance_verdict), REPLACE(STR(?relevance_verdict), "^.*[#/]", ""), STR(?relevance_verdict)), "")) = "NoLongerRelevant"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionSetEntries_IrrelevantButStillActive" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:irrelevantButStillActive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionSetEntries .
    OPTIONAL { $this effortless-ntwf:relevanceVerdict ?relevance_verdict . OPTIONAL { ?relevance_verdict effortless-ntwf:__key ?relevance_verdict__key . } }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?relevance_verdict__key, COALESCE(IF(isIRI(?relevance_verdict), REPLACE(STR(?relevance_verdict), "^.*[#/]", ""), STR(?relevance_verdict)), "")) = "NoLongerRelevant"), false) && COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Active"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionSetEntries_GovernanceUseCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:governanceUseCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionSetEntries .
    OPTIONAL { $this effortless-ntwf:usedAsAcceptanceCriterion ?used_as_acceptance_criterion . }
    OPTIONAL { $this effortless-ntwf:usedAsTestDriver ?used_as_test_driver . }
    OPTIONAL { $this effortless-ntwf:usedForGovernance ?used_for_governance . }
    OPTIONAL { $this effortless-ntwf:usedForScoping ?used_for_scoping . }
                BIND(ROUND((((IF(COALESCE(?used_for_scoping, false), 1, 0) + IF(COALESCE(?used_as_acceptance_criterion, false), 1, 0)) + IF(COALESCE(?used_as_test_driver, false), 1, 0)) + IF(COALESCE(?used_for_governance, false), 1, 0))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CompetencyQuestionSetEntries_ServesEveryGovernanceUse" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:servesEveryGovernanceUse ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CompetencyQuestionSetEntries .
    OPTIONAL { $this effortless-ntwf:governanceUseCount ?governance_use_count . }
                BIND((COALESCE(?governance_use_count, 0) = 4) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ConceptLadderRungs ===
effortless-ntwf:ConceptLadderRungsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConceptLadderRungs ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConceptLadderRungs_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConceptLadderRungs .
    OPTIONAL { $this effortless-ntwf:rungKind ?rung_kind . OPTIONAL { ?rung_kind effortless-ntwf:__key ?rung_kind__key . } }
    OPTIONAL { $this effortless-ntwf:statement ?statement . }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " ", COALESCE(COALESCE(?rung_kind__key, IF(isIRI(?rung_kind), REPLACE(STR(?rung_kind), "^.*[#/]", ""), STR(?rung_kind))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?statement), 1, 50)), REPLACE(STR(SUBSTR(STR(?statement), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?statement), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConceptLadderRungs_StepTopLevel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepTopLevel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConceptLadderRungs .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:ConceptLadderRungs .
                    ?child effortless-ntwf:step ?backfk .
                    $this effortless-ntwf:step ?backpv .
                    OPTIONAL { ?child effortless-ntwf:ladderLevel ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConceptLadderRungs_IsUltimateGoal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUltimateGoal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConceptLadderRungs .
    OPTIONAL { $this effortless-ntwf:ladderLevel ?ladder_level . }
    OPTIONAL { $this effortless-ntwf:stepTopLevel ?step_top_level . }
                BIND((COALESCE((COALESCE(?ladder_level, 0) > 0), false) && COALESCE((COALESCE(?ladder_level, 0) = COALESCE(?step_top_level, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConceptLadderRungs_IsDecompositionRung" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDecompositionRung ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConceptLadderRungs .
    OPTIONAL { $this effortless-ntwf:ladderLevel ?ladder_level . }
                BIND((COALESCE(?ladder_level, 0) < 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ConditionChecks ===
effortless-ntwf:ConditionChecksShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConditionChecks ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConditionChecks .
    OPTIONAL { $this effortless-ntwf:stepCondition ?step_condition . OPTIONAL { ?step_condition effortless-ntwf:__key ?step_condition__key . } }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . OPTIONAL { ?step_execution effortless-ntwf:__key ?step_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_execution__key, IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution))), ""), " / ", COALESCE(COALESCE(?step_condition__key, IF(isIRI(?step_condition), REPLACE(STR(?step_condition), "^.*[#/]", ""), STR(?step_condition))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_ConditionKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:conditionKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConditionChecks .
                OPTIONAL { $this effortless-ntwf:stepCondition ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepConditions ; effortless-ntwf:stepConditionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:conditionKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_IsFailedPrecondition" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFailedPrecondition ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConditionChecks .
    OPTIONAL { $this effortless-ntwf:conditionKind ?condition_kind . OPTIONAL { ?condition_kind effortless-ntwf:__key ?condition_kind__key . } }
    OPTIONAL { $this effortless-ntwf:held ?held . }
                BIND((COALESCE((COALESCE(?condition_kind__key, COALESCE(IF(isIRI(?condition_kind), REPLACE(STR(?condition_kind), "^.*[#/]", ""), STR(?condition_kind)), "")) = "Precondition"), false) && COALESCE((COALESCE(?held, false) = false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_IsViolatedInvariant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isViolatedInvariant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConditionChecks .
    OPTIONAL { $this effortless-ntwf:conditionKind ?condition_kind . OPTIONAL { ?condition_kind effortless-ntwf:__key ?condition_kind__key . } }
    OPTIONAL { $this effortless-ntwf:held ?held . }
                BIND((COALESCE((COALESCE(?condition_kind__key, COALESCE(IF(isIRI(?condition_kind), REPLACE(STR(?condition_kind), "^.*[#/]", ""), STR(?condition_kind)), "")) = "Invariant"), false) && COALESCE((COALESCE(?held, false) = false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_FailedPreconditionExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:failedPreconditionExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConditionChecks .
    OPTIONAL { $this effortless-ntwf:isFailedPrecondition ?is_failed_precondition . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_failed_precondition, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConditionChecks_ViolatedInvariantExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:violatedInvariantExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConditionChecks .
    OPTIONAL { $this effortless-ntwf:isViolatedInvariant ?is_violated_invariant . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_violated_invariant, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ConformanceRuns ===
effortless-ntwf:ConformanceRunsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConformanceRuns ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
    OPTIONAL { $this effortless-ntwf:conformanceRunId ?conformance_run_id . }
                BIND(?conformance_run_id AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_SubstrateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:substrateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:run $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_PerfectSubstrateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:perfectSubstrateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:perfectRunKey ?backfk .
                    $this effortless-ntwf:conformanceRunId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_CellsTested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cellsTested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:run $this .
                    OPTIONAL { ?child effortless-ntwf:cellsTested ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_CellsPassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cellsPassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:run $this .
                    OPTIONAL { ?child effortless-ntwf:cellsPassed ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_CellsFailed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cellsFailed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
    OPTIONAL { $this effortless-ntwf:cellsPassed ?cells_passed . }
    OPTIONAL { $this effortless-ntwf:cellsTested ?cells_tested . }
                BIND((?cells_tested - ?cells_passed) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_OverallScore" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:overallScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
    OPTIONAL { $this effortless-ntwf:cellsPassed ?cells_passed . }
    OPTIONAL { $this effortless-ntwf:cellsTested ?cells_tested . }
                BIND(IF(COALESCE((COALESCE(?cells_tested, 0) = 0), false), 0, (ROUND(((100 * ?cells_passed) / ?cells_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_ImperfectSubstrateCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:imperfectSubstrateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
    OPTIONAL { $this effortless-ntwf:perfectSubstrateCount ?perfect_substrate_count . }
    OPTIONAL { $this effortless-ntwf:substrateCount ?substrate_count . }
                BIND((?substrate_count - ?perfect_substrate_count) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceRuns_IsFullyConformant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFullyConformant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceRuns .
    OPTIONAL { $this effortless-ntwf:imperfectSubstrateCount ?imperfect_substrate_count . }
    OPTIONAL { $this effortless-ntwf:substrateCount ?substrate_count . }
                BIND((COALESCE((COALESCE(?substrate_count, 0) > 0), false) && COALESCE((COALESCE(?imperfect_substrate_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ConformanceSubstrates ===
effortless-ntwf:ConformanceSubstratesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConformanceSubstrates ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_IsGraded" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isGraded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
    OPTIONAL { $this effortless-ntwf:role ?role . OPTIONAL { ?role effortless-ntwf:__key ?role__key . } }
                BIND((COALESCE(?role__key, COALESCE(IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role)), "")) = "graded") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_RunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:runCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:substrate $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_LatestCellsTested" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestCellsTested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:substrate $this .
                    OPTIONAL { ?child effortless-ntwf:latestCellsTested ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_LatestCellsPassed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestCellsPassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:substrate $this .
                    OPTIONAL { ?child effortless-ntwf:latestCellsPassed ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_LatestHarnessErrors" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestHarnessErrors ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:SubstrateRunScores .
                    ?child effortless-ntwf:substrate $this .
                    OPTIONAL { ?child effortless-ntwf:latestErrorFlag ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_LatestCellsFailed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestCellsFailed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
    OPTIONAL { $this effortless-ntwf:latestCellsPassed ?latest_cells_passed . }
    OPTIONAL { $this effortless-ntwf:latestCellsTested ?latest_cells_tested . }
                BIND((?latest_cells_tested - ?latest_cells_passed) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_LatestScore" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
    OPTIONAL { $this effortless-ntwf:latestCellsPassed ?latest_cells_passed . }
    OPTIONAL { $this effortless-ntwf:latestCellsTested ?latest_cells_tested . }
                BIND(IF(COALESCE((COALESCE(?latest_cells_tested, 0) = 0), false), 0, (ROUND(((100 * ?latest_cells_passed) / ?latest_cells_tested) * STRDT(CONCAT("1e", STR(2)), xsd:double)) / STRDT(CONCAT("1e", STR(2)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_DisagreeingFieldCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:disagreeingFieldCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FieldDisagreements .
                    ?child effortless-ntwf:substrate $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_DisagreeingTableCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:disagreeingTableCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TableConformance .
                    ?child effortless-ntwf:imperfectSubstrateKey ?backfk .
                    $this effortless-ntwf:conformanceSubstrateId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConformanceSubstrates_IsFullyConformant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFullyConformant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConformanceSubstrates .
    OPTIONAL { $this effortless-ntwf:latestCellsFailed ?latest_cells_failed . }
    OPTIONAL { $this effortless-ntwf:latestCellsTested ?latest_cells_tested . }
    OPTIONAL { $this effortless-ntwf:latestHarnessErrors ?latest_harness_errors . }
                BIND((COALESCE((COALESCE(?latest_cells_tested, 0) > 0), false) && COALESCE((COALESCE(?latest_cells_failed, 0) = 0), false) && COALESCE((COALESCE(?latest_harness_errors, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ConsumerRevalidations ===
effortless-ntwf:ConsumerRevalidationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConsumerRevalidations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerRevalidations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerRevalidations .
    OPTIONAL { $this effortless-ntwf:modelConsumer ?model_consumer . OPTIONAL { ?model_consumer effortless-ntwf:__key ?model_consumer__key . } }
    OPTIONAL { $this effortless-ntwf:rulebookRelease ?rulebook_release . OPTIONAL { ?rulebook_release effortless-ntwf:__key ?rulebook_release__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?rulebook_release__key, IF(isIRI(?rulebook_release), REPLACE(STR(?rulebook_release), "^.*[#/]", ""), STR(?rulebook_release))), ""), " / ", COALESCE(COALESCE(?model_consumer__key, IF(isIRI(?model_consumer), REPLACE(STR(?model_consumer), "^.*[#/]", ""), STR(?model_consumer))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ConsumerSystemSyncs ===
effortless-ntwf:ConsumerSystemSyncsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConsumerSystemSyncs ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerSystemSyncs .
    OPTIONAL { $this effortless-ntwf:consumerSystem ?consumer_system . OPTIONAL { ?consumer_system effortless-ntwf:__key ?consumer_system__key . } }
    OPTIONAL { $this effortless-ntwf:loadedVersion ?loaded_version . OPTIONAL { ?loaded_version effortless-ntwf:__key ?loaded_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?consumer_system__key, IF(isIRI(?consumer_system), REPLACE(STR(?consumer_system), "^.*[#/]", ""), STR(?consumer_system))), ""), " holds ", COALESCE(COALESCE(?loaded_version__key, IF(isIRI(?loaded_version), REPLACE(STR(?loaded_version), "^.*[#/]", ""), STR(?loaded_version))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_SystemAudience" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:systemAudience ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerSystemSyncs .
                OPTIONAL { $this effortless-ntwf:consumerSystem ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeConsumerSystems ; effortless-ntwf:knowledgeConsumerSystemId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:audience ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_LoadedProcedure" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:loadedProcedure ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerSystemSyncs .
                OPTIONAL { $this effortless-ntwf:loadedVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:procedure ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_CanonicalVersion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:canonicalVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerSystemSyncs .
                OPTIONAL { $this effortless-ntwf:loadedProcedure ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Procedures ; effortless-ntwf:procedureId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:currentVersionKey ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_CanonicalVersionModifiedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:canonicalVersionModifiedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerSystemSyncs .
                OPTIONAL { $this effortless-ntwf:canonicalVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:modifiedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_LoadedVersionCreator" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:loadedVersionCreator ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerSystemSyncs .
                OPTIONAL { $this effortless-ntwf:loadedVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:createdByAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_IsBehindCanonicalVersion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isBehindCanonicalVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerSystemSyncs .
    OPTIONAL { $this effortless-ntwf:canonicalVersion ?canonical_version . OPTIONAL { ?canonical_version effortless-ntwf:__key ?canonical_version__key . } }
    OPTIONAL { $this effortless-ntwf:loadedVersion ?loaded_version . }
                BIND((COALESCE((COALESCE(?canonical_version__key, COALESCE(IF(isIRI(?canonical_version), REPLACE(STR(?canonical_version), "^.*[#/]", ""), STR(?canonical_version)), "")) != ""), false) && COALESCE(COALESCE((?loaded_version != ?canonical_version), !((!BOUND(?loaded_version) || STR(?loaded_version) = "") && (!BOUND(?canonical_version) || STR(?canonical_version) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_PredatesVersionChange" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:predatesVersionChange ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerSystemSyncs .
    OPTIONAL { $this effortless-ntwf:canonicalVersion ?canonical_version . }
    OPTIONAL { $this effortless-ntwf:canonicalVersionModifiedAt ?canonical_version_modified_at . }
    OPTIONAL { $this effortless-ntwf:loadedVersion ?loaded_version . }
    OPTIONAL { $this effortless-ntwf:syncedAt ?synced_at . }
                BIND((COALESCE(COALESCE((?loaded_version = ?canonical_version), ((!BOUND(?loaded_version) || STR(?loaded_version) = "") && (!BOUND(?canonical_version) || STR(?canonical_version) = ""))), false) && COALESCE(COALESCE((?synced_at < ?canonical_version_modified_at), false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_IsAiFedFromForkedCopy" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAiFedFromForkedCopy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerSystemSyncs .
    OPTIONAL { $this effortless-ntwf:sourceResource ?source_resource . OPTIONAL { ?source_resource effortless-ntwf:__key ?source_resource__key . } }
    OPTIONAL { $this effortless-ntwf:systemAudience ?system_audience . OPTIONAL { ?system_audience effortless-ntwf:__key ?system_audience__key . } }
                BIND((COALESCE((COALESCE(?system_audience__key, COALESCE(IF(isIRI(?system_audience), REPLACE(STR(?system_audience), "^.*[#/]", ""), STR(?system_audience)), "")) != "Human"), false) && COALESCE((COALESCE(?source_resource__key, COALESCE(IF(isIRI(?source_resource), REPLACE(STR(?source_resource), "^.*[#/]", ""), STR(?source_resource)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_DropsProvenanceInTransit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:dropsProvenanceInTransit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerSystemSyncs .
    OPTIONAL { $this effortless-ntwf:carriesProvenance ?carries_provenance . }
    OPTIONAL { $this effortless-ntwf:loadedVersionCreator ?loaded_version_creator . OPTIONAL { ?loaded_version_creator effortless-ntwf:__key ?loaded_version_creator__key . } }
                BIND((COALESCE((COALESCE(?loaded_version_creator__key, COALESCE(IF(isIRI(?loaded_version_creator), REPLACE(STR(?loaded_version_creator), "^.*[#/]", ""), STR(?loaded_version_creator)), "")) != ""), false) && COALESCE((COALESCE(?carries_provenance, false) = false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_ReachesHumans" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reachesHumans ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerSystemSyncs .
    OPTIONAL { $this effortless-ntwf:systemAudience ?system_audience . OPTIONAL { ?system_audience effortless-ntwf:__key ?system_audience__key . } }
                BIND((COALESCE((COALESCE(?system_audience__key, COALESCE(IF(isIRI(?system_audience), REPLACE(STR(?system_audience), "^.*[#/]", ""), STR(?system_audience)), "")) = "Human"), false) || COALESCE((COALESCE(?system_audience__key, COALESCE(IF(isIRI(?system_audience), REPLACE(STR(?system_audience), "^.*[#/]", ""), STR(?system_audience)), "")) = "Both"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConsumerSystemSyncs_ReachesMachines" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reachesMachines ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConsumerSystemSyncs .
    OPTIONAL { $this effortless-ntwf:systemAudience ?system_audience . OPTIONAL { ?system_audience effortless-ntwf:__key ?system_audience__key . } }
                BIND((COALESCE((COALESCE(?system_audience__key, COALESCE(IF(isIRI(?system_audience), REPLACE(STR(?system_audience), "^.*[#/]", ""), STR(?system_audience)), "")) = "AI"), false) || COALESCE((COALESCE(?system_audience__key, COALESCE(IF(isIRI(?system_audience), REPLACE(STR(?system_audience), "^.*[#/]", ""), STR(?system_audience)), "")) = "Both"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CorporateGovernancePrograms ===
effortless-ntwf:CorporateGovernanceProgramsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorporateGovernancePrograms ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorporateGovernancePrograms_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorporateGovernancePrograms .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorporateGovernancePrograms_IsComplianceOnly" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isComplianceOnly ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorporateGovernancePrograms .
    OPTIONAL { $this effortless-ntwf:coversCompliance ?covers_compliance . }
    OPTIONAL { $this effortless-ntwf:coversDataQuality ?covers_data_quality . }
    OPTIONAL { $this effortless-ntwf:coversInformationManagement ?covers_information_management . }
    OPTIONAL { $this effortless-ntwf:coversKnowledgeManagement ?covers_knowledge_management . }
                BIND((COALESCE(?covers_compliance, false) && COALESCE((COALESCE(?covers_data_quality, false) = false), false) && COALESCE((COALESCE(?covers_information_management, false) = false), false) && COALESCE((COALESCE(?covers_knowledge_management, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CriticalIncidents ===
effortless-ntwf:CriticalIncidentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CriticalIncidents ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CriticalIncidents_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CriticalIncidents .
    OPTIONAL { $this effortless-ntwf:account ?account . }
    OPTIONAL { $this effortless-ntwf:outcome ?outcome . OPTIONAL { ?outcome effortless-ntwf:__key ?outcome__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?outcome__key, IF(isIRI(?outcome), REPLACE(STR(?outcome), "^.*[#/]", ""), STR(?outcome))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?account), 1, 60)), REPLACE(STR(SUBSTR(STR(?account), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?account), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CriticalIncidents_IsAdverseOrImprovised" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAdverseOrImprovised ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CriticalIncidents .
    OPTIONAL { $this effortless-ntwf:outcome ?outcome . OPTIONAL { ?outcome effortless-ntwf:__key ?outcome__key . } }
                BIND((COALESCE((COALESCE(?outcome__key, COALESCE(IF(isIRI(?outcome), REPLACE(STR(?outcome), "^.*[#/]", ""), STR(?outcome)), "")) = "WentBadly"), false) || COALESCE((COALESCE(?outcome__key, COALESCE(IF(isIRI(?outcome), REPLACE(STR(?outcome), "^.*[#/]", ""), STR(?outcome)), "")) = "Improvised"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CriticalIncidents_HasSurfacedJudgment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasSurfacedJudgment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CriticalIncidents .
    OPTIONAL { $this effortless-ntwf:revealedJudgment ?revealed_judgment . OPTIONAL { ?revealed_judgment effortless-ntwf:__key ?revealed_judgment__key . } }
                BIND((COALESCE(?revealed_judgment__key, COALESCE(IF(isIRI(?revealed_judgment), REPLACE(STR(?revealed_judgment), "^.*[#/]", ""), STR(?revealed_judgment)), "")) != "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CueObservations ===
effortless-ntwf:CueObservationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CueObservations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CueObservations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CueObservations .
    OPTIONAL { $this effortless-ntwf:stepCue ?step_cue . OPTIONAL { ?step_cue effortless-ntwf:__key ?step_cue__key . } }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . OPTIONAL { ?step_execution effortless-ntwf:__key ?step_execution__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step_execution__key, IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), STR(?step_execution))), ""), " / ", COALESCE(COALESCE(?step_cue__key, IF(isIRI(?step_cue), REPLACE(STR(?step_cue), "^.*[#/]", ""), STR(?step_cue))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CueObservations_CueRequiresEscalation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cueRequiresEscalation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CueObservations .
                OPTIONAL { $this effortless-ntwf:stepCue ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepCues ; effortless-ntwf:stepCueId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:requiresEscalation ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CueObservations_IsUnescalatedDangerCue" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnescalatedDangerCue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CueObservations .
    OPTIONAL { $this effortless-ntwf:cueRequiresEscalation ?cue_requires_escalation . }
    OPTIONAL { $this effortless-ntwf:wasEscalated ?was_escalated . }
                BIND((COALESCE(?cue_requires_escalation, false) && COALESCE((COALESCE(?was_escalated, false) = false), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CueObservations_UnescalatedCueKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unescalatedCueKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CueObservations .
    OPTIONAL { $this effortless-ntwf:isUnescalatedDangerCue ?is_unescalated_danger_cue . }
    OPTIONAL { $this effortless-ntwf:stepCue ?step_cue . }
                BIND(IF(COALESCE(?is_unescalated_danger_cue, false), ?step_cue, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CueObservations_UnescalatedExecutionKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:unescalatedExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CueObservations .
    OPTIONAL { $this effortless-ntwf:isUnescalatedDangerCue ?is_unescalated_danger_cue . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_unescalated_danger_cue, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for DecisionPoints ===
effortless-ntwf:DecisionPointsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DecisionPoints ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DecisionPoints_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DecisionPoints .
    OPTIONAL { $this effortless-ntwf:question ?question . }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?question), 1, 50)), REPLACE(STR(SUBSTR(STR(?question), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?question), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DecisionPoints_HasNoDecidingFactors" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoDecidingFactors ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DecisionPoints .
    OPTIONAL { $this effortless-ntwf:decidingFactors ?deciding_factors . OPTIONAL { ?deciding_factors effortless-ntwf:__key ?deciding_factors__key . } }
                BIND((COALESCE(?deciding_factors__key, COALESCE(IF(isIRI(?deciding_factors), REPLACE(STR(?deciding_factors), "^.*[#/]", ""), STR(?deciding_factors)), "")) = "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DecisionPoints_IsDmnEncoded" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDmnEncoded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DecisionPoints .
    OPTIONAL { $this effortless-ntwf:dmnDecisionKey ?dmn_decision_key . OPTIONAL { ?dmn_decision_key effortless-ntwf:__key ?dmn_decision_key__key . } }
                BIND((COALESCE(?dmn_decision_key__key, COALESCE(IF(isIRI(?dmn_decision_key), REPLACE(STR(?dmn_decision_key), "^.*[#/]", ""), STR(?dmn_decision_key)), "")) != "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for DeliveredCommunications ===
effortless-ntwf:DeliveredCommunicationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DeliveredCommunications ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:channel ?channel . OPTIONAL { ?channel effortless-ntwf:__key ?channel__key . } }
    OPTIONAL { $this effortless-ntwf:recipientKey ?recipient_key . OPTIONAL { ?recipient_key effortless-ntwf:__key ?recipient_key__key . } }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . OPTIONAL { ?sent_at effortless-ntwf:__key ?sent_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?channel__key, IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), STR(?channel))), ""), " -> ", COALESCE(COALESCE(?recipient_key__key, IF(isIRI(?recipient_key), REPLACE(STR(?recipient_key), "^.*[#/]", ""), STR(?recipient_key))), ""), " @ ", COALESCE(REPLACE(COALESCE(?sent_at__key, IF(isIRI(?sent_at), REPLACE(STR(?sent_at), "^.*[#/]", ""), STR(?sent_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_HasAuthorization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasAuthorization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:authorizingStepExecution ?authorizing_step_execution . OPTIONAL { ?authorizing_step_execution effortless-ntwf:__key ?authorizing_step_execution__key . } }
                BIND((COALESCE(?authorizing_step_execution__key, COALESCE(IF(isIRI(?authorizing_step_execution), REPLACE(STR(?authorizing_step_execution), "^.*[#/]", ""), STR(?authorizing_step_execution)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_ContentMatchesApproval" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:contentMatchesApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:approvedContentHash ?approved_content_hash . }
    OPTIONAL { $this effortless-ntwf:renderedContentHash ?rendered_content_hash . }
                BIND(COALESCE((?rendered_content_hash = ?approved_content_hash), ((!BOUND(?rendered_content_hash) || STR(?rendered_content_hash) = "") && (!BOUND(?approved_content_hash) || STR(?approved_content_hash) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_AuthorizedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:authorizedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
                OPTIONAL { $this effortless-ntwf:authorizingStepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:endedAt ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_WasApprovedBeforeSending" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:wasApprovedBeforeSending ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:authorizedAt ?authorized_at . }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND(COALESCE((?authorized_at <= ?sent_at), ((!BOUND(?authorized_at) || STR(?authorized_at) = "") && (!BOUND(?sent_at) || STR(?sent_at) = ""))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_IsDefensible" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDefensible ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:contentMatchesApproval ?content_matches_approval . }
    OPTIONAL { $this effortless-ntwf:hasAuthorization ?has_authorization . }
    OPTIONAL { $this effortless-ntwf:wasApprovedBeforeSending ?was_approved_before_sending . }
                BIND((COALESCE(?has_authorization, false) && COALESCE(?content_matches_approval, false) && COALESCE(?was_approved_before_sending, false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for DepartmentProcessAccounts ===
effortless-ntwf:DepartmentProcessAccountsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DepartmentProcessAccounts ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DepartmentProcessAccounts_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DepartmentProcessAccounts .
    OPTIONAL { $this effortless-ntwf:department ?department . OPTIONAL { ?department effortless-ntwf:__key ?department__key . } }
    OPTIONAL { $this effortless-ntwf:procedure ?procedure . OPTIONAL { ?procedure effortless-ntwf:__key ?procedure__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?department__key, IF(isIRI(?department), REPLACE(STR(?department), "^.*[#/]", ""), STR(?department))), ""), " on ", COALESCE(COALESCE(?procedure__key, IF(isIRI(?procedure), REPLACE(STR(?procedure), "^.*[#/]", ""), STR(?procedure))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DepartmentProcessAccounts_ConflictingDepartment" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:conflictingDepartment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DepartmentProcessAccounts .
                OPTIONAL { $this effortless-ntwf:conflictsWithAccount ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:DepartmentProcessAccounts ; effortless-ntwf:departmentProcessAccountId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:department ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DepartmentProcessAccounts_IsAwaitingEngagement" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAwaitingEngagement ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DepartmentProcessAccounts .
    OPTIONAL { $this effortless-ntwf:engagedAt ?engaged_at . OPTIONAL { ?engaged_at effortless-ntwf:__key ?engaged_at__key . } }
                BIND((COALESCE(?engaged_at__key, COALESCE(IF(isIRI(?engaged_at), REPLACE(STR(?engaged_at), "^.*[#/]", ""), STR(?engaged_at)), "")) = "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DepartmentProcessAccounts_IsConflictingAccount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isConflictingAccount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DepartmentProcessAccounts .
    OPTIONAL { $this effortless-ntwf:conflictingDepartment ?conflicting_department . }
    OPTIONAL { $this effortless-ntwf:conflictsWithAccount ?conflicts_with_account . OPTIONAL { ?conflicts_with_account effortless-ntwf:__key ?conflicts_with_account__key . } }
    OPTIONAL { $this effortless-ntwf:department ?department . }
                BIND((COALESCE((COALESCE(?conflicts_with_account__key, COALESCE(IF(isIRI(?conflicts_with_account), REPLACE(STR(?conflicts_with_account), "^.*[#/]", ""), STR(?conflicts_with_account)), "")) != ""), false) && COALESCE(COALESCE((?conflicting_department != ?department), !((!BOUND(?conflicting_department) || STR(?conflicting_department) = "") && (!BOUND(?department) || STR(?department) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DepartmentProcessAccounts_IsUnresolvedDisagreement" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnresolvedDisagreement ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DepartmentProcessAccounts .
    OPTIONAL { $this effortless-ntwf:isConflictingAccount ?is_conflicting_account . }
    OPTIONAL { $this effortless-ntwf:resolutionPractice ?resolution_practice . OPTIONAL { ?resolution_practice effortless-ntwf:__key ?resolution_practice__key . } }
                BIND((COALESCE(?is_conflicting_account, false) && COALESCE((COALESCE(?resolution_practice__key, COALESCE(IF(isIRI(?resolution_practice), REPLACE(STR(?resolution_practice), "^.*[#/]", ""), STR(?resolution_practice)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for DomainCoverageAreas ===
effortless-ntwf:DomainCoverageAreasShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DomainCoverageAreas ;
