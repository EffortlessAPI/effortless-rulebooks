            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:isLiveDecisionBacklog ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:awaitsAuthorityDecision ?awaits_authority_decision . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:touchesLiveVersion ?touches_live_version . }
                BIND((COALESCE(?awaits_authority_decision, false) && COALESCE(?touches_live_version, false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_BlocksAnOpenGap a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_BlocksAnOpenGap" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:blocksAnOpenGap ?_result .
            }
            WHERE {
    $this a pko-extension:ChangeRequest .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:changeKind ?change_kind . OPTIONAL { ?change_kind erb:key ?change_kind__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:isLiveDecisionBacklog ?is_live_decision_backlog . }
                BIND((COALESCE(?is_live_decision_backlog, false) && COALESCE((COALESCE(?change_kind__key, COALESCE(IF(isIRI(?change_kind), REPLACE(STR(?change_kind), "^.*[#/]", ""), STR(?change_kind)), "")) = "Enhancement"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ChangeRequests_BacklogVersionKey a sh:NodeShape ;
    sh:targetClass pko-extension:ChangeRequest ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_BacklogVersionKey" ;
        sh:construct """
