    OPTIONAL { $this effortless-ntwf:targetVersionUnderSpecified ?target_version_under_specified . }
                BIND((COALESCE(?is_agentic, false) && COALESCE((COALESCE(?target_version__key, COALESCE(IF(isIRI(?target_version), REPLACE(STR(?target_version), "^.*[#/]", ""), STR(?target_version)), "")) != ""), false) && COALESCE(?target_version_under_specified, false)) AS ?_result)
