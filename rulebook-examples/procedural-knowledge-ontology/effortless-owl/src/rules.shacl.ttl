                $this pko-native-procedural-knowledge-rulebook:ownedProcedureCount ?_result .
            }
            WHERE {
    $this a pko-industry:Department .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-industry:Department .
                    ?child a pko-native-procedural-knowledge-rulebook:Procedures .
                    ?child pko-native-procedural-knowledge-rulebook:ownerOrganization $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:Organizations_AiFailsForLackOfCapturedKnowledge a sh:NodeShape ;
    sh:targetClass pko-industry:Department ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_AiFailsForLackOfCapturedKnowledge" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-industry: <https://w3id.org/pko/industry#>
