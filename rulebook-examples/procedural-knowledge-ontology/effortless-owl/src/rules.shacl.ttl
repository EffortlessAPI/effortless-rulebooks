                BIND(IF(COALESCE((COALESCE(?satisfaction_level__key, COALESCE(IF(isIRI(?satisfaction_level), REPLACE(STR(?satisfaction_level), "^.*[#/]", ""), STR(?satisfaction_level)), "")) != ""), false), ?step_execution, "") AS ?_result)
            }
