pko-native-procedural-knowledge-rulebook-shapes:StepExecutions_IncompleteCueObservationCount a sh:NodeShape ;
    sh:targetClass pko:StepExecution ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IncompleteCueObservationCount" ;
