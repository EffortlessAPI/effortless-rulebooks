            CONSTRUCT {
                $this effortless-ntwf:notifiedConsumerCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ConsumerRevalidations .
                    ?child effortless-ntwf:rulebookRelease $this .
                    OPTIONAL { ?child effortless-ntwf:wasNotified ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_RevalidatedConsumerCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:revalidatedConsumerCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ConsumerRevalidations .
                    ?child effortless-ntwf:rulebookRelease $this .
                    OPTIONAL { ?child effortless-ntwf:passedRevalidation ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_ValidationRunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:validationRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeValidationRuns .
                    ?child effortless-ntwf:release ?backfk .
                    $this effortless-ntwf:rulebookReleaseId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_ValidationFailureTotal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:validationFailureTotal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:ChangeValidationRuns .
                    ?child effortless-ntwf:release ?backfk .
                    $this effortless-ntwf:rulebookReleaseId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:runPurpose ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:failureCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER((STR(?c2) = "Acceptance"))
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
