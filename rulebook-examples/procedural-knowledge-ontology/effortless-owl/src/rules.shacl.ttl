                BIND(CONCAT(COALESCE(COALESCE(?step_transition__key, IF(isIRI(?step_transition), REPLACE(STR(?step_transition), "^.*[#/]", ""), STR(?step_transition))), ""), " @ ", COALESCE(REPLACE(COALESCE(?observed_at__key, IF(isIRI(?observed_at), REPLACE(STR(?observed_at), "^.*[#/]", ""), STR(?observed_at))), "Z$", "+00:00"), "")) AS ?_result)
