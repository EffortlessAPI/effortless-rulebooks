            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:namespaceIsHttp ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:OntologyProfiles .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:namespaceIri ?namespace_iri . }
                BIND((COALESCE((SUBSTR(STR(?namespace_iri), 1, 7) = "http://"), false) || COALESCE((SUBSTR(STR(?namespace_iri), 1, 8) = "https://"), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:OntologyProfiles_NamespaceDereferences a sh:NodeShape ;
