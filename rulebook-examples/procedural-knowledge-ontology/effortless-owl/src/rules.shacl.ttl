    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureExecutions .
                    ?child effortless-ntwf:deviatingNightVersionKey ?backfk .
