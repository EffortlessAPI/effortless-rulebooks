    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_IsAdoptedWithoutPilot" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAdoptedWithoutPilot ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:modelKind ?model_kind . OPTIONAL { ?model_kind effortless-ntwf:__key ?model_kind__key . } }
    OPTIONAL { $this effortless-ntwf:pilotCount ?pilot_count . }
                BIND((COALESCE((COALESCE(?model_kind__key, COALESCE(IF(isIRI(?model_kind), REPLACE(STR(?model_kind), "^.*[#/]", ""), STR(?model_kind)), "")) != "Vocabulary"), false) && COALESCE((COALESCE(?pilot_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_RequirementsExpertCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requirementsExpertCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelActivityExperts .
                    ?child effortless-ntwf:governedModel $this .
                    OPTIONAL { ?child effortless-ntwf:lotActivity ?c2 . }
                    FILTER((STR(?c2) = "RequirementsSpecification"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_ImplementationExpertCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:implementationExpertCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelActivityExperts .
                    ?child effortless-ntwf:governedModel $this .
                    OPTIONAL { ?child effortless-ntwf:lotActivity ?c2 . }
                    FILTER((STR(?c2) = "Implementation"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_PublicationExpertCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:publicationExpertCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelActivityExperts .
                    ?child effortless-ntwf:governedModel $this .
                    OPTIONAL { ?child effortless-ntwf:lotActivity ?c2 . }
                    FILTER((STR(?c2) = "Publication"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_MaintenanceExpertCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:maintenanceExpertCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelActivityExperts .
                    ?child effortless-ntwf:governedModel $this .
                    OPTIONAL { ?child effortless-ntwf:lotActivity ?c2 . }
                    FILTER((STR(?c2) = "Maintenance"))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_ExpertsNotInvolvedThroughout" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:expertsNotInvolvedThroughout ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:implementationExpertCount ?implementation_expert_count . }
    OPTIONAL { $this effortless-ntwf:maintenanceExpertCount ?maintenance_expert_count . }
    OPTIONAL { $this effortless-ntwf:modelKind ?model_kind . OPTIONAL { ?model_kind effortless-ntwf:__key ?model_kind__key . } }
    OPTIONAL { $this effortless-ntwf:publicationExpertCount ?publication_expert_count . }
    OPTIONAL { $this effortless-ntwf:requirementsExpertCount ?requirements_expert_count . }
                BIND((COALESCE((COALESCE(?model_kind__key, COALESCE(IF(isIRI(?model_kind), REPLACE(STR(?model_kind), "^.*[#/]", ""), STR(?model_kind)), "")) != "Vocabulary"), false) && COALESCE((COALESCE((COALESCE(?requirements_expert_count, 0) = 0), false) || COALESCE((COALESCE(?implementation_expert_count, 0) = 0), false) || COALESCE((COALESCE(?publication_expert_count, 0) = 0), false) || COALESCE((COALESCE(?maintenance_expert_count, 0) = 0), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_RealDataMappingRunCount" ;
        sh:prefixes effortless-ntwf: ;
