            }
            WHERE {
    $this a pko-extension:MessageDelivery .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:currentLastApprovalAt ?current_last_approval_at . OPTIONAL { ?current_last_approval_at erb:key ?current_last_approval_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sentAt ?sent_at . }
                BIND((COALESCE((COALESCE(?current_last_approval_at__key, COALESCE(IF(isIRI(?current_last_approval_at), REPLACE(STR(?current_last_approval_at), "^.*[#/]", ""), STR(?current_last_approval_at)), "")) != ""), false) && COALESCE(COALESCE((?current_last_approval_at > ?sent_at), false), false)) AS ?_result)
            }
