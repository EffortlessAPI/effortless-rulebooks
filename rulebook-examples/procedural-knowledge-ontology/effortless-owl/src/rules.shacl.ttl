pko-native-procedural-knowledge-rulebook-shapes:RoleAssignmentUpdateTasks_DependentRunRoleStepCount a sh:NodeShape ;
    sh:targetClass pko-extension:RoleAssignmentUpdateTask ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignmentUpdateTasks_DependentRunRoleStepCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:dependentRunRoleStepCount ?_result .
            }
            WHERE {
    $this a pko-extension:RoleAssignmentUpdateTask .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:RoleAssignmentUpdateTask .
                    ?child a p-plan:Step .
                    ?child pko-native-procedural-knowledge-rulebook:procedureVersion ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:dependentRunVersion ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:assignedRole ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:role ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignmentUpdateTasks_MissedNextDependentRun a sh:NodeShape ;
    sh:targetClass pko-extension:RoleAssignmentUpdateTask ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignmentUpdateTasks_MissedNextDependentRun" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:missedNextDependentRun ?_result .
            }
            WHERE {
    $this a pko-extension:RoleAssignmentUpdateTask .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:completedAt ?completed_at . OPTIONAL { ?completed_at erb:key ?completed_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:dependentRunRoleStepCount ?dependent_run_role_step_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:dependentRunStartedAt ?dependent_run_started_at . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:triggerOccurredAt ?trigger_occurred_at . }
                BIND((COALESCE((COALESCE(?dependent_run_role_step_count, 0) > 0), false) && COALESCE(COALESCE((?dependent_run_started_at > ?trigger_occurred_at), false), false) && COALESCE((COALESCE((COALESCE(?completed_at__key, COALESCE(IF(isIRI(?completed_at), REPLACE(STR(?completed_at), "^.*[#/]", ""), STR(?completed_at)), "")) = ""), false) || COALESCE(COALESCE((?completed_at > ?dependent_run_started_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignmentUpdateTasks_FailedNoticeCount a sh:NodeShape ;
    sh:targetClass pko-extension:RoleAssignmentUpdateTask ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignmentUpdateTasks_FailedNoticeCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:failedNoticeCount ?_result .
            }
            WHERE {
    $this a pko-extension:RoleAssignmentUpdateTask .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:RoleAssignmentUpdateTask .
                    ?child a pko-extension:AssignmentRoutedNotice .
                    ?child pko-native-procedural-knowledge-rulebook:procedureExecution ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:dependentExecution ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:noticeRole ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:role ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:reachedWrongPersonOrNobody ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignmentUpdateTasks_StaleAssignmentBrokeRouting a sh:NodeShape ;
    sh:targetClass pko-extension:RoleAssignmentUpdateTask ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignmentUpdateTasks_StaleAssignmentBrokeRouting" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:staleAssignmentBrokeRouting ?_result .
            }
            WHERE {
    $this a pko-extension:RoleAssignmentUpdateTask .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:failedNoticeCount ?failed_notice_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:missedNextDependentRun ?missed_next_dependent_run . }
                BIND((COALESCE(?missed_next_dependent_run, false) && COALESCE((COALESCE(?failed_notice_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for RoleAssignments ===
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_Name a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:role ?role . OPTIONAL { ?role erb:key ?role__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:validFrom ?valid_from . OPTIONAL { ?valid_from erb:key ?valid_from__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?role__key, IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role))), ""), " @ ", COALESCE(REPLACE(COALESCE(?valid_from__key, IF(isIRI(?valid_from), REPLACE(STR(?valid_from), "^.*[#/]", ""), STR(?valid_from))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
