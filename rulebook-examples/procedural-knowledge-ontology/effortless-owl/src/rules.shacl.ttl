            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isImplementedWithoutRealData ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:modelKind ?model_kind . OPTIONAL { ?model_kind effortless-ntwf:__key ?model_kind__key . } }
    OPTIONAL { $this effortless-ntwf:realDataMappingRunCount ?real_data_mapping_run_count . }
                BIND((COALESCE((COALESCE(?model_kind__key, COALESCE(IF(isIRI(?model_kind), REPLACE(STR(?model_kind), "^.*[#/]", ""), STR(?model_kind)), "")) != "Vocabulary"), false) && COALESCE((COALESCE(?real_data_mapping_run_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for GroundingSnapshots ===
effortless-ntwf:GroundingSnapshotsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:GroundingSnapshots ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GroundingSnapshots .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_IsGoverned" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isGoverned ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GroundingSnapshots .
    OPTIONAL { $this effortless-ntwf:governanceReviewedAt ?governance_reviewed_at . OPTIONAL { ?governance_reviewed_at effortless-ntwf:__key ?governance_reviewed_at__key . } }
    OPTIONAL { $this effortless-ntwf:servedFrom ?served_from . }
    OPTIONAL { $this effortless-ntwf:stewardRole ?steward_role . OPTIONAL { ?steward_role effortless-ntwf:__key ?steward_role__key . } }
                BIND((COALESCE((COALESCE(?steward_role__key, COALESCE(IF(isIRI(?steward_role), REPLACE(STR(?steward_role), "^.*[#/]", ""), STR(?steward_role)), "")) != ""), false) && COALESCE((COALESCE(?governance_reviewed_at__key, COALESCE(IF(isIRI(?governance_reviewed_at), REPLACE(STR(?governance_reviewed_at), "^.*[#/]", ""), STR(?governance_reviewed_at)), "")) != ""), false) && COALESCE(COALESCE((?governance_reviewed_at <= ?served_from), ((!BOUND(?governance_reviewed_at) || STR(?governance_reviewed_at) = "") && (!BOUND(?served_from) || STR(?served_from) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_ReasonerRunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reasonerRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GroundingSnapshots .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ReasonerRuns .
                    ?child effortless-ntwf:snapshot $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_ConsistentReasonerRunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:consistentReasonerRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GroundingSnapshots .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ReasonerRuns .
                    ?child effortless-ntwf:snapshot $this .
                    OPTIONAL { ?child effortless-ntwf:isConsistent ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_LatestMaterializedAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:latestMaterializedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GroundingSnapshots .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:ReasonerRuns .
                    ?child effortless-ntwf:snapshot $this .
                    OPTIONAL { ?child effortless-ntwf:materializedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_ServedWithoutConsistencyCheck" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:servedWithoutConsistencyCheck ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GroundingSnapshots .
    OPTIONAL { $this effortless-ntwf:consistentReasonerRunCount ?consistent_reasoner_run_count . }
    OPTIONAL { $this effortless-ntwf:servedFrom ?served_from . OPTIONAL { ?served_from effortless-ntwf:__key ?served_from__key . } }
                BIND((COALESCE((COALESCE(?served_from__key, COALESCE(IF(isIRI(?served_from), REPLACE(STR(?served_from), "^.*[#/]", ""), STR(?served_from)), "")) != ""), false) && COALESCE((COALESCE(?consistent_reasoner_run_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_ServedBeforeMaterialization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:servedBeforeMaterialization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GroundingSnapshots .
    OPTIONAL { $this effortless-ntwf:latestMaterializedAt ?latest_materialized_at . OPTIONAL { ?latest_materialized_at effortless-ntwf:__key ?latest_materialized_at__key . } }
    OPTIONAL { $this effortless-ntwf:servedFrom ?served_from . OPTIONAL { ?served_from effortless-ntwf:__key ?served_from__key . } }
                BIND((COALESCE((COALESCE(?served_from__key, COALESCE(IF(isIRI(?served_from), REPLACE(STR(?served_from), "^.*[#/]", ""), STR(?served_from)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?latest_materialized_at__key, COALESCE(IF(isIRI(?latest_materialized_at), REPLACE(STR(?latest_materialized_at), "^.*[#/]", ""), STR(?latest_materialized_at)), "")) = ""), false) || COALESCE(COALESCE((?latest_materialized_at > ?served_from), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_AssertionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assertionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GroundingSnapshots .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SnapshotAssertions .
                    ?child effortless-ntwf:snapshot $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_StaleAssignmentAssertionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:staleAssignmentAssertionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GroundingSnapshots .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SnapshotAssertions .
                    ?child effortless-ntwf:snapshot $this .
                    OPTIONAL { ?child effortless-ntwf:isStaleRoleAssertion ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_ServesStaleRoleAssignments" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:servesStaleRoleAssignments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GroundingSnapshots .
    OPTIONAL { $this effortless-ntwf:staleAssignmentAssertionCount ?stale_assignment_assertion_count . }
                BIND((COALESCE(?stale_assignment_assertion_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_DeprecatedAsCurrentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:deprecatedAsCurrentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GroundingSnapshots .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SnapshotAssertions .
                    ?child effortless-ntwf:snapshot $this .
                    OPTIONAL { ?child effortless-ntwf:presentsDeprecatedAsCurrent ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_ServesDeprecatedAsCurrent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:servesDeprecatedAsCurrent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GroundingSnapshots .
    OPTIONAL { $this effortless-ntwf:deprecatedAsCurrentCount ?deprecated_as_current_count . }
                BIND((COALESCE(?deprecated_as_current_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for InstanceDataVersions ===
effortless-ntwf:InstanceDataVersionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InstanceDataVersions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InstanceDataVersions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InstanceDataVersions .
    OPTIONAL { $this effortless-ntwf:dataVersionLabel ?data_version_label . }
                BIND(?data_version_label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InstanceDataVersions_LoggedChangeCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:loggedChangeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InstanceDataVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelChangeLogEntries .
                    ?child effortless-ntwf:instanceDataVersion $this .
                    }
                }
            }
        """ ;
    ] .

