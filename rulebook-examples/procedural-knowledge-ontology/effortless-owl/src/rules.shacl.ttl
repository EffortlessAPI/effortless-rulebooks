            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX p-plan: <http://purl.org/net/p-plan#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasInstructionOnly ?_result .
            }
            WHERE {
    $this a p-plan:Step .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:cueCount ?cue_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:decisionPointCount ?decision_point_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:failureModeCount ?failure_mode_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:invariantCount ?invariant_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:knowledgeFragmentCount ?knowledge_fragment_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:postconditionCount ?postcondition_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:preconditionCount ?precondition_count . }
                BIND((COALESCE((COALESCE(((?precondition_count + ?postcondition_count) + ?invariant_count), 0) = 0), false) && COALESCE((COALESCE(?cue_count, 0) = 0), false) && COALESCE((COALESCE(?failure_mode_count, 0) = 0), false) && COALESCE((COALESCE(?decision_point_count, 0) = 0), false) && COALESCE((COALESCE(?knowledge_fragment_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
