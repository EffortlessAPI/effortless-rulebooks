    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:parentProcedureExecutionOfOutcome ?parent_procedure_execution_of_outcome . }
                BIND(IF(COALESCE(?is_independent_human_observation, false), ?parent_procedure_execution_of_outcome, "") AS ?_result)
            }
