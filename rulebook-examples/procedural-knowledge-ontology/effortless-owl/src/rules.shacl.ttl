    $this a effortless-ntwf:ExternalStandardTerms .
                OPTIONAL { $this effortless-ntwf:ontologyProfile ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:OntologyProfiles ; effortless-ntwf:ontologyProfileId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:namespaceIri ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_DaysSinceDeprecated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceDeprecated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:deprecatedAt ?deprecated_at . OPTIONAL { ?deprecated_at effortless-ntwf:__key ?deprecated_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?deprecated_at__key, COALESCE(IF(isIRI(?deprecated_at), REPLACE(STR(?deprecated_at), "^.*[#/]", ""), STR(?deprecated_at)), "")) = ""), false), 0, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?deprecated_at) + FLOOR((153 * (MONTH(?deprecated_at) + 12 * FLOOR((14 - MONTH(?deprecated_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?deprecated_at) + 4800 - FLOOR((14 - MONTH(?deprecated_at)) / 12)) + FLOOR((YEAR(?deprecated_at) + 4800 - FLOOR((14 - MONTH(?deprecated_at)) / 12)) / 4) - FLOOR((YEAR(?deprecated_at) + 4800 - FLOOR((14 - MONTH(?deprecated_at)) / 12)) / 100) + FLOOR((YEAR(?deprecated_at) + 4800 - FLOOR((14 - MONTH(?deprecated_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_IsRecentDeprecation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRecentDeprecation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
    OPTIONAL { $this effortless-ntwf:daysSinceDeprecated ?days_since_deprecated . }
    OPTIONAL { $this effortless-ntwf:deprecatedAt ?deprecated_at . OPTIONAL { ?deprecated_at effortless-ntwf:__key ?deprecated_at__key . } }
    OPTIONAL { $this effortless-ntwf:deprecatedBySource ?deprecated_by_source . }
                BIND((COALESCE(?deprecated_by_source, false) && COALESCE((COALESCE(?deprecated_at__key, COALESCE(IF(isIRI(?deprecated_at), REPLACE(STR(?deprecated_at), "^.*[#/]", ""), STR(?deprecated_at)), "")) != ""), false) && COALESCE((COALESCE(?days_since_deprecated, 0) <= 730), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_UsingMappingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:usingMappingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SemanticMappings .
                    ?child effortless-ntwf:targetIri ?backfk .
                    $this effortless-ntwf:termIri ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_StaleIdentifierMappingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:staleIdentifierMappingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SemanticMappings .
                    ?child effortless-ntwf:targetIri ?backfk .
                    $this effortless-ntwf:previousTermIri ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_IsAdoptedButDeprecated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAdoptedButDeprecated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
    OPTIONAL { $this effortless-ntwf:deprecatedBySource ?deprecated_by_source . }
    OPTIONAL { $this effortless-ntwf:rehomedAsTerm ?rehomed_as_term . OPTIONAL { ?rehomed_as_term effortless-ntwf:__key ?rehomed_as_term__key . } }
    OPTIONAL { $this effortless-ntwf:usingMappingCount ?using_mapping_count . }
                BIND((COALESCE(?deprecated_by_source, false) && COALESCE((COALESCE((COALESCE(?using_mapping_count, 0) > 0), false) || COALESCE((COALESCE(?rehomed_as_term__key, COALESCE(IF(isIRI(?rehomed_as_term), REPLACE(STR(?rehomed_as_term), "^.*[#/]", ""), STR(?rehomed_as_term)), "")) != ""), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_IsAlignmentStaleAfterDeprecation" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAlignmentStaleAfterDeprecation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
    OPTIONAL { $this effortless-ntwf:alignmentUpdatedAt ?alignment_updated_at . OPTIONAL { ?alignment_updated_at effortless-ntwf:__key ?alignment_updated_at__key . } }
    OPTIONAL { $this effortless-ntwf:deprecatedAt ?deprecated_at . }
    OPTIONAL { $this effortless-ntwf:deprecatedBySource ?deprecated_by_source . }
                BIND((COALESCE(?deprecated_by_source, false) && COALESCE((COALESCE((COALESCE(?alignment_updated_at__key, COALESCE(IF(isIRI(?alignment_updated_at), REPLACE(STR(?alignment_updated_at), "^.*[#/]", ""), STR(?alignment_updated_at)), "")) = ""), false) || COALESCE(COALESCE((?alignment_updated_at < ?deprecated_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_IsNeededDeprecatedTermNotRehomed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNeededDeprecatedTermNotRehomed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
    OPTIONAL { $this effortless-ntwf:deprecatedBySource ?deprecated_by_source . }
    OPTIONAL { $this effortless-ntwf:modelStillNeedsTerm ?model_still_needs_term . }
    OPTIONAL { $this effortless-ntwf:rehomedAsTerm ?rehomed_as_term . OPTIONAL { ?rehomed_as_term effortless-ntwf:__key ?rehomed_as_term__key . } }
                BIND((COALESCE(?deprecated_by_source, false) && COALESCE(?model_still_needs_term, false) && COALESCE((COALESCE(?rehomed_as_term__key, COALESCE(IF(isIRI(?rehomed_as_term), REPLACE(STR(?rehomed_as_term), "^.*[#/]", ""), STR(?rehomed_as_term)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_IsRehomedWithoutIdentityLink" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRehomedWithoutIdentityLink ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
    OPTIONAL { $this effortless-ntwf:rehomedAsTerm ?rehomed_as_term . OPTIONAL { ?rehomed_as_term effortless-ntwf:__key ?rehomed_as_term__key . } }
    OPTIONAL { $this effortless-ntwf:rehomedTermSameAs ?rehomed_term_same_as . OPTIONAL { ?rehomed_term_same_as effortless-ntwf:__key ?rehomed_term_same_as__key . } }
    OPTIONAL { $this effortless-ntwf:termIri ?term_iri . }
                BIND((COALESCE((COALESCE(?rehomed_as_term__key, COALESCE(IF(isIRI(?rehomed_as_term), REPLACE(STR(?rehomed_as_term), "^.*[#/]", ""), STR(?rehomed_as_term)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?rehomed_term_same_as__key, COALESCE(IF(isIRI(?rehomed_term_same_as), REPLACE(STR(?rehomed_term_same_as), "^.*[#/]", ""), STR(?rehomed_term_same_as)), "")) = ""), false) || COALESCE(COALESCE((?rehomed_term_same_as != ?term_iri), !((!BOUND(?rehomed_term_same_as) || STR(?rehomed_term_same_as) = "") && (!BOUND(?term_iri) || STR(?term_iri) = ""))), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_IsRehomedWithoutNewRelease" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isRehomedWithoutNewRelease ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
    OPTIONAL { $this effortless-ntwf:deprecatedAt ?deprecated_at . }
    OPTIONAL { $this effortless-ntwf:rehomedAsTerm ?rehomed_as_term . OPTIONAL { ?rehomed_as_term effortless-ntwf:__key ?rehomed_as_term__key . } }
    OPTIONAL { $this effortless-ntwf:rehomedTermReleaseIssuedAt ?rehomed_term_release_issued_at . OPTIONAL { ?rehomed_term_release_issued_at effortless-ntwf:__key ?rehomed_term_release_issued_at__key . } }
                BIND((COALESCE((COALESCE(?rehomed_as_term__key, COALESCE(IF(isIRI(?rehomed_as_term), REPLACE(STR(?rehomed_as_term), "^.*[#/]", ""), STR(?rehomed_as_term)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?rehomed_term_release_issued_at__key, COALESCE(IF(isIRI(?rehomed_term_release_issued_at), REPLACE(STR(?rehomed_term_release_issued_at), "^.*[#/]", ""), STR(?rehomed_term_release_issued_at)), "")) = ""), false) || COALESCE(COALESCE((?rehomed_term_release_issued_at < ?deprecated_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_HasUnpropagatedIdentifierChange" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasUnpropagatedIdentifierChange ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
    OPTIONAL { $this effortless-ntwf:previousTermIri ?previous_term_iri . OPTIONAL { ?previous_term_iri effortless-ntwf:__key ?previous_term_iri__key . } }
    OPTIONAL { $this effortless-ntwf:staleIdentifierMappingCount ?stale_identifier_mapping_count . }
                BIND((COALESCE((COALESCE(?previous_term_iri__key, COALESCE(IF(isIRI(?previous_term_iri), REPLACE(STR(?previous_term_iri), "^.*[#/]", ""), STR(?previous_term_iri)), "")) != ""), false) && COALESCE((COALESCE(?stale_identifier_mapping_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExternalStandardTerms_RehomingKeptExternalNamespace" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:rehomingKeptExternalNamespace ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExternalStandardTerms .
    OPTIONAL { $this effortless-ntwf:profileNamespaceIri ?profile_namespace_iri . }
    OPTIONAL { $this effortless-ntwf:rehomedAsTerm ?rehomed_as_term . OPTIONAL { ?rehomed_as_term effortless-ntwf:__key ?rehomed_as_term__key . } }
    OPTIONAL { $this effortless-ntwf:rehomedTermNamespace ?rehomed_term_namespace . }
                BIND((COALESCE((COALESCE(?rehomed_as_term__key, COALESCE(IF(isIRI(?rehomed_as_term), REPLACE(STR(?rehomed_as_term), "^.*[#/]", ""), STR(?rehomed_as_term)), "")) != ""), false) && COALESCE(COALESCE((?rehomed_term_namespace = ?profile_namespace_iri), ((!BOUND(?rehomed_term_namespace) || STR(?rehomed_term_namespace) = "") && (!BOUND(?profile_namespace_iri) || STR(?profile_namespace_iri) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for FAQs ===
effortless-ntwf:FAQsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FAQs ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FAQs_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FAQs .
    OPTIONAL { $this effortless-ntwf:question ?question . }
                BIND(?question AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FAQs_ResolutionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:resolutionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FAQs .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:UserQuestions .
                    ?child effortless-ntwf:resolvedByFaq $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FAQs_IsUnusedFaq" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnusedFaq ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FAQs .
    OPTIONAL { $this effortless-ntwf:resolutionCount ?resolution_count . }
                BIND((COALESCE(?resolution_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Facilities ===
effortless-ntwf:FacilitiesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Facilities ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Facilities_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Facilities .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Facilities_DeviatingRunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:deviatingRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Facilities .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureExecutions .
                    ?child effortless-ntwf:deviatingFacilityKey ?backfk .
                    $this effortless-ntwf:facilityId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Facilities_CleanRunCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cleanRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Facilities .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcedureExecutions .
                    ?child effortless-ntwf:cleanFacilityKey ?backfk .
                    $this effortless-ntwf:facilityId ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Facilities_IsDeviationOnlyFacility" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDeviationOnlyFacility ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Facilities .
    OPTIONAL { $this effortless-ntwf:cleanRunCount ?clean_run_count . }
    OPTIONAL { $this effortless-ntwf:deviatingRunCount ?deviating_run_count . }
                BIND((COALESCE((COALESCE(?deviating_run_count, 0) > 0), false) && COALESCE((COALESCE(?clean_run_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for FailureModes ===
effortless-ntwf:FailureModesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FailureModes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FailureModes_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FailureModes .
    OPTIONAL { $this effortless-ntwf:description ?description . }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?description), 1, 40)), REPLACE(STR(SUBSTR(STR(?description), 1, 40)), "^.*[#/]", ""), STR(SUBSTR(STR(?description), 1, 40))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FailureModes_EscalationRoleHasNoHolder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:escalationRoleHasNoHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FailureModes .
                OPTIONAL { $this effortless-ntwf:escalateToRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:hasNoCurrentHolder ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FailureModes_EscalatesToVacantRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:escalatesToVacantRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FailureModes .
    OPTIONAL { $this effortless-ntwf:escalationRoleHasNoHolder ?escalation_role_has_no_holder . }
    OPTIONAL { $this effortless-ntwf:requiresEscalation ?requires_escalation . }
                BIND((COALESCE(?requires_escalation, false) && COALESCE(?escalation_role_has_no_holder, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FailureModes_HasNoResponse" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoResponse ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FailureModes .
    OPTIONAL { $this effortless-ntwf:response ?response . OPTIONAL { ?response effortless-ntwf:__key ?response__key . } }
                BIND((COALESCE(?response__key, COALESCE(IF(isIRI(?response), REPLACE(STR(?response), "^.*[#/]", ""), STR(?response)), "")) = "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for FaqCategories ===
effortless-ntwf:FaqCategoriesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FaqCategories ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FaqCategories_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FaqCategories .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FaqCategories_FaqCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:faqCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FaqCategories .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FAQs .
                    ?child effortless-ntwf:category $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for FaqTargets ===
effortless-ntwf:FaqTargetsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FaqTargets ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FaqTargets_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FaqTargets .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FaqTargets_FaqCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:faqCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FaqTargets .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FAQs .
                    ?child effortless-ntwf:targetKind $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for FieldDisagreements ===
effortless-ntwf:FieldDisagreementsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FieldDisagreements ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldDisagreements .
    OPTIONAL { $this effortless-ntwf:rulebookField ?rulebook_field . OPTIONAL { ?rulebook_field effortless-ntwf:__key ?rulebook_field__key . } }
    OPTIONAL { $this effortless-ntwf:substrate ?substrate . OPTIONAL { ?substrate effortless-ntwf:__key ?substrate__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?substrate__key, IF(isIRI(?substrate), REPLACE(STR(?substrate), "^.*[#/]", ""), STR(?substrate))), ""), " / ", COALESCE(COALESCE(?rulebook_field__key, IF(isIRI(?rulebook_field), REPLACE(STR(?rulebook_field), "^.*[#/]", ""), STR(?rulebook_field))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_SampledCellCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:sampledCellCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldDisagreements .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:CellDisagreements .
                    ?child effortless-ntwf:fieldDisagreement $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_IsFullySampled" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFullySampled ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldDisagreements .
    OPTIONAL { $this effortless-ntwf:cellsFailed ?cells_failed . }
    OPTIONAL { $this effortless-ntwf:sampledCellCount ?sampled_cell_count . }
                BIND((COALESCE(?sampled_cell_count, 0) = COALESCE(?cells_failed, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_Formula" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:formula ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldDisagreements .
                OPTIONAL { $this effortless-ntwf:rulebookField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:formula ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldDisagreements_SubstrateLabel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:substrateLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldDisagreements .
                OPTIONAL { $this effortless-ntwf:substrate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ConformanceSubstrates ; effortless-ntwf:conformanceSubstrateId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for FieldGrants ===
effortless-ntwf:FieldGrantsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FieldGrants ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
    OPTIONAL { $this effortless-ntwf:principal ?principal . OPTIONAL { ?principal effortless-ntwf:__key ?principal__key . } }
    OPTIONAL { $this effortless-ntwf:targetField ?target_field . OPTIONAL { ?target_field effortless-ntwf:__key ?target_field__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), ""), " -> ", COALESCE(COALESCE(?target_field__key, IF(isIRI(?target_field), REPLACE(STR(?target_field), "^.*[#/]", ""), STR(?target_field))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_FieldTable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldTable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
                OPTIONAL { $this effortless-ntwf:targetField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:targetTable ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_FieldName" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
                OPTIONAL { $this effortless-ntwf:targetField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:fieldName ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_FieldIsDerived" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:fieldIsDerived ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
                OPTIONAL { $this effortless-ntwf:targetField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isDerived ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_IsWritableDerivedField" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isWritableDerivedField ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
    OPTIONAL { $this effortless-ntwf:canWrite ?can_write . }
    OPTIONAL { $this effortless-ntwf:fieldIsDerived ?field_is_derived . }
                BIND((COALESCE(?can_write, false) && COALESCE(?field_is_derived, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_IsMasked" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMasked ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
    OPTIONAL { $this effortless-ntwf:maskStrategy ?mask_strategy . OPTIONAL { ?mask_strategy effortless-ntwf:__key ?mask_strategy__key . } }
                BIND((COALESCE((COALESCE(?mask_strategy__key, COALESCE(IF(isIRI(?mask_strategy), REPLACE(STR(?mask_strategy), "^.*[#/]", ""), STR(?mask_strategy)), "")) != "plain"), false) && COALESCE((COALESCE(?mask_strategy__key, COALESCE(IF(isIRI(?mask_strategy), REPLACE(STR(?mask_strategy), "^.*[#/]", ""), STR(?mask_strategy)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_GrantKeyWhenReadable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:grantKeyWhenReadable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
    OPTIONAL { $this effortless-ntwf:canRead ?can_read . }
    OPTIONAL { $this effortless-ntwf:fieldTable ?field_table . OPTIONAL { ?field_table effortless-ntwf:__key ?field_table__key . } }
    OPTIONAL { $this effortless-ntwf:principal ?principal . OPTIONAL { ?principal effortless-ntwf:__key ?principal__key . } }
                BIND(IF(COALESCE(?can_read, false), CONCAT(COALESCE(COALESCE(?principal__key, IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), STR(?principal))), ""), "|", COALESCE(COALESCE(?field_table__key, IF(isIRI(?field_table), REPLACE(STR(?field_table), "^.*[#/]", ""), STR(?field_table))), "")), "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for FragmentCorroborations ===
effortless-ntwf:FragmentCorroborationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FragmentCorroborations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FragmentCorroborations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FragmentCorroborations .
    OPTIONAL { $this effortless-ntwf:elicitationSession ?elicitation_session . OPTIONAL { ?elicitation_session effortless-ntwf:__key ?elicitation_session__key . } }
    OPTIONAL { $this effortless-ntwf:knowledgeFragment ?knowledge_fragment . OPTIONAL { ?knowledge_fragment effortless-ntwf:__key ?knowledge_fragment__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?knowledge_fragment__key, IF(isIRI(?knowledge_fragment), REPLACE(STR(?knowledge_fragment), "^.*[#/]", ""), STR(?knowledge_fragment))), ""), " via ", COALESCE(COALESCE(?elicitation_session__key, IF(isIRI(?elicitation_session), REPLACE(STR(?elicitation_session), "^.*[#/]", ""), STR(?elicitation_session))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Functions ===
effortless-ntwf:FunctionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Functions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Functions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Functions .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for GovernanceStageControls ===
effortless-ntwf:GovernanceStageControlsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:GovernanceStageControls ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernanceStageControls_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernanceStageControls .
    OPTIONAL { $this effortless-ntwf:governedModel ?governed_model . OPTIONAL { ?governed_model effortless-ntwf:__key ?governed_model__key . } }
    OPTIONAL { $this effortless-ntwf:stage ?stage . OPTIONAL { ?stage effortless-ntwf:__key ?stage__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?governed_model__key, IF(isIRI(?governed_model), REPLACE(STR(?governed_model), "^.*[#/]", ""), STR(?governed_model))), ""), " ", COALESCE(COALESCE(?stage__key, IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernanceStageControls_IsContinuousPipelineStage" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isContinuousPipelineStage ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernanceStageControls .
    OPTIONAL { $this effortless-ntwf:isContinuous ?is_continuous . }
    OPTIONAL { $this effortless-ntwf:stage ?stage . OPTIONAL { ?stage effortless-ntwf:__key ?stage__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?stage__key, COALESCE(IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage)), "")) = "Collection"), false) || COALESCE((COALESCE(?stage__key, COALESCE(IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage)), "")) = "Organization"), false) || COALESCE((COALESCE(?stage__key, COALESCE(IF(isIRI(?stage), REPLACE(STR(?stage), "^.*[#/]", ""), STR(?stage)), "")) = "Encoding"), false)), false) && COALESCE(?is_continuous, false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for GovernedModels ===
effortless-ntwf:GovernedModelsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:GovernedModels ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_DaysSinceRegistered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceRegistered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:registeredAt ?registered_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?registered_at) + FLOOR((153 * (MONTH(?registered_at) + 12 * FLOOR((14 - MONTH(?registered_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?registered_at) + 4800 - FLOOR((14 - MONTH(?registered_at)) / 12)) + FLOOR((YEAR(?registered_at) + 4800 - FLOOR((14 - MONTH(?registered_at)) / 12)) / 4) - FLOOR((YEAR(?registered_at) + 4800 - FLOOR((14 - MONTH(?registered_at)) / 12)) / 100) + FLOOR((YEAR(?registered_at) + 4800 - FLOOR((14 - MONTH(?registered_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_CharterCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:charterCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelCharters .
                    ?child effortless-ntwf:governedModel $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_CurrentCharterCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentCharterCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelCharters .
                    ?child effortless-ntwf:governedModel $this .
                    OPTIONAL { ?child effortless-ntwf:isCurrent ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_CurrentStewardRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentStewardRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                OPTIONAL { $this effortless-ntwf:currentCharter ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ModelCharters ; effortless-ntwf:modelCharterId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:stewardRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_CurrentStewardAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentStewardAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                OPTIONAL { $this effortless-ntwf:currentCharter ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ModelCharters ; effortless-ntwf:modelCharterId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:stewardAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_CurrentAuthorityRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentAuthorityRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                OPTIONAL { $this effortless-ntwf:currentCharter ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ModelCharters ; effortless-ntwf:modelCharterId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:authorityRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_CurrentAuthorityAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:currentAuthorityAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                OPTIONAL { $this effortless-ntwf:currentCharter ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ModelCharters ; effortless-ntwf:modelCharterId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:authorityAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_IsOwnerless" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOwnerless ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:currentCharterCount ?current_charter_count . }
                BIND((COALESCE(?current_charter_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_IsOwnerlessPastAYear" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOwnerlessPastAYear ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:daysSinceRegistered ?days_since_registered . }
    OPTIONAL { $this effortless-ntwf:isOwnerless ?is_ownerless . }
                BIND((COALESCE(?is_ownerless, false) && COALESCE((COALESCE(?days_since_registered, 0) > 365), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_GovernanceLapsed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:governanceLapsed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:charterCount ?charter_count . }
    OPTIONAL { $this effortless-ntwf:currentCharterCount ?current_charter_count . }
                BIND((COALESCE((COALESCE(?charter_count, 0) > 0), false) && COALESCE((COALESCE(?current_charter_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_HasNoCurrentSteward" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoCurrentSteward ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:currentStewardAgent ?current_steward_agent . OPTIONAL { ?current_steward_agent effortless-ntwf:__key ?current_steward_agent__key . } }
                BIND((COALESCE(?current_steward_agent__key, COALESCE(IF(isIRI(?current_steward_agent), REPLACE(STR(?current_steward_agent), "^.*[#/]", ""), STR(?current_steward_agent)), "")) = "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_HasNoCurrentAuthority" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoCurrentAuthority ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:currentAuthorityAgent ?current_authority_agent . OPTIONAL { ?current_authority_agent effortless-ntwf:__key ?current_authority_agent__key . } }
                BIND((COALESCE(?current_authority_agent__key, COALESCE(IF(isIRI(?current_authority_agent), REPLACE(STR(?current_authority_agent), "^.*[#/]", ""), STR(?current_authority_agent)), "")) = "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_IsProcedureWithoutChangeAuthority" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isProcedureWithoutChangeAuthority ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:currentAuthorityAgent ?current_authority_agent . OPTIONAL { ?current_authority_agent effortless-ntwf:__key ?current_authority_agent__key . } }
    OPTIONAL { $this effortless-ntwf:modelKind ?model_kind . OPTIONAL { ?model_kind effortless-ntwf:__key ?model_kind__key . } }
                BIND((COALESCE((COALESCE(?model_kind__key, COALESCE(IF(isIRI(?model_kind), REPLACE(STR(?model_kind), "^.*[#/]", ""), STR(?model_kind)), "")) = "ProcedureFamily"), false) && COALESCE((COALESCE(?current_authority_agent__key, COALESCE(IF(isIRI(?current_authority_agent), REPLACE(STR(?current_authority_agent), "^.*[#/]", ""), STR(?current_authority_agent)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_LastStewardActivityAt" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lastStewardActivityAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:StewardActivities .
                    ?child effortless-ntwf:activityModel ?backfk .
                    $this effortless-ntwf:governedModelId ?backpv .
                    OPTIONAL { ?child effortless-ntwf:performedAt ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_DaysSinceStewardActivity" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceStewardActivity ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:daysSinceRegistered ?days_since_registered . }
    OPTIONAL { $this effortless-ntwf:lastStewardActivityAt ?last_steward_activity_at . OPTIONAL { ?last_steward_activity_at effortless-ntwf:__key ?last_steward_activity_at__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?last_steward_activity_at__key, COALESCE(IF(isIRI(?last_steward_activity_at), REPLACE(STR(?last_steward_activity_at), "^.*[#/]", ""), STR(?last_steward_activity_at)), "")) = ""), false), ?days_since_registered, ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_steward_activity_at) + FLOOR((153 * (MONTH(?last_steward_activity_at) + 12 * FLOOR((14 - MONTH(?last_steward_activity_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_steward_activity_at) + 4800 - FLOOR((14 - MONTH(?last_steward_activity_at)) / 12)) + FLOOR((YEAR(?last_steward_activity_at) + 4800 - FLOOR((14 - MONTH(?last_steward_activity_at)) / 12)) / 4) - FLOOR((YEAR(?last_steward_activity_at) + 4800 - FLOOR((14 - MONTH(?last_steward_activity_at)) / 12)) / 100) + FLOOR((YEAR(?last_steward_activity_at) + 4800 - FLOOR((14 - MONTH(?last_steward_activity_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_IsUnmaintained" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnmaintained ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:daysSinceStewardActivity ?days_since_steward_activity . }
                BIND((COALESCE(?days_since_steward_activity, 0) > 90) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_DocumentsBehindCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:documentsBehindCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ModelDocuments .
                    ?child effortless-ntwf:governedModel $this .
                    OPTIONAL { ?child effortless-ntwf:isBehindCurrentRelease ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_IsNotKeptCurrent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNotKeptCurrent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:documentsBehindCount ?documents_behind_count . }
    OPTIONAL { $this effortless-ntwf:isUnmaintained ?is_unmaintained . }
                BIND((COALESCE(?is_unmaintained, false) || COALESCE((COALESCE(?documents_behind_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_OpenPracticeDriftCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:openPracticeDriftCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:DriftObservations .
                    ?child effortless-ntwf:governedModel $this .
                    OPTIONAL { ?child effortless-ntwf:isOpenPracticeMismatch ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GovernedModels_HasOpenPracticeDrift" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasOpenPracticeDrift ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GovernedModels .
    OPTIONAL { $this effortless-ntwf:openPracticeDriftCount ?open_practice_drift_count . }
                BIND((COALESCE(?open_practice_drift_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
