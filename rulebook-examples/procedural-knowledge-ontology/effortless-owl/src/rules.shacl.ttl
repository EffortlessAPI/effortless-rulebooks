                    ?child a pko-native-procedural-knowledge-rulebook:TermLabelVariants .
                    ?child pko-native-procedural-knowledge-rulebook:prefWording ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this pko-native-procedural-knowledge-rulebook:prefWording ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
