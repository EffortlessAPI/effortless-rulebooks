            WHERE {
    $this a pko-extension:KnowledgeRepositoryEntry .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:daysSinceUpdated ?days_since_updated . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:reviewIntervalDays ?review_interval_days . }
                BIND((COALESCE((COALESCE(?review_interval_days, 0) > 0), false) && COALESCE((COALESCE(?days_since_updated, 0) > COALESCE(?review_interval_days, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
