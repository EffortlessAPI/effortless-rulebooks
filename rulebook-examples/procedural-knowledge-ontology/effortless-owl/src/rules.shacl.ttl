    OPTIONAL { $this effortless-ntwf:counterfactualCondition ?counterfactual_condition . OPTIONAL { ?counterfactual_condition effortless-ntwf:__key ?counterfactual_condition__key . } }
                BIND((COALESCE((COALESCE(?counterfactual_condition__key, COALESCE(IF(isIRI(?counterfactual_condition), REPLACE(STR(?counterfactual_condition), "^.*[#/]", ""), STR(?counterfactual_condition)), "")) != ""), false) && COALESCE((COALESCE(?counterfactual_answer__key, COALESCE(IF(isIRI(?counterfactual_answer), REPLACE(STR(?counterfactual_answer), "^.*[#/]", ""), STR(?counterfactual_answer)), "")) != ""), false)) AS ?_result)
