                $this pko-native-procedural-knowledge-rulebook:isSingleTeamSilo ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeAuditItem .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:heldInternalLevel ?held_internal_level . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:internalHoldingTeamCount ?internal_holding_team_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:neededLevel ?needed_level . }
                BIND((COALESCE((COALESCE(?held_internal_level, 0) >= COALESCE(?needed_level, 0)), false) && COALESCE((COALESCE(?internal_holding_team_count, 0) = 1), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for KnowledgeAudits ===
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeAudits_Name a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeAudit ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAudits_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeAudit .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:organization ?organization . OPTIONAL { ?organization erb:key ?organization__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:title ?title . OPTIONAL { ?title erb:key ?title__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?organization__key, IF(isIRI(?organization), REPLACE(STR(?organization), "^.*[#/]", ""), STR(?organization))), ""), ": ", COALESCE(COALESCE(?title__key, IF(isIRI(?title), REPLACE(STR(?title), "^.*[#/]", ""), STR(?title))), "")) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeAudits_FindingCount a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeAudit ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAudits_FindingCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:findingCount ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeAudit .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:KnowledgeAudit .
                    ?child a pko-extension:KnowledgeAuditItem .
                    ?child pko-native-procedural-knowledge-rulebook:knowledgeAudit $this .
                    OPTIONAL { ?child pko-native-procedural-knowledge-rulebook:hasInternalShortfall ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:KnowledgeAudits_TreatsDeficitAsCostProblem a sh:NodeShape ;
    sh:targetClass pko-extension:KnowledgeAudit ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAudits_TreatsDeficitAsCostProblem" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:treatsDeficitAsCostProblem ?_result .
            }
            WHERE {
    $this a pko-extension:KnowledgeAudit .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:findingCount ?finding_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:problemFraming ?problem_framing . OPTIONAL { ?problem_framing erb:key ?problem_framing__key . } }
                BIND((COALESCE((COALESCE(?finding_count, 0) > 0), false) && COALESCE((COALESCE(?problem_framing__key, COALESCE(IF(isIRI(?problem_framing), REPLACE(STR(?problem_framing), "^.*[#/]", ""), STR(?problem_framing)), "")) != "KnowledgeDeficit"), false)) AS ?_result)
            }
        """ ;
    ] .

