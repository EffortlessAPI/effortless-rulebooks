    $this a pko-extension:KnowledgeFragment .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:sourceAgent ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a prov:Agent . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:isStillEngaged ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
