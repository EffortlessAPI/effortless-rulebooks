            }
        """ ;
    ] .

# === Rules for AssistantAnswers ===
pko-native-procedural-knowledge-rulebook-shapes:AssistantAnswers_Name a sh:NodeShape ;
    sh:targetClass pko-extension:AssistantAnswer ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_Name" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:name ?_result .
            }
            WHERE {
    $this a pko-extension:AssistantAnswer .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:answeringAgent ?answering_agent . OPTIONAL { ?answering_agent erb:key ?answering_agent__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:questionText ?question_text . }
                BIND(CONCAT(COALESCE(COALESCE(?answering_agent__key, IF(isIRI(?answering_agent), REPLACE(STR(?answering_agent), "^.*[#/]", ""), STR(?answering_agent))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?question_text), 1, 50)), REPLACE(STR(SUBSTR(STR(?question_text), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?question_text), 1, 50))), "")) AS ?_result)
            }
        """ ;
