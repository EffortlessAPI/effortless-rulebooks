    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:machineExpression ?machine_expression . OPTIONAL { ?machine_expression erb:key ?machine_expression__key . } }
                BIND((COALESCE(?machine_expression__key, COALESCE(IF(isIRI(?machine_expression), REPLACE(STR(?machine_expression), "^.*[#/]", ""), STR(?machine_expression)), "")) != "") AS ?_result)
            }
        """ ;
    ] .
