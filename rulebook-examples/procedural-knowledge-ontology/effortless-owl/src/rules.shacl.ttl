            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:AccessPrincipals_IsOverPrivileged a sh:NodeShape ;
    sh:targetClass pko-extension:AccessPrincipal ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_IsOverPrivileged" ;
