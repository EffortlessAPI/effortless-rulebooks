    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:procedureExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureExecutions ; effortless-ntwf:procedureExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:procedureVersion ?j3 . } }
                BIND(?j3 AS ?_result)
            }
