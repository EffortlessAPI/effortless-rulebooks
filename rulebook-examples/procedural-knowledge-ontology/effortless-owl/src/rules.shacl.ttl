            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:servedWithoutConsistencyCheck ?_result .
            }
            WHERE {
    $this a pko-extension:GroundingSnapshot .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:consistentReasonerRunCount ?consistent_reasoner_run_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:servedFrom ?served_from . OPTIONAL { ?served_from erb:key ?served_from__key . } }
                BIND((COALESCE((COALESCE(?served_from__key, COALESCE(IF(isIRI(?served_from), REPLACE(STR(?served_from), "^.*[#/]", ""), STR(?served_from)), "")) != ""), false) && COALESCE((COALESCE(?consistent_reasoner_run_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:GroundingSnapshots_ServedBeforeMaterialization a sh:NodeShape ;
    sh:targetClass pko-extension:GroundingSnapshot ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_ServedBeforeMaterialization" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:servedBeforeMaterialization ?_result .
            }
            WHERE {
    $this a pko-extension:GroundingSnapshot .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:latestMaterializedAt ?latest_materialized_at . OPTIONAL { ?latest_materialized_at erb:key ?latest_materialized_at__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:servedFrom ?served_from . OPTIONAL { ?served_from erb:key ?served_from__key . } }
                BIND((COALESCE((COALESCE(?served_from__key, COALESCE(IF(isIRI(?served_from), REPLACE(STR(?served_from), "^.*[#/]", ""), STR(?served_from)), "")) != ""), false) && COALESCE((COALESCE((COALESCE(?latest_materialized_at__key, COALESCE(IF(isIRI(?latest_materialized_at), REPLACE(STR(?latest_materialized_at), "^.*[#/]", ""), STR(?latest_materialized_at)), "")) = ""), false) || COALESCE(COALESCE((?latest_materialized_at > ?served_from), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:GroundingSnapshots_AssertionCount a sh:NodeShape ;
    sh:targetClass pko-extension:GroundingSnapshot ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GroundingSnapshots_AssertionCount" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:assertionCount ?_result .
            }
            WHERE {
    $this a pko-extension:GroundingSnapshot .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:GroundingSnapshot .
                    ?child a pko-native-procedural-knowledge-rulebook:SnapshotAssertions .
                    ?child pko-native-procedural-knowledge-rulebook:snapshot $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
