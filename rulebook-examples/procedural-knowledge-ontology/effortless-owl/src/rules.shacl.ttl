            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:annotationCount ?_result .
            }
            WHERE {
    $this a pko-extension:EncodingLifecycleStage .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a pko-extension:EncodingLifecycleStage .
                    ?child a pko-extension:ModelAnnotation .
                    ?child pko-native-procedural-knowledge-rulebook:lifecycleStage $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:EncodingLifecycleStages_IsStageWithoutFeedback a sh:NodeShape ;
