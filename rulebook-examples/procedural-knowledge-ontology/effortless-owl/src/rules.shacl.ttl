    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_CqCoveragePercent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:cqCoveragePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:answerableCqRunCount ?answerable_cq_run_count . }
    OPTIONAL { $this effortless-ntwf:cqRunCount ?cq_run_count . }
                BIND(IF(COALESCE((COALESCE(?cq_run_count, 0) = 0), false), 0, (ROUND(((100 * ?answerable_cq_run_count) / ?cq_run_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
