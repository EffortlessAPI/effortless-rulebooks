    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_HasTransferShortfallExposure" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasTransferShortfallExposure ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:departingVeteranKnowHowCount ?departing_veteran_know_how_count . }
    OPTIONAL { $this effortless-ntwf:recentStarterCount ?recent_starter_count . }
    OPTIONAL { $this effortless-ntwf:untransferredVeteranKnowHowCount ?untransferred_veteran_know_how_count . }
                BIND((COALESCE((COALESCE((COALESCE(?recent_starter_count, 0) >= 3), false) && COALESCE((COALESCE(?untransferred_veteran_know_how_count, 0) > 0), false)), false) || COALESCE((COALESCE(?departing_veteran_know_how_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_ProficientWithCaptureCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:proficientWithCaptureCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:OnboardingRecords .
                    ?child effortless-ntwf:procedure $this .
                    OPTIONAL { ?child effortless-ntwf:isProficient ?c2 . }
                    OPTIONAL { ?child effortless-ntwf:usedCapturedKnowledge ?c4 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER(BOUND(?c4) && ?c4 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_ProficientWithoutCaptureCount" ;
