pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_SearchSuccessPercent a sh:NodeShape ;
    sh:targetClass pko-native-procedural-knowledge-rulebook:ProcedureVersions ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_SearchSuccessPercent" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:searchSuccessPercent ?_result .
            }
            WHERE {
    $this a pko-native-procedural-knowledge-rulebook:ProcedureVersions .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:searchCount ?search_count . }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:successfulSearchCount ?successful_search_count . }
                BIND(IF(COALESCE((COALESCE(?search_count, 0) = 0), false), 0, (ROUND(xsd:double((100 * ?successful_search_count) / ?search_count) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:ProcedureVersions_OpenQuestionAnnotationCount a sh:NodeShape ;
