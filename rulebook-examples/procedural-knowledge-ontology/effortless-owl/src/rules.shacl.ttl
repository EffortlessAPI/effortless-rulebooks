            WHERE {
    $this a pro:RoleInTime .
                OPTIONAL { $this pko-native-procedural-knowledge-rulebook:supersedesAssignment ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a pro:RoleInTime . OPTIONAL { ?j1 pko-native-procedural-knowledge-rulebook:validTo ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_PredecessorLacksValidityEnd a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorLacksValidityEnd" ;
        sh:construct """
            PREFIX pko-native-procedural-knowledge-rulebook: <https://example.org/pko-native-procedural-knowledge-rulebook#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX pro: <http://purl.org/spar/pro/>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:predecessorLacksValidityEnd ?_result .
            }
            WHERE {
    $this a pro:RoleInTime .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:predecessorValidTo ?predecessor_valid_to . OPTIONAL { ?predecessor_valid_to erb:key ?predecessor_valid_to__key . } }
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:supersedesAssignment ?supersedes_assignment . OPTIONAL { ?supersedes_assignment erb:key ?supersedes_assignment__key . } }
                BIND((COALESCE((COALESCE(?supersedes_assignment__key, COALESCE(IF(isIRI(?supersedes_assignment), REPLACE(STR(?supersedes_assignment), "^.*[#/]", ""), STR(?supersedes_assignment)), "")) != ""), false) && COALESCE((COALESCE(?predecessor_valid_to__key, COALESCE(IF(isIRI(?predecessor_valid_to), REPLACE(STR(?predecessor_valid_to), "^.*[#/]", ""), STR(?predecessor_valid_to)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] .
pko-native-procedural-knowledge-rulebook-shapes:RoleAssignments_AgentVersionKey a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;
