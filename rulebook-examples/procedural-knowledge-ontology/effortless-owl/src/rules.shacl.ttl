pko-native-procedural-knowledge-rulebook-shapes:AgentDecisionRecords_MatchingBoundaryCount a sh:NodeShape ;
    sh:targetClass pko-extension:AgentDecisionRecord ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_MatchingBoundaryCount" ;
