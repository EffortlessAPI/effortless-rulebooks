            PREFIX pko-extension: <https://effortlessapi.github.io/effortless-rulebooks/ns/pko-extension#>
            CONSTRUCT {
                $this pko-native-procedural-knowledge-rulebook:hasMeasuredData ?_result .
            }
            WHERE {
    $this a pko-extension:RulebookField .
    OPTIONAL { $this pko-native-procedural-knowledge-rulebook:measuredSubstantiveCount ?measured_substantive_count . }
