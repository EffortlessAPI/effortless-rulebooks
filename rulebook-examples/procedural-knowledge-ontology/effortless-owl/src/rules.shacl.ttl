                BIND((COALESCE((COALESCE(?holder_departure_at__key, COALESCE(IF(isIRI(?holder_departure_at), REPLACE(STR(?holder_departure_at), "^.*[#/]", ""), STR(?holder_departure_at)), "")) != ""), false) && COALESCE((COALESCE(?days_until_holder_departure, 0) >= 0), false) && COALESCE((COALESCE(?days_until_holder_departure, 0) <= 120), false)) AS ?_result)
