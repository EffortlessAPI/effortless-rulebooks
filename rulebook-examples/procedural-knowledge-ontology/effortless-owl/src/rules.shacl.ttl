            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:mustBeRelearnedIfHolderLeaves ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowHowCarriers .
    OPTIONAL { $this effortless-ntwf:holderAgent ?holder_agent . OPTIONAL { ?holder_agent effortless-ntwf:__key ?holder_agent__key . } }
    OPTIONAL { $this effortless-ntwf:holderIsStillEngaged ?holder_is_still_engaged . }
    OPTIONAL { $this effortless-ntwf:repositoryEntryCount ?repository_entry_count . }
                BIND((COALESCE((COALESCE(?holder_agent__key, COALESCE(IF(isIRI(?holder_agent), REPLACE(STR(?holder_agent), "^.*[#/]", ""), STR(?holder_agent)), "")) != ""), false) && COALESCE((COALESCE(?holder_is_still_engaged, false) = true), false) && COALESCE((COALESCE(?repository_entry_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_IsOverlookedLivingHolder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isOverlookedLivingHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowHowCarriers .
    OPTIONAL { $this effortless-ntwf:holderAgent ?holder_agent . OPTIONAL { ?holder_agent effortless-ntwf:__key ?holder_agent__key . } }
    OPTIONAL { $this effortless-ntwf:holderIsStillEngaged ?holder_is_still_engaged . }
    OPTIONAL { $this effortless-ntwf:repositoryEntryCount ?repository_entry_count . }
    OPTIONAL { $this effortless-ntwf:sourceRelationshipCount ?source_relationship_count . }
                BIND((COALESCE((COALESCE(?holder_agent__key, COALESCE(IF(isIRI(?holder_agent), REPLACE(STR(?holder_agent), "^.*[#/]", ""), STR(?holder_agent)), "")) != ""), false) && COALESCE((COALESCE(?holder_is_still_engaged, false) = true), false) && COALESCE((COALESCE(?repository_entry_count, 0) = 0), false) && COALESCE((COALESCE(?source_relationship_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_TransferStopsWithoutVeteran" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:transferStopsWithoutVeteran ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowHowCarriers .
    OPTIONAL { $this effortless-ntwf:holderIsStillEngaged ?holder_is_still_engaged . }
    OPTIONAL { $this effortless-ntwf:isVeteranHeld ?is_veteran_held . }
    OPTIONAL { $this effortless-ntwf:repositoryEntryCount ?repository_entry_count . }
    OPTIONAL { $this effortless-ntwf:transferCount ?transfer_count . }
                BIND((COALESCE(?is_veteran_held, false) && COALESCE((COALESCE(?holder_is_still_engaged, false) = true), false) && COALESCE((COALESCE(?transfer_count, 0) > 0), false) && COALESCE((COALESCE(?repository_entry_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_DependencyCommunity" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:dependencyCommunity ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowHowCarriers .
                OPTIONAL { $this effortless-ntwf:buildsOnKnowHow ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowHowCarriers ; effortless-ntwf:knowHowCarrierId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:communityOfPractice ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_BuildsOnSameCommunityKnowHow" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:buildsOnSameCommunityKnowHow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowHowCarriers .
    OPTIONAL { $this effortless-ntwf:buildsOnKnowHow ?builds_on_know_how . OPTIONAL { ?builds_on_know_how effortless-ntwf:__key ?builds_on_know_how__key . } }
    OPTIONAL { $this effortless-ntwf:communityOfPractice ?community_of_practice . OPTIONAL { ?community_of_practice effortless-ntwf:__key ?community_of_practice__key . } }
    OPTIONAL { $this effortless-ntwf:dependencyCommunity ?dependency_community . }
                BIND((COALESCE((COALESCE(?builds_on_know_how__key, COALESCE(IF(isIRI(?builds_on_know_how), REPLACE(STR(?builds_on_know_how), "^.*[#/]", ""), STR(?builds_on_know_how)), "")) != ""), false) && COALESCE((COALESCE(?community_of_practice__key, COALESCE(IF(isIRI(?community_of_practice), REPLACE(STR(?community_of_practice), "^.*[#/]", ""), STR(?community_of_practice)), "")) != ""), false) && COALESCE(COALESCE((?dependency_community = ?community_of_practice), ((!BOUND(?dependency_community) || STR(?dependency_community) = "") && (!BOUND(?community_of_practice) || STR(?community_of_practice) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_LostAccumulationYears" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:lostAccumulationYears ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowHowCarriers .
    OPTIONAL { $this effortless-ntwf:holderTenureYears ?holder_tenure_years . }
    OPTIONAL { $this effortless-ntwf:isHeldOnlyByDeparted ?is_held_only_by_departed . }
                BIND(IF(COALESCE(?is_held_only_by_departed, false), ?holder_tenure_years, 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowHowCarriers_IsDelegatedToUnfitSource" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDelegatedToUnfitSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowHowCarriers .
    OPTIONAL { $this effortless-ntwf:isInPublicReferences ?is_in_public_references . }
    OPTIONAL { $this effortless-ntwf:replacementPlan ?replacement_plan . OPTIONAL { ?replacement_plan effortless-ntwf:__key ?replacement_plan__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?replacement_plan__key, COALESCE(IF(isIRI(?replacement_plan), REPLACE(STR(?replacement_plan), "^.*[#/]", ""), STR(?replacement_plan)), "")) = "PublicReference"), false) || COALESCE((COALESCE(?replacement_plan__key, COALESCE(IF(isIRI(?replacement_plan), REPLACE(STR(?replacement_plan), "^.*[#/]", ""), STR(?replacement_plan)), "")) = "AiGeneration"), false)), false) && COALESCE((COALESCE(?is_in_public_references, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeAuditItems ===
effortless-ntwf:KnowledgeAuditItemsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeAuditItems ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAuditItems_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeAuditItems .
    OPTIONAL { $this effortless-ntwf:knowledgeArea ?knowledge_area . OPTIONAL { ?knowledge_area effortless-ntwf:__key ?knowledge_area__key . } }
    OPTIONAL { $this effortless-ntwf:knowledgeAudit ?knowledge_audit . OPTIONAL { ?knowledge_audit effortless-ntwf:__key ?knowledge_audit__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?knowledge_audit__key, IF(isIRI(?knowledge_audit), REPLACE(STR(?knowledge_audit), "^.*[#/]", ""), STR(?knowledge_audit))), ""), " / ", COALESCE(COALESCE(?knowledge_area__key, IF(isIRI(?knowledge_area), REPLACE(STR(?knowledge_area), "^.*[#/]", ""), STR(?knowledge_area))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAuditItems_ClientOrganization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:clientOrganization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeAuditItems .
                OPTIONAL { $this effortless-ntwf:knowledgeAudit ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeAudits ; effortless-ntwf:knowledgeAuditId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAuditItems_HasInternalShortfall" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasInternalShortfall ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeAuditItems .
    OPTIONAL { $this effortless-ntwf:heldInternalLevel ?held_internal_level . }
    OPTIONAL { $this effortless-ntwf:neededLevel ?needed_level . }
                BIND((COALESCE(?held_internal_level, 0) < COALESCE(?needed_level, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAuditItems_IsKnowledgeDependency" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isKnowledgeDependency ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeAuditItems .
    OPTIONAL { $this effortless-ntwf:hasInternalShortfall ?has_internal_shortfall . }
    OPTIONAL { $this effortless-ntwf:neededLevel ?needed_level . }
    OPTIONAL { $this effortless-ntwf:providerHeldLevel ?provider_held_level . }
    OPTIONAL { $this effortless-ntwf:providerHoldingKnowledge ?provider_holding_knowledge . OPTIONAL { ?provider_holding_knowledge effortless-ntwf:__key ?provider_holding_knowledge__key . } }
                BIND((COALESCE(?has_internal_shortfall, false) && COALESCE((COALESCE(?provider_holding_knowledge__key, COALESCE(IF(isIRI(?provider_holding_knowledge), REPLACE(STR(?provider_holding_knowledge), "^.*[#/]", ""), STR(?provider_holding_knowledge)), "")) != ""), false) && COALESCE((COALESCE(?provider_held_level, 0) >= COALESCE(?needed_level, 0)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAuditItems_IsCoverageGap" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCoverageGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeAuditItems .
    OPTIONAL { $this effortless-ntwf:hasInternalShortfall ?has_internal_shortfall . }
    OPTIONAL { $this effortless-ntwf:isKnowledgeDependency ?is_knowledge_dependency . }
                BIND((COALESCE(?has_internal_shortfall, false) && COALESCE((!(COALESCE(?is_knowledge_dependency, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAuditItems_IsUnnamedFinding" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnnamedFinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeAuditItems .
    OPTIONAL { $this effortless-ntwf:hasInternalShortfall ?has_internal_shortfall . }
    OPTIONAL { $this effortless-ntwf:namedKnowledgeGap ?named_knowledge_gap . OPTIONAL { ?named_knowledge_gap effortless-ntwf:__key ?named_knowledge_gap__key . } }
                BIND((COALESCE(?has_internal_shortfall, false) && COALESCE((COALESCE(?named_knowledge_gap__key, COALESCE(IF(isIRI(?named_knowledge_gap), REPLACE(STR(?named_knowledge_gap), "^.*[#/]", ""), STR(?named_knowledge_gap)), "")) = ""), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAuditItems_IsSingleTeamSilo" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isSingleTeamSilo ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeAuditItems .
    OPTIONAL { $this effortless-ntwf:heldInternalLevel ?held_internal_level . }
    OPTIONAL { $this effortless-ntwf:internalHoldingTeamCount ?internal_holding_team_count . }
    OPTIONAL { $this effortless-ntwf:neededLevel ?needed_level . }
                BIND((COALESCE((COALESCE(?held_internal_level, 0) >= COALESCE(?needed_level, 0)), false) && COALESCE((COALESCE(?internal_holding_team_count, 0) = 1), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeAudits ===
effortless-ntwf:KnowledgeAuditsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeAudits ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAudits_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeAudits .
    OPTIONAL { $this effortless-ntwf:organization ?organization . OPTIONAL { ?organization effortless-ntwf:__key ?organization__key . } }
    OPTIONAL { $this effortless-ntwf:title ?title . OPTIONAL { ?title effortless-ntwf:__key ?title__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?organization__key, IF(isIRI(?organization), REPLACE(STR(?organization), "^.*[#/]", ""), STR(?organization))), ""), ": ", COALESCE(COALESCE(?title__key, IF(isIRI(?title), REPLACE(STR(?title), "^.*[#/]", ""), STR(?title))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAudits_FindingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:findingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeAudits .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeAuditItems .
                    ?child effortless-ntwf:knowledgeAudit $this .
                    OPTIONAL { ?child effortless-ntwf:hasInternalShortfall ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeAudits_TreatsDeficitAsCostProblem" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:treatsDeficitAsCostProblem ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeAudits .
    OPTIONAL { $this effortless-ntwf:findingCount ?finding_count . }
    OPTIONAL { $this effortless-ntwf:problemFraming ?problem_framing . OPTIONAL { ?problem_framing effortless-ntwf:__key ?problem_framing__key . } }
                BIND((COALESCE((COALESCE(?finding_count, 0) > 0), false) && COALESCE((COALESCE(?problem_framing__key, COALESCE(IF(isIRI(?problem_framing), REPLACE(STR(?problem_framing), "^.*[#/]", ""), STR(?problem_framing)), "")) != "KnowledgeDeficit"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeBrokerLinks ===
effortless-ntwf:KnowledgeBrokerLinksShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeBrokerLinks ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:broker ?broker . OPTIONAL { ?broker effortless-ntwf:__key ?broker__key . } }
    OPTIONAL { $this effortless-ntwf:seeker ?seeker . OPTIONAL { ?seeker effortless-ntwf:__key ?seeker__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?seeker__key, IF(isIRI(?seeker), REPLACE(STR(?seeker), "^.*[#/]", ""), STR(?seeker))), ""), " -> ", COALESCE(COALESCE(?broker__key, IF(isIRI(?broker), REPLACE(STR(?broker), "^.*[#/]", ""), STR(?broker))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_DaysSinceConsulted" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceConsulted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:lastConsultedAt ?last_consulted_at . }
                BIND(ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_consulted_at) + FLOOR((153 * (MONTH(?last_consulted_at) + 12 * FLOOR((14 - MONTH(?last_consulted_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) + FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 4) - FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 100) + FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_IsActiveReliance" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isActiveReliance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:daysSinceConsulted ?days_since_consulted . }
    OPTIONAL { $this effortless-ntwf:frequency ?frequency . OPTIONAL { ?frequency effortless-ntwf:__key ?frequency__key . } }
                BIND((COALESCE((!(COALESCE((COALESCE(?frequency__key, COALESCE(IF(isIRI(?frequency), REPLACE(STR(?frequency), "^.*[#/]", ""), STR(?frequency)), "")) = "Rarely"), false))), false) && COALESCE((COALESCE(?days_since_consulted, 0) <= 180), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_BrokerIsStillEngaged" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:brokerIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
                OPTIONAL { $this effortless-ntwf:broker ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isStillEngaged ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_IsAtRiskReliance" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAtRiskReliance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:brokerIsStillEngaged ?broker_is_still_engaged . }
    OPTIONAL { $this effortless-ntwf:isActiveReliance ?is_active_reliance . }
                BIND((COALESCE(?is_active_reliance, false) && COALESCE((!(COALESCE(?broker_is_still_engaged, false))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_ActiveRelianceBrokerKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:activeRelianceBrokerKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:broker ?broker . }
    OPTIONAL { $this effortless-ntwf:isActiveReliance ?is_active_reliance . }
                BIND(IF(COALESCE(?is_active_reliance, false), ?broker, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_AtRiskBrokerKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:atRiskBrokerKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:broker ?broker . }
    OPTIONAL { $this effortless-ntwf:isAtRiskReliance ?is_at_risk_reliance . }
                BIND(IF(COALESCE(?is_at_risk_reliance, false), ?broker, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_PointedHolder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:pointedHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
                OPTIONAL { $this effortless-ntwf:pointsToKnowHow ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowHowCarriers ; effortless-ntwf:knowHowCarrierId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:holderAgent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_LocatesOtherHolder" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:locatesOtherHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:broker ?broker . }
    OPTIONAL { $this effortless-ntwf:pointedHolder ?pointed_holder . OPTIONAL { ?pointed_holder effortless-ntwf:__key ?pointed_holder__key . } }
    OPTIONAL { $this effortless-ntwf:pointsToKnowHow ?points_to_know_how . OPTIONAL { ?points_to_know_how effortless-ntwf:__key ?points_to_know_how__key . } }
                BIND((COALESCE((COALESCE(?points_to_know_how__key, COALESCE(IF(isIRI(?points_to_know_how), REPLACE(STR(?points_to_know_how), "^.*[#/]", ""), STR(?points_to_know_how)), "")) != ""), false) && COALESCE((COALESCE(?pointed_holder__key, COALESCE(IF(isIRI(?pointed_holder), REPLACE(STR(?pointed_holder), "^.*[#/]", ""), STR(?pointed_holder)), "")) != ""), false) && COALESCE(COALESCE((?pointed_holder != ?broker), !((!BOUND(?pointed_holder) || STR(?pointed_holder) = "") && (!BOUND(?broker) || STR(?broker) = ""))), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_TranslationBetweenVocabularies" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:translationBetweenVocabularies ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:holderVocabulary ?holder_vocabulary . OPTIONAL { ?holder_vocabulary effortless-ntwf:__key ?holder_vocabulary__key . } }
    OPTIONAL { $this effortless-ntwf:holderWording ?holder_wording . OPTIONAL { ?holder_wording effortless-ntwf:__key ?holder_wording__key . } }
    OPTIONAL { $this effortless-ntwf:seekerVocabulary ?seeker_vocabulary . OPTIONAL { ?seeker_vocabulary effortless-ntwf:__key ?seeker_vocabulary__key . } }
    OPTIONAL { $this effortless-ntwf:seekerWording ?seeker_wording . OPTIONAL { ?seeker_wording effortless-ntwf:__key ?seeker_wording__key . } }
                BIND(IF(COALESCE((COALESCE((COALESCE(?seeker_vocabulary__key, COALESCE(IF(isIRI(?seeker_vocabulary), REPLACE(STR(?seeker_vocabulary), "^.*[#/]", ""), STR(?seeker_vocabulary)), "")) != ""), false) && COALESCE((COALESCE(?holder_vocabulary__key, COALESCE(IF(isIRI(?holder_vocabulary), REPLACE(STR(?holder_vocabulary), "^.*[#/]", ""), STR(?holder_vocabulary)), "")) != ""), false) && COALESCE(COALESCE((?seeker_vocabulary != ?holder_vocabulary), !((!BOUND(?seeker_vocabulary) || STR(?seeker_vocabulary) = "") && (!BOUND(?holder_vocabulary) || STR(?holder_vocabulary) = ""))), false)), false), CONCAT(COALESCE(COALESCE(?seeker_wording__key, IF(isIRI(?seeker_wording), REPLACE(STR(?seeker_wording), "^.*[#/]", ""), STR(?seeker_wording))), ""), " (", COALESCE(COALESCE(?seeker_vocabulary__key, IF(isIRI(?seeker_vocabulary), REPLACE(STR(?seeker_vocabulary), "^.*[#/]", ""), STR(?seeker_vocabulary))), ""), ") = ", COALESCE(COALESCE(?holder_wording__key, IF(isIRI(?holder_wording), REPLACE(STR(?holder_wording), "^.*[#/]", ""), STR(?holder_wording))), ""), " (", COALESCE(COALESCE(?holder_vocabulary__key, IF(isIRI(?holder_vocabulary), REPLACE(STR(?holder_vocabulary), "^.*[#/]", ""), STR(?holder_vocabulary))), ""), ")"), "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeCaptureInitiatives ===
effortless-ntwf:KnowledgeCaptureInitiativesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeCaptureInitiatives ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeCaptureInitiatives_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeCaptureInitiatives .
    OPTIONAL { $this effortless-ntwf:knowledgeMethod ?knowledge_method . OPTIONAL { ?knowledge_method effortless-ntwf:__key ?knowledge_method__key . } }
    OPTIONAL { $this effortless-ntwf:sourcingFunction ?sourcing_function . OPTIONAL { ?sourcing_function effortless-ntwf:__key ?sourcing_function__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?sourcing_function__key, IF(isIRI(?sourcing_function), REPLACE(STR(?sourcing_function), "^.*[#/]", ""), STR(?sourcing_function))), ""), " by ", COALESCE(COALESCE(?knowledge_method__key, IF(isIRI(?knowledge_method), REPLACE(STR(?knowledge_method), "^.*[#/]", ""), STR(?knowledge_method))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeConsumerSystems ===
effortless-ntwf:KnowledgeConsumerSystemsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeConsumerSystems ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeConsumerSystems .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_ModelSyncCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:modelSyncCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeConsumerSystems .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ConsumerSystemSyncs .
                    ?child effortless-ntwf:consumerSystem $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_IntegrationCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:integrationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeConsumerSystems .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentIntegrations .
                    ?child effortless-ntwf:knowledgeSystem $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_IsKnowledgeSilo" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isKnowledgeSilo ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeConsumerSystems .
    OPTIONAL { $this effortless-ntwf:exportsStandardFormat ?exports_standard_format . }
    OPTIONAL { $this effortless-ntwf:holdsProcedureKnowledge ?holds_procedure_knowledge . }
    OPTIONAL { $this effortless-ntwf:modelSyncCount ?model_sync_count . }
                BIND((COALESCE(?holds_procedure_knowledge, false) && COALESCE((COALESCE(?exports_standard_format, false) = false), false) && COALESCE((COALESCE(?model_sync_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_IsUnlinkedToolchainComponent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnlinkedToolchainComponent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeConsumerSystems .
    OPTIONAL { $this effortless-ntwf:integrationCount ?integration_count . }
    OPTIONAL { $this effortless-ntwf:modelSyncCount ?model_sync_count . }
    OPTIONAL { $this effortless-ntwf:systemKind ?system_kind . OPTIONAL { ?system_kind effortless-ntwf:__key ?system_kind__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?system_kind__key, COALESCE(IF(isIRI(?system_kind), REPLACE(STR(?system_kind), "^.*[#/]", ""), STR(?system_kind)), "")) = "ProcessModelingTool"), false) || COALESCE((COALESCE(?system_kind__key, COALESCE(IF(isIRI(?system_kind), REPLACE(STR(?system_kind), "^.*[#/]", ""), STR(?system_kind)), "")) = "SemanticRepository"), false) || COALESCE((COALESCE(?system_kind__key, COALESCE(IF(isIRI(?system_kind), REPLACE(STR(?system_kind), "^.*[#/]", ""), STR(?system_kind)), "")) = "AIPlatform"), false)), false) && COALESCE((COALESCE((?model_sync_count + ?integration_count), 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_SemanticLayerComponentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:semanticLayerComponentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeConsumerSystems .
    OPTIONAL { $this effortless-ntwf:hasMetadataSchema ?has_metadata_schema . }
    OPTIONAL { $this effortless-ntwf:hasOntology ?has_ontology . }
    OPTIONAL { $this effortless-ntwf:hasReasoner ?has_reasoner . }
    OPTIONAL { $this effortless-ntwf:hasTaxonomy ?has_taxonomy . }
    OPTIONAL { $this effortless-ntwf:hasThesaurus ?has_thesaurus . }
                BIND(ROUND(((((IF(COALESCE(?has_taxonomy, false), 1, 0) + IF(COALESCE(?has_thesaurus, false), 1, 0)) + IF(COALESCE(?has_ontology, false), 1, 0)) + IF(COALESCE(?has_metadata_schema, false), 1, 0)) + IF(COALESCE(?has_reasoner, false), 1, 0))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_PlatformCapabilityCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:platformCapabilityCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeConsumerSystems .
    OPTIONAL { $this effortless-ntwf:hasGraphAlgorithms ?has_graph_algorithms . }
    OPTIONAL { $this effortless-ntwf:hasMachineLearning ?has_machine_learning . }
    OPTIONAL { $this effortless-ntwf:hasReasoner ?has_reasoner . }
    OPTIONAL { $this effortless-ntwf:hasSemanticStorage ?has_semantic_storage . }
                BIND(ROUND((((IF(COALESCE(?has_reasoner, false), 1, 0) + IF(COALESCE(?has_semantic_storage, false), 1, 0)) + IF(COALESCE(?has_graph_algorithms, false), 1, 0)) + IF(COALESCE(?has_machine_learning, false), 1, 0))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConsumerSystems_IsImmatureGraphPlatform" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isImmatureGraphPlatform ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeConsumerSystems .
    OPTIONAL { $this effortless-ntwf:platformCapabilityCount ?platform_capability_count . }
    OPTIONAL { $this effortless-ntwf:systemKind ?system_kind . OPTIONAL { ?system_kind effortless-ntwf:__key ?system_kind__key . } }
                BIND((COALESCE((COALESCE(?system_kind__key, COALESCE(IF(isIRI(?system_kind), REPLACE(STR(?system_kind), "^.*[#/]", ""), STR(?system_kind)), "")) = "KnowledgeGraphPlatform"), false) && COALESCE((COALESCE(?platform_capability_count, 0) < 4), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeConversions ===
effortless-ntwf:KnowledgeConversionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeConversions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConversions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeConversions .
    OPTIONAL { $this effortless-ntwf:conversionMode ?conversion_mode . OPTIONAL { ?conversion_mode effortless-ntwf:__key ?conversion_mode__key . } }
    OPTIONAL { $this effortless-ntwf:description ?description . }
                BIND(CONCAT(COALESCE(COALESCE(?conversion_mode__key, IF(isIRI(?conversion_mode), REPLACE(STR(?conversion_mode), "^.*[#/]", ""), STR(?conversion_mode))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?description), 1, 60)), REPLACE(STR(SUBSTR(STR(?description), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?description), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeConversions_IsModeInconsistentWithForms" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isModeInconsistentWithForms ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeConversions .
    OPTIONAL { $this effortless-ntwf:conversionMode ?conversion_mode . OPTIONAL { ?conversion_mode effortless-ntwf:__key ?conversion_mode__key . } }
    OPTIONAL { $this effortless-ntwf:fromForm ?from_form . OPTIONAL { ?from_form effortless-ntwf:__key ?from_form__key . } }
    OPTIONAL { $this effortless-ntwf:toForm ?to_form . OPTIONAL { ?to_form effortless-ntwf:__key ?to_form__key . } }
                BIND((!(COALESCE((COALESCE((COALESCE((COALESCE(?conversion_mode__key, COALESCE(IF(isIRI(?conversion_mode), REPLACE(STR(?conversion_mode), "^.*[#/]", ""), STR(?conversion_mode)), "")) = "Socialization"), false) && COALESCE((COALESCE(?from_form__key, COALESCE(IF(isIRI(?from_form), REPLACE(STR(?from_form), "^.*[#/]", ""), STR(?from_form)), "")) = "Tacit"), false) && COALESCE((COALESCE(?to_form__key, COALESCE(IF(isIRI(?to_form), REPLACE(STR(?to_form), "^.*[#/]", ""), STR(?to_form)), "")) = "Tacit"), false)), false) || COALESCE((COALESCE((COALESCE(?conversion_mode__key, COALESCE(IF(isIRI(?conversion_mode), REPLACE(STR(?conversion_mode), "^.*[#/]", ""), STR(?conversion_mode)), "")) = "Externalization"), false) && COALESCE((COALESCE(?from_form__key, COALESCE(IF(isIRI(?from_form), REPLACE(STR(?from_form), "^.*[#/]", ""), STR(?from_form)), "")) = "Tacit"), false) && COALESCE((COALESCE(?to_form__key, COALESCE(IF(isIRI(?to_form), REPLACE(STR(?to_form), "^.*[#/]", ""), STR(?to_form)), "")) = "Explicit"), false)), false) || COALESCE((COALESCE((COALESCE(?conversion_mode__key, COALESCE(IF(isIRI(?conversion_mode), REPLACE(STR(?conversion_mode), "^.*[#/]", ""), STR(?conversion_mode)), "")) = "Combination"), false) && COALESCE((COALESCE(?from_form__key, COALESCE(IF(isIRI(?from_form), REPLACE(STR(?from_form), "^.*[#/]", ""), STR(?from_form)), "")) = "Explicit"), false) && COALESCE((COALESCE(?to_form__key, COALESCE(IF(isIRI(?to_form), REPLACE(STR(?to_form), "^.*[#/]", ""), STR(?to_form)), "")) = "Explicit"), false)), false) || COALESCE((COALESCE((COALESCE(?conversion_mode__key, COALESCE(IF(isIRI(?conversion_mode), REPLACE(STR(?conversion_mode), "^.*[#/]", ""), STR(?conversion_mode)), "")) = "Internalization"), false) && COALESCE((COALESCE(?from_form__key, COALESCE(IF(isIRI(?from_form), REPLACE(STR(?from_form), "^.*[#/]", ""), STR(?from_form)), "")) = "Explicit"), false) && COALESCE((COALESCE(?to_form__key, COALESCE(IF(isIRI(?to_form), REPLACE(STR(?to_form), "^.*[#/]", ""), STR(?to_form)), "")) = "Tacit"), false)), false)), false))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeDeliverables ===
effortless-ntwf:KnowledgeDeliverablesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeDeliverables ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeDeliverables_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeDeliverables .
    OPTIONAL { $this effortless-ntwf:direction ?direction . OPTIONAL { ?direction effortless-ntwf:__key ?direction__key . } }
    OPTIONAL { $this effortless-ntwf:providerEngagement ?provider_engagement . OPTIONAL { ?provider_engagement effortless-ntwf:__key ?provider_engagement__key . } }
    OPTIONAL { $this effortless-ntwf:title ?title . OPTIONAL { ?title effortless-ntwf:__key ?title__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?provider_engagement__key, IF(isIRI(?provider_engagement), REPLACE(STR(?provider_engagement), "^.*[#/]", ""), STR(?provider_engagement))), ""), " ", COALESCE(COALESCE(?direction__key, IF(isIRI(?direction), REPLACE(STR(?direction), "^.*[#/]", ""), STR(?direction))), ""), ": ", COALESCE(COALESCE(?title__key, IF(isIRI(?title), REPLACE(STR(?title), "^.*[#/]", ""), STR(?title))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeDeliverables_IsDelivered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isDelivered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeDeliverables .
    OPTIONAL { $this effortless-ntwf:deliveredAt ?delivered_at . OPTIONAL { ?delivered_at effortless-ntwf:__key ?delivered_at__key . } }
                BIND((COALESCE(?delivered_at__key, COALESCE(IF(isIRI(?delivered_at), REPLACE(STR(?delivered_at), "^.*[#/]", ""), STR(?delivered_at)), "")) != "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeFragments ===
effortless-ntwf:KnowledgeFragmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeFragments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
