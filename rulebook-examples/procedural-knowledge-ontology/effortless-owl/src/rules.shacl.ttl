            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agenticWithoutKnowledgeCapture ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAdoptionInitiatives .
    OPTIONAL { $this effortless-ntwf:aiInsightCount ?ai_insight_count . }
    OPTIONAL { $this effortless-ntwf:isAgentic ?is_agentic . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE(?is_agentic, false) && COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) != "Proposed"), false) && COALESCE((COALESCE(?ai_insight_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_IsAiOutcomeUnmeasured" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAiOutcomeUnmeasured ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAdoptionInitiatives .
    OPTIONAL { $this effortless-ntwf:daysSinceOutcomeMeasured ?days_since_outcome_measured . }
    OPTIONAL { $this effortless-ntwf:lastOutcomeMeasuredAt ?last_outcome_measured_at . OPTIONAL { ?last_outcome_measured_at effortless-ntwf:__key ?last_outcome_measured_at__key . } }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "Pilot"), false) || COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "InProduction"), false)), false) && COALESCE((COALESCE((COALESCE(?last_outcome_measured_at__key, COALESCE(IF(isIRI(?last_outcome_measured_at), REPLACE(STR(?last_outcome_measured_at), "^.*[#/]", ""), STR(?last_outcome_measured_at)), "")) = ""), false) || COALESCE((COALESCE(?days_since_outcome_measured, 0) > 30), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_AdoptedWithoutBottomLineResult" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:adoptedWithoutBottomLineResult ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAdoptionInitiatives .
    OPTIONAL { $this effortless-ntwf:measuredBottomLineImpact ?measured_bottom_line_impact . }
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status effortless-ntwf:__key ?status__key . } }
                BIND((COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "InProduction"), false) && COALESCE((COALESCE(?measured_bottom_line_impact, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAdoptionInitiatives_FailedWithoutFormalizedKnowledge" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:failedWithoutFormalizedKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAdoptionInitiatives .
    OPTIONAL { $this effortless-ntwf:approach ?approach . OPTIONAL { ?approach effortless-ntwf:__key ?approach__key . } }
    OPTIONAL { $this effortless-ntwf:outcome ?outcome . OPTIONAL { ?outcome effortless-ntwf:__key ?outcome__key . } }
    OPTIONAL { $this effortless-ntwf:targetHasNoExplicitSteps ?target_has_no_explicit_steps . }
    OPTIONAL { $this effortless-ntwf:targetProcedure ?target_procedure . OPTIONAL { ?target_procedure effortless-ntwf:__key ?target_procedure__key . } }
                BIND((COALESCE((COALESCE(?outcome__key, COALESCE(IF(isIRI(?outcome), REPLACE(STR(?outcome), "^.*[#/]", ""), STR(?outcome)), "")) = "Failed"), false) && COALESCE((COALESCE(?approach__key, COALESCE(IF(isIRI(?approach), REPLACE(STR(?approach), "^.*[#/]", ""), STR(?approach)), "")) = "PromptOnly"), false) && COALESCE((COALESCE((COALESCE(?target_procedure__key, COALESCE(IF(isIRI(?target_procedure), REPLACE(STR(?target_procedure), "^.*[#/]", ""), STR(?target_procedure)), "")) = ""), false) || COALESCE((COALESCE((COALESCE(?target_procedure__key, COALESCE(IF(isIRI(?target_procedure), REPLACE(STR(?target_procedure), "^.*[#/]", ""), STR(?target_procedure)), "")) != ""), false) && COALESCE(?target_has_no_explicit_steps, false)), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AiAgentAccountabilities ===
effortless-ntwf:AiAgentAccountabilitiesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AiAgentAccountabilities ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAgentAccountabilities_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAgentAccountabilities .
    OPTIONAL { $this effortless-ntwf:accountableAgent ?accountable_agent . OPTIONAL { ?accountable_agent effortless-ntwf:__key ?accountable_agent__key . } }
    OPTIONAL { $this effortless-ntwf:aiAgent ?ai_agent . OPTIONAL { ?ai_agent effortless-ntwf:__key ?ai_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?ai_agent__key, IF(isIRI(?ai_agent), REPLACE(STR(?ai_agent), "^.*[#/]", ""), STR(?ai_agent))), ""), " accountable to ", COALESCE(COALESCE(?accountable_agent__key, IF(isIRI(?accountable_agent), REPLACE(STR(?accountable_agent), "^.*[#/]", ""), STR(?accountable_agent))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAgentAccountabilities_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAgentAccountabilities .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAgentAccountabilities_IsCurrent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAgentAccountabilities .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . OPTIONAL { ?valid_to effortless-ntwf:__key ?valid_to__key . } }
                BIND((COALESCE(COALESCE((?valid_from <= ?as_of_instant), ((!BOUND(?valid_from) || STR(?valid_from) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?valid_to__key, COALESCE(IF(isIRI(?valid_to), REPLACE(STR(?valid_to), "^.*[#/]", ""), STR(?valid_to)), "")) = ""), false) || COALESCE(COALESCE((?valid_to > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAgentAccountabilities_AccountableAgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:accountableAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAgentAccountabilities .
                OPTIONAL { $this effortless-ntwf:accountableAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAgentAccountabilities_IsAccountableToNonPerson" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAccountableToNonPerson ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAgentAccountabilities .
    OPTIONAL { $this effortless-ntwf:accountableAgentKind ?accountable_agent_kind . OPTIONAL { ?accountable_agent_kind effortless-ntwf:__key ?accountable_agent_kind__key . } }
                BIND((COALESCE(?accountable_agent_kind__key, COALESCE(IF(isIRI(?accountable_agent_kind), REPLACE(STR(?accountable_agent_kind), "^.*[#/]", ""), STR(?accountable_agent_kind)), "")) != "Human") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiAgentAccountabilities_IsCurrentHumanAccountability" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrentHumanAccountability ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiAgentAccountabilities .
    OPTIONAL { $this effortless-ntwf:accountableAgentKind ?accountable_agent_kind . OPTIONAL { ?accountable_agent_kind effortless-ntwf:__key ?accountable_agent_kind__key . } }
    OPTIONAL { $this effortless-ntwf:isCurrent ?is_current . }
                BIND((COALESCE(?is_current, false) && COALESCE((COALESCE(?accountable_agent_kind__key, COALESCE(IF(isIRI(?accountable_agent_kind), REPLACE(STR(?accountable_agent_kind), "^.*[#/]", ""), STR(?accountable_agent_kind)), "")) = "Human"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AiInsightProposals ===
effortless-ntwf:AiInsightProposalsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AiInsightProposals ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiInsightProposals_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiInsightProposals .
    OPTIONAL { $this effortless-ntwf:proposingAgent ?proposing_agent . OPTIONAL { ?proposing_agent effortless-ntwf:__key ?proposing_agent__key . } }
    OPTIONAL { $this effortless-ntwf:statement ?statement . }
                BIND(CONCAT(COALESCE(COALESCE(?proposing_agent__key, IF(isIRI(?proposing_agent), REPLACE(STR(?proposing_agent), "^.*[#/]", ""), STR(?proposing_agent))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?statement), 1, 50)), REPLACE(STR(SUBSTR(STR(?statement), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?statement), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiInsightProposals_TargetCreatorKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:targetCreatorKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiInsightProposals .
                OPTIONAL { $this effortless-ntwf:targetProcedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:createdByAgentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiInsightProposals_IsUnvalidatedOrStrandedInsight" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUnvalidatedOrStrandedInsight ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiInsightProposals .
    OPTIONAL { $this effortless-ntwf:foldedIntoChangeRequest ?folded_into_change_request . OPTIONAL { ?folded_into_change_request effortless-ntwf:__key ?folded_into_change_request__key . } }
    OPTIONAL { $this effortless-ntwf:validatedByAgent ?validated_by_agent . OPTIONAL { ?validated_by_agent effortless-ntwf:__key ?validated_by_agent__key . } }
    OPTIONAL { $this effortless-ntwf:validationVerdict ?validation_verdict . OPTIONAL { ?validation_verdict effortless-ntwf:__key ?validation_verdict__key . } }
                BIND((COALESCE((COALESCE((COALESCE(?folded_into_change_request__key, COALESCE(IF(isIRI(?folded_into_change_request), REPLACE(STR(?folded_into_change_request), "^.*[#/]", ""), STR(?folded_into_change_request)), "")) != ""), false) && COALESCE((COALESCE(?validated_by_agent__key, COALESCE(IF(isIRI(?validated_by_agent), REPLACE(STR(?validated_by_agent), "^.*[#/]", ""), STR(?validated_by_agent)), "")) = ""), false)), false) || COALESCE((COALESCE((COALESCE(?validation_verdict__key, COALESCE(IF(isIRI(?validation_verdict), REPLACE(STR(?validation_verdict), "^.*[#/]", ""), STR(?validation_verdict)), "")) = "Valid"), false) && COALESCE((COALESCE(?folded_into_change_request__key, COALESCE(IF(isIRI(?folded_into_change_request), REPLACE(STR(?folded_into_change_request), "^.*[#/]", ""), STR(?folded_into_change_request)), "")) = ""), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiInsightProposals_GrewModelWithoutHumanSeed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:grewModelWithoutHumanSeed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiInsightProposals .
    OPTIONAL { $this effortless-ntwf:insightKind ?insight_kind . OPTIONAL { ?insight_kind effortless-ntwf:__key ?insight_kind__key . } }
    OPTIONAL { $this effortless-ntwf:targetCreatorKind ?target_creator_kind . OPTIONAL { ?target_creator_kind effortless-ntwf:__key ?target_creator_kind__key . } }
    OPTIONAL { $this effortless-ntwf:targetProcedureVersion ?target_procedure_version . OPTIONAL { ?target_procedure_version effortless-ntwf:__key ?target_procedure_version__key . } }
                BIND((COALESCE((COALESCE(?insight_kind__key, COALESCE(IF(isIRI(?insight_kind), REPLACE(STR(?insight_kind), "^.*[#/]", ""), STR(?insight_kind)), "")) = "ModelExtension"), false) && COALESCE((COALESCE((COALESCE(?target_procedure_version__key, COALESCE(IF(isIRI(?target_procedure_version), REPLACE(STR(?target_procedure_version), "^.*[#/]", ""), STR(?target_procedure_version)), "")) = ""), false) || COALESCE((COALESCE(?target_creator_kind__key, COALESCE(IF(isIRI(?target_creator_kind), REPLACE(STR(?target_creator_kind), "^.*[#/]", ""), STR(?target_creator_kind)), "")) != "Human"), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AiLabelingRuns ===
effortless-ntwf:AiLabelingRunsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AiLabelingRuns ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiLabelingRuns_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiLabelingRuns .
    OPTIONAL { $this effortless-ntwf:agent ?agent . OPTIONAL { ?agent effortless-ntwf:__key ?agent__key . } }
    OPTIONAL { $this effortless-ntwf:runAt ?run_at . OPTIONAL { ?run_at effortless-ntwf:__key ?run_at__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?agent__key, IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), STR(?agent))), ""), " ", COALESCE(REPLACE(COALESCE(?run_at__key, IF(isIRI(?run_at), REPLACE(STR(?run_at), "^.*[#/]", ""), STR(?run_at))), "Z$", "+00:00"), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiLabelingRuns_OutputCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:outputCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiLabelingRuns .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SourceTermMentions .
                    ?child effortless-ntwf:aiLabelingRun $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiLabelingRuns_NonCanonicalOutputCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:nonCanonicalOutputCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiLabelingRuns .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SourceTermMentions .
                    ?child effortless-ntwf:aiLabelingRun $this .
                    OPTIONAL { ?child effortless-ntwf:isNonCanonicalGeneratedValue ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiLabelingRuns_GroundingSchemeIsMachineAccessible" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:groundingSchemeIsMachineAccessible ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiLabelingRuns .
                OPTIONAL { $this effortless-ntwf:groundingScheme ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Vocabularies ; effortless-ntwf:vocabularyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isMachineAccessible ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiLabelingRuns_IsUngroundedSynonymSprawl" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUngroundedSynonymSprawl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiLabelingRuns .
    OPTIONAL { $this effortless-ntwf:groundingScheme ?grounding_scheme . OPTIONAL { ?grounding_scheme effortless-ntwf:__key ?grounding_scheme__key . } }
    OPTIONAL { $this effortless-ntwf:nonCanonicalOutputCount ?non_canonical_output_count . }
                BIND((COALESCE((COALESCE(?grounding_scheme__key, COALESCE(IF(isIRI(?grounding_scheme), REPLACE(STR(?grounding_scheme), "^.*[#/]", ""), STR(?grounding_scheme)), "")) = ""), false) && COALESCE((COALESCE(?non_canonical_output_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiLabelingRuns_GroundedInNonMachineReadableScheme" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:groundedInNonMachineReadableScheme ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiLabelingRuns .
    OPTIONAL { $this effortless-ntwf:groundingScheme ?grounding_scheme . OPTIONAL { ?grounding_scheme effortless-ntwf:__key ?grounding_scheme__key . } }
    OPTIONAL { $this effortless-ntwf:groundingSchemeIsMachineAccessible ?grounding_scheme_is_machine_accessible . }
                BIND((COALESCE((COALESCE(?grounding_scheme__key, COALESCE(IF(isIRI(?grounding_scheme), REPLACE(STR(?grounding_scheme), "^.*[#/]", ""), STR(?grounding_scheme)), "")) != ""), false) && COALESCE((COALESCE(?grounding_scheme_is_machine_accessible, false) = false), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AiModelDeployments ===
effortless-ntwf:AiModelDeploymentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AiModelDeployments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelDeployments_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiModelDeployments .
    OPTIONAL { $this effortless-ntwf:environment ?environment . OPTIONAL { ?environment effortless-ntwf:__key ?environment__key . } }
    OPTIONAL { $this effortless-ntwf:modelVersion ?model_version . OPTIONAL { ?model_version effortless-ntwf:__key ?model_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_version__key, IF(isIRI(?model_version), REPLACE(STR(?model_version), "^.*[#/]", ""), STR(?model_version))), ""), " @ ", COALESCE(COALESCE(?environment__key, IF(isIRI(?environment), REPLACE(STR(?environment), "^.*[#/]", ""), STR(?environment))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelDeployments_AsOfInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiModelDeployments .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:asOfInstant ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelDeployments_IsLiveInProduction" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLiveInProduction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiModelDeployments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:deployedAt ?deployed_at . }
    OPTIONAL { $this effortless-ntwf:environment ?environment . OPTIONAL { ?environment effortless-ntwf:__key ?environment__key . } }
    OPTIONAL { $this effortless-ntwf:retiredAt ?retired_at . OPTIONAL { ?retired_at effortless-ntwf:__key ?retired_at__key . } }
                BIND((COALESCE((COALESCE(?environment__key, COALESCE(IF(isIRI(?environment), REPLACE(STR(?environment), "^.*[#/]", ""), STR(?environment)), "")) = "Production"), false) && COALESCE(COALESCE((?deployed_at <= ?as_of_instant), ((!BOUND(?deployed_at) || STR(?deployed_at) = "") && (!BOUND(?as_of_instant) || STR(?as_of_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?retired_at__key, COALESCE(IF(isIRI(?retired_at), REPLACE(STR(?retired_at), "^.*[#/]", ""), STR(?retired_at)), "")) = ""), false) || COALESCE(COALESCE((?retired_at > ?as_of_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelDeployments_AgentIdentifier" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentIdentifier ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiModelDeployments .
                OPTIONAL { $this effortless-ntwf:modelVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AiRegistryModelVersions ; effortless-ntwf:aiRegistryModelVersionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:dcIdentifier ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelDeployments_AssignmentLinkCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assignmentLinkCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiModelDeployments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:agent ?backfk .
                    $this effortless-ntwf:agentIdentifier ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelDeployments_ArtifactLinkCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:artifactLinkCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiModelDeployments .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ExecutionEntities .
                    ?child effortless-ntwf:attributedToAgent ?backfk .
                    $this effortless-ntwf:agentIdentifier ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelDeployments_IsIsolatedRegistryFact" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isIsolatedRegistryFact ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiModelDeployments .
    OPTIONAL { $this effortless-ntwf:artifactLinkCount ?artifact_link_count . }
    OPTIONAL { $this effortless-ntwf:assignmentLinkCount ?assignment_link_count . }
    OPTIONAL { $this effortless-ntwf:isLiveInProduction ?is_live_in_production . }
                BIND((COALESCE(?is_live_in_production, false) && COALESCE((COALESCE(?assignment_link_count, 0) = 0), false) && COALESCE((COALESCE(?artifact_link_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AiModelEvaluations ===
effortless-ntwf:AiModelEvaluationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AiModelEvaluations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelEvaluations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiModelEvaluations .
    OPTIONAL { $this effortless-ntwf:metric ?metric . OPTIONAL { ?metric effortless-ntwf:__key ?metric__key . } }
    OPTIONAL { $this effortless-ntwf:modelVersion ?model_version . OPTIONAL { ?model_version effortless-ntwf:__key ?model_version__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?model_version__key, IF(isIRI(?model_version), REPLACE(STR(?model_version), "^.*[#/]", ""), STR(?model_version))), ""), " ", COALESCE(COALESCE(?metric__key, IF(isIRI(?metric), REPLACE(STR(?metric), "^.*[#/]", ""), STR(?metric))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiModelEvaluations_Passed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:passed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiModelEvaluations .
    OPTIONAL { $this effortless-ntwf:passThreshold ?pass_threshold . }
    OPTIONAL { $this effortless-ntwf:score ?score . }
                BIND((COALESCE(?score, 0) >= COALESCE(?pass_threshold, 0)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AiRegistryModelVersions ===
effortless-ntwf:AiRegistryModelVersionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AiRegistryModelVersions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiRegistryModelVersions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiRegistryModelVersions .
    OPTIONAL { $this effortless-ntwf:dcHasVersion ?dc_has_version . OPTIONAL { ?dc_has_version effortless-ntwf:__key ?dc_has_version__key . } }
    OPTIONAL { $this effortless-ntwf:dcTitle ?dc_title . OPTIONAL { ?dc_title effortless-ntwf:__key ?dc_title__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?dc_title__key, IF(isIRI(?dc_title), REPLACE(STR(?dc_title), "^.*[#/]", ""), STR(?dc_title))), ""), " ", COALESCE(COALESCE(?dc_has_version__key, IF(isIRI(?dc_has_version), REPLACE(STR(?dc_has_version), "^.*[#/]", ""), STR(?dc_has_version))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiRegistryModelVersions_GraphIndividualCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:graphIndividualCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiRegistryModelVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Agents .
                    ?child effortless-ntwf:agentId ?backfk .
                    $this effortless-ntwf:dcIdentifier ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiRegistryModelVersions_LiveProductionDeploymentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:liveProductionDeploymentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiRegistryModelVersions .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AiModelDeployments .
                    ?child effortless-ntwf:modelVersion $this .
                    OPTIONAL { ?child effortless-ntwf:isLiveInProduction ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiRegistryModelVersions_IsLiveButUnregisteredInGraph" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isLiveButUnregisteredInGraph ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiRegistryModelVersions .
    OPTIONAL { $this effortless-ntwf:graphIndividualCount ?graph_individual_count . }
    OPTIONAL { $this effortless-ntwf:liveProductionDeploymentCount ?live_production_deployment_count . }
                BIND((COALESCE((COALESCE(?live_production_deployment_count, 0) > 0), false) && COALESCE((COALESCE(?graph_individual_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AiToolInvocations ===
effortless-ntwf:AiToolInvocationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AiToolInvocations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiToolInvocations_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiToolInvocations .
    OPTIONAL { $this effortless-ntwf:function ?function . OPTIONAL { ?function effortless-ntwf:__key ?function__key . } }
    OPTIONAL { $this effortless-ntwf:invokingAgent ?invoking_agent . OPTIONAL { ?invoking_agent effortless-ntwf:__key ?invoking_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?invoking_agent__key, IF(isIRI(?invoking_agent), REPLACE(STR(?invoking_agent), "^.*[#/]", ""), STR(?invoking_agent))), ""), " -> ", COALESCE(COALESCE(?function__key, IF(isIRI(?function), REPLACE(STR(?function), "^.*[#/]", ""), STR(?function))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiToolInvocations_ExecutedStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:executedStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiToolInvocations .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiToolInvocations_DeclaredFunctionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:declaredFunctionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiToolInvocations .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepFunctions .
                    ?child effortless-ntwf:step ?backfk .
                    $this effortless-ntwf:executedStep ?backpv .
                    OPTIONAL { ?child effortless-ntwf:function ?c2 . }
                    OPTIONAL { $this effortless-ntwf:function ?p2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(REPLACE(STR(?c2), "^.*[#/]", "") = REPLACE(STR(?p2), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiToolInvocations_IsUndeclaredToolUse" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUndeclaredToolUse ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiToolInvocations .
    OPTIONAL { $this effortless-ntwf:declaredFunctionCount ?declared_function_count . }
                BIND((COALESCE(?declared_function_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiToolInvocations_DeclaredInputCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:declaredInputCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiToolInvocations .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:stepInputVariableCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AiToolInvocations_ActedWithoutDeclaredContext" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:actedWithoutDeclaredContext ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AiToolInvocations .
    OPTIONAL { $this effortless-ntwf:declaredInputCount ?declared_input_count . }
    OPTIONAL { $this effortless-ntwf:suppliedInputCount ?supplied_input_count . }
                BIND((COALESCE((COALESCE(?declared_input_count, 0) > 0), false) && COALESCE((COALESCE(?supplied_input_count, 0) < COALESCE(?declared_input_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AnswerGroundings ===
effortless-ntwf:AnswerGroundingsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AnswerGroundings ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AnswerGroundings_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AnswerGroundings .
    OPTIONAL { $this effortless-ntwf:assistantAnswer ?assistant_answer . OPTIONAL { ?assistant_answer effortless-ntwf:__key ?assistant_answer__key . } }
    OPTIONAL { $this effortless-ntwf:externalSourceUri ?external_source_uri . OPTIONAL { ?external_source_uri effortless-ntwf:__key ?external_source_uri__key . } }
    OPTIONAL { $this effortless-ntwf:retrievalSegment ?retrieval_segment . OPTIONAL { ?retrieval_segment effortless-ntwf:__key ?retrieval_segment__key . } }
    OPTIONAL { $this effortless-ntwf:snapshotAssertion ?snapshot_assertion . OPTIONAL { ?snapshot_assertion effortless-ntwf:__key ?snapshot_assertion__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?assistant_answer__key, IF(isIRI(?assistant_answer), REPLACE(STR(?assistant_answer), "^.*[#/]", ""), STR(?assistant_answer))), ""), " <- ", COALESCE(COALESCE(?snapshot_assertion__key, IF(isIRI(?snapshot_assertion), REPLACE(STR(?snapshot_assertion), "^.*[#/]", ""), STR(?snapshot_assertion))), ""), COALESCE(COALESCE(?retrieval_segment__key, IF(isIRI(?retrieval_segment), REPLACE(STR(?retrieval_segment), "^.*[#/]", ""), STR(?retrieval_segment))), ""), COALESCE(COALESCE(?external_source_uri__key, IF(isIRI(?external_source_uri), REPLACE(STR(?external_source_uri), "^.*[#/]", ""), STR(?external_source_uri))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AnswerGroundings_IsFromOwnKnowledge" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isFromOwnKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AnswerGroundings .
    OPTIONAL { $this effortless-ntwf:externalSourceUri ?external_source_uri . OPTIONAL { ?external_source_uri effortless-ntwf:__key ?external_source_uri__key . } }
    OPTIONAL { $this effortless-ntwf:retrievalSegment ?retrieval_segment . OPTIONAL { ?retrieval_segment effortless-ntwf:__key ?retrieval_segment__key . } }
    OPTIONAL { $this effortless-ntwf:snapshotAssertion ?snapshot_assertion . OPTIONAL { ?snapshot_assertion effortless-ntwf:__key ?snapshot_assertion__key . } }
                BIND((COALESCE((COALESCE(?external_source_uri__key, COALESCE(IF(isIRI(?external_source_uri), REPLACE(STR(?external_source_uri), "^.*[#/]", ""), STR(?external_source_uri)), "")) = ""), false) && COALESCE((COALESCE((COALESCE(?snapshot_assertion__key, COALESCE(IF(isIRI(?snapshot_assertion), REPLACE(STR(?snapshot_assertion), "^.*[#/]", ""), STR(?snapshot_assertion)), "")) != ""), false) || COALESCE((COALESCE(?retrieval_segment__key, COALESCE(IF(isIRI(?retrieval_segment), REPLACE(STR(?retrieval_segment), "^.*[#/]", ""), STR(?retrieval_segment)), "")) != ""), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AnswerGroundings_AssertionIsStale" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assertionIsStale ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AnswerGroundings .
                OPTIONAL { $this effortless-ntwf:snapshotAssertion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:SnapshotAssertions ; effortless-ntwf:snapshotAssertionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isStaleRoleAssertion ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AnswerGroundings_AssertionPresentsDeprecated" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assertionPresentsDeprecated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AnswerGroundings .
                OPTIONAL { $this effortless-ntwf:snapshotAssertion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:SnapshotAssertions ; effortless-ntwf:snapshotAssertionId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:presentsDeprecatedAsCurrent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AnswerGroundings_GroundsOnStaleAssertion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:groundsOnStaleAssertion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AnswerGroundings .
    OPTIONAL { $this effortless-ntwf:assertionIsStale ?assertion_is_stale . }
    OPTIONAL { $this effortless-ntwf:assertionPresentsDeprecated ?assertion_presents_deprecated . }
    OPTIONAL { $this effortless-ntwf:snapshotAssertion ?snapshot_assertion . OPTIONAL { ?snapshot_assertion effortless-ntwf:__key ?snapshot_assertion__key . } }
                BIND((COALESCE((COALESCE(?snapshot_assertion__key, COALESCE(IF(isIRI(?snapshot_assertion), REPLACE(STR(?snapshot_assertion), "^.*[#/]", ""), STR(?snapshot_assertion)), "")) != ""), false) && COALESCE((COALESCE(?assertion_is_stale, false) || COALESCE(?assertion_presents_deprecated, false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AnswerRequirementChecks ===
effortless-ntwf:AnswerRequirementChecksShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AnswerRequirementChecks ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AnswerRequirementChecks_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AnswerRequirementChecks .
    OPTIONAL { $this effortless-ntwf:assistantAnswer ?assistant_answer . OPTIONAL { ?assistant_answer effortless-ntwf:__key ?assistant_answer__key . } }
    OPTIONAL { $this effortless-ntwf:requirement ?requirement . OPTIONAL { ?requirement effortless-ntwf:__key ?requirement__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?assistant_answer__key, IF(isIRI(?assistant_answer), REPLACE(STR(?assistant_answer), "^.*[#/]", ""), STR(?assistant_answer))), ""), " vs ", COALESCE(COALESCE(?requirement__key, IF(isIRI(?requirement), REPLACE(STR(?requirement), "^.*[#/]", ""), STR(?requirement))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AppNavGroups ===
effortless-ntwf:AppNavGroupsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppNavGroups ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppNavGroups_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppNavGroups .
    OPTIONAL { $this effortless-ntwf:groupLabel ?group_label . }
                BIND(?group_label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppNavGroups_RouteCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:routeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppNavGroups .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AppRoutes .
                    ?child effortless-ntwf:navGroup $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for AppRoleProfiles ===
effortless-ntwf:AppRoleProfilesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppRoleProfiles ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoleProfiles_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoleProfiles .
    OPTIONAL { $this effortless-ntwf:displayLabel ?display_label . OPTIONAL { ?display_label effortless-ntwf:__key ?display_label__key . } }
    OPTIONAL { $this effortless-ntwf:roleKind ?role_kind . OPTIONAL { ?role_kind effortless-ntwf:__key ?role_kind__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?display_label__key, IF(isIRI(?display_label), REPLACE(STR(?display_label), "^.*[#/]", ""), STR(?display_label))), ""), " (", COALESCE(COALESCE(?role_kind__key, IF(isIRI(?role_kind), REPLACE(STR(?role_kind), "^.*[#/]", ""), STR(?role_kind))), ""), ")") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoleProfiles_RouteCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:routeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoleProfiles .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AppRoutes .
                    ?child effortless-ntwf:owningRole ?backfk .
                    $this effortless-ntwf:role ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for AppRouteQuestions ===
effortless-ntwf:AppRouteQuestionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppRouteQuestions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRouteQuestions_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRouteQuestions .
    OPTIONAL { $this effortless-ntwf:question ?question . OPTIONAL { ?question effortless-ntwf:__key ?question__key . } }
    OPTIONAL { $this effortless-ntwf:route ?route . OPTIONAL { ?route effortless-ntwf:__key ?route__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?route__key, IF(isIRI(?route), REPLACE(STR(?route), "^.*[#/]", ""), STR(?route))), ""), " answers ", COALESCE(COALESCE(?question__key, IF(isIRI(?question), REPLACE(STR(?question), "^.*[#/]", ""), STR(?question))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AppRouteReferences ===
effortless-ntwf:AppRouteReferencesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppRouteReferences ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRouteReferences_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRouteReferences .
    OPTIONAL { $this effortless-ntwf:fromRoute ?from_route . OPTIONAL { ?from_route effortless-ntwf:__key ?from_route__key . } }
    OPTIONAL { $this effortless-ntwf:toRoute ?to_route . OPTIONAL { ?to_route effortless-ntwf:__key ?to_route__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_route__key, IF(isIRI(?from_route), REPLACE(STR(?from_route), "^.*[#/]", ""), STR(?from_route))), ""), " -> ", COALESCE(COALESCE(?to_route__key, IF(isIRI(?to_route), REPLACE(STR(?to_route), "^.*[#/]", ""), STR(?to_route))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AppRoutes ===
effortless-ntwf:AppRoutesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppRoutes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:routeName ?route_name . OPTIONAL { ?route_name effortless-ntwf:__key ?route_name__key . } }
    OPTIONAL { $this effortless-ntwf:routePath ?route_path . OPTIONAL { ?route_path effortless-ntwf:__key ?route_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?route_name__key, IF(isIRI(?route_name), REPLACE(STR(?route_name), "^.*[#/]", ""), STR(?route_name))), ""), " — ", COALESCE(COALESCE(?route_path__key, IF(isIRI(?route_path), REPLACE(STR(?route_path), "^.*[#/]", ""), STR(?route_path))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_IsInNav" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isInNav ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:navGroup ?nav_group . OPTIONAL { ?nav_group effortless-ntwf:__key ?nav_group__key . } }
                BIND((COALESCE(?nav_group__key, COALESCE(IF(isIRI(?nav_group), REPLACE(STR(?nav_group), "^.*[#/]", ""), STR(?nav_group)), "")) != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_IsShared" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isShared ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:owningRole ?owning_role . OPTIONAL { ?owning_role effortless-ntwf:__key ?owning_role__key . } }
    OPTIONAL { $this effortless-ntwf:surface ?surface . OPTIONAL { ?surface effortless-ntwf:__key ?surface__key . } }
                BIND((COALESCE((COALESCE(?owning_role__key, COALESCE(IF(isIRI(?owning_role), REPLACE(STR(?owning_role), "^.*[#/]", ""), STR(?owning_role)), "")) = ""), false) && COALESCE((COALESCE(?surface__key, COALESCE(IF(isIRI(?surface), REPLACE(STR(?surface), "^.*[#/]", ""), STR(?surface)), "")) = "domain"), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_IsMaintainer" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isMaintainer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:surface ?surface . OPTIONAL { ?surface effortless-ntwf:__key ?surface__key . } }
                BIND((COALESCE(?surface__key, COALESCE(IF(isIRI(?surface), REPLACE(STR(?surface), "^.*[#/]", ""), STR(?surface)), "")) = "maintainer") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_QuestionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:questionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AppRouteQuestions .
                    ?child effortless-ntwf:route $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_ReferenceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:referenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AppRouteReferences .
                    ?child effortless-ntwf:fromRoute $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_AnswersNoQuestion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:answersNoQuestion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:isMaintainer ?is_maintainer . }
    OPTIONAL { $this effortless-ntwf:isShared ?is_shared . }
    OPTIONAL { $this effortless-ntwf:questionCount ?question_count . }
    OPTIONAL { $this effortless-ntwf:routeKind ?route_kind . OPTIONAL { ?route_kind effortless-ntwf:__key ?route_kind__key . } }
                BIND((COALESCE((COALESCE(?question_count, 0) = 0), false) && COALESCE((COALESCE(?is_shared, false) = false), false) && COALESCE((COALESCE(?is_maintainer, false) = false), false) && COALESCE((COALESCE(?route_kind__key, COALESCE(IF(isIRI(?route_kind), REPLACE(STR(?route_kind), "^.*[#/]", ""), STR(?route_kind)), "")) != "index"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AppUsers ===
effortless-ntwf:AppUsersShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppUsers ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
    OPTIONAL { $this effortless-ntwf:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_AgentKind" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
                OPTIONAL { $this effortless-ntwf:linkedAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentKind ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_Organization" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:organization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
                OPTIONAL { $this effortless-ntwf:linkedAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:organization ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_AssignmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:PrincipalAssignments .
                    ?child effortless-ntwf:appUser $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_HasNoPrincipal" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoPrincipal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
    OPTIONAL { $this effortless-ntwf:assignmentCount ?assignment_count . }
                BIND((COALESCE(?assignment_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_HoldsMultiplePrincipals" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:holdsMultiplePrincipals ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
    OPTIONAL { $this effortless-ntwf:assignmentCount ?assignment_count . }
                BIND((COALESCE(?assignment_count, 0) > 1) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_IsNonHumanSignIn" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNonHumanSignIn ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
    OPTIONAL { $this effortless-ntwf:agentKind ?agent_kind . OPTIONAL { ?agent_kind effortless-ntwf:__key ?agent_kind__key . } }
                BIND((COALESCE((COALESCE(?agent_kind__key, COALESCE(IF(isIRI(?agent_kind), REPLACE(STR(?agent_kind), "^.*[#/]", ""), STR(?agent_kind)), "")) = "AIAgent"), false) || COALESCE((COALESCE(?agent_kind__key, COALESCE(IF(isIRI(?agent_kind), REPLACE(STR(?agent_kind), "^.*[#/]", ""), STR(?agent_kind)), "")) = "AutomatedPipeline"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ApplicabilityScopes ===
effortless-ntwf:ApplicabilityScopesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ApplicabilityScopes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ApplicabilityScopes_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ApplicabilityScopes .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ApplicabilityScopes_DimensionCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:dimensionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ApplicabilityScopes .
    OPTIONAL { $this effortless-ntwf:businessUnit ?business_unit . OPTIONAL { ?business_unit effortless-ntwf:__key ?business_unit__key . } }
    OPTIONAL { $this effortless-ntwf:customerSegment ?customer_segment . OPTIONAL { ?customer_segment effortless-ntwf:__key ?customer_segment__key . } }
    OPTIONAL { $this effortless-ntwf:geography ?geography . OPTIONAL { ?geography effortless-ntwf:__key ?geography__key . } }
    OPTIONAL { $this effortless-ntwf:regulatoryRegime ?regulatory_regime . OPTIONAL { ?regulatory_regime effortless-ntwf:__key ?regulatory_regime__key . } }
                BIND(ROUND((((IF(COALESCE((COALESCE(?business_unit__key, COALESCE(IF(isIRI(?business_unit), REPLACE(STR(?business_unit), "^.*[#/]", ""), STR(?business_unit)), "")) != ""), false), 1, 0) + IF(COALESCE((COALESCE(?geography__key, COALESCE(IF(isIRI(?geography), REPLACE(STR(?geography), "^.*[#/]", ""), STR(?geography)), "")) != ""), false), 1, 0)) + IF(COALESCE((COALESCE(?customer_segment__key, COALESCE(IF(isIRI(?customer_segment), REPLACE(STR(?customer_segment), "^.*[#/]", ""), STR(?customer_segment)), "")) != ""), false), 1, 0)) + IF(COALESCE((COALESCE(?regulatory_regime__key, COALESCE(IF(isIRI(?regulatory_regime), REPLACE(STR(?regulatory_regime), "^.*[#/]", ""), STR(?regulatory_regime)), "")) != ""), false), 1, 0))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ApplicabilityScopes_StatesConditions" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:statesConditions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ApplicabilityScopes .
    OPTIONAL { $this effortless-ntwf:appliesWhen ?applies_when . OPTIONAL { ?applies_when effortless-ntwf:__key ?applies_when__key . } }
    OPTIONAL { $this effortless-ntwf:exclusionCondition ?exclusion_condition . OPTIONAL { ?exclusion_condition effortless-ntwf:__key ?exclusion_condition__key . } }
                BIND((COALESCE((COALESCE(?applies_when__key, COALESCE(IF(isIRI(?applies_when), REPLACE(STR(?applies_when), "^.*[#/]", ""), STR(?applies_when)), "")) != ""), false) || COALESCE((COALESCE(?exclusion_condition__key, COALESCE(IF(isIRI(?exclusion_condition), REPLACE(STR(?exclusion_condition), "^.*[#/]", ""), STR(?exclusion_condition)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ArticleClaims ===
effortless-ntwf:ArticleClaimsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ArticleClaims ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ArticleClaims .
    OPTIONAL { $this effortless-ntwf:articleClaimId ?article_claim_id . OPTIONAL { ?article_claim_id effortless-ntwf:__key ?article_claim_id__key . } }
    OPTIONAL { $this effortless-ntwf:claimText ?claim_text . }
                BIND(CONCAT(COALESCE(COALESCE(?article_claim_id__key, IF(isIRI(?article_claim_id), REPLACE(STR(?article_claim_id), "^.*[#/]", ""), STR(?article_claim_id))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?claim_text), 1, 60)), REPLACE(STR(SUBSTR(STR(?claim_text), 1, 60)), "^.*[#/]", ""), STR(SUBSTR(STR(?claim_text), 1, 60))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_RequiredEvidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:requiredEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ArticleClaims .
    OPTIONAL { $this effortless-ntwf:claimKind ?claim_kind . OPTIONAL { ?claim_kind effortless-ntwf:__key ?claim_kind__key . } }
                BIND(IF(COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "Concept"), false), "a table with rows or a field with data", IF(COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "CompetencyQuestion"), false), "an answered role question with a computed answer", IF(COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "Standard"), false), "a mapped ontology profile or an applied knowledge method", IF(COALESCE((COALESCE(?claim_kind__key, COALESCE(IF(isIRI(?claim_kind), REPLACE(STR(?claim_kind), "^.*[#/]", ""), STR(?claim_kind)), "")) = "Scenario"), false), "a procedure with recorded executions", "a discriminating witness invented for a role question")))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_EvidenceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:evidenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ArticleClaims .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ClaimEvidence .
                    ?child effortless-ntwf:articleClaim $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_ValidEvidenceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:validEvidenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ArticleClaims .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ClaimEvidence .
                    ?child effortless-ntwf:articleClaim $this .
                    OPTIONAL { ?child effortless-ntwf:isValid ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_AgreedEvidenceCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:agreedEvidenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ArticleClaims .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ClaimEvidence .
                    ?child effortless-ntwf:articleClaim $this .
                    OPTIONAL { ?child effortless-ntwf:isAgreedEvidence ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_IsCovered" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isCovered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ArticleClaims .
    OPTIONAL { $this effortless-ntwf:validEvidenceCount ?valid_evidence_count . }
                BIND((COALESCE(?valid_evidence_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_IsAgreed" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isAgreed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ArticleClaims .
    OPTIONAL { $this effortless-ntwf:agreedEvidenceCount ?agreed_evidence_count . }
                BIND((COALESCE(?agreed_evidence_count, 0) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArticleClaims_HasRejectedEvidence" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:hasRejectedEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ArticleClaims .
    OPTIONAL { $this effortless-ntwf:evidenceCount ?evidence_count . }
    OPTIONAL { $this effortless-ntwf:validEvidenceCount ?valid_evidence_count . }
                BIND((COALESCE((COALESCE(?evidence_count, 0) > 0), false) && COALESCE((COALESCE(?valid_evidence_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ArtifactHandoffs ===
effortless-ntwf:ArtifactHandoffsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ArtifactHandoffs ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArtifactHandoffs_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ArtifactHandoffs .
    OPTIONAL { $this effortless-ntwf:fromStep ?from_step . OPTIONAL { ?from_step effortless-ntwf:__key ?from_step__key . } }
    OPTIONAL { $this effortless-ntwf:toStep ?to_step . OPTIONAL { ?to_step effortless-ntwf:__key ?to_step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?from_step__key, IF(isIRI(?from_step), REPLACE(STR(?from_step), "^.*[#/]", ""), STR(?from_step))), ""), " -> ", COALESCE(COALESCE(?to_step__key, IF(isIRI(?to_step), REPLACE(STR(?to_step), "^.*[#/]", ""), STR(?to_step))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArtifactHandoffs_DeclaredSourceStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:declaredSourceStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ArtifactHandoffs .
                OPTIONAL { $this effortless-ntwf:stepVariable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepVariables ; effortless-ntwf:stepVariableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:sourceStep ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArtifactHandoffs_DeclaredConsumerStep" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:declaredConsumerStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ArtifactHandoffs .
                OPTIONAL { $this effortless-ntwf:stepVariable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepVariables ; effortless-ntwf:stepVariableId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:step ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArtifactHandoffs_DisagreesWithDeclaredVariable" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:disagreesWithDeclaredVariable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ArtifactHandoffs .
    OPTIONAL { $this effortless-ntwf:declaredConsumerStep ?declared_consumer_step . }
    OPTIONAL { $this effortless-ntwf:declaredSourceStep ?declared_source_step . }
    OPTIONAL { $this effortless-ntwf:fromStep ?from_step . }
    OPTIONAL { $this effortless-ntwf:toStep ?to_step . }
                BIND((COALESCE(COALESCE((?from_step != ?declared_source_step), !((!BOUND(?from_step) || STR(?from_step) = "") && (!BOUND(?declared_source_step) || STR(?declared_source_step) = ""))), false) || COALESCE(COALESCE((?to_step != ?declared_consumer_step), !((!BOUND(?to_step) || STR(?to_step) = "") && (!BOUND(?declared_consumer_step) || STR(?declared_consumer_step) = ""))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AssignmentInstantChecks ===
effortless-ntwf:AssignmentInstantChecksShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AssignmentInstantChecks ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentInstantChecks .
    OPTIONAL { $this effortless-ntwf:roleAssignment ?role_assignment . OPTIONAL { ?role_assignment effortless-ntwf:__key ?role_assignment__key . } }
    OPTIONAL { $this effortless-ntwf:step ?step . OPTIONAL { ?step effortless-ntwf:__key ?step__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?step__key, IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), STR(?step))), ""), " / ", COALESCE(COALESCE(?role_assignment__key, IF(isIRI(?role_assignment), REPLACE(STR(?role_assignment), "^.*[#/]", ""), STR(?role_assignment))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_StepRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:stepRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentInstantChecks .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:assignedRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_AssignmentRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assignmentRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentInstantChecks .
                OPTIONAL { $this effortless-ntwf:roleAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:role ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_AssignmentValidFrom" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assignmentValidFrom ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentInstantChecks .
                OPTIONAL { $this effortless-ntwf:roleAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:validFrom ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_AssignmentValidTo" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assignmentValidTo ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentInstantChecks .
                OPTIONAL { $this effortless-ntwf:roleAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:validTo ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_AssignmentAgent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assignmentAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentInstantChecks .
                OPTIONAL { $this effortless-ntwf:roleAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_AssignmentAgentVersion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:assignmentAgentVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentInstantChecks .
                OPTIONAL { $this effortless-ntwf:roleAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:agentVersionKey ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentInstantChecks_HeldStepAtInstant" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:heldStepAtInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentInstantChecks .
    OPTIONAL { $this effortless-ntwf:assignmentRole ?assignment_role . }
    OPTIONAL { $this effortless-ntwf:assignmentValidFrom ?assignment_valid_from . }
    OPTIONAL { $this effortless-ntwf:assignmentValidTo ?assignment_valid_to . OPTIONAL { ?assignment_valid_to effortless-ntwf:__key ?assignment_valid_to__key . } }
    OPTIONAL { $this effortless-ntwf:auditInstant ?audit_instant . }
    OPTIONAL { $this effortless-ntwf:stepRole ?step_role . }
                BIND((COALESCE(COALESCE((?assignment_role = ?step_role), ((!BOUND(?assignment_role) || STR(?assignment_role) = "") && (!BOUND(?step_role) || STR(?step_role) = ""))), false) && COALESCE(COALESCE((?assignment_valid_from <= ?audit_instant), ((!BOUND(?assignment_valid_from) || STR(?assignment_valid_from) = "") && (!BOUND(?audit_instant) || STR(?audit_instant) = ""))), false) && COALESCE((COALESCE((COALESCE(?assignment_valid_to__key, COALESCE(IF(isIRI(?assignment_valid_to), REPLACE(STR(?assignment_valid_to), "^.*[#/]", ""), STR(?assignment_valid_to)), "")) = ""), false) || COALESCE(COALESCE((?assignment_valid_to > ?audit_instant), false), false)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AssignmentRoutedNotices ===
effortless-ntwf:AssignmentRoutedNoticesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AssignmentRoutedNotices ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentRoutedNotices .
    OPTIONAL { $this effortless-ntwf:noticeStep ?notice_step . OPTIONAL { ?notice_step effortless-ntwf:__key ?notice_step__key . } }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . OPTIONAL { ?procedure_execution effortless-ntwf:__key ?procedure_execution__key . } }
    OPTIONAL { $this effortless-ntwf:routedToAgent ?routed_to_agent . OPTIONAL { ?routed_to_agent effortless-ntwf:__key ?routed_to_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?procedure_execution__key, IF(isIRI(?procedure_execution), REPLACE(STR(?procedure_execution), "^.*[#/]", ""), STR(?procedure_execution))), ""), " / ", COALESCE(COALESCE(?notice_step__key, IF(isIRI(?notice_step), REPLACE(STR(?notice_step), "^.*[#/]", ""), STR(?notice_step))), ""), " -> ", COALESCE(COALESCE(?routed_to_agent__key, IF(isIRI(?routed_to_agent), REPLACE(STR(?routed_to_agent), "^.*[#/]", ""), STR(?routed_to_agent))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_NoticeRole" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:noticeRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentRoutedNotices .
                OPTIONAL { $this effortless-ntwf:noticeStep ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:assignedRole ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RecipientRoleKey" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientRoleKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentRoutedNotices .
    OPTIONAL { $this effortless-ntwf:noticeRole ?notice_role . OPTIONAL { ?notice_role effortless-ntwf:__key ?notice_role__key . } }
    OPTIONAL { $this effortless-ntwf:routedToAgent ?routed_to_agent . OPTIONAL { ?routed_to_agent effortless-ntwf:__key ?routed_to_agent__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?routed_to_agent__key, IF(isIRI(?routed_to_agent), REPLACE(STR(?routed_to_agent), "^.*[#/]", ""), STR(?routed_to_agent))), ""), "|", COALESCE(COALESCE(?notice_role__key, IF(isIRI(?notice_role), REPLACE(STR(?notice_role), "^.*[#/]", ""), STR(?notice_role))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RecipientPairAssignmentCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientPairAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentRoutedNotices .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:agentRolePairKey ?backfk .
                    $this effortless-ntwf:recipientRoleKey ?backpv .
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RecipientValidFrom" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientValidFrom ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentRoutedNotices .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:agentRolePairKey ?backfk .
                    $this effortless-ntwf:recipientRoleKey ?backpv .
                    OPTIONAL { ?child effortless-ntwf:validFrom ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RecipientLatestValidTo" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientLatestValidTo ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentRoutedNotices .
                {
                    SELECT (MAX(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:agentRolePairKey ?backfk .
                    $this effortless-ntwf:recipientRoleKey ?backpv .
                    OPTIONAL { ?child effortless-ntwf:validTo ?sumraw . }
                    BIND(?sumraw AS ?sumval)
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RecipientOpenEndedCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientOpenEndedCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentRoutedNotices .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:agentRolePairKey ?backfk .
                    $this effortless-ntwf:recipientRoleKey ?backpv .
                    OPTIONAL { ?child effortless-ntwf:isOpenEnded ?c2 . }
                    FILTER(REPLACE(STR(?backfk), "^.*[#/]", "") = REPLACE(STR(?backpv), "^.*[#/]", ""))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RecipientHeldRoleWhenSent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:recipientHeldRoleWhenSent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentRoutedNotices .
    OPTIONAL { $this effortless-ntwf:recipientLatestValidTo ?recipient_latest_valid_to . }
    OPTIONAL { $this effortless-ntwf:recipientOpenEndedCount ?recipient_open_ended_count . }
    OPTIONAL { $this effortless-ntwf:recipientPairAssignmentCount ?recipient_pair_assignment_count . }
    OPTIONAL { $this effortless-ntwf:recipientValidFrom ?recipient_valid_from . }
    OPTIONAL { $this effortless-ntwf:routedToAgent ?routed_to_agent . OPTIONAL { ?routed_to_agent effortless-ntwf:__key ?routed_to_agent__key . } }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND((COALESCE((COALESCE(?routed_to_agent__key, COALESCE(IF(isIRI(?routed_to_agent), REPLACE(STR(?routed_to_agent), "^.*[#/]", ""), STR(?routed_to_agent)), "")) != ""), false) && COALESCE((COALESCE(?recipient_pair_assignment_count, 0) > 0), false) && COALESCE(COALESCE((?recipient_valid_from <= ?sent_at), ((!BOUND(?recipient_valid_from) || STR(?recipient_valid_from) = "") && (!BOUND(?sent_at) || STR(?sent_at) = ""))), false) && COALESCE((COALESCE((COALESCE(?recipient_open_ended_count, 0) > 0), false) || COALESCE(COALESCE((?recipient_latest_valid_to > ?sent_at), false), false)), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_ReachedWrongPersonOrNobody" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:reachedWrongPersonOrNobody ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentRoutedNotices .
    OPTIONAL { $this effortless-ntwf:recipientHeldRoleWhenSent ?recipient_held_role_when_sent . }
                BIND((!(COALESCE(?recipient_held_role_when_sent, false))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentRoutedNotices_RoutedAroundModel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:routedAroundModel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentRoutedNotices .
    OPTIONAL { $this effortless-ntwf:recipientHeldRoleWhenSent ?recipient_held_role_when_sent . }
    OPTIONAL { $this effortless-ntwf:routingSource ?routing_source . OPTIONAL { ?routing_source effortless-ntwf:__key ?routing_source__key . } }
                BIND((COALESCE((COALESCE(?routing_source__key, COALESCE(IF(isIRI(?routing_source), REPLACE(STR(?routing_source), "^.*[#/]", ""), STR(?routing_source)), "")) != "RoleAssignments"), false) && COALESCE((!(COALESCE(?recipient_held_role_when_sent, false))), false)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AssignmentUpdatePolicies ===
effortless-ntwf:AssignmentUpdatePoliciesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AssignmentUpdatePolicies ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssignmentUpdatePolicies_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssignmentUpdatePolicies .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AssistantAnswers ===
effortless-ntwf:AssistantAnswersShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AssistantAnswers ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantAnswers .
    OPTIONAL { $this effortless-ntwf:answeringAgent ?answering_agent . OPTIONAL { ?answering_agent effortless-ntwf:__key ?answering_agent__key . } }
    OPTIONAL { $this effortless-ntwf:questionText ?question_text . }
                BIND(CONCAT(COALESCE(COALESCE(?answering_agent__key, IF(isIRI(?answering_agent), REPLACE(STR(?answering_agent), "^.*[#/]", ""), STR(?answering_agent))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?question_text), 1, 50)), REPLACE(STR(SUBSTR(STR(?question_text), 1, 50)), "^.*[#/]", ""), STR(SUBSTR(STR(?question_text), 1, 50))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_GroundingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:groundingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantAnswers .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AnswerGroundings .
                    ?child effortless-ntwf:assistantAnswer $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_OwnKnowledgeGroundingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ownKnowledgeGroundingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantAnswers .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AnswerGroundings .
                    ?child effortless-ntwf:assistantAnswer $this .
                    OPTIONAL { ?child effortless-ntwf:isFromOwnKnowledge ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_CitedGroundingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:citedGroundingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantAnswers .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AnswerGroundings .
                    ?child effortless-ntwf:assistantAnswer $this .
                    OPTIONAL { ?child effortless-ntwf:citedToUser ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_StaleGroundingCount" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:staleGroundingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantAnswers .
                {
                    SELECT (COUNT(?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AnswerGroundings .
                    ?child effortless-ntwf:assistantAnswer $this .
                    OPTIONAL { ?child effortless-ntwf:groundsOnStaleAssertion ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_IsNotFromOwnKnowledge" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isNotFromOwnKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantAnswers .
    OPTIONAL { $this effortless-ntwf:deliveryDisposition ?delivery_disposition . OPTIONAL { ?delivery_disposition effortless-ntwf:__key ?delivery_disposition__key . } }
    OPTIONAL { $this effortless-ntwf:ownKnowledgeGroundingCount ?own_knowledge_grounding_count . }
                BIND((COALESCE((COALESCE(?delivery_disposition__key, COALESCE(IF(isIRI(?delivery_disposition), REPLACE(STR(?delivery_disposition), "^.*[#/]", ""), STR(?delivery_disposition)), "")) = "Delivered"), false) && COALESCE((COALESCE(?own_knowledge_grounding_count, 0) = 0), false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AssistantAnswers_IsUntraceableToSource" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isUntraceableToSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AssistantAnswers .
    OPTIONAL { $this effortless-ntwf:citedGroundingCount ?cited_grounding_count . }
    OPTIONAL { $this effortless-ntwf:deliveryDisposition ?delivery_disposition . OPTIONAL { ?delivery_disposition effortless-ntwf:__key ?delivery_disposition__key . } }
    OPTIONAL { $this effortless-ntwf:groundingCount ?grounding_count . }
