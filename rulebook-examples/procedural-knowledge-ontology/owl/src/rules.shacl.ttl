            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:hasRenderedBody ?has_rendered_body . }
    OPTIONAL { $this effortless-ntwf:isEvidenceRequired ?is_evidence_required . }
                BIND((?is_evidence_required && (!(?has_rendered_body))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
