    OPTIONAL { $this effortless-ntwf:hasOptOutPhrase ?has_opt_out_phrase . }
    OPTIONAL { $this effortless-ntwf:optOutPhrasePosition ?opt_out_phrase_position . }
    OPTIONAL { $this effortless-ntwf:policyMaxMessageLengthAtSend ?policy_max_message_length_at_send . }
                BIND((?has_opt_out_phrase && (?opt_out_phrase_position <= ?policy_max_message_length_at_send)) AS ?_result)
