                OPTIONAL { ?j1 a effortless-ntwf:Exceptions ; effortless-ntwf:exceptionId ?j2 ; effortless-ntwf:condition ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
