        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isMyDecidedButUnlanded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isImplemented ?is_implemented . }
    OPTIONAL { $this effortless-ntwf:isMyDecidedRequest ?is_my_decided_request . }
                BIND((?is_my_decided_request && (!(?is_implemented))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_DecisionLatencyDays" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
