    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:awaitsAuthorityDecision ?awaits_authority_decision . }
    OPTIONAL { $this effortless-ntwf:touchesLiveVersion ?touches_live_version . }
                BIND((?awaits_authority_decision && ?touches_live_version) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_BlocksAnOpenGap" ;
