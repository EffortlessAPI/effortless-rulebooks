    OPTIONAL { $this effortless-ntwf:requestedAt ?requested_at . }
                BIND(IF(isNumeric(IF(COALESCE(?is_decided, false), ((DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)))), ROUND(IF(COALESCE(?is_decided, false), ((DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)))), IF(COALESCE(?is_decided, false), ((DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsStillPending" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isStillPending ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isDecided ?is_decided . }
    OPTIONAL { $this effortless-ntwf:isOpen ?is_open . }
                BIND((?is_open && (!(?is_decided))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsStalled" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isStalled ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:daysPending ?days_pending . }
    OPTIONAL { $this effortless-ntwf:isStillPending ?is_still_pending . }
                BIND((?is_still_pending && (?days_pending > 14)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_AuthorityAgent" ;
