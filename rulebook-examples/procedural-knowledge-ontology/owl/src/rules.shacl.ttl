    OPTIONAL { $this effortless-ntwf:learnerAgent ?learner_agent . }
    OPTIONAL { $this effortless-ntwf:mentorAgent ?mentor_agent . }
                BIND(CONCAT(COALESCE(IF(isIRI(?mentor_agent), REPLACE(STR(?mentor_agent), "^.*[#/]", ""), IF(DATATYPE(?mentor_agent) = xsd:dateTime, CONCAT(SUBSTR(STR(?mentor_agent), 1, 10), " ", SUBSTR(STR(?mentor_agent), 12, 8), IF(TZ(?mentor_agent) = "Z", "+00", IF(STRENDS(TZ(?mentor_agent), ":00"), SUBSTR(TZ(?mentor_agent), 1, 3), TZ(?mentor_agent)))), STR(?mentor_agent))), ""), " -> ", COALESCE(IF(isIRI(?learner_agent), REPLACE(STR(?learner_agent), "^.*[#/]", ""), IF(DATATYPE(?learner_agent) = xsd:dateTime, CONCAT(SUBSTR(STR(?learner_agent), 1, 10), " ", SUBSTR(STR(?learner_agent), 12, 8), IF(TZ(?learner_agent) = "Z", "+00", IF(STRENDS(TZ(?learner_agent), ":00"), SUBSTR(TZ(?learner_agent), 1, 3), TZ(?learner_agent)))), STR(?learner_agent))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for MessageDeliveries ===
effortless-ntwf:MessageDeliveriesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:MessageDeliveries ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . }
    OPTIONAL { $this effortless-ntwf:recipient ?recipient . }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND(CONCAT(COALESCE(IF(isIRI(?recipient), REPLACE(STR(?recipient), "^.*[#/]", ""), IF(DATATYPE(?recipient) = xsd:dateTime, CONCAT(SUBSTR(STR(?recipient), 1, 10), " ", SUBSTR(STR(?recipient), 12, 8), IF(TZ(?recipient) = "Z", "+00", IF(STRENDS(TZ(?recipient), ":00"), SUBSTR(TZ(?recipient), 1, 3), TZ(?recipient)))), STR(?recipient))), ""), " / ", COALESCE(IF(isIRI(?message_template), REPLACE(STR(?message_template), "^.*[#/]", ""), IF(DATATYPE(?message_template) = xsd:dateTime, CONCAT(SUBSTR(STR(?message_template), 1, 10), " ", SUBSTR(STR(?message_template), 12, 8), IF(TZ(?message_template) = "Z", "+00", IF(STRENDS(TZ(?message_template), ":00"), SUBSTR(TZ(?message_template), 1, 3), TZ(?message_template)))), STR(?message_template))), ""), " / ", COALESCE(IF(isIRI(?sent_at), REPLACE(STR(?sent_at), "^.*[#/]", ""), IF(DATATYPE(?sent_at) = xsd:dateTime, CONCAT(SUBSTR(STR(?sent_at), 1, 10), " ", SUBSTR(STR(?sent_at), 12, 8), IF(TZ(?sent_at) = "Z", "+00", IF(STRENDS(TZ(?sent_at), ":00"), SUBSTR(TZ(?sent_at), 1, 3), TZ(?sent_at)))), STR(?sent_at))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyChannel" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:policyChannel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 ; effortless-ntwf:communicationPolicy ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_ChannelName" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:channelName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:policyChannel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:channel ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyRequiresConsent" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:policyRequiresConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:policyChannel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:consentRequired ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_RecipientHasSmsConsent" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:recipientHasSmsConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 ; effortless-ntwf:hasSmsConsent ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_WasActuallyTransmitted" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:wasActuallyTransmitted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:deliveryStatus ?delivery_status . }
                BIND(((REPLACE(COALESCE(STR(?delivery_status), ""), "^.*#", "") = "Sent") || ((REPLACE(COALESCE(STR(?delivery_status), ""), "^.*#", "") = "Delivered") || (REPLACE(COALESCE(STR(?delivery_status), ""), "^.*#", "") = "Bounced"))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsConsentViolation" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isConsentViolation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyRequiresConsent ?policy_requires_consent . }
    OPTIONAL { $this effortless-ntwf:recipientHasSmsConsent ?recipient_has_sms_consent . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((?was_actually_transmitted && (?policy_requires_consent && (!(?recipient_has_sms_consent)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_ConsentViolationPolicyKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
