            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_IsFresh" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isFresh ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:ageMinutes ?age_minutes . }
    OPTIONAL { $this effortless-ntwf:freshnessSlaMinutes ?freshness_sla_minutes . }
                BIND((?age_minutes <= ?freshness_sla_minutes) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_StaleBindingStepKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:staleBindingStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isFresh ?is_fresh . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE((!(?is_fresh)), false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_AuthoritativeStaleStepKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:authoritativeStaleStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isAuthoritative ?is_authoritative . }
    OPTIONAL { $this effortless-ntwf:isFresh ?is_fresh . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(((!(?is_fresh)) && COALESCE(?is_authoritative, false)), false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_IsStaleAndAuthoritative" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isStaleAndAuthoritative ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isAuthoritative ?is_authoritative . }
    OPTIONAL { $this effortless-ntwf:isFresh ?is_fresh . }
                BIND((COALESCE(?is_authoritative, false) && (!(?is_fresh))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_StepWhenStale" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepWhenStale ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isStaleAndAuthoritative ?is_stale_and_authoritative . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_stale_and_authoritative, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_ResourceIsApproved" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:resourceIsApproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
                OPTIONAL { $this effortless-ntwf:resource ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Resources ; effortless-ntwf:resourceId ?j2 ; effortless-ntwf:isApprovedSource ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_IsUsableForDrafting" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUsableForDrafting ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isFresh ?is_fresh . }
    OPTIONAL { $this effortless-ntwf:resourceIsApproved ?resource_is_approved . }
                BIND((?resource_is_approved && ?is_fresh) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OperationalBindings_StepWhenUnusable" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepWhenUnusable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OperationalBindings .
    OPTIONAL { $this effortless-ntwf:isUsableForDrafting ?is_usable_for_drafting . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_usable_for_drafting, false), "", ?step) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Organizations ===
effortless-ntwf:OrganizationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Organizations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Organizations_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Organizations .
    OPTIONAL { $this effortless-ntwf:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for PrincipalAssignments ===
effortless-ntwf:PrincipalAssignmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:PrincipalAssignments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
    OPTIONAL { $this effortless-ntwf:appUser ?app_user . }
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
                BIND(CONCAT(COALESCE(IF(isIRI(?app_user), REPLACE(STR(?app_user), "^.*[#/]", ""), IF(DATATYPE(?app_user) = xsd:dateTime, CONCAT(SUBSTR(STR(?app_user), 1, 10), " ", SUBSTR(STR(?app_user), 12, 8), IF(TZ(?app_user) = "Z", "+00", IF(STRENDS(TZ(?app_user), ":00"), SUBSTR(TZ(?app_user), 1, 3), TZ(?app_user)))), STR(?app_user))), ""), " as ", COALESCE(IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), IF(DATATYPE(?principal) = xsd:dateTime, CONCAT(SUBSTR(STR(?principal), 1, 10), " ", SUBSTR(STR(?principal), 12, 8), IF(TZ(?principal) = "Z", "+00", IF(STRENDS(TZ(?principal), ":00"), SUBSTR(TZ(?principal), 1, 3), TZ(?principal)))), STR(?principal))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_PrincipalIsAdmin" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:principalIsAdmin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
                OPTIONAL { $this effortless-ntwf:principal ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AccessPrincipals ; effortless-ntwf:accessPrincipalId ?j2 ; effortless-ntwf:isAdministrator ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_UserOrganization" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:userOrganization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
                OPTIONAL { $this effortless-ntwf:appUser ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AppUsers ; effortless-ntwf:appUserId ?j2 ; effortless-ntwf:organization ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_PrincipalOrganization" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:principalOrganization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
                OPTIONAL { $this effortless-ntwf:principal ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AccessPrincipals ; effortless-ntwf:accessPrincipalId ?j2 ; effortless-ntwf:organizationScope ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PrincipalAssignments_IsCrossOrganizationGrant" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isCrossOrganizationGrant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PrincipalAssignments .
    OPTIONAL { $this effortless-ntwf:principalOrganization ?principal_organization . }
    OPTIONAL { $this effortless-ntwf:userOrganization ?user_organization . }
                BIND(((REPLACE(COALESCE(STR(?user_organization), ""), "^.*#", "") != "") && (REPLACE(COALESCE(STR(?principal_organization), ""), "^.*#", "") != "") && (?user_organization != ?principal_organization)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureExecutions ===
effortless-ntwf:ProcedureExecutionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureExecutions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:context ?context . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(CONCAT(COALESCE(IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), IF(DATATYPE(?procedure_version) = xsd:dateTime, CONCAT(SUBSTR(STR(?procedure_version), 1, 10), " ", SUBSTR(STR(?procedure_version), 12, 8), IF(TZ(?procedure_version) = "Z", "+00", IF(STRENDS(TZ(?procedure_version), ":00"), SUBSTR(TZ(?procedure_version), 1, 3), TZ(?procedure_version)))), STR(?procedure_version))), ""), " / ", COALESCE(IF(isIRI(?context), REPLACE(STR(?context), "^.*[#/]", ""), IF(DATATYPE(?context) = xsd:dateTime, CONCAT(SUBSTR(STR(?context), 1, 10), " ", SUBSTR(STR(?context), 12, 8), IF(TZ(?context) = "Z", "+00", IF(STRENDS(TZ(?context), ":00"), SUBSTR(TZ(?context), 1, 3), TZ(?context)))), STR(?context))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ExpectedStepCount" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:expectedStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 ; effortless-ntwf:specifiedStepCount ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_CompletedStepCount" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:completedStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    $this effortless-ntwf:procedureExecutionId ?p0 .
                    ?child effortless-ntwf:completedExecutionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ControlBreachCount" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:controlBreachCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    $this effortless-ntwf:procedureExecutionId ?p0 .
                    ?child effortless-ntwf:controlBreachExecutionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_LateStepCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:lateStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    $this effortless-ntwf:procedureExecutionId ?p0 .
                    ?child effortless-ntwf:lateExecutionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_IsStructurallyComplete" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isStructurallyComplete ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:completedStepCount ?completed_step_count . }
    OPTIONAL { $this effortless-ntwf:expectedStepCount ?expected_step_count . }
                BIND((?completed_step_count >= ?expected_step_count) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_DivergedFromSpecification" ;
        sh:order 8 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:divergedFromSpecification ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:controlBreachCount ?control_breach_count . }
    OPTIONAL { $this effortless-ntwf:isStructurallyComplete ?is_structurally_complete . }
                BIND(((!(?is_structurally_complete)) || (?control_breach_count > 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AllBlockingControlsEvaluated" ;
        sh:order 8 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:allBlockingControlsEvaluated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:unevaluatedBlockingTotal ?unevaluated_blocking_total . }
                BIND((?unevaluated_blocking_total = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_UnevaluatedBlockingTotal" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unevaluatedBlockingTotal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    $this effortless-ntwf:procedureExecutionId ?p0 .
                    ?child effortless-ntwf:unevaluatedBlockingExecutionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SeparationOfDutiesHeld" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:separationOfDutiesHeld ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:separationViolationCount ?separation_violation_count . }
                BIND((?separation_violation_count = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SeparationViolationCount" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:separationViolationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    $this effortless-ntwf:procedureExecutionId ?p0 .
                    ?child effortless-ntwf:separationViolationExecutionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_IsAttestationReady" ;
        sh:order 9 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isAttestationReady ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:allBlockingControlsEvaluated ?all_blocking_controls_evaluated . }
    OPTIONAL { $this effortless-ntwf:divergedFromSpecification ?diverged_from_specification . }
    OPTIONAL { $this effortless-ntwf:isStructurallyComplete ?is_structurally_complete . }
    OPTIONAL { $this effortless-ntwf:separationOfDutiesHeld ?separation_of_duties_held . }
                BIND((?is_structurally_complete && (!(?diverged_from_specification)) && ?all_blocking_controls_evaluated && ?separation_of_duties_held) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AttestationBlockerSummary" ;
        sh:order 10 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:attestationBlockerSummary ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:isAttestationReady ?is_attestation_ready . }
    OPTIONAL { $this effortless-ntwf:isStructurallyComplete ?is_structurally_complete . }
    OPTIONAL { $this effortless-ntwf:separationViolationCount ?separation_violation_count . }
    OPTIONAL { $this effortless-ntwf:unevaluatedBlockingTotal ?unevaluated_blocking_total . }
                BIND(IF(COALESCE(?is_attestation_ready, false), "", IF(COALESCE((!(?is_structurally_complete)), false), "Incomplete: specified steps did not all complete.", IF(COALESCE((?separation_violation_count > 0), false), "Segregation of duties violated.", IF(COALESCE((?unevaluated_blocking_total > 0), false), "Blocking controls were never evaluated.", "Control breach recorded on one or more steps.")))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_ExecutedVersionIsFit" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:executedVersionIsFit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 ; effortless-ntwf:isFitToExecute ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_SignedAgainstUnfitVersion" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:signedAgainstUnfitVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureExecutions .
    OPTIONAL { $this effortless-ntwf:executedVersionIsFit ?executed_version_is_fit . }
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . }
                BIND(((REPLACE(COALESCE(STR(?execution_status), ""), "^.*#", "") = "Completed") && (!(?executed_version_is_fit))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureExecutions_AssertedOnlyControlCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
