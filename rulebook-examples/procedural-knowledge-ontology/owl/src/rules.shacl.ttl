    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:renderedBody ?rendered_body . }
                BIND(IF(isNumeric(IF(STR(?rendered_body) = "", ?__null, STRLEN(STR(?rendered_body)))), ROUND(IF(STR(?rendered_body) = "", ?__null, STRLEN(STR(?rendered_body)))), IF(STR(?rendered_body) = "", ?__null, STRLEN(STR(?rendered_body)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyMaxMessageLengthAtSend" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
