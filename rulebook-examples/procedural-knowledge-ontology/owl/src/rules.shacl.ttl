# === Shape with rules for FieldGrants ===
effortless-ntwf:FieldGrantsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FieldGrants ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
    OPTIONAL { $this effortless-ntwf:targetField ?target_field . }
                BIND(CONCAT(COALESCE(IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), IF(DATATYPE(?principal) = xsd:dateTime, CONCAT(SUBSTR(STR(?principal), 1, 10), " ", SUBSTR(STR(?principal), 12, 8), IF(TZ(?principal) = "Z", "+00", IF(STRENDS(TZ(?principal), ":00"), SUBSTR(TZ(?principal), 1, 3), TZ(?principal)))), STR(?principal))), ""), " -> ", COALESCE(IF(isIRI(?target_field), REPLACE(STR(?target_field), "^.*[#/]", ""), IF(DATATYPE(?target_field) = xsd:dateTime, CONCAT(SUBSTR(STR(?target_field), 1, 10), " ", SUBSTR(STR(?target_field), 12, 8), IF(TZ(?target_field) = "Z", "+00", IF(STRENDS(TZ(?target_field), ":00"), SUBSTR(TZ(?target_field), 1, 3), TZ(?target_field)))), STR(?target_field))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_FieldTable" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:fieldTable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
                OPTIONAL { $this effortless-ntwf:targetField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 ; effortless-ntwf:targetTable ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_FieldName" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:fieldName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
                OPTIONAL { $this effortless-ntwf:targetField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 ; effortless-ntwf:fieldName ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_FieldIsDerived" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:fieldIsDerived ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
                OPTIONAL { $this effortless-ntwf:targetField ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 ; effortless-ntwf:isDerived ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_IsWritableDerivedField" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isWritableDerivedField ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
    OPTIONAL { $this effortless-ntwf:canWrite ?can_write . }
    OPTIONAL { $this effortless-ntwf:fieldIsDerived ?field_is_derived . }
                BIND((COALESCE(?can_write, false) && ?field_is_derived) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_IsMasked" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isMasked ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
    OPTIONAL { $this effortless-ntwf:maskStrategy ?mask_strategy . }
                BIND(((REPLACE(COALESCE(STR(?mask_strategy), ""), "^.*#", "") != "plain") && (REPLACE(COALESCE(STR(?mask_strategy), ""), "^.*#", "") != "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FieldGrants_GrantKeyWhenReadable" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:grantKeyWhenReadable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FieldGrants .
    OPTIONAL { $this effortless-ntwf:canRead ?can_read . }
    OPTIONAL { $this effortless-ntwf:fieldTable ?field_table . }
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
                BIND(IF(COALESCE(?can_read, false), CONCAT(COALESCE(IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), IF(DATATYPE(?principal) = xsd:dateTime, CONCAT(SUBSTR(STR(?principal), 1, 10), " ", SUBSTR(STR(?principal), 12, 8), IF(TZ(?principal) = "Z", "+00", IF(STRENDS(TZ(?principal), ":00"), SUBSTR(TZ(?principal), 1, 3), TZ(?principal)))), STR(?principal))), ""), "|", COALESCE(IF(isIRI(?field_table), REPLACE(STR(?field_table), "^.*[#/]", ""), IF(DATATYPE(?field_table) = xsd:dateTime, CONCAT(SUBSTR(STR(?field_table), 1, 10), " ", SUBSTR(STR(?field_table), 12, 8), IF(TZ(?field_table) = "Z", "+00", IF(STRENDS(TZ(?field_table), ":00"), SUBSTR(TZ(?field_table), 1, 3), TZ(?field_table)))), STR(?field_table))), "")), "") AS ?_result)
            }
        """ ;
    ] .

