        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ranUnderException ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:exceptionInvocationCount ?exception_invocation_count . }
                BIND((?exception_invocation_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsCompleted" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isCompleted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . }
                BIND((REPLACE(COALESCE(STR(?execution_status), ""), "^.*#", "") = "Completed") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsVerificationPassed" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isVerificationPassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:verificationResult ?verification_result . }
                BIND((REPLACE(COALESCE(STR(?verification_result), ""), "^.*#", "") = "PASS") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsLegalReviewStep" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isLegalReviewStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND((REPLACE(COALESCE(STR(?step), ""), "^.*#", "") = "policy-04") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ClearedLegalReviewKey" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:clearedLegalReviewKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:isLegalReviewStep ?is_legal_review_step . }
    OPTIONAL { $this effortless-ntwf:isVerificationPassed ?is_verification_passed . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE((?is_legal_review_step && ?is_verification_passed), false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_AssignedRole" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:assignedRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:assignedRole ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_RoleCurrentAgent" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:roleCurrentAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:assignedRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 ; effortless-ntwf:currentAgent ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExecutorIsDesignatedAgent" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:executorIsDesignatedAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executedByAgent ?executed_by_agent . }
    OPTIONAL { $this effortless-ntwf:roleCurrentAgent ?role_current_agent . }
                BIND((?executed_by_agent = ?role_current_agent) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_InputsWereFreshAtRun" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:inputsWereFreshAtRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:inputsAreFresh ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_RanOnStaleInputs" ;
        sh:order 8 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ranOnStaleInputs ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . }
    OPTIONAL { $this effortless-ntwf:inputsWereFreshAtRun ?inputs_were_fresh_at_run . }
                BIND(((REPLACE(COALESCE(STR(?execution_status), ""), "^.*#", "") = "Completed") && (!(?inputs_were_fresh_at_run))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_UnresolvedIssueCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unresolvedIssueCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:IssueOccurrences .
                    $this effortless-ntwf:stepExecutionId ?p0 .
                    ?child effortless-ntwf:stepExecutionWhenUnresolved ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasDeviation" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasDeviation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:deviation ?deviation . }
                BIND((REPLACE(COALESCE(STR(?deviation), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsClean" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isClean ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:hasDeviation ?has_deviation . }
    OPTIONAL { $this effortless-ntwf:isLate ?is_late . }
    OPTIONAL { $this effortless-ntwf:unresolvedIssueCount ?unresolved_issue_count . }
    OPTIONAL { $this effortless-ntwf:verificationResult ?verification_result . }
                BIND(((REPLACE(COALESCE(STR(?verification_result), ""), "^.*#", "") = "PASS") && (!(?has_deviation)) && (?unresolved_issue_count = 0) && (!(?is_late))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ProcedureExecutionWhenUnclean" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:procedureExecutionWhenUnclean ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:isClean ?is_clean . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?is_clean, false), "", ?procedure_execution) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_EvaluatedRequirementCount" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:evaluatedRequirementCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    $this effortless-ntwf:stepExecutionId ?p0 .
                    ?child effortless-ntwf:stepExecutionWhenScored ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_RequiredBlockingCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:requiredBlockingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:blockingRequirementCount ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasUnevaluatedBlockingRequirement" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasUnevaluatedBlockingRequirement ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:evaluatedRequirementCount ?evaluated_requirement_count . }
    OPTIONAL { $this effortless-ntwf:requiredBlockingCount ?required_blocking_count . }
                BIND((?evaluated_requirement_count < ?required_blocking_count) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExecutingAgentKind" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:executingAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:executedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:agentKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_WasExecutedBySoftware" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:wasExecutedBySoftware ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executingAgentKind ?executing_agent_kind . }
                BIND(((REPLACE(COALESCE(STR(?executing_agent_kind), ""), "^.*#", "") = "AIAgent") || (REPLACE(COALESCE(STR(?executing_agent_kind), ""), "^.*#", "") = "AutomatedPipeline")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_StepIsSoftwareAssigned" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepIsSoftwareAssigned ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:isSoftwareAssigned ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_SoftwareDidHumanWork" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:softwareDidHumanWork ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:stepIsSoftwareAssigned ?step_is_software_assigned . }
    OPTIONAL { $this effortless-ntwf:wasExecutedBySoftware ?was_executed_by_software . }
                BIND((?was_executed_by_software && (!(?step_is_software_assigned))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsApprovalExecution" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isApprovalExecution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:isHumanApprovalGate ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsVerified" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isVerified ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:verificationResult ?verification_result . }
                BIND(((REPLACE(COALESCE(STR(?verification_result), ""), "^.*#", "") != "") && (REPLACE(COALESCE(STR(?verification_result), ""), "^.*#", "") != "PENDING") && (REPLACE(COALESCE(STR(?verification_result), ""), "^.*#", "") != "FAIL")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_UnconfirmedNonHumanDecisionCount" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unconfirmedNonHumanDecisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    $this effortless-ntwf:stepExecutionId ?p0 .
                    ?child effortless-ntwf:stepExecutionWhenUnconfirmed ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_RequiresHumanConfirmation" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:requiresHumanConfirmation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:requiresHumanConfirmation ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HumanConfirmationMissing" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:humanConfirmationMissing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:requiresHumanConfirmation ?requires_human_confirmation . }
    OPTIONAL { $this effortless-ntwf:unconfirmedNonHumanDecisionCount ?unconfirmed_non_human_decision_count . }
                BIND((?requires_human_confirmation && (?unconfirmed_non_human_decision_count > 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_DraftedFromUnusableSource" ;
        sh:order 8 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:draftedFromUnusableSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . }
    OPTIONAL { $this effortless-ntwf:inputsWereUsable ?inputs_were_usable . }
                BIND(((REPLACE(COALESCE(STR(?execution_status), ""), "^.*#", "") = "Completed") && (!(?inputs_were_usable))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_InputsWereUsable" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:inputsWereUsable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:allSourcesUsable ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_SoftwareExecutionStepKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:softwareExecutionStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:step ?step . }
    OPTIONAL { $this effortless-ntwf:wasExecutedBySoftware ?was_executed_by_software . }
                BIND(IF(COALESCE(?was_executed_by_software, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_StepControlKind" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepControlKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:controlKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_UnfalsifiedClearanceCount" ;
        sh:order 8 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unfalsifiedClearanceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    $this effortless-ntwf:stepExecutionId ?p0 .
                    ?child effortless-ntwf:unfalsifiedClearanceStepKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_AllClearancesAreUnfalsified" ;
        sh:order 9 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:allClearancesAreUnfalsified ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:evaluatedBlockingCount ?evaluated_blocking_count . }
    OPTIONAL { $this effortless-ntwf:unfalsifiedClearanceCount ?unfalsified_clearance_count . }
                BIND(((?evaluated_blocking_count > 0) && (?unfalsified_clearance_count >= ?evaluated_blocking_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_StaleAtRunCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:staleAtRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:BindingObservations .
                    $this effortless-ntwf:stepExecutionId ?p0 .
                    ?child effortless-ntwf:staleAtRunStepKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_WasStaleWhenIRanIt" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:wasStaleWhenIRanIt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:staleAtRunCount ?stale_at_run_count . }
                BIND((?stale_at_run_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_StalenessAnswerIsTenseDependent" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stalenessAnswerIsTenseDependent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:ranOnStaleAuthoritativeSource ?ran_on_stale_authoritative_source . }
    OPTIONAL { $this effortless-ntwf:wasStaleWhenIRanIt ?was_stale_when_i_ran_it . }
                BIND((!((?was_stale_when_i_ran_it = ?ran_on_stale_authoritative_source))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasAnyDeclaredCheck" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasAnyDeclaredCheck ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:expectedBlockingCount ?expected_blocking_count . }
    OPTIONAL { $this effortless-ntwf:expectedVerificationCount ?expected_verification_count . }
                BIND(((?expected_verification_count > 0) || (?expected_blocking_count > 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_PerformedCheckCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:performedCheckCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:evaluatedBlockingCount ?evaluated_blocking_count . }
    OPTIONAL { $this effortless-ntwf:performedVerificationCount ?performed_verification_count . }
                BIND((?performed_verification_count + ?evaluated_blocking_count) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_DeclaredCheckCount" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:declaredCheckCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:expectedBlockingCount ?expected_blocking_count . }
    OPTIONAL { $this effortless-ntwf:expectedVerificationCount ?expected_verification_count . }
                BIND((?expected_verification_count + ?expected_blocking_count) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsUncheckedByDesign" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUncheckedByDesign ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:declaredCheckCount ?declared_check_count . }
                BIND((?declared_check_count = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsVacuouslyClean" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isVacuouslyClean ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:isClean ?is_clean . }
    OPTIONAL { $this effortless-ntwf:isUncheckedByDesign ?is_unchecked_by_design . }
                BIND((?is_clean && ?is_unchecked_by_design) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsSubstantivelyClean" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isSubstantivelyClean ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:declaredCheckCount ?declared_check_count . }
    OPTIONAL { $this effortless-ntwf:isClean ?is_clean . }
    OPTIONAL { $this effortless-ntwf:performedCheckCount ?performed_check_count . }
                BIND((?is_clean && (?performed_check_count >= ?declared_check_count) && (?declared_check_count > 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_VacuouslyCleanExecutionKey" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:vacuouslyCleanExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:isVacuouslyClean ?is_vacuously_clean . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?is_vacuously_clean, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_UncorroboratedPassCount" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:uncorroboratedPassCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:VerificationOutcomes .
                    $this effortless-ntwf:stepExecutionId ?p0 .
                    ?child effortless-ntwf:uncorroboratedPassStepKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_EvidencePositionIsWeak" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:evidencePositionIsWeak ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:performedVerificationCount ?performed_verification_count . }
    OPTIONAL { $this effortless-ntwf:uncorroboratedPassCount ?uncorroborated_pass_count . }
                BIND(((?performed_verification_count > 0) && (?uncorroborated_pass_count >= ?performed_verification_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_PreparationExecutionKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:preparationExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
    OPTIONAL { $this effortless-ntwf:stepIsPreparation ?step_is_preparation . }
                BIND(IF(COALESCE(?step_is_preparation, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ApprovalExecutionKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:approvalExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
    OPTIONAL { $this effortless-ntwf:stepIsApproval ?step_is_approval . }
                BIND(IF(COALESCE(?step_is_approval, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasGoverningInstrument" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasGoverningInstrument ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:hasApprovedChangeCoverage ?has_approved_change_coverage . }
    OPTIONAL { $this effortless-ntwf:ranUnderException ?ran_under_exception . }
                BIND((?ran_under_exception || ?has_approved_change_coverage) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasApprovedChangeCoverage" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasApprovedChangeCoverage ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:versionOfStep ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 ; effortless-ntwf:hasApprovedChangeRequest ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_VersionOfStep" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:versionOfStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:procedureVersion ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsUngovernedDivergence" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUngovernedDivergence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:hasDeviation ?has_deviation . }
    OPTIONAL { $this effortless-ntwf:hasGoverningInstrument ?has_governing_instrument . }
    OPTIONAL { $this effortless-ntwf:isLate ?is_late . }
    OPTIONAL { $this effortless-ntwf:proceededPastBlockingControl ?proceeded_past_blocking_control . }
                BIND(((?has_deviation || ?is_late || ?proceeded_past_blocking_control) && (!(?has_governing_instrument))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_UngovernedDivergenceExecutionKey" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ungovernedDivergenceExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:isUngovernedDivergence ?is_ungoverned_divergence . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?is_ungoverned_divergence, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_SelfAttestedApprovalExecutionKey" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:selfAttestedApprovalExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:approvalRestsOnSelfAttestation ?approval_rests_on_self_attestation . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?approval_rests_on_self_attestation, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepFunctions ===
effortless-ntwf:StepFunctionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepFunctions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepFunctions_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepFunctions .
    OPTIONAL { $this effortless-ntwf:function ?function . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(CONCAT(COALESCE(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), IF(DATATYPE(?step) = xsd:dateTime, CONCAT(SUBSTR(STR(?step), 1, 10), " ", SUBSTR(STR(?step), 12, 8), IF(TZ(?step) = "Z", "+00", IF(STRENDS(TZ(?step), ":00"), SUBSTR(TZ(?step), 1, 3), TZ(?step)))), STR(?step))), ""), " / ", COALESCE(IF(isIRI(?function), REPLACE(STR(?function), "^.*[#/]", ""), IF(DATATYPE(?function) = xsd:dateTime, CONCAT(SUBSTR(STR(?function), 1, 10), " ", SUBSTR(STR(?function), 12, 8), IF(TZ(?function) = "Z", "+00", IF(STRENDS(TZ(?function), ":00"), SUBSTR(TZ(?function), 1, 3), TZ(?function)))), STR(?function))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepRequirements ===
effortless-ntwf:StepRequirementsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepRequirements ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:requirement ?requirement . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(CONCAT(COALESCE(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), IF(DATATYPE(?step) = xsd:dateTime, CONCAT(SUBSTR(STR(?step), 1, 10), " ", SUBSTR(STR(?step), 12, 8), IF(TZ(?step) = "Z", "+00", IF(STRENDS(TZ(?step), ":00"), SUBSTR(TZ(?step), 1, 3), TZ(?step)))), STR(?step))), ""), " / ", COALESCE(IF(isIRI(?requirement), REPLACE(STR(?requirement), "^.*[#/]", ""), IF(DATATYPE(?requirement) = xsd:dateTime, CONCAT(SUBSTR(STR(?requirement), 1, 10), " ", SUBSTR(STR(?requirement), 12, 8), IF(TZ(?requirement) = "Z", "+00", IF(STRENDS(TZ(?requirement), ":00"), SUBSTR(TZ(?requirement), 1, 3), TZ(?requirement)))), STR(?requirement))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_RequirementIsBlocking" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:requirementIsBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 ; effortless-ntwf:isBlocking ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_BlockingStepKey" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:blockingStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?requirement_is_blocking, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_StepWhenBlocking" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepWhenBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?requirement_is_blocking, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_RequirementLacksWitness" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:requirementLacksWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 ; effortless-ntwf:isUnwitnessedBlockingControl ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_UnwitnessedStepKey" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unwitnessedStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:requirementLacksWitness ?requirement_lacks_witness . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?requirement_lacks_witness, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_SatisfactionCountForBinding" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:satisfactionCountForBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    $this effortless-ntwf:stepRequirementId ?p0 .
                    ?child effortless-ntwf:bindingKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_BindingWasEverExercised" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:bindingWasEverExercised ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:satisfactionCountForBinding ?satisfaction_count_for_binding . }
                BIND((?satisfaction_count_for_binding > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_IsUnexercisedBlockingBinding" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnexercisedBlockingBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:bindingWasEverExercised ?binding_was_ever_exercised . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
                BIND((?requirement_is_blocking && (!(?binding_was_ever_exercised))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepRequirements_UnexercisedBindingRequirementKey" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unexercisedBindingRequirementKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepRequirements .
    OPTIONAL { $this effortless-ntwf:isUnexercisedBlockingBinding ?is_unexercised_blocking_binding . }
    OPTIONAL { $this effortless-ntwf:requirement ?requirement . }
                BIND(IF(COALESCE(?is_unexercised_blocking_binding, false), ?requirement, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepTools ===
effortless-ntwf:StepToolsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepTools ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTools_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTools .
    OPTIONAL { $this effortless-ntwf:step ?step . }
    OPTIONAL { $this effortless-ntwf:tool ?tool . }
                BIND(CONCAT(COALESCE(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), IF(DATATYPE(?step) = xsd:dateTime, CONCAT(SUBSTR(STR(?step), 1, 10), " ", SUBSTR(STR(?step), 12, 8), IF(TZ(?step) = "Z", "+00", IF(STRENDS(TZ(?step), ":00"), SUBSTR(TZ(?step), 1, 3), TZ(?step)))), STR(?step))), ""), " / ", COALESCE(IF(isIRI(?tool), REPLACE(STR(?tool), "^.*[#/]", ""), IF(DATATYPE(?tool) = xsd:dateTime, CONCAT(SUBSTR(STR(?tool), 1, 10), " ", SUBSTR(STR(?tool), 12, 8), IF(TZ(?tool) = "Z", "+00", IF(STRENDS(TZ(?tool), ":00"), SUBSTR(TZ(?tool), 1, 3), TZ(?tool)))), STR(?tool))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepTransitions ===
effortless-ntwf:StepTransitionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepTransitions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:fromStep ?from_step . }
    OPTIONAL { $this effortless-ntwf:toStep ?to_step . }
                BIND(CONCAT(COALESCE(IF(isIRI(?from_step), REPLACE(STR(?from_step), "^.*[#/]", ""), IF(DATATYPE(?from_step) = xsd:dateTime, CONCAT(SUBSTR(STR(?from_step), 1, 10), " ", SUBSTR(STR(?from_step), 12, 8), IF(TZ(?from_step) = "Z", "+00", IF(STRENDS(TZ(?from_step), ":00"), SUBSTR(TZ(?from_step), 1, 3), TZ(?from_step)))), STR(?from_step))), ""), " -> ", COALESCE(IF(isIRI(?to_step), REPLACE(STR(?to_step), "^.*[#/]", ""), IF(DATATYPE(?to_step) = xsd:dateTime, CONCAT(SUBSTR(STR(?to_step), 1, 10), " ", SUBSTR(STR(?to_step), 12, 8), IF(TZ(?to_step) = "Z", "+00", IF(STRENDS(TZ(?to_step), ":00"), SUBSTR(TZ(?to_step), 1, 3), TZ(?to_step)))), STR(?to_step))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsRecoveryPath" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isRecoveryPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:transitionKind ?transition_kind . }
                BIND(((REPLACE(COALESCE(STR(?transition_kind), ""), "^.*#", "") = "Fallback") || (REPLACE(COALESCE(STR(?transition_kind), ""), "^.*#", "") = "Alternative")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_CountOfFromStepExecutions" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfFromStepExecutions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    $this effortless-ntwf:fromStep ?p0 .
                    ?child effortless-ntwf:step ?c0 .
                    FILTER(IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_CountOfToStepExecutions" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfToStepExecutions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    $this effortless-ntwf:toStep ?p0 .
                    ?child effortless-ntwf:step ?c0 .
                    FILTER(IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_HasReachableOrigin" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasReachableOrigin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:countOfFromStepExecutions ?count_of_from_step_executions . }
                BIND((?count_of_from_step_executions > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_HasReachableTarget" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasReachableTarget ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:countOfToStepExecutions ?count_of_to_step_executions . }
                BIND((?count_of_to_step_executions > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsNeverExercised" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isNeverExercised ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:hasReachableOrigin ?has_reachable_origin . }
    OPTIONAL { $this effortless-ntwf:hasReachableTarget ?has_reachable_target . }
                BIND((!((?has_reachable_origin && ?has_reachable_target))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsUntestedRecoveryPath" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUntestedRecoveryPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:isNeverExercised ?is_never_exercised . }
    OPTIONAL { $this effortless-ntwf:isRecoveryPath ?is_recovery_path . }
                BIND((?is_recovery_path && ?is_never_exercised) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_CountOfObservedTraversals" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfObservedTraversals ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ObservedTransitions .
                    ?child effortless-ntwf:stepTransition $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_HasBeenTraversed" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasBeenTraversed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:countOfObservedTraversals ?count_of_observed_traversals . }
                BIND((?count_of_observed_traversals > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsUnwalkedRecoveryPath" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwalkedRecoveryPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:hasBeenTraversed ?has_been_traversed . }
    OPTIONAL { $this effortless-ntwf:isRecoveryPath ?is_recovery_path . }
                BIND((?is_recovery_path && (!(?has_been_traversed))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_TargetBlockingRequirementCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:targetBlockingRequirementCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
                OPTIONAL { $this effortless-ntwf:toStep ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:blockingRequirementCount ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_TargetCarriesBlockingControl" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:targetCarriesBlockingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:targetBlockingRequirementCount ?target_blocking_requirement_count . }
                BIND((?target_blocking_requirement_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_IsUnrehearsedControlEntry" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnrehearsedControlEntry ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:isUnwalkedRecoveryPath ?is_unwalked_recovery_path . }
    OPTIONAL { $this effortless-ntwf:targetCarriesBlockingControl ?target_carries_blocking_control . }
                BIND((?is_unwalked_recovery_path && ?target_carries_blocking_control) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepTransitions_UnrehearsedControlVersionKey" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unrehearsedControlVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepTransitions .
    OPTIONAL { $this effortless-ntwf:isUnrehearsedControlEntry ?is_unrehearsed_control_entry . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_unrehearsed_control_entry, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for StepVerifications ===
effortless-ntwf:StepVerificationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StepVerifications ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepVerifications_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepVerifications .
    OPTIONAL { $this effortless-ntwf:step ?step . }
    OPTIONAL { $this effortless-ntwf:verificationKind ?verification_kind . }
                BIND(CONCAT(COALESCE(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), IF(DATATYPE(?step) = xsd:dateTime, CONCAT(SUBSTR(STR(?step), 1, 10), " ", SUBSTR(STR(?step), 12, 8), IF(TZ(?step) = "Z", "+00", IF(STRENDS(TZ(?step), ":00"), SUBSTR(TZ(?step), 1, 3), TZ(?step)))), STR(?step))), ""), " / ", COALESCE(IF(isIRI(?verification_kind), REPLACE(STR(?verification_kind), "^.*[#/]", ""), IF(DATATYPE(?verification_kind) = xsd:dateTime, CONCAT(SUBSTR(STR(?verification_kind), 1, 10), " ", SUBSTR(STR(?verification_kind), 12, 8), IF(TZ(?verification_kind) = "Z", "+00", IF(STRENDS(TZ(?verification_kind), ":00"), SUBSTR(TZ(?verification_kind), 1, 3), TZ(?verification_kind)))), STR(?verification_kind))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Steps ===
effortless-ntwf:StepsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Steps ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:stepNumber ?step_number . }
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(CONCAT(COALESCE(IF(isIRI(?step_number), REPLACE(STR(?step_number), "^.*[#/]", ""), IF(DATATYPE(?step_number) = xsd:dateTime, CONCAT(SUBSTR(STR(?step_number), 1, 10), " ", SUBSTR(STR(?step_number), 12, 8), IF(TZ(?step_number) = "Z", "+00", IF(STRENDS(TZ(?step_number), ":00"), SUBSTR(TZ(?step_number), 1, 3), TZ(?step_number)))), STR(?step_number))), ""), ". ", COALESCE(IF(isIRI(?title), REPLACE(STR(?title), "^.*[#/]", ""), IF(DATATYPE(?title) = xsd:dateTime, CONCAT(SUBSTR(STR(?title), 1, 10), " ", SUBSTR(STR(?title), 12, 8), IF(TZ(?title) = "Z", "+00", IF(STRENDS(TZ(?title), ":00"), SUBSTR(TZ(?title), 1, 3), TZ(?title)))), STR(?title))), "")) AS ?_result)
            }
        """ ;
    ] ;
