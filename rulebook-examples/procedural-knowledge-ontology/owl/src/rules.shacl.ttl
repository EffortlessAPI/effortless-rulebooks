            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
                OPTIONAL { $this effortless-ntwf:policyChannel ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:maxMessageLength ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_SegmentCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:segmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyMaxMessageLengthAtSend ?policy_max_message_length_at_send . }
    OPTIONAL { $this effortless-ntwf:renderedBodyLength ?rendered_body_length . }
                BIND(IF(isNumeric(IF(COALESCE((?rendered_body_length = 0), false), 0, IF(COALESCE((?rendered_body_length <= ?policy_max_message_length_at_send), false), 1, (CEIL(((?rendered_body_length / ?policy_max_message_length_at_send)) * 1) / 1)))), ROUND(IF(COALESCE((?rendered_body_length = 0), false), 0, IF(COALESCE((?rendered_body_length <= ?policy_max_message_length_at_send), false), 1, (CEIL(((?rendered_body_length / ?policy_max_message_length_at_send)) * 1) / 1)))), IF(COALESCE((?rendered_body_length = 0), false), 0, IF(COALESCE((?rendered_body_length <= ?policy_max_message_length_at_send), false), 1, (CEIL(((?rendered_body_length / ?policy_max_message_length_at_send)) * 1) / 1)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
