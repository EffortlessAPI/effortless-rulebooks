            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:blocksAnOpenGap ?blocks_an_open_gap . }
    OPTIONAL { $this effortless-ntwf:isMyPendingDecision ?is_my_pending_decision . }
                BIND((?is_my_pending_decision && ?blocks_an_open_gap) AS ?_result)
