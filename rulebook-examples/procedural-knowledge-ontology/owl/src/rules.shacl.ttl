            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRouteQuestions .
    OPTIONAL { $this effortless-ntwf:question ?question . }
    OPTIONAL { $this effortless-ntwf:route ?route . }
                BIND(CONCAT(COALESCE(IF(isIRI(?route), REPLACE(STR(?route), "^.*[#/]", ""), IF(DATATYPE(?route) = xsd:dateTime, CONCAT(SUBSTR(STR(?route), 1, 10), " ", SUBSTR(STR(?route), 12, 8), IF(TZ(?route) = "Z", "+00", IF(STRENDS(TZ(?route), ":00"), SUBSTR(TZ(?route), 1, 3), TZ(?route)))), STR(?route))), ""), " answers ", COALESCE(IF(isIRI(?question), REPLACE(STR(?question), "^.*[#/]", ""), IF(DATATYPE(?question) = xsd:dateTime, CONCAT(SUBSTR(STR(?question), 1, 10), " ", SUBSTR(STR(?question), 12, 8), IF(TZ(?question) = "Z", "+00", IF(STRENDS(TZ(?question), ":00"), SUBSTR(TZ(?question), 1, 3), TZ(?question)))), STR(?question))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AppRouteReferences ===
