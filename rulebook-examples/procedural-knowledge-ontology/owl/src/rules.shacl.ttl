    OPTIONAL { $this effortless-ntwf:policyHasQuietHours ?policy_has_quiet_hours . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((?was_actually_transmitted && (?policy_has_quiet_hours && ?is_inside_quiet_window)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_QuietHoursViolationPolicyKey" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
