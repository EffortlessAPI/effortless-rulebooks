    OPTIONAL { $this effortless-ntwf:requestedAt ?requested_at . }
                BIND(IF(isNumeric(IF(COALESCE(?is_decided, false), ((DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)), 0)), ROUND(IF(COALESCE(?is_decided, false), ((DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)), 0)), IF(COALESCE(?is_decided, false), ((DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045) - (DAY(?requested_at) + FLOOR((153 * (MONTH(?requested_at) + 12 * FLOOR((14 - MONTH(?requested_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 4) - FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 100) + FLOOR((YEAR(?requested_at) + 4800 - FLOOR((14 - MONTH(?requested_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_ImplementationLatencyDays" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:implementationLatencyDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . }
    OPTIONAL { $this effortless-ntwf:implementedAt ?implemented_at . }
    OPTIONAL { $this effortless-ntwf:isImplemented ?is_implemented . }
                BIND(IF(isNumeric(IF(COALESCE(?is_implemented, false), ((DAY(?implemented_at) + FLOOR((153 * (MONTH(?implemented_at) + 12 * FLOOR((14 - MONTH(?implemented_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) + FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 4) - FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 100) + FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045)), 0)), ROUND(IF(COALESCE(?is_implemented, false), ((DAY(?implemented_at) + FLOOR((153 * (MONTH(?implemented_at) + 12 * FLOOR((14 - MONTH(?implemented_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) + FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 4) - FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 100) + FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045)), 0)), IF(COALESCE(?is_implemented, false), ((DAY(?implemented_at) + FLOOR((153 * (MONTH(?implemented_at) + 12 * FLOOR((14 - MONTH(?implemented_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) + FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 4) - FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 100) + FLOOR((YEAR(?implemented_at) + 4800 - FLOOR((14 - MONTH(?implemented_at)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_DelayIsDownstreamOfMe" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:delayIsDownstreamOfMe ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:decisionLatencyDays ?decision_latency_days . }
    OPTIONAL { $this effortless-ntwf:isMyDecidedButUnlanded ?is_my_decided_but_unlanded . }
                BIND((?is_my_decided_but_unlanded && (?decision_latency_days <= 14)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_UnlandedVersionKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unlandedVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isMyDecidedButUnlanded ?is_my_decided_but_unlanded . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_my_decided_but_unlanded, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsApprovedNotImplemented" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isApprovedNotImplemented ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isImplemented ?is_implemented . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND(((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved") && (!(?is_implemented))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_DaysSinceApproval" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . }
    OPTIONAL { $this effortless-ntwf:isDecided ?is_decided . }
                BIND(IF(isNumeric(IF(COALESCE(?is_decided, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045)), 0)), ROUND(IF(COALESCE(?is_decided, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045)), 0)), IF(COALESCE(?is_decided, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsStalledImplementation" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isStalledImplementation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:daysSinceApproval ?days_since_approval . }
    OPTIONAL { $this effortless-ntwf:isApprovedNotImplemented ?is_approved_not_implemented . }
                BIND((?is_approved_not_implemented && (?days_since_approval > 14)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_StalledImplementationVersionKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stalledImplementationVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isStalledImplementation ?is_stalled_implementation . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_stalled_implementation, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_ApprovedVersionKey" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:approvedVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isApprovedDecision ?is_approved_decision . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_approved_decision, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsApprovedDecision" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isApprovedDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CommunicationPolicies ===
effortless-ntwf:CommunicationPoliciesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CommunicationPolicies ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunicationPolicies .
    OPTIONAL { $this effortless-ntwf:channel ?channel . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(CONCAT(COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), IF(DATATYPE(?channel) = xsd:dateTime, CONCAT(SUBSTR(STR(?channel), 1, 10), " ", SUBSTR(STR(?channel), 12, 8), IF(TZ(?channel) = "Z", "+00", IF(STRENDS(TZ(?channel), ":00"), SUBSTR(TZ(?channel), 1, 3), TZ(?channel)))), STR(?channel))), ""), " policy / ", COALESCE(IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), IF(DATATYPE(?procedure_version) = xsd:dateTime, CONCAT(SUBSTR(STR(?procedure_version), 1, 10), " ", SUBSTR(STR(?procedure_version), 12, 8), IF(TZ(?procedure_version) = "Z", "+00", IF(STRENDS(TZ(?procedure_version), ":00"), SUBSTR(TZ(?procedure_version), 1, 3), TZ(?procedure_version)))), STR(?procedure_version))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_ConsentViolationCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:consentViolationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunicationPolicies .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MessageDeliveries .
                    $this effortless-ntwf:communicationPolicyId ?p0 .
                    ?child effortless-ntwf:policyChannel ?c0 .
                    OPTIONAL { ?child effortless-ntwf:isConsentViolation ?c2 . }
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_QuietHoursViolationCount" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:quietHoursViolationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunicationPolicies .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:MessageDeliveries .
                    $this effortless-ntwf:communicationPolicyId ?p0 .
                    ?child effortless-ntwf:quietHoursViolationPolicyKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunicationPolicies_IsActivePolicy" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isActivePolicy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunicationPolicies .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Active") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for CommunitiesOfPractice ===
effortless-ntwf:CommunitiesOfPracticeShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CommunitiesOfPractice ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CommunitiesOfPractice_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CommunitiesOfPractice .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for DeliveredCommunications ===
effortless-ntwf:DeliveredCommunicationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DeliveredCommunications ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:channel ?channel . }
    OPTIONAL { $this effortless-ntwf:recipientKey ?recipient_key . }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND(CONCAT(COALESCE(IF(isIRI(?channel), REPLACE(STR(?channel), "^.*[#/]", ""), IF(DATATYPE(?channel) = xsd:dateTime, CONCAT(SUBSTR(STR(?channel), 1, 10), " ", SUBSTR(STR(?channel), 12, 8), IF(TZ(?channel) = "Z", "+00", IF(STRENDS(TZ(?channel), ":00"), SUBSTR(TZ(?channel), 1, 3), TZ(?channel)))), STR(?channel))), ""), " -> ", COALESCE(IF(isIRI(?recipient_key), REPLACE(STR(?recipient_key), "^.*[#/]", ""), IF(DATATYPE(?recipient_key) = xsd:dateTime, CONCAT(SUBSTR(STR(?recipient_key), 1, 10), " ", SUBSTR(STR(?recipient_key), 12, 8), IF(TZ(?recipient_key) = "Z", "+00", IF(STRENDS(TZ(?recipient_key), ":00"), SUBSTR(TZ(?recipient_key), 1, 3), TZ(?recipient_key)))), STR(?recipient_key))), ""), " @ ", COALESCE(IF(isIRI(?sent_at), REPLACE(STR(?sent_at), "^.*[#/]", ""), IF(DATATYPE(?sent_at) = xsd:dateTime, CONCAT(SUBSTR(STR(?sent_at), 1, 10), " ", SUBSTR(STR(?sent_at), 12, 8), IF(TZ(?sent_at) = "Z", "+00", IF(STRENDS(TZ(?sent_at), ":00"), SUBSTR(TZ(?sent_at), 1, 3), TZ(?sent_at)))), STR(?sent_at))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_HasAuthorization" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasAuthorization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:authorizingStepExecution ?authorizing_step_execution . }
                BIND((REPLACE(COALESCE(STR(?authorizing_step_execution), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_ContentMatchesApproval" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:contentMatchesApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:approvedContentHash ?approved_content_hash . }
    OPTIONAL { $this effortless-ntwf:renderedContentHash ?rendered_content_hash . }
                BIND((?rendered_content_hash = ?approved_content_hash) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_AuthorizedAt" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:authorizedAt ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
                OPTIONAL { $this effortless-ntwf:authorizingStepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 ; effortless-ntwf:endedAt ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_WasApprovedBeforeSending" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:wasApprovedBeforeSending ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:authorizedAt ?authorized_at . }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND((?authorized_at <= ?sent_at) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DeliveredCommunications_IsDefensible" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isDefensible ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DeliveredCommunications .
    OPTIONAL { $this effortless-ntwf:contentMatchesApproval ?content_matches_approval . }
    OPTIONAL { $this effortless-ntwf:hasAuthorization ?has_authorization . }
    OPTIONAL { $this effortless-ntwf:wasApprovedBeforeSending ?was_approved_before_sending . }
                BIND((?has_authorization && ?content_matches_approval && ?was_approved_before_sending) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ElicitationSessions ===
effortless-ntwf:ElicitationSessionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ElicitationSessions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:method ?method . }
    OPTIONAL { $this effortless-ntwf:startedAt ?started_at . }
                BIND(CONCAT(COALESCE(IF(isIRI(?method), REPLACE(STR(?method), "^.*[#/]", ""), IF(DATATYPE(?method) = xsd:dateTime, CONCAT(SUBSTR(STR(?method), 1, 10), " ", SUBSTR(STR(?method), 12, 8), IF(TZ(?method) = "Z", "+00", IF(STRENDS(TZ(?method), ":00"), SUBSTR(TZ(?method), 1, 3), TZ(?method)))), STR(?method))), ""), " / ", COALESCE(IF(isIRI(?started_at), REPLACE(STR(?started_at), "^.*[#/]", ""), IF(DATATYPE(?started_at) = xsd:dateTime, CONCAT(SUBSTR(STR(?started_at), 1, 10), " ", SUBSTR(STR(?started_at), 12, 8), IF(TZ(?started_at) = "Z", "+00", IF(STRENDS(TZ(?started_at), ":00"), SUBSTR(TZ(?started_at), 1, 3), TZ(?started_at)))), STR(?started_at))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_AsOfInstant" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 ; effortless-ntwf:asOfInstant ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_DaysSinceElicited" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceElicited ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:endedAt ?ended_at . }
                BIND(IF(isNumeric(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?ended_at) + FLOOR((153 * (MONTH(?ended_at) + 12 * FLOOR((14 - MONTH(?ended_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 4) - FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 100) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 400) - 32045))), ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?ended_at) + FLOOR((153 * (MONTH(?ended_at) + 12 * FLOOR((14 - MONTH(?ended_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 4) - FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 100) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 400) - 32045))), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?ended_at) + FLOOR((153 * (MONTH(?ended_at) + 12 * FLOOR((14 - MONTH(?ended_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 4) - FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 100) + FLOOR((YEAR(?ended_at) + 4800 - FLOOR((14 - MONTH(?ended_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsSingleWitnessMethod" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isSingleWitnessMethod ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:method ?method . }
                BIND(((REPLACE(COALESCE(STR(?method), ""), "^.*#", "") = "Shadowing") || (REPLACE(COALESCE(STR(?method), ""), "^.*#", "") = "PractitionerInterview")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_PractitionerIsStillEngaged" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:practitionerIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                OPTIONAL { $this effortless-ntwf:practitionerAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:isStillEngaged ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_ValidFragmentsProduced" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:validFragmentsProduced ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeFragments .
                    $this effortless-ntwf:elicitationSessionId ?p0 .
                    ?child effortless-ntwf:validFragmentSessionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsHighYieldSession" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isHighYieldSession ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:validFragmentsProduced ?valid_fragments_produced . }
                BIND((?valid_fragments_produced >= 3) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsConcentratedSingleWitness" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isConcentratedSingleWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:isHighYieldSession ?is_high_yield_session . }
    OPTIONAL { $this effortless-ntwf:isSingleWitnessMethod ?is_single_witness_method . }
                BIND((?is_single_witness_method && ?is_high_yield_session) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_IsStaleConcentratedWitness" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isStaleConcentratedWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:daysSinceElicited ?days_since_elicited . }
    OPTIONAL { $this effortless-ntwf:isConcentratedSingleWitness ?is_concentrated_single_witness . }
                BIND((?is_concentrated_single_witness && (?days_since_elicited > 180)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ElicitationSessions_ConcentratedSessionVersionKey" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:concentratedSessionVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ElicitationSessions .
    OPTIONAL { $this effortless-ntwf:isConcentratedSingleWitness ?is_concentrated_single_witness . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_concentrated_single_witness, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Errors ===
effortless-ntwf:ErrorsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Errors ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Errors_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Errors .
    OPTIONAL { $this effortless-ntwf:errorCode ?error_code . }
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(CONCAT(COALESCE(IF(isIRI(?error_code), REPLACE(STR(?error_code), "^.*[#/]", ""), IF(DATATYPE(?error_code) = xsd:dateTime, CONCAT(SUBSTR(STR(?error_code), 1, 10), " ", SUBSTR(STR(?error_code), 12, 8), IF(TZ(?error_code) = "Z", "+00", IF(STRENDS(TZ(?error_code), ":00"), SUBSTR(TZ(?error_code), 1, 3), TZ(?error_code)))), STR(?error_code))), ""), " - ", COALESCE(IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), IF(DATATYPE(?label) = xsd:dateTime, CONCAT(SUBSTR(STR(?label), 1, 10), " ", SUBSTR(STR(?label), 12, 8), IF(TZ(?label) = "Z", "+00", IF(STRENDS(TZ(?label), ":00"), SUBSTR(TZ(?label), 1, 3), TZ(?label)))), STR(?label))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for EvaluationContexts ===
effortless-ntwf:EvaluationContextsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EvaluationContexts ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EvaluationContexts_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EvaluationContexts .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(CONCAT(COALESCE(IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), IF(DATATYPE(?label) = xsd:dateTime, CONCAT(SUBSTR(STR(?label), 1, 10), " ", SUBSTR(STR(?label), 12, 8), IF(TZ(?label) = "Z", "+00", IF(STRENDS(TZ(?label), ":00"), SUBSTR(TZ(?label), 1, 3), TZ(?label)))), STR(?label))), ""), " @ ", COALESCE(IF(isIRI(?as_of_instant), REPLACE(STR(?as_of_instant), "^.*[#/]", ""), IF(DATATYPE(?as_of_instant) = xsd:dateTime, CONCAT(SUBSTR(STR(?as_of_instant), 1, 10), " ", SUBSTR(STR(?as_of_instant), 12, 8), IF(TZ(?as_of_instant) = "Z", "+00", IF(STRENDS(TZ(?as_of_instant), ":00"), SUBSTR(TZ(?as_of_instant), 1, 3), TZ(?as_of_instant)))), STR(?as_of_instant))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ExceptionInvocations ===
effortless-ntwf:ExceptionInvocationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ExceptionInvocations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:exception ?exception . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(CONCAT(COALESCE(IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), IF(DATATYPE(?step_execution) = xsd:dateTime, CONCAT(SUBSTR(STR(?step_execution), 1, 10), " ", SUBSTR(STR(?step_execution), 12, 8), IF(TZ(?step_execution) = "Z", "+00", IF(STRENDS(TZ(?step_execution), ":00"), SUBSTR(TZ(?step_execution), 1, 3), TZ(?step_execution)))), STR(?step_execution))), ""), " / ", COALESCE(IF(isIRI(?exception), REPLACE(STR(?exception), "^.*[#/]", ""), IF(DATATYPE(?exception) = xsd:dateTime, CONCAT(SUBSTR(STR(?exception), 1, 10), " ", SUBSTR(STR(?exception), 12, 8), IF(TZ(?exception) = "Z", "+00", IF(STRENDS(TZ(?exception), ":00"), SUBSTR(TZ(?exception), 1, 3), TZ(?exception)))), STR(?exception))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ExpectedHandling" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:expectedHandling ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:exception ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Exceptions ; effortless-ntwf:exceptionId ?j2 ; effortless-ntwf:handling ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_RequiredApprovalRole" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:requiredApprovalRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:exception ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Exceptions ; effortless-ntwf:exceptionId ?j2 ; effortless-ntwf:approvalRole ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_RequiredApprovalRoleHolder" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:requiredApprovalRoleHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:requiredApprovalRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 ; effortless-ntwf:currentAgent ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ApprovalRoleMatches" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:approvalRoleMatches ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approvedByAgent ?approved_by_agent . }
    OPTIONAL { $this effortless-ntwf:requiredApprovalRoleHolder ?required_approval_role_holder . }
                BIND((?approved_by_agent = ?required_approval_role_holder) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_IsApproved" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isApproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approvedByAgent ?approved_by_agent . }
                BIND((REPLACE(COALESCE(STR(?approved_by_agent), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_IsImproperlyApproved" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isImproperlyApproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approvalRoleMatches ?approval_role_matches . }
    OPTIONAL { $this effortless-ntwf:isApproved ?is_approved . }
                BIND(((!(?is_approved)) || (!(?approval_role_matches))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_InvokerAgentKind" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:invokerAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:invokedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:agentKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_InvokerAlsoPreparedKey" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:invokerAlsoPreparedKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approvedByAgent ?approved_by_agent . }
    OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?parent_procedure_execution . }
                BIND(CONCAT(COALESCE(IF(isIRI(?parent_procedure_execution), REPLACE(STR(?parent_procedure_execution), "^.*[#/]", ""), IF(DATATYPE(?parent_procedure_execution) = xsd:dateTime, CONCAT(SUBSTR(STR(?parent_procedure_execution), 1, 10), " ", SUBSTR(STR(?parent_procedure_execution), 12, 8), IF(TZ(?parent_procedure_execution) = "Z", "+00", IF(STRENDS(TZ(?parent_procedure_execution), ":00"), SUBSTR(TZ(?parent_procedure_execution), 1, 3), TZ(?parent_procedure_execution)))), STR(?parent_procedure_execution))), ""), "|", COALESCE(IF(isIRI(?approved_by_agent), REPLACE(STR(?approved_by_agent), "^.*[#/]", ""), IF(DATATYPE(?approved_by_agent) = xsd:dateTime, CONCAT(SUBSTR(STR(?approved_by_agent), 1, 10), " ", SUBSTR(STR(?approved_by_agent), 12, 8), IF(TZ(?approved_by_agent) = "Z", "+00", IF(STRENDS(TZ(?approved_by_agent), ":00"), SUBSTR(TZ(?approved_by_agent), 1, 3), TZ(?approved_by_agent)))), STR(?approved_by_agent))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ParentProcedureExecution" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:parentProcedureExecution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 ; effortless-ntwf:procedureExecution ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_ApproverPreparedCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:approverPreparedCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepExecutions .
                    $this effortless-ntwf:invokerAlsoPreparedKey ?p0 .
                    ?child effortless-ntwf:preparerAgentKey ?c0 .
                    FILTER(IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_DelegatedToPreparer" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:delegatedToPreparer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:approverPreparedCount ?approver_prepared_count . }
                BIND((?approver_prepared_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ExceptionInvocations_IsUngovernedInvocation" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUngovernedInvocation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ExceptionInvocations .
    OPTIONAL { $this effortless-ntwf:delegatedToPreparer ?delegated_to_preparer . }
    OPTIONAL { $this effortless-ntwf:isImproperlyApproved ?is_improperly_approved . }
                BIND((?is_improperly_approved || ?delegated_to_preparer) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Exceptions ===
effortless-ntwf:ExceptionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Exceptions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Exceptions_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Exceptions .
    OPTIONAL { $this effortless-ntwf:condition ?condition . }
                BIND(?condition AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Exceptions_ActiveExceptionStepKey" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:activeExceptionStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Exceptions .
    OPTIONAL { $this effortless-ntwf:status ?status . }
    OPTIONAL { $this effortless-ntwf:triggerStep ?trigger_step . }
                BIND(IF(COALESCE((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Active"), false), ?trigger_step, "") AS ?_result)
            }
        """ ;
    ] .

