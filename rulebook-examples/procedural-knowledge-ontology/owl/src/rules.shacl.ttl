                $this effortless-ntwf:draftRewriteRatePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:draftDecisionCount ?draft_decision_count . }
    OPTIONAL { $this effortless-ntwf:overriddenDraftCount ?overridden_draft_count . }
                BIND(IF(COALESCE((?draft_decision_count = 0), false), 0, ((?overridden_draft_count * 100) / ?draft_decision_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_TimesNamedAsBroker" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:timesNamedAsBroker ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeBrokerLinks .
                    $this effortless-ntwf:agentId ?p0 .
                    ?child effortless-ntwf:activeRelianceBrokerKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_IsRecognizedBroker" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
