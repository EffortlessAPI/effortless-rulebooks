= "" || TZ(?as_of_instant) = "Z", 0, IF(SUBSTR(TZ(?as_of_instant), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?as_of_instant), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?as_of_instant), 5, 2)) * 60))) - ((DAY(?evaluated_at) + FLOOR((153 * (MONTH(?evaluated_at) + 12 * FLOOR((14 - MONTH(?evaluated_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 4) - FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 100) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 400) - 32045) * 86400 + COALESCE(HOURS(?evaluated_at), 0) * 3600 + COALESCE(MINUTES(?evaluated_at), 0) * 60 + COALESCE(SECONDS(?evaluated_at), 0) - IF(TZ(?evaluated_at) = "" || TZ(?evaluated_at) = "Z", 0, IF(SUBSTR(TZ(?evaluated_at), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?evaluated_at), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?evaluated_at), 5, 2)) * 60)))) / 3600)) AS ?_result)
