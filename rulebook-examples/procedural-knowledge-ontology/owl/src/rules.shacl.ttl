    OPTIONAL { $this effortless-ntwf:isUnhandledUnreachable ?is_unhandled_unreachable . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE((?is_fabricated_acknowledgement || ?is_unhandled_unreachable), false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_PolicyRetentionDays" ;
