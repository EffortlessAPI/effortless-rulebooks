            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:isUnexercisedHumanGate ?is_unexercised_human_gate . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_unexercised_human_gate, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_HasDeclaredControlKind" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasDeclaredControlKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:controlKind ?control_kind . }
                BIND((REPLACE(COALESCE(STR(?control_kind), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_UndeclaredControlVersionKey" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:undeclaredControlVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:hasDeclaredControlKind ?has_declared_control_kind . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?has_declared_control_kind, false), "", ?procedure_version) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_ApprovalStepIsSoftwareAssigned" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:approvalStepIsSoftwareAssigned ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:controlKind ?control_kind . }
    OPTIONAL { $this effortless-ntwf:isSoftwareAssigned ?is_software_assigned . }
                BIND(((REPLACE(COALESCE(STR(?control_kind), ""), "^.*#", "") = "Approval") && ?is_software_assigned) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_UnwitnessedBlockingCount" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unwitnessedBlockingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepRequirements .
                    $this effortless-ntwf:stepId ?p0 .
                    ?child effortless-ntwf:unwitnessedStepKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for StewardshipAssignments ===
effortless-ntwf:StewardshipAssignmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StewardshipAssignments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StewardshipAssignments .
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
    OPTIONAL { $this effortless-ntwf:stewardRole ?steward_role . }
                BIND(CONCAT(COALESCE(IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), IF(DATATYPE(?procedure_version) = xsd:dateTime, CONCAT(SUBSTR(STR(?procedure_version), 1, 10), " ", SUBSTR(STR(?procedure_version), 12, 8), IF(TZ(?procedure_version) = "Z", "+00", IF(STRENDS(TZ(?procedure_version), ":00"), SUBSTR(TZ(?procedure_version), 1, 3), TZ(?procedure_version)))), STR(?procedure_version))), ""), " / steward=", COALESCE(IF(isIRI(?steward_role), REPLACE(STR(?steward_role), "^.*[#/]", ""), IF(DATATYPE(?steward_role) = xsd:dateTime, CONCAT(SUBSTR(STR(?steward_role), 1, 10), " ", SUBSTR(STR(?steward_role), 12, 8), IF(TZ(?steward_role) = "Z", "+00", IF(STRENDS(TZ(?steward_role), ":00"), SUBSTR(TZ(?steward_role), 1, 3), TZ(?steward_role)))), STR(?steward_role))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_CountOfReviewEvents" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfReviewEvents ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StewardshipAssignments .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ReviewEvents .
                    $this effortless-ntwf:procedureVersion ?p0 .
                    ?child effortless-ntwf:procedureVersion ?c0 .
                    FILTER(IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_HasEverBeenReviewed" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasEverBeenReviewed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StewardshipAssignments .
    OPTIONAL { $this effortless-ntwf:countOfReviewEvents ?count_of_review_events . }
                BIND((?count_of_review_events > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_AsOfInstant" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StewardshipAssignments .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 ; effortless-ntwf:asOfInstant ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StewardshipAssignments_IsCurrentAssignment" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrentAssignment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StewardshipAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND(((?valid_from <= ?as_of_instant) && ((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = "") || (?valid_to > ?as_of_instant))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for TemplateApprovals ===
effortless-ntwf:TemplateApprovalsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TemplateApprovals ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TemplateApprovals .
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . }
    OPTIONAL { $this effortless-ntwf:decision ?decision . }
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . }
                BIND(CONCAT(COALESCE(IF(isIRI(?message_template), REPLACE(STR(?message_template), "^.*[#/]", ""), IF(DATATYPE(?message_template) = xsd:dateTime, CONCAT(SUBSTR(STR(?message_template), 1, 10), " ", SUBSTR(STR(?message_template), 12, 8), IF(TZ(?message_template) = "Z", "+00", IF(STRENDS(TZ(?message_template), ":00"), SUBSTR(TZ(?message_template), 1, 3), TZ(?message_template)))), STR(?message_template))), ""), " / ", COALESCE(IF(isIRI(?decision), REPLACE(STR(?decision), "^.*[#/]", ""), IF(DATATYPE(?decision) = xsd:dateTime, CONCAT(SUBSTR(STR(?decision), 1, 10), " ", SUBSTR(STR(?decision), 12, 8), IF(TZ(?decision) = "Z", "+00", IF(STRENDS(TZ(?decision), ":00"), SUBSTR(TZ(?decision), 1, 3), TZ(?decision)))), STR(?decision))), ""), " / ", COALESCE(IF(isIRI(?decided_at), REPLACE(STR(?decided_at), "^.*[#/]", ""), IF(DATATYPE(?decided_at) = xsd:dateTime, CONCAT(SUBSTR(STR(?decided_at), 1, 10), " ", SUBSTR(STR(?decided_at), 12, 8), IF(TZ(?decided_at) = "Z", "+00", IF(STRENDS(TZ(?decided_at), ":00"), SUBSTR(TZ(?decided_at), 1, 3), TZ(?decided_at)))), STR(?decided_at))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_IsApprovalDecision" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isApprovalDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TemplateApprovals .
    OPTIONAL { $this effortless-ntwf:decision ?decision . }
                BIND((REPLACE(COALESCE(STR(?decision), ""), "^.*#", "") = "Approved") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_TemplatePolicy" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:templatePolicy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TemplateApprovals .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 ; effortless-ntwf:communicationPolicy ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_RequiredApprovalRole" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:requiredApprovalRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TemplateApprovals .
                OPTIONAL { $this effortless-ntwf:templatePolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:approvalRole ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_IsDecidedByRequiredRole" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isDecidedByRequiredRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TemplateApprovals .
    OPTIONAL { $this effortless-ntwf:decidedInRole ?decided_in_role . }
    OPTIONAL { $this effortless-ntwf:requiredApprovalRole ?required_approval_role . }
                BIND((?decided_in_role = ?required_approval_role) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TemplateApprovals_ValidApprovalTemplateKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:validApprovalTemplateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TemplateApprovals .
    OPTIONAL { $this effortless-ntwf:isApprovalDecision ?is_approval_decision . }
    OPTIONAL { $this effortless-ntwf:isDecidedByRequiredRole ?is_decided_by_required_role . }
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . }
                BIND(IF(COALESCE((?is_approval_decision && ?is_decided_by_required_role), false), ?message_template, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for TestCases ===
effortless-ntwf:TestCasesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TestCases ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:subject ?subject . }
    OPTIONAL { $this effortless-ntwf:testKind ?test_kind . }
                BIND(CONCAT(COALESCE(IF(isIRI(?test_kind), REPLACE(STR(?test_kind), "^.*[#/]", ""), IF(DATATYPE(?test_kind) = xsd:dateTime, CONCAT(SUBSTR(STR(?test_kind), 1, 10), " ", SUBSTR(STR(?test_kind), 12, 8), IF(TZ(?test_kind) = "Z", "+00", IF(STRENDS(TZ(?test_kind), ":00"), SUBSTR(TZ(?test_kind), 1, 3), TZ(?test_kind)))), STR(?test_kind))), ""), ": ", COALESCE(IF(isIRI(?subject), REPLACE(STR(?subject), "^.*[#/]", ""), IF(DATATYPE(?subject) = xsd:dateTime, CONCAT(SUBSTR(STR(?subject), 1, 10), " ", SUBSTR(STR(?subject), 12, 8), IF(TZ(?subject) = "Z", "+00", IF(STRENDS(TZ(?subject), ":00"), SUBSTR(TZ(?subject), 1, 3), TZ(?subject)))), STR(?subject))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_IsBlocking" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:severity ?severity . }
                BIND((REPLACE(COALESCE(STR(?severity), ""), "^.*#", "") = "blocking") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_IsPassing" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isPassing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:lastOutcome ?last_outcome . }
                BIND((REPLACE(COALESCE(STR(?last_outcome), ""), "^.*#", "") = "PASS") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_IsFailing" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isFailing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:lastOutcome ?last_outcome . }
                BIND((REPLACE(COALESCE(STR(?last_outcome), ""), "^.*#", "") = "FAIL") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_NeedsAttention" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:needsAttention ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
    OPTIONAL { $this effortless-ntwf:isFailing ?is_failing . }
                BIND((?is_failing && ?is_blocking) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_PassingSuiteKey" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:passingSuiteKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:isPassing ?is_passing . }
    OPTIONAL { $this effortless-ntwf:suite ?suite . }
                BIND(IF(COALESCE(?is_passing, false), ?suite, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestCases_NeedsAttentionSuiteKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:needsAttentionSuiteKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestCases .
    OPTIONAL { $this effortless-ntwf:needsAttention ?needs_attention . }
    OPTIONAL { $this effortless-ntwf:suite ?suite . }
                BIND(IF(COALESCE(?needs_attention, false), ?suite, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for TestSuites ===
effortless-ntwf:TestSuitesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TestSuites ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestSuites .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_TestCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:testCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestSuites .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TestCases .
                    ?child effortless-ntwf:suite $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_PassCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:passCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestSuites .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TestCases .
                    $this effortless-ntwf:testSuiteId ?p0 .
                    ?child effortless-ntwf:passingSuiteKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_BlockingFailCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:blockingFailCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestSuites .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:TestCases .
                    $this effortless-ntwf:testSuiteId ?p0 .
                    ?child effortless-ntwf:needsAttentionSuiteKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TestSuites_IsGreen" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isGreen ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TestSuites .
    OPTIONAL { $this effortless-ntwf:blockingFailCount ?blocking_fail_count . }
                BIND((?blocking_fail_count = 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Tools ===
effortless-ntwf:ToolsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Tools ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Tools_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Tools .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for UserFeedback ===
effortless-ntwf:UserFeedbackShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:UserFeedback ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserFeedback_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UserFeedback .
    OPTIONAL { $this effortless-ntwf:disposition ?disposition . }
    OPTIONAL { $this effortless-ntwf:feedbackText ?feedback_text . }
                BIND(CONCAT(COALESCE(IF(isIRI(?disposition), REPLACE(STR(?disposition), "^.*[#/]", ""), IF(DATATYPE(?disposition) = xsd:dateTime, CONCAT(SUBSTR(STR(?disposition), 1, 10), " ", SUBSTR(STR(?disposition), 12, 8), IF(TZ(?disposition) = "Z", "+00", IF(STRENDS(TZ(?disposition), ":00"), SUBSTR(TZ(?disposition), 1, 3), TZ(?disposition)))), STR(?disposition))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?feedback_text), 1, 60)), REPLACE(STR(SUBSTR(STR(?feedback_text), 1, 60)), "^.*[#/]", ""), IF(DATATYPE(SUBSTR(STR(?feedback_text), 1, 60)) = xsd:dateTime, CONCAT(SUBSTR(STR(SUBSTR(STR(?feedback_text), 1, 60)), 1, 10), " ", SUBSTR(STR(SUBSTR(STR(?feedback_text), 1, 60)), 12, 8), IF(TZ(SUBSTR(STR(?feedback_text), 1, 60)) = "Z", "+00", IF(STRENDS(TZ(SUBSTR(STR(?feedback_text), 1, 60)), ":00"), SUBSTR(TZ(SUBSTR(STR(?feedback_text), 1, 60)), 1, 3), TZ(SUBSTR(STR(?feedback_text), 1, 60))))), STR(SUBSTR(STR(?feedback_text), 1, 60)))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for UserQuestions ===
effortless-ntwf:UserQuestionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:UserQuestions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UserQuestions_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UserQuestions .
    OPTIONAL { $this effortless-ntwf:questionText ?question_text . }
                BIND(SUBSTR(STR(?question_text), 1, 70) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for VerificationOutcomes ===
effortless-ntwf:VerificationOutcomesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:VerificationOutcomes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
    OPTIONAL { $this effortless-ntwf:stepVerification ?step_verification . }
                BIND(CONCAT(COALESCE(IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), IF(DATATYPE(?step_execution) = xsd:dateTime, CONCAT(SUBSTR(STR(?step_execution), 1, 10), " ", SUBSTR(STR(?step_execution), 12, 8), IF(TZ(?step_execution) = "Z", "+00", IF(STRENDS(TZ(?step_execution), ":00"), SUBSTR(TZ(?step_execution), 1, 3), TZ(?step_execution)))), STR(?step_execution))), ""), " / ", COALESCE(IF(isIRI(?step_verification), REPLACE(STR(?step_verification), "^.*[#/]", ""), IF(DATATYPE(?step_verification) = xsd:dateTime, CONCAT(SUBSTR(STR(?step_verification), 1, 10), " ", SUBSTR(STR(?step_verification), 12, 8), IF(TZ(?step_verification) = "Z", "+00", IF(STRENDS(TZ(?step_verification), ":00"), SUBSTR(TZ(?step_verification), 1, 3), TZ(?step_verification)))), STR(?step_verification))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_ExpectedSignalValue" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:expectedSignalValue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
                OPTIONAL { $this effortless-ntwf:stepVerification ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepVerifications ; effortless-ntwf:stepVerificationId ?j2 ; effortless-ntwf:expectedSignalValue ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_SignalIdentifier" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:signalIdentifier ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
                OPTIONAL { $this effortless-ntwf:stepVerification ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepVerifications ; effortless-ntwf:stepVerificationId ?j2 ; effortless-ntwf:signalIdentifier ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_SignalMatchesExpected" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:signalMatchesExpected ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:expectedSignalValue ?expected_signal_value . }
    OPTIONAL { $this effortless-ntwf:observedSignalValue ?observed_signal_value . }
                BIND((?observed_signal_value = ?expected_signal_value) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_HasEvidence" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:evidenceUri ?evidence_uri . }
                BIND((REPLACE(COALESCE(STR(?evidence_uri), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IsUnbackedObservation" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnbackedObservation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:hasEvidence ?has_evidence . }
    OPTIONAL { $this effortless-ntwf:signalMatchesExpected ?signal_matches_expected . }
                BIND((?signal_matches_expected && (!(?has_evidence))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IsSelfWitnessed" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isSelfWitnessed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:observedByAgent ?observed_by_agent . }
    OPTIONAL { $this effortless-ntwf:stepExecutorAgent ?step_executor_agent . }
                BIND((?observed_by_agent = ?step_executor_agent) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_StepExecutorAgent" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepExecutorAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 ; effortless-ntwf:executedByAgent ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_SelfWitnessedStepKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:selfWitnessedStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:isSelfWitnessed ?is_self_witnessed . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_self_witnessed, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_UnbackedStepKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unbackedStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:isUnbackedObservation ?is_unbacked_observation . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_unbacked_observation, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IsSelfWitnessedAndUnbacked" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isSelfWitnessedAndUnbacked ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:hasEvidence ?has_evidence . }
    OPTIONAL { $this effortless-ntwf:isSelfWitnessed ?is_self_witnessed . }
                BIND((?is_self_witnessed && (!(?has_evidence))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IsUncorroboratedPass" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUncorroboratedPass ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:isSelfWitnessedAndUnbacked ?is_self_witnessed_and_unbacked . }
    OPTIONAL { $this effortless-ntwf:signalMatchesExpected ?signal_matches_expected . }
                BIND((?signal_matches_expected && ?is_self_witnessed_and_unbacked) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_UncorroboratedPassStepKey" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:uncorroboratedPassStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:isUncorroboratedPass ?is_uncorroborated_pass . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_uncorroborated_pass, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_ObserverIsNonHuman" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:observerIsNonHuman ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
                OPTIONAL { $this effortless-ntwf:observedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:isNonHuman ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_ObserverIsIndependentOfExecutor" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:observerIsIndependentOfExecutor ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:isSelfWitnessed ?is_self_witnessed . }
                BIND((!(?is_self_witnessed)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IsIndependentHumanObservation" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isIndependentHumanObservation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:hasEvidence ?has_evidence . }
    OPTIONAL { $this effortless-ntwf:isSelfWitnessed ?is_self_witnessed . }
    OPTIONAL { $this effortless-ntwf:observerIsNonHuman ?observer_is_non_human . }
                BIND(((!(?observer_is_non_human)) && (!(?is_self_witnessed)) && ?has_evidence) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_IndependentObservationExecutionKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:independentObservationExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
    OPTIONAL { $this effortless-ntwf:isIndependentHumanObservation ?is_independent_human_observation . }
    OPTIONAL { $this effortless-ntwf:parentProcedureExecutionOfOutcome ?parent_procedure_execution_of_outcome . }
                BIND(IF(COALESCE(?is_independent_human_observation, false), ?parent_procedure_execution_of_outcome, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VerificationOutcomes_ParentProcedureExecutionOfOutcome" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:parentProcedureExecutionOfOutcome ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VerificationOutcomes .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 ; effortless-ntwf:procedureExecution ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Vocabularies ===
effortless-ntwf:VocabulariesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Vocabularies ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_TermCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:termCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:VocabularyTerms .
                    ?child effortless-ntwf:vocabulary $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_OrphanTermCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:orphanTermCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:VocabularyTerms .
                    $this effortless-ntwf:vocabularyId ?p0 .
                    ?child effortless-ntwf:orphanTermVocabularyKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Vocabularies_HasOrphanTerms" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasOrphanTerms ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Vocabularies .
    OPTIONAL { $this effortless-ntwf:orphanTermCount ?orphan_term_count . }
                BIND((?orphan_term_count > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for VocabularyTerms ===
effortless-ntwf:VocabularyTermsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:VocabularyTerms ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
    OPTIONAL { $this effortless-ntwf:prefLabel ?pref_label . }
                BIND(?pref_label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_UsageCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:usageCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Requirements .
                    ?child effortless-ntwf:controlledTerm $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_IsOrphanTerm" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isOrphanTerm ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
    OPTIONAL { $this effortless-ntwf:usageCount ?usage_count . }
                BIND((?usage_count = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_IsWidelyAdoptedTerm" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isWidelyAdoptedTerm ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
    OPTIONAL { $this effortless-ntwf:usageCount ?usage_count . }
                BIND((?usage_count >= 2) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VocabularyTerms_OrphanTermVocabularyKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:orphanTermVocabularyKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VocabularyTerms .
    OPTIONAL { $this effortless-ntwf:isOrphanTerm ?is_orphan_term . }
    OPTIONAL { $this effortless-ntwf:vocabulary ?vocabulary . }
                BIND(IF(COALESCE(?is_orphan_term, false), ?vocabulary, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for WitnessLoops ===
effortless-ntwf:WitnessLoopsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:WitnessLoops ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WitnessLoops_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:WitnessLoops .
    OPTIONAL { $this effortless-ntwf:loopNumber ?loop_number . }
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(CONCAT("Loop ", COALESCE(IF(isIRI(?loop_number), REPLACE(STR(?loop_number), "^.*[#/]", ""), IF(DATATYPE(?loop_number) = xsd:dateTime, CONCAT(SUBSTR(STR(?loop_number), 1, 10), " ", SUBSTR(STR(?loop_number), 12, 8), IF(TZ(?loop_number) = "Z", "+00", IF(STRENDS(TZ(?loop_number), ":00"), SUBSTR(TZ(?loop_number), 1, 3), TZ(?loop_number)))), STR(?loop_number))), ""), ": ", COALESCE(IF(isIRI(?title), REPLACE(STR(?title), "^.*[#/]", ""), IF(DATATYPE(?title) = xsd:dateTime, CONCAT(SUBSTR(STR(?title), 1, 10), " ", SUBSTR(STR(?title), 12, 8), IF(TZ(?title) = "Z", "+00", IF(STRENDS(TZ(?title), ":00"), SUBSTR(TZ(?title), 1, 3), TZ(?title)))), STR(?title))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WitnessLoops_QuestionCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:questionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:WitnessLoops .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleQuestions .
                    ?child effortless-ntwf:witnessLoop $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_WitnessLoops_IsComplete" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isComplete ?_result .
            }
            WHERE {
    $this a effortless-ntwf:WitnessLoops .
    OPTIONAL { $this effortless-ntwf:completedAt ?completed_at . }
                BIND((REPLACE(COALESCE(STR(?completed_at), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] .

