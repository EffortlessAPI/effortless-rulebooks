    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_FragilitySignalCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:fragilitySignalCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:hasOperationalReliance ?has_operational_reliance . }
    OPTIONAL { $this effortless-ntwf:isFromSingleWitness ?is_from_single_witness . }
    OPTIONAL { $this effortless-ntwf:isLowConfidence ?is_low_confidence . }
    OPTIONAL { $this effortless-ntwf:isOverdueForReview ?is_overdue_for_review . }
                BIND(IF(isNumeric((((IF(COALESCE(?is_from_single_witness, false), 1, 0) + IF(COALESCE(?is_overdue_for_review, false), 1, 0)) + IF(COALESCE(?is_low_confidence, false), 1, 0)) + IF(COALESCE(?has_operational_reliance, false), 1, 0))), ROUND((((IF(COALESCE(?is_from_single_witness, false), 1, 0) + IF(COALESCE(?is_overdue_for_review, false), 1, 0)) + IF(COALESCE(?is_low_confidence, false), 1, 0)) + IF(COALESCE(?has_operational_reliance, false), 1, 0))), (((IF(COALESCE(?is_from_single_witness, false), 1, 0) + IF(COALESCE(?is_overdue_for_review, false), 1, 0)) + IF(COALESCE(?is_low_confidence, false), 1, 0)) + IF(COALESCE(?has_operational_reliance, false), 1, 0))) AS ?_result)
            }
