                $this effortless-ntwf:hasAtRiskKnowledgeReliance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:atRiskRelianceCount ?at_risk_reliance_count . }
                BIND((?at_risk_reliance_count > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AppNavGroups ===
effortless-ntwf:AppNavGroupsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppNavGroups ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppNavGroups_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppNavGroups .
    OPTIONAL { $this effortless-ntwf:groupLabel ?group_label . }
                BIND(?group_label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppNavGroups_RouteCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:routeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppNavGroups .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AppRoutes .
                    ?child effortless-ntwf:navGroup $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for AppRoleProfiles ===
effortless-ntwf:AppRoleProfilesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppRoleProfiles ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoleProfiles_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoleProfiles .
    OPTIONAL { $this effortless-ntwf:displayLabel ?display_label . }
    OPTIONAL { $this effortless-ntwf:roleKind ?role_kind . }
                BIND(CONCAT(COALESCE(IF(isIRI(?display_label), REPLACE(STR(?display_label), "^.*[#/]", ""), IF(DATATYPE(?display_label) = xsd:dateTime, CONCAT(SUBSTR(STR(?display_label), 1, 10), " ", SUBSTR(STR(?display_label), 12, 8), IF(TZ(?display_label) = "Z", "+00", IF(STRENDS(TZ(?display_label), ":00"), SUBSTR(TZ(?display_label), 1, 3), TZ(?display_label)))), STR(?display_label))), ""), " (", COALESCE(IF(isIRI(?role_kind), REPLACE(STR(?role_kind), "^.*[#/]", ""), IF(DATATYPE(?role_kind) = xsd:dateTime, CONCAT(SUBSTR(STR(?role_kind), 1, 10), " ", SUBSTR(STR(?role_kind), 12, 8), IF(TZ(?role_kind) = "Z", "+00", IF(STRENDS(TZ(?role_kind), ":00"), SUBSTR(TZ(?role_kind), 1, 3), TZ(?role_kind)))), STR(?role_kind))), ""), ")") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoleProfiles_RouteCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:routeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoleProfiles .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AppRoutes .
                    $this effortless-ntwf:role ?p0 .
                    ?child effortless-ntwf:owningRole ?c0 .
                    FILTER(IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for AppRouteQuestions ===
effortless-ntwf:AppRouteQuestionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppRouteQuestions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRouteQuestions_Name" ;
