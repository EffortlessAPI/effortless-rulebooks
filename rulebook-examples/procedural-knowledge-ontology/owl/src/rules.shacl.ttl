@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix effortless-ntwf: <https://w3id.org/effortless-ntwf#> .

# === Shape with rules for AccessDenialTests ===
effortless-ntwf:AccessDenialTestsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AccessDenialTests ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:forbiddenRowId ?forbidden_row_id . }
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
                BIND(CONCAT(COALESCE(IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), IF(DATATYPE(?principal) = xsd:dateTime, CONCAT(SUBSTR(STR(?principal), 1, 10), " ", SUBSTR(STR(?principal), 12, 8), IF(TZ(?principal) = "Z", "+00", IF(STRENDS(TZ(?principal), ":00"), SUBSTR(TZ(?principal), 1, 3), TZ(?principal)))), STR(?principal))), ""), " must not see ", COALESCE(IF(isIRI(?forbidden_row_id), REPLACE(STR(?forbidden_row_id), "^.*[#/]", ""), IF(DATATYPE(?forbidden_row_id) = xsd:dateTime, CONCAT(SUBSTR(STR(?forbidden_row_id), 1, 10), " ", SUBSTR(STR(?forbidden_row_id), 12, 8), IF(TZ(?forbidden_row_id) = "Z", "+00", IF(STRENDS(TZ(?forbidden_row_id), ":00"), SUBSTR(TZ(?forbidden_row_id), 1, 3), TZ(?forbidden_row_id)))), STR(?forbidden_row_id))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_HasRun" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:lastRunAt ?last_run_at . }
                BIND((REPLACE(COALESCE(STR(?last_run_at), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsPassing" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isPassing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:expectedVisible ?expected_visible . }
    OPTIONAL { $this effortless-ntwf:observedVisible ?observed_visible . }
                BIND((?observed_visible = ?expected_visible) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsLeak" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isLeak ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:expectedVisible ?expected_visible . }
    OPTIONAL { $this effortless-ntwf:observedVisible ?observed_visible . }
                BIND(((!(COALESCE(?expected_visible, false))) && COALESCE(?observed_visible, false)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsUnproven" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnproven ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:hasRun ?has_run . }
                BIND((!(?has_run)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessDenialTests_IsPositiveControl" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isPositiveControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessDenialTests .
    OPTIONAL { $this effortless-ntwf:expectedVisible ?expected_visible . }
                BIND(?expected_visible AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AccessPolicies ===
effortless-ntwf:AccessPoliciesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AccessPolicies ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:command ?command . }
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
    OPTIONAL { $this effortless-ntwf:targetTable ?target_table . }
                BIND(CONCAT(COALESCE(IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), IF(DATATYPE(?principal) = xsd:dateTime, CONCAT(SUBSTR(STR(?principal), 1, 10), " ", SUBSTR(STR(?principal), 12, 8), IF(TZ(?principal) = "Z", "+00", IF(STRENDS(TZ(?principal), ":00"), SUBSTR(TZ(?principal), 1, 3), TZ(?principal)))), STR(?principal))), ""), " ", COALESCE(IF(isIRI(?command), REPLACE(STR(?command), "^.*[#/]", ""), IF(DATATYPE(?command) = xsd:dateTime, CONCAT(SUBSTR(STR(?command), 1, 10), " ", SUBSTR(STR(?command), 12, 8), IF(TZ(?command) = "Z", "+00", IF(STRENDS(TZ(?command), ":00"), SUBSTR(TZ(?command), 1, 3), TZ(?command)))), STR(?command))), ""), " ", COALESCE(IF(isIRI(?target_table), REPLACE(STR(?target_table), "^.*[#/]", ""), IF(DATATYPE(?target_table) = xsd:dateTime, CONCAT(SUBSTR(STR(?target_table), 1, 10), " ", SUBSTR(STR(?target_table), 12, 8), IF(TZ(?target_table) = "Z", "+00", IF(STRENDS(TZ(?target_table), ":00"), SUBSTR(TZ(?target_table), 1, 3), TZ(?target_table)))), STR(?target_table))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsWriteCommand" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isWriteCommand ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:command ?command . }
                BIND(((REPLACE(COALESCE(STR(?command), ""), "^.*#", "") = "INSERT") || (REPLACE(COALESCE(STR(?command), ""), "^.*#", "") = "UPDATE") || (REPLACE(COALESCE(STR(?command), ""), "^.*#", "") = "DELETE") || (REPLACE(COALESCE(STR(?command), ""), "^.*#", "") = "ALL")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsUnrestricted" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnrestricted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:rowPredicate ?row_predicate . }
                BIND((REPLACE(COALESCE(STR(?row_predicate), ""), "^.*#", "") = "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_PrincipalIsAdmin" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:principalIsAdmin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
                OPTIONAL { $this effortless-ntwf:principal ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:AccessPrincipals ; effortless-ntwf:accessPrincipalId ?j2 ; effortless-ntwf:isAdministrator ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsUnrestrictedNonAdminGrant" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnrestrictedNonAdminGrant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:isUnrestricted ?is_unrestricted . }
    OPTIONAL { $this effortless-ntwf:principalIsAdmin ?principal_is_admin . }
                BIND((?is_unrestricted && (!(?principal_is_admin))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_IsUnwitnessedWrite" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwitnessedWrite ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
    OPTIONAL { $this effortless-ntwf:denialTestCount ?denial_test_count . }
    OPTIONAL { $this effortless-ntwf:isWriteCommand ?is_write_command . }
                BIND((?is_write_command && (?denial_test_count = 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPolicies_DenialTestCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:denialTestCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPolicies .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AccessDenialTests .
                    ?child effortless-ntwf:targetPolicy $this .
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for AccessPrincipals ===
effortless-ntwf:AccessPrincipalsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AccessPrincipals ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_OrganizationScope" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:organizationScope ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                OPTIONAL { $this effortless-ntwf:domainRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 ; effortless-ntwf:organization ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_RoleLabel" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:roleLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                OPTIONAL { $this effortless-ntwf:domainRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 ; effortless-ntwf:label ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_PolicyCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:policyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AccessPolicies .
                    ?child effortless-ntwf:principal $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_GrantCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:grantCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FieldGrants .
                    ?child effortless-ntwf:principal $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_VisibleTableCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:visibleTableCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleSchemaViews .
                    ?child effortless-ntwf:principal $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_HasNoAccess" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoAccess ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
    OPTIONAL { $this effortless-ntwf:policyCount ?policy_count . }
                BIND((?policy_count = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AccessPrincipals_IsOverPrivileged" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isOverPrivileged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AccessPrincipals .
    OPTIONAL { $this effortless-ntwf:isAdministrator ?is_administrator . }
    OPTIONAL { $this effortless-ntwf:visibleTableCount ?visible_table_count . }
                BIND(((!(COALESCE(?is_administrator, false))) && (?visible_table_count >= 74)) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Actions ===
effortless-ntwf:ActionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Actions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Actions_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Actions .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AgentDecisionRecords ===
effortless-ntwf:AgentDecisionRecordsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AgentDecisionRecords ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:decisionSummary ?decision_summary . }
                BIND(CONCAT(COALESCE(IF(isIRI(?deciding_agent), REPLACE(STR(?deciding_agent), "^.*[#/]", ""), IF(DATATYPE(?deciding_agent) = xsd:dateTime, CONCAT(SUBSTR(STR(?deciding_agent), 1, 10), " ", SUBSTR(STR(?deciding_agent), 12, 8), IF(TZ(?deciding_agent) = "Z", "+00", IF(STRENDS(TZ(?deciding_agent), ":00"), SUBSTR(TZ(?deciding_agent), 1, 3), TZ(?deciding_agent)))), STR(?deciding_agent))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?decision_summary), 1, 60)), REPLACE(STR(SUBSTR(STR(?decision_summary), 1, 60)), "^.*[#/]", ""), IF(DATATYPE(SUBSTR(STR(?decision_summary), 1, 60)) = xsd:dateTime, CONCAT(SUBSTR(STR(SUBSTR(STR(?decision_summary), 1, 60)), 1, 10), " ", SUBSTR(STR(SUBSTR(STR(?decision_summary), 1, 60)), 12, 8), IF(TZ(SUBSTR(STR(?decision_summary), 1, 60)) = "Z", "+00", IF(STRENDS(TZ(SUBSTR(STR(?decision_summary), 1, 60)), ":00"), SUBSTR(TZ(SUBSTR(STR(?decision_summary), 1, 60)), 1, 3), TZ(SUBSTR(STR(?decision_summary), 1, 60))))), STR(SUBSTR(STR(?decision_summary), 1, 60)))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_WasOverridden" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:wasOverridden ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:humanDisposition ?human_disposition . }
                BIND(((REPLACE(COALESCE(STR(?human_disposition), ""), "^.*#", "") = "Corrected") || (REPLACE(COALESCE(STR(?human_disposition), ""), "^.*#", "") = "Reversed")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_WasReviewed" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:wasReviewed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:humanDisposition ?human_disposition . }
                BIND(((REPLACE(COALESCE(STR(?human_disposition), ""), "^.*#", "") != "") && (REPLACE(COALESCE(STR(?human_disposition), ""), "^.*#", "") != "NotReviewed")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_DecidingAgentKind" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:decidingAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
                OPTIONAL { $this effortless-ntwf:decidingAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:agentKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_DecidingAgentWhenOverridden" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:decidingAgentWhenOverridden ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND(IF(COALESCE(?was_overridden, false), ?deciding_agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_RoleAssignmentWhenScored" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:roleAssignmentWhenScored ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:underRoleAssignment ?under_role_assignment . }
                BIND(IF(COALESCE((REPLACE(COALESCE(STR(?under_role_assignment), ""), "^.*#", "") != ""), false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_RoleAssignmentWhenOverridden" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:roleAssignmentWhenOverridden ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:underRoleAssignment ?under_role_assignment . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND(IF(COALESCE(?was_overridden, false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_StepOfDecision" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepOfDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 ; effortless-ntwf:step ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_BoundaryMatchKey" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryMatchKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgentKind ?deciding_agent_kind . }
    OPTIONAL { $this effortless-ntwf:decisionKind ?decision_kind . }
    OPTIONAL { $this effortless-ntwf:stepOfDecision ?step_of_decision . }
                BIND(CONCAT(COALESCE(IF(isIRI(?step_of_decision), REPLACE(STR(?step_of_decision), "^.*[#/]", ""), IF(DATATYPE(?step_of_decision) = xsd:dateTime, CONCAT(SUBSTR(STR(?step_of_decision), 1, 10), " ", SUBSTR(STR(?step_of_decision), 12, 8), IF(TZ(?step_of_decision) = "Z", "+00", IF(STRENDS(TZ(?step_of_decision), ":00"), SUBSTR(TZ(?step_of_decision), 1, 3), TZ(?step_of_decision)))), STR(?step_of_decision))), ""), "|", COALESCE(IF(isIRI(?deciding_agent_kind), REPLACE(STR(?deciding_agent_kind), "^.*[#/]", ""), IF(DATATYPE(?deciding_agent_kind) = xsd:dateTime, CONCAT(SUBSTR(STR(?deciding_agent_kind), 1, 10), " ", SUBSTR(STR(?deciding_agent_kind), 12, 8), IF(TZ(?deciding_agent_kind) = "Z", "+00", IF(STRENDS(TZ(?deciding_agent_kind), ":00"), SUBSTR(TZ(?deciding_agent_kind), 1, 3), TZ(?deciding_agent_kind)))), STR(?deciding_agent_kind))), ""), "|", COALESCE(IF(isIRI(?decision_kind), REPLACE(STR(?decision_kind), "^.*[#/]", ""), IF(DATATYPE(?decision_kind) = xsd:dateTime, CONCAT(SUBSTR(STR(?decision_kind), 1, 10), " ", SUBSTR(STR(?decision_kind), 12, 8), IF(TZ(?decision_kind) = "Z", "+00", IF(STRENDS(TZ(?decision_kind), ":00"), SUBSTR(TZ(?decision_kind), 1, 3), TZ(?decision_kind)))), STR(?decision_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_MatchingBoundaryCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:matchingBoundaryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AuthorityBoundaries .
                    $this effortless-ntwf:boundaryMatchKey ?p0 .
                    ?child effortless-ntwf:boundaryMatchKey ?c0 .
                    FILTER(IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_ViolatedAuthorityBoundary" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:violatedAuthorityBoundary ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:matchingBoundaryCount ?matching_boundary_count . }
                BIND((?matching_boundary_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_ReviewerAgentKind" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:reviewerAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
                OPTIONAL { $this effortless-ntwf:reviewedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:agentKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_HasHumanConfirmation" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasHumanConfirmation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:humanDisposition ?human_disposition . }
    OPTIONAL { $this effortless-ntwf:reviewerAgentKind ?reviewer_agent_kind . }
                BIND(((REPLACE(COALESCE(STR(?reviewer_agent_kind), ""), "^.*#", "") = "Human") && (REPLACE(COALESCE(STR(?human_disposition), ""), "^.*#", "") != "") && (REPLACE(COALESCE(STR(?human_disposition), ""), "^.*#", "") != "NotReviewed")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_NeedsHumanConfirmation" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:needsHumanConfirmation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgentKind ?deciding_agent_kind . }
    OPTIONAL { $this effortless-ntwf:materialityBand ?materiality_band . }
                BIND(((!((REPLACE(COALESCE(STR(?deciding_agent_kind), ""), "^.*#", "") = "Human"))) && ((REPLACE(COALESCE(STR(?materiality_band), ""), "^.*#", "") = "Material") || (REPLACE(COALESCE(STR(?materiality_band), ""), "^.*#", "") = "Escalated"))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsUnconfirmedNonHumanDecision" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnconfirmedNonHumanDecision ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:hasHumanConfirmation ?has_human_confirmation . }
    OPTIONAL { $this effortless-ntwf:needsHumanConfirmation ?needs_human_confirmation . }
                BIND((?needs_human_confirmation && (!(?has_human_confirmation))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_StepExecutionWhenUnconfirmed" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepExecutionWhenUnconfirmed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:isUnconfirmedNonHumanDecision ?is_unconfirmed_non_human_decision . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_unconfirmed_non_human_decision, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_AgentWhenBoundaryViolated" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:agentWhenBoundaryViolated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:violatedAuthorityBoundary ?violated_authority_boundary . }
                BIND(IF(COALESCE(?violated_authority_boundary, false), ?deciding_agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_ReviewLatencyMinutes" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:reviewLatencyMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidedAt ?decided_at . }
    OPTIONAL { $this effortless-ntwf:reviewedAt ?reviewed_at . }
                BIND(IF(COALESCE((REPLACE(COALESCE(STR(?reviewed_at), ""), "^.*#", "") = ""), false), 0, ROUND((((DAY(?reviewed_at) + FLOOR((153 * (MONTH(?reviewed_at) + 12 * FLOOR((14 - MONTH(?reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 400) - 32045) * 86400 + COALESCE(HOURS(?reviewed_at), 0) * 3600 + COALESCE(MINUTES(?reviewed_at), 0) * 60 + COALESCE(SECONDS(?reviewed_at), 0) - IF(TZ(?reviewed_at) = "" || TZ(?reviewed_at) = "Z", 0, IF(SUBSTR(TZ(?reviewed_at), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?reviewed_at), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?reviewed_at), 5, 2)) * 60))) - ((DAY(?decided_at) + FLOOR((153 * (MONTH(?decided_at) + 12 * FLOOR((14 - MONTH(?decided_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 4) - FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 100) + FLOOR((YEAR(?decided_at) + 4800 - FLOOR((14 - MONTH(?decided_at)) / 12)) / 400) - 32045) * 86400 + COALESCE(HOURS(?decided_at), 0) * 3600 + COALESCE(MINUTES(?decided_at), 0) * 60 + COALESCE(SECONDS(?decided_at), 0) - IF(TZ(?decided_at) = "" || TZ(?decided_at) = "Z", 0, IF(SUBSTR(TZ(?decided_at), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?decided_at), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?decided_at), 5, 2)) * 60)))) / 60)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsDraftKind" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isDraftKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decisionKind ?decision_kind . }
                BIND(((REPLACE(COALESCE(STR(?decision_kind), ""), "^.*#", "") = "Draft") || (REPLACE(COALESCE(STR(?decision_kind), ""), "^.*#", "") = "Commitment")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_AgentWhenDraftOverridden" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:agentWhenDraftOverridden ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:isDraftKind ?is_draft_kind . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND(IF(COALESCE((?is_draft_kind && ?was_overridden), false), ?deciding_agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_AgentWhenDraft" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:agentWhenDraft ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:decidingAgent ?deciding_agent . }
    OPTIONAL { $this effortless-ntwf:isDraftKind ?is_draft_kind . }
                BIND(IF(COALESCE(?is_draft_kind, false), ?deciding_agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsErrorCorrection" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isErrorCorrection ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:overrideReasonKind ?override_reason_kind . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND((?was_overridden && (REPLACE(COALESCE(STR(?override_reason_kind), ""), "^.*#", "") = "ErrorCorrection")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsReservedJudgmentOverride" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isReservedJudgmentOverride ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:overrideReasonKind ?override_reason_kind . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND((?was_overridden && (REPLACE(COALESCE(STR(?override_reason_kind), ""), "^.*#", "") = "JudgmentReserved")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_OverrideReasonIsRecorded" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:overrideReasonIsRecorded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:overrideReasonKind ?override_reason_kind . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND((?was_overridden && (REPLACE(COALESCE(STR(?override_reason_kind), ""), "^.*#", "") != "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_IsUnexplainedOverride" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnexplainedOverride ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:overrideReasonIsRecorded ?override_reason_is_recorded . }
    OPTIONAL { $this effortless-ntwf:wasOverridden ?was_overridden . }
                BIND((?was_overridden && (!(?override_reason_is_recorded))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_ErrorCorrectionRoleAssignmentKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:errorCorrectionRoleAssignmentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:isErrorCorrection ?is_error_correction . }
    OPTIONAL { $this effortless-ntwf:underRoleAssignment ?under_role_assignment . }
                BIND(IF(COALESCE(?is_error_correction, false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AgentDecisionRecords_BoundaryViolationRoleAssignmentKey" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryViolationRoleAssignmentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AgentDecisionRecords .
    OPTIONAL { $this effortless-ntwf:underRoleAssignment ?under_role_assignment . }
    OPTIONAL { $this effortless-ntwf:violatedAuthorityBoundary ?violated_authority_boundary . }
                BIND(IF(COALESCE(?violated_authority_boundary, false), ?under_role_assignment, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Agents ===
effortless-ntwf:AgentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Agents ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_CountOfCurrentRoleAssignments" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfCurrentRoleAssignments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    $this effortless-ntwf:agentId ?p0 .
                    ?child effortless-ntwf:currentAgentKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_IsStillEngaged" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Agents .
    OPTIONAL { $this effortless-ntwf:countOfCurrentRoleAssignments ?count_of_current_role_assignments . }
                BIND((?count_of_current_role_assignments > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Agents_DecisionCount" ;
