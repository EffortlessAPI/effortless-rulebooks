    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:isDecided ?is_decided . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND(((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "UnderReview") && (!(?is_decided))) AS ?_result)
            }
