                $this effortless-ntwf:countOfOverdueGaps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeGaps .
                    OPTIONAL { ?child effortless-ntwf:isOverdueGap ?c0 . }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfChangeRequests" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfChangeRequests ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeRequests .
                    ?child effortless-ntwf:procedureVersion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfReviewEvents" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfReviewEvents ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ReviewEvents .
                    ?child effortless-ntwf:procedureVersion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HasGovernanceRecord" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasGovernanceRecord ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:countOfChangeRequests ?count_of_change_requests . }
    OPTIONAL { $this effortless-ntwf:countOfReviewEvents ?count_of_review_events . }
                BIND(((?count_of_change_requests > 0) || (?count_of_review_events > 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_AsOfInstant" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 ; effortless-ntwf:asOfInstant ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_DaysSinceModified" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceModified ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:modifiedAt ?modified_at . }
                BIND(IF(isNumeric(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?modified_at) + FLOOR((153 * (MONTH(?modified_at) + 12 * FLOOR((14 - MONTH(?modified_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) + FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 4) - FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 100) + FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 400) - 32045))), ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?modified_at) + FLOOR((153 * (MONTH(?modified_at) + 12 * FLOOR((14 - MONTH(?modified_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) + FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 4) - FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 100) + FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 400) - 32045))), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?modified_at) + FLOOR((153 * (MONTH(?modified_at) + 12 * FLOOR((14 - MONTH(?modified_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) + FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 4) - FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 100) + FLOOR((YEAR(?modified_at) + 4800 - FLOOR((14 - MONTH(?modified_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_DaysSinceLastReview" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceLastReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
                {
                    SELECT (MAX(?aggval) AS ?_agg0) WHERE {
                    ?child a effortless-ntwf:ReviewEvents .
                    ?child effortless-ntwf:procedureVersion $this .
                    ?child effortless-ntwf:reviewedAt ?aggval .
                    }
                }
                BIND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?_agg0) + FLOOR((153 * (MONTH(?_agg0) + 12 * FLOOR((14 - MONTH(?_agg0)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?_agg0) + 4800 - FLOOR((14 - MONTH(?_agg0)) / 12)) + FLOOR((YEAR(?_agg0) + 4800 - FLOOR((14 - MONTH(?_agg0)) / 12)) / 4) - FLOOR((YEAR(?_agg0) + 4800 - FLOOR((14 - MONTH(?_agg0)) / 12)) / 100) + FLOOR((YEAR(?_agg0) + 4800 - FLOOR((14 - MONTH(?_agg0)) / 12)) / 400) - 32045)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_WasModifiedSinceLastReview" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:wasModifiedSinceLastReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:daysSinceLastReview ?days_since_last_review . }
    OPTIONAL { $this effortless-ntwf:daysSinceModified ?days_since_modified . }
                BIND((?days_since_modified < ?days_since_last_review) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ModifierIsAuthority" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:modifierIsAuthority ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                OPTIONAL { $this effortless-ntwf:modifiedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:agentKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HasUnwitnessedChange" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasUnwitnessedChange ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:isLive ?is_live . }
    OPTIONAL { $this effortless-ntwf:wasModifiedSinceLastReview ?was_modified_since_last_review . }
                BIND((?is_live && ?was_modified_since_last_review) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfStaleFragments" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfStaleFragments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeFragments .
                    OPTIONAL { ?child effortless-ntwf:exceedsOwningCadence ?c0 . }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_KnowledgeIsStalerThanCadence" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:knowledgeIsStalerThanCadence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:countOfStaleFragments ?count_of_stale_fragments . }
                BIND((?count_of_stale_fragments > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CompoundFragileFragmentCount" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:compoundFragileFragmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeFragments .
                    $this effortless-ntwf:procedureVersionId ?p0 .
                    ?child effortless-ntwf:compoundFragileVersionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_RestsOnCompoundFragileKnowledge" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:restsOnCompoundFragileKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:compoundFragileFragmentCount ?compound_fragile_fragment_count . }
    OPTIONAL { $this effortless-ntwf:isLive ?is_live . }
