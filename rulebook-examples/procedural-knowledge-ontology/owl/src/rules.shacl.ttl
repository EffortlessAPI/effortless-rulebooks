    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
                BIND(((REPLACE(COALESCE(STR(?owner_role_agent_kind), ""), "^.*#", "") != "") && (?valid_from < ?owner_role_assignment_valid_from)) AS ?_result)
