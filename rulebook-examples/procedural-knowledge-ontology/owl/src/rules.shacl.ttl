    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_DaysSinceActualReview" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceActualReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:hasReviewRecord ?has_review_record . }
    OPTIONAL { $this effortless-ntwf:lastReviewedAt ?last_reviewed_at . }
                BIND(IF(isNumeric(IF(COALESCE(?has_review_record, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_reviewed_at) + FLOOR((153 * (MONTH(?last_reviewed_at) + 12 * FLOOR((14 - MONTH(?last_reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) + FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 400) - 32045)), 0)), ROUND(IF(COALESCE(?has_review_record, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_reviewed_at) + FLOOR((153 * (MONTH(?last_reviewed_at) + 12 * FLOOR((14 - MONTH(?last_reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) + FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 400) - 32045)), 0)), IF(COALESCE(?has_review_record, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_reviewed_at) + FLOOR((153 * (MONTH(?last_reviewed_at) + 12 * FLOOR((14 - MONTH(?last_reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) + FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?last_reviewed_at) + 4800 - FLOOR((14 - MONTH(?last_reviewed_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsUnreviewedSinceAuthoring" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnreviewedSinceAuthoring ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:hasReviewRecord ?has_review_record . }
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
                BIND((?is_currently_valid && (!(?has_review_record))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsGenuinelyOverdue" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isGenuinelyOverdue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:daysSinceActualReview ?days_since_actual_review . }
    OPTIONAL { $this effortless-ntwf:hasReviewRecord ?has_review_record . }
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this effortless-ntwf:reviewCadenceDays ?review_cadence_days . }
                BIND((?is_currently_valid && ?has_review_record && (?days_since_actual_review > ?review_cadence_days)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_ReviewRecencyIsInferred" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:reviewRecencyIsInferred ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:hasReviewRecord ?has_review_record . }
    OPTIONAL { $this effortless-ntwf:isOverdueForReview ?is_overdue_for_review . }
                BIND((?is_overdue_for_review && (!(?has_review_record))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_InferenceDisagreesWithRecord" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:inferenceDisagreesWithRecord ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:hasReviewRecord ?has_review_record . }
    OPTIONAL { $this effortless-ntwf:isGenuinelyOverdue ?is_genuinely_overdue . }
    OPTIONAL { $this effortless-ntwf:isOverdueForReview ?is_overdue_for_review . }
                BIND((?has_review_record && ?is_overdue_for_review && (!(?is_genuinely_overdue))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_GenuinelyOverdueVersionKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:genuinelyOverdueVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isGenuinelyOverdue ?is_genuinely_overdue . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_genuinely_overdue, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_RatifiedBoundaryCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ratifiedBoundaryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AuthorityBoundaries .
                    $this effortless-ntwf:knowledgeFragmentId ?p0 .
                    ?child effortless-ntwf:ratifyingFragmentKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_RelianceSurfaceCount" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:relianceSurfaceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isInvokedByAnException ?is_invoked_by_an_exception . }
    OPTIONAL { $this effortless-ntwf:ratifiedBoundaryCount ?ratified_boundary_count . }
                BIND(IF(isNumeric((?is_invoked_by_an_exception + ?ratified_boundary_count)), ROUND((?is_invoked_by_an_exception + ?ratified_boundary_count)), (?is_invoked_by_an_exception + ?ratified_boundary_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_DaysAwaitingMyApproval" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:daysAwaitingMyApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:isMyUnfinishedApproval ?is_my_unfinished_approval . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
                BIND(IF(isNumeric(IF(COALESCE(?is_my_unfinished_approval, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?valid_from) + FLOOR((153 * (MONTH(?valid_from) + 12 * FLOOR((14 - MONTH(?valid_from)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 4) - FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 100) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 400) - 32045)), 0)), ROUND(IF(COALESCE(?is_my_unfinished_approval, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?valid_from) + FLOOR((153 * (MONTH(?valid_from) + 12 * FLOOR((14 - MONTH(?valid_from)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 4) - FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 100) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 400) - 32045)), 0)), IF(COALESCE(?is_my_unfinished_approval, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?valid_from) + FLOOR((153 * (MONTH(?valid_from) + 12 * FLOOR((14 - MONTH(?valid_from)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 4) - FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 100) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsHighBlastRadiusUnapproved" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isHighBlastRadiusUnapproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isUnapprovedAndOperationallyLive ?is_unapproved_and_operationally_live . }
    OPTIONAL { $this effortless-ntwf:relianceSurfaceCount ?reliance_surface_count . }
                BIND((?is_unapproved_and_operationally_live && (?reliance_surface_count > 1)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsLongUnapproved" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isLongUnapproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:daysAwaitingMyApproval ?days_awaiting_my_approval . }
    OPTIONAL { $this effortless-ntwf:isMyUnfinishedApproval ?is_my_unfinished_approval . }
                BIND((?is_my_unfinished_approval && (?days_awaiting_my_approval > 30)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_UnapprovedLoadBearingVersionKey" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unapprovedLoadBearingVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isHighBlastRadiusUnapproved ?is_high_blast_radius_unapproved . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_high_blast_radius_unapproved, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_OwnerRoleIsVacated" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ownerRoleIsVacated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:ownerRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 ; effortless-ntwf:isVacatedRole ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsOrphanedByRole" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isOrphanedByRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this effortless-ntwf:ownerRoleIsVacated ?owner_role_is_vacated . }
                BIND((?is_currently_valid && ?owner_role_is_vacated) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_ValidFragmentVersionKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:validFragmentVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_currently_valid, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeGaps ===
effortless-ntwf:KnowledgeGapsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeGaps ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:severity ?severity . }
    OPTIONAL { $this effortless-ntwf:statement ?statement . }
                BIND(CONCAT(COALESCE(IF(isIRI(?severity), REPLACE(STR(?severity), "^.*[#/]", ""), IF(DATATYPE(?severity) = xsd:dateTime, CONCAT(SUBSTR(STR(?severity), 1, 10), " ", SUBSTR(STR(?severity), 12, 8), IF(TZ(?severity) = "Z", "+00", IF(STRENDS(TZ(?severity), ":00"), SUBSTR(TZ(?severity), 1, 3), TZ(?severity)))), STR(?severity))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?statement), 1, 60)), REPLACE(STR(SUBSTR(STR(?statement), 1, 60)), "^.*[#/]", ""), IF(DATATYPE(SUBSTR(STR(?statement), 1, 60)) = xsd:dateTime, CONCAT(SUBSTR(STR(SUBSTR(STR(?statement), 1, 60)), 1, 10), " ", SUBSTR(STR(SUBSTR(STR(?statement), 1, 60)), 12, 8), IF(TZ(SUBSTR(STR(?statement), 1, 60)) = "Z", "+00", IF(STRENDS(TZ(SUBSTR(STR(?statement), 1, 60)), ":00"), SUBSTR(TZ(SUBSTR(STR(?statement), 1, 60)), 1, 3), TZ(SUBSTR(STR(?statement), 1, 60))))), STR(SUBSTR(STR(?statement), 1, 60)))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsOpen" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isOpen ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND(((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Open") || (REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Investigating")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OpenGapVersionKey" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:openGapVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:isOpen ?is_open . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
    OPTIONAL { $this effortless-ntwf:severity ?severity . }
                BIND(IF(COALESCE((?is_open && (REPLACE(COALESCE(STR(?severity), ""), "^.*#", "") = "High")), false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsBlocking" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:blockingKind ?blocking_kind . }
                BIND((REPLACE(COALESCE(STR(?blocking_kind), ""), "^.*#", "") = "Blocking") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsOpenAndBlocking" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isOpenAndBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
    OPTIONAL { $this effortless-ntwf:isOpen ?is_open . }
                BIND((?is_open && ?is_blocking) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_AsOfInstant" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 ; effortless-ntwf:asOfInstant ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_DaysOpen" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:daysOpen ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:identifiedAt ?identified_at . }
    OPTIONAL { $this effortless-ntwf:isOpen ?is_open . }
                BIND(IF(isNumeric(IF(COALESCE(?is_open, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?identified_at) + FLOOR((153 * (MONTH(?identified_at) + 12 * FLOOR((14 - MONTH(?identified_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) + FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 4) - FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 100) + FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 400) - 32045)), 0)), ROUND(IF(COALESCE(?is_open, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?identified_at) + FLOOR((153 * (MONTH(?identified_at) + 12 * FLOOR((14 - MONTH(?identified_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) + FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 4) - FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 100) + FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 400) - 32045)), 0)), IF(COALESCE(?is_open, false), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?identified_at) + FLOOR((153 * (MONTH(?identified_at) + 12 * FLOOR((14 - MONTH(?identified_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) + FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 4) - FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 100) + FLOOR((YEAR(?identified_at) + 4800 - FLOOR((14 - MONTH(?identified_at)) / 12)) / 400) - 32045)), 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_ToleranceDays" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:toleranceDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:severity ?severity . }
                BIND(IF(isNumeric(IF(COALESCE((REPLACE(COALESCE(STR(?severity), ""), "^.*#", "") = "High"), false), 30, IF(COALESCE((REPLACE(COALESCE(STR(?severity), ""), "^.*#", "") = "Medium"), false), 90, 180))), ROUND(IF(COALESCE((REPLACE(COALESCE(STR(?severity), ""), "^.*#", "") = "High"), false), 30, IF(COALESCE((REPLACE(COALESCE(STR(?severity), ""), "^.*#", "") = "Medium"), false), 90, 180))), IF(COALESCE((REPLACE(COALESCE(STR(?severity), ""), "^.*#", "") = "High"), false), 30, IF(COALESCE((REPLACE(COALESCE(STR(?severity), ""), "^.*#", "") = "Medium"), false), 90, 180))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsOverdueGap" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isOverdueGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:daysOpen ?days_open . }
    OPTIONAL { $this effortless-ntwf:toleranceDays ?tolerance_days . }
                BIND((?days_open > ?tolerance_days) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OwnerAgent" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ownerAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
                OPTIONAL { $this effortless-ntwf:ownerRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 ; effortless-ntwf:currentAgent ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OwnerIsStillEngaged" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ownerIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
                OPTIONAL { $this effortless-ntwf:ownerAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:isStillEngaged ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_HasResolutionPlan" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasResolutionPlan ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:resolutionPlan ?resolution_plan . }
                BIND((REPLACE(COALESCE(STR(?resolution_plan), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsAbandonedUnknown" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isAbandonedUnknown ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:hasResolutionPlan ?has_resolution_plan . }
    OPTIONAL { $this effortless-ntwf:isOverdueGap ?is_overdue_gap . }
    OPTIONAL { $this effortless-ntwf:ownerIsStillEngaged ?owner_is_still_engaged . }
                BIND((?is_overdue_gap && ((!(?has_resolution_plan)) || (!(?owner_is_still_engaged)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OpenBlockingGapVersionKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:openBlockingGapVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:isOpenAndBlocking ?is_open_and_blocking . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_open_and_blocking, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_OwnerRoleIsVacated" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ownerRoleIsVacated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
                OPTIONAL { $this effortless-ntwf:ownerRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 ; effortless-ntwf:isVacatedRole ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeGaps_IsOwnerlessOpenGap" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isOwnerlessOpenGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeGaps .
    OPTIONAL { $this effortless-ntwf:isOpen ?is_open . }
    OPTIONAL { $this effortless-ntwf:ownerRoleIsVacated ?owner_role_is_vacated . }
                BIND((?is_open && ?owner_role_is_vacated) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for LearningActivities ===
effortless-ntwf:LearningActivitiesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:LearningActivities ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LearningActivities_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:LearningActivities .
    OPTIONAL { $this effortless-ntwf:activityKind ?activity_kind . }
    OPTIONAL { $this effortless-ntwf:occurredAt ?occurred_at . }
                BIND(CONCAT(COALESCE(IF(isIRI(?activity_kind), REPLACE(STR(?activity_kind), "^.*[#/]", ""), IF(DATATYPE(?activity_kind) = xsd:dateTime, CONCAT(SUBSTR(STR(?activity_kind), 1, 10), " ", SUBSTR(STR(?activity_kind), 12, 8), IF(TZ(?activity_kind) = "Z", "+00", IF(STRENDS(TZ(?activity_kind), ":00"), SUBSTR(TZ(?activity_kind), 1, 3), TZ(?activity_kind)))), STR(?activity_kind))), ""), " / ", COALESCE(IF(isIRI(?occurred_at), REPLACE(STR(?occurred_at), "^.*[#/]", ""), IF(DATATYPE(?occurred_at) = xsd:dateTime, CONCAT(SUBSTR(STR(?occurred_at), 1, 10), " ", SUBSTR(STR(?occurred_at), 12, 8), IF(TZ(?occurred_at) = "Z", "+00", IF(STRENDS(TZ(?occurred_at), ":00"), SUBSTR(TZ(?occurred_at), 1, 3), TZ(?occurred_at)))), STR(?occurred_at))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Mentorships ===
effortless-ntwf:MentorshipsShape a sh:NodeShape ;
