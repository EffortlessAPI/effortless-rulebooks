    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Steps_IsUnexercisedHumanGate" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnexercisedHumanGate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:hasBeenApproachedBySoftware ?has_been_approached_by_software . }
    OPTIONAL { $this effortless-ntwf:isHumanApprovalGate ?is_human_approval_gate . }
                BIND((?is_human_approval_gate && (!(?has_been_approached_by_software))) AS ?_result)
            }
        """ ;
