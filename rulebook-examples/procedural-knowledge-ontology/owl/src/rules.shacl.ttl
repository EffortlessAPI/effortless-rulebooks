    OPTIONAL { $this effortless-ntwf:policyRequiresOptOut ?policy_requires_opt_out . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((?was_actually_transmitted && (?policy_requires_opt_out && (!(?has_opt_out_phrase)))) AS ?_result)
            }
