            }
        """ ;
    ] .

# === Shape with rules for ProcedureVersionLinks ===
effortless-ntwf:ProcedureVersionLinksShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureVersionLinks ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersionLinks_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersionLinks .
    OPTIONAL { $this effortless-ntwf:nextProcedureVersion ?next_procedure_version . }
    OPTIONAL { $this effortless-ntwf:previousProcedureVersion ?previous_procedure_version . }
                BIND(CONCAT(COALESCE(IF(isIRI(?previous_procedure_version), REPLACE(STR(?previous_procedure_version), "^.*[#/]", ""), IF(DATATYPE(?previous_procedure_version) = xsd:dateTime, CONCAT(SUBSTR(STR(?previous_procedure_version), 1, 10), " ", SUBSTR(STR(?previous_procedure_version), 12, 8), IF(TZ(?previous_procedure_version) = "Z", "+00", IF(STRENDS(TZ(?previous_procedure_version), ":00"), SUBSTR(TZ(?previous_procedure_version), 1, 3), TZ(?previous_procedure_version)))), STR(?previous_procedure_version))), ""), " -> ", COALESCE(IF(isIRI(?next_procedure_version), REPLACE(STR(?next_procedure_version), "^.*[#/]", ""), IF(DATATYPE(?next_procedure_version) = xsd:dateTime, CONCAT(SUBSTR(STR(?next_procedure_version), 1, 10), " ", SUBSTR(STR(?next_procedure_version), 12, 8), IF(TZ(?next_procedure_version) = "Z", "+00", IF(STRENDS(TZ(?next_procedure_version), ":00"), SUBSTR(TZ(?next_procedure_version), 1, 3), TZ(?next_procedure_version)))), STR(?next_procedure_version))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersionLinks_SupersededVersionKey" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:supersededVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersionLinks .
    OPTIONAL { $this effortless-ntwf:previousProcedureVersion ?previous_procedure_version . }
    OPTIONAL { $this effortless-ntwf:relationIri ?relation_iri . }
                BIND(IF(COALESCE((COALESCE(STR(?relation_iri), "") = "https://w3id.org/pko#nextVersion"), false), ?previous_procedure_version, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcedureVersions ===
effortless-ntwf:ProcedureVersionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcedureVersions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfSteps" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfSteps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:procedureVersion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfOpenKnowledgeGaps" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfOpenKnowledgeGaps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeGaps .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:status ?c2 . }
                    FILTER(STR(?c2) = "Open")
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsReadyForExecution" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isReadyForExecution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:countOfOpenKnowledgeGaps ?count_of_open_knowledge_gaps . }
    OPTIONAL { $this effortless-ntwf:countOfSteps ?count_of_steps . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND(((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved") && (?count_of_steps > 0) && (?count_of_open_knowledge_gaps = 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_SpecifiedStepCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:specifiedStepCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    ?child effortless-ntwf:procedureVersion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_OverdueReviewCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:overdueReviewCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ReviewEvents .
                    $this effortless-ntwf:procedureVersionId ?p0 .
                    ?child effortless-ntwf:overdueVersionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_OpenChangeRequestCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:openChangeRequestCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeRequests .
                    $this effortless-ntwf:procedureVersionId ?p0 .
                    ?child effortless-ntwf:openChangeVersionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_OpenHighSeverityGapCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:openHighSeverityGapCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeGaps .
                    $this effortless-ntwf:procedureVersionId ?p0 .
                    ?child effortless-ntwf:openGapVersionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsFitToExecute" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isFitToExecute ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:openChangeRequestCount ?open_change_request_count . }
    OPTIONAL { $this effortless-ntwf:openHighSeverityGapCount ?open_high_severity_gap_count . }
    OPTIONAL { $this effortless-ntwf:overdueReviewCount ?overdue_review_count . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND(((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved") && (?overdue_review_count = 0) && (?open_change_request_count = 0) && (?open_high_severity_gap_count = 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_StewardReviewCadenceDays" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stewardReviewCadenceDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (SUM(?sumval) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StewardshipAssignments .
                    ?child effortless-ntwf:procedureVersion $this .
                    OPTIONAL { ?child effortless-ntwf:reviewCadenceDays ?sumraw . }
                    BIND(COALESCE(?sumraw, 0) AS ?sumval)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfStewardshipAssignments" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfStewardshipAssignments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StewardshipAssignments .
                    ?child effortless-ntwf:procedureVersion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HasAnySteward" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasAnySteward ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:countOfStewardshipAssignments ?count_of_stewardship_assignments . }
                BIND((?count_of_stewardship_assignments > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsLive" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isLive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND(((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved") || (REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Published")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsUnstewarded" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnstewarded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:hasAnySteward ?has_any_steward . }
                BIND((!(?has_any_steward)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsLiveAndUnstewarded" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isLiveAndUnstewarded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:isLive ?is_live . }
    OPTIONAL { $this effortless-ntwf:isUnstewarded ?is_unstewarded . }
                BIND((?is_live && ?is_unstewarded) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfOpenBlockingGaps" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfOpenBlockingGaps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeGaps .
                    OPTIONAL { ?child effortless-ntwf:isOpenAndBlocking ?c0 . }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HasOpenBlockingGap" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasOpenBlockingGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:countOfOpenBlockingGaps ?count_of_open_blocking_gaps . }
                BIND((?count_of_open_blocking_gaps > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsLiveWithBlockingGap" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isLiveWithBlockingGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:hasOpenBlockingGap ?has_open_blocking_gap . }
    OPTIONAL { $this effortless-ntwf:isLive ?is_live . }
                BIND((?is_live && ?has_open_blocking_gap) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ShouldNotBeExecutable" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:shouldNotBeExecutable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:hasOpenBlockingGap ?has_open_blocking_gap . }
    OPTIONAL { $this effortless-ntwf:isReadyForExecution ?is_ready_for_execution . }
                BIND((?is_ready_for_execution && ?has_open_blocking_gap) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfUnapprovedRelianceFragments" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfUnapprovedRelianceFragments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:KnowledgeFragments .
                    OPTIONAL { ?child effortless-ntwf:isUnapprovedButReliedOn ?c0 . }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_RunsOnUnapprovedKnowledge" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:runsOnUnapprovedKnowledge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:countOfUnapprovedRelianceFragments ?count_of_unapproved_reliance_fragments . }
                BIND((?count_of_unapproved_reliance_fragments > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_CountOfOverdueGaps" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
