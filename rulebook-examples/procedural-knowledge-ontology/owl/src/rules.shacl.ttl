    $this a effortless-ntwf:AppRouteReferences .
    OPTIONAL { $this effortless-ntwf:fromRoute ?from_route . }
    OPTIONAL { $this effortless-ntwf:toRoute ?to_route . }
                BIND(CONCAT(COALESCE(IF(isIRI(?from_route), REPLACE(STR(?from_route), "^.*[#/]", ""), IF(DATATYPE(?from_route) = xsd:dateTime, CONCAT(SUBSTR(STR(?from_route), 1, 10), " ", SUBSTR(STR(?from_route), 12, 8), IF(TZ(?from_route) = "Z", "+00", IF(STRENDS(TZ(?from_route), ":00"), SUBSTR(TZ(?from_route), 1, 3), TZ(?from_route)))), STR(?from_route))), ""), " -> ", COALESCE(IF(isIRI(?to_route), REPLACE(STR(?to_route), "^.*[#/]", ""), IF(DATATYPE(?to_route) = xsd:dateTime, CONCAT(SUBSTR(STR(?to_route), 1, 10), " ", SUBSTR(STR(?to_route), 12, 8), IF(TZ(?to_route) = "Z", "+00", IF(STRENDS(TZ(?to_route), ":00"), SUBSTR(TZ(?to_route), 1, 3), TZ(?to_route)))), STR(?to_route))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AppRoutes ===
effortless-ntwf:AppRoutesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppRoutes ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:routeName ?route_name . }
    OPTIONAL { $this effortless-ntwf:routePath ?route_path . }
                BIND(CONCAT(COALESCE(IF(isIRI(?route_name), REPLACE(STR(?route_name), "^.*[#/]", ""), IF(DATATYPE(?route_name) = xsd:dateTime, CONCAT(SUBSTR(STR(?route_name), 1, 10), " ", SUBSTR(STR(?route_name), 12, 8), IF(TZ(?route_name) = "Z", "+00", IF(STRENDS(TZ(?route_name), ":00"), SUBSTR(TZ(?route_name), 1, 3), TZ(?route_name)))), STR(?route_name))), ""), " — ", COALESCE(IF(isIRI(?route_path), REPLACE(STR(?route_path), "^.*[#/]", ""), IF(DATATYPE(?route_path) = xsd:dateTime, CONCAT(SUBSTR(STR(?route_path), 1, 10), " ", SUBSTR(STR(?route_path), 12, 8), IF(TZ(?route_path) = "Z", "+00", IF(STRENDS(TZ(?route_path), ":00"), SUBSTR(TZ(?route_path), 1, 3), TZ(?route_path)))), STR(?route_path))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_IsInNav" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isInNav ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:navGroup ?nav_group . }
                BIND((REPLACE(COALESCE(STR(?nav_group), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_IsShared" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isShared ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:owningRole ?owning_role . }
    OPTIONAL { $this effortless-ntwf:surface ?surface . }
                BIND(((REPLACE(COALESCE(STR(?owning_role), ""), "^.*#", "") = "") && (REPLACE(COALESCE(STR(?surface), ""), "^.*#", "") = "domain")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_IsMaintainer" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isMaintainer ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:surface ?surface . }
                BIND((REPLACE(COALESCE(STR(?surface), ""), "^.*#", "") = "maintainer") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_QuestionCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:questionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AppRouteQuestions .
                    ?child effortless-ntwf:route $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_ReferenceCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:referenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AppRouteReferences .
                    ?child effortless-ntwf:fromRoute $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppRoutes_AnswersNoQuestion" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:answersNoQuestion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppRoutes .
    OPTIONAL { $this effortless-ntwf:isMaintainer ?is_maintainer . }
    OPTIONAL { $this effortless-ntwf:isShared ?is_shared . }
    OPTIONAL { $this effortless-ntwf:questionCount ?question_count . }
    OPTIONAL { $this effortless-ntwf:routeKind ?route_kind . }
                BIND(((?question_count = 0) && (?is_shared = false) && (?is_maintainer = false) && (REPLACE(COALESCE(STR(?route_kind), ""), "^.*#", "") != "index")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AppUsers ===
effortless-ntwf:AppUsersShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AppUsers ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
    OPTIONAL { $this effortless-ntwf:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_AgentKind" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:agentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
                OPTIONAL { $this effortless-ntwf:linkedAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:agentKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_Organization" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:organization ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
                OPTIONAL { $this effortless-ntwf:linkedAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:organization ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_AssignmentCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:assignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:PrincipalAssignments .
                    ?child effortless-ntwf:appUser $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_HasNoPrincipal" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoPrincipal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
    OPTIONAL { $this effortless-ntwf:assignmentCount ?assignment_count . }
                BIND((?assignment_count = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_HoldsMultiplePrincipals" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:holdsMultiplePrincipals ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
    OPTIONAL { $this effortless-ntwf:assignmentCount ?assignment_count . }
                BIND((?assignment_count > 1) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AppUsers_IsNonHumanSignIn" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isNonHumanSignIn ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AppUsers .
    OPTIONAL { $this effortless-ntwf:agentKind ?agent_kind . }
                BIND(((REPLACE(COALESCE(STR(?agent_kind), ""), "^.*#", "") = "AIAgent") || (REPLACE(COALESCE(STR(?agent_kind), ""), "^.*#", "") = "AutomatedPipeline")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Attestations ===
effortless-ntwf:AttestationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Attestations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
    OPTIONAL { $this effortless-ntwf:attestationId ?attestation_id . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(CONCAT(COALESCE(IF(isIRI(?procedure_execution), REPLACE(STR(?procedure_execution), "^.*[#/]", ""), IF(DATATYPE(?procedure_execution) = xsd:dateTime, CONCAT(SUBSTR(STR(?procedure_execution), 1, 10), " ", SUBSTR(STR(?procedure_execution), 12, 8), IF(TZ(?procedure_execution) = "Z", "+00", IF(STRENDS(TZ(?procedure_execution), ":00"), SUBSTR(TZ(?procedure_execution), 1, 3), TZ(?procedure_execution)))), STR(?procedure_execution))), ""), " / ", COALESCE(IF(isIRI(?attestation_id), REPLACE(STR(?attestation_id), "^.*[#/]", ""), IF(DATATYPE(?attestation_id) = xsd:dateTime, CONCAT(SUBSTR(STR(?attestation_id), 1, 10), " ", SUBSTR(STR(?attestation_id), 12, 8), IF(TZ(?attestation_id) = "Z", "+00", IF(STRENDS(TZ(?attestation_id), ":00"), SUBSTR(TZ(?attestation_id), 1, 3), TZ(?attestation_id)))), STR(?attestation_id))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_VersionIsFitNow" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:versionIsFitNow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
                OPTIONAL { $this effortless-ntwf:procedureExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureExecutions ; effortless-ntwf:procedureExecutionId ?j2 ; effortless-ntwf:executedVersionIsFit ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_FitnessVerdictHasDrifted" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:fitnessVerdictHasDrifted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
    OPTIONAL { $this effortless-ntwf:versionIsFitNow ?version_is_fit_now . }
    OPTIONAL { $this effortless-ntwf:versionWasFitAtSigning ?version_was_fit_at_signing . }
                BIND((!((?version_was_fit_at_signing = ?version_is_fit_now))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_AssuranceGradeNow" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:assuranceGradeNow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
                OPTIONAL { $this effortless-ntwf:procedureExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureExecutions ; effortless-ntwf:procedureExecutionId ?j2 ; effortless-ntwf:assuranceGrade ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_AssuranceGradeHasDrifted" ;
        sh:order 8 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:assuranceGradeHasDrifted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
    OPTIONAL { $this effortless-ntwf:assuranceGradeAtSigning ?assurance_grade_at_signing . }
    OPTIONAL { $this effortless-ntwf:assuranceGradeNow ?assurance_grade_now . }
                BIND((!((?assurance_grade_at_signing = ?assurance_grade_now))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Attestations_WouldNotSurviveRestatement" ;
        sh:order 9 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:wouldNotSurviveRestatement ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Attestations .
    OPTIONAL { $this effortless-ntwf:assuranceGradeHasDrifted ?assurance_grade_has_drifted . }
    OPTIONAL { $this effortless-ntwf:fitnessVerdictHasDrifted ?fitness_verdict_has_drifted . }
                BIND((?fitness_verdict_has_drifted || ?assurance_grade_has_drifted) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for AuthorityBoundaries ===
effortless-ntwf:AuthorityBoundariesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AuthorityBoundaries ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:forbiddenAgentKind ?forbidden_agent_kind . }
    OPTIONAL { $this effortless-ntwf:forbiddenDecisionKind ?forbidden_decision_kind . }
                BIND(CONCAT(COALESCE(IF(isIRI(?forbidden_agent_kind), REPLACE(STR(?forbidden_agent_kind), "^.*[#/]", ""), IF(DATATYPE(?forbidden_agent_kind) = xsd:dateTime, CONCAT(SUBSTR(STR(?forbidden_agent_kind), 1, 10), " ", SUBSTR(STR(?forbidden_agent_kind), 12, 8), IF(TZ(?forbidden_agent_kind) = "Z", "+00", IF(STRENDS(TZ(?forbidden_agent_kind), ":00"), SUBSTR(TZ(?forbidden_agent_kind), 1, 3), TZ(?forbidden_agent_kind)))), STR(?forbidden_agent_kind))), ""), " may not ", COALESCE(IF(isIRI(?forbidden_decision_kind), REPLACE(STR(?forbidden_decision_kind), "^.*[#/]", ""), IF(DATATYPE(?forbidden_decision_kind) = xsd:dateTime, CONCAT(SUBSTR(STR(?forbidden_decision_kind), 1, 10), " ", SUBSTR(STR(?forbidden_decision_kind), 12, 8), IF(TZ(?forbidden_decision_kind) = "Z", "+00", IF(STRENDS(TZ(?forbidden_decision_kind), ":00"), SUBSTR(TZ(?forbidden_decision_kind), 1, 3), TZ(?forbidden_decision_kind)))), STR(?forbidden_decision_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_AsOfInstant" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 ; effortless-ntwf:asOfInstant ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsCurrentlyBinding" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrentlyBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND(((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved") && (?valid_from <= ?as_of_instant) && ((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = "") || (?valid_to > ?as_of_instant))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentIsValid" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentIsValid ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 ; effortless-ntwf:isCurrentlyValid ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_StepWhenBinding" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepWhenBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_currently_binding, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_BoundaryMatchKey" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryMatchKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:forbiddenAgentKind ?forbidden_agent_kind . }
    OPTIONAL { $this effortless-ntwf:forbiddenDecisionKind ?forbidden_decision_kind . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(CONCAT(COALESCE(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), IF(DATATYPE(?step) = xsd:dateTime, CONCAT(SUBSTR(STR(?step), 1, 10), " ", SUBSTR(STR(?step), 12, 8), IF(TZ(?step) = "Z", "+00", IF(STRENDS(TZ(?step), ":00"), SUBSTR(TZ(?step), 1, 3), TZ(?step)))), STR(?step))), ""), "|", COALESCE(IF(isIRI(?forbidden_agent_kind), REPLACE(STR(?forbidden_agent_kind), "^.*[#/]", ""), IF(DATATYPE(?forbidden_agent_kind) = xsd:dateTime, CONCAT(SUBSTR(STR(?forbidden_agent_kind), 1, 10), " ", SUBSTR(STR(?forbidden_agent_kind), 12, 8), IF(TZ(?forbidden_agent_kind) = "Z", "+00", IF(STRENDS(TZ(?forbidden_agent_kind), ":00"), SUBSTR(TZ(?forbidden_agent_kind), 1, 3), TZ(?forbidden_agent_kind)))), STR(?forbidden_agent_kind))), ""), "|", COALESCE(IF(isIRI(?forbidden_decision_kind), REPLACE(STR(?forbidden_decision_kind), "^.*[#/]", ""), IF(DATATYPE(?forbidden_decision_kind) = xsd:dateTime, CONCAT(SUBSTR(STR(?forbidden_decision_kind), 1, 10), " ", SUBSTR(STR(?forbidden_decision_kind), 12, 8), IF(TZ(?forbidden_decision_kind) = "Z", "+00", IF(STRENDS(TZ(?forbidden_decision_kind), ":00"), SUBSTR(TZ(?forbidden_decision_kind), 1, 3), TZ(?forbidden_decision_kind)))), STR(?forbidden_decision_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_ViolationCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:violationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    $this effortless-ntwf:boundaryMatchKey ?p0 .
                    ?child effortless-ntwf:boundaryMatchKey ?c0 .
                    FILTER(IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsUntested" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUntested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:violationCount ?violation_count . }
                BIND((?is_currently_binding && (?violation_count = 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_HasRatifyingFragment" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasRatifyingFragment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?ratified_by_knowledge_fragment . }
                BIND((REPLACE(COALESCE(STR(?ratified_by_knowledge_fragment), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsUnwarranted" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwarranted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:hasRatifyingFragment ?has_ratifying_fragment . }
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:ratifyingFragmentIsValid ?ratifying_fragment_is_valid . }
                BIND((?is_currently_binding && ((!(?has_ratifying_fragment)) || (!(?ratifying_fragment_is_valid)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentIsOverdue" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentIsOverdue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 ; effortless-ntwf:isOverdueForReview ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentIsSingleWitness" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentIsSingleWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 ; effortless-ntwf:isFromSingleWitness ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_WarrantIsThin" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:warrantIsThin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:ratifyingFragmentIsOverdue ?ratifying_fragment_is_overdue . }
    OPTIONAL { $this effortless-ntwf:ratifyingFragmentIsSingleWitness ?ratifying_fragment_is_single_witness . }
                BIND((?is_currently_binding && (?ratifying_fragment_is_overdue || ?ratifying_fragment_is_single_witness)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsUnwarrantedAndUntested" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwarrantedAndUntested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isUntested ?is_untested . }
    OPTIONAL { $this effortless-ntwf:isUnwarranted ?is_unwarranted . }
                BIND((?is_unwarranted && ?is_untested) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_UnwarrantedBoundaryStepKey" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unwarrantedBoundaryStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isUnwarranted ?is_unwarranted . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(IF(COALESCE(?is_unwarranted, false), ?step, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?ratified_by_knowledge_fragment . }
                BIND(IF(COALESCE(?is_currently_binding, false), ?ratified_by_knowledge_fragment, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatifyingFragmentStatus" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ratifyingFragmentStatus ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
                OPTIONAL { $this effortless-ntwf:ratifiedByKnowledgeFragment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:KnowledgeFragments ; effortless-ntwf:knowledgeFragmentId ?j2 ; effortless-ntwf:status ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_RatificationLapsed" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ratificationLapsed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:hasRatifyingFragment ?has_ratifying_fragment . }
    OPTIONAL { $this effortless-ntwf:ratifyingFragmentIsValid ?ratifying_fragment_is_valid . }
                BIND((?has_ratifying_fragment && (!(?ratifying_fragment_is_valid))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_BindsDespiteLapsedRatification" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:bindsDespiteLapsedRatification ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:isCurrentlyBinding ?is_currently_binding . }
    OPTIONAL { $this effortless-ntwf:ratificationLapsed ?ratification_lapsed . }
                BIND((?is_currently_binding && ?ratification_lapsed) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_IsUngroundedAndUntested" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUngroundedAndUntested ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:bindsDespiteLapsedRatification ?binds_despite_lapsed_ratification . }
    OPTIONAL { $this effortless-ntwf:isUntested ?is_untested . }
                BIND((?binds_despite_lapsed_ratification && ?is_untested) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AuthorityBoundaries_ConstrainedRoleAssignmentKey" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:constrainedRoleAssignmentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AuthorityBoundaries .
    OPTIONAL { $this effortless-ntwf:authorityRole ?authority_role . }
    OPTIONAL { $this effortless-ntwf:bindsDespiteLapsedRatification ?binds_despite_lapsed_ratification . }
                BIND(IF(COALESCE(?binds_despite_lapsed_ratification, false), ?authority_role, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for BindingObservations ===
effortless-ntwf:BindingObservationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:BindingObservations ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
    OPTIONAL { $this effortless-ntwf:bindingObservationId ?binding_observation_id . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(CONCAT(COALESCE(IF(isIRI(?step_execution), REPLACE(STR(?step_execution), "^.*[#/]", ""), IF(DATATYPE(?step_execution) = xsd:dateTime, CONCAT(SUBSTR(STR(?step_execution), 1, 10), " ", SUBSTR(STR(?step_execution), 12, 8), IF(TZ(?step_execution) = "Z", "+00", IF(STRENDS(TZ(?step_execution), ":00"), SUBSTR(TZ(?step_execution), 1, 3), TZ(?step_execution)))), STR(?step_execution))), ""), " / ", COALESCE(IF(isIRI(?binding_observation_id), REPLACE(STR(?binding_observation_id), "^.*[#/]", ""), IF(DATATYPE(?binding_observation_id) = xsd:dateTime, CONCAT(SUBSTR(STR(?binding_observation_id), 1, 10), " ", SUBSTR(STR(?binding_observation_id), 12, 8), IF(TZ(?binding_observation_id) = "Z", "+00", IF(STRENDS(TZ(?binding_observation_id), ":00"), SUBSTR(TZ(?binding_observation_id), 1, 3), TZ(?binding_observation_id)))), STR(?binding_observation_id))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_SlaMinutesAtRun" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:slaMinutesAtRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
                OPTIONAL { $this effortless-ntwf:operationalBinding ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:OperationalBindings ; effortless-ntwf:operationalBindingId ?j2 ; effortless-ntwf:freshnessSlaMinutes ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_AgeAtRunMinutes" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ageAtRunMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
    OPTIONAL { $this effortless-ntwf:observedSourceTimestamp ?observed_source_timestamp . }
    OPTIONAL { $this effortless-ntwf:readAt ?read_at . }
                BIND(IF(isNumeric(ROUND((((DAY(?read_at) + FLOOR((153 * (MONTH(?read_at) + 12 * FLOOR((14 - MONTH(?read_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) + FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 4) - FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 100) + FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 400) - 32045) * 86400 + COALESCE(HOURS(?read_at), 0) * 3600 + COALESCE(MINUTES(?read_at), 0) * 60 + COALESCE(SECONDS(?read_at), 0) - IF(TZ(?read_at) = "" || TZ(?read_at) = "Z", 0, IF(SUBSTR(TZ(?read_at), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?read_at), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?read_at), 5, 2)) * 60))) - ((DAY(?observed_source_timestamp) + FLOOR((153 * (MONTH(?observed_source_timestamp) + 12 * FLOOR((14 - MONTH(?observed_source_timestamp)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) + FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 4) - FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 100) + FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 400) - 32045) * 86400 + COALESCE(HOURS(?observed_source_timestamp), 0) * 3600 + COALESCE(MINUTES(?observed_source_timestamp), 0) * 60 + COALESCE(SECONDS(?observed_source_timestamp), 0) - IF(TZ(?observed_source_timestamp) = "" || TZ(?observed_source_timestamp) = "Z", 0, IF(SUBSTR(TZ(?observed_source_timestamp), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?observed_source_timestamp), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?observed_source_timestamp), 5, 2)) * 60)))) / 60)), ROUND(ROUND((((DAY(?read_at) + FLOOR((153 * (MONTH(?read_at) + 12 * FLOOR((14 - MONTH(?read_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) + FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 4) - FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 100) + FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 400) - 32045) * 86400 + COALESCE(HOURS(?read_at), 0) * 3600 + COALESCE(MINUTES(?read_at), 0) * 60 + COALESCE(SECONDS(?read_at), 0) - IF(TZ(?read_at) = "" || TZ(?read_at) = "Z", 0, IF(SUBSTR(TZ(?read_at), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?read_at), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?read_at), 5, 2)) * 60))) - ((DAY(?observed_source_timestamp) + FLOOR((153 * (MONTH(?observed_source_timestamp) + 12 * FLOOR((14 - MONTH(?observed_source_timestamp)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) + FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 4) - FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 100) + FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 400) - 32045) * 86400 + COALESCE(HOURS(?observed_source_timestamp), 0) * 3600 + COALESCE(MINUTES(?observed_source_timestamp), 0) * 60 + COALESCE(SECONDS(?observed_source_timestamp), 0) - IF(TZ(?observed_source_timestamp) = "" || TZ(?observed_source_timestamp) = "Z", 0, IF(SUBSTR(TZ(?observed_source_timestamp), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?observed_source_timestamp), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?observed_source_timestamp), 5, 2)) * 60)))) / 60)), ROUND((((DAY(?read_at) + FLOOR((153 * (MONTH(?read_at) + 12 * FLOOR((14 - MONTH(?read_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) + FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 4) - FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 100) + FLOOR((YEAR(?read_at) + 4800 - FLOOR((14 - MONTH(?read_at)) / 12)) / 400) - 32045) * 86400 + COALESCE(HOURS(?read_at), 0) * 3600 + COALESCE(MINUTES(?read_at), 0) * 60 + COALESCE(SECONDS(?read_at), 0) - IF(TZ(?read_at) = "" || TZ(?read_at) = "Z", 0, IF(SUBSTR(TZ(?read_at), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?read_at), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?read_at), 5, 2)) * 60))) - ((DAY(?observed_source_timestamp) + FLOOR((153 * (MONTH(?observed_source_timestamp) + 12 * FLOOR((14 - MONTH(?observed_source_timestamp)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) + FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 4) - FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 100) + FLOOR((YEAR(?observed_source_timestamp) + 4800 - FLOOR((14 - MONTH(?observed_source_timestamp)) / 12)) / 400) - 32045) * 86400 + COALESCE(HOURS(?observed_source_timestamp), 0) * 3600 + COALESCE(MINUTES(?observed_source_timestamp), 0) * 60 + COALESCE(SECONDS(?observed_source_timestamp), 0) - IF(TZ(?observed_source_timestamp) = "" || TZ(?observed_source_timestamp) = "Z", 0, IF(SUBSTR(TZ(?observed_source_timestamp), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?observed_source_timestamp), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?observed_source_timestamp), 5, 2)) * 60)))) / 60)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_WasStaleAtRun" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:wasStaleAtRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
    OPTIONAL { $this effortless-ntwf:ageAtRunMinutes ?age_at_run_minutes . }
    OPTIONAL { $this effortless-ntwf:isAuthoritativeBinding ?is_authoritative_binding . }
    OPTIONAL { $this effortless-ntwf:slaMinutesAtRun ?sla_minutes_at_run . }
                BIND((?is_authoritative_binding && (?age_at_run_minutes > ?sla_minutes_at_run)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_IsAuthoritativeBinding" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isAuthoritativeBinding ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
                OPTIONAL { $this effortless-ntwf:operationalBinding ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:OperationalBindings ; effortless-ntwf:operationalBindingId ?j2 ; effortless-ntwf:isAuthoritative ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_BindingObservations_StaleAtRunStepKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:staleAtRunStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:BindingObservations .
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
    OPTIONAL { $this effortless-ntwf:wasStaleAtRun ?was_stale_at_run . }
                BIND(IF(COALESCE(?was_stale_at_run, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ChangeRequests ===
effortless-ntwf:ChangeRequestsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ChangeRequests ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_IsOpen" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isOpen ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
    OPTIONAL { $this effortless-ntwf:implementedAt ?implemented_at . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Draft") || (REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "UnderReview") || (REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved")) && (REPLACE(COALESCE(STR(?implemented_at), ""), "^.*#", "") = "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_OpenChangeVersionKey" ;
