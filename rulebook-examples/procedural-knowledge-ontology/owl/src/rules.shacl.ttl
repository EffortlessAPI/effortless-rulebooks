    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_AgeDays" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ageDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:sentAt ?sent_at . }
                BIND(IF(isNumeric(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?sent_at) + FLOOR((153 * (MONTH(?sent_at) + 12 * FLOOR((14 - MONTH(?sent_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 4) - FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 100) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 400) - 32045))), ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?sent_at) + FLOOR((153 * (MONTH(?sent_at) + 12 * FLOOR((14 - MONTH(?sent_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 4) - FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 100) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 400) - 32045))), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?sent_at) + FLOOR((153 * (MONTH(?sent_at) + 12 * FLOOR((14 - MONTH(?sent_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 4) - FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 100) + FLOOR((YEAR(?sent_at) + 4800 - FLOOR((14 - MONTH(?sent_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsWithinRetentionWindow" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isWithinRetentionWindow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:ageDays ?age_days . }
    OPTIONAL { $this effortless-ntwf:policyRetentionDays ?policy_retention_days . }
                BIND((?age_days <= ?policy_retention_days) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
