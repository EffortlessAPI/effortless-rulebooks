                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 ; effortless-ntwf:isSendableUnderApproval ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsDriftedSend" ;
