# === Shape with rules for IssueOccurrences ===
effortless-ntwf:IssueOccurrencesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IssueOccurrences ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:error ?error . }
    OPTIONAL { $this effortless-ntwf:occurredAt ?occurred_at . }
                BIND(CONCAT(COALESCE(IF(isIRI(?error), REPLACE(STR(?error), "^.*[#/]", ""), IF(DATATYPE(?error) = xsd:dateTime, CONCAT(SUBSTR(STR(?error), 1, 10), " ", SUBSTR(STR(?error), 12, 8), IF(TZ(?error) = "Z", "+00", IF(STRENDS(TZ(?error), ":00"), SUBSTR(TZ(?error), 1, 3), TZ(?error)))), STR(?error))), ""), " @ ", COALESCE(IF(isIRI(?occurred_at), REPLACE(STR(?occurred_at), "^.*[#/]", ""), IF(DATATYPE(?occurred_at) = xsd:dateTime, CONCAT(SUBSTR(STR(?occurred_at), 1, 10), " ", SUBSTR(STR(?occurred_at), 12, 8), IF(TZ(?occurred_at) = "Z", "+00", IF(STRENDS(TZ(?occurred_at), ":00"), SUBSTR(TZ(?occurred_at), 1, 3), TZ(?occurred_at)))), STR(?occurred_at))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_IsUnresolved" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnresolved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND(((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Open") || (REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Investigating") || (REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Monitoring")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssueOccurrences_StepExecutionWhenUnresolved" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepExecutionWhenUnresolved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssueOccurrences .
    OPTIONAL { $this effortless-ntwf:isUnresolved ?is_unresolved . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_unresolved, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for IssuedTokens ===
effortless-ntwf:IssuedTokensShape a sh:NodeShape ;
