    OPTIONAL { $this effortless-ntwf:isQuietHoursViolation ?is_quiet_hours_violation . }
    OPTIONAL { $this effortless-ntwf:policyChannel ?policy_channel . }
                BIND(IF(COALESCE(?is_quiet_hours_violation, false), ?policy_channel, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_RecipientIsUnreachable" ;
