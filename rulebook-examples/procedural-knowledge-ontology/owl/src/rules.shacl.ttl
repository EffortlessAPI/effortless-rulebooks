    OPTIONAL { $this effortless-ntwf:segmentCount ?segment_count . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((?was_actually_transmitted && (?segment_count > ?policy_max_segments_at_send)) AS ?_result)
            }
