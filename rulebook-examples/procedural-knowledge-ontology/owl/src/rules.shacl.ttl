    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(CONCAT(COALESCE(IF(isIRI(?step), REPLACE(STR(?step), "^.*[#/]", ""), IF(DATATYPE(?step) = xsd:dateTime, CONCAT(SUBSTR(STR(?step), 1, 10), " ", SUBSTR(STR(?step), 12, 8), IF(TZ(?step) = "Z", "+00", IF(STRENDS(TZ(?step), ":00"), SUBSTR(TZ(?step), 1, 3), TZ(?step)))), STR(?step))), ""), " / ", COALESCE(IF(isIRI(?record_or_schema_key), REPLACE(STR(?record_or_schema_key), "^.*[#/]", ""), IF(DATATYPE(?record_or_schema_key) = xsd:dateTime, CONCAT(SUBSTR(STR(?record_or_schema_key), 1, 10), " ", SUBSTR(STR(?record_or_schema_key), 12, 8), IF(TZ(?record_or_schema_key) = "Z", "+00", IF(STRENDS(TZ(?record_or_schema_key), ":00"), SUBSTR(TZ(?record_or_schema_key), 1, 3), TZ(?record_or_schema_key)))), STR(?record_or_schema_key))), "")) AS ?_result)
