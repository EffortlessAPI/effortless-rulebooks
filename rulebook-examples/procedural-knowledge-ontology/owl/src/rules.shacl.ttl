    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AuthorizationIsOverdueForReview" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:authorizationIsOverdueForReview ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizationReviewCadenceDays ?authorization_review_cadence_days . }
    OPTIONAL { $this effortless-ntwf:daysSinceAuthorizationReview ?days_since_authorization_review . }
                BIND(((?authorization_review_cadence_days > 0) && (?days_since_authorization_review > ?authorization_review_cadence_days)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsStandingUnreviewedAutomation" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isStandingUnreviewedAutomation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizationIsOverdueForReview ?authorization_is_overdue_for_review . }
    OPTIONAL { $this effortless-ntwf:coversNow ?covers_now . }
    OPTIONAL { $this effortless-ntwf:isNonHumanAssignment ?is_non_human_assignment . }
                BIND((?covers_now && (?is_non_human_assignment && ?authorization_is_overdue_for_review)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsUnconditionedAutomationHandover" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnconditionedAutomationHandover ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizationReviewCadenceDays ?authorization_review_cadence_days . }
    OPTIONAL { $this effortless-ntwf:isHumanToNonHumanHandover ?is_human_to_non_human_handover . }
                BIND((?is_human_to_non_human_handover && (?authorization_review_cadence_days = 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ExceedsTolerableErrorRate" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:exceedsTolerableErrorRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:errorRatePercent ?error_rate_percent . }
    OPTIONAL { $this effortless-ntwf:maxTolerableErrorRatePercent ?max_tolerable_error_rate_percent . }
                BIND(((?max_tolerable_error_rate_percent > 0) && (?error_rate_percent >= ?max_tolerable_error_rate_percent)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_BoundaryViolationCountForAssignment" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:boundaryViolationCountForAssignment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    $this effortless-ntwf:roleAssignmentId ?p0 .
                    ?child effortless-ntwf:boundaryViolationRoleAssignmentKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasAnyBoundaryViolation" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasAnyBoundaryViolation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:boundaryViolationCountForAssignment ?boundary_violation_count_for_assignment . }
                BIND((?boundary_violation_count_for_assignment > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasUngroundedGoverningBoundary" ;
        sh:order 8 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasUngroundedGoverningBoundary ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:role ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 ; effortless-ntwf:isGovernedByLapsedAuthority ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_SuspensionConditionMet" ;
        sh:order 9 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:suspensionConditionMet ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:exceedsTolerableErrorRate ?exceeds_tolerable_error_rate . }
    OPTIONAL { $this effortless-ntwf:hasAnyBoundaryViolation ?has_any_boundary_violation . }
    OPTIONAL { $this effortless-ntwf:hasUngroundedGoverningBoundary ?has_ungrounded_governing_boundary . }
                BIND((?exceeds_tolerable_error_rate || (?has_any_boundary_violation || ?has_ungrounded_governing_boundary)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsOperatingUnderMetSuspensionCondition" ;
        sh:order 10 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isOperatingUnderMetSuspensionCondition ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:coversNow ?covers_now . }
    OPTIONAL { $this effortless-ntwf:isNonHumanAssignment ?is_non_human_assignment . }
    OPTIONAL { $this effortless-ntwf:suspensionConditionMet ?suspension_condition_met . }
                BIND((?suspension_condition_met && (?covers_now && ?is_non_human_assignment)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasDeclaredSuspensionCondition" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasDeclaredSuspensionCondition ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:maxTolerableErrorRatePercent ?max_tolerable_error_rate_percent . }
                BIND((?max_tolerable_error_rate_percent > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasApprovingAuthority" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasApprovingAuthority ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:approvingAuthorityRole ?approving_authority_role . }
                BIND((REPLACE(COALESCE(STR(?approving_authority_role), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasAuthorizingChangeRequest" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasAuthorizingChangeRequest ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizingChangeRequest ?authorizing_change_request . }
                BIND((REPLACE(COALESCE(STR(?authorizing_change_request), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsUnauthorizedEnforcementAgent" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnauthorizedEnforcementAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:isEnforcementRole ?is_enforcement_role . }
    OPTIONAL { $this effortless-ntwf:isUnauthorizedNonHumanAssignment ?is_unauthorized_non_human_assignment . }
                BIND((COALESCE(?is_enforcement_role, false) && ?is_unauthorized_non_human_assignment) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_GovernanceEvidenceCount" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:governanceEvidenceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:hasApprovingAuthority ?has_approving_authority . }
    OPTIONAL { $this effortless-ntwf:hasAuthorizingChangeRequest ?has_authorizing_change_request . }
                BIND(IF(isNumeric((IF(COALESCE(?has_approving_authority, false), 1, 0) + IF(COALESCE(?has_authorizing_change_request, false), 1, 0))), ROUND((IF(COALESCE(?has_approving_authority, false), 1, 0) + IF(COALESCE(?has_authorizing_change_request, false), 1, 0))), (IF(COALESCE(?has_approving_authority, false), 1, 0) + IF(COALESCE(?has_authorizing_change_request, false), 1, 0))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_UnauthorizedEnforcementRoleKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unauthorizedEnforcementRoleKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:isUnauthorizedNonHumanAssignment ?is_unauthorized_non_human_assignment . }
    OPTIONAL { $this effortless-ntwf:role ?role . }
                BIND(IF(COALESCE(?is_unauthorized_non_human_assignment, false), ?role, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleQuestions ===
effortless-ntwf:RoleQuestionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleQuestions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleQuestions_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleQuestions .
    OPTIONAL { $this effortless-ntwf:askingRole ?asking_role . }
    OPTIONAL { $this effortless-ntwf:questionText ?question_text . }
                BIND(CONCAT(COALESCE(IF(isIRI(?asking_role), REPLACE(STR(?asking_role), "^.*[#/]", ""), IF(DATATYPE(?asking_role) = xsd:dateTime, CONCAT(SUBSTR(STR(?asking_role), 1, 10), " ", SUBSTR(STR(?asking_role), 12, 8), IF(TZ(?asking_role) = "Z", "+00", IF(STRENDS(TZ(?asking_role), ":00"), SUBSTR(TZ(?asking_role), 1, 3), TZ(?asking_role)))), STR(?asking_role))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?question_text), 1, 60)), REPLACE(STR(SUBSTR(STR(?question_text), 1, 60)), "^.*[#/]", ""), IF(DATATYPE(SUBSTR(STR(?question_text), 1, 60)) = xsd:dateTime, CONCAT(SUBSTR(STR(SUBSTR(STR(?question_text), 1, 60)), 1, 10), " ", SUBSTR(STR(SUBSTR(STR(?question_text), 1, 60)), 12, 8), IF(TZ(SUBSTR(STR(?question_text), 1, 60)) = "Z", "+00", IF(STRENDS(TZ(SUBSTR(STR(?question_text), 1, 60)), ":00"), SUBSTR(TZ(SUBSTR(STR(?question_text), 1, 60)), 1, 3), TZ(SUBSTR(STR(?question_text), 1, 60))))), STR(SUBSTR(STR(?question_text), 1, 60)))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleQuestions_PredicateCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:predicateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleQuestions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RulebookFields .
                    ?child effortless-ntwf:inventedForQuestion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleQuestions_IsAnswered" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isAnswered ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleQuestions .
    OPTIONAL { $this effortless-ntwf:predicateCount ?predicate_count . }
                BIND((?predicate_count > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleSchemaViews ===
effortless-ntwf:RoleSchemaViewsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleSchemaViews ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_Name" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
    OPTIONAL { $this effortless-ntwf:schemaName ?schema_name . }
    OPTIONAL { $this effortless-ntwf:viewName ?view_name . }
                BIND(CONCAT(COALESCE(IF(isIRI(?schema_name), REPLACE(STR(?schema_name), "^.*[#/]", ""), IF(DATATYPE(?schema_name) = xsd:dateTime, CONCAT(SUBSTR(STR(?schema_name), 1, 10), " ", SUBSTR(STR(?schema_name), 12, 8), IF(TZ(?schema_name) = "Z", "+00", IF(STRENDS(TZ(?schema_name), ":00"), SUBSTR(TZ(?schema_name), 1, 3), TZ(?schema_name)))), STR(?schema_name))), ""), ".", COALESCE(IF(isIRI(?view_name), REPLACE(STR(?view_name), "^.*[#/]", ""), IF(DATATYPE(?view_name) = xsd:dateTime, CONCAT(SUBSTR(STR(?view_name), 1, 10), " ", SUBSTR(STR(?view_name), 12, 8), IF(TZ(?view_name) = "Z", "+00", IF(STRENDS(TZ(?view_name), ":00"), SUBSTR(TZ(?view_name), 1, 3), TZ(?view_name)))), STR(?view_name))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_SchemaName" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:schemaName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
                OPTIONAL { $this effortless-ntwf:roleSchema ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleSchemas ; effortless-ntwf:roleSchemaId ?j2 ; effortless-ntwf:schemaName ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_SourceView" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:sourceView ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
                OPTIONAL { $this effortless-ntwf:targetTable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookTables ; effortless-ntwf:rulebookTableId ?j2 ; effortless-ntwf:physicalView ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_GrantKey" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:grantKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
    OPTIONAL { $this effortless-ntwf:targetTable ?target_table . }
                BIND(CONCAT(COALESCE(IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), IF(DATATYPE(?principal) = xsd:dateTime, CONCAT(SUBSTR(STR(?principal), 1, 10), " ", SUBSTR(STR(?principal), 12, 8), IF(TZ(?principal) = "Z", "+00", IF(STRENDS(TZ(?principal), ":00"), SUBSTR(TZ(?principal), 1, 3), TZ(?principal)))), STR(?principal))), ""), "|", COALESCE(IF(isIRI(?target_table), REPLACE(STR(?target_table), "^.*[#/]", ""), IF(DATATYPE(?target_table) = xsd:dateTime, CONCAT(SUBSTR(STR(?target_table), 1, 10), " ", SUBSTR(STR(?target_table), 12, 8), IF(TZ(?target_table) = "Z", "+00", IF(STRENDS(TZ(?target_table), ":00"), SUBSTR(TZ(?target_table), 1, 3), TZ(?target_table)))), STR(?target_table))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_ColumnCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:columnCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:FieldGrants .
                    $this effortless-ntwf:grantKey ?p0 .
                    ?child effortless-ntwf:grantKeyWhenReadable ?c0 .
                    FILTER(IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_TableFieldCount" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:tableFieldCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
                OPTIONAL { $this effortless-ntwf:targetTable ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookTables ; effortless-ntwf:rulebookTableId ?j2 ; effortless-ntwf:fieldCount ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_IsFullWidth" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isFullWidth ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
    OPTIONAL { $this effortless-ntwf:columnCount ?column_count . }
    OPTIONAL { $this effortless-ntwf:tableFieldCount ?table_field_count . }
                BIND(((?column_count > 0) && (?column_count >= ?table_field_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemaViews_IsDegenerateView" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isDegenerateView ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemaViews .
    OPTIONAL { $this effortless-ntwf:columnCount ?column_count . }
                BIND((?column_count = 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleSchemas ===
effortless-ntwf:RoleSchemasShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleSchemas ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemas_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemas .
    OPTIONAL { $this effortless-ntwf:schemaName ?schema_name . }
                BIND(?schema_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemas_SearchPath" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:searchPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemas .
    OPTIONAL { $this effortless-ntwf:schemaName ?schema_name . }
                BIND(?schema_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemas_ViewCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:viewCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemas .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleSchemaViews .
                    ?child effortless-ntwf:roleSchema $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleSchemas_IsEmptySchema" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isEmptySchema ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleSchemas .
    OPTIONAL { $this effortless-ntwf:viewCount ?view_count . }
                BIND((?view_count = 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Roles ===
effortless-ntwf:RolesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Roles ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_CurrentAgentKind" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:currentAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                OPTIONAL { $this effortless-ntwf:currentAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:agentKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_ActiveAssignmentCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:activeAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    ?child effortless-ntwf:role $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_CurrentlyCoveredAssignmentCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:currentlyCoveredAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    $this effortless-ntwf:roleId ?p0 .
                    ?child effortless-ntwf:roleWhenCovering ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_HasNoCurrentHolder" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasNoCurrentHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:currentlyCoveredAssignmentCount ?currently_covered_assignment_count . }
                BIND((?currently_covered_assignment_count = 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_CountOfAwaitedDecisions" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:countOfAwaitedDecisions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeRequests .
                    ?child effortless-ntwf:authorityRole $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_CurrentAssignmentValidFrom" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:currentAssignmentValidFrom ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                OPTIONAL { $this effortless-ntwf:currentAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 ; effortless-ntwf:validFrom ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsNonHumanHeld" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isNonHumanHeld ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:currentAgentKind ?current_agent_kind . }
                BIND((!((REPLACE(COALESCE(STR(?current_agent_kind), ""), "^.*#", "") = "Human"))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsUngovernedNonHumanRole" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUngovernedNonHumanRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:hasNoCurrentHolder ?has_no_current_holder . }
    OPTIONAL { $this effortless-ntwf:isNonHumanHeld ?is_non_human_held . }
                BIND((?is_non_human_held && ?has_no_current_holder) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_DepartedAssignmentCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:departedAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    $this effortless-ntwf:roleId ?p0 .
                    ?child effortless-ntwf:departedRoleKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_HasLostAHolder" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasLostAHolder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:departedAssignmentCount ?departed_assignment_count . }
                BIND((?departed_assignment_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsVacatedRole" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isVacatedRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:hasLostAHolder ?has_lost_a_holder . }
    OPTIONAL { $this effortless-ntwf:hasNoCurrentHolder ?has_no_current_holder . }
                BIND((?has_lost_a_holder && ?has_no_current_holder) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_UngroundedBoundaryCount" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ungroundedBoundaryCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AuthorityBoundaries .
                    $this effortless-ntwf:roleId ?p0 .
                    ?child effortless-ntwf:constrainedRoleAssignmentKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsGovernedByLapsedAuthority" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isGovernedByLapsedAuthority ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:ungroundedBoundaryCount ?ungrounded_boundary_count . }
                BIND((?ungrounded_boundary_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_UnescalatedRefusalCount" ;
        sh:order 13 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unescalatedRefusalCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:SendIntents .
                    $this effortless-ntwf:roleId ?p0 .
                    ?child effortless-ntwf:unescalatedRefusalRoleKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_UnauthorizedEnforcementAssignmentCount" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unauthorizedEnforcementAssignmentCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RoleAssignments .
                    $this effortless-ntwf:roleId ?p0 .
                    ?child effortless-ntwf:unauthorizedEnforcementRoleKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Roles_IsUngovernedEnforcementRole" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUngovernedEnforcementRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Roles .
    OPTIONAL { $this effortless-ntwf:unauthorizedEnforcementAssignmentCount ?unauthorized_enforcement_assignment_count . }
                BIND((?unauthorized_enforcement_assignment_count > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RulebookFields ===
effortless-ntwf:RulebookFieldsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RulebookFields ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:fieldName ?field_name . }
    OPTIONAL { $this effortless-ntwf:targetTable ?target_table . }
                BIND(CONCAT(COALESCE(IF(isIRI(?target_table), REPLACE(STR(?target_table), "^.*[#/]", ""), IF(DATATYPE(?target_table) = xsd:dateTime, CONCAT(SUBSTR(STR(?target_table), 1, 10), " ", SUBSTR(STR(?target_table), 12, 8), IF(TZ(?target_table) = "Z", "+00", IF(STRENDS(TZ(?target_table), ":00"), SUBSTR(TZ(?target_table), 1, 3), TZ(?target_table)))), STR(?target_table))), ""), ".", COALESCE(IF(isIRI(?field_name), REPLACE(STR(?field_name), "^.*[#/]", ""), IF(DATATYPE(?field_name) = xsd:dateTime, CONCAT(SUBSTR(STR(?field_name), 1, 10), " ", SUBSTR(STR(?field_name), 12, 8), IF(TZ(?field_name) = "Z", "+00", IF(STRENDS(TZ(?field_name), ":00"), SUBSTR(TZ(?field_name), 1, 3), TZ(?field_name)))), STR(?field_name))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_IsDerived" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isDerived ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:fieldType ?field_type . }
                BIND(((REPLACE(COALESCE(STR(?field_type), ""), "^.*#", "") = "calculated") || (REPLACE(COALESCE(STR(?field_type), ""), "^.*#", "") = "lookup") || (REPLACE(COALESCE(STR(?field_type), ""), "^.*#", "") = "aggregation")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookFields_IsWitness" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookFields .
    OPTIONAL { $this effortless-ntwf:inventedForQuestion ?invented_for_question . }
                BIND((REPLACE(COALESCE(STR(?invented_for_question), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RulebookReleases ===
effortless-ntwf:RulebookReleasesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RulebookReleases ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookReleases_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookReleases .
    OPTIONAL { $this effortless-ntwf:pkoCoreVersionIri ?pko_core_version_iri . }
    OPTIONAL { $this effortless-ntwf:rulebookVersion ?rulebook_version . }
                BIND(CONCAT(COALESCE(IF(isIRI(?rulebook_version), REPLACE(STR(?rulebook_version), "^.*[#/]", ""), IF(DATATYPE(?rulebook_version) = xsd:dateTime, CONCAT(SUBSTR(STR(?rulebook_version), 1, 10), " ", SUBSTR(STR(?rulebook_version), 12, 8), IF(TZ(?rulebook_version) = "Z", "+00", IF(STRENDS(TZ(?rulebook_version), ":00"), SUBSTR(TZ(?rulebook_version), 1, 3), TZ(?rulebook_version)))), STR(?rulebook_version))), ""), " / PKO ", COALESCE(IF(isIRI(?pko_core_version_iri), REPLACE(STR(?pko_core_version_iri), "^.*[#/]", ""), IF(DATATYPE(?pko_core_version_iri) = xsd:dateTime, CONCAT(SUBSTR(STR(?pko_core_version_iri), 1, 10), " ", SUBSTR(STR(?pko_core_version_iri), 12, 8), IF(TZ(?pko_core_version_iri) = "Z", "+00", IF(STRENDS(TZ(?pko_core_version_iri), ":00"), SUBSTR(TZ(?pko_core_version_iri), 1, 3), TZ(?pko_core_version_iri)))), STR(?pko_core_version_iri))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RulebookTables ===
effortless-ntwf:RulebookTablesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RulebookTables ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
    OPTIONAL { $this effortless-ntwf:tableName ?table_name . }
                BIND(?table_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_FieldCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:fieldCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RulebookFields .
                    $this effortless-ntwf:rulebookTableId ?p0 .
                    ?child effortless-ntwf:targetTable ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_PolicyCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:policyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AccessPolicies .
                    ?child effortless-ntwf:targetTable $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RulebookTables_IsUnsecured" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnsecured ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RulebookTables .
    OPTIONAL { $this effortless-ntwf:policyCount ?policy_count . }
                BIND((?policy_count = 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SemanticMappings ===
effortless-ntwf:SemanticMappingsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SemanticMappings ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SemanticMappings_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SemanticMappings .
    OPTIONAL { $this effortless-ntwf:sourcePath ?source_path . }
    OPTIONAL { $this effortless-ntwf:targetIri ?target_iri . }
                BIND(CONCAT(COALESCE(IF(isIRI(?source_path), REPLACE(STR(?source_path), "^.*[#/]", ""), IF(DATATYPE(?source_path) = xsd:dateTime, CONCAT(SUBSTR(STR(?source_path), 1, 10), " ", SUBSTR(STR(?source_path), 12, 8), IF(TZ(?source_path) = "Z", "+00", IF(STRENDS(TZ(?source_path), ":00"), SUBSTR(TZ(?source_path), 1, 3), TZ(?source_path)))), STR(?source_path))), ""), " -> ", COALESCE(IF(isIRI(?target_iri), REPLACE(STR(?target_iri), "^.*[#/]", ""), IF(DATATYPE(?target_iri) = xsd:dateTime, CONCAT(SUBSTR(STR(?target_iri), 1, 10), " ", SUBSTR(STR(?target_iri), 12, 8), IF(TZ(?target_iri) = "Z", "+00", IF(STRENDS(TZ(?target_iri), ":00"), SUBSTR(TZ(?target_iri), 1, 3), TZ(?target_iri)))), STR(?target_iri))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for SendIntents ===
effortless-ntwf:SendIntentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SendIntents ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:messageTemplate ?message_template . }
    OPTIONAL { $this effortless-ntwf:recipient ?recipient . }
                BIND(CONCAT(COALESCE(IF(isIRI(?recipient), REPLACE(STR(?recipient), "^.*[#/]", ""), IF(DATATYPE(?recipient) = xsd:dateTime, CONCAT(SUBSTR(STR(?recipient), 1, 10), " ", SUBSTR(STR(?recipient), 12, 8), IF(TZ(?recipient) = "Z", "+00", IF(STRENDS(TZ(?recipient), ":00"), SUBSTR(TZ(?recipient), 1, 3), TZ(?recipient)))), STR(?recipient))), ""), " / ", COALESCE(IF(isIRI(?message_template), REPLACE(STR(?message_template), "^.*[#/]", ""), IF(DATATYPE(?message_template) = xsd:dateTime, CONCAT(SUBSTR(STR(?message_template), 1, 10), " ", SUBSTR(STR(?message_template), 12, 8), IF(TZ(?message_template) = "Z", "+00", IF(STRENDS(TZ(?message_template), ":00"), SUBSTR(TZ(?message_template), 1, 3), TZ(?message_template)))), STR(?message_template))), ""), " / intent") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentPolicy" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentPolicy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 ; effortless-ntwf:communicationPolicy ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentChannel" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentChannel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:channel ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_PolicyIsActive" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:policyIsActive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:isActivePolicy ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentRequiresConsent" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentRequiresConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:consentRequired ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RecipientHasChannelConsent" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:recipientHasChannelConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 ; effortless-ntwf:hasSmsConsent ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ConsentGatePassed" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:consentGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentRequiresConsent ?intent_requires_consent . }
    OPTIONAL { $this effortless-ntwf:recipientHasChannelConsent ?recipient_has_channel_consent . }
                BIND(((!(?intent_requires_consent)) || ?recipient_has_channel_consent) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RecipientIsSmsReachable" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:recipientIsSmsReachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 ; effortless-ntwf:isSmsReachable ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RecipientIsEmailReachable" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:recipientIsEmailReachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:recipient ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Recipients ; effortless-ntwf:recipientId ?j2 ; effortless-ntwf:isEmailReachable ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ReachabilityGatePassed" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:reachabilityGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentChannel ?intent_channel . }
    OPTIONAL { $this effortless-ntwf:recipientIsEmailReachable ?recipient_is_email_reachable . }
    OPTIONAL { $this effortless-ntwf:recipientIsSmsReachable ?recipient_is_sms_reachable . }
                BIND(IF(COALESCE((REPLACE(COALESCE(STR(?intent_channel), ""), "^.*#", "") = "SMS"), false), ?recipient_is_sms_reachable, ?recipient_is_email_reachable) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_PermissionGatePassed" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:permissionGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:consentGatePassed ?consent_gate_passed . }
    OPTIONAL { $this effortless-ntwf:policyIsActive ?policy_is_active . }
    OPTIONAL { $this effortless-ntwf:reachabilityGatePassed ?reachability_gate_passed . }
                BIND((?policy_is_active && (?consent_gate_passed && ?reachability_gate_passed)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentQuietStartHour" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentQuietStartHour ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:quietHoursStartHour ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentQuietEndHour" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentQuietEndHour ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:quietHoursEndHour ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentPolicyHasQuietHours" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentPolicyHasQuietHours ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentQuietEndHour ?intent_quiet_end_hour . }
    OPTIONAL { $this effortless-ntwf:intentQuietStartHour ?intent_quiet_start_hour . }
                BIND((?intent_quiet_start_hour != ?intent_quiet_end_hour) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentQuietWindowWraps" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentQuietWindowWraps ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentQuietEndHour ?intent_quiet_end_hour . }
    OPTIONAL { $this effortless-ntwf:intentQuietStartHour ?intent_quiet_start_hour . }
                BIND((?intent_quiet_start_hour > ?intent_quiet_end_hour) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentIsInsideQuietWindow" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentIsInsideQuietWindow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentQuietEndHour ?intent_quiet_end_hour . }
    OPTIONAL { $this effortless-ntwf:intentQuietStartHour ?intent_quiet_start_hour . }
    OPTIONAL { $this effortless-ntwf:intentQuietWindowWraps ?intent_quiet_window_wraps . }
    OPTIONAL { $this effortless-ntwf:proposedSendAtLocalHour ?proposed_send_at_local_hour . }
                BIND(IF(COALESCE(?intent_quiet_window_wraps, false), ((?proposed_send_at_local_hour >= ?intent_quiet_start_hour) || (?proposed_send_at_local_hour < ?intent_quiet_end_hour)), ((?proposed_send_at_local_hour >= ?intent_quiet_start_hour) && (?proposed_send_at_local_hour < ?intent_quiet_end_hour))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_TimingGatePassed" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:timingGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentIsInsideQuietWindow ?intent_is_inside_quiet_window . }
    OPTIONAL { $this effortless-ntwf:intentPolicyHasQuietHours ?intent_policy_has_quiet_hours . }
                BIND(((!(?intent_policy_has_quiet_hours)) || (!(?intent_is_inside_quiet_window))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_HoursUntilWindowOpens" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hoursUntilWindowOpens ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentQuietEndHour ?intent_quiet_end_hour . }
    OPTIONAL { $this effortless-ntwf:proposedSendAtLocalHour ?proposed_send_at_local_hour . }
    OPTIONAL { $this effortless-ntwf:timingGatePassed ?timing_gate_passed . }
                BIND(IF(isNumeric(IF(COALESCE(?timing_gate_passed, false), 0, IF(COALESCE((?proposed_send_at_local_hour < ?intent_quiet_end_hour), false), (?intent_quiet_end_hour - ?proposed_send_at_local_hour), ((24 - ?proposed_send_at_local_hour) + ?intent_quiet_end_hour)))), ROUND(IF(COALESCE(?timing_gate_passed, false), 0, IF(COALESCE((?proposed_send_at_local_hour < ?intent_quiet_end_hour), false), (?intent_quiet_end_hour - ?proposed_send_at_local_hour), ((24 - ?proposed_send_at_local_hour) + ?intent_quiet_end_hour)))), IF(COALESCE(?timing_gate_passed, false), 0, IF(COALESCE((?proposed_send_at_local_hour < ?intent_quiet_end_hour), false), (?intent_quiet_end_hour - ?proposed_send_at_local_hour), ((24 - ?proposed_send_at_local_hour) + ?intent_quiet_end_hour)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentMaxMessageLength" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentMaxMessageLength ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:maxMessageLength ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentMaxSegments" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentMaxSegments ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:maxSegments ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_LengthGatePassed" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:lengthGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentMaxSegments ?intent_max_segments . }
    OPTIONAL { $this effortless-ntwf:proposedBodyLength ?proposed_body_length . }
    OPTIONAL { $this effortless-ntwf:proposedSegmentCount ?proposed_segment_count . }
                BIND(((?proposed_body_length > 0) && (?proposed_segment_count <= ?intent_max_segments)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentRequiredOptOutPhrase" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentRequiredOptOutPhrase ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:requiredOptOutPhrase ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_OptOutGatePassed" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:optOutGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:intentMaxMessageLength ?intent_max_message_length . }
    OPTIONAL { $this effortless-ntwf:intentRequiredOptOutPhrase ?intent_required_opt_out_phrase . }
    OPTIONAL { $this effortless-ntwf:proposedOptOutPosition ?proposed_opt_out_position . }
                BIND(((REPLACE(COALESCE(STR(?intent_required_opt_out_phrase), ""), "^.*#", "") = "") || ((?proposed_opt_out_position > 0) && (?proposed_opt_out_position <= ?intent_max_message_length))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ContentGatePassed" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:contentGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:lengthGatePassed ?length_gate_passed . }
    OPTIONAL { $this effortless-ntwf:optOutGatePassed ?opt_out_gate_passed . }
                BIND((?length_gate_passed && ?opt_out_gate_passed) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_TemplateIsSendable" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:templateIsSendable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:messageTemplate ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageTemplates ; effortless-ntwf:messageTemplateId ?j2 ; effortless-ntwf:isSendableUnderApproval ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ExecutionHasLegalClearance" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:executionHasLegalClearance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:procedureExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureExecutions ; effortless-ntwf:procedureExecutionId ?j2 ; effortless-ntwf:hasClearedLegalReview ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentApprovalRole" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentApprovalRole ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentPolicy ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:CommunicationPolicies ; effortless-ntwf:communicationPolicyId ?j2 ; effortless-ntwf:approvalRole ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ApprovalRoleAgentKind" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:approvalRoleAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:intentApprovalRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 ; effortless-ntwf:currentAgentKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ApprovalIsHuman" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:approvalIsHuman ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:approvalRoleAgentKind ?approval_role_agent_kind . }
                BIND((REPLACE(COALESCE(STR(?approval_role_agent_kind), ""), "^.*#", "") = "Human") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_AuthorizationGatePassed" ;
        sh:order 8 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:authorizationGatePassed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:approvalIsHuman ?approval_is_human . }
    OPTIONAL { $this effortless-ntwf:executionHasLegalClearance ?execution_has_legal_clearance . }
    OPTIONAL { $this effortless-ntwf:templateIsSendable ?template_is_sendable . }
                BIND((?template_is_sendable && (?execution_has_legal_clearance && ?approval_is_human)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsClearedToSend" ;
        sh:order 9 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isClearedToSend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:authorizationGatePassed ?authorization_gate_passed . }
    OPTIONAL { $this effortless-ntwf:contentGatePassed ?content_gate_passed . }
    OPTIONAL { $this effortless-ntwf:permissionGatePassed ?permission_gate_passed . }
    OPTIONAL { $this effortless-ntwf:timingGatePassed ?timing_gate_passed . }
                BIND((?permission_gate_passed && (?timing_gate_passed && (?content_gate_passed && ?authorization_gate_passed))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_BlockingGateName" ;
        sh:order 10 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:blockingGateName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:contentGatePassed ?content_gate_passed . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
    OPTIONAL { $this effortless-ntwf:permissionGatePassed ?permission_gate_passed . }
    OPTIONAL { $this effortless-ntwf:timingGatePassed ?timing_gate_passed . }
                BIND(IF(COALESCE(?is_cleared_to_send, false), "", IF(COALESCE((!(?permission_gate_passed)), false), "Permission", IF(COALESCE((!(?timing_gate_passed)), false), "Timing", IF(COALESCE((!(?content_gate_passed)), false), "Content", "Authorization")))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_HasResultingDelivery" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasResultingDelivery ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:resultingDelivery ?resulting_delivery . }
                BIND((REPLACE(COALESCE(STR(?resulting_delivery), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ResultingDeliveryWasTransmitted" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:resultingDeliveryWasTransmitted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:resultingDelivery ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageDeliveries ; effortless-ntwf:messageDeliveryId ?j2 ; effortless-ntwf:wasActuallyTransmitted ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsOverriddenRefusal" ;
        sh:order 10 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isOverriddenRefusal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:hasResultingDelivery ?has_resulting_delivery . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
    OPTIONAL { $this effortless-ntwf:resultingDeliveryWasTransmitted ?resulting_delivery_was_transmitted . }
                BIND(((!(?is_cleared_to_send)) && (?has_resulting_delivery && ?resulting_delivery_was_transmitted)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsSilentlyDropped" ;
        sh:order 10 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isSilentlyDropped ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:hasResultingDelivery ?has_resulting_delivery . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
                BIND(((!(?is_cleared_to_send)) && (!(?has_resulting_delivery))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_ResultingDeliveryException" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:resultingDeliveryException ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
                OPTIONAL { $this effortless-ntwf:resultingDelivery ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:MessageDeliveries ; effortless-ntwf:messageDeliveryId ?j2 ; effortless-ntwf:invokedException ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RefusalCitedAnException" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:refusalCitedAnException ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:resultingDeliveryException ?resulting_delivery_exception . }
                BIND((REPLACE(COALESCE(STR(?resulting_delivery_exception), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsProperlyHandledRefusal" ;
        sh:order 10 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isProperlyHandledRefusal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:hasResultingDelivery ?has_resulting_delivery . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
    OPTIONAL { $this effortless-ntwf:refusalCitedAnException ?refusal_cited_an_exception . }
    OPTIONAL { $this effortless-ntwf:resultingDeliveryWasTransmitted ?resulting_delivery_was_transmitted . }
                BIND(((!(?is_cleared_to_send)) && (?has_resulting_delivery && ((!(?resulting_delivery_was_transmitted)) && ?refusal_cited_an_exception))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RefusalFailureExecutionKey" ;
        sh:order 11 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:refusalFailureExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:isOverriddenRefusal ?is_overridden_refusal . }
    OPTIONAL { $this effortless-ntwf:isSilentlyDropped ?is_silently_dropped . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE((?is_overridden_refusal || ?is_silently_dropped), false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IntentExecutionKey" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:intentExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(?procedure_execution AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_DeliveredIntentExecutionKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:deliveredIntentExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:hasResultingDelivery ?has_resulting_delivery . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
    OPTIONAL { $this effortless-ntwf:resultingDeliveryWasTransmitted ?resulting_delivery_was_transmitted . }
                BIND(IF(COALESCE((?has_resulting_delivery && ?resulting_delivery_was_transmitted), false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_DroppedIntentExecutionKey" ;
        sh:order 11 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:droppedIntentExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:isSilentlyDropped ?is_silently_dropped . }
    OPTIONAL { $this effortless-ntwf:procedureExecution ?procedure_execution . }
                BIND(IF(COALESCE(?is_silently_dropped, false), ?procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_MyApprovalWasInForce" ;
        sh:order 8 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:myApprovalWasInForce ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:templateIsSendable ?template_is_sendable . }
                BIND(?template_is_sendable AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RefusedOnApprovedContent" ;
        sh:order 9 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:refusedOnApprovedContent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:contentGatePassed ?content_gate_passed . }
    OPTIONAL { $this effortless-ntwf:myApprovalWasInForce ?my_approval_was_in_force . }
                BIND((?my_approval_was_in_force && (!(?content_gate_passed))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RefusedOnOptOutOnly" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:refusedOnOptOutOnly ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:lengthGatePassed ?length_gate_passed . }
    OPTIONAL { $this effortless-ntwf:optOutGatePassed ?opt_out_gate_passed . }
                BIND(((!(?opt_out_gate_passed)) && ?length_gate_passed) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RefusalWasOnMyRules" ;
        sh:order 10 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:refusalWasOnMyRules ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:contentGatePassed ?content_gate_passed . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
    OPTIONAL { $this effortless-ntwf:timingGatePassed ?timing_gate_passed . }
                BIND(((!(?is_cleared_to_send)) && ((!(?content_gate_passed)) || (!(?timing_gate_passed)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_RefusalWasOutsideMyControl" ;
        sh:order 10 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:refusalWasOutsideMyControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:authorizationGatePassed ?authorization_gate_passed . }
    OPTIONAL { $this effortless-ntwf:isClearedToSend ?is_cleared_to_send . }
    OPTIONAL { $this effortless-ntwf:permissionGatePassed ?permission_gate_passed . }
                BIND(((!(?is_cleared_to_send)) && ((!(?permission_gate_passed)) || (!(?authorization_gate_passed)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SendIntents_IsUnreportedRefusalOnMyRules" ;
        sh:order 11 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnreportedRefusalOnMyRules ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SendIntents .
    OPTIONAL { $this effortless-ntwf:approverWasNotified ?approver_was_notified . }
    OPTIONAL { $this effortless-ntwf:refusalWasOnMyRules ?refusal_was_on_my_rules . }
