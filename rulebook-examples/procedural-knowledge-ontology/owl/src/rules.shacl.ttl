nteger(SUBSTR(TZ(?ended_at), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?ended_at), 5, 2)) * 60))) - ((DAY(?started_at) + FLOOR((153 * (MONTH(?started_at) + 12 * FLOOR((14 - MONTH(?started_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 4) - FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 100) + FLOOR((YEAR(?started_at) + 4800 - FLOOR((14 - MONTH(?started_at)) / 12)) / 400) - 32045) * 86400 + COALESCE(HOURS(?started_at), 0) * 3600 + COALESCE(MINUTES(?started_at), 0) * 60 + COALESCE(SECONDS(?started_at), 0) - IF(TZ(?started_at) = "" || TZ(?started_at) = "Z", 0, IF(SUBSTR(TZ(?started_at), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?started_at), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?started_at), 5, 2)) * 60)))) / 60))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExpectedDurationMinutes" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:expectedDurationMinutes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:expectedDurationMinutes ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsLate" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isLate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:actualDurationMinutes ?actual_duration_minutes . }
    OPTIONAL { $this effortless-ntwf:expectedDurationMinutes ?expected_duration_minutes . }
                BIND((?actual_duration_minutes > ?expected_duration_minutes) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_BlockingUnmetCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:blockingUnmetCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:stepExecution $this .
                    OPTIONAL { ?child effortless-ntwf:isBlockingAndUnmet ?c2 . }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_BlockingUnmetCountSafe" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:blockingUnmetCountSafe ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    $this effortless-ntwf:stepExecutionId ?p0 .
                    ?child effortless-ntwf:blockingUnmetStepKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ProceededPastBlockingControl" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:proceededPastBlockingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:blockingUnmetCountSafe ?blocking_unmet_count_safe . }
    OPTIONAL { $this effortless-ntwf:executionStatus ?execution_status . }
                BIND(((REPLACE(COALESCE(STR(?execution_status), ""), "^.*#", "") = "Completed") && (?blocking_unmet_count_safe > 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExpectedBlockingCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:expectedBlockingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:blockingRequirementCount ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_EvaluatedBlockingCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:evaluatedBlockingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    $this effortless-ntwf:stepExecutionId ?p0 .
                    ?child effortless-ntwf:blockingSatisfactionStepKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_UnevaluatedBlockingCount" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unevaluatedBlockingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:evaluatedBlockingCount ?evaluated_blocking_count . }
    OPTIONAL { $this effortless-ntwf:expectedBlockingCount ?expected_blocking_count . }
                BIND((?expected_blocking_count - ?evaluated_blocking_count) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasUnevaluatedBlockingControl" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasUnevaluatedBlockingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:unevaluatedBlockingCount ?unevaluated_blocking_count . }
                BIND((?unevaluated_blocking_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_StaleAuthoritativeSourceCount" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:staleAuthoritativeSourceCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:authoritativeStaleCount ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_RanOnStaleAuthoritativeSource" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ranOnStaleAuthoritativeSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:staleAuthoritativeSourceCount ?stale_authoritative_source_count . }
                BIND((?stale_authoritative_source_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasDeviationNote" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasDeviationNote ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:deviation ?deviation . }
                BIND((REPLACE(COALESCE(STR(?deviation), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_IsLateAndUnexplained" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isLateAndUnexplained ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:hasDeviationNote ?has_deviation_note . }
    OPTIONAL { $this effortless-ntwf:isLate ?is_late . }
                BIND((?is_late && (!(?has_deviation_note))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_AvailableExceptionCountForStep" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:availableExceptionCountForStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:availableExceptionCount ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HadUninvokedExceptionAvailable" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hadUninvokedExceptionAvailable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:availableExceptionCountForStep ?available_exception_count_for_step . }
    OPTIONAL { $this effortless-ntwf:isLateAndUnexplained ?is_late_and_unexplained . }
                BIND((?is_late_and_unexplained && (?available_exception_count_for_step > 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ExpectedVerificationCount" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:expectedVerificationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:declaredVerificationCount ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_PerformedVerificationCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:performedVerificationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:VerificationOutcomes .
                    ?child effortless-ntwf:stepExecution $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_SkippedVerificationCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:skippedVerificationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:expectedVerificationCount ?expected_verification_count . }
    OPTIONAL { $this effortless-ntwf:performedVerificationCount ?performed_verification_count . }
                BIND((?expected_verification_count - ?performed_verification_count) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_HasSkippedVerification" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasSkippedVerification ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:skippedVerificationCount ?skipped_verification_count . }
                BIND((?skipped_verification_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_ClaimsPassWithoutEvidence" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:claimsPassWithoutEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
    OPTIONAL { $this effortless-ntwf:hasSkippedVerification ?has_skipped_verification . }
    OPTIONAL { $this effortless-ntwf:verificationResult ?verification_result . }
                BIND(((REPLACE(COALESCE(STR(?verification_result), ""), "^.*#", "") = "PASS") && ?has_skipped_verification) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StepExecutions_StepIsPreparation" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepIsPreparation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StepExecutions .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:isPreparationStep ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
