            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:optOutPhrasePosition ?opt_out_phrase_position . }
                BIND((?opt_out_phrase_position > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MessageDeliveries_IsOptOutInFirstSegment" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
