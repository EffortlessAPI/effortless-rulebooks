    OPTIONAL { $this effortless-ntwf:isAcknowledged ?is_acknowledged . }
    OPTIONAL { $this effortless-ntwf:recipientIsUnreachable ?recipient_is_unreachable . }
                BIND((?recipient_is_unreachable && ?is_acknowledged) AS ?_result)
            }
