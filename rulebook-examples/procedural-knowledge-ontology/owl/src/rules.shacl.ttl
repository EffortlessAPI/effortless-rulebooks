            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:policyRequiredOptOutPhrase ?policy_required_opt_out_phrase . }
    OPTIONAL { $this effortless-ntwf:renderedBody ?rendered_body . }
                BIND(IF(isNumeric(IF(CONTAINS(STR(?rendered_body), STR(?policy_required_opt_out_phrase)), STRLEN(STRBEFORE(STR(?rendered_body), STR(?policy_required_opt_out_phrase))) + 1, 0)), ROUND(IF(CONTAINS(STR(?rendered_body), STR(?policy_required_opt_out_phrase)), STRLEN(STRBEFORE(STR(?rendered_body), STR(?policy_required_opt_out_phrase))) + 1, 0)), IF(CONTAINS(STR(?rendered_body), STR(?policy_required_opt_out_phrase)), STRLEN(STRBEFORE(STR(?rendered_body), STR(?policy_required_opt_out_phrase))) + 1, 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
