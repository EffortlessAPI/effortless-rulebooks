            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssuedTokens .
    OPTIONAL { $this effortless-ntwf:appUser ?app_user . }
    OPTIONAL { $this effortless-ntwf:issuedAt ?issued_at . }
    OPTIONAL { $this effortless-ntwf:principal ?principal . }
                BIND(CONCAT(COALESCE(IF(isIRI(?app_user), REPLACE(STR(?app_user), "^.*[#/]", ""), IF(DATATYPE(?app_user) = xsd:dateTime, CONCAT(SUBSTR(STR(?app_user), 1, 10), " ", SUBSTR(STR(?app_user), 12, 8), IF(TZ(?app_user) = "Z", "+00", IF(STRENDS(TZ(?app_user), ":00"), SUBSTR(TZ(?app_user), 1, 3), TZ(?app_user)))), STR(?app_user))), ""), " as ", COALESCE(IF(isIRI(?principal), REPLACE(STR(?principal), "^.*[#/]", ""), IF(DATATYPE(?principal) = xsd:dateTime, CONCAT(SUBSTR(STR(?principal), 1, 10), " ", SUBSTR(STR(?principal), 12, 8), IF(TZ(?principal) = "Z", "+00", IF(STRENDS(TZ(?principal), ":00"), SUBSTR(TZ(?principal), 1, 3), TZ(?principal)))), STR(?principal))), ""), " @ ", COALESCE(IF(isIRI(?issued_at), REPLACE(STR(?issued_at), "^.*[#/]", ""), IF(DATATYPE(?issued_at) = xsd:dateTime, CONCAT(SUBSTR(STR(?issued_at), 1, 10), " ", SUBSTR(STR(?issued_at), 12, 8), IF(TZ(?issued_at) = "Z", "+00", IF(STRENDS(TZ(?issued_at), ":00"), SUBSTR(TZ(?issued_at), 1, 3), TZ(?issued_at)))), STR(?issued_at))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IssuedTokens_IsDevMinted" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isDevMinted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IssuedTokens .
    OPTIONAL { $this effortless-ntwf:issuer ?issuer . }
                BIND((REPLACE(COALESCE(STR(?issuer), ""), "^.*#", "") = "dev-mint") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for JwtClaimMappings ===
effortless-ntwf:JwtClaimMappingsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:JwtClaimMappings ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_JwtClaimMappings_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:JwtClaimMappings .
    OPTIONAL { $this effortless-ntwf:claimName ?claim_name . }
    OPTIONAL { $this effortless-ntwf:sqlAccessor ?sql_accessor . }
                BIND(CONCAT(COALESCE(IF(isIRI(?claim_name), REPLACE(STR(?claim_name), "^.*[#/]", ""), IF(DATATYPE(?claim_name) = xsd:dateTime, CONCAT(SUBSTR(STR(?claim_name), 1, 10), " ", SUBSTR(STR(?claim_name), 12, 8), IF(TZ(?claim_name) = "Z", "+00", IF(STRENDS(TZ(?claim_name), ":00"), SUBSTR(TZ(?claim_name), 1, 3), TZ(?claim_name)))), STR(?claim_name))), ""), " -> ", COALESCE(IF(isIRI(?sql_accessor), REPLACE(STR(?sql_accessor), "^.*[#/]", ""), IF(DATATYPE(?sql_accessor) = xsd:dateTime, CONCAT(SUBSTR(STR(?sql_accessor), 1, 10), " ", SUBSTR(STR(?sql_accessor), 12, 8), IF(TZ(?sql_accessor) = "Z", "+00", IF(STRENDS(TZ(?sql_accessor), ":00"), SUBSTR(TZ(?sql_accessor), 1, 3), TZ(?sql_accessor)))), STR(?sql_accessor))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_JwtClaimMappings_UsageCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:usageCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:JwtClaimMappings .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AccessPolicies .
                    $this effortless-ntwf:sqlAccessor ?p0 .
                    ?child effortless-ntwf:rowPredicate ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeBrokerLinks ===
effortless-ntwf:KnowledgeBrokerLinksShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeBrokerLinks ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:broker ?broker . }
    OPTIONAL { $this effortless-ntwf:seeker ?seeker . }
                BIND(CONCAT(COALESCE(IF(isIRI(?seeker), REPLACE(STR(?seeker), "^.*[#/]", ""), IF(DATATYPE(?seeker) = xsd:dateTime, CONCAT(SUBSTR(STR(?seeker), 1, 10), " ", SUBSTR(STR(?seeker), 12, 8), IF(TZ(?seeker) = "Z", "+00", IF(STRENDS(TZ(?seeker), ":00"), SUBSTR(TZ(?seeker), 1, 3), TZ(?seeker)))), STR(?seeker))), ""), " -> ", COALESCE(IF(isIRI(?broker), REPLACE(STR(?broker), "^.*[#/]", ""), IF(DATATYPE(?broker) = xsd:dateTime, CONCAT(SUBSTR(STR(?broker), 1, 10), " ", SUBSTR(STR(?broker), 12, 8), IF(TZ(?broker) = "Z", "+00", IF(STRENDS(TZ(?broker), ":00"), SUBSTR(TZ(?broker), 1, 3), TZ(?broker)))), STR(?broker))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_AsOfInstant" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 ; effortless-ntwf:asOfInstant ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_DaysSinceConsulted" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceConsulted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:lastConsultedAt ?last_consulted_at . }
                BIND(IF(isNumeric(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_consulted_at) + FLOOR((153 * (MONTH(?last_consulted_at) + 12 * FLOOR((14 - MONTH(?last_consulted_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) + FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 4) - FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 100) + FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 400) - 32045))), ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_consulted_at) + FLOOR((153 * (MONTH(?last_consulted_at) + 12 * FLOOR((14 - MONTH(?last_consulted_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) + FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 4) - FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 100) + FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 400) - 32045))), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?last_consulted_at) + FLOOR((153 * (MONTH(?last_consulted_at) + 12 * FLOOR((14 - MONTH(?last_consulted_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) + FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 4) - FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 100) + FLOOR((YEAR(?last_consulted_at) + 4800 - FLOOR((14 - MONTH(?last_consulted_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_IsActiveReliance" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isActiveReliance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:daysSinceConsulted ?days_since_consulted . }
    OPTIONAL { $this effortless-ntwf:frequency ?frequency . }
                BIND(((!((REPLACE(COALESCE(STR(?frequency), ""), "^.*#", "") = "Rarely"))) && (?days_since_consulted <= 180)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_BrokerIsStillEngaged" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:brokerIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
                OPTIONAL { $this effortless-ntwf:broker ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:isStillEngaged ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_IsAtRiskReliance" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isAtRiskReliance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:brokerIsStillEngaged ?broker_is_still_engaged . }
    OPTIONAL { $this effortless-ntwf:isActiveReliance ?is_active_reliance . }
                BIND((?is_active_reliance && (!(?broker_is_still_engaged))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_ActiveRelianceBrokerKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:activeRelianceBrokerKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:broker ?broker . }
    OPTIONAL { $this effortless-ntwf:isActiveReliance ?is_active_reliance . }
                BIND(IF(COALESCE(?is_active_reliance, false), ?broker, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeBrokerLinks_AtRiskBrokerKey" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:atRiskBrokerKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeBrokerLinks .
    OPTIONAL { $this effortless-ntwf:broker ?broker . }
    OPTIONAL { $this effortless-ntwf:isAtRiskReliance ?is_at_risk_reliance . }
                BIND(IF(COALESCE(?is_at_risk_reliance, false), ?broker, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for KnowledgeFragments ===
effortless-ntwf:KnowledgeFragmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:KnowledgeFragments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:knowledgeForm ?knowledge_form . }
    OPTIONAL { $this effortless-ntwf:statement ?statement . }
                BIND(CONCAT(COALESCE(IF(isIRI(?knowledge_form), REPLACE(STR(?knowledge_form), "^.*[#/]", ""), IF(DATATYPE(?knowledge_form) = xsd:dateTime, CONCAT(SUBSTR(STR(?knowledge_form), 1, 10), " ", SUBSTR(STR(?knowledge_form), 12, 8), IF(TZ(?knowledge_form) = "Z", "+00", IF(STRENDS(TZ(?knowledge_form), ":00"), SUBSTR(TZ(?knowledge_form), 1, 3), TZ(?knowledge_form)))), STR(?knowledge_form))), ""), ": ", COALESCE(IF(isIRI(SUBSTR(STR(?statement), 1, 60)), REPLACE(STR(SUBSTR(STR(?statement), 1, 60)), "^.*[#/]", ""), IF(DATATYPE(SUBSTR(STR(?statement), 1, 60)) = xsd:dateTime, CONCAT(SUBSTR(STR(SUBSTR(STR(?statement), 1, 60)), 1, 10), " ", SUBSTR(STR(SUBSTR(STR(?statement), 1, 60)), 12, 8), IF(TZ(SUBSTR(STR(?statement), 1, 60)) = "Z", "+00", IF(STRENDS(TZ(SUBSTR(STR(?statement), 1, 60)), ":00"), SUBSTR(TZ(SUBSTR(STR(?statement), 1, 60)), 1, 3), TZ(SUBSTR(STR(?statement), 1, 60))))), STR(SUBSTR(STR(?statement), 1, 60)))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_AsOfInstant" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 ; effortless-ntwf:asOfInstant ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsCurrentlyValid" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrentlyValid ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND(((?valid_from <= ?as_of_instant) && ((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = "") || (?valid_to > ?as_of_instant)) && (REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_SourceAgentIsStillEngaged" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:sourceAgentIsStillEngaged ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:sourceAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:isStillEngaged ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_SourceAgentKind" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:sourceAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:sourceAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:agentKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_HasHumanSource" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasHumanSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:sourceAgentKind ?source_agent_kind . }
                BIND((REPLACE(COALESCE(STR(?source_agent_kind), ""), "^.*#", "") = "Human") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_HasOrphanedProvenance" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasOrphanedProvenance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this effortless-ntwf:sourceAgentIsStillEngaged ?source_agent_is_still_engaged . }
                BIND((?is_currently_valid && (!(?source_agent_is_still_engaged))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsUndefendableTacitClaim" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUndefendableTacitClaim ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:hasOrphanedProvenance ?has_orphaned_provenance . }
    OPTIONAL { $this effortless-ntwf:knowledgeForm ?knowledge_form . }
                BIND((?has_orphaned_provenance && ((REPLACE(COALESCE(STR(?knowledge_form), ""), "^.*#", "") = "Tacit") || (REPLACE(COALESCE(STR(?knowledge_form), ""), "^.*#", "") = "SituatedJudgment"))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsApproved" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isApproved ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Approved") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsWithinValidityWindow" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isWithinValidityWindow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND(((?valid_from <= ?as_of_instant) && ((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = "") || (?valid_to > ?as_of_instant))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsReliedUpon" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isReliedUpon ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isWithinValidityWindow ?is_within_validity_window . }
    OPTIONAL { $this effortless-ntwf:step ?step . }
                BIND(((REPLACE(COALESCE(STR(?step), ""), "^.*#", "") != "") && ?is_within_validity_window) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_StepProcedureVersionStatus" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepProcedureVersionStatus ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:step ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Steps ; effortless-ntwf:stepId ?j2 ; effortless-ntwf:procedureVersion ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsAttachedToLiveVersion" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isAttachedToLiveVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 ; effortless-ntwf:isLive ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsUnapprovedButReliedOn" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnapprovedButReliedOn ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isApproved ?is_approved . }
    OPTIONAL { $this effortless-ntwf:isAttachedToLiveVersion ?is_attached_to_live_version . }
    OPTIONAL { $this effortless-ntwf:isReliedUpon ?is_relied_upon . }
                BIND((?is_relied_upon && ?is_attached_to_live_version && (!(?is_approved))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_EvidenceAgeDays" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:evidenceAgeDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:elicitationSession ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ElicitationSessions ; effortless-ntwf:elicitationSessionId ?j2 ; effortless-ntwf:daysSinceElicited ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_HasRecordedElicitation" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasRecordedElicitation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:elicitationSession ?elicitation_session . }
                BIND((REPLACE(COALESCE(STR(?elicitation_session), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsFromSingleWitness" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isFromSingleWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:elicitationSession ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ElicitationSessions ; effortless-ntwf:elicitationSessionId ?j2 ; effortless-ntwf:isSingleWitnessMethod ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_EvidenceExpiryDays" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:evidenceExpiryDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isFromSingleWitness ?is_from_single_witness . }
                BIND(IF(isNumeric(IF(COALESCE(?is_from_single_witness, false), 180, 365)), ROUND(IF(COALESCE(?is_from_single_witness, false), 180, 365)), IF(COALESCE(?is_from_single_witness, false), 180, 365)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_EvidenceHasExpired" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:evidenceHasExpired ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:evidenceAgeDays ?evidence_age_days . }
    OPTIONAL { $this effortless-ntwf:evidenceExpiryDays ?evidence_expiry_days . }
    OPTIONAL { $this effortless-ntwf:hasRecordedElicitation ?has_recorded_elicitation . }
                BIND((?has_recorded_elicitation && (?evidence_age_days > ?evidence_expiry_days)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_OwnerAgent" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ownerAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                OPTIONAL { $this effortless-ntwf:ownerRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 ; effortless-ntwf:currentAgent ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsAwaitingApproval" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isAwaitingApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Reviewed") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_OwnerIsMe" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ownerIsMe ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:ownerRole ?owner_role . }
                BIND((REPLACE(COALESCE(STR(?owner_role), ""), "^.*#", "") = "hr-policy-owner") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsMyUnfinishedApproval" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isMyUnfinishedApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isAwaitingApproval ?is_awaiting_approval . }
    OPTIONAL { $this effortless-ntwf:ownerIsMe ?owner_is_me . }
                BIND((?owner_is_me && ?is_awaiting_approval) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsInvokedByAnException" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isInvokedByAnException ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Exceptions .
                    $this effortless-ntwf:step ?p0 .
                    ?child effortless-ntwf:triggerStep ?c0 .
                    FILTER(IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_HasOperationalReliance" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasOperationalReliance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:isInvokedByAnException ?is_invoked_by_an_exception . }
                BIND((?is_invoked_by_an_exception > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsUnapprovedAndOperationallyLive" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnapprovedAndOperationallyLive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:hasOperationalReliance ?has_operational_reliance . }
    OPTIONAL { $this effortless-ntwf:isMyUnfinishedApproval ?is_my_unfinished_approval . }
                BIND((?is_my_unfinished_approval && ?has_operational_reliance) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_AgeDays" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:ageDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
                BIND(IF(isNumeric(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?valid_from) + FLOOR((153 * (MONTH(?valid_from) + 12 * FLOOR((14 - MONTH(?valid_from)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 4) - FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 100) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 400) - 32045))), ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?valid_from) + FLOOR((153 * (MONTH(?valid_from) + 12 * FLOOR((14 - MONTH(?valid_from)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 4) - FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 100) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 400) - 32045))), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?valid_from) + FLOOR((153 * (MONTH(?valid_from) + 12 * FLOOR((14 - MONTH(?valid_from)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 4) - FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 100) + FLOOR((YEAR(?valid_from) + 4800 - FLOOR((14 - MONTH(?valid_from)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_KnowledgeFragments_IsLowConfidence" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isLowConfidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:KnowledgeFragments .
    OPTIONAL { $this effortless-ntwf:confidence ?confidence . }
                BIND(((REPLACE(COALESCE(STR(?confidence), ""), "^.*#", "") = "Medium") || (REPLACE(COALESCE(STR(?confidence), ""), "^.*#", "") = "Low")) AS ?_result)
            }
        """ ;
