    $this a effortless-ntwf:Steps .
    OPTIONAL { $this effortless-ntwf:assignedAgentKind ?assigned_agent_kind . }
                BIND(((REPLACE(COALESCE(STR(?assigned_agent_kind), ""), "^.*#", "") = "AIAgent") || (REPLACE(COALESCE(STR(?assigned_agent_kind), ""), "^.*#", "") = "AutomatedPipeline")) AS ?_result)
            }
