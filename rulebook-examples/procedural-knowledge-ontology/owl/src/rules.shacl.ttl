            }
            WHERE {
    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:deliveryStatus ?delivery_status . }
                BIND(((REPLACE(COALESCE(STR(?delivery_status), ""), "^.*#", "") = "Failed") || (REPLACE(COALESCE(STR(?delivery_status), ""), "^.*#", "") = "Bounced")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
