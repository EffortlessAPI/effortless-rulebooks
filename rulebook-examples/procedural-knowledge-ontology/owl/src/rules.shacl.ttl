                $this effortless-ntwf:authorityRoleLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ChangeRequests .
                OPTIONAL { $this effortless-ntwf:authorityRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 ; effortless-ntwf:label ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ChangeRequests_TouchesLiveVersion" ;
