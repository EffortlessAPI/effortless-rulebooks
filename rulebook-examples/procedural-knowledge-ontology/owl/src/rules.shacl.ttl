    $this a effortless-ntwf:MessageTemplates .
                OPTIONAL { $this effortless-ntwf:lastValidApproval ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:TemplateApprovals ; effortless-ntwf:templateApprovalId ?j2 ; effortless-ntwf:decidedAt ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ObservedTransitions ===
effortless-ntwf:ObservedTransitionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ObservedTransitions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ObservedTransitions_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ObservedTransitions .
    OPTIONAL { $this effortless-ntwf:observedAt ?observed_at . }
    OPTIONAL { $this effortless-ntwf:stepTransition ?step_transition . }
                BIND(CONCAT(COALESCE(IF(isIRI(?step_transition), REPLACE(STR(?step_transition), "^.*[#/]", ""), IF(DATATYPE(?step_transition) = xsd:dateTime, CONCAT(SUBSTR(STR(?step_transition), 1, 10), " ", SUBSTR(STR(?step_transition), 12, 8), IF(TZ(?step_transition) = "Z", "+00", IF(STRENDS(TZ(?step_transition), ":00"), SUBSTR(TZ(?step_transition), 1, 3), TZ(?step_transition)))), STR(?step_transition))), ""), " @ ", COALESCE(IF(isIRI(?observed_at), REPLACE(STR(?observed_at), "^.*[#/]", ""), IF(DATATYPE(?observed_at) = xsd:dateTime, CONCAT(SUBSTR(STR(?observed_at), 1, 10), " ", SUBSTR(STR(?observed_at), 12, 8), IF(TZ(?observed_at) = "Z", "+00", IF(STRENDS(TZ(?observed_at), ":00"), SUBSTR(TZ(?observed_at), 1, 3), TZ(?observed_at)))), STR(?observed_at))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for OntologyProfiles ===
effortless-ntwf:OntologyProfilesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OntologyProfiles ;
