    $this a effortless-ntwf:OntologyProfiles .
    OPTIONAL { $this effortless-ntwf:label ?label . }
    OPTIONAL { $this effortless-ntwf:version ?version . }
                BIND(CONCAT(COALESCE(IF(isIRI(?label), REPLACE(STR(?label), "^.*[#/]", ""), IF(DATATYPE(?label) = xsd:dateTime, CONCAT(SUBSTR(STR(?label), 1, 10), " ", SUBSTR(STR(?label), 12, 8), IF(TZ(?label) = "Z", "+00", IF(STRENDS(TZ(?label), ":00"), SUBSTR(TZ(?label), 1, 3), TZ(?label)))), STR(?label))), ""), " ", COALESCE(IF(isIRI(?version), REPLACE(STR(?version), "^.*[#/]", ""), IF(DATATYPE(?version) = xsd:dateTime, CONCAT(SUBSTR(STR(?version), 1, 10), " ", SUBSTR(STR(?version), 12, 8), IF(TZ(?version) = "Z", "+00", IF(STRENDS(TZ(?version), ":00"), SUBSTR(TZ(?version), 1, 3), TZ(?version)))), STR(?version))), "")) AS ?_result)
            }
