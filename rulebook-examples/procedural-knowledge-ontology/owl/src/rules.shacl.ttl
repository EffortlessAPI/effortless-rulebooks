    $this a effortless-ntwf:MessageDeliveries .
    OPTIONAL { $this effortless-ntwf:isWithinRetentionWindow ?is_within_retention_window . }
    OPTIONAL { $this effortless-ntwf:wasActuallyTransmitted ?was_actually_transmitted . }
                BIND((?was_actually_transmitted && ?is_within_retention_window) AS ?_result)
            }
