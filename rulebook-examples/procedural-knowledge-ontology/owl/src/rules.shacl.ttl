                $this effortless-ntwf:isLoadBearingOrphan ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:isStillReferenced ?is_still_referenced . }
    OPTIONAL { $this effortless-ntwf:isUnstewarded ?is_unstewarded . }
    OPTIONAL { $this effortless-ntwf:stillOwnsValidKnowledge ?still_owns_valid_knowledge . }
                BIND((?is_unstewarded && (?still_owns_valid_knowledge || ?is_still_referenced)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsCleanlyRetired" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isCleanlyRetired ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:isStillReferenced ?is_still_referenced . }
    OPTIONAL { $this effortless-ntwf:isUnstewarded ?is_unstewarded . }
    OPTIONAL { $this effortless-ntwf:stillOwnsValidKnowledge ?still_owns_valid_knowledge . }
                BIND((?is_unstewarded && (!(?still_owns_valid_knowledge)) && (!(?is_still_referenced))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_StalledImplementationCount" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stalledImplementationCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeRequests .
                    $this effortless-ntwf:procedureVersionId ?p0 .
                    ?child effortless-ntwf:stalledImplementationVersionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_IsHeldUnfitByLandedDecisions" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isHeldUnfitByLandedDecisions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:isFitToExecute ?is_fit_to_execute . }
    OPTIONAL { $this effortless-ntwf:stalledImplementationCount ?stalled_implementation_count . }
                BIND(((!(?is_fit_to_execute)) && (?stalled_implementation_count > 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_UndeclaredControlKindCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:undeclaredControlKindCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Steps .
                    $this effortless-ntwf:procedureVersionId ?p0 .
                    ?child effortless-ntwf:undeclaredControlVersionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ControlTaxonomyIsIncomplete" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:controlTaxonomyIsIncomplete ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:undeclaredControlKindCount ?undeclared_control_kind_count . }
                BIND((?undeclared_control_kind_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HasApprovedChangeRequest" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasApprovedChangeRequest ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:approvedChangeRequestCount ?approved_change_request_count . }
                BIND((?approved_change_request_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_ApprovedChangeRequestCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:approvedChangeRequestCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ChangeRequests .
                    $this effortless-ntwf:procedureVersionId ?p0 .
                    ?child effortless-ntwf:approvedVersionKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_UnwatchedUnownedControlCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unwatchedUnownedControlCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:Requirements .
                    OPTIONAL { ?child effortless-ntwf:unwatchedUnownedFlag ?c0 . }
                    FILTER(STR(?c0) = "unwatched-unowned")
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_MiningRunCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:miningRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcessMiningRuns .
                    ?child effortless-ntwf:procedureVersion $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_DriftedMiningRunCount" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:driftedMiningRunCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:ProcessMiningRuns .
                    $this effortless-ntwf:procedureVersionId ?p0 .
                    ?child effortless-ntwf:driftedMiningRunKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcedureVersions_HasUnresolvedMiningDrift" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasUnresolvedMiningDrift ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcedureVersions .
    OPTIONAL { $this effortless-ntwf:driftedMiningRunCount ?drifted_mining_run_count . }
                BIND((?drifted_mining_run_count > 0) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Procedures ===
effortless-ntwf:ProceduresShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Procedures ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Procedures_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Procedures .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ProcessMiningRuns ===
effortless-ntwf:ProcessMiningRunsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ProcessMiningRuns ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:eventLogSource ?event_log_source . }
    OPTIONAL { $this effortless-ntwf:minedAt ?mined_at . }
                BIND(CONCAT(COALESCE(IF(isIRI(?event_log_source), REPLACE(STR(?event_log_source), "^.*[#/]", ""), IF(DATATYPE(?event_log_source) = xsd:dateTime, CONCAT(SUBSTR(STR(?event_log_source), 1, 10), " ", SUBSTR(STR(?event_log_source), 12, 8), IF(TZ(?event_log_source) = "Z", "+00", IF(STRENDS(TZ(?event_log_source), ":00"), SUBSTR(TZ(?event_log_source), 1, 3), TZ(?event_log_source)))), STR(?event_log_source))), ""), " / ", COALESCE(IF(isIRI(?mined_at), REPLACE(STR(?mined_at), "^.*[#/]", ""), IF(DATATYPE(?mined_at) = xsd:dateTime, CONCAT(SUBSTR(STR(?mined_at), 1, 10), " ", SUBSTR(STR(?mined_at), 12, 8), IF(TZ(?mined_at) = "Z", "+00", IF(STRENDS(TZ(?mined_at), ":00"), SUBSTR(TZ(?mined_at), 1, 3), TZ(?mined_at)))), STR(?mined_at))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_AsOfInstant" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 ; effortless-ntwf:asOfInstant ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_ConformanceRate" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:conformanceRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:conformingVariantCount ?conforming_variant_count . }
    OPTIONAL { $this effortless-ntwf:discoveredVariantCount ?discovered_variant_count . }
                BIND(IF(COALESCE((?discovered_variant_count = 0), false), 0, (?conforming_variant_count / ?discovered_variant_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsConformant" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isConformant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:conformanceRate ?conformance_rate . }
                BIND((?conformance_rate >= 0.8) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_HasMajorDriftFromDocumentation" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasMajorDriftFromDocumentation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:conformanceRate ?conformance_rate . }
                BIND((?conformance_rate < 0.5) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_DaysSinceMined" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceMined ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:minedAt ?mined_at . }
                BIND(IF(isNumeric(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?mined_at) + FLOOR((153 * (MONTH(?mined_at) + 12 * FLOOR((14 - MONTH(?mined_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) + FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 4) - FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 100) + FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 400) - 32045))), ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?mined_at) + FLOOR((153 * (MONTH(?mined_at) + 12 * FLOOR((14 - MONTH(?mined_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) + FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 4) - FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 100) + FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 400) - 32045))), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?mined_at) + FLOOR((153 * (MONTH(?mined_at) + 12 * FLOOR((14 - MONTH(?mined_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) + FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 4) - FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 100) + FLOOR((YEAR(?mined_at) + 4800 - FLOOR((14 - MONTH(?mined_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsStaleMiningEvidence" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isStaleMiningEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:daysSinceMined ?days_since_mined . }
                BIND((?days_since_mined > 180) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_ProcedureVersionIsLive" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:procedureVersionIsLive ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 ; effortless-ntwf:isLive ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_IsDriftOnLiveVersion" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isDriftOnLiveVersion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:hasMajorDriftFromDocumentation ?has_major_drift_from_documentation . }
    OPTIONAL { $this effortless-ntwf:procedureVersionIsLive ?procedure_version_is_live . }
                BIND((?has_major_drift_from_documentation && ?procedure_version_is_live) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ProcessMiningRuns_DriftedMiningRunKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:driftedMiningRunKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ProcessMiningRuns .
    OPTIONAL { $this effortless-ntwf:isDriftOnLiveVersion ?is_drift_on_live_version . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_drift_on_live_version, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Rationales ===
effortless-ntwf:RationalesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Rationales ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Rationales_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Rationales .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Recipients ===
effortless-ntwf:RecipientsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Recipients ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:displayName ?display_name . }
                BIND(?display_name AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_HasSmsConsent" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasSmsConsent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:smsConsentStatus ?sms_consent_status . }
                BIND((REPLACE(COALESCE(STR(?sms_consent_status), ""), "^.*#", "") = "Granted") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsEmailReachable" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isEmailReachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:emailAddress ?email_address . }
                BIND((REPLACE(COALESCE(STR(?email_address), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsSmsReachable" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isSmsReachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:mobileNumber ?mobile_number . }
                BIND((REPLACE(COALESCE(STR(?mobile_number), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsUnreachable" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnreachable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:isEmailReachable ?is_email_reachable . }
    OPTIONAL { $this effortless-ntwf:isSmsReachable ?is_sms_reachable . }
                BIND(((!(?is_email_reachable)) && (!(?is_sms_reachable))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Recipients_IsCommunicationallyStranded" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isCommunicationallyStranded ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Recipients .
    OPTIONAL { $this effortless-ntwf:isEmailReachable ?is_email_reachable . }
    OPTIONAL { $this effortless-ntwf:isSmsReachable ?is_sms_reachable . }
                BIND(((!(?is_sms_reachable)) && (!(?is_email_reachable))) AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RequirementSatisfactions ===
effortless-ntwf:RequirementSatisfactionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RequirementSatisfactions ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:requirement ?requirement . }
    OPTIONAL { $this effortless-ntwf:satisfactionLevel ?satisfaction_level . }
                BIND(CONCAT(COALESCE(IF(isIRI(?requirement), REPLACE(STR(?requirement), "^.*[#/]", ""), IF(DATATYPE(?requirement) = xsd:dateTime, CONCAT(SUBSTR(STR(?requirement), 1, 10), " ", SUBSTR(STR(?requirement), 12, 8), IF(TZ(?requirement) = "Z", "+00", IF(STRENDS(TZ(?requirement), ":00"), SUBSTR(TZ(?requirement), 1, 3), TZ(?requirement)))), STR(?requirement))), ""), " / ", COALESCE(IF(isIRI(?satisfaction_level), REPLACE(STR(?satisfaction_level), "^.*[#/]", ""), IF(DATATYPE(?satisfaction_level) = xsd:dateTime, CONCAT(SUBSTR(STR(?satisfaction_level), 1, 10), " ", SUBSTR(STR(?satisfaction_level), 12, 8), IF(TZ(?satisfaction_level) = "Z", "+00", IF(STRENDS(TZ(?satisfaction_level), ":00"), SUBSTR(TZ(?satisfaction_level), 1, 3), TZ(?satisfaction_level)))), STR(?satisfaction_level))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RequirementIsBlocking" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:requirementIsBlocking ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 ; effortless-ntwf:isBlocking ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsFullySatisfied" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isFullySatisfied ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:satisfactionLevel ?satisfaction_level . }
                BIND((REPLACE(COALESCE(STR(?satisfaction_level), ""), "^.*#", "") = "Satisfied") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsBlockingAndUnmet" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isBlockingAndUnmet ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
                BIND((?requirement_is_blocking && (!(?is_fully_satisfied))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_BlockingUnmetStepKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:blockingUnmetStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isBlockingAndUnmet ?is_blocking_and_unmet . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_blocking_and_unmet, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_BlockingSatisfactionStepKey" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:blockingSatisfactionStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?requirement_is_blocking, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_NegativeOutcomeRequirementKey" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:negativeOutcomeRequirementKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this effortless-ntwf:requirement ?requirement . }
                BIND(IF(COALESCE((!(?is_fully_satisfied)), false), ?requirement, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_EvaluatorAgentKind" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:evaluatorAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:evaluatedByAgent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:agentKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_NonHumanEvaluatedHumanControl" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:nonHumanEvaluatedHumanControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:evaluatorAgentKind ?evaluator_agent_kind . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
                BIND((?requirement_is_blocking && (REPLACE(COALESCE(STR(?evaluator_agent_kind), ""), "^.*#", "") != "Human")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RequirementHasComputedWitness" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:requirementHasComputedWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 ; effortless-ntwf:hasComputedWitness ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsAssertedOnly" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isAssertedOnly ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this effortless-ntwf:requirementHasComputedWitness ?requirement_has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
                BIND((?requirement_is_blocking && ?is_fully_satisfied && (!(?requirement_has_computed_witness))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_AssertedOnlyExecutionKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:assertedOnlyExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isAssertedOnly ?is_asserted_only . }
    OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?parent_procedure_execution . }
                BIND(IF(COALESCE(?is_asserted_only, false), ?parent_procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_ParentProcedureExecution" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:parentProcedureExecution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 ; effortless-ntwf:procedureExecution ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_StepExecutionWhenScored" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepExecutionWhenScored ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:satisfactionLevel ?satisfaction_level . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE((REPLACE(COALESCE(STR(?satisfaction_level), ""), "^.*#", "") != ""), false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsHumanEvaluated" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isHumanEvaluated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:evaluatorAgentKind ?evaluator_agent_kind . }
                BIND((REPLACE(COALESCE(STR(?evaluator_agent_kind), ""), "^.*#", "") = "Human") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RequirementIsApprovalType" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:requirementIsApprovalType ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 ; effortless-ntwf:requirementType ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsInvalidApproval" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isInvalidApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this effortless-ntwf:isHumanEvaluated ?is_human_evaluated . }
    OPTIONAL { $this effortless-ntwf:requirementIsApprovalType ?requirement_is_approval_type . }
                BIND(((REPLACE(COALESCE(STR(?requirement_is_approval_type), ""), "^.*#", "") = "Approval") && ((!(?is_fully_satisfied)) || (!(?is_human_evaluated)))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_ProcedureExecutionOfSatisfaction" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:procedureExecutionOfSatisfaction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 ; effortless-ntwf:procedureExecution ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RunWhenInvalidApproval" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:runWhenInvalidApproval ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isInvalidApproval ?is_invalid_approval . }
    OPTIONAL { $this effortless-ntwf:procedureExecutionOfSatisfaction ?procedure_execution_of_satisfaction . }
                BIND(IF(COALESCE(?is_invalid_approval, false), ?procedure_execution_of_satisfaction, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RequirementIsUnfalsified" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:requirementIsUnfalsified ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:requirement ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Requirements ; effortless-ntwf:requirementId ?j2 ; effortless-ntwf:isUnfalsifiedControl ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsClearanceByUnfalsifiedControl" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isClearanceByUnfalsifiedControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isFullySatisfied ?is_fully_satisfied . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
    OPTIONAL { $this effortless-ntwf:requirementIsUnfalsified ?requirement_is_unfalsified . }
                BIND((?is_fully_satisfied && ?requirement_is_blocking && ?requirement_is_unfalsified) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_UnfalsifiedClearanceStepKey" ;
        sh:order 7 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unfalsifiedClearanceStepKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isClearanceByUnfalsifiedControl ?is_clearance_by_unfalsified_control . }
    OPTIONAL { $this effortless-ntwf:stepExecution ?step_execution . }
                BIND(IF(COALESCE(?is_clearance_by_unfalsified_control, false), ?step_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_SpecStepOfExecution" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:specStepOfExecution ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 ; effortless-ntwf:step ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_BindingKey" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:bindingKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:requirementSatisfactionId ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepRequirements ; effortless-ntwf:stepRequirementId ?j2 ; effortless-ntwf:stepRequirementId ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_ScoredStepExecutorAgent" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:scoredStepExecutorAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 ; effortless-ntwf:executedByAgent ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_EvaluatorIsStepExecutor" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:evaluatorIsStepExecutor ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:evaluatedByAgent ?evaluated_by_agent . }
    OPTIONAL { $this effortless-ntwf:scoredStepExecutorAgent ?scored_step_executor_agent . }
                BIND((?evaluated_by_agent = ?scored_step_executor_agent) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_RunOwnerAgent" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:runOwnerAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureExecutions ; effortless-ntwf:procedureExecutionId ?j2 ; effortless-ntwf:executedByAgent ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_EvaluatorOwnsTheRun" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:evaluatorOwnsTheRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:evaluatedByAgent ?evaluated_by_agent . }
    OPTIONAL { $this effortless-ntwf:runOwnerAgent ?run_owner_agent . }
                BIND((?evaluated_by_agent = ?run_owner_agent) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsInterestedPartyAssertion" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isInterestedPartyAssertion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:evaluatorIsStepExecutor ?evaluator_is_step_executor . }
    OPTIONAL { $this effortless-ntwf:evaluatorOwnsTheRun ?evaluator_owns_the_run . }
    OPTIONAL { $this effortless-ntwf:isAssertedOnly ?is_asserted_only . }
                BIND((?is_asserted_only && (?evaluator_is_step_executor || ?evaluator_owns_the_run)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_HasWrittenEvidence" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasWrittenEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:evidence ?evidence . }
                BIND((REPLACE(COALESCE(STR(?evidence), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsBareAssertion" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isBareAssertion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:hasWrittenEvidence ?has_written_evidence . }
    OPTIONAL { $this effortless-ntwf:isAssertedOnly ?is_asserted_only . }
                BIND((?is_asserted_only && (!(?has_written_evidence))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_InterestedAssertionExecutionKey" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:interestedAssertionExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isInterestedPartyAssertion ?is_interested_party_assertion . }
    OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?parent_procedure_execution . }
                BIND(IF(COALESCE(?is_interested_party_assertion, false), ?parent_procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_IsComputedlyWitnessed" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isComputedlyWitnessed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:requirementHasComputedWitness ?requirement_has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:requirementIsBlocking ?requirement_is_blocking . }
                BIND((?requirement_is_blocking && ?requirement_has_computed_witness) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_ComputedWitnessExecutionKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:computedWitnessExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:isComputedlyWitnessed ?is_computedly_witnessed . }
    OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?parent_procedure_execution . }
                BIND(IF(COALESCE(?is_computedly_witnessed, false), ?parent_procedure_execution, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_StepExecutorAgent" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepExecutorAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:stepExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:StepExecutions ; effortless-ntwf:stepExecutionId ?j2 ; effortless-ntwf:executedByAgent ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_WasScoredAfterAttestation" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:wasScoredAfterAttestation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:attestationInstantForRun ?attestation_instant_for_run . }
    OPTIONAL { $this effortless-ntwf:evaluatedAt ?evaluated_at . }
                BIND((ROUND((((DAY(?evaluated_at) + FLOOR((153 * (MONTH(?evaluated_at) + 12 * FLOOR((14 - MONTH(?evaluated_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 4) - FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 100) + FLOOR((YEAR(?evaluated_at) + 4800 - FLOOR((14 - MONTH(?evaluated_at)) / 12)) / 400) - 32045) * 86400 + COALESCE(HOURS(?evaluated_at), 0) * 3600 + COALESCE(MINUTES(?evaluated_at), 0) * 60 + COALESCE(SECONDS(?evaluated_at), 0) - IF(TZ(?evaluated_at) = "" || TZ(?evaluated_at) = "Z", 0, IF(SUBSTR(TZ(?evaluated_at), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?evaluated_at), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?evaluated_at), 5, 2)) * 60))) - ((DAY(?attestation_instant_for_run) + FLOOR((153 * (MONTH(?attestation_instant_for_run) + 12 * FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?attestation_instant_for_run) + 4800 - FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12)) + FLOOR((YEAR(?attestation_instant_for_run) + 4800 - FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12)) / 4) - FLOOR((YEAR(?attestation_instant_for_run) + 4800 - FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12)) / 100) + FLOOR((YEAR(?attestation_instant_for_run) + 4800 - FLOOR((14 - MONTH(?attestation_instant_for_run)) / 12)) / 400) - 32045) * 86400 + COALESCE(HOURS(?attestation_instant_for_run), 0) * 3600 + COALESCE(MINUTES(?attestation_instant_for_run), 0) * 60 + COALESCE(SECONDS(?attestation_instant_for_run), 0) - IF(TZ(?attestation_instant_for_run) = "" || TZ(?attestation_instant_for_run) = "Z", 0, IF(SUBSTR(TZ(?attestation_instant_for_run), 1, 1) = "-", -1, 1) * (xsd:integer(SUBSTR(TZ(?attestation_instant_for_run), 2, 2)) * 3600 + xsd:integer(SUBSTR(TZ(?attestation_instant_for_run), 5, 2)) * 60)))) / 60) > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_AttestationInstantForRun" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:attestationInstantForRun ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
                OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureExecutions ; effortless-ntwf:procedureExecutionId ?j2 ; effortless-ntwf:latestAttestationInstant ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RequirementSatisfactions_PostAttestationScoreExecutionKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:postAttestationScoreExecutionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RequirementSatisfactions .
    OPTIONAL { $this effortless-ntwf:parentProcedureExecution ?parent_procedure_execution . }
    OPTIONAL { $this effortless-ntwf:wasScoredAfterAttestation ?was_scored_after_attestation . }
                BIND(IF(COALESCE(?was_scored_after_attestation, false), ?parent_procedure_execution, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Requirements ===
effortless-ntwf:RequirementsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Requirements ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_SatisfactionRecordCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:satisfactionRecordCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    ?child effortless-ntwf:requirement $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_StepBindingCount" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stepBindingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepRequirements .
                    ?child effortless-ntwf:requirement $this .
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsBoundToAnyStep" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isBoundToAnyStep ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:stepBindingCount ?step_binding_count . }
                BIND((?step_binding_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_HasEverBeenEvaluated" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasEverBeenEvaluated ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:satisfactionRecordCount ?satisfaction_record_count . }
                BIND((?satisfaction_record_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_NegativeOutcomeCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:negativeOutcomeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:RequirementSatisfactions .
                    $this effortless-ntwf:requirementId ?p0 .
                    ?child effortless-ntwf:negativeOutcomeRequirementKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsInoperativeControl" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isInoperativeControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasEverBeenEvaluated ?has_ever_been_evaluated . }
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
    OPTIONAL { $this effortless-ntwf:isBoundToAnyStep ?is_bound_to_any_step . }
                BIND((COALESCE(?is_blocking, false) && ?is_bound_to_any_step && (!(?has_ever_been_evaluated))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsDecorativeControl" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isDecorativeControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
    OPTIONAL { $this effortless-ntwf:isBoundToAnyStep ?is_bound_to_any_step . }
                BIND((COALESCE(?is_blocking, false) && (!(?is_bound_to_any_step))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_HasEverProducedNegative" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasEverProducedNegative ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:negativeOutcomeCount ?negative_outcome_count . }
                BIND((?negative_outcome_count > 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsUnfalsifiedControl" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnfalsifiedControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasEverBeenEvaluated ?has_ever_been_evaluated . }
    OPTIONAL { $this effortless-ntwf:hasEverProducedNegative ?has_ever_produced_negative . }
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
                BIND((COALESCE(?is_blocking, false) && ?has_ever_been_evaluated && (!(?has_ever_produced_negative))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_ClaimsAWitnessField" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:claimsAWitnessField ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:witnessFieldName ?witness_field_name . }
                BIND((REPLACE(COALESCE(STR(?witness_field_name), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_NamedWitnessFieldExists" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:namedWitnessFieldExists ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
                OPTIONAL { $this effortless-ntwf:witnessFieldName ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RulebookFields ; effortless-ntwf:rulebookFieldId ?j2 ; effortless-ntwf:isDerived ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_DerivedHasComputedWitness" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:derivedHasComputedWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:claimsAWitnessField ?claims_a_witness_field . }
    OPTIONAL { $this effortless-ntwf:namedWitnessFieldExists ?named_witness_field_exists . }
                BIND((?claims_a_witness_field && ?named_witness_field_exists) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_WitnessClaimIsUnverified" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:witnessClaimIsUnverified ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:derivedHasComputedWitness ?derived_has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:hasComputedWitness ?has_computed_witness . }
                BIND((!((?has_computed_witness = ?derived_has_computed_witness))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsUnwitnessedBlockingControl" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwitnessedBlockingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:derivedHasComputedWitness ?derived_has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
                BIND((COALESCE(?is_blocking, false) && (!(?derived_has_computed_witness))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_WitnessFireCount" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:witnessFireCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:negativeOutcomeCount ?negative_outcome_count . }
                BIND(?negative_outcome_count AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_WitnessHasNeverFired" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:witnessHasNeverFired ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:witnessFireCount ?witness_fire_count . }
                BIND((COALESCE(?has_computed_witness, false) && (?witness_fire_count = 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_EvaluationSampleSize" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:evaluationSampleSize ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:satisfactionRecordCount ?satisfaction_record_count . }
                BIND(?satisfaction_record_count AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_HasMeaningfulSample" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasMeaningfulSample ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:evaluationSampleSize ?evaluation_sample_size . }
    OPTIONAL { $this effortless-ntwf:minimumSampleForAssurance ?minimum_sample_for_assurance . }
                BIND((?evaluation_sample_size >= ?minimum_sample_for_assurance) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsUntestedWitness" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUntestedWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasMeaningfulSample ?has_meaningful_sample . }
    OPTIONAL { $this effortless-ntwf:witnessHasNeverFired ?witness_has_never_fired . }
                BIND((?witness_has_never_fired && (!(?has_meaningful_sample))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsEvidencedHoldingControl" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isEvidencedHoldingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasMeaningfulSample ?has_meaningful_sample . }
    OPTIONAL { $this effortless-ntwf:witnessHasNeverFired ?witness_has_never_fired . }
                BIND((?witness_has_never_fired && ?has_meaningful_sample) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_ControlAssuranceState" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:controlAssuranceState ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:hasEverBeenEvaluated ?has_ever_been_evaluated . }
    OPTIONAL { $this effortless-ntwf:hasMeaningfulSample ?has_meaningful_sample . }
    OPTIONAL { $this effortless-ntwf:isBoundToAnyStep ?is_bound_to_any_step . }
    OPTIONAL { $this effortless-ntwf:witnessFireCount ?witness_fire_count . }
                BIND(IF(COALESCE((!(?is_bound_to_any_step)), false), "Decorative", IF(COALESCE((!(?has_ever_been_evaluated)), false), "Inoperative", IF(COALESCE((!(COALESCE(?has_computed_witness, false))), false), "Asserted", IF(COALESCE((?witness_fire_count > 0), false), "Demonstrated", IF(COALESCE(?has_meaningful_sample, false), "Holding", "Untested"))))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_UnexercisedBindingCount" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unexercisedBindingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:StepRequirements .
                    $this effortless-ntwf:requirementId ?p0 .
                    ?child effortless-ntwf:unexercisedBindingRequirementKey ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_WitnessIsPartiallyScoped" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:witnessIsPartiallyScoped ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:unexercisedBindingCount ?unexercised_binding_count . }
                BIND((COALESCE(?has_computed_witness, false) && (?unexercised_binding_count > 0)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_AccountableAgent" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:accountableAgent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
                OPTIONAL { $this effortless-ntwf:accountableRole ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Roles ; effortless-ntwf:roleId ?j2 ; effortless-ntwf:currentAgent ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_HasNamedOwner" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasNamedOwner ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:accountableRole ?accountable_role . }
                BIND((REPLACE(COALESCE(STR(?accountable_role), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsOrphanedBlockingControl" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isOrphanedBlockingControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasNamedOwner ?has_named_owner . }
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
                BIND((COALESCE(?is_blocking, false) && (!(?has_named_owner))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_IsUnwatchedAndUnowned" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnwatchedAndUnowned ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:hasNamedOwner ?has_named_owner . }
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
                BIND((COALESCE(?is_blocking, false) && (!(COALESCE(?has_computed_witness, false))) && (!(?has_named_owner))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_AttestationExposureNote" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:attestationExposureNote ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:hasComputedWitness ?has_computed_witness . }
    OPTIONAL { $this effortless-ntwf:isBlocking ?is_blocking . }
    OPTIONAL { $this effortless-ntwf:isOrphanedBlockingControl ?is_orphaned_blocking_control . }
    OPTIONAL { $this effortless-ntwf:isUnwatchedAndUnowned ?is_unwatched_and_unowned . }
                BIND(IF(COALESCE((!(COALESCE(?is_blocking, false))), false), "", IF(COALESCE(?is_unwatched_and_unowned, false), "Unwatched and unowned: exposure defaults to the signatory.", IF(COALESCE(?is_orphaned_blocking_control, false), "Witnessed but unowned: no named accountability.", IF(COALESCE((!(COALESCE(?has_computed_witness, false))), false), "Owned but unwitnessed: rests on human judgement.", "")))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_UnwatchedUnownedFlag" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:unwatchedUnownedFlag ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:isUnwatchedAndUnowned ?is_unwatched_and_unowned . }
                BIND(IF(COALESCE(?is_unwatched_and_unowned, false), "unwatched-unowned", "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Requirements_UsesControlledVocabulary" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:usesControlledVocabulary ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Requirements .
    OPTIONAL { $this effortless-ntwf:controlledTerm ?controlled_term . }
                BIND((REPLACE(COALESCE(STR(?controlled_term), ""), "^.*#", "") != "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for Resources ===
effortless-ntwf:ResourcesShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Resources ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Resources .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Resources_IsApprovedSource" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isApprovedSource ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Resources .
    OPTIONAL { $this effortless-ntwf:approvalStatus ?approval_status . }
                BIND((REPLACE(COALESCE(STR(?approval_status), ""), "^.*#", "") = "Approved") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for ReviewEvents ===
effortless-ntwf:ReviewEventsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ReviewEvents ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
    OPTIONAL { $this effortless-ntwf:reviewKind ?review_kind . }
                BIND(CONCAT(COALESCE(IF(isIRI(?procedure_version), REPLACE(STR(?procedure_version), "^.*[#/]", ""), IF(DATATYPE(?procedure_version) = xsd:dateTime, CONCAT(SUBSTR(STR(?procedure_version), 1, 10), " ", SUBSTR(STR(?procedure_version), 12, 8), IF(TZ(?procedure_version) = "Z", "+00", IF(STRENDS(TZ(?procedure_version), ":00"), SUBSTR(TZ(?procedure_version), 1, 3), TZ(?procedure_version)))), STR(?procedure_version))), ""), " / ", COALESCE(IF(isIRI(?review_kind), REPLACE(STR(?review_kind), "^.*[#/]", ""), IF(DATATYPE(?review_kind) = xsd:dateTime, CONCAT(SUBSTR(STR(?review_kind), 1, 10), " ", SUBSTR(STR(?review_kind), 12, 8), IF(TZ(?review_kind) = "Z", "+00", IF(STRENDS(TZ(?review_kind), ":00"), SUBSTR(TZ(?review_kind), 1, 3), TZ(?review_kind)))), STR(?review_kind))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_AsOfInstant" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 ; effortless-ntwf:asOfInstant ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_IsOverdue" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isOverdue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:nextReviewDue ?next_review_due . }
                BIND((?next_review_due < ?as_of_instant) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_OverdueVersionKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:overdueVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:isOverdue ?is_overdue . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?is_overdue, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_PromisedCadenceDays" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:promisedCadenceDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
                OPTIONAL { $this effortless-ntwf:procedureVersion ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:ProcedureVersions ; effortless-ntwf:procedureVersionId ?j2 ; effortless-ntwf:stewardReviewCadenceDays ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_DaysSinceReviewed" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:daysSinceReviewed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:reviewedAt ?reviewed_at . }
                BIND(IF(isNumeric(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?reviewed_at) + FLOOR((153 * (MONTH(?reviewed_at) + 12 * FLOOR((14 - MONTH(?reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 400) - 32045))), ROUND(((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?reviewed_at) + FLOOR((153 * (MONTH(?reviewed_at) + 12 * FLOOR((14 - MONTH(?reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 400) - 32045))), ((DAY(?as_of_instant) + FLOOR((153 * (MONTH(?as_of_instant) + 12 * FLOOR((14 - MONTH(?as_of_instant)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 4) - FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 100) + FLOOR((YEAR(?as_of_instant) + 4800 - FLOOR((14 - MONTH(?as_of_instant)) / 12)) / 400) - 32045) - (DAY(?reviewed_at) + FLOOR((153 * (MONTH(?reviewed_at) + 12 * FLOOR((14 - MONTH(?reviewed_at)) / 12) - 3) + 2) / 5) + 365 * (YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 4) - FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 100) + FLOOR((YEAR(?reviewed_at) + 4800 - FLOOR((14 - MONTH(?reviewed_at)) / 12)) / 400) - 32045))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_ExceedsPromisedCadence" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:exceedsPromisedCadence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:daysSinceReviewed ?days_since_reviewed . }
    OPTIONAL { $this effortless-ntwf:promisedCadenceDays ?promised_cadence_days . }
                BIND((?days_since_reviewed > ?promised_cadence_days) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_CadenceDriftDays" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:cadenceDriftDays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:daysSinceReviewed ?days_since_reviewed . }
    OPTIONAL { $this effortless-ntwf:promisedCadenceDays ?promised_cadence_days . }
                BIND(IF(isNumeric((?days_since_reviewed - ?promised_cadence_days)), ROUND((?days_since_reviewed - ?promised_cadence_days)), (?days_since_reviewed - ?promised_cadence_days)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_PromiseAndBehaviorDisagree" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:promiseAndBehaviorDisagree ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:exceedsPromisedCadence ?exceeds_promised_cadence . }
    OPTIONAL { $this effortless-ntwf:isOverdue ?is_overdue . }
                BIND((?exceeds_promised_cadence && (!(?is_overdue))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ReviewEvents_CadenceBreachVersionKey" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:cadenceBreachVersionKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ReviewEvents .
    OPTIONAL { $this effortless-ntwf:exceedsPromisedCadence ?exceeds_promised_cadence . }
    OPTIONAL { $this effortless-ntwf:procedureVersion ?procedure_version . }
                BIND(IF(COALESCE(?exceeds_promised_cadence, false), ?procedure_version, "") AS ?_result)
            }
        """ ;
    ] .

# === Shape with rules for RoleAssignments ===
effortless-ntwf:RoleAssignmentsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoleAssignments ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:role ?role . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
                BIND(CONCAT(COALESCE(IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), IF(DATATYPE(?role) = xsd:dateTime, CONCAT(SUBSTR(STR(?role), 1, 10), " ", SUBSTR(STR(?role), 12, 8), IF(TZ(?role) = "Z", "+00", IF(STRENDS(TZ(?role), ":00"), SUBSTR(TZ(?role), 1, 3), TZ(?role)))), STR(?role))), ""), " @ ", COALESCE(IF(isIRI(?valid_from), REPLACE(STR(?valid_from), "^.*[#/]", ""), IF(DATATYPE(?valid_from) = xsd:dateTime, CONCAT(SUBSTR(STR(?valid_from), 1, 10), " ", SUBSTR(STR(?valid_from), 12, 8), IF(TZ(?valid_from) = "Z", "+00", IF(STRENDS(TZ(?valid_from), ":00"), SUBSTR(TZ(?valid_from), 1, 3), TZ(?valid_from)))), STR(?valid_from))), "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AsOfInstant" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:asOfInstant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:evaluationContext ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:EvaluationContexts ; effortless-ntwf:evaluationContextId ?j2 ; effortless-ntwf:asOfInstant ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsCurrent" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND(((?valid_from <= ?as_of_instant) && ((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = "") || (?valid_to > ?as_of_instant))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_CurrentAgentKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:currentAgentKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:agent ?agent . }
    OPTIONAL { $this effortless-ntwf:isCurrent ?is_current . }
                BIND(IF(COALESCE(?is_current, false), ?agent, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsCurrentlyValid" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isCurrentlyValid ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND(((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Active") && ((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = "") || (?valid_to > ?as_of_instant))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AgentRoleKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:agentRoleKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:agent ?agent . }
    OPTIONAL { $this effortless-ntwf:isCurrentlyValid ?is_currently_valid . }
    OPTIONAL { $this effortless-ntwf:role ?role . }
                BIND(IF(COALESCE(?is_currently_valid, false), CONCAT(COALESCE(IF(isIRI(?agent), REPLACE(STR(?agent), "^.*[#/]", ""), IF(DATATYPE(?agent) = xsd:dateTime, CONCAT(SUBSTR(STR(?agent), 1, 10), " ", SUBSTR(STR(?agent), 12, 8), IF(TZ(?agent) = "Z", "+00", IF(STRENDS(TZ(?agent), ":00"), SUBSTR(TZ(?agent), 1, 3), TZ(?agent)))), STR(?agent))), ""), "|", COALESCE(IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), IF(DATATYPE(?role) = xsd:dateTime, CONCAT(SUBSTR(STR(?role), 1, 10), " ", SUBSTR(STR(?role), 12, 8), IF(TZ(?role) = "Z", "+00", IF(STRENDS(TZ(?role), ":00"), SUBSTR(TZ(?role), 1, 3), TZ(?role)))), STR(?role))), "")), "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasDeparted" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasDeparted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND(((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") != "") && (?valid_to <= ?as_of_instant)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_CoversNow" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:coversNow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:asOfInstant ?as_of_instant . }
    OPTIONAL { $this effortless-ntwf:status ?status . }
    OPTIONAL { $this effortless-ntwf:validFrom ?valid_from . }
    OPTIONAL { $this effortless-ntwf:validTo ?valid_to . }
                BIND(((REPLACE(COALESCE(STR(?status), ""), "^.*#", "") = "Active") && (?valid_from <= ?as_of_instant) && ((REPLACE(COALESCE(STR(?valid_to), ""), "^.*#", "") = "") || (?valid_to > ?as_of_instant))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_RoleWhenCovering" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:roleWhenCovering ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:coversNow ?covers_now . }
    OPTIONAL { $this effortless-ntwf:role ?role . }
                BIND(IF(COALESCE(?covers_now, false), ?role, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_AgentKind" ;
        sh:order 0 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:agentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:agent ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Agents ; effortless-ntwf:agentId ?j2 ; effortless-ntwf:agentKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsNonHumanAssignment" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isNonHumanAssignment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:agentKind ?agent_kind . }
                BIND((!((REPLACE(COALESCE(STR(?agent_kind), ""), "^.*#", "") = "Human"))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorAgentKind" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorAgentKind ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:supersedesAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 ; effortless-ntwf:agentKind ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsHumanToNonHumanHandover" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isHumanToNonHumanHandover ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:isNonHumanAssignment ?is_non_human_assignment . }
    OPTIONAL { $this effortless-ntwf:predecessorAgentKind ?predecessor_agent_kind . }
                BIND(((REPLACE(COALESCE(STR(?predecessor_agent_kind), ""), "^.*#", "") = "Human") && ?is_non_human_assignment) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_IsUnauthorizedNonHumanAssignment" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:isUnauthorizedNonHumanAssignment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:hasApprovingAuthority ?has_approving_authority . }
    OPTIONAL { $this effortless-ntwf:isNonHumanAssignment ?is_non_human_assignment . }
                BIND((?is_non_human_assignment && (!(?has_approving_authority))) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_WasAuthorizedByChangeRequest" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:wasAuthorizedByChangeRequest ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:authorizingChangeRequest ?authorizing_change_request . }
    OPTIONAL { $this effortless-ntwf:hasApprovingAuthority ?has_approving_authority . }
                BIND((?has_approving_authority && (REPLACE(COALESCE(STR(?authorizing_change_request), ""), "^.*#", "") != "")) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_DecisionCount" ;
        sh:order 1 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:decisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    $this effortless-ntwf:roleAssignmentId ?p0 .
                    ?child effortless-ntwf:roleAssignmentWhenScored ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_OverriddenDecisionCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:overriddenDecisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                {
                    SELECT (COUNT(DISTINCT ?child) AS ?_result) WHERE {
                    ?child a effortless-ntwf:AgentDecisionRecords .
                    $this effortless-ntwf:roleAssignmentId ?p0 .
                    ?child effortless-ntwf:roleAssignmentWhenOverridden ?c0 .
                    FILTER(IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)) != "" && IF(isIRI(?c0), REPLACE(STR(?c0), "^.*[#/]", ""), STR(?c0)) = IF(isIRI(?p0), REPLACE(STR(?p0), "^.*[#/]", ""), STR(?p0)))
                    }
                }
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_OverrideRatePercent" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:overrideRatePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:decisionCount ?decision_count . }
    OPTIONAL { $this effortless-ntwf:overriddenDecisionCount ?overridden_decision_count . }
                BIND(IF(COALESCE((?decision_count = 0), false), 0, ((?overridden_decision_count * 100) / ?decision_count)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorOverrideRatePercent" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorOverrideRatePercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:supersedesAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 ; effortless-ntwf:overrideRatePercent ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_QualityRegressedVsPredecessor" ;
        sh:order 5 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:qualityRegressedVsPredecessor ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:overrideRatePercent ?override_rate_percent . }
    OPTIONAL { $this effortless-ntwf:predecessorOverrideRatePercent ?predecessor_override_rate_percent . }
    OPTIONAL { $this effortless-ntwf:supersedesAssignment ?supersedes_assignment . }
                BIND(((REPLACE(COALESCE(STR(?supersedes_assignment), ""), "^.*#", "") != "") && (?override_rate_percent > ?predecessor_override_rate_percent)) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_DepartedRoleKey" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:departedRoleKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:hasDeparted ?has_departed . }
    OPTIONAL { $this effortless-ntwf:role ?role . }
                BIND(IF(COALESCE(?has_departed, false), ?role, "") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorDecisionCount" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorDecisionCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
                OPTIONAL { $this effortless-ntwf:supersedesAssignment ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:RoleAssignments ; effortless-ntwf:roleAssignmentId ?j2 ; effortless-ntwf:decisionCount ?j3 . FILTER(REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "")) }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_HasSufficientSample" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:hasSufficientSample ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:decisionCount ?decision_count . }
    OPTIONAL { $this effortless-ntwf:minimumDecisionsForComparison ?minimum_decisions_for_comparison . }
                BIND((?decision_count >= ?minimum_decisions_for_comparison) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_PredecessorHasSufficientSample" ;
        sh:order 3 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:predecessorHasSufficientSample ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:minimumDecisionsForComparison ?minimum_decisions_for_comparison . }
    OPTIONAL { $this effortless-ntwf:predecessorDecisionCount ?predecessor_decision_count . }
                BIND((?predecessor_decision_count >= ?minimum_decisions_for_comparison) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_ComparisonIsEvidentiallySound" ;
        sh:order 4 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:comparisonIsEvidentiallySound ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:hasSufficientSample ?has_sufficient_sample . }
    OPTIONAL { $this effortless-ntwf:predecessorHasSufficientSample ?predecessor_has_sufficient_sample . }
                BIND((?has_sufficient_sample && ?predecessor_has_sufficient_sample) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_SingleOverrideSwingPercent" ;
        sh:order 2 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:singleOverrideSwingPercent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoleAssignments .
    OPTIONAL { $this effortless-ntwf:decisionCount ?decision_count . }
                BIND(IF(COALESCE((?decision_count > 0), false), (100 / ?decision_count), 0) AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleAssignments_QualityVerdictIsUnsupported" ;
        sh:order 6 ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
