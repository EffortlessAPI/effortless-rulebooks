    rdfs:comment "Exact PKO class IRI." .

# === Class: IssueOccurrences ===
effortless-ntwf:IssueOccurrences a owl:Class ;
    rdfs:label "IssueOccurrences" ;
    rdfs:comment "Concrete issue events during execution. Maps to pko:IssueOccurrence, hasEncounteredError, wasEncounteredBy, issueCause, and issueSolution." .

effortless-ntwf:issueOccurrenceId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range xsd:string ;
    rdfs:label "IssueOccurrenceId" ;
    rdfs:comment "Stored logical identifier for one IssueOccurrences row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
