effortless-ntwf:isBlockedOnPendingDecision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBlockedOnPendingDecision" ;
    rdfs:comment "A live version carrying both an undecided change request and an open blocking gap — the gap cannot close until the decision lands." .
    # calculated: calculated

effortless-ntwf:unexercisedHumanGateCount a owl:DatatypeProperty ;
