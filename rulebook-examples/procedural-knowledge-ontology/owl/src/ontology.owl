effortless-ntwf:miningRunCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "MiningRunCount" ;
    rdfs:comment "How many process-mining conformance runs exist for this procedure version." .
    # calculated: aggregation

effortless-ntwf:driftedMiningRunCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "DriftedMiningRunCount" ;
    rdfs:comment "How many mining runs found major, real drift while this version was live." .
    # calculated: aggregation

effortless-ntwf:hasUnresolvedMiningDrift a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnresolvedMiningDrift" ;
    rdfs:comment "TRUE when mined operational evidence contradicts this live version's documented path." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: Procedures ===
effortless-ntwf:Procedures a owl:Class ;
    rdfs:label "Procedures" ;
    rdfs:comment "Abstract, discoverable procedures. Each version is represented separately in ProcedureVersions. Maps to pko:Procedure and dcat:Resource." .

effortless-ntwf:procedureId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:string ;
    rdfs:label "ProcedureId" ;
    rdfs:comment "Stored logical identifier for one Procedures row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Procedures row." .
    # calculated: calculated

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Human-readable title; maps to dcterms:title." .

effortless-ntwf:procedureType a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range effortless-ntwf:ProcedureTypes ;
    rdfs:label "ProcedureType" ;
    rdfs:comment "Procedure type; maps to pko:hasProcedureType." .

effortless-ntwf:ownerOrganization a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "OwnerOrganization" ;
    rdfs:comment "Organization that owns the procedure." .

effortless-ntwf:adoptedByOrganization a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "AdoptedByOrganization" ;
    rdfs:comment "Organization that adopts the procedure; maps to pko:isAdoptedBy." .

effortless-ntwf:purpose a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Purpose" ;
    rdfs:comment "Desired outcome and scope of the procedure." .

effortless-ntwf:target a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:string ;
    rdfs:label "Target" ;
    rdfs:comment "Thing or population on which the procedure acts; maps to pko:hasProcedureTarget." .

effortless-ntwf:isTemplate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTemplate" ;
    rdfs:comment "TRUE when the procedure is a reusable template; maps to pko:isTemplate." .

effortless-ntwf:currentVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Procedures ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentVersionKey" ;
    rdfs:comment "Current version identifier, mirrored structurally by ProcedureVersions.IsCurrent." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: ProcessMiningRuns ===
effortless-ntwf:ProcessMiningRuns a owl:Class ;
    rdfs:label "ProcessMiningRuns" ;
    rdfs:comment "One conformance-checking run of a mined event log against a documented procedure version — a third kind of evidence, distinct from an elicitation session (someone's account) or a knowledge fragment (a claim): what the system of record actually did, discovered by process mining rather than told to us." .

effortless-ntwf:processMiningRunId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:string ;
    rdfs:label "ProcessMiningRunId" ;
    rdfs:comment "Stored logical identifier for one ProcessMiningRuns row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the ProcessMiningRuns row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version this mined event log is checked against." .

effortless-ntwf:eventLogSource a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:string ;
    rdfs:label "EventLogSource" ;
    rdfs:comment "System or log the event log was extracted from (e.g. an ERP audit log)." .

effortless-ntwf:minedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:dateTime ;
    rdfs:label "MinedAt" ;
    rdfs:comment "When this mining/conformance-checking run was performed." .

effortless-ntwf:discoveredVariantCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:integer ;
    rdfs:label "DiscoveredVariantCount" ;
    rdfs:comment "Distinct process variants discovered in the mined event log." .

effortless-ntwf:conformingVariantCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:integer ;
    rdfs:label "ConformingVariantCount" ;
    rdfs:comment "How many of the discovered variants exactly match a documented path through StepTransitions." .

effortless-ntwf:deviationDescription a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:string ;
    rdfs:label "DeviationDescription" ;
    rdfs:comment "Narrative of the most significant discovered deviation, if any." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged under." .
    # calculated: lookup

effortless-ntwf:conformanceRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:string ;
    rdfs:label "ConformanceRate" ;
    rdfs:comment "Share of discovered variants that conform to the documented procedure." .
    # calculated: calculated

effortless-ntwf:isConformant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConformant" ;
    rdfs:comment "TRUE when at least 80% of what actually happened matches what was documented." .
    # calculated: calculated

effortless-ntwf:hasMajorDriftFromDocumentation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasMajorDriftFromDocumentation" ;
    rdfs:comment "TRUE when less than half of what actually happened matches what was documented." .
    # calculated: calculated

effortless-ntwf:daysSinceMined a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceMined" ;
    rdfs:comment "Days elapsed since this event log was mined." .
    # calculated: calculated

effortless-ntwf:isStaleMiningEvidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStaleMiningEvidence" ;
    rdfs:comment "TRUE when this mining evidence is more than 180 days old." .
    # calculated: calculated

effortless-ntwf:procedureVersionIsLive a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:boolean ;
    rdfs:label "ProcedureVersionIsLive" ;
    rdfs:comment "Whether the procedure version this run was checked against is currently live." .
    # calculated: lookup

effortless-ntwf:isDriftOnLiveVersion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDriftOnLiveVersion" ;
    rdfs:comment "TRUE when a major, real, mined deviation exists against a procedure version people are actually executing right now." .
    # calculated: calculated

effortless-ntwf:driftedMiningRunKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcessMiningRuns ;
    rdfs:range xsd:string ;
    rdfs:label "DriftedMiningRunKey" ;
    rdfs:comment "Composite-key echo: this run's procedure version when the run drifted on a live version, else blank." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: Rationales ===
effortless-ntwf:Rationales a owl:Class ;
    rdfs:label "Rationales" ;
    rdfs:comment "First-class rationale statements explaining why procedural commitments and design decisions exist. Explicit ERB-PKO extension, represented as prov:Entity/dcat:Resource in projections." .

effortless-ntwf:rationaleId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Rationales ;
    rdfs:range xsd:string ;
    rdfs:label "RationaleId" ;
    rdfs:comment "Stored logical identifier for one Rationales row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Rationales row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Version justified by the rationale." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Optional step justified by the rationale." .

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Rationale title." .

effortless-ntwf:statement a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Statement" ;
    rdfs:comment "Reasoned explanation." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Draft, Reviewed, Approved, or Superseded." .

effortless-ntwf:authorityRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "AuthorityRole" ;
    rdfs:comment "Role authorized to approve the rationale." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: Recipients ===
effortless-ntwf:Recipients a owl:Class ;
    rdfs:label "Recipients" ;
    rdfs:comment "Recipients (added by witness loop 1)." .

effortless-ntwf:recipientId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Recipients ;
    rdfs:range xsd:string ;
    rdfs:label "RecipientId" ;
    rdfs:comment "Stored logical identifier for one Recipients row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Recipients row." .
    # calculated: calculated

effortless-ntwf:displayName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DisplayName" ;
    rdfs:comment "Employee display name as carried in the consent registry." .

effortless-ntwf:organization a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "Organization" ;
    rdfs:comment "Organization the recipient belongs to." .

effortless-ntwf:emailAddress a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "EmailAddress" ;
    rdfs:comment "Corporate email address; empty string when the recipient has no valid corporate email." .

effortless-ntwf:mobileNumber a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Recipients ;
    rdfs:range xsd:string ;
    rdfs:label "MobileNumber" ;
    rdfs:comment "Mobile number in E.164 form; empty string when no mobile number is on file." .

effortless-ntwf:smsConsentStatus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Recipients ;
    rdfs:range xsd:string ;
    rdfs:label "SmsConsentStatus" ;
    rdfs:comment "Consent state as observed in the consent registry: Granted, Revoked, or NeverGiven." .

effortless-ntwf:smsConsentAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Recipients ;
    rdfs:range xsd:dateTime ;
    rdfs:label "SmsConsentAt" ;
    rdfs:comment "Timestamp at which the current SMS consent state took effect." .

effortless-ntwf:consentBinding a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Recipients ;
    rdfs:range effortless-ntwf:OperationalBindings ;
    rdfs:label "ConsentBinding" ;
    rdfs:comment "Operational binding through which this consent state was observed." .

effortless-ntwf:hasSmsConsent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Recipients ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSmsConsent" ;
    rdfs:comment "TRUE only when the recipient's SMS consent state is Granted." .
    # calculated: calculated

effortless-ntwf:isEmailReachable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Recipients ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEmailReachable" ;
    rdfs:comment "TRUE when a corporate email address is on file for this recipient." .
    # calculated: calculated

effortless-ntwf:isSmsReachable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Recipients ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSmsReachable" ;
    rdfs:comment "TRUE when a mobile number is on file for this recipient." .
    # calculated: calculated

effortless-ntwf:isUnreachable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Recipients ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnreachable" ;
    rdfs:comment "TRUE when the recipient has neither an email address nor a mobile number -- the exc-unreachable trigger condition." .
    # calculated: calculated

effortless-ntwf:isCommunicationallyStranded a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Recipients ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCommunicationallyStranded" ;
    rdfs:comment "TRUE when every channel we hold for this person is either non-consenting or unreachable, so no lawful route exists at all." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension IRI; recipients are not a PKO 2.0.0 native class." .

# === Class: RequirementSatisfactions ===
effortless-ntwf:RequirementSatisfactions a owl:Class ;
    rdfs:label "RequirementSatisfactions" ;
    rdfs:comment "Execution-time evaluations of requirements. Maps to pko:RequirementSatisfaction, refersToRequirement, and hasRequirementSatisfactionLevel." .

effortless-ntwf:requirementSatisfactionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "RequirementSatisfactionId" ;
    rdfs:comment "Stored logical identifier for one RequirementSatisfactions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the RequirementSatisfactions row." .
    # calculated: calculated

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "Execution being evaluated." .

effortless-ntwf:requirement a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Requirements ;
    rdfs:label "Requirement" ;
    rdfs:comment "Requirement evaluated." .

effortless-ntwf:satisfactionLevel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "SatisfactionLevel" ;
    rdfs:comment "NotEvaluated, NotSatisfied, PartiallySatisfied, or Satisfied." .

effortless-ntwf:evidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "Evidence" ;
    rdfs:comment "Evidence supporting the evaluation." .

effortless-ntwf:evaluatedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "EvaluatedByAgent" ;
    rdfs:comment "Agent that evaluated satisfaction." .

effortless-ntwf:evaluatedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "EvaluatedAt" ;
    rdfs:comment "Evaluation timestamp." .

effortless-ntwf:requirementIsBlocking a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "RequirementIsBlocking" ;
    rdfs:comment "Whether the requirement being evaluated on this satisfaction row is a blocking control." .
    # calculated: lookup

effortless-ntwf:isFullySatisfied a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFullySatisfied" ;
    rdfs:comment "TRUE only when the requirement is recorded as fully Satisfied. PartiallySatisfied, Unsatisfied, Waived, and blank are all FALSE." .
    # calculated: calculated

effortless-ntwf:isBlockingAndUnmet a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBlockingAndUnmet" ;
    rdfs:comment "TRUE when a blocking requirement is recorded at anything less than fully Satisfied. This is the control-failure witness at the requirement grain." .
    # calculated: calculated

effortless-ntwf:blockingUnmetStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "BlockingUnmetStepKey" ;
    rdfs:comment "Echoes the parent StepExecution id only when this row is a blocking-unmet violation; empty string otherwise." .
    # calculated: calculated

effortless-ntwf:blockingSatisfactionStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "BlockingSatisfactionStepKey" ;
    rdfs:comment "Echoes the parent StepExecution id when this satisfaction row concerns a blocking requirement." .
    # calculated: calculated

effortless-ntwf:negativeOutcomeRequirementKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "NegativeOutcomeRequirementKey" ;
    rdfs:comment "Echoes the Requirement id only when this evaluation came out at less than fully Satisfied." .
    # calculated: calculated

effortless-ntwf:evaluatorAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "EvaluatorAgentKind" ;
    rdfs:comment "What kind of agent evaluated this requirement satisfaction." .
    # calculated: lookup

effortless-ntwf:nonHumanEvaluatedHumanControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "NonHumanEvaluatedHumanControl" ;
    rdfs:comment "TRUE when a blocking requirement was evaluated by a non-human agent." .
    # calculated: calculated

effortless-ntwf:requirementHasComputedWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "RequirementHasComputedWitness" ;
    rdfs:comment "Whether the requirement this row evaluates has a computed witness behind it." .
    # calculated: lookup

effortless-ntwf:isAssertedOnly a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAssertedOnly" ;
    rdfs:comment "TRUE when a blocking requirement is recorded as Satisfied purely on human assertion, with no computed predicate behind it." .
    # calculated: calculated

effortless-ntwf:assertedOnlyExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "AssertedOnlyExecutionKey" ;
    rdfs:comment "Echoes the grandparent procedure execution id for assertion-only satisfactions." .
    # calculated: calculated

effortless-ntwf:parentProcedureExecution a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ParentProcedureExecution" ;
    rdfs:comment "The procedure execution this satisfaction ultimately belongs to." .
    # calculated: lookup

effortless-ntwf:stepExecutionWhenScored a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "StepExecutionWhenScored" ;
    rdfs:comment "Echoes the step-execution id when a satisfaction level was actually recorded, blank otherwise." .
    # calculated: calculated

effortless-ntwf:isHumanEvaluated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHumanEvaluated" ;
    rdfs:comment "TRUE when a human evaluated this requirement satisfaction." .
    # calculated: calculated

effortless-ntwf:requirementIsApprovalType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "RequirementIsApprovalType" ;
    rdfs:comment "The requirement's type, e.g. Approval, Control, Privacy." .
    # calculated: lookup

effortless-ntwf:isInvalidApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInvalidApproval" ;
    rdfs:comment "TRUE when an approval-type requirement is not fully satisfied, or was not evaluated by a human." .
    # calculated: calculated

effortless-ntwf:procedureExecutionOfSatisfaction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "ProcedureExecutionOfSatisfaction" ;
    rdfs:comment "The run this satisfaction belongs to." .
    # calculated: lookup

effortless-ntwf:runWhenInvalidApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "RunWhenInvalidApproval" ;
    rdfs:comment "Echoes the run id when this is an invalid approval, blank otherwise." .
    # calculated: calculated

effortless-ntwf:requirementIsUnfalsified a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "RequirementIsUnfalsified" ;
    rdfs:comment "Whether the requirement behind this satisfaction record has never once returned a negative result." .
    # calculated: lookup

effortless-ntwf:isClearanceByUnfalsifiedControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsClearanceByUnfalsifiedControl" ;
    rdfs:comment "TRUE when this record cleared a step against a blocking control that has never produced a negative outcome." .
    # calculated: calculated

effortless-ntwf:unfalsifiedClearanceStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "UnfalsifiedClearanceStepKey" ;
    rdfs:comment "Echoes the step execution id when this clearance came from an unfalsified control." .
    # calculated: calculated

effortless-ntwf:specStepOfExecution a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "SpecStepOfExecution" ;
    rdfs:comment "The specification step behind the step execution this satisfaction was recorded against." .
    # calculated: lookup

effortless-ntwf:bindingKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "BindingKey" ;
    rdfs:comment "The StepRequirements binding this satisfaction record exercised." .
    # calculated: lookup

effortless-ntwf:scoredStepExecutorAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "ScoredStepExecutorAgent" ;
    rdfs:comment "The agent who executed the step this satisfaction record scores." .
    # calculated: lookup

effortless-ntwf:evaluatorIsStepExecutor a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "EvaluatorIsStepExecutor" ;
    rdfs:comment "TRUE when the agent who scored this control is the same agent who performed the step being scored." .
    # calculated: calculated

effortless-ntwf:runOwnerAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "RunOwnerAgent" ;
    rdfs:comment "The agent accountable for the whole procedure execution this satisfaction sits inside." .
    # calculated: lookup

effortless-ntwf:evaluatorOwnsTheRun a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "EvaluatorOwnsTheRun" ;
    rdfs:comment "TRUE when the agent scoring this control is the agent accountable for the execution it belongs to." .
    # calculated: calculated

effortless-ntwf:isInterestedPartyAssertion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInterestedPartyAssertion" ;
    rdfs:comment "TRUE when a blocking control's only evidence is an assertion made by someone with an interest in the outcome." .
    # calculated: calculated

effortless-ntwf:hasWrittenEvidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasWrittenEvidence" ;
    rdfs:comment "TRUE when this satisfaction record carries any evidence text at all." .
    # calculated: calculated

effortless-ntwf:isBareAssertion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBareAssertion" ;
    rdfs:comment "TRUE when a blocking control was cleared with no computed witness and no written justification." .
    # calculated: calculated

effortless-ntwf:interestedAssertionExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "InterestedAssertionExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this record is an interested-party assertion." .
    # calculated: calculated

effortless-ntwf:isComputedlyWitnessed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsComputedlyWitnessed" ;
    rdfs:comment "TRUE when this record scores a blocking control that has a computed witness behind it." .
    # calculated: calculated

effortless-ntwf:computedWitnessExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "ComputedWitnessExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this control was computationally witnessed." .
    # calculated: calculated

effortless-ntwf:stepExecutorAgent a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "StepExecutorAgent" ;
    rdfs:comment "The agent who executed the step this satisfaction record scores." .
    # calculated: lookup

effortless-ntwf:wasScoredAfterAttestation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasScoredAfterAttestation" ;
    rdfs:comment "TRUE when this control was scored after the run it belongs to had already been attested." .
    # calculated: calculated

effortless-ntwf:attestationInstantForRun a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AttestationInstantForRun" ;
    rdfs:comment "When the parent execution was attested, if it has been." .
    # calculated: lookup

effortless-ntwf:postAttestationScoreExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RequirementSatisfactions ;
    rdfs:range xsd:string ;
    rdfs:label "PostAttestationScoreExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this control was scored after signature." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: Requirements ===
effortless-ntwf:Requirements a owl:Class ;
    rdfs:label "Requirements" ;
    rdfs:comment "Normative requirements applied to procedures, steps, or transitions. Maps to pko:Requirement and pko:hasRequirement." .

effortless-ntwf:requirementId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "RequirementId" ;
    rdfs:comment "Stored logical identifier for one Requirements row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Requirements row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Requirement label." .

effortless-ntwf:requirementType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "RequirementType" ;
    rdfs:comment "Controlled requirement type; maps to pko:hasRequirementType." .

effortless-ntwf:statement a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Statement" ;
    rdfs:comment "Normative requirement statement." .

effortless-ntwf:rationale a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Rationale" ;
    rdfs:comment "Why the requirement exists." .

effortless-ntwf:isBlocking a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBlocking" ;
    rdfs:comment "TRUE when unsatisfied requirement blocks execution or approval." .

effortless-ntwf:satisfactionRecordCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "SatisfactionRecordCount" ;
    rdfs:comment "How many times this requirement has ever been evaluated against an execution." .
    # calculated: aggregation

effortless-ntwf:stepBindingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "StepBindingCount" ;
    rdfs:comment "How many steps the specification binds this requirement to." .
    # calculated: aggregation

effortless-ntwf:isBoundToAnyStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBoundToAnyStep" ;
    rdfs:comment "TRUE when at least one step carries this requirement." .
    # calculated: calculated

effortless-ntwf:hasEverBeenEvaluated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasEverBeenEvaluated" ;
    rdfs:comment "TRUE when this requirement has at least one satisfaction record in the model." .
    # calculated: calculated

effortless-ntwf:negativeOutcomeCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "NegativeOutcomeCount" ;
    rdfs:comment "How many times this requirement has ever produced a less-than-satisfied outcome." .
    # calculated: aggregation

effortless-ntwf:isInoperativeControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInoperativeControl" ;
    rdfs:comment "TRUE for a blocking requirement that is attached to a step in the specification but has never once been evaluated on any execution." .
    # calculated: calculated

effortless-ntwf:isDecorativeControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDecorativeControl" ;
    rdfs:comment "TRUE for a blocking requirement that is not attached to any step at all." .
    # calculated: calculated

effortless-ntwf:hasComputedWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasComputedWitness" ;
    rdfs:comment "Whether a computed predicate in this rulebook evaluates this requirement, as opposed to it being satisfied by human assertion only." .

effortless-ntwf:witnessFieldName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessFieldName" ;
    rdfs:comment "The fully-qualified Table.Field of the predicate that computes this requirement, when one exists." .

effortless-ntwf:hasEverProducedNegative a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasEverProducedNegative" ;
    rdfs:comment "TRUE when this requirement has at least once been scored as anything other than Satisfied." .
    # calculated: calculated

effortless-ntwf:isUnfalsifiedControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnfalsifiedControl" ;
    rdfs:comment "TRUE for a blocking control that HAS been evaluated at least once and has never returned a negative result." .
    # calculated: calculated

effortless-ntwf:claimsAWitnessField a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "ClaimsAWitnessField" ;
    rdfs:comment "TRUE when this requirement names a field it claims computes it." .
    # calculated: calculated

effortless-ntwf:namedWitnessFieldExists a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "NamedWitnessFieldExists" ;
    rdfs:comment "TRUE when the field named in WitnessFieldName actually exists in the field catalog AND is a derived (calculated/lookup/aggregation) field." .
    # calculated: lookup

effortless-ntwf:derivedHasComputedWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "DerivedHasComputedWitness" ;
    rdfs:comment "Whether this requirement genuinely has a computed witness, derived from the field catalog rather than asserted." .
    # calculated: calculated

effortless-ntwf:witnessClaimIsUnverified a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "WitnessClaimIsUnverified" ;
    rdfs:comment "TRUE when the hand-typed HasComputedWitness flag disagrees with what the field catalog says." .
    # calculated: calculated

effortless-ntwf:isUnwitnessedBlockingControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwitnessedBlockingControl" ;
    rdfs:comment "TRUE for a blocking control with no verified computed witness behind it." .
    # calculated: calculated

effortless-ntwf:witnessFireCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessFireCount" ;
    rdfs:comment "How many times this requirement's evaluation has returned a non-Satisfied result." .
    # calculated: calculated

effortless-ntwf:witnessHasNeverFired a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "WitnessHasNeverFired" ;
    rdfs:comment "TRUE for a requirement that has a computed witness which has never once returned a negative result." .
    # calculated: calculated

effortless-ntwf:evaluationSampleSize a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "EvaluationSampleSize" ;
    rdfs:comment "How many times this requirement has been evaluated at all." .
    # calculated: calculated

effortless-ntwf:hasMeaningfulSample a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasMeaningfulSample" ;
    rdfs:comment "TRUE when this requirement has been evaluated often enough that a clean record is informative." .
    # calculated: calculated

effortless-ntwf:minimumSampleForAssurance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:integer ;
    rdfs:label "MinimumSampleForAssurance" ;
    rdfs:comment "The number of clean evaluations this control must accumulate before its silence counts as evidence." .

effortless-ntwf:isUntestedWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntestedWitness" ;
    rdfs:comment "TRUE for a witness that has never fired and has not been exercised enough for that silence to mean anything." .
    # calculated: calculated

effortless-ntwf:isEvidencedHoldingControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEvidencedHoldingControl" ;
    rdfs:comment "TRUE for a witness that has never fired across a sample large enough for that to constitute evidence." .
    # calculated: calculated

effortless-ntwf:controlAssuranceState a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "ControlAssuranceState" ;
    rdfs:comment "One of Decorative, Inoperative, Asserted, Demonstrated, Holding, or Untested — the single control-health verdict for this requirement." .
    # calculated: calculated

effortless-ntwf:unexercisedBindingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "UnexercisedBindingCount" ;
    rdfs:comment "How many of this control's step bindings have never been evaluated." .
    # calculated: aggregation

effortless-ntwf:witnessIsPartiallyScoped a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "WitnessIsPartiallyScoped" ;
    rdfs:comment "TRUE when a control has a computed witness but at least one of its step bindings has never been exercised by it." .
    # calculated: calculated

effortless-ntwf:accountableRole a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "AccountableRole" ;
    rdfs:comment "The role answerable for this control operating as designed." .

effortless-ntwf:accountableAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "AccountableAgent" ;
    rdfs:comment "The person currently holding the accountable role for this control." .
    # calculated: lookup

effortless-ntwf:hasNamedOwner a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNamedOwner" ;
    rdfs:comment "TRUE when a role has been named as accountable for this control." .
    # calculated: calculated

effortless-ntwf:isOrphanedBlockingControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOrphanedBlockingControl" ;
    rdfs:comment "TRUE for a blocking control with nobody named as accountable for it." .
    # calculated: calculated

effortless-ntwf:isUnwatchedAndUnowned a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwatchedAndUnowned" ;
    rdfs:comment "TRUE for a blocking control that nothing computes and nobody owns." .
    # calculated: calculated

effortless-ntwf:attestationExposureNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "AttestationExposureNote" ;
    rdfs:comment "States, per control, what kind of exposure attesting to it creates." .
    # calculated: calculated

effortless-ntwf:unwatchedUnownedFlag a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:string ;
    rdfs:label "UnwatchedUnownedFlag" ;
    rdfs:comment "Constant marker echoed when this control is both unwatched and unowned." .
    # calculated: calculated

effortless-ntwf:controlledTerm a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range effortless-ntwf:VocabularyTerms ;
    rdfs:label "ControlledTerm" ;
    rdfs:comment "Controlled vocabulary term this requirement's concept maps to, if any." .

effortless-ntwf:usesControlledVocabulary a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Requirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "UsesControlledVocabulary" ;
    rdfs:comment "TRUE when this requirement points at a controlled term instead of only free-texting the concept." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: Resources ===
effortless-ntwf:Resources a owl:Class ;
    rdfs:label "Resources" ;
    rdfs:comment "Documents, datasets, APIs, templates, images, manuals, and operational records referenced by procedures. Maps to dcat:Resource." .

effortless-ntwf:resourceId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Resources ;
    rdfs:range xsd:string ;
    rdfs:label "ResourceId" ;
    rdfs:comment "Stored logical identifier for one Resources row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Resources row." .
    # calculated: calculated

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Resource title; maps to dcterms:title." .

effortless-ntwf:resourceKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Resources ;
    rdfs:range xsd:string ;
    rdfs:label "ResourceKind" ;
    rdfs:comment "Document, Dataset, API, Template, OperationalRecord, Image, Video, or another declared type." .

effortless-ntwf:externalUri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Resources ;
    rdfs:range xsd:string ;
    rdfs:label "ExternalUri" ;
    rdfs:comment "Resolvable or organization-internal resource identifier." .

effortless-ntwf:createdAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Resources ;
    rdfs:range xsd:dateTime ;
    rdfs:label "CreatedAt" ;
    rdfs:comment "Creation time; maps to dcterms:created." .

effortless-ntwf:modifiedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ModifiedAt" ;
    rdfs:comment "Modification time; maps to dcterms:modified." .

effortless-ntwf:description a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Description" ;
    rdfs:comment "Resource description; maps to dcterms:description." .

effortless-ntwf:approvalStatus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Resources ;
    rdfs:range xsd:string ;
    rdfs:label "ApprovalStatus" ;
    rdfs:comment "Approved, Draft, Deprecated, or Unvetted." .

effortless-ntwf:isApprovedSource a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Resources ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApprovedSource" ;
    rdfs:comment "TRUE when this resource is an approved source." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact semantic class IRI." .

# === Class: ReviewEvents ===
effortless-ntwf:ReviewEvents a owl:Class ;
    rdfs:label "ReviewEvents" ;
    rdfs:comment "Periodic governance reviews that test competency coverage, staleness, and semantic integrity. Explicit ERB-PKO extension represented as prov:Activity." .

effortless-ntwf:reviewEventId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ReviewEvents ;
    rdfs:range xsd:string ;
    rdfs:label "ReviewEventId" ;
    rdfs:comment "Stored logical identifier for one ReviewEvents row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the ReviewEvents row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Reviewed procedure version." .

effortless-ntwf:reviewKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ReviewEvents ;
    rdfs:range xsd:string ;
    rdfs:label "ReviewKind" ;
    rdfs:comment "Review type." .

effortless-ntwf:reviewedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ReviewedAt" ;
    rdfs:comment "Review timestamp." .

effortless-ntwf:reviewedByAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ReviewedByAgent" ;
    rdfs:comment "Reviewing agent." .

effortless-ntwf:outcome a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Outcome" ;
    rdfs:comment "Passed, PassedWithChange, Failed, or Deferred." .

effortless-ntwf:relatedChangeRequest a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ReviewEvents ;
    rdfs:range effortless-ntwf:ChangeRequests ;
    rdfs:label "RelatedChangeRequest" ;
    rdfs:comment "Change request produced or considered." .

effortless-ntwf:nextReviewDue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ReviewEvents ;
    rdfs:range xsd:dateTime ;
    rdfs:label "NextReviewDue" ;
    rdfs:comment "Next required review." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:isOverdue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ReviewEvents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverdue" ;
    rdfs:comment "TRUE when review is overdue." .
    # calculated: calculated

effortless-ntwf:overdueVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ReviewEvents ;
    rdfs:range xsd:string ;
    rdfs:label "OverdueVersionKey" ;
    rdfs:comment "Echoes the ProcedureVersion id only when this review is past its next-due date." .
    # calculated: calculated

effortless-ntwf:promisedCadenceDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ReviewEvents ;
    rdfs:range xsd:integer ;
    rdfs:label "PromisedCadenceDays" ;
    rdfs:comment "The review cadence promised for this procedure version, resolved via ProcedureVersions because INDEX/MATCH can only match a target table primary key." .
    # calculated: lookup

effortless-ntwf:daysSinceReviewed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ReviewEvents ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceReviewed" ;
    rdfs:comment "Elapsed days since this review actually happened." .
    # calculated: calculated

effortless-ntwf:exceedsPromisedCadence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ReviewEvents ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExceedsPromisedCadence" ;
    rdfs:comment "TRUE when more days have elapsed since this review than the stewardship assignment promised as a cadence." .
    # calculated: calculated

effortless-ntwf:cadenceDriftDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ReviewEvents ;
    rdfs:range xsd:integer ;
    rdfs:label "CadenceDriftDays" ;
    rdfs:comment "Signed drift: positive means we are past the promised cadence by this many days; negative means we are still inside it." .
    # calculated: calculated

effortless-ntwf:promiseAndBehaviorDisagree a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ReviewEvents ;
    rdfs:range xsd:boolean ;
    rdfs:label "PromiseAndBehaviorDisagree" ;
    rdfs:comment "TRUE when the promised cadence has been blown but the hand-entered NextReviewDue still says we are fine." .
    # calculated: calculated

effortless-ntwf:cadenceBreachVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ReviewEvents ;
    rdfs:range xsd:string ;
    rdfs:label "CadenceBreachVersionKey" ;
    rdfs:comment "Composite-key echo: this review event's procedure version when the promised cadence has been exceeded, blank otherwise." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Class IRI used in projection." .

# === Class: RoleAssignments ===
effortless-ntwf:RoleAssignments a owl:Class ;
    rdfs:label "RoleAssignments" ;
    rdfs:comment "Time-bounded records of agents holding roles. Maps to pro:RoleInTime and preserves assignment history instead of overwriting it." .

effortless-ntwf:roleAssignmentId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "RoleAssignmentId" ;
    rdfs:comment "Stored logical identifier for one RoleAssignments row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the RoleAssignments row." .
    # calculated: calculated

effortless-ntwf:role a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "Role" ;
    rdfs:comment "Role held during the assignment." .

effortless-ntwf:agent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "Agent" ;
    rdfs:comment "Agent holding the role." .

effortless-ntwf:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ValidFrom" ;
    rdfs:comment "Start of the assignment's valid-time interval." .

effortless-ntwf:validTo a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ValidTo" ;
    rdfs:comment "End of the assignment's valid-time interval; null means open-ended." .

effortless-ntwf:reason a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "Reason" ;
    rdfs:comment "Rationale for the assignment or reassignment." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Active, Superseded, Planned, or Revoked." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this assignment's currency is judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this assignment's currency is judged against." .
    # calculated: lookup

effortless-ntwf:isCurrent a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrent" ;
    rdfs:comment "TRUE when the assignment is valid now." .
    # calculated: calculated

effortless-ntwf:currentAgentKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentAgentKey" ;
    rdfs:comment "Echoes the Agent id only while this assignment is current; empty otherwise. Lets a parent count CURRENT assignments with a single-criterion COUNTIFS, which is the only shape this transpiler translates correctly." .
    # calculated: calculated

effortless-ntwf:isCurrentlyValid a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrentlyValid" ;
    rdfs:comment "TRUE when this role assignment is active and has not lapsed." .
    # calculated: calculated

effortless-ntwf:agentRoleKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "AgentRoleKey" ;
    rdfs:comment "Composite agent+role key, emitted only for currently-valid assignments." .
    # calculated: calculated

effortless-ntwf:hasDeparted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasDeparted" ;
    rdfs:comment "TRUE when this role assignment has ended — the agent no longer holds the role." .
    # calculated: calculated

effortless-ntwf:coversNow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "CoversNow" ;
    rdfs:comment "TRUE when this assignment is both status-Active and inside its valid-time window right now." .
    # calculated: calculated

effortless-ntwf:roleWhenCovering a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "RoleWhenCovering" ;
    rdfs:comment "Echoes the role id when this assignment is currently in force, blank otherwise." .
    # calculated: calculated

effortless-ntwf:agentKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AgentKind" ;
    rdfs:comment "Whether the agent holding this assignment is Human, AIAgent, or AutomatedPipeline." .
    # calculated: lookup

effortless-ntwf:isNonHumanAssignment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonHumanAssignment" ;
    rdfs:comment "TRUE when this assignment places a non-human agent into the role." .
    # calculated: calculated

effortless-ntwf:supersedesAssignment a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range effortless-ntwf:RoleAssignments ;
    rdfs:label "SupersedesAssignment" ;
    rdfs:comment "The assignment this one replaced, if any." .

effortless-ntwf:predecessorAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "PredecessorAgentKind" ;
    rdfs:comment "Agent kind of the assignment this one superseded." .
    # calculated: lookup

effortless-ntwf:isHumanToNonHumanHandover a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHumanToNonHumanHandover" ;
    rdfs:comment "TRUE when this assignment handed a role from a human to a non-human agent." .
    # calculated: calculated

effortless-ntwf:approvingAuthorityRole a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "ApprovingAuthorityRole" ;
    rdfs:comment "Role that approved this assignment." .

effortless-ntwf:authorizingChangeRequest a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range effortless-ntwf:ChangeRequests ;
    rdfs:label "AuthorizingChangeRequest" ;
    rdfs:comment "Change request under which this assignment was approved." .

effortless-ntwf:isUnauthorizedNonHumanAssignment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnauthorizedNonHumanAssignment" ;
    rdfs:comment "TRUE when a non-human agent holds this role with no approving authority recorded at all. An authority named without a change request is still an authority; the separate WasAuthorizedByChangeRequest column carries that weaker distinction." .
    # calculated: calculated

effortless-ntwf:wasAuthorizedByChangeRequest a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasAuthorizedByChangeRequest" ;
    rdfs:comment "TRUE when this assignment's authorization is traceable to a change request, not merely to a named role. The stronger form of authorization, kept separate so the weaker one is not silently reported as unauthorized." .
    # calculated: calculated

effortless-ntwf:decisionCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DecisionCount" ;
    rdfs:comment "Decisions made under this assignment." .
    # calculated: aggregation

effortless-ntwf:overriddenDecisionCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OverriddenDecisionCount" ;
    rdfs:comment "Decisions made under this assignment that a human corrected or reversed." .
    # calculated: aggregation

effortless-ntwf:overrideRatePercent a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OverrideRatePercent" ;
    rdfs:comment "Percentage of decisions under this assignment that a human overrode." .
    # calculated: calculated

effortless-ntwf:predecessorOverrideRatePercent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "PredecessorOverrideRatePercent" ;
    rdfs:comment "Override rate of the assignment this one superseded." .
    # calculated: lookup

effortless-ntwf:qualityRegressedVsPredecessor a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "QualityRegressedVsPredecessor" ;
    rdfs:comment "TRUE when this assignment is overridden by humans more often than the assignment it replaced." .
    # calculated: calculated

effortless-ntwf:departedRoleKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "DepartedRoleKey" ;
    rdfs:comment "Composite-key echo: the role this assignment covered when the assignment has ended, blank otherwise." .
    # calculated: calculated

effortless-ntwf:minimumDecisionsForComparison a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:integer ;
    rdfs:label "MinimumDecisionsForComparison" ;
    rdfs:comment "The number of decisions below which an override-rate comparison is not considered evidentially meaningful for this role." .

effortless-ntwf:predecessorDecisionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "PredecessorDecisionCount" ;
    rdfs:comment "How many decisions the superseded assignment produced." .
    # calculated: lookup

effortless-ntwf:hasSufficientSample a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSufficientSample" ;
    rdfs:comment "TRUE when this assignment has produced enough decisions for its override rate to mean anything." .
    # calculated: calculated

effortless-ntwf:predecessorHasSufficientSample a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "PredecessorHasSufficientSample" ;
    rdfs:comment "TRUE when the predecessor assignment produced enough decisions to compare against." .
    # calculated: calculated

effortless-ntwf:comparisonIsEvidentiallySound a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "ComparisonIsEvidentiallySound" ;
    rdfs:comment "TRUE when both sides of the override-rate comparison rest on adequate samples." .
    # calculated: calculated

effortless-ntwf:singleOverrideSwingPercent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "SingleOverrideSwingPercent" ;
    rdfs:comment "How many percentage points one additional override would move this assignment's rate. The fragility of the number." .
    # calculated: calculated

effortless-ntwf:qualityVerdictIsUnsupported a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "QualityVerdictIsUnsupported" ;
    rdfs:comment "TRUE when a quality verdict is being reported for this assignment on a sample too small to support it." .
    # calculated: calculated

effortless-ntwf:isUnmeasuredAutomationHandover a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnmeasuredAutomationHandover" ;
    rdfs:comment "TRUE when a human-to-machine handover is operating without a statistically meaningful quality comparison behind it." .
    # calculated: calculated

effortless-ntwf:errorCorrectionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "ErrorCorrectionCount" ;
    rdfs:comment "How many of this assignment's decisions were overridden because they were wrong." .
    # calculated: aggregation

effortless-ntwf:errorRatePercent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "ErrorRatePercent" ;
    rdfs:comment "Percentage of this assignment's decisions overridden as errors -- the override rate with reserved-judgment overrides removed." .
    # calculated: calculated

effortless-ntwf:authorizationDecidedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AuthorizationDecidedAt" ;
    rdfs:comment "When the approving authority actually granted this assignment. Empty when no authorization was ever recorded." .

effortless-ntwf:authorizationReviewedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AuthorizationReviewedAt" ;
    rdfs:comment "When the authorization for this assignment was last re-examined." .

effortless-ntwf:authorizationReviewCadenceDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:integer ;
    rdfs:label "AuthorizationReviewCadenceDays" ;
    rdfs:comment "How often this assignment's authorization is promised to be re-examined." .

effortless-ntwf:hasDatedAuthorization a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasDatedAuthorization" ;
    rdfs:comment "TRUE when this assignment carries both a named approving authority and the date they granted it." .
    # calculated: calculated

effortless-ntwf:daysSinceAuthorizationReview a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceAuthorizationReview" ;
    rdfs:comment "How long since this assignment's authorization was last re-examined." .
    # calculated: calculated

effortless-ntwf:authorizationIsOverdueForReview a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "AuthorizationIsOverdueForReview" ;
    rdfs:comment "TRUE when the promised re-examination interval has elapsed without a review." .
    # calculated: calculated

effortless-ntwf:isStandingUnreviewedAutomation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStandingUnreviewedAutomation" ;
    rdfs:comment "TRUE when a currently-active non-human assignment has been running past its authorization review date." .
    # calculated: calculated

effortless-ntwf:isUnconditionedAutomationHandover a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnconditionedAutomationHandover" ;
    rdfs:comment "TRUE when a human-to-machine handover was authorized with no promised review cadence at all -- granted once, permanently." .
    # calculated: calculated

effortless-ntwf:maxTolerableErrorRatePercent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:integer ;
    rdfs:label "MaxTolerableErrorRatePercent" ;
    rdfs:comment "The error rate at or above which this assignment must stop making decisions unaided." .

effortless-ntwf:exceedsTolerableErrorRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExceedsTolerableErrorRate" ;
    rdfs:comment "TRUE when this assignment's error rate has reached the threshold set when it was authorized." .
    # calculated: calculated

effortless-ntwf:boundaryViolationCountForAssignment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "BoundaryViolationCountForAssignment" ;
    rdfs:comment "How many decisions under this assignment violated an authority boundary." .
    # calculated: aggregation

effortless-ntwf:hasAnyBoundaryViolation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasAnyBoundaryViolation" ;
    rdfs:comment "TRUE when any decision under this assignment crossed a boundary it was forbidden to cross." .
    # calculated: calculated

effortless-ntwf:hasUngroundedGoverningBoundary a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUngroundedGoverningBoundary" ;
    rdfs:comment "TRUE when at least one boundary constraining this assignment's role rests on lapsed knowledge." .
    # calculated: lookup

effortless-ntwf:suspensionConditionMet a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "SuspensionConditionMet" ;
    rdfs:comment "TRUE when any pre-declared condition requiring this assignment to stop deciding unaided has been met." .
    # calculated: calculated

effortless-ntwf:isOperatingUnderMetSuspensionCondition a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOperatingUnderMetSuspensionCondition" ;
    rdfs:comment "TRUE when a suspension condition has been met and the assignment is nonetheless still active and still deciding." .
    # calculated: calculated

effortless-ntwf:hasDeclaredSuspensionCondition a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasDeclaredSuspensionCondition" ;
    rdfs:comment "TRUE when this assignment has any pre-declared condition under which it must stop at all." .
    # calculated: calculated

effortless-ntwf:hasApprovingAuthority a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasApprovingAuthority" ;
    rdfs:comment "TRUE when a role is recorded as having approved this assignment." .
    # calculated: calculated

effortless-ntwf:hasAuthorizingChangeRequest a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasAuthorizingChangeRequest" ;
    rdfs:comment "TRUE when a change request is recorded as the governance vehicle for this assignment." .
    # calculated: calculated

effortless-ntwf:isEnforcementRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEnforcementRole" ;
    rdfs:comment "Whether this role's function is to enforce controls on other agents' actions." .

effortless-ntwf:isUnauthorizedEnforcementAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnauthorizedEnforcementAgent" ;
    rdfs:comment "TRUE when a non-human agent enforces controls on others while holding no recorded authorization of its own." .
    # calculated: calculated

effortless-ntwf:governanceEvidenceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:integer ;
    rdfs:label "GovernanceEvidenceCount" ;
    rdfs:comment "How many independent governance artifacts back this assignment: an approving role, an authorizing change request." .
    # calculated: calculated

effortless-ntwf:unauthorizedEnforcementRoleKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "UnauthorizedEnforcementRoleKey" ;
    rdfs:comment "Echoes the role only for non-human assignments nobody authorized; empty otherwise." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact class IRI for the assignment event." .

# === Class: RoleQuestions ===
effortless-ntwf:RoleQuestions a owl:Class ;
    rdfs:label "RoleQuestions" ;
    rdfs:comment "One row per question a named role wants answered. Every invented predicate in this rulebook traces back to one of these." .

effortless-ntwf:roleQuestionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleQuestions ;
    rdfs:range xsd:string ;
    rdfs:label "RoleQuestionId" ;
    rdfs:comment "Stored logical identifier for one RoleQuestions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the RoleQuestions row." .
    # calculated: calculated

effortless-ntwf:askingRole a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:RoleQuestions ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "AskingRole" ;
    rdfs:comment "The role that wants this question answered." .

effortless-ntwf:witnessLoop a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:RoleQuestions ;
    rdfs:range effortless-ntwf:WitnessLoops ;
    rdfs:label "WitnessLoop" ;
    rdfs:comment "The expansion loop in which this question was posed." .

effortless-ntwf:questionText a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "QuestionText" ;
    rdfs:comment "The question in the role's own words." .

effortless-ntwf:whyItMatters a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleQuestions ;
    rdfs:range xsd:string ;
    rdfs:label "WhyItMatters" ;
    rdfs:comment "What goes wrong in the real world when this question cannot be answered." .

effortless-ntwf:answerableBefore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleQuestions ;
    rdfs:range xsd:boolean ;
    rdfs:label "AnswerableBefore" ;
    rdfs:comment "TRUE if the model could already answer this before its loop ran. FALSE means the loop had to invent predicates for it." .

effortless-ntwf:predicateCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleQuestions ;
    rdfs:range xsd:string ;
    rdfs:label "PredicateCount" ;
    rdfs:comment "How many fields were invented to answer this question." .
    # calculated: aggregation

effortless-ntwf:isAnswered a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleQuestions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAnswered" ;
    rdfs:comment "TRUE when at least one predicate exists to answer this question." .
    # calculated: calculated

effortless-ntwf:witnessedAnswer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleQuestions ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessedAnswer" ;
    rdfs:comment "The current reading of this question's predicates, extracted from the substrate after the loop ran: which witness columns fire, on how many rows out of how many. Written by tools/extract_computed_answers.py from values Postgres computed — never recomputed in Python. This is what lets a later loop plan against materialized answers instead of imagined ones." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: RoleSchemaViews ===
effortless-ntwf:RoleSchemaViews a owl:Class ;
    rdfs:label "RoleSchemaViews" ;
    rdfs:comment "The emitted views: one per principal x table. ColumnList is DERIVED from FieldGrants, so toggling a single grant changes the emitted DDL with no second edit anywhere. This is what makes an admin's save reshape the database without touching UI code." .

effortless-ntwf:roleSchemaViewId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemaViews ;
    rdfs:range xsd:string ;
    rdfs:label "RoleSchemaViewId" ;
    rdfs:comment "Stored logical identifier, e.g. 'rsv-controller-procedures'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:roleSchema a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:RoleSchemaViews ;
    rdfs:range effortless-ntwf:RoleSchemas ;
    rdfs:label "RoleSchema" ;
    rdfs:comment "Schema this view is emitted into." .

effortless-ntwf:principal a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:AccessPrincipals ;
    rdfs:label "Principal" ;
    rdfs:comment "Principal that will read this view." .

effortless-ntwf:targetTable a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RulebookTables ;
    rdfs:label "TargetTable" ;
    rdfs:comment "Rulebook table this view exposes." .

effortless-ntwf:viewName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemaViews ;
    rdfs:range xsd:string ;
    rdfs:label "ViewName" ;
    rdfs:comment "Unqualified view name inside the principal's schema, e.g. 'procedures'." .

effortless-ntwf:schemaName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SchemaName" ;
    rdfs:comment "Schema name, from the owning RoleSchemas row." .
    # calculated: lookup

effortless-ntwf:sourceView a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemaViews ;
    rdfs:range xsd:string ;
    rdfs:label "SourceView" ;
    rdfs:comment "Underlying computed view this narrows, e.g. 'vw_procedures'." .
    # calculated: lookup

effortless-ntwf:grantKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemaViews ;
    rdfs:range xsd:string ;
    rdfs:label "GrantKey" ;
    rdfs:comment "Composite key matching FieldGrants.GrantKeyWhenReadable, used to roll up this view's readable column count." .
    # calculated: calculated

effortless-ntwf:columnCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemaViews ;
    rdfs:range xsd:string ;
    rdfs:label "ColumnCount" ;
    rdfs:comment "Number of columns exposed, derived live from the principal's readable field grants. Change one grant and this view's shape changes." .
    # calculated: aggregation

effortless-ntwf:tableFieldCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemaViews ;
    rdfs:range xsd:string ;
    rdfs:label "TableFieldCount" ;
    rdfs:comment "Total catalogued fields on the target table." .
    # calculated: lookup

effortless-ntwf:isFullWidth a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemaViews ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFullWidth" ;
    rdfs:comment "True when every field on the table is exposed, so the horizontal cut removes nothing." .
    # calculated: calculated

effortless-ntwf:isDegenerateView a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemaViews ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDegenerateView" ;
    rdfs:comment "True when the view exposes zero columns -- an emitted view that cannot be selected from. A generator that emits this has produced invalid DDL." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: RoleSchemas ===
effortless-ntwf:RoleSchemas a owl:Class ;
    rdfs:label "RoleSchemas" ;
    rdfs:comment "One Postgres schema per principal -- the principal's entire visible world. The schema is the only entry on that principal's search_path, so a table absent from it cannot be named at all." .

effortless-ntwf:roleSchemaId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemas ;
    rdfs:range xsd:string ;
    rdfs:label "RoleSchemaId" ;
    rdfs:comment "Stored logical identifier, e.g. 'schema-controller'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:principal a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:AccessPrincipals ;
    rdfs:label "Principal" ;
    rdfs:comment "Principal that owns this schema." .

effortless-ntwf:schemaName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SchemaName" ;
    rdfs:comment "Postgres schema name, e.g. 'pko_controller'." .

effortless-ntwf:searchPath a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemas ;
    rdfs:range xsd:string ;
    rdfs:label "SearchPath" ;
    rdfs:comment "search_path set for this principal's sessions. The principal's own schema only -- public is deliberately excluded so base tables cannot be named." .
    # calculated: calculated

effortless-ntwf:isSealed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemas ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSealed" ;
    rdfs:comment "True when the principal may not create objects in its own schema." .

effortless-ntwf:viewCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemas ;
    rdfs:range xsd:string ;
    rdfs:label "ViewCount" ;
    rdfs:comment "Number of views exposed in this schema." .
    # calculated: aggregation

effortless-ntwf:isEmptySchema a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoleSchemas ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEmptySchema" ;
    rdfs:comment "True when the schema exposes no views, so the principal can read nothing at all." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: Roles ===
effortless-ntwf:Roles a owl:Class ;
    rdfs:label "Roles" ;
    rdfs:comment "Stable organizational functions separated from the agents that currently fill them. Maps to pro:Role." .

effortless-ntwf:roleId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:string ;
    rdfs:label "RoleId" ;
    rdfs:comment "Stored logical identifier for one Roles row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Roles row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Human-readable role label." .

effortless-ntwf:organization a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "Organization" ;
    rdfs:comment "Organization that owns the role." .

effortless-ntwf:currentAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "CurrentAgent" ;
    rdfs:comment "Current agent filling the role; history is retained in RoleAssignments." .

effortless-ntwf:currentAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentAgentKind" ;
    rdfs:comment "Agent category of the current role filler." .
    # calculated: lookup

effortless-ntwf:responsibility a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:string ;
    rdfs:label "Responsibility" ;
    rdfs:comment "Accountability and responsibility assigned to the role." .

effortless-ntwf:activeAssignmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:string ;
    rdfs:label "ActiveAssignmentCount" ;
    rdfs:comment "Total number of assignment rows ever recorded against this role." .
    # calculated: aggregation

effortless-ntwf:currentlyCoveredAssignmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentlyCoveredAssignmentCount" ;
    rdfs:comment "Number of assignment rows for this role that are in force right now." .
    # calculated: aggregation

effortless-ntwf:hasNoCurrentHolder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoCurrentHolder" ;
    rdfs:comment "TRUE when no assignment currently covers this role — the role is uncovered." .
    # calculated: calculated

effortless-ntwf:countOfAwaitedDecisions a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfAwaitedDecisions" ;
    rdfs:comment "How many change requests name this role as the deciding authority." .
    # calculated: aggregation

effortless-ntwf:currentAssignment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentAssignment" ;
    rdfs:comment "The RoleAssignments id of the assignment by which this role is currently held. Deliberately a raw identifier, not a relationship: RoleAssignments already points at Roles, so an FK back would make the two mutually dependent and this rulebook must stay acyclic." .

effortless-ntwf:currentAssignmentValidFrom a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:dateTime ;
    rdfs:label "CurrentAssignmentValidFrom" ;
    rdfs:comment "Start of the currently-in-force assignment for this role." .
    # calculated: lookup

effortless-ntwf:isNonHumanHeld a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonHumanHeld" ;
    rdfs:comment "TRUE when the role's current agent is an AI agent or automated pipeline." .
    # calculated: calculated

effortless-ntwf:isUngovernedNonHumanRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngovernedNonHumanRole" ;
    rdfs:comment "TRUE when a role is pointed at a non-human agent but has no assignment row granting it." .
    # calculated: calculated

effortless-ntwf:departedAssignmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:string ;
    rdfs:label "DepartedAssignmentCount" ;
    rdfs:comment "How many assignments to this role have ended." .
    # calculated: aggregation

effortless-ntwf:hasLostAHolder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasLostAHolder" ;
    rdfs:comment "Whether anyone has ever departed this role." .
    # calculated: calculated

effortless-ntwf:isVacatedRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsVacatedRole" ;
    rdfs:comment "A role somebody departed and that nobody currently covers." .
    # calculated: calculated

effortless-ntwf:ungroundedBoundaryCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:string ;
    rdfs:label "UngroundedBoundaryCount" ;
    rdfs:comment "How many boundaries constrain this role on lapsed authority." .
    # calculated: aggregation

effortless-ntwf:isGovernedByLapsedAuthority a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGovernedByLapsedAuthority" ;
    rdfs:comment "TRUE when at least one constraint on this role rests on knowledge that is no longer valid." .
    # calculated: calculated

effortless-ntwf:unescalatedRefusalCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:string ;
    rdfs:label "UnescalatedRefusalCount" ;
    rdfs:comment "How many refusals this role should have been told about and was not." .
    # calculated: aggregation

effortless-ntwf:unauthorizedEnforcementAssignmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:string ;
    rdfs:label "UnauthorizedEnforcementAssignmentCount" ;
    rdfs:comment "How many current assignments of this role are unauthorized enforcement assignments." .
    # calculated: aggregation

effortless-ntwf:isUngovernedEnforcementRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Roles ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngovernedEnforcementRole" ;
    rdfs:comment "TRUE when a role that enforces controls on others is held with no recorded authorization." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact semantic type IRI for the role." .

# === Class: RulebookFields ===
effortless-ntwf:RulebookFields a owl:Class ;
    rdfs:label "RulebookFields" ;
    rdfs:comment "A complete census of every field in this rulebook. Reconciled from the real schemas by tools/reconcile_field_catalog.py — never hand-maintained. Fields invented by a witness loop carry an InventedForQuestion FK." .

effortless-ntwf:rulebookFieldId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookFields ;
    rdfs:range xsd:string ;
    rdfs:label "RulebookFieldId" ;
    rdfs:comment "Stored logical identifier for one RulebookFields row. Formed as <TargetTable>.<FieldName>." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the RulebookFields row." .
    # calculated: calculated

effortless-ntwf:targetTable a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "TargetTable" ;
    rdfs:comment "The table this field lives on." .

effortless-ntwf:fieldName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "FieldName" ;
    rdfs:comment "The field's name within its table." .

effortless-ntwf:fieldType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookFields ;
    rdfs:range xsd:string ;
    rdfs:label "FieldType" ;
    rdfs:comment "raw, calculated, lookup, relationship, or aggregation." .

effortless-ntwf:datatype a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookFields ;
    rdfs:range xsd:string ;
    rdfs:label "Datatype" ;
    rdfs:comment "The field's declared datatype." .

effortless-ntwf:formula a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookFields ;
    rdfs:range xsd:string ;
    rdfs:label "Formula" ;
    rdfs:comment "The field's formula when it is derived. Null for raw and relationship fields." .

effortless-ntwf:inventedForQuestion a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:RulebookFields ;
    rdfs:range effortless-ntwf:RoleQuestions ;
    rdfs:label "InventedForQuestion" ;
    rdfs:comment "The role question that motivated this field's existence. Null for fields that predate the witness-loop exercise." .

effortless-ntwf:isDerived a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookFields ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDerived" ;
    rdfs:comment "TRUE when this field is computed rather than stored." .
    # calculated: calculated

effortless-ntwf:isWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookFields ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWitness" ;
    rdfs:comment "TRUE when this field exists because a role asked a question. These are the fields the witness loops added." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: RulebookReleases ===
effortless-ntwf:RulebookReleases a owl:Class ;
    rdfs:label "RulebookReleases" ;
    rdfs:comment "Version ledger for the canonical ERB-PKO rulebook itself. This is distinct from PKO Procedure versioning." .

effortless-ntwf:rulebookReleaseId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:string ;
    rdfs:label "RulebookReleaseId" ;
    rdfs:comment "Stored logical identifier for one RulebookReleases row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the RulebookReleases row." .
    # calculated: calculated

effortless-ntwf:rulebookVersion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:string ;
    rdfs:label "RulebookVersion" ;
    rdfs:comment "Semantic version of this canonical rulebook release." .

effortless-ntwf:profileVersion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:string ;
    rdfs:label "ProfileVersion" ;
    rdfs:comment "Version of the ERB-PKO profile schema." .

effortless-ntwf:profileSchemaPath a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:string ;
    rdfs:label "ProfileSchemaPath" ;
    rdfs:comment "Repository-relative path to the ERB-PKO JSON profile schema." .

effortless-ntwf:pkoCoreVersionIri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:string ;
    rdfs:label "PkoCoreVersionIri" ;
    rdfs:comment "Exact version IRI of the PKO core ontology used by this release." .

effortless-ntwf:pkoIndustryVersionIri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:string ;
    rdfs:label "PkoIndustryVersionIri" ;
    rdfs:comment "Exact version IRI of the PKO industry module used by this release." .

effortless-ntwf:issuedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "IssuedAt" ;
    rdfs:comment "Timestamp at which this rulebook release was issued." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Release status such as Draft, Candidate, or Published." .

effortless-ntwf:changelog a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookReleases ;
    rdfs:range xsd:string ;
    rdfs:label "Changelog" ;
    rdfs:comment "Human-readable semantic changelog for this release." .

effortless-ntwf:isCurrent a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrent" ;
    rdfs:comment "TRUE only for the current rulebook release." .

# === Class: RulebookTables ===
effortless-ntwf:RulebookTables a owl:Class ;
    rdfs:label "RulebookTables" ;
    rdfs:comment "Census of every table in this rulebook. The table-level counterpart to RulebookFields, and the anchor every access policy points at. Derived by tools/reconcile_field_catalog.py -- never hand-maintained." .

effortless-ntwf:rulebookTableId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookTables ;
    rdfs:range xsd:string ;
    rdfs:label "RulebookTableId" ;
    rdfs:comment "Primary key: the rulebook table name, verbatim. rulebook-to-postgres synthesizes a lowercased slug PK for a table with no <Entity>Id and rewrites every FK to it, which broke each formula comparing an FK to TableName." .

effortless-ntwf:tableName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookTables ;
    rdfs:range xsd:string ;
    rdfs:label "TableName" ;
    rdfs:comment "Stored logical identifier: the rulebook table name, e.g. 'Procedures'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:physicalTable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookTables ;
    rdfs:range xsd:string ;
    rdfs:label "PhysicalTable" ;
    rdfs:comment "snake_case Postgres base table name emitted by rulebook-to-postgres." .

effortless-ntwf:physicalView a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookTables ;
    rdfs:range xsd:string ;
    rdfs:label "PhysicalView" ;
    rdfs:comment "snake_case Postgres view name (vw_*) carrying the computed columns." .

effortless-ntwf:subjectArea a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookTables ;
    rdfs:range xsd:string ;
    rdfs:label "SubjectArea" ;
    rdfs:comment "Coarse grouping used to organise role schemas, e.g. 'execution', 'governance'." .

effortless-ntwf:isExtension a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookTables ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExtension" ;
    rdfs:comment "True when this table is an ERB extension rather than a native/aligned PKO term." .

effortless-ntwf:fieldCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookTables ;
    rdfs:range xsd:string ;
    rdfs:label "FieldCount" ;
    rdfs:comment "Number of catalogued fields on this table." .
    # calculated: aggregation

effortless-ntwf:policyCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "PolicyCount" ;
    rdfs:comment "Number of access policies targeting this table." .
    # calculated: aggregation

effortless-ntwf:isUnsecured a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RulebookTables ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnsecured" ;
    rdfs:comment "True when RLS is enabled but no policy targets the table, so every principal sees zero rows. A fail-closed table nobody has granted access to." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: SemanticMappings ===
effortless-ntwf:SemanticMappings a owl:Class ;
    rdfs:label "SemanticMappings" ;
    rdfs:comment "Machine-readable alignment from ERB table/field paths to exact PKO or reused ontology terms. Extension mappings are never presented as native PKO." .

effortless-ntwf:semanticMappingId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SemanticMappings ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticMappingId" ;
    rdfs:comment "Stored logical identifier for one SemanticMappings row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the SemanticMappings row." .
    # calculated: calculated

effortless-ntwf:sourcePath a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SemanticMappings ;
    rdfs:range xsd:string ;
    rdfs:label "SourcePath" ;
    rdfs:comment "ERB table, field, or discriminator path." .

effortless-ntwf:mappingKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SemanticMappings ;
    rdfs:range xsd:string ;
    rdfs:label "MappingKind" ;
    rdfs:comment "class, objectProperty, datatypeProperty, individual, or rule." .

effortless-ntwf:targetIri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SemanticMappings ;
    rdfs:range xsd:string ;
    rdfs:label "TargetIri" ;
    rdfs:comment "Exact target semantic IRI." .

effortless-ntwf:mappingRelation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SemanticMappings ;
    rdfs:range xsd:string ;
    rdfs:label "MappingRelation" ;
    rdfs:comment "exact, aligned, subclass, subproperty, or extension." .

effortless-ntwf:ontologyProfile a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:SemanticMappings ;
    rdfs:range effortless-ntwf:OntologyProfiles ;
    rdfs:label "OntologyProfile" ;
    rdfs:comment "Versioned ontology profile containing the target term." .

effortless-ntwf:notes a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Notes" ;
    rdfs:comment "Mapping semantics and boundaries." .

# === Class: SendIntents ===
effortless-ntwf:SendIntents a owl:Class ;
    rdfs:label "SendIntents" ;
    rdfs:comment "SendIntents (added by witness loop 1)." .

effortless-ntwf:sendIntentId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "SendIntentId" ;
    rdfs:comment "Stored logical identifier for one SendIntents row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the SendIntents row." .
    # calculated: calculated

effortless-ntwf:procedureExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "ProcedureExecution" ;
    rdfs:comment "Execution this send intent belongs to." .

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "Step execution evaluating this intent." .

effortless-ntwf:recipient a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Recipients ;
    rdfs:label "Recipient" ;
    rdfs:comment "Intended recipient." .

effortless-ntwf:messageTemplate a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:MessageTemplates ;
    rdfs:label "MessageTemplate" ;
    rdfs:comment "Template the pipeline intends to render and send." .

effortless-ntwf:proposedBody a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "ProposedBody" ;
    rdfs:comment "The fully rendered text the pipeline intends to transmit, before transmission." .

effortless-ntwf:proposedSendAtLocalHour a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:integer ;
    rdfs:label "ProposedSendAtLocalHour" ;
    rdfs:comment "Hour 0-23 in the recipient's local timezone at which the pipeline intends to transmit." .

effortless-ntwf:evaluatedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "EvaluatedAt" ;
    rdfs:comment "When the pipeline evaluated the gates for this intent." .

effortless-ntwf:resultingDelivery a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range effortless-ntwf:MessageDeliveries ;
    rdfs:label "ResultingDelivery" ;
    rdfs:comment "The delivery record produced from this intent, whether transmitted or suppressed." .

effortless-ntwf:intentPolicy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "IntentPolicy" ;
    rdfs:comment "The communication policy governing the template this intent would send." .
    # calculated: lookup

effortless-ntwf:intentChannel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "IntentChannel" ;
    rdfs:comment "Channel this intent would transmit on." .
    # calculated: lookup

effortless-ntwf:policyIsActive a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "PolicyIsActive" ;
    rdfs:comment "Whether the governing policy is currently Active rather than Draft, Suspended, or Retired." .
    # calculated: lookup

effortless-ntwf:intentRequiresConsent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IntentRequiresConsent" ;
    rdfs:comment "Whether the governing policy requires consent for this channel." .
    # calculated: lookup

effortless-ntwf:recipientHasChannelConsent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "RecipientHasChannelConsent" ;
    rdfs:comment "Whether the intended recipient has active SMS consent on record." .
    # calculated: lookup

effortless-ntwf:consentGatePassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "ConsentGatePassed" ;
    rdfs:comment "TRUE when either the channel does not require consent, or the recipient has granted it." .
    # calculated: calculated

effortless-ntwf:recipientIsSmsReachable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "RecipientIsSmsReachable" ;
    rdfs:comment "Whether a mobile number is on file for the intended recipient." .
    # calculated: lookup

effortless-ntwf:recipientIsEmailReachable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "RecipientIsEmailReachable" ;
    rdfs:comment "Whether an email address is on file for the intended recipient." .
    # calculated: lookup

effortless-ntwf:reachabilityGatePassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "ReachabilityGatePassed" ;
    rdfs:comment "TRUE when the recipient is reachable on the channel this intent would use." .
    # calculated: calculated

effortless-ntwf:permissionGatePassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "PermissionGatePassed" ;
    rdfs:comment "TRUE when the policy is active, consent is satisfied, and the recipient is reachable on this channel. The channel-permission gate." .
    # calculated: calculated

effortless-ntwf:intentQuietStartHour a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:integer ;
    rdfs:label "IntentQuietStartHour" ;
    rdfs:comment "Quiet-hours start hour from the governing policy." .
    # calculated: lookup

effortless-ntwf:intentQuietEndHour a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:integer ;
    rdfs:label "IntentQuietEndHour" ;
    rdfs:comment "Quiet-hours end hour from the governing policy." .
    # calculated: lookup

effortless-ntwf:intentPolicyHasQuietHours a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IntentPolicyHasQuietHours" ;
    rdfs:comment "TRUE when the governing policy declares a real quiet-hours window." .
    # calculated: calculated

effortless-ntwf:intentQuietWindowWraps a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IntentQuietWindowWraps" ;
    rdfs:comment "TRUE when the quiet window crosses midnight." .
    # calculated: calculated

effortless-ntwf:intentIsInsideQuietWindow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IntentIsInsideQuietWindow" ;
    rdfs:comment "TRUE when the proposed recipient-local send hour falls inside the forbidden window." .
    # calculated: calculated

effortless-ntwf:timingGatePassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "TimingGatePassed" ;
    rdfs:comment "TRUE when transmitting now is permitted on timing grounds. The timing gate." .
    # calculated: calculated

effortless-ntwf:hoursUntilWindowOpens a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:integer ;
    rdfs:label "HoursUntilWindowOpens" ;
    rdfs:comment "How many hours the pipeline must defer before transmission becomes permitted; 0 when already permitted." .
    # calculated: calculated

effortless-ntwf:intentMaxMessageLength a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:integer ;
    rdfs:label "IntentMaxMessageLength" ;
    rdfs:comment "Per-segment character limit from the governing policy." .
    # calculated: lookup

effortless-ntwf:intentMaxSegments a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:integer ;
    rdfs:label "IntentMaxSegments" ;
    rdfs:comment "Segment ceiling from the governing policy." .
    # calculated: lookup

effortless-ntwf:proposedBodyLength a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:integer ;
    rdfs:label "ProposedBodyLength" ;
    rdfs:comment "Character count of ProposedBody, written by the pipeline at render time." .

effortless-ntwf:proposedSegmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:integer ;
    rdfs:label "ProposedSegmentCount" ;
    rdfs:comment "Number of channel segments ProposedBody will occupy, computed by the pipeline at render time." .

effortless-ntwf:lengthGatePassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "LengthGatePassed" ;
    rdfs:comment "TRUE when the proposed text is non-empty and fits within the segment ceiling." .
    # calculated: calculated

effortless-ntwf:intentRequiredOptOutPhrase a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "IntentRequiredOptOutPhrase" ;
    rdfs:comment "Opt-out phrase the governing policy requires in every message on this channel." .
    # calculated: lookup

effortless-ntwf:proposedOptOutPosition a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:integer ;
    rdfs:label "ProposedOptOutPosition" ;
    rdfs:comment "Character position of the required opt-out phrase within ProposedBody; 0 when absent. Written by the pipeline at render time." .

effortless-ntwf:optOutGatePassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "OptOutGatePassed" ;
    rdfs:comment "TRUE when no opt-out is required, or the required phrase is present within the first segment." .
    # calculated: calculated

effortless-ntwf:contentGatePassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "ContentGatePassed" ;
    rdfs:comment "TRUE when the proposed text satisfies every content rule of the governing channel policy." .
    # calculated: calculated

effortless-ntwf:templateIsSendable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "TemplateIsSendable" ;
    rdfs:comment "Whether the template carries a current, properly-authorized, non-drifted approval." .
    # calculated: lookup

effortless-ntwf:executionHasLegalClearance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExecutionHasLegalClearance" ;
    rdfs:comment "Whether legal review has passed for the execution this intent belongs to." .
    # calculated: lookup

effortless-ntwf:intentApprovalRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "IntentApprovalRole" ;
    rdfs:comment "The role the governing policy designates as the approving authority." .
    # calculated: lookup

effortless-ntwf:approvalRoleAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "ApprovalRoleAgentKind" ;
    rdfs:comment "Whether the agent currently filling the designated approval role is Human, AIAgent, or AutomatedPipeline." .
    # calculated: lookup

effortless-ntwf:approvalIsHuman a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "ApprovalIsHuman" ;
    rdfs:comment "TRUE when the designated approval role is currently held by a human agent." .
    # calculated: calculated

effortless-ntwf:authorizationGatePassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "AuthorizationGatePassed" ;
    rdfs:comment "TRUE only when the template is validly approved, legal review has cleared, and the approving role is held by a human. The authorization gate." .
    # calculated: calculated

effortless-ntwf:isClearedToSend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsClearedToSend" ;
    rdfs:comment "TRUE only when all four gates pass. THE single column the pipeline reads before transmitting." .
    # calculated: calculated

effortless-ntwf:blockingGateName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "BlockingGateName" ;
    rdfs:comment "Names the first gate that refused, for the suppression reason; empty string when cleared." .
    # calculated: calculated

effortless-ntwf:hasResultingDelivery a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasResultingDelivery" ;
    rdfs:comment "TRUE when this intent produced a delivery record of any status." .
    # calculated: calculated

effortless-ntwf:resultingDeliveryWasTransmitted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "ResultingDeliveryWasTransmitted" ;
    rdfs:comment "Whether the delivery produced from this intent actually left our systems." .
    # calculated: lookup

effortless-ntwf:isOverriddenRefusal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverriddenRefusal" ;
    rdfs:comment "TRUE when a gate refused and the message was transmitted regardless. The override witness." .
    # calculated: calculated

effortless-ntwf:isSilentlyDropped a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSilentlyDropped" ;
    rdfs:comment "TRUE when a gate refused and no delivery record of any kind was produced -- the recipient vanished from the run." .
    # calculated: calculated

effortless-ntwf:resultingDeliveryException a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "ResultingDeliveryException" ;
    rdfs:comment "The documented exception invoked on the delivery produced from this intent, if any." .
    # calculated: lookup

effortless-ntwf:refusalCitedAnException a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "RefusalCitedAnException" ;
    rdfs:comment "TRUE when the suppression produced by this refusal cited a documented exception." .
    # calculated: calculated

effortless-ntwf:isProperlyHandledRefusal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsProperlyHandledRefusal" ;
    rdfs:comment "TRUE when a refusal correctly resulted in a non-transmitted delivery record citing a documented exception. The positive witness." .
    # calculated: calculated

effortless-ntwf:refusalFailureExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "RefusalFailureExecutionKey" ;
    rdfs:comment "Carries the execution id on any mishandled refusal; empty string otherwise." .
    # calculated: calculated

effortless-ntwf:intentExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "IntentExecutionKey" ;
    rdfs:comment "The procedure execution id for every intent, used as the campaign rollup key." .
    # calculated: calculated

effortless-ntwf:deliveredIntentExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "DeliveredIntentExecutionKey" ;
    rdfs:comment "The execution id when this intent actually reached a person, otherwise empty string." .
    # calculated: calculated

effortless-ntwf:droppedIntentExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "DroppedIntentExecutionKey" ;
    rdfs:comment "The execution id when this intent was refused and left no record at all." .
    # calculated: calculated

effortless-ntwf:myApprovalWasInForce a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "MyApprovalWasInForce" ;
    rdfs:comment "TRUE when the template carried a valid approval at the moment this intent was evaluated." .
    # calculated: calculated

effortless-ntwf:refusedOnApprovedContent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "RefusedOnApprovedContent" ;
    rdfs:comment "TRUE when the pipeline refused an intent on content grounds even though the template was approved." .
    # calculated: calculated

effortless-ntwf:refusedOnOptOutOnly a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "RefusedOnOptOutOnly" ;
    rdfs:comment "TRUE when the only content failure was a missing or mispositioned opt-out phrase." .
    # calculated: calculated

effortless-ntwf:refusalWasOnMyRules a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "RefusalWasOnMyRules" ;
    rdfs:comment "TRUE when the refusal came from a communications rule I own -- content, length, opt-out, quiet hours." .
    # calculated: calculated

effortless-ntwf:refusalWasOutsideMyControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "RefusalWasOutsideMyControl" ;
    rdfs:comment "TRUE when the refusal came from consent, reachability, or authorization -- none of which I can fix by editing a template." .
    # calculated: calculated

effortless-ntwf:approverWasNotified a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "ApproverWasNotified" ;
    rdfs:comment "Whether the approving human was informed that this intent was refused." .

effortless-ntwf:isUnreportedRefusalOnMyRules a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnreportedRefusalOnMyRules" ;
    rdfs:comment "TRUE when a refusal I own and could have fixed was never surfaced to me." .
    # calculated: calculated

effortless-ntwf:isApprovalOverriddenSilently a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApprovalOverriddenSilently" ;
    rdfs:comment "TRUE when the pipeline overrode a valid human approval on content grounds and told nobody." .
    # calculated: calculated

effortless-ntwf:alternateChannelIntent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "AlternateChannelIntent" ;
    rdfs:comment "The follow-up intent raised on a different channel after this one was refused. Stored as a raw identifier rather than an FK: SendIntents pointing at SendIntents would make the table self-referential in a way the DAG contract does not allow here." .

effortless-ntwf:hasAlternateChannelAttempt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasAlternateChannelAttempt" ;
    rdfs:comment "TRUE when a follow-up intent on another channel was raised for this refused send." .
    # calculated: calculated

effortless-ntwf:alternateAttemptWasCleared a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "AlternateAttemptWasCleared" ;
    rdfs:comment "Whether the follow-up intent itself passed all gates." .
    # calculated: lookup

effortless-ntwf:isRefusedWithNoAlternative a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRefusedWithNoAlternative" ;
    rdfs:comment "TRUE when a send was refused and no attempt was ever made on any other channel." .
    # calculated: calculated

effortless-ntwf:exceptionPrescribedAnAlternative a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExceptionPrescribedAnAlternative" ;
    rdfs:comment "TRUE when the documented exception for this refusal prescribes a different-channel send as the correct handling." .
    # calculated: calculated

effortless-ntwf:prescribedHandlingWasPerformed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "PrescribedHandlingWasPerformed" ;
    rdfs:comment "TRUE when the exception prescribed an alternate channel and an alternate intent was actually raised and cleared." .
    # calculated: calculated

effortless-ntwf:isSuppressionWithoutRemedy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSuppressionWithoutRemedy" ;
    rdfs:comment "TRUE when we cited an exception that prescribed an alternate channel and then never performed it." .
    # calculated: calculated

effortless-ntwf:refusalRecordedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:dateTime ;
    rdfs:label "RefusalRecordedAt" ;
    rdfs:comment "When this refusal was written to a durable record. Empty when no record was ever emitted." .

effortless-ntwf:refusalNotifiedRole a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "RefusalNotifiedRole" ;
    rdfs:comment "The role informed that this send was refused." .

effortless-ntwf:hasDurableRefusalRecord a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasDurableRefusalRecord" ;
    rdfs:comment "TRUE when this refusal was written down somewhere a human can find it." .
    # calculated: calculated

effortless-ntwf:refusalWasEscalated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "RefusalWasEscalated" ;
    rdfs:comment "TRUE when a specific role was notified of this refusal." .
    # calculated: calculated

effortless-ntwf:isUnrecordedRefusal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnrecordedRefusal" ;
    rdfs:comment "TRUE when I refused a send and produced no delivery record, no refusal record, and no exception. The refusal left no trace of any kind." .
    # calculated: calculated

effortless-ntwf:isUnescalatedRefusal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnescalatedRefusal" ;
    rdfs:comment "TRUE when a refusal was recorded but no human role was ever told." .
    # calculated: calculated

effortless-ntwf:unescalatedRefusalRoleKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "UnescalatedRefusalRoleKey" ;
    rdfs:comment "Echoes the role that should have been told about this refusal, but only when the refusal went unrecorded. Empty otherwise." .
    # calculated: calculated

effortless-ntwf:unrecordedRefusalExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "UnrecordedRefusalExecutionKey" ;
    rdfs:comment "Echoes the parent procedure execution only for refusals nobody recorded; empty otherwise." .
    # calculated: calculated

effortless-ntwf:retryIntent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "RetryIntent" ;
    rdfs:comment "The intent I raised when the quiet window reopened for this deferred send. Raw identifier rather than an FK: a SendIntents self-reference is not expressible as a relationship without making the table depend on itself." .

effortless-ntwf:wasDeferredOnTiming a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasDeferredOnTiming" ;
    rdfs:comment "TRUE when the timing gate is the reason this intent did not clear, and every other gate passed." .
    # calculated: calculated

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:windowHasSinceReopened a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "WindowHasSinceReopened" ;
    rdfs:comment "TRUE when enough time has passed since evaluation that the quiet window this intent hit must have closed." .
    # calculated: calculated

effortless-ntwf:hasRetryAttempt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRetryAttempt" ;
    rdfs:comment "TRUE when a retry intent was raised for this deferred send." .
    # calculated: calculated

effortless-ntwf:retryWasCleared a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "RetryWasCleared" ;
    rdfs:comment "Whether the retry intent itself passed all gates." .
    # calculated: lookup

effortless-ntwf:isAbandonedDeferral a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAbandonedDeferral" ;
    rdfs:comment "TRUE when a send was deferred for timing, the window has since reopened, and no retry was ever raised. A deferral silently converted into a cancellation." .
    # calculated: calculated

effortless-ntwf:deferralAgeHours a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:integer ;
    rdfs:label "DeferralAgeHours" ;
    rdfs:comment "How long this deferred intent has been sitting since evaluation." .
    # calculated: calculated

effortless-ntwf:isStaleDeferral a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStaleDeferral" ;
    rdfs:comment "TRUE when a deferred send has been waiting more than 24 hours -- longer than any quiet window can justify." .
    # calculated: calculated

effortless-ntwf:evaluatingRoleAssignment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "EvaluatingRoleAssignment" ;
    rdfs:comment "The RoleAssignments id under which the pipeline evaluated this send intent. Raw rather than an FK because SendIntents already sits downstream of the execution graph and an added edge to RoleAssignments is not needed to resolve it." .

effortless-ntwf:enforcedByUnauthorizedAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "EnforcedByUnauthorizedAgent" ;
    rdfs:comment "Whether the gate decision on this intent was made by an agent holding an unauthorized enforcement assignment." .
    # calculated: lookup

effortless-ntwf:consentInputWasResolvable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "ConsentInputWasResolvable" ;
    rdfs:comment "TRUE when the recipient's consent state was actually retrievable, as opposed to absent and read as a refusal." .
    # calculated: calculated

effortless-ntwf:recipientConsentStatusRaw a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "RecipientConsentStatusRaw" ;
    rdfs:comment "The recipient's consent status as a string: Granted, Revoked, NeverGiven, or empty if no consent record exists at all." .
    # calculated: lookup

effortless-ntwf:policyInputWasResolvable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "PolicyInputWasResolvable" ;
    rdfs:comment "TRUE when a governing communication policy was actually found for this intent." .
    # calculated: calculated

effortless-ntwf:allGateInputsResolved a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "AllGateInputsResolved" ;
    rdfs:comment "TRUE when every input my gates depend on was actually retrievable." .
    # calculated: calculated

effortless-ntwf:isUnevaluableRefusal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnevaluableRefusal" ;
    rdfs:comment "TRUE when I refused a send but at least one gate input could not be resolved -- so I do not actually know whether the rule was violated or merely unreadable." .
    # calculated: calculated

effortless-ntwf:gateResultWasIndependentlyConfirmed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "GateResultWasIndependentlyConfirmed" ;
    rdfs:comment "Whether any agent other than me verified this gate outcome." .

effortless-ntwf:isSelfWitnessedDecision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSelfWitnessedDecision" ;
    rdfs:comment "TRUE when the entire decision to send or refuse rests solely on my own computation, unconfirmed by anything else." .
    # calculated: calculated

effortless-ntwf:isIndependentlyConfirmed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsIndependentlyConfirmed" ;
    rdfs:comment "TRUE when this intent's decision was corroborated by an actual delivery record rather than resting solely on the pipeline's own say-so." .
    # calculated: calculated

effortless-ntwf:independentlyConfirmedExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SendIntents ;
    rdfs:range xsd:string ;
    rdfs:label "IndependentlyConfirmedExecutionKey" ;
    rdfs:comment "Echoes the parent execution only for independently confirmed intents; empty otherwise." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension IRI; pre-send intents are not a PKO 2.0.0 native class." .

# === Class: StepActions ===
effortless-ntwf:StepActions a owl:Class ;
    rdfs:label "StepActions" ;
    rdfs:comment "Many-to-many Step/Action semantics normalized into a first-class ERB junction table." .

effortless-ntwf:stepActionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepActions ;
    rdfs:range xsd:string ;
    rdfs:label "StepActionId" ;
    rdfs:comment "Stored logical identifier for one StepActions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the StepActions row." .
    # calculated: calculated

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Step side of the relationship." .

effortless-ntwf:action a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:StepActions ;
    rdfs:range effortless-ntwf:Actions ;
    rdfs:label "Action" ;
    rdfs:comment "Action side of the relationship." .

# === Class: StepExecutions ===
effortless-ntwf:StepExecutions a owl:Class ;
    rdfs:label "StepExecutions" ;
    rdfs:comment "Concrete executions of specified steps. Maps to pko:StepExecution, hasExecutedStep, includesStepExecution, and nextStepExecution." .

effortless-ntwf:stepExecutionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "StepExecutionId" ;
    rdfs:comment "Stored logical identifier for one StepExecutions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the StepExecutions row." .
    # calculated: calculated

effortless-ntwf:procedureExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "ProcedureExecution" ;
    rdfs:comment "Parent procedure execution." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Specified step executed; maps to pko:hasExecutedStep." .

effortless-ntwf:executedByAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ExecutedByAgent" ;
    rdfs:comment "Agent executing the step; maps to pko:wasExecutedBy." .

effortless-ntwf:executionStatus a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ExecutionStatus" ;
    rdfs:comment "InProgress, Completed, Paused, Cancelled, or Failed." .

effortless-ntwf:startedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "StartedAt" ;
    rdfs:comment "Execution start." .

effortless-ntwf:endedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "EndedAt" ;
    rdfs:comment "Execution end." .

effortless-ntwf:verificationResult a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "VerificationResult" ;
    rdfs:comment "PASS, WARN, FAIL, or PENDING." .

effortless-ntwf:deviation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "Deviation" ;
    rdfs:comment "Observed deviation from the specification." .

effortless-ntwf:actualDurationMinutes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:integer ;
    rdfs:label "ActualDurationMinutes" ;
    rdfs:comment "Observed duration in minutes." .
    # calculated: calculated

effortless-ntwf:expectedDurationMinutes a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "ExpectedDurationMinutes" ;
    rdfs:comment "Expected duration from the specification." .
    # calculated: lookup

effortless-ntwf:isLate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLate" ;
    rdfs:comment "TRUE when actual duration exceeds expected duration." .
    # calculated: calculated

effortless-ntwf:blockingUnmetCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "BlockingUnmetCount" ;
    rdfs:comment "How many blocking requirements attached to this step execution are recorded as not fully satisfied." .
    # calculated: aggregation

effortless-ntwf:blockingUnmetCountSafe a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "BlockingUnmetCountSafe" ;
    rdfs:comment "Count of blocking-but-unmet requirements on this step execution, computed via the single-criterion key so no criterion is dropped." .
    # calculated: aggregation

effortless-ntwf:proceededPastBlockingControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ProceededPastBlockingControl" ;
    rdfs:comment "TRUE when a step execution reached Completed even though a blocking requirement on it was never fully satisfied." .
    # calculated: calculated

effortless-ntwf:expectedBlockingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ExpectedBlockingCount" ;
    rdfs:comment "How many blocking requirements this execution's step was supposed to have evaluated." .
    # calculated: lookup

effortless-ntwf:evaluatedBlockingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "EvaluatedBlockingCount" ;
    rdfs:comment "How many blocking requirements actually received a satisfaction record on this step execution, at any level." .
    # calculated: aggregation

effortless-ntwf:unevaluatedBlockingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UnevaluatedBlockingCount" ;
    rdfs:comment "Blocking requirements that were bound to this step but never assessed on this execution." .
    # calculated: calculated

effortless-ntwf:hasUnevaluatedBlockingControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnevaluatedBlockingControl" ;
    rdfs:comment "TRUE when at least one blocking control bound to this step was never evaluated on this execution." .
    # calculated: calculated

effortless-ntwf:staleAuthoritativeSourceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "StaleAuthoritativeSourceCount" ;
    rdfs:comment "Number of stale authoritative sources bound to the step this execution ran." .
    # calculated: lookup

effortless-ntwf:ranOnStaleAuthoritativeSource a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "RanOnStaleAuthoritativeSource" ;
    rdfs:comment "TRUE when this execution's step depends on at least one authoritative source that is outside its freshness SLA." .
    # calculated: calculated

effortless-ntwf:hasDeviationNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasDeviationNote" ;
    rdfs:comment "TRUE when a human recorded some deviation narrative on this execution." .
    # calculated: calculated

effortless-ntwf:isLateAndUnexplained a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLateAndUnexplained" ;
    rdfs:comment "TRUE when the execution exceeded its expected duration and no deviation was recorded." .
    # calculated: calculated

effortless-ntwf:availableExceptionCountForStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "AvailableExceptionCountForStep" ;
    rdfs:comment "How many active exceptions were available to this execution's step." .
    # calculated: lookup

effortless-ntwf:hadUninvokedExceptionAvailable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HadUninvokedExceptionAvailable" ;
    rdfs:comment "TRUE when an execution ran long with no explanation despite the specification defining an active exception for exactly that situation." .
    # calculated: calculated

effortless-ntwf:expectedVerificationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ExpectedVerificationCount" ;
    rdfs:comment "How many verifications this execution was supposed to perform." .
    # calculated: lookup

effortless-ntwf:performedVerificationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "PerformedVerificationCount" ;
    rdfs:comment "How many verification outcomes were actually recorded against this execution." .
    # calculated: aggregation

effortless-ntwf:skippedVerificationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "SkippedVerificationCount" ;
    rdfs:comment "Declared verifications with no recorded outcome on this execution." .
    # calculated: calculated

effortless-ntwf:hasSkippedVerification a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSkippedVerification" ;
    rdfs:comment "TRUE when a declared verification was never performed on this execution." .
    # calculated: calculated

effortless-ntwf:claimsPassWithoutEvidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ClaimsPassWithoutEvidence" ;
    rdfs:comment "TRUE when an execution asserts PASS while at least one declared verification has no recorded outcome." .
    # calculated: calculated

effortless-ntwf:stepIsPreparation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "StepIsPreparation" ;
    rdfs:comment "Whether this execution ran a preparation step." .
    # calculated: lookup

effortless-ntwf:stepIsApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "StepIsApproval" ;
    rdfs:comment "Whether this execution ran an approval step." .
    # calculated: lookup

effortless-ntwf:preparerAgentKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "PreparerAgentKey" ;
    rdfs:comment "Composite execution+agent key, emitted only for preparation steps." .
    # calculated: calculated

effortless-ntwf:approverAgentKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ApproverAgentKey" ;
    rdfs:comment "Composite execution+agent key, emitted only for approval steps." .
    # calculated: calculated

effortless-ntwf:preparedByThisAgentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "PreparedByThisAgentCount" ;
    rdfs:comment "On an approval row, how many preparation steps in the SAME procedure execution were run by this same agent." .
    # calculated: aggregation

effortless-ntwf:violatesSeparationOfDuties a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ViolatesSeparationOfDuties" ;
    rdfs:comment "TRUE when the agent approving this step also prepared work earlier in the same procedure execution." .
    # calculated: calculated

effortless-ntwf:requiredRoleForStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "RequiredRoleForStep" ;
    rdfs:comment "The role the specification assigns to this step." .
    # calculated: lookup

effortless-ntwf:executorRoleKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ExecutorRoleKey" ;
    rdfs:comment "The agent+role pair that would need to exist as a valid assignment for this execution to be properly authorized." .
    # calculated: calculated

effortless-ntwf:executorAuthorityCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ExecutorAuthorityCount" ;
    rdfs:comment "How many currently-valid role assignments grant this executor the role their step required." .
    # calculated: aggregation

effortless-ntwf:executorHeldRequiredRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExecutorHeldRequiredRole" ;
    rdfs:comment "TRUE when the executing agent holds a currently-valid assignment to the role the step required." .
    # calculated: calculated

effortless-ntwf:isUnauthorizedApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnauthorizedApproval" ;
    rdfs:comment "TRUE when an approval step was executed by an agent who does not hold the required approving role." .
    # calculated: calculated

effortless-ntwf:completedExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "CompletedExecutionKey" ;
    rdfs:comment "Echoes the parent execution id only for completed steps." .
    # calculated: calculated

effortless-ntwf:controlBreachExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ControlBreachExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this step execution carries ANY control breach." .
    # calculated: calculated

effortless-ntwf:lateExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "LateExecutionKey" ;
    rdfs:comment "Echoes the parent execution id only for steps that ran past their expected duration." .
    # calculated: calculated

effortless-ntwf:executorAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ExecutorAgentKind" ;
    rdfs:comment "Human, AIAgent, or AutomatedPipeline — what kind of agent actually ran this step." .
    # calculated: lookup

effortless-ntwf:executorIsHuman a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExecutorIsHuman" ;
    rdfs:comment "TRUE when a human executed this step." .
    # calculated: calculated

effortless-ntwf:stepRequiresHumanConfirmation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "StepRequiresHumanConfirmation" ;
    rdfs:comment "Whether the specification requires this step to be human-confirmed." .
    # calculated: lookup

effortless-ntwf:nonHumanRanHumanStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "NonHumanRanHumanStep" ;
    rdfs:comment "TRUE when a step requiring human confirmation was executed by an AI agent or automated pipeline." .
    # calculated: calculated

effortless-ntwf:nonHumanApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "NonHumanApproval" ;
    rdfs:comment "TRUE when an approval-authority step was executed by a non-human agent, regardless of the RequiresHumanConfirmation flag." .
    # calculated: calculated

effortless-ntwf:unevaluatedBlockingExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UnevaluatedBlockingExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this step left a blocking control unevaluated." .
    # calculated: calculated

effortless-ntwf:separationViolationExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "SeparationViolationExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this step execution violates segregation of duties." .
    # calculated: calculated

effortless-ntwf:selfWitnessedVerificationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "SelfWitnessedVerificationCount" ;
    rdfs:comment "How many of this execution's verifications were observed by the same agent who ran the step." .
    # calculated: aggregation

effortless-ntwf:unbackedVerificationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UnbackedVerificationCount" ;
    rdfs:comment "How many verifications on this execution recorded a matching signal with no retained evidence artifact." .
    # calculated: aggregation

effortless-ntwf:approvalRestsOnSelfAttestation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ApprovalRestsOnSelfAttestation" ;
    rdfs:comment "TRUE when an approval step's verification was either self-witnessed by the approver or never performed at all." .
    # calculated: calculated

effortless-ntwf:exceptionInvocationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ExceptionInvocationCount" ;
    rdfs:comment "How many specified exceptions were invoked during this step execution." .
    # calculated: aggregation

effortless-ntwf:ranUnderException a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "RanUnderException" ;
    rdfs:comment "TRUE when this execution invoked at least one specified exception." .
    # calculated: calculated

effortless-ntwf:isCompleted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCompleted" ;
    rdfs:comment "TRUE when this step execution reached a completed state." .
    # calculated: calculated

effortless-ntwf:isVerificationPassed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsVerificationPassed" ;
    rdfs:comment "TRUE only when this step execution's verification actually passed. PENDING and FAIL are both not-passed." .
    # calculated: calculated

effortless-ntwf:isLegalReviewStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLegalReviewStep" ;
    rdfs:comment "TRUE for executions of the legal and privacy review step." .
    # calculated: calculated

effortless-ntwf:clearedLegalReviewKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ClearedLegalReviewKey" ;
    rdfs:comment "Carries the execution id only when this row is a PASSED legal review; empty string otherwise." .
    # calculated: calculated

effortless-ntwf:assignedRole a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AssignedRole" ;
    rdfs:comment "The role the specification assigns to this step." .
    # calculated: lookup

effortless-ntwf:roleCurrentAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "RoleCurrentAgent" ;
    rdfs:comment "The agent currently designated to hold the step's assigned role." .
    # calculated: lookup

effortless-ntwf:executorIsDesignatedAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExecutorIsDesignatedAgent" ;
    rdfs:comment "TRUE when the agent that executed the step is the agent currently designated for the step's role." .
    # calculated: calculated

effortless-ntwf:inputsWereFreshAtRun a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "InputsWereFreshAtRun" ;
    rdfs:comment "Freshness verdict for the step this execution ran." .
    # calculated: lookup

effortless-ntwf:ranOnStaleInputs a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "RanOnStaleInputs" ;
    rdfs:comment "TRUE when an execution completed even though its step's authoritative inputs are stale." .
    # calculated: calculated

effortless-ntwf:unresolvedIssueCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UnresolvedIssueCount" ;
    rdfs:comment "Number of unresolved issue occurrences recorded against this execution." .
    # calculated: aggregation

effortless-ntwf:hasDeviation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasDeviation" ;
    rdfs:comment "TRUE when a deviation from the specification was recorded." .
    # calculated: calculated

effortless-ntwf:isClean a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsClean" ;
    rdfs:comment "TRUE when this execution passed verification, deviated from nothing, left no open issue, and finished on time." .
    # calculated: calculated

effortless-ntwf:procedureExecutionWhenUnclean a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ProcedureExecutionWhenUnclean" ;
    rdfs:comment "Echoes the parent execution id when this step execution is not clean, blank otherwise." .
    # calculated: calculated

effortless-ntwf:evaluatedRequirementCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "EvaluatedRequirementCount" ;
    rdfs:comment "Number of requirements actually scored against this execution." .
    # calculated: aggregation

effortless-ntwf:requiredBlockingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:integer ;
    rdfs:label "RequiredBlockingCount" ;
    rdfs:comment "Number of blocking requirements the specification demands for this step." .
    # calculated: lookup

effortless-ntwf:hasUnevaluatedBlockingRequirement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnevaluatedBlockingRequirement" ;
    rdfs:comment "TRUE when fewer requirements were scored than the step has blocking requirements." .
    # calculated: calculated

effortless-ntwf:executingAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ExecutingAgentKind" ;
    rdfs:comment "The kind of agent that actually performed this step execution." .
    # calculated: lookup

effortless-ntwf:wasExecutedBySoftware a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasExecutedBySoftware" ;
    rdfs:comment "TRUE when software actually performed this step." .
    # calculated: calculated

effortless-ntwf:stepIsSoftwareAssigned a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "StepIsSoftwareAssigned" ;
    rdfs:comment "Whether the step being executed was specified as a software step." .
    # calculated: lookup

effortless-ntwf:softwareDidHumanWork a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "SoftwareDidHumanWork" ;
    rdfs:comment "TRUE when software performed a step the procedure specified for a human." .
    # calculated: calculated

effortless-ntwf:isApprovalExecution a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApprovalExecution" ;
    rdfs:comment "Whether this execution is of a designated human approval gate." .
    # calculated: lookup

effortless-ntwf:isVerified a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsVerified" ;
    rdfs:comment "TRUE when this execution recorded a positive verification outcome." .
    # calculated: calculated

effortless-ntwf:unconfirmedNonHumanDecisionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UnconfirmedNonHumanDecisionCount" ;
    rdfs:comment "Number of material non-human decisions in this execution that no human confirmed." .
    # calculated: aggregation

effortless-ntwf:requiresHumanConfirmation a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "RequiresHumanConfirmation" ;
    rdfs:comment "Whether the specification requires human confirmation for this step." .
    # calculated: lookup

effortless-ntwf:humanConfirmationMissing a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HumanConfirmationMissing" ;
    rdfs:comment "TRUE when a step requiring human confirmation contains unconfirmed material non-human decisions." .
    # calculated: calculated

effortless-ntwf:draftedFromUnusableSource a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "DraftedFromUnusableSource" ;
    rdfs:comment "TRUE when a drafting execution completed despite an unapproved or stale source at its step." .
    # calculated: calculated

effortless-ntwf:inputsWereUsable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "InputsWereUsable" ;
    rdfs:comment "Source-usability verdict for the step this execution ran." .
    # calculated: lookup

effortless-ntwf:softwareExecutionStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "SoftwareExecutionStepKey" ;
    rdfs:comment "Composite-key echo: the step this execution ran when it was carried out by software, blank otherwise." .
    # calculated: calculated

effortless-ntwf:stepControlKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "StepControlKind" ;
    rdfs:comment "The control kind of the step this execution ran." .
    # calculated: lookup

effortless-ntwf:unfalsifiedClearanceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UnfalsifiedClearanceCount" ;
    rdfs:comment "How many of this step's blocking clearances came from controls that have never once failed." .
    # calculated: aggregation

effortless-ntwf:allClearancesAreUnfalsified a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "AllClearancesAreUnfalsified" ;
    rdfs:comment "TRUE when every blocking control evaluated on this step is one that has never returned a negative result." .
    # calculated: calculated

effortless-ntwf:staleAtRunCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "StaleAtRunCount" ;
    rdfs:comment "How many authoritative sources this step read that were already out of SLA when it read them." .
    # calculated: aggregation

effortless-ntwf:wasStaleWhenIRanIt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasStaleWhenIRanIt" ;
    rdfs:comment "TRUE when this execution consumed at least one authoritative source that was stale at the time of reading." .
    # calculated: calculated

effortless-ntwf:stalenessAnswerIsTenseDependent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "StalenessAnswerIsTenseDependent" ;
    rdfs:comment "TRUE when the as-of-now staleness verdict disagrees with the as-of-run verdict for the same step." .
    # calculated: calculated

effortless-ntwf:hasAnyDeclaredCheck a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasAnyDeclaredCheck" ;
    rdfs:comment "TRUE when the specification declared at least one verification or one blocking requirement for this step." .
    # calculated: calculated

effortless-ntwf:performedCheckCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "PerformedCheckCount" ;
    rdfs:comment "Total number of checks actually carried out on this execution, verifications plus blocking-control evaluations." .
    # calculated: calculated

effortless-ntwf:declaredCheckCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "DeclaredCheckCount" ;
    rdfs:comment "Total number of checks the specification called for on this step." .
    # calculated: calculated

effortless-ntwf:isUncheckedByDesign a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUncheckedByDesign" ;
    rdfs:comment "TRUE when the specification asked for no verification and no blocking control on this step at all." .
    # calculated: calculated

effortless-ntwf:isVacuouslyClean a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsVacuouslyClean" ;
    rdfs:comment "TRUE when this execution reads clean and nothing was ever declared that could have made it read otherwise." .
    # calculated: calculated

effortless-ntwf:isSubstantivelyClean a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSubstantivelyClean" ;
    rdfs:comment "TRUE when this execution is clean AND every declared check was actually performed." .
    # calculated: calculated

effortless-ntwf:vacuouslyCleanExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "VacuouslyCleanExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this step is vacuously clean." .
    # calculated: calculated

effortless-ntwf:uncorroboratedPassCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UncorroboratedPassCount" ;
    rdfs:comment "How many of this step's passing verifications were observed by the executor with no evidence attached." .
    # calculated: aggregation

effortless-ntwf:evidencePositionIsWeak a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "EvidencePositionIsWeak" ;
    rdfs:comment "TRUE when every verification performed on this step was an uncorroborated self-witnessed pass." .
    # calculated: calculated

effortless-ntwf:preparationExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "PreparationExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this step execution is a preparation step." .
    # calculated: calculated

effortless-ntwf:approvalExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ApprovalExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this step execution is an approval step." .
    # calculated: calculated

effortless-ntwf:hasGoverningInstrument a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasGoverningInstrument" ;
    rdfs:comment "TRUE when this step's departure from spec is covered by an invoked exception or an approved change request against its procedure version." .
    # calculated: calculated

effortless-ntwf:hasApprovedChangeCoverage a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasApprovedChangeCoverage" ;
    rdfs:comment "Whether the procedure version this step belongs to has an approved change request that could account for a departure." .
    # calculated: lookup

effortless-ntwf:versionOfStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "VersionOfStep" ;
    rdfs:comment "The procedure version this step execution's specification step belongs to." .
    # calculated: lookup

effortless-ntwf:isUngovernedDivergence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngovernedDivergence" ;
    rdfs:comment "TRUE when this step departed from specification and no exception or approved change covers it." .
    # calculated: calculated

effortless-ntwf:ungovernedDivergenceExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UngovernedDivergenceExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this step diverged without governance." .
    # calculated: calculated

effortless-ntwf:selfAttestedApprovalExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "SelfAttestedApprovalExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this approval rested on self-attestation." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: StepFunctions ===
effortless-ntwf:StepFunctions a owl:Class ;
    rdfs:label "StepFunctions" ;
    rdfs:comment "Many-to-many Step/Function semantics normalized into an ERB junction table." .

effortless-ntwf:stepFunctionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepFunctions ;
    rdfs:range xsd:string ;
    rdfs:label "StepFunctionId" ;
    rdfs:comment "Stored logical identifier for one StepFunctions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the StepFunctions row." .
    # calculated: calculated

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Step side of the relationship." .

effortless-ntwf:function a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:StepFunctions ;
    rdfs:range effortless-ntwf:Functions ;
    rdfs:label "Function" ;
    rdfs:comment "Function side of the relationship." .

# === Class: StepRequirements ===
effortless-ntwf:StepRequirements a owl:Class ;
    rdfs:label "StepRequirements" ;
    rdfs:comment "Many-to-many Step/Requirement semantics normalized into an ERB junction table." .

effortless-ntwf:stepRequirementId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepRequirements ;
    rdfs:range xsd:string ;
    rdfs:label "StepRequirementId" ;
    rdfs:comment "Stored logical identifier for one StepRequirements row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the StepRequirements row." .
    # calculated: calculated

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Step side of the relationship." .

effortless-ntwf:requirement a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Requirements ;
    rdfs:label "Requirement" ;
    rdfs:comment "Requirement side of the relationship." .

effortless-ntwf:requirementIsBlocking a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "RequirementIsBlocking" ;
    rdfs:comment "Whether this spec-side step/requirement binding names a blocking control." .
    # calculated: lookup

effortless-ntwf:blockingStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepRequirements ;
    rdfs:range xsd:string ;
    rdfs:label "BlockingStepKey" ;
    rdfs:comment "Echoes the Step id only when the bound requirement is blocking; empty otherwise." .
    # calculated: calculated

effortless-ntwf:stepWhenBlocking a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepRequirements ;
    rdfs:range xsd:string ;
    rdfs:label "StepWhenBlocking" ;
    rdfs:comment "Echoes the step id when the bound requirement is blocking, blank otherwise." .
    # calculated: calculated

effortless-ntwf:requirementLacksWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepRequirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "RequirementLacksWitness" ;
    rdfs:comment "Whether the requirement bound at this step is a blocking control with no computed witness." .
    # calculated: lookup

effortless-ntwf:unwitnessedStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepRequirements ;
    rdfs:range xsd:string ;
    rdfs:label "UnwitnessedStepKey" ;
    rdfs:comment "Echoes the step id when the requirement bound here has no computed witness." .
    # calculated: calculated

effortless-ntwf:satisfactionCountForBinding a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepRequirements ;
    rdfs:range xsd:string ;
    rdfs:label "SatisfactionCountForBinding" ;
    rdfs:comment "How many times this specific (step, requirement) binding has been evaluated in any execution." .
    # calculated: aggregation

effortless-ntwf:bindingWasEverExercised a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepRequirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "BindingWasEverExercised" ;
    rdfs:comment "TRUE when this specific (step, requirement) pair has been evaluated at least once." .
    # calculated: calculated

effortless-ntwf:isUnexercisedBlockingBinding a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepRequirements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnexercisedBlockingBinding" ;
    rdfs:comment "TRUE for a blocking control bound to a step where it has never actually been evaluated." .
    # calculated: calculated

effortless-ntwf:unexercisedBindingRequirementKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepRequirements ;
    rdfs:range xsd:string ;
    rdfs:label "UnexercisedBindingRequirementKey" ;
    rdfs:comment "Echoes the requirement id when this binding has never been exercised." .
    # calculated: calculated

# === Class: StepTools ===
effortless-ntwf:StepTools a owl:Class ;
    rdfs:label "StepTools" ;
    rdfs:comment "Many-to-many Step/Tool semantics normalized into an ERB junction table." .

effortless-ntwf:stepToolId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTools ;
    rdfs:range xsd:string ;
    rdfs:label "StepToolId" ;
    rdfs:comment "Stored logical identifier for one StepTools row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the StepTools row." .
    # calculated: calculated

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Step side of the relationship." .

effortless-ntwf:tool a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:StepTools ;
    rdfs:range effortless-ntwf:Tools ;
    rdfs:label "Tool" ;
    rdfs:comment "Tool side of the relationship." .

# === Class: StepTransitions ===
effortless-ntwf:StepTransitions a owl:Class ;
    rdfs:label "StepTransitions" ;
    rdfs:comment "Directed control-flow edges represented as first-class pko:Transition instances with fromStep/toStep and next/alternative/fallback semantics." .

effortless-ntwf:stepTransitionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:string ;
    rdfs:label "StepTransitionId" ;
    rdfs:comment "Stored logical identifier for one StepTransitions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the StepTransitions row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version whose control flow owns the transition." .

effortless-ntwf:fromStep a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "FromStep" ;
    rdfs:comment "Source step; maps to pko:fromStep." .

effortless-ntwf:toStep a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "ToStep" ;
    rdfs:comment "Destination step; maps to pko:toStep." .

effortless-ntwf:transitionKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:string ;
    rdfs:label "TransitionKind" ;
    rdfs:comment "Next, Alternative, or Fallback." .

effortless-ntwf:condition a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Condition" ;
    rdfs:comment "Condition under which the edge is taken." .

effortless-ntwf:priority a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:integer ;
    rdfs:label "Priority" ;
    rdfs:comment "Evaluation priority when several outgoing edges exist." .

effortless-ntwf:isRecoveryPath a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRecoveryPath" ;
    rdfs:comment "TRUE when this transition is a non-default path taken because something went wrong." .
    # calculated: calculated

effortless-ntwf:countOfFromStepExecutions a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfFromStepExecutions" ;
    rdfs:comment "How many times the step this transition leaves from has actually been executed." .
    # calculated: aggregation

effortless-ntwf:countOfToStepExecutions a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfToStepExecutions" ;
    rdfs:comment "How many times the step this transition arrives at has actually been executed." .
    # calculated: aggregation

effortless-ntwf:hasReachableOrigin a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasReachableOrigin" ;
    rdfs:comment "TRUE when the origin step of this transition has been executed at least once." .
    # calculated: calculated

effortless-ntwf:hasReachableTarget a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasReachableTarget" ;
    rdfs:comment "TRUE when the destination step of this transition has been executed at least once." .
    # calculated: calculated

effortless-ntwf:isNeverExercised a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNeverExercised" ;
    rdfs:comment "TRUE when at least one end of this transition has never appeared in any step execution." .
    # calculated: calculated

effortless-ntwf:isUntestedRecoveryPath a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntestedRecoveryPath" ;
    rdfs:comment "TRUE for a Fallback or Alternative transition whose endpoints show no execution evidence." .
    # calculated: calculated

effortless-ntwf:countOfObservedTraversals a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfObservedTraversals" ;
    rdfs:comment "How many times this exact transition has actually been traversed." .
    # calculated: aggregation

effortless-ntwf:hasBeenTraversed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasBeenTraversed" ;
    rdfs:comment "TRUE when this transition has been walked at least once." .
    # calculated: calculated

effortless-ntwf:isUnwalkedRecoveryPath a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwalkedRecoveryPath" ;
    rdfs:comment "TRUE for a Fallback/Alternative transition with zero recorded traversals." .
    # calculated: calculated

effortless-ntwf:targetBlockingRequirementCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:string ;
    rdfs:label "TargetBlockingRequirementCount" ;
    rdfs:comment "How many blocking requirements are attached to the step this transition lands on." .
    # calculated: lookup

effortless-ntwf:targetCarriesBlockingControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "TargetCarriesBlockingControl" ;
    rdfs:comment "Whether the destination step of this transition carries at least one blocking control." .
    # calculated: calculated

effortless-ntwf:isUnrehearsedControlEntry a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnrehearsedControlEntry" ;
    rdfs:comment "A recovery path that has never been traversed and that leads into a step carrying a blocking control." .
    # calculated: calculated

effortless-ntwf:unrehearsedControlVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepTransitions ;
    rdfs:range xsd:string ;
    rdfs:label "UnrehearsedControlVersionKey" ;
    rdfs:comment "Composite-key echo: this transition's procedure version when it is an unrehearsed control entry, blank otherwise." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: StepVerifications ===
effortless-ntwf:StepVerifications a owl:Class ;
    rdfs:label "StepVerifications" ;
    rdfs:comment "Verification definitions attached to steps. Maps to pko:StepVerification and pko:SignalVerification." .

effortless-ntwf:stepVerificationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepVerifications ;
    rdfs:range xsd:string ;
    rdfs:label "StepVerificationId" ;
    rdfs:comment "Stored logical identifier for one StepVerifications row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the StepVerifications row." .
    # calculated: calculated

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Step whose execution is verified; maps to pko:hasStepVerification." .

effortless-ntwf:verificationKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StepVerifications ;
    rdfs:range xsd:string ;
    rdfs:label "VerificationKind" ;
    rdfs:comment "SignalVerification, ApprovalVerification, ProvenanceVerification, or another documented kind." .

effortless-ntwf:signalIdentifier a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SignalIdentifier" ;
    rdfs:comment "Signal or evidence key; maps to pko:signalIdentifier for signal verifications." .

effortless-ntwf:expectedSignalValue a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ExpectedSignalValue" ;
    rdfs:comment "Expected value; maps to pko:expectedSignalValue." .

effortless-ntwf:instruction a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Instruction" ;
    rdfs:comment "How to verify the step." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO or extension class IRI." .

# === Class: Steps ===
effortless-ntwf:Steps a owl:Class ;
    rdfs:label "Steps" ;
    rdfs:comment "Version-scoped units of work. Atomic steps map to pplan:Step; composite steps map to pplan:MultiStep. The specification is never conflated with execution." .

effortless-ntwf:stepId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "StepId" ;
    rdfs:comment "Stored logical identifier for one Steps row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Steps row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version containing the step; maps to pko:hasStep/pplan:isStepOfPlan." .

effortless-ntwf:stepNumber a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "StepNumber" ;
    rdfs:comment "Stable sequence label; maps to pko:stepNumber." .

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Human-readable step title." .

effortless-ntwf:stepKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "StepKind" ;
    rdfs:comment "Atomic or MultiStep." .

effortless-ntwf:assignedRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "AssignedRole" ;
    rdfs:comment "Role responsible for the step." .

effortless-ntwf:assignedRoleLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "AssignedRoleLabel" ;
    rdfs:comment "Resolved role label." .
    # calculated: lookup

effortless-ntwf:assignedAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "AssignedAgentKind" ;
    rdfs:comment "Current role-filler category." .
    # calculated: lookup

effortless-ntwf:instruction a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Instruction" ;
    rdfs:comment "Normative step instruction." .

effortless-ntwf:expectedDurationMinutes a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "ExpectedDurationMinutes" ;
    rdfs:comment "Expected duration represented as an OWL-Time duration in semantic projections." .

effortless-ntwf:expertiseLevel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "ExpertiseLevel" ;
    rdfs:comment "PKO expertise level: Junior, Senior, Expert, or Master." .

effortless-ntwf:requiresHumanConfirmation a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "RequiresHumanConfirmation" ;
    rdfs:comment "TRUE when a human must confirm the step; maps to pko:wasConfirmedBy at execution." .

effortless-ntwf:blockingRequirementCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "BlockingRequirementCount" ;
    rdfs:comment "How many blocking requirements the specification attaches to this step." .
    # calculated: aggregation

effortless-ntwf:staleBindingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "StaleBindingCount" ;
    rdfs:comment "How many operational bindings for this step are currently outside their freshness SLA." .
    # calculated: aggregation

effortless-ntwf:authoritativeStaleCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "AuthoritativeStaleCount" ;
    rdfs:comment "How many authoritative bindings for this step are currently stale." .
    # calculated: aggregation

effortless-ntwf:availableExceptionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "AvailableExceptionCount" ;
    rdfs:comment "How many active exceptions the specification defines for this step." .
    # calculated: aggregation

effortless-ntwf:declaredVerificationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "DeclaredVerificationCount" ;
    rdfs:comment "How many verifications the specification declares for this step." .
    # calculated: aggregation

effortless-ntwf:isPreparationStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPreparationStep" ;
    rdfs:comment "TRUE for steps whose assigned role produces the work product rather than reviewing it." .
    # calculated: calculated

effortless-ntwf:isApprovalStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApprovalStep" ;
    rdfs:comment "TRUE for steps whose assigned role is an approval authority." .
    # calculated: calculated

effortless-ntwf:staleAuthoritativeBindingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "StaleAuthoritativeBindingCount" ;
    rdfs:comment "Number of authoritative bindings for this step that are past their freshness SLA." .
    # calculated: aggregation

effortless-ntwf:inputsAreFresh a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "InputsAreFresh" ;
    rdfs:comment "TRUE when no authoritative binding for this step is stale." .
    # calculated: calculated

effortless-ntwf:isSoftwareAssigned a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSoftwareAssigned" ;
    rdfs:comment "TRUE when this step is specified to be performed by software rather than a person." .
    # calculated: calculated

effortless-ntwf:isHumanApprovalGate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHumanApprovalGate" ;
    rdfs:comment "TRUE for the steps that exist specifically to place a human commitment between drafting and delivery." .
    # calculated: calculated

effortless-ntwf:gateHeldByHuman a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "GateHeldByHuman" ;
    rdfs:comment "TRUE when a designated approval gate is in fact assigned to a human role." .
    # calculated: calculated

effortless-ntwf:bindingBoundaryCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "BindingBoundaryCount" ;
    rdfs:comment "Number of authority boundaries currently binding at this step." .
    # calculated: aggregation

effortless-ntwf:assignedRoleIsUngoverned a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "AssignedRoleIsUngoverned" ;
    rdfs:comment "Whether this step's assigned role is a non-human role with no governing assignment." .
    # calculated: lookup

effortless-ntwf:unusableBindingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "UnusableBindingCount" ;
    rdfs:comment "Number of bindings at this step that are unapproved or stale." .
    # calculated: aggregation

effortless-ntwf:allSourcesUsable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "AllSourcesUsable" ;
    rdfs:comment "TRUE when every binding at this step is an approved, fresh source." .
    # calculated: calculated

effortless-ntwf:controlKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "ControlKind" ;
    rdfs:comment "What kind of control this step is: Preparation, Approval, LegalReview, Verification, Extraction, Publication, Retrospective, or None. That policy-04 is a legal review is a property OF policy-04, not of a formula that happens to name it; storing it as data makes downstream predicates portable to procedures that do not exist yet." .

effortless-ntwf:unwarrantedBoundaryCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "UnwarrantedBoundaryCount" ;
    rdfs:comment "How many boundaries governing this step are being enforced without a valid ratifying claim." .
    # calculated: aggregation

effortless-ntwf:isGovernedByUnwarrantedBoundary a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGovernedByUnwarrantedBoundary" ;
    rdfs:comment "Whether this step's constraints on machine authority rest on a claim that is no longer valid." .
    # calculated: calculated

effortless-ntwf:softwareExecutionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "SoftwareExecutionCount" ;
    rdfs:comment "How many times a software agent has actually executed this step." .
    # calculated: aggregation

effortless-ntwf:hasBeenApproachedBySoftware a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasBeenApproachedBySoftware" ;
    rdfs:comment "Whether any software agent has ever executed this step." .
    # calculated: calculated

effortless-ntwf:isUnexercisedHumanGate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnexercisedHumanGate" ;
    rdfs:comment "A human-only approval gate that no software agent has ever attempted — the control is asserted, not demonstrated." .
    # calculated: calculated

effortless-ntwf:isDemonstratedHumanGate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDemonstratedHumanGate" ;
    rdfs:comment "A human gate that software has actually reached and that a human nevertheless held." .
    # calculated: calculated

effortless-ntwf:unexercisedGateVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "UnexercisedGateVersionKey" ;
    rdfs:comment "Composite-key echo: this step's procedure version when the step is an unexercised human gate, blank otherwise." .
    # calculated: calculated

effortless-ntwf:hasDeclaredControlKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasDeclaredControlKind" ;
    rdfs:comment "Whether this step declares what kind of control it is." .
    # calculated: calculated

effortless-ntwf:undeclaredControlVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "UndeclaredControlVersionKey" ;
    rdfs:comment "Composite-key echo: this step's procedure version when the step has no declared control kind, blank otherwise." .
    # calculated: calculated

effortless-ntwf:approvalStepIsSoftwareAssigned a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:boolean ;
    rdfs:label "ApprovalStepIsSoftwareAssigned" ;
    rdfs:comment "An approval-kind step whose assigned role is currently held by an AI agent or automated pipeline." .
    # calculated: calculated

effortless-ntwf:unwitnessedBlockingCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Steps ;
    rdfs:range xsd:string ;
    rdfs:label "UnwitnessedBlockingCount" ;
    rdfs:comment "How many blocking controls bound to this step have no computed witness." .
    # calculated: aggregation

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact P-Plan class IRI." .

# === Class: StewardshipAssignments ===
effortless-ntwf:StewardshipAssignments a owl:Class ;
    rdfs:label "StewardshipAssignments" ;
    rdfs:comment "Separates ongoing stewardship from authority to approve semantic commitments. Explicit ERB-PKO governance extension." .

effortless-ntwf:stewardshipAssignmentId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StewardshipAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "StewardshipAssignmentId" ;
    rdfs:comment "Stored logical identifier for one StewardshipAssignments row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the StewardshipAssignments row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Governed procedure version." .

effortless-ntwf:stewardRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "StewardRole" ;
    rdfs:comment "Role responsible for health, review, and maintenance." .

effortless-ntwf:authorityRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "AuthorityRole" ;
    rdfs:comment "Role authorized to approve semantic changes." .

effortless-ntwf:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ValidFrom" ;
    rdfs:comment "Start of stewardship interval." .

effortless-ntwf:validTo a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ValidTo" ;
    rdfs:comment "End of stewardship interval." .

effortless-ntwf:reviewCadenceDays a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "ReviewCadenceDays" ;
    rdfs:comment "Required review cadence." .

effortless-ntwf:countOfReviewEvents a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfReviewEvents" ;
    rdfs:comment "How many review events have ever been recorded for the procedure version this assignment stewards." .
    # calculated: aggregation

effortless-ntwf:hasEverBeenReviewed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StewardshipAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasEverBeenReviewed" ;
    rdfs:comment "TRUE if at least one review event exists for the stewarded procedure version." .
    # calculated: calculated

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:isCurrentAssignment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StewardshipAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrentAssignment" ;
    rdfs:comment "TRUE when this stewardship assignment is in force right now." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: TemplateApprovals ===
effortless-ntwf:TemplateApprovals a owl:Class ;
    rdfs:label "TemplateApprovals" ;
    rdfs:comment "TemplateApprovals (added by witness loop 1)." .

effortless-ntwf:templateApprovalId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TemplateApprovals ;
    rdfs:range xsd:string ;
    rdfs:label "TemplateApprovalId" ;
    rdfs:comment "Stored logical identifier for one TemplateApprovals row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the TemplateApprovals row." .
    # calculated: calculated

effortless-ntwf:messageTemplate a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:MessageTemplates ;
    rdfs:label "MessageTemplate" ;
    rdfs:comment "Template this decision applies to." .

effortless-ntwf:decidedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:TemplateApprovals ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "DecidedByAgent" ;
    rdfs:comment "Agent who made the approval decision." .

effortless-ntwf:decidedInRole a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:TemplateApprovals ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "DecidedInRole" ;
    rdfs:comment "Role the agent was acting in when deciding." .

effortless-ntwf:decision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TemplateApprovals ;
    rdfs:range xsd:string ;
    rdfs:label "Decision" ;
    rdfs:comment "Approved, Rejected, or Withdrawn." .

effortless-ntwf:decidedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "DecidedAt" ;
    rdfs:comment "When the decision was recorded." .

effortless-ntwf:approvedBodyHash a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TemplateApprovals ;
    rdfs:range xsd:string ;
    rdfs:label "ApprovedBodyHash" ;
    rdfs:comment "Digest of the exact template body that was approved, so later edits are detectable." .

effortless-ntwf:notes a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Notes" ;
    rdfs:comment "Approver's rationale or conditions." .

effortless-ntwf:isApprovalDecision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TemplateApprovals ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApprovalDecision" ;
    rdfs:comment "TRUE when this decision row is an approval rather than a rejection or withdrawal." .
    # calculated: calculated

effortless-ntwf:templatePolicy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TemplateApprovals ;
    rdfs:range xsd:string ;
    rdfs:label "TemplatePolicy" ;
    rdfs:comment "The communication policy governing the template being approved." .
    # calculated: lookup

effortless-ntwf:requiredApprovalRole a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RequiredApprovalRole" ;
    rdfs:comment "The role the governing policy designates as approver -- communications-manager for both current policies." .
    # calculated: lookup

effortless-ntwf:isDecidedByRequiredRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TemplateApprovals ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDecidedByRequiredRole" ;
    rdfs:comment "TRUE when the approving role matches the role the policy designates." .
    # calculated: calculated

effortless-ntwf:validApprovalTemplateKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TemplateApprovals ;
    rdfs:range xsd:string ;
    rdfs:label "ValidApprovalTemplateKey" ;
    rdfs:comment "Carries the template id only on approvals made by the correct role; empty string otherwise." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension IRI; template approval events are not a PKO 2.0.0 native class." .

# === Class: TestCases ===
effortless-ntwf:TestCases a owl:Class ;
    rdfs:label "TestCases" ;
    rdfs:comment "The conformance suite, as data. One row per check, naming what it checks and — where applicable — the role question whose answer it defends. tools/run_test_suite.py executes these rows and writes the outcome back; it invents no checks of its own." .

effortless-ntwf:testCaseId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestCases ;
    rdfs:range xsd:string ;
    rdfs:label "TestCaseId" ;
    rdfs:comment "Stored logical identifier for one TestCases row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the TestCases row." .
    # calculated: calculated

effortless-ntwf:testKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestCases ;
    rdfs:range xsd:string ;
    rdfs:label "TestKind" ;
    rdfs:comment "What class of check this is. One of: structural (the rulebook's own shape), formula-translates (the transpiler emitted a real function, not a NULL stub), view-loads (the view exists and is queryable), fk-resolves (every FK value names a real row), witness-discriminates (a boolean witness can distinguish cases in this data), witness-fires (a specific witness reads TRUE on at least one row), provenance (every invented field traces to a question), catalog-sync (RulebookFields matches the real schemas), question-answered (a role question has at least one predicate answering it), invariant (a domain rule that must hold), remediation (a seeded violation was resolved in model rather than deleted)." .

effortless-ntwf:subject a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestCases ;
    rdfs:range xsd:string ;
    rdfs:label "Subject" ;
    rdfs:comment "What is under test — a Table.Field, a table, a view, or a question id." .

effortless-ntwf:targetTable a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "TargetTable" ;
    rdfs:comment "The table this check reads, when it reads one." .

effortless-ntwf:targetField a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "TargetField" ;
    rdfs:comment "The field this check reads, when it reads one." .

effortless-ntwf:assertion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestCases ;
    rdfs:range xsd:string ;
    rdfs:label "Assertion" ;
    rdfs:comment "What must be true, stated so a human can judge the verdict without reading code." .

effortless-ntwf:defendsQuestion a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:TestCases ;
    rdfs:range effortless-ntwf:RoleQuestions ;
    rdfs:label "DefendsQuestion" ;
    rdfs:comment "The role question whose answer this check protects. Null for checks that defend the model's structure rather than a specific question." .

effortless-ntwf:suite a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:TestCases ;
    rdfs:range effortless-ntwf:TestSuites ;
    rdfs:label "Suite" ;
    rdfs:comment "The suite this check belongs to." .

effortless-ntwf:severity a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Severity" ;
    rdfs:comment "blocking — a failure means the model is stating something false; advisory — a failure means the model cannot state something it should be able to. Vacuity is advisory by design: a witness that cannot fire on this seed is not necessarily wrong, and forcing it red would create pressure to fabricate data." .

effortless-ntwf:isBlocking a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBlocking" ;
    rdfs:comment "TRUE when a failure of this check means the model is asserting something false." .
    # calculated: calculated

effortless-ntwf:lastOutcome a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestCases ;
    rdfs:range xsd:string ;
    rdfs:label "LastOutcome" ;
    rdfs:comment "PASS, WARN, FAIL, or SKIP from the most recent run. Written by tools/run_test_suite.py from the substrate — never hand-edited." .

effortless-ntwf:lastDetail a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestCases ;
    rdfs:range xsd:string ;
    rdfs:label "LastDetail" ;
    rdfs:comment "The observed reading behind LastOutcome, e.g. a fire count or the error text." .

effortless-ntwf:lastRunAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastRunAt" ;
    rdfs:comment "When this check last ran." .

effortless-ntwf:isPassing a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPassing" ;
    rdfs:comment "TRUE when the last run passed outright." .
    # calculated: calculated

effortless-ntwf:isFailing a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestCases ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFailing" ;
    rdfs:comment "TRUE when the last run failed. A blocking failure means the model is asserting something false." .
    # calculated: calculated

effortless-ntwf:needsAttention a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestCases ;
    rdfs:range xsd:boolean ;
    rdfs:label "NeedsAttention" ;
    rdfs:comment "TRUE when this check failed and its failure means the model is wrong. This is the number that must be zero." .
    # calculated: calculated

effortless-ntwf:passingSuiteKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestCases ;
    rdfs:range xsd:string ;
    rdfs:label "PassingSuiteKey" ;
    rdfs:comment "Echoes the suite id only for checks that passed; empty otherwise. Single-criterion COUNTIFS key." .
    # calculated: calculated

effortless-ntwf:needsAttentionSuiteKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestCases ;
    rdfs:range xsd:string ;
    rdfs:label "NeedsAttentionSuiteKey" ;
    rdfs:comment "Echoes the suite id only for blocking checks that failed; empty otherwise. Single-criterion COUNTIFS key." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: TestSuites ===
effortless-ntwf:TestSuites a owl:Class ;
    rdfs:label "TestSuites" ;
    rdfs:comment "Groups of conformance checks. Rollups here are computed from TestCases, so the board's headline is itself a derived field." .

effortless-ntwf:testSuiteId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestSuites ;
    rdfs:range xsd:string ;
    rdfs:label "TestSuiteId" ;
    rdfs:comment "Stored logical identifier for one TestSuites row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the TestSuites row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Display name for this suite." .

effortless-ntwf:testCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestSuites ;
    rdfs:range xsd:string ;
    rdfs:label "TestCount" ;
    rdfs:comment "How many checks belong to this suite." .
    # calculated: aggregation

effortless-ntwf:passCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestSuites ;
    rdfs:range xsd:string ;
    rdfs:label "PassCount" ;
    rdfs:comment "How many checks passed on the last run." .
    # calculated: aggregation

effortless-ntwf:blockingFailCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestSuites ;
    rdfs:range xsd:string ;
    rdfs:label "BlockingFailCount" ;
    rdfs:comment "How many blocking checks failed. This is the number that must be zero for the board to be green." .
    # calculated: aggregation

effortless-ntwf:isGreen a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestSuites ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGreen" ;
    rdfs:comment "TRUE when no blocking check is failing. Advisory warnings do not break the board." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: Tools ===
effortless-ntwf:Tools a owl:Class ;
    rdfs:label "Tools" ;
    rdfs:comment "Tools required to execute steps. Maps to m4ing:Tool and pko:requiresTool." .

effortless-ntwf:toolId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Tools ;
    rdfs:range xsd:string ;
    rdfs:label "ToolId" ;
    rdfs:comment "Stored logical identifier for one Tools row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Tools row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Tool label." .

effortless-ntwf:purpose a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Purpose" ;
    rdfs:comment "Operational purpose." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact semantic class IRI." .

# === Class: UserFeedback ===
effortless-ntwf:UserFeedback a owl:Class ;
    rdfs:label "UserFeedback" ;
    rdfs:comment "Feedback supplied by users about a procedure or execution. Maps to pko:UserFeedbackOccurrence, feedbackOnProcedureExecution, and wasProvidedBy." .

effortless-ntwf:userFeedbackId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UserFeedback ;
    rdfs:range xsd:string ;
    rdfs:label "UserFeedbackId" ;
    rdfs:comment "Stored logical identifier for one UserFeedback row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the UserFeedback row." .
    # calculated: calculated

effortless-ntwf:procedureExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "ProcedureExecution" ;
    rdfs:comment "Execution receiving feedback." .

effortless-ntwf:providedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:UserFeedback ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ProvidedByAgent" ;
    rdfs:comment "Agent providing feedback." .

effortless-ntwf:providedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UserFeedback ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ProvidedAt" ;
    rdfs:comment "Feedback time." .

effortless-ntwf:feedbackText a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UserFeedback ;
    rdfs:range xsd:string ;
    rdfs:label "FeedbackText" ;
    rdfs:comment "Feedback statement." .

effortless-ntwf:disposition a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UserFeedback ;
    rdfs:range xsd:string ;
    rdfs:label "Disposition" ;
    rdfs:comment "Accepted, Rejected, UnderReview, or Deferred." .

effortless-ntwf:changeRequestKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UserFeedback ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeRequestKey" ;
    rdfs:comment "Related change request identifier." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: UserQuestions ===
effortless-ntwf:UserQuestions a owl:Class ;
    rdfs:label "UserQuestions" ;
    rdfs:comment "Questions asked by agents during execution. Maps to pko:UserQuestionOccurrence, questionByUser, wasAskedBy, and isQuestionAddressedBy." .

effortless-ntwf:userQuestionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UserQuestions ;
    rdfs:range xsd:string ;
    rdfs:label "UserQuestionId" ;
    rdfs:comment "Stored logical identifier for one UserQuestions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the UserQuestions row." .
    # calculated: calculated

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "Execution context for the question." .

effortless-ntwf:askedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:UserQuestions ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "AskedByAgent" ;
    rdfs:comment "Agent asking the question." .

effortless-ntwf:askedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UserQuestions ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AskedAt" ;
    rdfs:comment "Question time." .

effortless-ntwf:questionText a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "QuestionText" ;
    rdfs:comment "Question text; maps to pko:questionByUser." .

effortless-ntwf:resolvedByFaq a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:UserQuestions ;
    rdfs:range effortless-ntwf:FAQs ;
    rdfs:label "ResolvedByFaq" ;
    rdfs:comment "FAQ used to resolve the question." .

effortless-ntwf:addressedByResource a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:UserQuestions ;
    rdfs:range effortless-ntwf:Resources ;
    rdfs:label "AddressedByResource" ;
    rdfs:comment "Resource that addressed the question." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Open, Answered, Escalated, or Closed." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: VerificationOutcomes ===
effortless-ntwf:VerificationOutcomes a owl:Class ;
    rdfs:label "VerificationOutcomes" ;
    rdfs:comment "VerificationOutcomes (added by witness loop 1)." .

effortless-ntwf:verificationOutcomeId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:string ;
    rdfs:label "VerificationOutcomeId" ;
    rdfs:comment "Stored logical identifier for one VerificationOutcomes row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "The execution during which the verification was performed." .

effortless-ntwf:stepVerification a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range effortless-ntwf:StepVerifications ;
    rdfs:label "StepVerification" ;
    rdfs:comment "The declared verification being performed." .

effortless-ntwf:observedSignalValue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:string ;
    rdfs:label "ObservedSignalValue" ;
    rdfs:comment "The value the signal actually read at verification time." .

effortless-ntwf:observedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ObservedByAgent" ;
    rdfs:comment "Agent who observed the signal." .

effortless-ntwf:observedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ObservedAt" ;
    rdfs:comment "When the signal was observed." .

effortless-ntwf:evidenceUri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:string ;
    rdfs:label "EvidenceUri" ;
    rdfs:comment "Pointer to the retained artifact backing the observation." .

effortless-ntwf:expectedSignalValue a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ExpectedSignalValue" ;
    rdfs:comment "The value the specification expects." .
    # calculated: lookup

effortless-ntwf:signalIdentifier a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SignalIdentifier" ;
    rdfs:comment "Which signal this outcome concerns." .
    # calculated: lookup

effortless-ntwf:signalMatchesExpected a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:boolean ;
    rdfs:label "SignalMatchesExpected" ;
    rdfs:comment "TRUE when the observed value equals the expected value." .
    # calculated: calculated

effortless-ntwf:hasEvidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasEvidence" ;
    rdfs:comment "TRUE when a retained artifact backs this observation." .
    # calculated: calculated

effortless-ntwf:isUnbackedObservation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnbackedObservation" ;
    rdfs:comment "TRUE when a verification was recorded as matching but no evidence artifact was retained." .
    # calculated: calculated

effortless-ntwf:isSelfWitnessed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSelfWitnessed" ;
    rdfs:comment "TRUE when the agent who observed the verification signal is the same agent who executed the step being verified." .
    # calculated: calculated

effortless-ntwf:stepExecutorAgent a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "StepExecutorAgent" ;
    rdfs:comment "The agent who executed the step this verification outcome concerns." .
    # calculated: lookup

effortless-ntwf:selfWitnessedStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:string ;
    rdfs:label "SelfWitnessedStepKey" ;
    rdfs:comment "Echoes the StepExecution id only for self-witnessed verifications." .
    # calculated: calculated

effortless-ntwf:unbackedStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:string ;
    rdfs:label "UnbackedStepKey" ;
    rdfs:comment "Echoes the StepExecution id when a verification matched but retained no evidence." .
    # calculated: calculated

effortless-ntwf:isSelfWitnessedAndUnbacked a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSelfWitnessedAndUnbacked" ;
    rdfs:comment "TRUE when the executor observed their own passing signal and attached no evidence." .
    # calculated: calculated

effortless-ntwf:isUncorroboratedPass a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUncorroboratedPass" ;
    rdfs:comment "TRUE when a PASSING signal was self-observed with no evidence behind it." .
    # calculated: calculated

effortless-ntwf:uncorroboratedPassStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:string ;
    rdfs:label "UncorroboratedPassStepKey" ;
    rdfs:comment "Echoes the step execution id when this outcome is an uncorroborated pass." .
    # calculated: calculated

effortless-ntwf:observerIsNonHuman a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:boolean ;
    rdfs:label "ObserverIsNonHuman" ;
    rdfs:comment "Whether the agent who recorded this observation is non-human. Agents has no PrimaryRole column and an FK from Agents back to Roles would create a table cycle, so the independence question is answered by agent kind rather than by role." .
    # calculated: lookup

effortless-ntwf:observerIsIndependentOfExecutor a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:boolean ;
    rdfs:label "ObserverIsIndependentOfExecutor" ;
    rdfs:comment "TRUE when someone other than the step's executor recorded the observation." .
    # calculated: calculated

effortless-ntwf:isIndependentHumanObservation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsIndependentHumanObservation" ;
    rdfs:comment "TRUE when a human other than the step's executor observed this signal and attached evidence." .
    # calculated: calculated

effortless-ntwf:independentObservationExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:string ;
    rdfs:label "IndependentObservationExecutionKey" ;
    rdfs:comment "Echoes the parent execution id when this is an independent human observation." .
    # calculated: calculated

effortless-ntwf:parentProcedureExecutionOfOutcome a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VerificationOutcomes ;
    rdfs:range xsd:string ;
    rdfs:label "ParentProcedureExecutionOfOutcome" ;
    rdfs:comment "The procedure execution this verification outcome belongs to." .
    # calculated: lookup

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension IRI — PKO 2.0.0 has no execution-side verification outcome class." .

# === Class: Vocabularies ===
effortless-ntwf:Vocabularies a owl:Class ;
    rdfs:label "Vocabularies" ;
    rdfs:comment "A controlled vocabulary / SKOS-style concept scheme — one facet of standardized terminology (e.g. a family of control categories) that Requirements and other rows can point at instead of restating the concept in free text each time." .

effortless-ntwf:vocabularyId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Vocabularies ;
    rdfs:range xsd:string ;
    rdfs:label "VocabularyId" ;
    rdfs:comment "Stored logical identifier for one Vocabularies row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Vocabularies row." .
    # calculated: calculated

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Human-facing name of this controlled vocabulary." .

effortless-ntwf:schemeUri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Vocabularies ;
    rdfs:range xsd:string ;
    rdfs:label "SchemeUri" ;
    rdfs:comment "SKOS ConceptScheme IRI for this vocabulary." .

effortless-ntwf:governingRole a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Vocabularies ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "GoverningRole" ;
    rdfs:comment "Role accountable for defining and maintaining terms in this vocabulary." .

effortless-ntwf:termCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Vocabularies ;
    rdfs:range xsd:string ;
    rdfs:label "TermCount" ;
    rdfs:comment "How many terms belong to this vocabulary." .
    # calculated: aggregation

effortless-ntwf:orphanTermCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Vocabularies ;
    rdfs:range xsd:string ;
    rdfs:label "OrphanTermCount" ;
    rdfs:comment "How many terms in this vocabulary have never actually been used." .
    # calculated: aggregation

effortless-ntwf:hasOrphanTerms a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Vocabularies ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOrphanTerms" ;
    rdfs:comment "TRUE when this vocabulary has at least one defined-but-unused term." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: VocabularyTerms ===
effortless-ntwf:VocabularyTerms a owl:Class ;
    rdfs:label "VocabularyTerms" ;
    rdfs:comment "One controlled, defined term (a SKOS Concept) within a Vocabulary. Requirements point at a VocabularyTerm instead of free-texting the same concept in a new Statement every time." .

effortless-ntwf:vocabularyTermId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VocabularyTerms ;
    rdfs:range xsd:string ;
    rdfs:label "VocabularyTermId" ;
    rdfs:comment "Stored logical identifier for one VocabularyTerms row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the VocabularyTerms row." .
    # calculated: calculated

effortless-ntwf:vocabulary a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:VocabularyTerms ;
    rdfs:range effortless-ntwf:Vocabularies ;
    rdfs:label "Vocabulary" ;
    rdfs:comment "Vocabulary this term belongs to." .

effortless-ntwf:prefLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VocabularyTerms ;
    rdfs:range xsd:string ;
    rdfs:label "PrefLabel" ;
    rdfs:comment "SKOS preferred label — the controlled term itself." .

effortless-ntwf:altLabels a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VocabularyTerms ;
    rdfs:range xsd:string ;
    rdfs:label "AltLabels" ;
    rdfs:comment "Comma-separated synonyms this term should also match." .

effortless-ntwf:definition a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Definition" ;
    rdfs:comment "SKOS definition of what this term means." .

effortless-ntwf:usageCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "UsageCount" ;
    rdfs:comment "How many Requirements point at this exact term instead of free-texting the concept." .
    # calculated: aggregation

effortless-ntwf:isOrphanTerm a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VocabularyTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOrphanTerm" ;
    rdfs:comment "TRUE when this term has been defined but nothing in the model actually uses it yet." .
    # calculated: calculated

effortless-ntwf:isWidelyAdoptedTerm a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VocabularyTerms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWidelyAdoptedTerm" ;
    rdfs:comment "TRUE when more than one Requirement shares this exact controlled term." .
    # calculated: calculated

effortless-ntwf:orphanTermVocabularyKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VocabularyTerms ;
    rdfs:range xsd:string ;
    rdfs:label "OrphanTermVocabularyKey" ;
    rdfs:comment "Composite-key echo: this term's vocabulary when the term is an orphan, else blank." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: WitnessLoops ===
effortless-ntwf:WitnessLoops a owl:Class ;
    rdfs:label "WitnessLoops" ;
    rdfs:comment "One row per role-question expansion loop. Each loop poses questions that only became askable because of the previous loop's predicates." .

effortless-ntwf:witnessLoopId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:WitnessLoops ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessLoopId" ;
    rdfs:comment "Stored logical identifier for one WitnessLoops row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the WitnessLoops row." .
    # calculated: calculated

effortless-ntwf:loopNumber a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:WitnessLoops ;
    rdfs:range xsd:string ;
    rdfs:label "LoopNumber" ;
    rdfs:comment "Ordinal of this expansion loop. Loop 1 is the founding set of role questions." .

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Short title for what this loop set out to make askable." .

effortless-ntwf:premise a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:WitnessLoops ;
    rdfs:range xsd:string ;
    rdfs:label "Premise" ;
    rdfs:comment "Why this loop's questions became askable. For loop N>1 this names the loop N-1 predicates that made them possible." .

effortless-ntwf:startedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "StartedAt" ;
    rdfs:comment "Time this loop began." .

effortless-ntwf:completedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:WitnessLoops ;
    rdfs:range xsd:dateTime ;
    rdfs:label "CompletedAt" ;
    rdfs:comment "Time this loop was committed. Null while in progress." .

effortless-ntwf:questionCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "QuestionCount" ;
    rdfs:comment "How many role questions were posed in this loop." .
    # calculated: aggregation

effortless-ntwf:isComplete a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:WitnessLoops ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsComplete" ;
    rdfs:comment "TRUE once the loop has been committed." .
    # calculated: calculated

effortless-ntwf:fieldsAfter a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:WitnessLoops ;
    rdfs:range xsd:string ;
    rdfs:label "FieldsAfter" ;
    rdfs:comment "Total fields in the rulebook after this loop completed." .

effortless-ntwf:derivedAfter a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:WitnessLoops ;
    rdfs:range xsd:string ;
    rdfs:label "DerivedAfter" ;
    rdfs:comment "Derived fields after this loop completed." .

effortless-ntwf:witnessedAfter a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:WitnessLoops ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessedAfter" ;
    rdfs:comment "Fields invented for a role question after this loop completed." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .
