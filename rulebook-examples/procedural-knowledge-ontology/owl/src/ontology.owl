effortless-ntwf:genuinelyOverdueFragmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "GenuinelyOverdueFragmentCount" ;
    rdfs:comment "How many of this version's claims are overdue by actual review record rather than by inference." .
