@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix effortless-ntwf: <https://w3id.org/effortless-ntwf#> .

<https://w3id.org/effortless-ntwf#> a owl:Ontology ;
    rdfs:label "NTWF Ontology (Effortless rendering)" ;
    rdfs:comment "Generated by Effortless from procedural-knowledge-ontology-rulebook.json. Vocabulary: Jessica Talisman NTWF." .

# === Class: AccessDenialTests ===
effortless-ntwf:AccessDenialTests a owl:Class ;
    rdfs:label "AccessDenialTests" ;
    rdfs:comment "Denial witnesses. A policy with no failing case seeded against it is an assertion, not evidence -- the same acceptance bar the rest of this rulebook holds. Each row names a principal, a query, and the row that MUST NOT come back, so a policy that silently stops enforcing is caught by a red test rather than by an incident." .

effortless-ntwf:accessDenialTestId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessDenialTests ;
    rdfs:range xsd:string ;
    rdfs:label "AccessDenialTestId" ;
    rdfs:comment "Stored logical identifier, e.g. 'deny-analyst-other-org-procedures'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:targetPolicy a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AccessDenialTests ;
    rdfs:range effortless-ntwf:AccessPolicies ;
    rdfs:label "TargetPolicy" ;
    rdfs:comment "Policy this test exercises." .

effortless-ntwf:principal a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:AccessPrincipals ;
    rdfs:label "Principal" ;
    rdfs:comment "Principal the query runs as." .

effortless-ntwf:targetTable a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RulebookTables ;
    rdfs:label "TargetTable" ;
    rdfs:comment "Table queried." .

effortless-ntwf:forbiddenRowId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessDenialTests ;
    rdfs:range xsd:string ;
    rdfs:label "ForbiddenRowId" ;
    rdfs:comment "Primary key of the row that must be invisible to this principal." .

effortless-ntwf:expectedVisible a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessDenialTests ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExpectedVisible" ;
    rdfs:comment "False for a denial test: the row must not appear. True asserts a row the principal is entitled to does appear." .

effortless-ntwf:observedVisible a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessDenialTests ;
    rdfs:range xsd:boolean ;
    rdfs:label "ObservedVisible" ;
    rdfs:comment "What the substrate actually returned on the last run. Written back by the verifier, never hand-set." .

effortless-ntwf:lastRunAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastRunAt" ;
    rdfs:comment "When this test was last executed against Postgres." .

effortless-ntwf:hasRun a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessDenialTests ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRun" ;
    rdfs:comment "True once the test has been executed at least once." .
    # calculated: calculated

effortless-ntwf:isPassing a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPassing" ;
    rdfs:comment "True when observed visibility matches expectation." .
    # calculated: calculated

effortless-ntwf:isLeak a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessDenialTests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLeak" ;
    rdfs:comment "True when a row that must be invisible was returned. A confirmed access-control breach." .
    # calculated: calculated

effortless-ntwf:isUnproven a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessDenialTests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnproven" ;
    rdfs:comment "True when the test has never run, so it proves nothing regardless of how it is written." .
    # calculated: calculated

effortless-ntwf:rationale a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Rationale" ;
    rdfs:comment "Why this row must (or must not) be visible, and which predicate it exercises." .

effortless-ntwf:isPositiveControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessDenialTests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPositiveControl" ;
    rdfs:comment "True when this test asserts a row the principal IS entitled to. A denial suite with no positive controls cannot distinguish a working policy from one that denies everything." .
    # calculated: calculated

effortless-ntwf:forbiddenTable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessDenialTests ;
    rdfs:range xsd:string ;
    rdfs:label "ForbiddenTable" ;
    rdfs:comment "For a table-absence witness: the table that must NOT exist in this principal's schema. Selecting it must raise 'relation does not exist', not return zero rows." .

effortless-ntwf:forbiddenColumn a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessDenialTests ;
    rdfs:range xsd:string ;
    rdfs:label "ForbiddenColumn" ;
    rdfs:comment "For a column-absence witness: the column that must NOT exist in this principal's view. Selecting it must raise 'column does not exist', not return null." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: AccessPolicies ===
effortless-ntwf:AccessPolicies a owl:Class ;
    rdfs:label "AccessPolicies" ;
    rdfs:comment "Row-level security policies: the VERTICAL cut. One row per principal x table x command, carrying the predicate that decides which rows are visible. RowPredicate is emitted verbatim into a Postgres USING clause, so it may call any SECURITY DEFINER calc_* function and therefore reference inference fields many hops down the DAG." .

effortless-ntwf:accessPolicyId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "AccessPolicyId" ;
    rdfs:comment "Stored logical identifier, e.g. 'pol-controller-procedures-select'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:principal a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:AccessPrincipals ;
    rdfs:label "Principal" ;
    rdfs:comment "Principal this policy grants to." .

effortless-ntwf:targetTable a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RulebookTables ;
    rdfs:label "TargetTable" ;
    rdfs:comment "Rulebook table this policy guards." .

effortless-ntwf:command a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "Command" ;
    rdfs:comment "SQL command the policy governs: SELECT, INSERT, UPDATE, DELETE or ALL." .

effortless-ntwf:rowPredicate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "RowPredicate" ;
    rdfs:comment "SQL boolean expression emitted into USING(...). Empty means all rows of the table. Must not sub-select the guarded table -- Postgres raises infinite recursion; route such predicates through a SECURITY DEFINER function instead." .

effortless-ntwf:checkPredicate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "CheckPredicate" ;
    rdfs:comment "SQL boolean expression emitted into WITH CHECK(...) for write commands. Empty reuses RowPredicate." .

effortless-ntwf:rationale a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Rationale" ;
    rdfs:comment "Why this principal is entitled to these rows, in the granting authority's words." .

effortless-ntwf:referencesInference a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPolicies ;
    rdfs:range xsd:boolean ;
    rdfs:label "ReferencesInference" ;
    rdfs:comment "True when RowPredicate calls a calc_* function, i.e. the cut depends on a derived field rather than a stored column." .

effortless-ntwf:isWriteCommand a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPolicies ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWriteCommand" ;
    rdfs:comment "True when this policy governs a mutating command." .
    # calculated: calculated

effortless-ntwf:isUnrestricted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPolicies ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnrestricted" ;
    rdfs:comment "True when the policy carries no predicate, exposing every row of the target table to the principal." .
    # calculated: calculated

effortless-ntwf:principalIsAdmin a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "PrincipalIsAdmin" ;
    rdfs:comment "Whether the granted principal is an administrator." .
    # calculated: lookup

effortless-ntwf:isUnrestrictedNonAdminGrant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPolicies ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnrestrictedNonAdminGrant" ;
    rdfs:comment "True when a non-administrator principal is granted an unrestricted policy -- a whole-table exposure that no row predicate narrows. The single highest-signal privilege-escalation witness in the model." .
    # calculated: calculated

effortless-ntwf:isUnwitnessedWrite a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPolicies ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwitnessedWrite" ;
    rdfs:comment "True when a write policy has no denial test proving it refuses out-of-scope rows. An untested write grant is an assertion, not evidence." .
    # calculated: calculated

effortless-ntwf:denialTestCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "DenialTestCount" ;
    rdfs:comment "Number of denial tests seeded against this policy." .
    # calculated: aggregation

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: AccessPrincipals ===
effortless-ntwf:AccessPrincipals a owl:Class ;
    rdfs:label "AccessPrincipals" ;
    rdfs:comment "Security principals -- the identities policies attach to. A principal is the console persona a person logs in as; it maps many-to-one onto a domain Role, so 'who may see this row' is expressed once against the domain vocabulary while the UI keeps its own persona names. Each principal owns exactly one Postgres role and one Postgres schema." .

effortless-ntwf:accessPrincipalId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPrincipals ;
    rdfs:range xsd:string ;
    rdfs:label "AccessPrincipalId" ;
    rdfs:comment "Stored logical identifier, e.g. 'principal-controller'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Display label shown in the console role picker." .

effortless-ntwf:domainRole a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AccessPrincipals ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "DomainRole" ;
    rdfs:comment "Domain role whose authority this principal exercises." .

effortless-ntwf:pgRoleName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPrincipals ;
    rdfs:range xsd:string ;
    rdfs:label "PgRoleName" ;
    rdfs:comment "Postgres role name this principal authenticates as, e.g. 'pko_controller'." .

effortless-ntwf:schemaName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SchemaName" ;
    rdfs:comment "Postgres schema that is this principal's entire visible world, e.g. 'pko_controller'." .

effortless-ntwf:isAdministrator a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPrincipals ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAdministrator" ;
    rdfs:comment "True when this principal may read every table and edit access policy." .

effortless-ntwf:organizationScope a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPrincipals ;
    rdfs:range xsd:string ;
    rdfs:label "OrganizationScope" ;
    rdfs:comment "Organization inherited from the domain role; the default tenancy boundary for row predicates." .
    # calculated: lookup

effortless-ntwf:roleLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPrincipals ;
    rdfs:range xsd:string ;
    rdfs:label "RoleLabel" ;
    rdfs:comment "Label of the domain role, for display." .
    # calculated: lookup

effortless-ntwf:policyCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "PolicyCount" ;
    rdfs:comment "Number of row policies granted to this principal." .
    # calculated: aggregation

effortless-ntwf:grantCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPrincipals ;
    rdfs:range xsd:string ;
    rdfs:label "GrantCount" ;
    rdfs:comment "Number of field grants held by this principal." .
    # calculated: aggregation

effortless-ntwf:visibleTableCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPrincipals ;
    rdfs:range xsd:string ;
    rdfs:label "VisibleTableCount" ;
    rdfs:comment "Number of tables exposed in this principal's schema." .
    # calculated: aggregation

effortless-ntwf:hasNoAccess a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPrincipals ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoAccess" ;
    rdfs:comment "True when the principal holds no policies at all, so its schema is empty and it can read nothing. Fail-closed by construction." .
    # calculated: calculated

effortless-ntwf:isOverPrivileged a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AccessPrincipals ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverPrivileged" ;
    rdfs:comment "True when a non-administrator principal can reach every table in the rulebook -- an admin-equivalent principal that was never declared as one." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: Actions ===
effortless-ntwf:Actions a owl:Class ;
    rdfs:label "Actions" ;
    rdfs:comment "Human actions required by steps. Maps to pko:Action and pko:requiresAction." .

effortless-ntwf:actionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Actions ;
    rdfs:range xsd:string ;
    rdfs:label "ActionId" ;
    rdfs:comment "Stored logical identifier for one Actions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Actions row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Action label." .

effortless-ntwf:definition a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Definition" ;
    rdfs:comment "Normative definition of the action." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: AgentDecisionRecords ===
effortless-ntwf:AgentDecisionRecords a owl:Class ;
    rdfs:label "AgentDecisionRecords" ;
    rdfs:comment "AgentDecisionRecords (added by witness loop 1)." .

effortless-ntwf:agentDecisionRecordId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "AgentDecisionRecordId" ;
    rdfs:comment "Stored logical identifier for one AgentDecisionRecords row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AgentDecisionRecords row." .
    # calculated: calculated

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "Step execution during which the decision was made." .

effortless-ntwf:decidingAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "DecidingAgent" ;
    rdfs:comment "Agent that made the decision." .

effortless-ntwf:decisionKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "DecisionKind" ;
    rdfs:comment "Classification, Prioritization, Draft, Suppression, Escalation, or Posting." .

effortless-ntwf:decisionSummary a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "DecisionSummary" ;
    rdfs:comment "What the agent decided, in one sentence." .

effortless-ntwf:decidedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "DecidedAt" ;
    rdfs:comment "When the decision was made." .

effortless-ntwf:materialityBand a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "MaterialityBand" ;
    rdfs:comment "BelowThreshold, Material, or Escalated." .

effortless-ntwf:humanDisposition a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "HumanDisposition" ;
    rdfs:comment "Accepted, Corrected, Reversed, or NotReviewed." .

effortless-ntwf:reviewedByAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ReviewedByAgent" ;
    rdfs:comment "Human agent that dispositioned the decision." .

effortless-ntwf:reviewedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ReviewedAt" ;
    rdfs:comment "When a human dispositioned the decision." .

effortless-ntwf:wasOverridden a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasOverridden" ;
    rdfs:comment "TRUE when a human corrected or reversed this decision." .
    # calculated: calculated

effortless-ntwf:wasReviewed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasReviewed" ;
    rdfs:comment "TRUE when a human actually dispositioned this decision." .
    # calculated: calculated

effortless-ntwf:decidingAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "DecidingAgentKind" ;
    rdfs:comment "Whether the deciding agent is Human, AIAgent, or AutomatedPipeline." .
    # calculated: lookup

effortless-ntwf:decidingAgentWhenOverridden a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "DecidingAgentWhenOverridden" ;
    rdfs:comment "Echoes the deciding agent id when the decision was overridden, blank otherwise." .
    # calculated: calculated

effortless-ntwf:underRoleAssignment a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range effortless-ntwf:RoleAssignments ;
    rdfs:label "UnderRoleAssignment" ;
    rdfs:comment "Role assignment in force when the decision was made; anchors the decision to one side of a handover." .

effortless-ntwf:roleAssignmentWhenScored a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "RoleAssignmentWhenScored" ;
    rdfs:comment "Echoes the governing role assignment when one is recorded, blank otherwise." .
    # calculated: calculated

effortless-ntwf:roleAssignmentWhenOverridden a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "RoleAssignmentWhenOverridden" ;
    rdfs:comment "Echoes the governing role assignment when the decision was overridden, blank otherwise." .
    # calculated: calculated

effortless-ntwf:stepOfDecision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "StepOfDecision" ;
    rdfs:comment "The specified step at which this decision was made." .
    # calculated: lookup

effortless-ntwf:boundaryMatchKey a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "BoundaryMatchKey" ;
    rdfs:comment "Composite key of step, deciding agent kind, and decision kind for this decision." .
    # calculated: calculated

effortless-ntwf:matchingBoundaryCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "MatchingBoundaryCount" ;
    rdfs:comment "Number of authority boundaries this decision matches." .
    # calculated: aggregation

effortless-ntwf:violatedAuthorityBoundary a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "ViolatedAuthorityBoundary" ;
    rdfs:comment "TRUE when this decision matches an authority boundary that forbids it." .
    # calculated: calculated

effortless-ntwf:reviewerAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "ReviewerAgentKind" ;
    rdfs:comment "Agent kind of the reviewer, if any." .
    # calculated: lookup

effortless-ntwf:hasHumanConfirmation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasHumanConfirmation" ;
    rdfs:comment "TRUE when a human agent actually dispositioned this decision." .
    # calculated: calculated

effortless-ntwf:needsHumanConfirmation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "NeedsHumanConfirmation" ;
    rdfs:comment "TRUE when a non-human agent made a material or escalated decision." .
    # calculated: calculated

effortless-ntwf:isUnconfirmedNonHumanDecision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnconfirmedNonHumanDecision" ;
    rdfs:comment "TRUE when a material non-human decision was never confirmed by a human." .
    # calculated: calculated

effortless-ntwf:stepExecutionWhenUnconfirmed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "StepExecutionWhenUnconfirmed" ;
    rdfs:comment "Echoes the step-execution id when the decision is an unconfirmed non-human material decision, blank otherwise." .
    # calculated: calculated

effortless-ntwf:agentWhenBoundaryViolated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "AgentWhenBoundaryViolated" ;
    rdfs:comment "Echoes the deciding agent id when the decision violated a boundary, blank otherwise." .
    # calculated: calculated

effortless-ntwf:reviewLatencyMinutes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "ReviewLatencyMinutes" ;
    rdfs:comment "Minutes between the decision and its human disposition; 0 when never reviewed. Declared number, not integer: DATETIME_DIFF returns a numeric and an integer cast makes the entire view fail on read." .
    # calculated: calculated

effortless-ntwf:isDraftKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDraftKind" ;
    rdfs:comment "TRUE when this decision produced text — the drafter's own output class." .
    # calculated: calculated

effortless-ntwf:agentWhenDraftOverridden a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "AgentWhenDraftOverridden" ;
    rdfs:comment "Echoes the deciding agent id when a drafting decision was overridden, blank otherwise." .
    # calculated: calculated

effortless-ntwf:agentWhenDraft a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "AgentWhenDraft" ;
    rdfs:comment "Echoes the deciding agent id when the decision produced text, blank otherwise." .
    # calculated: calculated

effortless-ntwf:overrideReasonKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "OverrideReasonKind" ;
    rdfs:comment "Why the human changed my output: ErrorCorrection, JudgmentReserved, PolicyChange, or empty when not overridden." .

effortless-ntwf:isErrorCorrection a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsErrorCorrection" ;
    rdfs:comment "TRUE when the override corrected something I got wrong." .
    # calculated: calculated

effortless-ntwf:isReservedJudgmentOverride a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReservedJudgmentOverride" ;
    rdfs:comment "TRUE when the override was a human exercising authority the procedure always reserved to them." .
    # calculated: calculated

effortless-ntwf:overrideReasonIsRecorded a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "OverrideReasonIsRecorded" ;
    rdfs:comment "TRUE when an override carries a stated reason." .
    # calculated: calculated

effortless-ntwf:isUnexplainedOverride a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnexplainedOverride" ;
    rdfs:comment "TRUE when my output was changed and nobody recorded why." .
    # calculated: calculated

effortless-ntwf:errorCorrectionRoleAssignmentKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "ErrorCorrectionRoleAssignmentKey" ;
    rdfs:comment "The role assignment id when this decision was overridden as an error correction, otherwise empty." .
    # calculated: calculated

effortless-ntwf:boundaryViolationRoleAssignmentKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AgentDecisionRecords ;
    rdfs:range xsd:string ;
    rdfs:label "BoundaryViolationRoleAssignmentKey" ;
    rdfs:comment "Echoes the role assignment this decision was made under, but only when the decision violated an authority boundary. Empty otherwise." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI for an agent decision record." .

# === Class: Agents ===
effortless-ntwf:Agents a owl:Class ;
    rdfs:label "Agents" ;
    rdfs:comment "Human and software agents that create, modify, approve, or execute procedural knowledge. Maps to prov:Agent." .

effortless-ntwf:agentId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "AgentId" ;
    rdfs:comment "Stored logical identifier for one Agents row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Agents row." .
    # calculated: calculated

effortless-ntwf:displayName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DisplayName" ;
    rdfs:comment "Agent's human-readable name." .

effortless-ntwf:agentKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AgentKind" ;
    rdfs:comment "Human, AIAgent, AutomatedPipeline, Organization, or another explicit agent category." .

effortless-ntwf:organization a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "Organization" ;
    rdfs:comment "Organization to which the agent belongs." .

effortless-ntwf:contactAddress a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "ContactAddress" ;
    rdfs:comment "Contact address when applicable." .

effortless-ntwf:versionOrEmploymentKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "VersionOrEmploymentKey" ;
    rdfs:comment "Model version, pipeline release, or employment assignment key." .

effortless-ntwf:countOfCurrentRoleAssignments a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfCurrentRoleAssignments" ;
    rdfs:comment "How many role assignments this agent currently holds. Counts only CURRENT assignments via the CurrentAgentKey echo — counting all assignments would report a departed agent as engaged forever." .
    # calculated: aggregation

effortless-ntwf:isStillEngaged a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStillEngaged" ;
    rdfs:comment "TRUE when this agent currently holds at least one role in the organization." .
    # calculated: calculated

effortless-ntwf:decisionCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DecisionCount" ;
    rdfs:comment "Total decisions this agent has recorded." .
    # calculated: aggregation

effortless-ntwf:overriddenDecisionCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OverriddenDecisionCount" ;
    rdfs:comment "Decisions by this agent that a human corrected or reversed." .
    # calculated: aggregation

effortless-ntwf:overrideRatePercent a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OverrideRatePercent" ;
    rdfs:comment "Percentage of this agent's decisions that were overridden by a human." .
    # calculated: calculated

effortless-ntwf:isNonHuman a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonHuman" ;
    rdfs:comment "TRUE when this agent is an AI agent or an automated pipeline." .
    # calculated: calculated

effortless-ntwf:boundaryViolationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "BoundaryViolationCount" ;
    rdfs:comment "Number of decisions by this agent that violated an authority boundary." .
    # calculated: aggregation

effortless-ntwf:isOperatingOutsideBoundary a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOperatingOutsideBoundary" ;
    rdfs:comment "TRUE when this agent has made at least one decision an authority boundary forbids." .
    # calculated: calculated

effortless-ntwf:draftDecisionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "DraftDecisionCount" ;
    rdfs:comment "Number of drafting decisions this agent has made." .
    # calculated: aggregation

effortless-ntwf:overriddenDraftCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "OverriddenDraftCount" ;
    rdfs:comment "Number of this agent's drafting decisions a human corrected or reversed." .
    # calculated: aggregation

effortless-ntwf:draftRewriteRatePercent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "DraftRewriteRatePercent" ;
    rdfs:comment "Percentage of this agent's drafting output that a human rewrote." .
    # calculated: calculated

effortless-ntwf:timesNamedAsBroker a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "TimesNamedAsBroker" ;
    rdfs:comment "How many active informal-reliance links name this agent as the one actually consulted." .
    # calculated: aggregation

effortless-ntwf:isRecognizedBroker a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRecognizedBroker" ;
    rdfs:comment "TRUE when at least three people actively rely on this agent as an informal knowledge broker." .
    # calculated: calculated

effortless-ntwf:atRiskRelianceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:string ;
    rdfs:label "AtRiskRelianceCount" ;
    rdfs:comment "How many active informal-reliance links name this agent while this agent holds no current role." .
    # calculated: aggregation

effortless-ntwf:hasAtRiskKnowledgeReliance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Agents ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasAtRiskKnowledgeReliance" ;
    rdfs:comment "TRUE when people are actively relying on this agent even though they have already left every role." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact semantic type IRI used when projecting the agent." .

# === Class: AppNavGroups ===
effortless-ntwf:AppNavGroups a owl:Class ;
    rdfs:label "AppNavGroups" ;
    rdfs:comment "The left-navigation section headers. A route names the group it appears under; the nav renders the groups its active role actually uses." .

effortless-ntwf:appNavGroupId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppNavGroups ;
    rdfs:range xsd:string ;
    rdfs:label "AppNavGroupId" ;
    rdfs:comment "Stored logical identifier for one AppNavGroups row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AppNavGroups row." .
    # calculated: calculated

effortless-ntwf:groupLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppNavGroups ;
    rdfs:range xsd:string ;
    rdfs:label "GroupLabel" ;
    rdfs:comment "Section header text rendered in the left navigation." .

effortless-ntwf:routeCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RouteCount" ;
    rdfs:comment "How many routes sit under this nav group across all roles." .
    # calculated: aggregation

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI for this row. An extension: PKO does not model navigation." .

# === Class: AppRoleProfiles ===
effortless-ntwf:AppRoleProfiles a owl:Class ;
    rdfs:label "AppRoleProfiles" ;
    rdfs:comment "One row per role, carrying how that role is presented: its accent colour, its 128x128 icon, and the login-card copy. Presentation is data, so the app never hardcodes a colour or a label per role." .

effortless-ntwf:appRoleProfileId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "AppRoleProfileId" ;
    rdfs:comment "Stored logical identifier for one AppRoleProfiles row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AppRoleProfiles row." .
    # calculated: calculated

effortless-ntwf:role a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "Role" ;
    rdfs:comment "The role this presentation profile describes." .

effortless-ntwf:displayLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "DisplayLabel" ;
    rdfs:comment "Label shown on the login card and in the app chrome." .

effortless-ntwf:roleKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "RoleKind" ;
    rdfs:comment "human or software. Drives the login-card silhouette and the icon plate shape." .

effortless-ntwf:accentColor a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "AccentColor" ;
    rdfs:comment "Hex accent colour. Distinctive per role; used for chrome, the left-nav active state, and the icon plate." .

effortless-ntwf:iconMark a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "IconMark" ;
    rdfs:comment "Name of the geometric mark drawn on this role's icon. Colour is never the only signal — the mark discriminates in greyscale." .

effortless-ntwf:iconPngBase64 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "IconPngBase64" ;
    rdfs:comment "128x128 PNG icon for this role, base64-encoded, no data: prefix. Rendered on the login card and beside the role name throughout the app." .

effortless-ntwf:pitch a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "Pitch" ;
    rdfs:comment "One line of login-card copy: what this role opens the app to do, in that role's own terms." .

effortless-ntwf:sortOrder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoleProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "SortOrder" ;
    rdfs:comment "Display order on the login screen. Human roles first, then software roles." .

effortless-ntwf:routeCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RouteCount" ;
    rdfs:comment "How many routes this role has." .
    # calculated: aggregation

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI for this row. An extension: PKO does not model application presentation." .

# === Class: AppRouteQuestions ===
effortless-ntwf:AppRouteQuestions a owl:Class ;
    rdfs:label "AppRouteQuestions" ;
    rdfs:comment "Junction: which RoleQuestions each route helps answer. Deliberately many-to-many — a question is answered across several routes and a route serves several questions. It is not, and should not become, 1:1." .

effortless-ntwf:appRouteQuestionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRouteQuestions ;
    rdfs:range xsd:string ;
    rdfs:label "AppRouteQuestionId" ;
    rdfs:comment "Stored logical identifier for one AppRouteQuestions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AppRouteQuestions row." .
    # calculated: calculated

effortless-ntwf:route a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AppRouteQuestions ;
    rdfs:range effortless-ntwf:AppRoutes ;
    rdfs:label "Route" ;
    rdfs:comment "The route that helps answer the question." .

effortless-ntwf:question a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RoleQuestions ;
    rdfs:label "Question" ;
    rdfs:comment "The role question this route helps answer." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI for this row. An extension." .

# === Class: AppRouteReferences ===
effortless-ntwf:AppRouteReferences a owl:Class ;
    rdfs:label "AppRouteReferences" ;
    rdfs:comment "Junction: which other routes a route links to. This is the navigation graph between screens, kept as rows rather than embedded lists so the canonical model stays a DAG." .

effortless-ntwf:appRouteReferenceId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRouteReferences ;
    rdfs:range xsd:string ;
    rdfs:label "AppRouteReferenceId" ;
    rdfs:comment "Stored logical identifier for one AppRouteReferences row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AppRouteReferences row." .
    # calculated: calculated

effortless-ntwf:fromRoute a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AppRouteReferences ;
    rdfs:range effortless-ntwf:AppRoutes ;
    rdfs:label "FromRoute" ;
    rdfs:comment "The route that links out." .

effortless-ntwf:toRoute a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AppRouteReferences ;
    rdfs:range effortless-ntwf:AppRoutes ;
    rdfs:label "ToRoute" ;
    rdfs:comment "The route being linked to." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI for this row. An extension." .

# === Class: AppRoutes ===
effortless-ntwf:AppRoutes a owl:Class ;
    rdfs:label "AppRoutes" ;
    rdfs:comment "One row per screen in the role-navigated application, as /{role}/{dashboard}/{entity...}. Each carries its purpose in the owning role's voice and brief layout hints, so a later build session has the brief without re-deriving it. Shared detail routes have no owning role." .

effortless-ntwf:appRouteId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "AppRouteId" ;
    rdfs:comment "Stored logical identifier for one AppRoutes row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AppRoutes row." .
    # calculated: calculated

effortless-ntwf:routePath a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "RoutePath" ;
    rdfs:comment "The URL path, /{role}/{dashboard}/{entity...}. Shared detail routes live under /shared/ because the same entity serves every role." .

effortless-ntwf:routeName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "RouteName" ;
    rdfs:comment "Short label. This is the left-nav text." .

effortless-ntwf:surface a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "Surface" ;
    rdfs:comment "domain | maintainer. Domain routes belong to the twelve accountable Roles. Maintainer routes are the model's own instrumentation (Admin, Explorer) and deliberately have no owning role — 'admin' is not a role anyone is accountable in." .

effortless-ntwf:owningRole a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "OwningRole" ;
    rdfs:comment "The role whose navigation contains this route. Null for shared routes reachable from several roles." .

effortless-ntwf:navGroup a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range effortless-ntwf:AppNavGroups ;
    rdfs:label "NavGroup" ;
    rdfs:comment "Left-nav section this route appears under. Null for detail routes reached by drill-down rather than from the nav." .

effortless-ntwf:navOrder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "NavOrder" ;
    rdfs:comment "Sort order within the nav group." .

effortless-ntwf:routeKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "RouteKind" ;
    rdfs:comment "dashboard | workspace | detail | index | action. Detail routes carry path parameters and are not in the nav." .

effortless-ntwf:purpose a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Purpose" ;
    rdfs:comment "What the role does here, in that role's own voice. This is the brief for the build session." .

effortless-ntwf:layoutHints a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "LayoutHints" ;
    rdfs:comment "Brief layout direction: the shape of the screen, what leads, and what must not be collapsed or implied." .

effortless-ntwf:isInNav a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInNav" ;
    rdfs:comment "Whether this route appears in the left navigation. Detail routes do not." .
    # calculated: calculated

effortless-ntwf:isShared a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsShared" ;
    rdfs:comment "Whether this route is shared across domain roles rather than owned by one. A maintainer route is not shared — it belongs to a different surface entirely." .
    # calculated: calculated

effortless-ntwf:isMaintainer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMaintainer" ;
    rdfs:comment "Whether this route is model instrumentation rather than a domain workspace. Maintainer routes are reached from the login page's maintainer section, not from a role card." .
    # calculated: calculated

effortless-ntwf:questionCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "QuestionCount" ;
    rdfs:comment "How many role questions this route helps answer." .
    # calculated: aggregation

effortless-ntwf:referenceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:string ;
    rdfs:label "ReferenceCount" ;
    rdfs:comment "How many other routes this route links to." .
    # calculated: aggregation

effortless-ntwf:answersNoQuestion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppRoutes ;
    rdfs:range xsd:boolean ;
    rdfs:label "AnswersNoQuestion" ;
    rdfs:comment "A domain route owned by a role that answers no role question. Not automatically wrong, but it should be justified. Maintainer routes are excluded: they answer questions about the model itself, which are not RoleQuestions and must not be fabricated as such." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI for this row. An extension: PKO models procedures, not the applications that display them." .

# === Class: AppUsers ===
effortless-ntwf:AppUsers a owl:Class ;
    rdfs:label "AppUsers" ;
    rdfs:comment "Sign-in identities. One row per person or automation that can authenticate. EmailAddress is what a verified token asserts; everything else about the caller is resolved from here inside the database, never trusted from the token." .

effortless-ntwf:appUserId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range xsd:string ;
    rdfs:label "AppUserId" ;
    rdfs:comment "Stored logical identifier, e.g. 'user-maria-chen'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:emailAddress a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "EmailAddress" ;
    rdfs:comment "Verified email. The one claim magic-links vouches for, and the join key from a token back to this row." .

effortless-ntwf:displayName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DisplayName" ;
    rdfs:comment "Name shown in the console." .

effortless-ntwf:linkedAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "LinkedAgent" ;
    rdfs:comment "Domain agent this sign-in identity corresponds to." .

effortless-ntwf:isEnabled a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEnabled" ;
    rdfs:comment "False disables sign-in without deleting the identity or its history." .

effortless-ntwf:agentKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AgentKind" ;
    rdfs:comment "Whether the linked agent is Human, AIAgent or AutomatedPipeline." .
    # calculated: lookup

effortless-ntwf:organization a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Organization" ;
    rdfs:comment "Organization inherited from the linked agent; the tenancy claim baked into issued tokens." .
    # calculated: lookup

effortless-ntwf:assignmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range xsd:string ;
    rdfs:label "AssignmentCount" ;
    rdfs:comment "Number of principals this user may act as." .
    # calculated: aggregation

effortless-ntwf:hasNoPrincipal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasNoPrincipal" ;
    rdfs:comment "True when the user may act as no principal at all, so a successfully verified token still grants nothing. Authentication without authorization." .
    # calculated: calculated

effortless-ntwf:holdsMultiplePrincipals a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range xsd:boolean ;
    rdfs:label "HoldsMultiplePrincipals" ;
    rdfs:comment "True when the user may act as more than one principal, so the principal cannot be inferred from the email alone and must be chosen explicitly at sign-in." .
    # calculated: calculated

effortless-ntwf:isNonHumanSignIn a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AppUsers ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNonHumanSignIn" ;
    rdfs:comment "True when a non-human agent has a sign-in identity. Pipelines and AI agents authenticate too, and their tokens are scoped exactly like a person's." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: Attestations ===
effortless-ntwf:Attestations a owl:Class ;
    rdfs:label "Attestations" ;
    rdfs:comment "Attestations (added by witness loop 2)." .

effortless-ntwf:attestationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:string ;
    rdfs:label "AttestationId" ;
    rdfs:comment "Primary key of a signature event: one person, one execution, one instant." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Attestations row." .
    # calculated: calculated

effortless-ntwf:procedureExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "ProcedureExecution" ;
    rdfs:comment "The execution being attested to." .

effortless-ntwf:signedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "SignedByAgent" ;
    rdfs:comment "The human who signed." .

effortless-ntwf:signedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:dateTime ;
    rdfs:label "SignedAt" ;
    rdfs:comment "The instant of signature." .

effortless-ntwf:assuranceGradeAtSigning a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:string ;
    rdfs:label "AssuranceGradeAtSigning" ;
    rdfs:comment "The AssuranceGrade string as the model reported it at the moment of signature, captured then and never recomputed." .

effortless-ntwf:versionWasFitAtSigning a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:boolean ;
    rdfs:label "VersionWasFitAtSigning" ;
    rdfs:comment "Whether the executed procedure version was fit to execute at the moment of signature." .

effortless-ntwf:versionIsFitNow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:boolean ;
    rdfs:label "VersionIsFitNow" ;
    rdfs:comment "Whether the executed version reads as fit today." .
    # calculated: lookup

effortless-ntwf:fitnessVerdictHasDrifted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:boolean ;
    rdfs:label "FitnessVerdictHasDrifted" ;
    rdfs:comment "TRUE when the fitness of the signed version reads differently today than it did at signature." .
    # calculated: calculated

effortless-ntwf:assuranceGradeNow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:string ;
    rdfs:label "AssuranceGradeNow" ;
    rdfs:comment "The AssuranceGrade the model reports for this execution today." .
    # calculated: lookup

effortless-ntwf:assuranceGradeHasDrifted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:boolean ;
    rdfs:label "AssuranceGradeHasDrifted" ;
    rdfs:comment "TRUE when the assurance behind this signature is described differently now than it was at signature." .
    # calculated: calculated

effortless-ntwf:wouldNotSurviveRestatement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Attestations ;
    rdfs:range xsd:boolean ;
    rdfs:label "WouldNotSurviveRestatement" ;
    rdfs:comment "TRUE when re-deriving this attestation today would not reproduce what the model said when it was signed." .
    # calculated: calculated

# === Class: AuthorityBoundaries ===
effortless-ntwf:AuthorityBoundaries a owl:Class ;
    rdfs:label "AuthorityBoundaries" ;
    rdfs:comment "AuthorityBoundaries (added by witness loop 1)." .

effortless-ntwf:authorityBoundaryId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "AuthorityBoundaryId" ;
    rdfs:comment "Stored logical identifier for one AuthorityBoundaries row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the AuthorityBoundaries row." .
    # calculated: calculated

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Step at which the boundary applies." .

effortless-ntwf:forbiddenAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "ForbiddenAgentKind" ;
    rdfs:comment "Agent kind that may not perform the forbidden decision kind: Human, AIAgent, or AutomatedPipeline." .

effortless-ntwf:forbiddenDecisionKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "ForbiddenDecisionKind" ;
    rdfs:comment "Decision kind forbidden to that agent kind at this step." .

effortless-ntwf:ratifiedByKnowledgeFragment a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range effortless-ntwf:KnowledgeFragments ;
    rdfs:label "RatifiedByKnowledgeFragment" ;
    rdfs:comment "Knowledge fragment that states the boundary." .

effortless-ntwf:enforcingRequirement a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range effortless-ntwf:Requirements ;
    rdfs:label "EnforcingRequirement" ;
    rdfs:comment "Requirement under which the boundary is enforced, if any." .

effortless-ntwf:authorityRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "AuthorityRole" ;
    rdfs:comment "Role accountable for the boundary." .

effortless-ntwf:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ValidFrom" ;
    rdfs:comment "Start of the boundary's valid-time interval." .

effortless-ntwf:validTo a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ValidTo" ;
    rdfs:comment "End of the boundary's valid-time interval; null means open-ended." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Approved, Proposed, or Retired." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this boundary's currency is judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this boundary is judged against." .
    # calculated: lookup

effortless-ntwf:isCurrentlyBinding a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrentlyBinding" ;
    rdfs:comment "TRUE when this boundary is approved and inside its valid-time window right now." .
    # calculated: calculated

effortless-ntwf:ratifyingFragmentIsValid a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "RatifyingFragmentIsValid" ;
    rdfs:comment "Whether the knowledge fragment that ratified this boundary is still valid." .
    # calculated: lookup

effortless-ntwf:stepWhenBinding a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "StepWhenBinding" ;
    rdfs:comment "Echoes the step id when this boundary is currently binding, blank otherwise." .
    # calculated: calculated

effortless-ntwf:boundaryMatchKey a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "BoundaryMatchKey" ;
    rdfs:comment "Composite key of step, forbidden agent kind, and forbidden decision kind." .
    # calculated: calculated

effortless-ntwf:violationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "ViolationCount" ;
    rdfs:comment "Number of recorded decisions that this boundary forbids." .
    # calculated: aggregation

effortless-ntwf:isUntested a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUntested" ;
    rdfs:comment "TRUE when a binding boundary has never been triggered by any recorded decision." .
    # calculated: calculated

effortless-ntwf:hasRatifyingFragment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRatifyingFragment" ;
    rdfs:comment "TRUE when this boundary names a knowledge fragment as its justification. FALSE means the rule constrains behaviour on nobody's recorded authority — strictly worse than resting on an expired claim, and previously invisible because the ratification lookup returned NULL." .
    # calculated: calculated

effortless-ntwf:isUnwarranted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwarranted" ;
    rdfs:comment "TRUE when a binding constraint on authority rests on no ratifying claim at all, or on one that is no longer valid. Either way the rule is being enforced without a live justification." .
    # calculated: calculated

effortless-ntwf:ratifyingFragmentIsOverdue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "RatifyingFragmentIsOverdue" ;
    rdfs:comment "Whether the fragment ratifying this boundary is past its review date." .
    # calculated: lookup

effortless-ntwf:ratifyingFragmentIsSingleWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "RatifyingFragmentIsSingleWitness" ;
    rdfs:comment "Whether the fragment ratifying this boundary rests on a single witness." .
    # calculated: lookup

effortless-ntwf:warrantIsThin a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "WarrantIsThin" ;
    rdfs:comment "A binding boundary whose ratifying knowledge is either overdue for review or single-sourced — still valid, but weakly warranted." .
    # calculated: calculated

effortless-ntwf:isUnwarrantedAndUntested a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnwarrantedAndUntested" ;
    rdfs:comment "A boundary whose ratification has lapsed and which no agent decision has ever been evaluated against — we cannot show it works and we cannot show why it exists." .
    # calculated: calculated

effortless-ntwf:unwarrantedBoundaryStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "UnwarrantedBoundaryStepKey" ;
    rdfs:comment "Composite-key echo: the step this boundary governs when the boundary is unwarranted, blank otherwise." .
    # calculated: calculated

effortless-ntwf:ratifyingFragmentKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "RatifyingFragmentKey" ;
    rdfs:comment "Composite-key echo: the fragment ratifying this boundary when the boundary is currently binding, blank otherwise." .
    # calculated: calculated

effortless-ntwf:ratifyingFragmentStatus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "RatifyingFragmentStatus" ;
    rdfs:comment "The status string of the knowledge fragment that ratifies this boundary: Approved, Reviewed, Draft, or empty." .
    # calculated: lookup

effortless-ntwf:ratificationLapsed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "RatificationLapsed" ;
    rdfs:comment "TRUE when this boundary names a ratifying fragment and that fragment is no longer valid." .
    # calculated: calculated

effortless-ntwf:bindsDespiteLapsedRatification a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "BindsDespiteLapsedRatification" ;
    rdfs:comment "TRUE when a boundary is still enforced against agents while the knowledge that authorized it has lapsed." .
    # calculated: calculated

effortless-ntwf:isUngroundedAndUntested a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngroundedAndUntested" ;
    rdfs:comment "TRUE when a boundary has lapsed ratification AND has never once been exercised -- so neither its authority nor its operation has ever been demonstrated." .
    # calculated: calculated

effortless-ntwf:constrainedRoleAssignmentKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AuthorityBoundaries ;
    rdfs:range xsd:string ;
    rdfs:label "ConstrainedRoleAssignmentKey" ;
    rdfs:comment "The role id this boundary constrains, emitted only when the boundary is ungrounded." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI for an authority boundary." .

# === Class: BindingObservations ===
effortless-ntwf:BindingObservations a owl:Class ;
    rdfs:label "BindingObservations" ;
    rdfs:comment "BindingObservations (added by witness loop 2)." .

effortless-ntwf:bindingObservationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:string ;
    rdfs:label "BindingObservationId" ;
    rdfs:comment "Primary key of an execution-side observation of one operational binding, frozen at the moment a step actually ran." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the BindingObservations row." .
    # calculated: calculated

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "The step execution during which this binding was read." .

effortless-ntwf:operationalBinding a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range effortless-ntwf:OperationalBindings ;
    rdfs:label "OperationalBinding" ;
    rdfs:comment "The spec-side binding this observation instantiates." .

effortless-ntwf:observedSourceTimestamp a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ObservedSourceTimestamp" ;
    rdfs:comment "The LastObservedAt value the source actually carried at run time, captured then and never recomputed." .

effortless-ntwf:readAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ReadAt" ;
    rdfs:comment "When the step execution actually read this binding." .

effortless-ntwf:slaMinutesAtRun a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:integer ;
    rdfs:label "SlaMinutesAtRun" ;
    rdfs:comment "The freshness SLA declared for this binding." .
    # calculated: lookup

effortless-ntwf:ageAtRunMinutes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:integer ;
    rdfs:label "AgeAtRunMinutes" ;
    rdfs:comment "How old the source data was at the instant the step read it." .
    # calculated: calculated

effortless-ntwf:wasStaleAtRun a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasStaleAtRun" ;
    rdfs:comment "TRUE when an authoritative source was already outside its SLA at the moment the step consumed it." .
    # calculated: calculated

effortless-ntwf:isAuthoritativeBinding a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAuthoritativeBinding" ;
    rdfs:comment "Whether the binding observed is the authoritative source for its record key." .
    # calculated: lookup

effortless-ntwf:staleAtRunStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:BindingObservations ;
    rdfs:range xsd:string ;
    rdfs:label "StaleAtRunStepKey" ;
    rdfs:comment "Echoes the step execution id when the source was stale at run time." .
    # calculated: calculated

# === Class: ChangeRequests ===
effortless-ntwf:ChangeRequests a owl:Class ;
    rdfs:label "ChangeRequests" ;
    rdfs:comment "Governed requests for semantic or operational change, anchored to a procedure version and authority. Explicit ERB-PKO extension." .

effortless-ntwf:changeRequestId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeRequestId" ;
    rdfs:comment "Stored logical identifier for one ChangeRequests row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the ChangeRequests row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version affected." .

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Change title." .

effortless-ntwf:changeKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeKind" ;
    rdfs:comment "Defect, Enhancement, NewRequirement, DataOperation, or BreakingChange." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Draft, UnderReview, Approved, Rejected, Implemented, or Closed." .

effortless-ntwf:requestedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "RequestedByAgent" ;
    rdfs:comment "Agent requesting the change." .

effortless-ntwf:authorityRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "AuthorityRole" ;
    rdfs:comment "Role authorized to approve the change." .

effortless-ntwf:requestedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:dateTime ;
    rdfs:label "RequestedAt" ;
    rdfs:comment "Request time." .

effortless-ntwf:decidedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "DecidedAt" ;
    rdfs:comment "Decision time." .

effortless-ntwf:impactAssessment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "ImpactAssessment" ;
    rdfs:comment "Expected effect on commitments, data, projections, and tests." .

effortless-ntwf:isOpen a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOpen" ;
    rdfs:comment "TRUE while the change request is still outstanding. An Approved request stays open until ImplementedAt records that it actually landed — approval is a decision, not an outcome." .
    # calculated: calculated

effortless-ntwf:openChangeVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "OpenChangeVersionKey" ;
    rdfs:comment "Echoes the ProcedureVersion id only for change requests still open." .
    # calculated: calculated

effortless-ntwf:isDecided a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDecided" ;
    rdfs:comment "TRUE when a decision timestamp has been recorded." .
    # calculated: calculated

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:daysPending a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysPending" ;
    rdfs:comment "Days from request to decision, or to now if still undecided." .
    # calculated: calculated

effortless-ntwf:isStillPending a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStillPending" ;
    rdfs:comment "TRUE when the request is in an open status and has no decision recorded." .
    # calculated: calculated

effortless-ntwf:isStalled a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStalled" ;
    rdfs:comment "TRUE when an undecided change request has been pending more than fourteen days." .
    # calculated: calculated

effortless-ntwf:authorityAgent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "AuthorityAgent" ;
    rdfs:comment "The agent currently holding the authority role that owes a decision on this request." .
    # calculated: lookup

effortless-ntwf:requesterIsAuthority a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "RequesterIsAuthority" ;
    rdfs:comment "TRUE when the agent who raised the request is also the agent who decides it." .
    # calculated: calculated

effortless-ntwf:awaitsAuthorityDecision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "AwaitsAuthorityDecision" ;
    rdfs:comment "TRUE when this request is formally before its authority and no decision has been recorded." .
    # calculated: calculated

effortless-ntwf:authorityRoleLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "AuthorityRoleLabel" ;
    rdfs:comment "Human-readable label of the role that owes a decision." .
    # calculated: lookup

effortless-ntwf:touchesLiveVersion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "TouchesLiveVersion" ;
    rdfs:comment "Whether the version this request would alter is currently executable." .
    # calculated: lookup

effortless-ntwf:isLiveDecisionBacklog a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveDecisionBacklog" ;
    rdfs:comment "TRUE when a decision I owe is blocking a change to a procedure currently in production." .
    # calculated: calculated

effortless-ntwf:blocksAnOpenGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "BlocksAnOpenGap" ;
    rdfs:comment "TRUE when an undecided request against a live version is the kind that exists to close a known gap." .
    # calculated: calculated

effortless-ntwf:implementedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ImplementedAt" ;
    rdfs:comment "When the approved change was actually applied to the procedure version. Null until it lands. Distinct from DecidedAt, which records only that the authority ruled. Approval and implementation are separate events; conflating them is what left IsOpen with no terminal state." .

effortless-ntwf:backlogVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "BacklogVersionKey" ;
    rdfs:comment "Composite-key echo: this request's procedure version when it is live decision backlog, blank otherwise." .
    # calculated: calculated

effortless-ntwf:isMyPendingDecision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyPendingDecision" ;
    rdfs:comment "A change request awaiting a decision that is mine personally to make." .
    # calculated: calculated

effortless-ntwf:isMyBlockingBacklog a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyBlockingBacklog" ;
    rdfs:comment "A decision waiting on me that is holding an open gap on a live procedure." .
    # calculated: calculated

effortless-ntwf:isMyOverdueBacklog a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyOverdueBacklog" ;
    rdfs:comment "A blocking decision that has waited on me for more than two weeks." .
    # calculated: calculated

effortless-ntwf:isImplemented a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsImplemented" ;
    rdfs:comment "Whether the approved change has actually been applied." .
    # calculated: calculated

effortless-ntwf:isMyDecidedRequest a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyDecidedRequest" ;
    rdfs:comment "A change request I have personally ruled on." .
    # calculated: calculated

effortless-ntwf:isMyDecidedButUnlanded a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyDecidedButUnlanded" ;
    rdfs:comment "A decision I have made that has not yet been applied — still counted against me by the loop-1 open-request measure." .
    # calculated: calculated

effortless-ntwf:decisionLatencyDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:integer ;
    rdfs:label "DecisionLatencyDays" ;
    rdfs:comment "How many days I took to rule, once ruled. Zero when undecided — read only alongside IsDecided." .
    # calculated: calculated

effortless-ntwf:implementationLatencyDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:integer ;
    rdfs:label "ImplementationLatencyDays" ;
    rdfs:comment "How many days elapsed between my ruling and the change actually landing. Zero when not yet implemented." .
    # calculated: calculated

effortless-ntwf:delayIsDownstreamOfMe a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "DelayIsDownstreamOfMe" ;
    rdfs:comment "A request I decided promptly that is nevertheless still outstanding because nobody has implemented it." .
    # calculated: calculated

effortless-ntwf:unlandedVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "UnlandedVersionKey" ;
    rdfs:comment "Composite-key echo: this request's procedure version when I have decided it but it has not landed, blank otherwise." .
    # calculated: calculated

effortless-ntwf:isApprovedNotImplemented a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApprovedNotImplemented" ;
    rdfs:comment "A change request the authority approved but that has not yet been applied." .
    # calculated: calculated

effortless-ntwf:daysSinceApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceApproval" ;
    rdfs:comment "How many days have elapsed since the authority decided this request. Zero when undecided." .
    # calculated: calculated

effortless-ntwf:isStalledImplementation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStalledImplementation" ;
    rdfs:comment "An approved change request that has sat unimplemented for more than two weeks." .
    # calculated: calculated

effortless-ntwf:stalledImplementationVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "StalledImplementationVersionKey" ;
    rdfs:comment "Composite-key echo: this request's procedure version when its implementation is stalled, blank otherwise." .
    # calculated: calculated

effortless-ntwf:approvedVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:string ;
    rdfs:label "ApprovedVersionKey" ;
    rdfs:comment "Echoes the target version id when this change request was approved." .
    # calculated: calculated

effortless-ntwf:isApprovedDecision a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ChangeRequests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApprovedDecision" ;
    rdfs:comment "TRUE when this change request was decided in the affirmative." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: CommunicationPolicies ===
effortless-ntwf:CommunicationPolicies a owl:Class ;
    rdfs:label "CommunicationPolicies" ;
    rdfs:comment "Channel-specific communication policy projected from the same canonical procedure. Uses ODRL-style policy semantics plus ERB-PKO channel constraints." .

effortless-ntwf:communicationPolicyId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "CommunicationPolicyId" ;
    rdfs:comment "Stored logical identifier for one CommunicationPolicies row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the CommunicationPolicies row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version governing the channel." .

effortless-ntwf:channel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Channel" ;
    rdfs:comment "Email, SMS, Push, Postal, or another declared channel." .

effortless-ntwf:audienceRule a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "AudienceRule" ;
    rdfs:comment "Rule that identifies eligible recipients." .

effortless-ntwf:consentRequired a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:boolean ;
    rdfs:label "ConsentRequired" ;
    rdfs:comment "Whether active consent is required." .

effortless-ntwf:quietHoursStart a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "QuietHoursStart" ;
    rdfs:comment "Recipient-local quiet-hours start." .

effortless-ntwf:quietHoursEnd a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "QuietHoursEnd" ;
    rdfs:comment "Recipient-local quiet-hours end." .

effortless-ntwf:maxMessageLength a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:integer ;
    rdfs:label "MaxMessageLength" ;
    rdfs:comment "Maximum message length for one unit." .

effortless-ntwf:maxSegments a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:integer ;
    rdfs:label "MaxSegments" ;
    rdfs:comment "Maximum number of channel segments." .

effortless-ntwf:retentionDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:integer ;
    rdfs:label "RetentionDays" ;
    rdfs:comment "Retention period for rendered messages and delivery records." .

effortless-ntwf:approvalRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "ApprovalRole" ;
    rdfs:comment "Role approving the channel policy." .

effortless-ntwf:requiredContent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "RequiredContent" ;
    rdfs:comment "Content that every message must include." .

effortless-ntwf:authorityStatement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "AuthorityStatement" ;
    rdfs:comment "Which artifact is authoritative." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Draft, Active, Suspended, or Retired." .

effortless-ntwf:consentViolationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "ConsentViolationCount" ;
    rdfs:comment "Number of consent violations attributable to this channel policy." .
    # calculated: aggregation

effortless-ntwf:quietHoursStartHour a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:integer ;
    rdfs:label "QuietHoursStartHour" ;
    rdfs:comment "The hour (0-23) at which the quiet window opens. Stored rather than parsed from QuietHoursStart: VALUE(LEFT(...)) does not translate — the transpiler casts the \"20:00\" string to a timestamp and the view errors. The sending system already knows this number, so modeling it as a parse would dress a broken derivation up as a rule." .

effortless-ntwf:quietHoursEndHour a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:integer ;
    rdfs:label "QuietHoursEndHour" ;
    rdfs:comment "Numeric hour 0-23 at which quiet hours end. Seeded 8 for comm-sms-policy, 0 for comm-email-policy." .

effortless-ntwf:quietHoursViolationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "QuietHoursViolationCount" ;
    rdfs:comment "Number of transmitted messages that breached this policy's quiet-hours window." .
    # calculated: aggregation

effortless-ntwf:requiredOptOutPhrase a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:string ;
    rdfs:label "RequiredOptOutPhrase" ;
    rdfs:comment "The exact opt-out phrase every message on this channel must contain. Seeded 'Reply STOP' for comm-sms-policy, empty string for comm-email-policy." .

effortless-ntwf:isActivePolicy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunicationPolicies ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsActivePolicy" ;
    rdfs:comment "TRUE only when this channel policy is in Active status." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "ODRL Policy class IRI." .

# === Class: CommunitiesOfPractice ===
effortless-ntwf:CommunitiesOfPractice a owl:Class ;
    rdfs:label "CommunitiesOfPractice" ;
    rdfs:comment "Socio-technical communities that transmit and maintain procedural knowledge. Explicit ERB-PKO extension." .

effortless-ntwf:communityOfPracticeId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunitiesOfPractice ;
    rdfs:range xsd:string ;
    rdfs:label "CommunityOfPracticeId" ;
    rdfs:comment "Stored logical identifier for one CommunitiesOfPractice row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the CommunitiesOfPractice row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Community's human-readable name." .

effortless-ntwf:organization a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Organizations ;
    rdfs:label "Organization" ;
    rdfs:comment "Organization hosting the community." .

effortless-ntwf:stewardRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "StewardRole" ;
    rdfs:comment "Role accountable for convening and maintaining the community." .

effortless-ntwf:purpose a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Purpose" ;
    rdfs:comment "Shared practice and knowledge-transfer purpose." .

effortless-ntwf:cadence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CommunitiesOfPractice ;
    rdfs:range xsd:string ;
    rdfs:label "Cadence" ;
    rdfs:comment "Meeting or practice cadence." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: DeliveredCommunications ===
effortless-ntwf:DeliveredCommunications a owl:Class ;
    rdfs:label "DeliveredCommunications" ;
    rdfs:comment "Everything above is a proxy for the real question, which is instance-level: THIS message, to THIS recipient, rendered from THIS template, authorized by THIS approval. The model has MessageTemplates and CommunicationPolicies as specifications and no record of a single thing ever sent. Without an instance table, 'can I show that what was sent matched what I approved' is permanently unanswerable rather than merely unanswered — and it is the question a disputing employee actually asks. Extension term (urn:effortless:pko-extension#DeliveredCommunication); PKO has no native class for a delivered artifact instance." .

effortless-ntwf:deliveredCommunicationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DeliveredCommunications ;
    rdfs:range xsd:string ;
    rdfs:label "DeliveredCommunicationId" ;
    rdfs:comment "Stored logical identifier for one DeliveredCommunications row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:procedureExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "ProcedureExecution" ;
    rdfs:comment "The run that produced this delivery." .

effortless-ntwf:sendingStepExecution a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:DeliveredCommunications ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "SendingStepExecution" ;
    rdfs:comment "The policy-07 step execution that sent it." .

effortless-ntwf:authorizingStepExecution a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:DeliveredCommunications ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "AuthorizingStepExecution" ;
    rdfs:comment "The human approval gate execution that authorized this content. Null means nobody approved it." .

effortless-ntwf:messageTemplate a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:MessageTemplates ;
    rdfs:label "MessageTemplate" ;
    rdfs:comment "The approved template this delivery was rendered from." .

effortless-ntwf:channel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Channel" ;
    rdfs:comment "Email or SMS." .

effortless-ntwf:recipientKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DeliveredCommunications ;
    rdfs:range xsd:string ;
    rdfs:label "RecipientKey" ;
    rdfs:comment "Opaque recipient identifier; no personal data in the rulebook." .

effortless-ntwf:sentAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "SentAt" ;
    rdfs:comment "When the message was dispatched." .

effortless-ntwf:renderedContentHash a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DeliveredCommunications ;
    rdfs:range xsd:string ;
    rdfs:label "RenderedContentHash" ;
    rdfs:comment "Hash of the exact bytes delivered, for comparison against the approved rendering." .

effortless-ntwf:approvedContentHash a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DeliveredCommunications ;
    rdfs:range xsd:string ;
    rdfs:label "ApprovedContentHash" ;
    rdfs:comment "Hash of the content as it stood at the approval gate." .

effortless-ntwf:deliveryStatus a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DeliveryStatus" ;
    rdfs:comment "Provider-reported delivery outcome." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

effortless-ntwf:hasAuthorization a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DeliveredCommunications ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasAuthorization" ;
    rdfs:comment "TRUE when this delivery names the approval that authorized it." .
    # calculated: calculated

effortless-ntwf:contentMatchesApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DeliveredCommunications ;
    rdfs:range xsd:boolean ;
    rdfs:label "ContentMatchesApproval" ;
    rdfs:comment "TRUE when the bytes delivered are the bytes approved." .
    # calculated: calculated

effortless-ntwf:authorizedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DeliveredCommunications ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AuthorizedAt" ;
    rdfs:comment "When the authorizing approval completed." .
    # calculated: lookup

effortless-ntwf:wasApprovedBeforeSending a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DeliveredCommunications ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasApprovedBeforeSending" ;
    rdfs:comment "TRUE when the approval preceded the send." .
    # calculated: calculated

effortless-ntwf:isDefensible a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DeliveredCommunications ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDefensible" ;
    rdfs:comment "TRUE when this delivery can be defended in a dispute: authorized, unaltered, and approved beforehand." .
    # calculated: calculated

