    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Functions row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Function label." .

effortless-ntwf:definition a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Definition" ;
    rdfs:comment "Deterministic or AI-assisted behavior." .

effortless-ntwf:implementationKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Functions ;
    rdfs:range xsd:string ;
    rdfs:label "ImplementationKey" ;
