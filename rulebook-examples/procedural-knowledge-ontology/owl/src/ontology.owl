    # calculated: aggregation

effortless-ntwf:knowledgeIsStalerThanCadence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "KnowledgeIsStalerThanCadence" ;
    rdfs:comment "TRUE when this version rests on at least one claim older than its own review cadence." .
    # calculated: calculated

effortless-ntwf:compoundFragileFragmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "CompoundFragileFragmentCount" ;
