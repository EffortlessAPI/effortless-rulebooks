effortless-ntwf:Functions a owl:Class ;
    rdfs:label "Functions" ;
    rdfs:comment "Software or algorithmic functions required by steps. Maps to pko:Function and pko:requiresFunction." .

effortless-ntwf:functionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Functions ;
    rdfs:range xsd:string ;
    rdfs:label "FunctionId" ;
    rdfs:comment "Stored logical identifier for one Functions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
