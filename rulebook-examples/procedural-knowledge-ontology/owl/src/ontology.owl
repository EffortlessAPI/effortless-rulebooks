effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "Step execution during which the issue occurred." .

effortless-ntwf:error a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range effortless-ntwf:Errors ;
    rdfs:label "Error" ;
    rdfs:comment "Error encountered." .

effortless-ntwf:encounteredByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:IssueOccurrences ;
    rdfs:range effortless-ntwf:Agents ;
