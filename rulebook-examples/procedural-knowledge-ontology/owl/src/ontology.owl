    rdfs:range xsd:boolean ;
    rdfs:label "RestsOnCompoundFragileKnowledge" ;
    rdfs:comment "A live procedure version resting on at least one knowledge fragment that carries three or more decay signals." .
    # calculated: calculated

effortless-ntwf:concentratedWitnessSessionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "ConcentratedWitnessSessionCount" ;
    rdfs:comment "How many concentrated single-witness sessions underwrite this version's knowledge base." .
    # calculated: aggregation

effortless-ntwf:knowledgeBaseIsConcentrated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "KnowledgeBaseIsConcentrated" ;
    rdfs:comment "A live version where at least one single-witness session alone underwrites three or more of its live claims." .
    # calculated: calculated

effortless-ntwf:machineConsumedUnapprovedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "MachineConsumedUnapprovedCount" ;
