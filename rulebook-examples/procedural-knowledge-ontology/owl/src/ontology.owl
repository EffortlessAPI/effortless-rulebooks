# === Class: ElicitationSessions ===
effortless-ntwf:ElicitationSessions a owl:Class ;
    rdfs:label "ElicitationSessions" ;
    rdfs:comment "Structured knowledge-elicitation events involving practitioners and knowledge engineers. Explicit ERB-PKO extension, modeled as prov:Activity." .

effortless-ntwf:elicitationSessionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "ElicitationSessionId" ;
    rdfs:comment "Stored logical identifier for one ElicitationSessions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the ElicitationSessions row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version whose knowledge was elicited." .

effortless-ntwf:method a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "Method" ;
    rdfs:comment "Interview, shadowing, workshop, observation, document analysis, or another method." .

effortless-ntwf:startedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "StartedAt" ;
    rdfs:comment "Start time; maps to prov:startedAtTime." .

effortless-ntwf:endedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "EndedAt" ;
    rdfs:comment "End time; maps to prov:endedAtTime." .

effortless-ntwf:practitionerAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "PractitionerAgent" ;
    rdfs:comment "Domain practitioner providing knowledge." .

effortless-ntwf:facilitatorAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "FacilitatorAgent" ;
    rdfs:comment "Person facilitating elicitation." .

effortless-ntwf:summary a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "Summary" ;
    rdfs:comment "What was learned and captured." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Draft, Reviewed, Approved, or Rejected." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:daysSinceElicited a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceElicited" ;
    rdfs:comment "Days elapsed since this elicitation session concluded." .
    # calculated: calculated

effortless-ntwf:isSingleWitnessMethod a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSingleWitnessMethod" ;
    rdfs:comment "TRUE when this session captured one practitioner's account rather than a group's." .
    # calculated: calculated

effortless-ntwf:practitionerIsStillEngaged a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "PractitionerIsStillEngaged" ;
    rdfs:comment "Whether the practitioner whose knowledge this session captured still holds a role here." .
    # calculated: lookup

effortless-ntwf:validFragmentsProduced a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "ValidFragmentsProduced" ;
    rdfs:comment "How many currently-valid knowledge fragments this one session produced." .
    # calculated: aggregation

effortless-ntwf:isHighYieldSession a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHighYieldSession" ;
    rdfs:comment "A session that alone underwrites three or more currently-valid claims." .
    # calculated: calculated

effortless-ntwf:isConcentratedSingleWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConcentratedSingleWitness" ;
    rdfs:comment "One unrepeated session with one witness that underwrites three or more live claims." .
    # calculated: calculated

effortless-ntwf:isStaleConcentratedWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStaleConcentratedWitness" ;
    rdfs:comment "A concentrated single-witness session more than 180 days old — matching the single-witness expiry horizon loop 1 already established." .
    # calculated: calculated

effortless-ntwf:concentratedSessionVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ElicitationSessions ;
    rdfs:range xsd:string ;
    rdfs:label "ConcentratedSessionVersionKey" ;
    rdfs:comment "Composite-key echo: this session's procedure version when the session is a concentrated single witness, blank otherwise." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Class IRI used in semantic projection." .

# === Class: Errors ===
effortless-ntwf:Errors a owl:Class ;
    rdfs:label "Errors" ;
    rdfs:comment "Reusable error definitions encountered during execution. Maps to pko:Error, errorCode, and errorCause." .

effortless-ntwf:errorId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Errors ;
    rdfs:range xsd:string ;
    rdfs:label "ErrorId" ;
    rdfs:comment "Stored logical identifier for one Errors row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Errors row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Error label." .

effortless-ntwf:errorCode a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Errors ;
    rdfs:range xsd:string ;
    rdfs:label "ErrorCode" ;
    rdfs:comment "Error code; maps to pko:errorCode." .

effortless-ntwf:errorCause a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Errors ;
    rdfs:range xsd:string ;
    rdfs:label "ErrorCause" ;
    rdfs:comment "Known or suspected cause; maps to pko:errorCause." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: EvaluationContexts ===
effortless-ntwf:EvaluationContexts a owl:Class ;
    rdfs:label "EvaluationContexts" ;
    rdfs:comment "The instant this rulebook's time-dependent witnesses are evaluated against. Modeled as data rather than wall-clock so every freshness, overdue, and validity answer is reproducible and auditable: asking the same question tomorrow yields the same answer. Exactly one row carries IsCurrent." .

effortless-ntwf:evaluationContextId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvaluationContexts ;
    rdfs:range xsd:string ;
    rdfs:label "EvaluationContextId" ;
    rdfs:comment "Stored logical identifier for one EvaluationContexts row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the EvaluationContexts row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "What this evaluation instant represents." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The instant all time-dependent witnesses are evaluated against." .

effortless-ntwf:isCurrent a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrent" ;
    rdfs:comment "TRUE for the single active evaluation context." .

effortless-ntwf:rationale a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Rationale" ;
    rdfs:comment "Why this instant was chosen." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: ExceptionInvocations ===
effortless-ntwf:ExceptionInvocations a owl:Class ;
    rdfs:label "ExceptionInvocations" ;
    rdfs:comment "ExceptionInvocations (added by witness loop 1)." .

effortless-ntwf:exceptionInvocationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "ExceptionInvocationId" ;
    rdfs:comment "Stored logical identifier for one ExceptionInvocations row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "The execution during which the exception was invoked." .

effortless-ntwf:exception a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range effortless-ntwf:Exceptions ;
    rdfs:label "Exception" ;
    rdfs:comment "The specified exception that was invoked." .

effortless-ntwf:invokedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "InvokedByAgent" ;
    rdfs:comment "Agent who invoked the exception." .

effortless-ntwf:approvedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ApprovedByAgent" ;
    rdfs:comment "Agent who approved the invocation. Must satisfy the exception's ApprovalRole." .

effortless-ntwf:invokedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:dateTime ;
    rdfs:label "InvokedAt" ;
    rdfs:comment "When the exception was invoked." .

effortless-ntwf:handlingApplied a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "HandlingApplied" ;
    rdfs:comment "What was actually done, in the invoker's words." .

effortless-ntwf:expectedHandling a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "ExpectedHandling" ;
    rdfs:comment "The handling the specification prescribes." .
    # calculated: lookup

effortless-ntwf:requiredApprovalRole a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RequiredApprovalRole" ;
    rdfs:comment "The role the specification requires to approve this exception." .
    # calculated: lookup

effortless-ntwf:requiredApprovalRoleHolder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "RequiredApprovalRoleHolder" ;
    rdfs:comment "The agent who currently holds the role that must approve this exception." .
    # calculated: lookup

effortless-ntwf:approvalRoleMatches a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:boolean ;
    rdfs:label "ApprovalRoleMatches" ;
    rdfs:comment "TRUE when the agent who approved is the holder of the role the exception requires." .
    # calculated: calculated

effortless-ntwf:isApproved a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApproved" ;
    rdfs:comment "TRUE when an approver was recorded at all." .
    # calculated: calculated

effortless-ntwf:isImproperlyApproved a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsImproperlyApproved" ;
    rdfs:comment "TRUE when an exception was invoked without an approver, or approved by an agent who does not hold the required role." .
    # calculated: calculated

effortless-ntwf:invokerAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "InvokerAgentKind" ;
    rdfs:comment "What kind of agent invoked the exception." .
    # calculated: lookup

effortless-ntwf:invokerAlsoPreparedKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "InvokerAlsoPreparedKey" ;
    rdfs:comment "Composite execution+approver key, in the same key space as StepExecutions.PreparerAgentKey." .
    # calculated: calculated

effortless-ntwf:parentProcedureExecution a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ParentProcedureExecution" ;
    rdfs:comment "The procedure execution this invocation belongs to." .
    # calculated: lookup

effortless-ntwf:approverPreparedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:string ;
    rdfs:label "ApproverPreparedCount" ;
    rdfs:comment "How many preparation steps in the same execution were run by the agent who approved this exception." .
    # calculated: aggregation

effortless-ntwf:delegatedToPreparer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:boolean ;
    rdfs:label "DelegatedToPreparer" ;
    rdfs:comment "TRUE when an exception routed approval authority to an agent who prepared work in the same execution." .
    # calculated: calculated

effortless-ntwf:isUngovernedInvocation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ExceptionInvocations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUngovernedInvocation" ;
    rdfs:comment "TRUE when an exception was invoked without proper role authority, or routed authority to the preparer." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension IRI — PKO does not define exception invocation." .

# === Class: Exceptions ===
effortless-ntwf:Exceptions a owl:Class ;
    rdfs:label "Exceptions" ;
    rdfs:comment "Documented exceptions, fallbacks, and alternative handling. Aligns structurally with PKO fallback/alternative steps and requirements; the exception record itself is an ERB-PKO extension." .

effortless-ntwf:exceptionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Exceptions ;
    rdfs:range xsd:string ;
    rdfs:label "ExceptionId" ;
    rdfs:comment "Stored logical identifier for one Exceptions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Exceptions row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version containing the exception." .

effortless-ntwf:triggerStep a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Exceptions ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "TriggerStep" ;
    rdfs:comment "Step at which the exception becomes relevant." .

effortless-ntwf:condition a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Condition" ;
    rdfs:comment "Exception condition." .

effortless-ntwf:handling a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Exceptions ;
    rdfs:range xsd:string ;
    rdfs:label "Handling" ;
    rdfs:comment "Required handling and guardrails." .

effortless-ntwf:approvalRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "ApprovalRole" ;
    rdfs:comment "Role that approves use of the exception." .

effortless-ntwf:fallbackRole a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Exceptions ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "FallbackRole" ;
    rdfs:comment "Role or function that executes fallback handling." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Active, Draft, Retired, or Superseded." .

effortless-ntwf:activeExceptionStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Exceptions ;
    rdfs:range xsd:string ;
    rdfs:label "ActiveExceptionStepKey" ;
    rdfs:comment "Echoes the TriggerStep id only for exceptions currently in Active status." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: Explanations ===
effortless-ntwf:Explanations a owl:Class ;
    rdfs:label "Explanations" ;
    rdfs:comment "Explainable derivation artifacts associated with procedural decisions. Maps to pko:Explanation and pko:hasExplanation." .

effortless-ntwf:explanationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Explanations ;
    rdfs:range xsd:string ;
    rdfs:label "ExplanationId" ;
    rdfs:comment "Stored logical identifier for one Explanations row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Explanations row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version explained." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Step explained." .

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Explanation title." .

effortless-ntwf:description a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Description" ;
    rdfs:comment "What the explanation traces." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: FAQs ===
effortless-ntwf:FAQs a owl:Class ;
    rdfs:label "FAQs" ;
    rdfs:comment "Frequently asked procedural questions. Maps to pko:FrequentlyAskedQuestion, question, answer, hasFAQCategory, and hasFAQTarget." .

effortless-ntwf:faqId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FAQs ;
    rdfs:range xsd:string ;
    rdfs:label "FaqId" ;
    rdfs:comment "Stored logical identifier for one FAQs row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the FAQs row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version addressed by the FAQ." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Optional step targeted by the FAQ." .

effortless-ntwf:category a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FAQs ;
    rdfs:range xsd:string ;
    rdfs:label "Category" ;
    rdfs:comment "FAQ category." .

effortless-ntwf:targetKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FAQs ;
    rdfs:range xsd:string ;
    rdfs:label "TargetKind" ;
    rdfs:comment "Procedure, Step, Tool, Resource, or Execution." .

effortless-ntwf:question a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Question" ;
    rdfs:comment "FAQ question; maps to pko:question." .

effortless-ntwf:answer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FAQs ;
    rdfs:range xsd:string ;
    rdfs:label "Answer" ;
    rdfs:comment "Approved answer; maps to pko:answer." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: FieldGrants ===
effortless-ntwf:FieldGrants a owl:Class ;
    rdfs:label "FieldGrants" ;
    rdfs:comment "Field-level grants: the HORIZONTAL cut. One row per principal x field. A field with no grant row is not filtered from the principal's view -- it is absent from it, so the column does not exist as far as that principal's SQL is concerned." .

effortless-ntwf:fieldGrantId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FieldGrants ;
    rdfs:range xsd:string ;
    rdfs:label "FieldGrantId" ;
    rdfs:comment "Stored logical identifier, e.g. 'fg-controller-Procedures.Title'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:principal a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:AccessPrincipals ;
    rdfs:label "Principal" ;
    rdfs:comment "Principal receiving the grant." .

effortless-ntwf:targetField a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:RulebookFields ;
    rdfs:label "TargetField" ;
    rdfs:comment "Catalogued field being exposed." .

effortless-ntwf:canRead a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FieldGrants ;
    rdfs:range xsd:boolean ;
    rdfs:label "CanRead" ;
    rdfs:comment "True when the principal may read this field." .

effortless-ntwf:canWrite a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FieldGrants ;
    rdfs:range xsd:boolean ;
    rdfs:label "CanWrite" ;
    rdfs:comment "True when the principal may write this field." .

effortless-ntwf:maskStrategy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FieldGrants ;
    rdfs:range xsd:string ;
    rdfs:label "MaskStrategy" ;
    rdfs:comment "How the value is presented when read: 'plain', 'redacted' or 'hashed'." .

effortless-ntwf:fieldTable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FieldGrants ;
    rdfs:range xsd:string ;
    rdfs:label "FieldTable" ;
    rdfs:comment "Table the granted field belongs to." .
    # calculated: lookup

effortless-ntwf:fieldName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "FieldName" ;
    rdfs:comment "Name of the granted field." .
    # calculated: lookup

effortless-ntwf:fieldIsDerived a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FieldGrants ;
    rdfs:range xsd:boolean ;
    rdfs:label "FieldIsDerived" ;
    rdfs:comment "Whether the granted field is a derived (calculated/lookup/aggregation) field." .
    # calculated: lookup

effortless-ntwf:isWritableDerivedField a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FieldGrants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWritableDerivedField" ;
    rdfs:comment "True when a derived field has been granted write access. Derived fields are computed by the substrate and cannot be written -- such a grant is incoherent and must be corrected." .
    # calculated: calculated

effortless-ntwf:isMasked a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FieldGrants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMasked" ;
    rdfs:comment "True when the value is transformed rather than shown verbatim." .
    # calculated: calculated

effortless-ntwf:grantKeyWhenReadable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FieldGrants ;
    rdfs:range xsd:string ;
    rdfs:label "GrantKeyWhenReadable" ;
    rdfs:comment "Composite echo of principal and table, blank unless readable. Enables single-criterion COUNTIFS rollups of readable columns per principal per table, per the documented multi-criteria COUNTIFS defect." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

