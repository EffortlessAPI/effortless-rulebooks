    rdfs:comment "Exact PKO class IRI." .

# === Class: IssuedTokens ===
effortless-ntwf:IssuedTokens a owl:Class ;
    rdfs:label "IssuedTokens" ;
    rdfs:comment "Audit trail of every token minted. A token records which user signed in, which principal they chose, and the claims that were joined from the database at mint time -- so a later question of 'what could this session see' is answerable from data rather than reconstruction." .

effortless-ntwf:issuedTokenId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssuedTokens ;
    rdfs:range xsd:string ;
    rdfs:label "IssuedTokenId" ;
    rdfs:comment "Stored logical identifier for one mint event." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:appUser a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:AppUsers ;
    rdfs:label "AppUser" ;
    rdfs:comment "Identity that signed in." .

effortless-ntwf:principal a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:AccessPrincipals ;
    rdfs:label "Principal" ;
    rdfs:comment "Principal the token authorises." .

effortless-ntwf:issuedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "IssuedAt" ;
    rdfs:comment "When the token was minted." .

effortless-ntwf:expiresAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssuedTokens ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ExpiresAt" ;
    rdfs:comment "When the token stops being accepted." .

effortless-ntwf:issuer a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssuedTokens ;
    rdfs:range xsd:string ;
    rdfs:label "Issuer" ;
    rdfs:comment "Who minted it: 'dev-mint' locally, or the magic-links tenant URL in production." .

effortless-ntwf:subjectClaim a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssuedTokens ;
    rdfs:range xsd:string ;
    rdfs:label "SubjectClaim" ;
    rdfs:comment "The 'sub' claim: the AppUserId the bearer is asserted to be." .

effortless-ntwf:claimsSnapshot a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssuedTokens ;
    rdfs:range xsd:string ;
    rdfs:label "ClaimsSnapshot" ;
    rdfs:comment "JSON of the additional claims joined from the database at mint time." .

effortless-ntwf:isDevMinted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IssuedTokens ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDevMinted" ;
    rdfs:comment "True when issued by the local dev minter rather than a real magic-links tenant. Dev tokens are genuine RS256 tokens with a genuine keypair; they simply skip the email round-trip." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: JwtClaimMappings ===
effortless-ntwf:JwtClaimMappings a owl:Class ;
    rdfs:label "JwtClaimMappings" ;
    rdfs:comment "Maps verified JWT claims onto the SQL accessors row predicates call. Magic-links is the notary: it asserts only that the bearer controls an email address. This table records how that verified email, and any additional claims, become values a policy can test." .

effortless-ntwf:jwtClaimMappingId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:JwtClaimMappings ;
    rdfs:range xsd:string ;
    rdfs:label "JwtClaimMappingId" ;
    rdfs:comment "Stored logical identifier, e.g. 'claim-email'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:claimName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:JwtClaimMappings ;
    rdfs:range xsd:string ;
    rdfs:label "ClaimName" ;
    rdfs:comment "Claim key as it appears in the verified JWT payload, e.g. 'email'." .

effortless-ntwf:sqlAccessor a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:JwtClaimMappings ;
    rdfs:range xsd:string ;
    rdfs:label "SqlAccessor" ;
    rdfs:comment "SQL function a policy calls to read the claim, e.g. 'app.jwt_email()'." .

effortless-ntwf:isReservedClaim a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:JwtClaimMappings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReservedClaim" ;
    rdfs:comment "True for claims magic-links controls and an app cannot override: email, iss, iat, nbf, exp, sub, tenant_id." .

effortless-ntwf:mapsToPrincipal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:JwtClaimMappings ;
    rdfs:range xsd:boolean ;
    rdfs:label "MapsToPrincipal" ;
    rdfs:comment "True when this claim is what resolves the caller to an AccessPrincipals row." .

effortless-ntwf:description2 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:JwtClaimMappings ;
    rdfs:range xsd:string ;
    rdfs:label "Description2" ;
    rdfs:comment "What the claim asserts and who vouches for it." .

effortless-ntwf:usageCount a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "UsageCount" ;
    rdfs:comment "Number of policies whose predicate calls this accessor." .
    # calculated: aggregation

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: KnowledgeBrokerLinks ===
effortless-ntwf:KnowledgeBrokerLinks a owl:Class ;
    rdfs:label "KnowledgeBrokerLinks" ;
    rdfs:comment "An informal expertise-network edge: one agent naming another as who they actually go to for a topic, independent of any formal Role or RoleAssignment. RoleAssignments and CommunitiesOfPractice record who is SUPPOSED to know something; this records who people ACTUALLY rely on." .

effortless-ntwf:knowledgeBrokerLinkId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeBrokerLinkId" ;
    rdfs:comment "Stored logical identifier for one KnowledgeBrokerLinks row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the KnowledgeBrokerLinks row." .
    # calculated: calculated

effortless-ntwf:seeker a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "Seeker" ;
    rdfs:comment "The agent who goes to someone else for this topic." .

effortless-ntwf:broker a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "Broker" ;
    rdfs:comment "The agent who is actually consulted, whether or not they hold a formal role for it." .

effortless-ntwf:topic a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range effortless-ntwf:VocabularyTerms ;
    rdfs:label "Topic" ;
    rdfs:comment "The controlled topic this reliance is about." .

effortless-ntwf:frequency a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "Frequency" ;
    rdfs:comment "Rarely, Sometimes, or Often." .

effortless-ntwf:lastConsultedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastConsultedAt" ;
    rdfs:comment "When the seeker last actually consulted the broker on this topic." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged under." .
    # calculated: lookup

effortless-ntwf:daysSinceConsulted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceConsulted" ;
    rdfs:comment "Days elapsed since the seeker last consulted the broker." .
    # calculated: calculated

effortless-ntwf:isActiveReliance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsActiveReliance" ;
    rdfs:comment "TRUE when this is a live, ongoing informal dependency rather than a one-off or stale contact." .
    # calculated: calculated

effortless-ntwf:brokerIsStillEngaged a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:boolean ;
    rdfs:label "BrokerIsStillEngaged" ;
    rdfs:comment "Whether the broker being relied on still holds any current role at all." .
    # calculated: lookup

effortless-ntwf:isAtRiskReliance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAtRiskReliance" ;
    rdfs:comment "TRUE when someone is actively relying on a broker who has already left every role they held." .
    # calculated: calculated

effortless-ntwf:activeRelianceBrokerKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "ActiveRelianceBrokerKey" ;
    rdfs:comment "Composite-key echo: the broker this link names when the reliance is active, else blank." .
    # calculated: calculated

effortless-ntwf:atRiskBrokerKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeBrokerLinks ;
    rdfs:range xsd:string ;
    rdfs:label "AtRiskBrokerKey" ;
    rdfs:comment "Composite-key echo: the broker this link names when the reliance is at risk, else blank." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: KnowledgeFragments ===
effortless-ntwf:KnowledgeFragments a owl:Class ;
    rdfs:label "KnowledgeFragments" ;
    rdfs:comment "Explicit records of tacit, implicit, explicit, and situated procedural knowledge. This is an ERB-PKO extension represented as provenance-bearing dcat:Resource instances." .

effortless-ntwf:knowledgeFragmentId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeFragmentId" ;
    rdfs:comment "Stored logical identifier for one KnowledgeFragments row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the KnowledgeFragments row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version informed by the fragment." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Optional step to which the fragment applies." .

effortless-ntwf:knowledgeForm a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeForm" ;
    rdfs:comment "Tacit, Implicit, Explicit, SituatedJudgment, LessonLearned, or another declared form." .

effortless-ntwf:statement a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Statement" ;
    rdfs:comment "Captured knowledge statement." .

effortless-ntwf:elicitationSession a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range effortless-ntwf:ElicitationSessions ;
    rdfs:label "ElicitationSession" ;
    rdfs:comment "Optional elicitation session that produced the fragment." .

effortless-ntwf:sourceAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "SourceAgent" ;
    rdfs:comment "Practitioner or source agent." .

effortless-ntwf:confidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "Confidence" ;
    rdfs:comment "Low, Medium, or High confidence." .

effortless-ntwf:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ValidFrom" ;
    rdfs:comment "Start of the fragment's valid-time interval." .

effortless-ntwf:validTo a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ValidTo" ;
    rdfs:comment "End of the fragment's valid-time interval." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Draft, Reviewed, Approved, Rejected, or Superseded." .

effortless-ntwf:ownerRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "OwnerRole" ;
    rdfs:comment "Role accountable for maintaining the fragment." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:isCurrentlyValid a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrentlyValid" ;
    rdfs:comment "TRUE when the fragment is approved and valid now." .
    # calculated: calculated

effortless-ntwf:sourceAgentIsStillEngaged a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "SourceAgentIsStillEngaged" ;
    rdfs:comment "Whether the agent who is the source of this claim still holds a role here." .
    # calculated: lookup

effortless-ntwf:sourceAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "SourceAgentKind" ;
    rdfs:comment "Whether the source of this claim is a Human, an AIAgent, or an AutomatedPipeline." .
    # calculated: lookup

effortless-ntwf:hasHumanSource a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasHumanSource" ;
    rdfs:comment "TRUE when the claim originates from a human practitioner rather than software." .
    # calculated: calculated

effortless-ntwf:hasOrphanedProvenance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOrphanedProvenance" ;
    rdfs:comment "TRUE when we still rely on this claim but the agent who gave it to us no longer holds a role here." .
    # calculated: calculated

effortless-ntwf:isUndefendableTacitClaim a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUndefendableTacitClaim" ;
    rdfs:comment "TRUE when an orphaned claim is of a kind that lives in a person's head rather than in a document." .
    # calculated: calculated

effortless-ntwf:isApproved a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsApproved" ;
    rdfs:comment "TRUE when this claim has passed knowledge-authority approval." .
    # calculated: calculated

effortless-ntwf:isWithinValidityWindow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWithinValidityWindow" ;
    rdfs:comment "TRUE when this claim's stated validity window contains the present moment." .
    # calculated: calculated

effortless-ntwf:isReliedUpon a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReliedUpon" ;
    rdfs:comment "TRUE when this claim is attached to a specific step and is inside its validity window — i.e. it is operationally in play." .
    # calculated: calculated

effortless-ntwf:stepProcedureVersionStatus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "StepProcedureVersionStatus" ;
    rdfs:comment "The procedure version owning the step this claim is attached to." .
    # calculated: lookup

effortless-ntwf:isAttachedToLiveVersion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAttachedToLiveVersion" ;
    rdfs:comment "Whether the procedure version this claim belongs to is currently executable." .
    # calculated: lookup

effortless-ntwf:isUnapprovedButReliedOn a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnapprovedButReliedOn" ;
    rdfs:comment "TRUE when a live procedure is acting on a claim that has not been approved by the knowledge authority." .
    # calculated: calculated

effortless-ntwf:evidenceAgeDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:integer ;
    rdfs:label "EvidenceAgeDays" ;
    rdfs:comment "Age in days of the elicitation session this claim came from." .
    # calculated: lookup

effortless-ntwf:hasRecordedElicitation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRecordedElicitation" ;
    rdfs:comment "TRUE when this claim traces to a recorded elicitation session." .
    # calculated: calculated

effortless-ntwf:isFromSingleWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFromSingleWitness" ;
    rdfs:comment "Whether this claim rests on a single practitioner's account." .
    # calculated: lookup

effortless-ntwf:evidenceExpiryDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:integer ;
    rdfs:label "EvidenceExpiryDays" ;
    rdfs:comment "How many days this claim's evidence is trusted for, given how it was gathered." .
    # calculated: calculated

effortless-ntwf:evidenceHasExpired a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "EvidenceHasExpired" ;
    rdfs:comment "TRUE when the evidence behind this claim is older than we trust evidence of its kind to be." .
    # calculated: calculated

effortless-ntwf:ownerAgent a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OwnerAgent" ;
    rdfs:comment "The agent currently holding the role that owns this claim." .
    # calculated: lookup

effortless-ntwf:isAwaitingApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAwaitingApproval" ;
    rdfs:comment "TRUE when this claim has been reviewed but not yet approved." .
    # calculated: calculated

effortless-ntwf:ownerIsMe a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "OwnerIsMe" ;
    rdfs:comment "TRUE when the People Policy Owner role owns this claim." .
    # calculated: calculated

effortless-ntwf:isMyUnfinishedApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMyUnfinishedApproval" ;
    rdfs:comment "TRUE when a claim I own has been reviewed and is waiting on my approval." .
    # calculated: calculated

effortless-ntwf:isInvokedByAnException a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:integer ;
    rdfs:label "IsInvokedByAnException" ;
    rdfs:comment "How many documented exception handlers trigger on the same step this claim is attached to." .
    # calculated: aggregation

effortless-ntwf:hasOperationalReliance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOperationalReliance" ;
    rdfs:comment "TRUE when an exception handler exists on the step this claim governs." .
    # calculated: calculated

effortless-ntwf:isUnapprovedAndOperationallyLive a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnapprovedAndOperationallyLive" ;
    rdfs:comment "TRUE when a claim awaiting my approval is already being acted on through a documented exception path." .
    # calculated: calculated

effortless-ntwf:ageDays a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "AgeDays" ;
    rdfs:comment "Days since this claim became valid." .
    # calculated: calculated

effortless-ntwf:isLowConfidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLowConfidence" ;
    rdfs:comment "TRUE when this claim was recorded with less than high confidence." .
    # calculated: calculated

effortless-ntwf:owningVersionCadenceDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:integer ;
    rdfs:label "OwningVersionCadenceDays" ;
    rdfs:comment "The review cadence promised for the version this claim supports." .
    # calculated: lookup

effortless-ntwf:exceedsOwningCadence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExceedsOwningCadence" ;
    rdfs:comment "TRUE when this claim is older than the review cadence promised for the version it supports." .
    # calculated: calculated

effortless-ntwf:isAgingLowConfidenceClaim a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAgingLowConfidenceClaim" ;
    rdfs:comment "TRUE when a claim we were never sure about has also outlived its version's review cadence." .
    # calculated: calculated

effortless-ntwf:ownerRoleAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "OwnerRoleAgentKind" ;
    rdfs:comment "Agent kind of whoever currently holds the role that owns this knowledge fragment." .
    # calculated: lookup

effortless-ntwf:isHumanOwned a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHumanOwned" ;
    rdfs:comment "TRUE when the owning role is currently held by a human." .
    # calculated: calculated

effortless-ntwf:isAiValidatedByAi a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAiValidatedByAi" ;
    rdfs:comment "TRUE when knowledge came from a non-human source AND is owned by a non-human-held role." .
    # calculated: calculated

effortless-ntwf:reviewCadenceDays a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "ReviewCadenceDays" ;
    rdfs:comment "The review cadence promised for the procedure version this fragment supports, resolved via ProcedureVersions because INDEX/MATCH only matches a target primary key." .
    # calculated: lookup

effortless-ntwf:isOverdueForReview a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverdueForReview" ;
    rdfs:comment "TRUE when a currently-valid fragment has gone longer than its stewardship cadence without review." .
    # calculated: calculated

effortless-ntwf:predatesCurrentRoleHolder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "PredatesCurrentRoleHolder" ;
    rdfs:comment "TRUE when this knowledge became valid before the current holder of its owning role took the role." .
    # calculated: calculated

effortless-ntwf:ownerRoleAssignmentValidFrom a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:dateTime ;
    rdfs:label "OwnerRoleAssignmentValidFrom" ;
    rdfs:comment "When the current holder of the owning role took that role." .
    # calculated: lookup

effortless-ntwf:lastReviewedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastReviewedAt" ;
    rdfs:comment "When this fragment was last actually reviewed and reaffirmed by its owning role. Null when it has never been reviewed since authoring. IsOverdueForReview infers recency from ValidFrom, which records when the claim became TRUE, not when anyone last looked at it. Those are different events, and the inference is deliberately left in place under its own name rather than silently rewritten to fall back on this column." .

effortless-ntwf:fragilitySignalCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:integer ;
    rdfs:label "FragilitySignalCount" ;
    rdfs:comment "How many of the four loop-1 decay signals are simultaneously true for this fragment: single witness, overdue for review, low confidence, operational reliance." .
    # calculated: calculated

effortless-ntwf:isCompoundFragile a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCompoundFragile" ;
    rdfs:comment "A fragment carrying at least three of the four decay signals at once." .
    # calculated: calculated

effortless-ntwf:isSinglePointOfFailure a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSinglePointOfFailure" ;
    rdfs:comment "A claim that rests on exactly one person's word and that an active exception handler actually routes cases against." .
    # calculated: calculated

effortless-ntwf:isExpiringSinglePointOfFailure a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExpiringSinglePointOfFailure" ;
    rdfs:comment "A single-sourced, operationally relied-upon claim that is also past its review date." .
    # calculated: calculated

effortless-ntwf:compoundFragileVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "CompoundFragileVersionKey" ;
    rdfs:comment "Composite-key echo: this fragment's procedure version when the fragment is compound-fragile, blank otherwise." .
    # calculated: calculated

effortless-ntwf:validFragmentSessionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "ValidFragmentSessionKey" ;
    rdfs:comment "Composite-key echo: the elicitation session behind this fragment when the fragment is currently valid, blank otherwise." .
    # calculated: calculated

effortless-ntwf:consumingStepIsSoftwareAssigned a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "ConsumingStepIsSoftwareAssigned" ;
    rdfs:comment "Whether the step that consumes this fragment is assigned to an AI agent or an automated pipeline." .
    # calculated: lookup

effortless-ntwf:consumingStepAgentKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "ConsumingStepAgentKind" ;
    rdfs:comment "The kind of agent currently holding the role assigned to the step that consumes this fragment." .
    # calculated: lookup

effortless-ntwf:isUnapprovedAndMachineConsumed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnapprovedAndMachineConsumed" ;
    rdfs:comment "An unapproved claim that a software-assigned step actually relies on — executed literally, with no human in position to notice it is wrong." .
    # calculated: calculated

effortless-ntwf:isUnapprovedAndHumanConsumed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnapprovedAndHumanConsumed" ;
    rdfs:comment "An unapproved claim relied on by a human-assigned step — a reviewable risk rather than a silent one." .
    # calculated: calculated

effortless-ntwf:machineConsumedUnapprovedVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "MachineConsumedUnapprovedVersionKey" ;
    rdfs:comment "Composite-key echo: this fragment's procedure version when the fragment is unapproved and machine-consumed, blank otherwise." .
    # calculated: calculated

effortless-ntwf:hasReviewRecord a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasReviewRecord" ;
    rdfs:comment "Whether this fragment has ever had an actual review recorded, as opposed to merely having a ValidFrom date." .
    # calculated: calculated

effortless-ntwf:daysSinceActualReview a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceActualReview" ;
    rdfs:comment "Days elapsed since this fragment was last actually reviewed. Zero when no review has ever been recorded — read this only alongside HasReviewRecord, never on its own." .
    # calculated: calculated

effortless-ntwf:isUnreviewedSinceAuthoring a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnreviewedSinceAuthoring" ;
    rdfs:comment "A currently-valid claim that nobody has ever reviewed since it was written." .
    # calculated: calculated

effortless-ntwf:isGenuinelyOverdue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGenuinelyOverdue" ;
    rdfs:comment "A valid claim whose LAST ACTUAL REVIEW is older than the cadence its owning version promised." .
    # calculated: calculated

effortless-ntwf:reviewRecencyIsInferred a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "ReviewRecencyIsInferred" ;
    rdfs:comment "A fragment reported overdue by the loop-1 inference purely because no review has ever been recorded — the number is an artifact of missing data, not evidence of neglect." .
    # calculated: calculated

effortless-ntwf:inferenceDisagreesWithRecord a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "InferenceDisagreesWithRecord" ;
    rdfs:comment "A fragment the ValidFrom inference calls overdue but which was in fact reviewed inside its cadence — a false positive in the loop-1 predicate, now provable." .
    # calculated: calculated

effortless-ntwf:genuinelyOverdueVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "GenuinelyOverdueVersionKey" ;
    rdfs:comment "Composite-key echo: this fragment's procedure version when the fragment is genuinely overdue, blank otherwise." .
    # calculated: calculated

effortless-ntwf:ratifiedBoundaryCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "RatifiedBoundaryCount" ;
    rdfs:comment "How many currently-binding authority boundaries this fragment ratifies." .
    # calculated: aggregation

effortless-ntwf:relianceSurfaceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:integer ;
    rdfs:label "RelianceSurfaceCount" ;
    rdfs:comment "Total number of distinct downstream dependents on this claim: exception handlers plus ratified authority boundaries." .
    # calculated: calculated

effortless-ntwf:daysAwaitingMyApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysAwaitingMyApproval" ;
    rdfs:comment "How long a claim of mine has been sitting at Reviewed without my approval. Zero when the claim is not mine or is already decided." .
    # calculated: calculated

effortless-ntwf:isHighBlastRadiusUnapproved a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHighBlastRadiusUnapproved" ;
    rdfs:comment "An unapproved, operationally live claim of mine with more than one distinct downstream dependent." .
    # calculated: calculated

effortless-ntwf:isLongUnapproved a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLongUnapproved" ;
    rdfs:comment "A claim that has waited on my signature for more than thirty days." .
    # calculated: calculated

effortless-ntwf:unapprovedLoadBearingVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "UnapprovedLoadBearingVersionKey" ;
    rdfs:comment "Composite-key echo: this fragment's procedure version when it is a high-blast-radius unapproved claim, blank otherwise." .
    # calculated: calculated

effortless-ntwf:ownerRoleIsVacated a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "OwnerRoleIsVacated" ;
    rdfs:comment "Whether the role that owns this claim is currently vacated." .
    # calculated: lookup

effortless-ntwf:isOrphanedByRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOrphanedByRole" ;
    rdfs:comment "A currently-valid claim whose owning role nobody holds — accountable to a vacancy." .
    # calculated: calculated

effortless-ntwf:validFragmentVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeFragments ;
    rdfs:range xsd:string ;
    rdfs:label "ValidFragmentVersionKey" ;
    rdfs:comment "Composite-key echo: this fragment's owning procedure version when the fragment is currently valid, blank otherwise." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: KnowledgeGaps ===
effortless-ntwf:KnowledgeGaps a owl:Class ;
    rdfs:label "KnowledgeGaps" ;
    rdfs:comment "Known unknowns and missing procedural coverage. Explicit ERB-PKO extension used to govern scope and prevent silent incompleteness." .

effortless-ntwf:knowledgeGapId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:string ;
    rdfs:label "KnowledgeGapId" ;
    rdfs:comment "Stored logical identifier for one KnowledgeGaps row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the KnowledgeGaps row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Affected procedure version." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Affected step." .

effortless-ntwf:statement a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Statement" ;
    rdfs:comment "What is not yet known or represented." .

effortless-ntwf:severity a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Severity" ;
    rdfs:comment "Low, Medium, High, or Critical." .

effortless-ntwf:blockingKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:string ;
    rdfs:label "BlockingKind" ;
    rdfs:comment "Blocking or NonBlocking." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Open, Investigating, Resolved, AcceptedRisk, or Closed." .

effortless-ntwf:ownerRole a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Roles ;
    rdfs:label "OwnerRole" ;
    rdfs:comment "Role responsible for resolving the gap." .

effortless-ntwf:identifiedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:dateTime ;
    rdfs:label "IdentifiedAt" ;
    rdfs:comment "Time the gap was identified." .

effortless-ntwf:resolutionPlan a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:string ;
    rdfs:label "ResolutionPlan" ;
    rdfs:comment "Resolution plan or final resolution." .

effortless-ntwf:isOpen a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOpen" ;
    rdfs:comment "TRUE when the gap remains open." .
    # calculated: calculated

effortless-ntwf:openGapVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:string ;
    rdfs:label "OpenGapVersionKey" ;
    rdfs:comment "Echoes the ProcedureVersion id for open high-severity knowledge gaps." .
    # calculated: calculated

effortless-ntwf:isBlocking a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBlocking" ;
    rdfs:comment "TRUE when this gap is declared blocking rather than informational." .
    # calculated: calculated

effortless-ntwf:isOpenAndBlocking a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOpenAndBlocking" ;
    rdfs:comment "TRUE when this gap is both unresolved and declared blocking." .
    # calculated: calculated

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:daysOpen a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysOpen" ;
    rdfs:comment "Days this gap has been unresolved, or zero once closed." .
    # calculated: calculated

effortless-ntwf:toleranceDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:integer ;
    rdfs:label "ToleranceDays" ;
    rdfs:comment "How long a gap of this severity may remain open before it becomes a governance failure in its own right." .
    # calculated: calculated

effortless-ntwf:isOverdueGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverdueGap" ;
    rdfs:comment "TRUE when this acknowledged unknown has outlived the tolerance for its severity." .
    # calculated: calculated

effortless-ntwf:ownerAgent a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "OwnerAgent" ;
    rdfs:comment "The agent currently holding the role that owns resolving this gap." .
    # calculated: lookup

effortless-ntwf:ownerIsStillEngaged a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:boolean ;
    rdfs:label "OwnerIsStillEngaged" ;
    rdfs:comment "Whether the agent responsible for closing this gap still holds a role here." .
    # calculated: lookup

effortless-ntwf:hasResolutionPlan a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasResolutionPlan" ;
    rdfs:comment "TRUE when someone has written down how this gap would be closed." .
    # calculated: calculated

effortless-ntwf:isAbandonedUnknown a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAbandonedUnknown" ;
    rdfs:comment "TRUE when an overdue gap has either no plan or no living owner — an admission of ignorance that nobody is acting on." .
    # calculated: calculated

effortless-ntwf:openBlockingGapVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:string ;
    rdfs:label "OpenBlockingGapVersionKey" ;
    rdfs:comment "Composite-key echo: this gap's procedure version when the gap is both open and blocking, blank otherwise." .
    # calculated: calculated

effortless-ntwf:ownerRoleIsVacated a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "OwnerRoleIsVacated" ;
    rdfs:comment "Whether the role that owns this gap is currently vacated." .
    # calculated: lookup

effortless-ntwf:isOwnerlessOpenGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:KnowledgeGaps ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOwnerlessOpenGap" ;
    rdfs:comment "An open gap whose owning role nobody currently holds — an acknowledged unknown with nobody accountable for closing it." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: LearningActivities ===
effortless-ntwf:LearningActivities a owl:Class ;
    rdfs:label "LearningActivities" ;
    rdfs:comment "Learning, retrospective, tabletop, and onboarding activities that convert execution experience into maintained knowledge. Explicit ERB-PKO extension represented as prov:Activity." .

effortless-ntwf:learningActivityId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:LearningActivities ;
    rdfs:range xsd:string ;
    rdfs:label "LearningActivityId" ;
    rdfs:comment "Stored logical identifier for one LearningActivities row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the LearningActivities row." .
    # calculated: calculated

effortless-ntwf:communityOfPractice a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:CommunitiesOfPractice ;
    rdfs:label "CommunityOfPractice" ;
    rdfs:comment "Community hosting the activity." .

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version practiced or reviewed." .

effortless-ntwf:activityKind a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:LearningActivities ;
    rdfs:range xsd:string ;
    rdfs:label "ActivityKind" ;
    rdfs:comment "Retrospective, TabletopExercise, Onboarding, Drill, or Apprenticeship." .

effortless-ntwf:occurredAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "OccurredAt" ;
    rdfs:comment "Activity time." .

effortless-ntwf:facilitatorAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "FacilitatorAgent" ;
    rdfs:comment "Facilitator." .

effortless-ntwf:outcome a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Outcome" ;
    rdfs:comment "Knowledge or competence produced." .

effortless-ntwf:evidenceResource a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:LearningActivities ;
    rdfs:range effortless-ntwf:Resources ;
    rdfs:label "EvidenceResource" ;
    rdfs:comment "Evidence or material produced." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Class IRI used in projection." .

# === Class: Mentorships ===
effortless-ntwf:Mentorships a owl:Class ;
    rdfs:label "Mentorships" ;
    rdfs:comment "Time-bounded apprenticeship relationships that intentionally transfer situated procedural knowledge. Explicit ERB-PKO extension." .

effortless-ntwf:mentorshipId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Mentorships ;
    rdfs:range xsd:string ;
    rdfs:label "MentorshipId" ;
    rdfs:comment "Stored logical identifier for one Mentorships row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Mentorships row." .
    # calculated: calculated

effortless-ntwf:communityOfPractice a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:CommunitiesOfPractice ;
    rdfs:label "CommunityOfPractice" ;
    rdfs:comment "Community in which the mentorship operates." .

effortless-ntwf:mentorAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Mentorships ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "MentorAgent" ;
    rdfs:comment "Experienced practitioner serving as mentor." .

effortless-ntwf:learnerAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Mentorships ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "LearnerAgent" ;
    rdfs:comment "Practitioner learning the procedure." .

effortless-ntwf:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ValidFrom" ;
    rdfs:comment "Mentorship start." .

effortless-ntwf:validTo a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ValidTo" ;
    rdfs:comment "Mentorship end." .

effortless-ntwf:learningObjective a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Mentorships ;
    rdfs:range xsd:string ;
    rdfs:label "LearningObjective" ;
    rdfs:comment "Procedural capability to be transferred." .

effortless-ntwf:evidenceOfCompletion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Mentorships ;
    rdfs:range xsd:string ;
    rdfs:label "EvidenceOfCompletion" ;
    rdfs:comment "Evidence showing completion or competence." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: MessageDeliveries ===
effortless-ntwf:MessageDeliveries a owl:Class ;
    rdfs:label "MessageDeliveries" ;
    rdfs:comment "MessageDeliveries (added by witness loop 1)." .

effortless-ntwf:messageDeliveryId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "MessageDeliveryId" ;
    rdfs:comment "Stored logical identifier for one MessageDeliveries row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the MessageDeliveries row." .
    # calculated: calculated

effortless-ntwf:procedureExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "ProcedureExecution" ;
    rdfs:comment "The procedure execution this send was performed under." .

effortless-ntwf:stepExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "StepExecution" ;
    rdfs:comment "The step execution that performed the send." .

effortless-ntwf:recipient a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Recipients ;
    rdfs:label "Recipient" ;
    rdfs:comment "Who the message was sent to." .

effortless-ntwf:messageTemplate a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:MessageTemplates ;
    rdfs:label "MessageTemplate" ;
    rdfs:comment "Template that was rendered for this send." .

effortless-ntwf:sentByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "SentByAgent" ;
    rdfs:comment "Agent that performed the send." .

effortless-ntwf:renderedBody a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "RenderedBody" ;
    rdfs:comment "The exact body text that was transmitted, after variable substitution." .

effortless-ntwf:sentAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "SentAt" ;
    rdfs:comment "Transmission timestamp." .

effortless-ntwf:sentAtLocalHour a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:integer ;
    rdfs:label "SentAtLocalHour" ;
    rdfs:comment "Hour of day 0-23 in the RECIPIENT's local timezone at transmission. Stored raw because recipient-local time is what the quiet-hours rule is written against and it is not derivable from SentAt alone." .

effortless-ntwf:deliveryStatus a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DeliveryStatus" ;
    rdfs:comment "Sent, Delivered, Failed, Suppressed, or Bounced." .

effortless-ntwf:suppressionReason a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "SuppressionReason" ;
    rdfs:comment "When DeliveryStatus is Suppressed, why; empty string otherwise." .

effortless-ntwf:invokedException a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range effortless-ntwf:Exceptions ;
    rdfs:label "InvokedException" ;
    rdfs:comment "Documented exception invoked for this delivery, when one was." .

effortless-ntwf:acknowledgedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AcknowledgedAt" ;
    rdfs:comment "When the recipient acknowledged; null when not acknowledged." .

effortless-ntwf:policyChannel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "PolicyChannel" ;
    rdfs:comment "The communication policy governing the template that was sent." .
    # calculated: lookup

effortless-ntwf:channelName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "ChannelName" ;
    rdfs:comment "Channel (Email, SMS) of the policy this delivery went out under." .
    # calculated: lookup

effortless-ntwf:policyRequiresConsent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "PolicyRequiresConsent" ;
    rdfs:comment "Whether the governing policy requires active consent for this channel." .
    # calculated: lookup

effortless-ntwf:recipientHasSmsConsent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "RecipientHasSmsConsent" ;
    rdfs:comment "Whether the recipient of this delivery had SMS consent on file." .
    # calculated: lookup

effortless-ntwf:wasActuallyTransmitted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasActuallyTransmitted" ;
    rdfs:comment "TRUE when the message actually left our systems. Suppressed and Failed messages never reached the carrier." .
    # calculated: calculated

effortless-ntwf:isConsentViolation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConsentViolation" ;
    rdfs:comment "TRUE when a message was actually transmitted on a consent-required channel to a recipient without consent. This is the TCPA witness." .
    # calculated: calculated

effortless-ntwf:consentViolationPolicyKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "ConsentViolationPolicyKey" ;
    rdfs:comment "Carries the policy id only on rows that are consent violations; empty string otherwise." .
    # calculated: calculated

effortless-ntwf:policyQuietHoursStartHour a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:integer ;
    rdfs:label "PolicyQuietHoursStartHour" ;
    rdfs:comment "Quiet-hours start hour (0-23) from the governing policy." .
    # calculated: lookup

effortless-ntwf:policyQuietHoursEndHour a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:integer ;
    rdfs:label "PolicyQuietHoursEndHour" ;
    rdfs:comment "Quiet-hours end hour (0-23) from the governing policy." .
    # calculated: lookup

effortless-ntwf:policyHasQuietHours a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "PolicyHasQuietHours" ;
    rdfs:comment "TRUE when the governing policy actually declares a quiet-hours window. comm-email-policy has 00:00-00:00, meaning no window." .
    # calculated: calculated

effortless-ntwf:quietWindowWrapsMidnight a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "QuietWindowWrapsMidnight" ;
    rdfs:comment "TRUE when the quiet window crosses midnight (20:00 -> 08:00 does)." .
    # calculated: calculated

effortless-ntwf:isInsideQuietWindow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInsideQuietWindow" ;
    rdfs:comment "TRUE when the recipient-local send hour falls inside the declared quiet window, handling the midnight wrap correctly." .
    # calculated: calculated

effortless-ntwf:isQuietHoursViolation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsQuietHoursViolation" ;
    rdfs:comment "TRUE when a message was actually transmitted inside a declared quiet-hours window. The quiet-hours witness." .
    # calculated: calculated

effortless-ntwf:quietHoursViolationPolicyKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "QuietHoursViolationPolicyKey" ;
    rdfs:comment "Carries the policy id only on quiet-hours violations; empty string otherwise." .
    # calculated: calculated

effortless-ntwf:recipientIsUnreachable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "RecipientIsUnreachable" ;
    rdfs:comment "Whether the recipient has neither email nor mobile on file -- the exc-unreachable trigger." .
    # calculated: lookup

effortless-ntwf:isAcknowledged a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAcknowledged" ;
    rdfs:comment "TRUE when an acknowledgement timestamp is recorded for this delivery." .
    # calculated: calculated

effortless-ntwf:invokedExceptionCondition a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "InvokedExceptionCondition" ;
    rdfs:comment "The documented condition of the exception invoked on this delivery, if any." .
    # calculated: lookup

effortless-ntwf:hasUnreachableExceptionInvoked a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnreachableExceptionInvoked" ;
    rdfs:comment "TRUE when the documented unreachable-recipient exception was formally invoked on this delivery." .
    # calculated: calculated

effortless-ntwf:isFabricatedAcknowledgement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFabricatedAcknowledgement" ;
    rdfs:comment "TRUE when an acknowledgement is recorded for a recipient we could not reach. This is the misrepresentation witness." .
    # calculated: calculated

effortless-ntwf:isUnhandledUnreachable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnhandledUnreachable" ;
    rdfs:comment "TRUE when a recipient was unreachable but no documented exception was invoked -- the case fell on the floor silently." .
    # calculated: calculated

effortless-ntwf:unreachableFailureKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "UnreachableFailureKey" ;
    rdfs:comment "Carries the execution id on any unreachable-handling failure; empty string otherwise." .
    # calculated: calculated

effortless-ntwf:policyRetentionDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:integer ;
    rdfs:label "PolicyRetentionDays" ;
    rdfs:comment "Retention commitment in days inherited from the governing channel policy." .
    # calculated: lookup

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:ageDays a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "AgeDays" ;
    rdfs:comment "Days elapsed since transmission." .
    # calculated: calculated

effortless-ntwf:isWithinRetentionWindow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWithinRetentionWindow" ;
    rdfs:comment "TRUE while this delivery is still inside its committed retention period." .
    # calculated: calculated

effortless-ntwf:hasRenderedBody a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRenderedBody" ;
    rdfs:comment "TRUE when the exact transmitted text is still held on this record." .
    # calculated: calculated

effortless-ntwf:isEvidenceRequired a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEvidenceRequired" ;
    rdfs:comment "TRUE when we are still obliged to hold this message's text." .
    # calculated: calculated

effortless-ntwf:isRetentionBreach a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRetentionBreach" ;
    rdfs:comment "TRUE when we are obliged to hold the message text and do not. The evidentiary-gap witness." .
    # calculated: calculated

effortless-ntwf:retentionBreachExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "RetentionBreachExecutionKey" ;
    rdfs:comment "Carries the execution id on retention breaches; empty string otherwise." .
    # calculated: calculated

effortless-ntwf:sendingStepExecutionStep a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "SendingStepExecutionStep" ;
    rdfs:comment "Which procedure step this delivery was performed under." .
    # calculated: lookup

effortless-ntwf:executionHasClearedLegalReview a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExecutionHasClearedLegalReview" ;
    rdfs:comment "Whether legal review had passed for the execution this delivery belongs to." .
    # calculated: lookup

effortless-ntwf:isUnreviewedSend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnreviewedSend" ;
    rdfs:comment "TRUE when a message was transmitted under an execution whose legal review had not passed. The ungated-send witness." .
    # calculated: calculated

effortless-ntwf:renderedBodyLength a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:integer ;
    rdfs:label "RenderedBodyLength" ;
    rdfs:comment "Character length of the exact text that was actually transmitted." .
    # calculated: calculated

effortless-ntwf:policyMaxMessageLengthAtSend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:integer ;
    rdfs:label "PolicyMaxMessageLengthAtSend" ;
    rdfs:comment "The per-segment limit that governed this specific send." .
    # calculated: lookup

effortless-ntwf:segmentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:integer ;
    rdfs:label "SegmentCount" ;
    rdfs:comment "How many channel segments the transmitted text occupied." .
    # calculated: calculated

effortless-ntwf:policyMaxSegmentsAtSend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:integer ;
    rdfs:label "PolicyMaxSegmentsAtSend" ;
    rdfs:comment "The segment ceiling that governed this specific send." .
    # calculated: lookup

effortless-ntwf:isOverSegmentLimit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOverSegmentLimit" ;
    rdfs:comment "TRUE when a transmitted message split into more segments than the policy permits. The oversize witness." .
    # calculated: calculated

effortless-ntwf:templateHasValidApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "TemplateHasValidApproval" ;
    rdfs:comment "Whether the template used for this delivery had a properly-authorized approval." .
    # calculated: lookup

effortless-ntwf:isUnapprovedSend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnapprovedSend" ;
    rdfs:comment "TRUE when a message was transmitted using a template with no valid approval behind it." .
    # calculated: calculated

effortless-ntwf:policyRequiredOptOutPhrase a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "PolicyRequiredOptOutPhrase" ;
    rdfs:comment "The opt-out phrase required for this delivery's channel." .
    # calculated: lookup

effortless-ntwf:policyRequiresOptOut a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "PolicyRequiresOptOut" ;
    rdfs:comment "TRUE when the governing channel policy declares a required opt-out phrase at all." .
    # calculated: calculated

effortless-ntwf:optOutPhrasePosition a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:integer ;
    rdfs:label "OptOutPhrasePosition" ;
    rdfs:comment "Character position at which the required opt-out phrase appears in the transmitted text; 0 when absent." .
    # calculated: calculated

effortless-ntwf:hasOptOutPhrase a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOptOutPhrase" ;
    rdfs:comment "TRUE when the required opt-out phrase appears anywhere in the transmitted text." .
    # calculated: calculated

effortless-ntwf:isOptOutInFirstSegment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOptOutInFirstSegment" ;
    rdfs:comment "TRUE when the opt-out phrase falls inside the first segment, where it is guaranteed to be read." .
    # calculated: calculated

effortless-ntwf:isMissingRequiredOptOut a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMissingRequiredOptOut" ;
    rdfs:comment "TRUE when a transmitted message on an opt-out-required channel did not contain the phrase at all. The hard witness." .
    # calculated: calculated

effortless-ntwf:isOptOutAtRiskOfTruncation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOptOutAtRiskOfTruncation" ;
    rdfs:comment "TRUE when the opt-out phrase is present but sits beyond the first segment, where carrier truncation or out-of-order delivery can hide it. The soft witness." .
    # calculated: calculated

effortless-ntwf:isFailedDelivery a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFailedDelivery" ;
    rdfs:comment "TRUE when the message left our systems but did not land." .
    # calculated: calculated

effortless-ntwf:isSuppressed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSuppressed" ;
    rdfs:comment "TRUE when we deliberately chose not to transmit." .
    # calculated: calculated

effortless-ntwf:isTriaged a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTriaged" ;
    rdfs:comment "TRUE when some documented exception was formally invoked on this delivery -- i.e. a human or a rule picked it up." .
    # calculated: calculated

effortless-ntwf:isAbandonedFailure a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAbandonedFailure" ;
    rdfs:comment "TRUE when a delivery failed and no documented exception was invoked. The abandoned-bounce witness." .
    # calculated: calculated

effortless-ntwf:abandonedFailureExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "AbandonedFailureExecutionKey" ;
    rdfs:comment "Carries the execution id on abandoned failures; empty string otherwise." .
    # calculated: calculated

effortless-ntwf:reachedExecutionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "ReachedExecutionKey" ;
    rdfs:comment "Carries the execution id on confirmed-delivered messages; empty string otherwise." .
    # calculated: calculated

effortless-ntwf:templateWasSendable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "TemplateWasSendable" ;
    rdfs:comment "Whether the template used for this delivery was fully sendable under a current, matching approval." .
    # calculated: lookup

effortless-ntwf:isDriftedSend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDriftedSend" ;
    rdfs:comment "TRUE when a message was transmitted from a template that was not validly sendable at the time. The drift witness." .
    # calculated: calculated

effortless-ntwf:driftedSendTemplateKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "DriftedSendTemplateKey" ;
    rdfs:comment "Carries the template id on drifted sends; empty string otherwise." .
    # calculated: calculated

effortless-ntwf:wasSentOutsideBusinessHours a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasSentOutsideBusinessHours" ;
    rdfs:comment "TRUE when this message landed before 08:00 or after 18:00 in the recipient's local time." .
    # calculated: calculated

effortless-ntwf:wasDeliveredAndUnanswered a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasDeliveredAndUnanswered" ;
    rdfs:comment "TRUE when a message actually reached someone and no acknowledgement came back." .
    # calculated: calculated

effortless-ntwf:isPoorlyTimedUnanswered a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPoorlyTimedUnanswered" ;
    rdfs:comment "TRUE when an unanswered message was delivered outside business hours -- a timing hypothesis for the silence." .
    # calculated: calculated

effortless-ntwf:isWellTimedUnanswered a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWellTimedUnanswered" ;
    rdfs:comment "TRUE when a message was delivered at a reasonable hour and still drew no response." .
    # calculated: calculated

effortless-ntwf:unansweredTemplateKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "UnansweredTemplateKey" ;
    rdfs:comment "The template id when this delivery went unanswered, otherwise empty string." .
    # calculated: calculated

effortless-ntwf:transmittedTemplateKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "TransmittedTemplateKey" ;
    rdfs:comment "The template id when this delivery actually reached someone." .
    # calculated: calculated

effortless-ntwf:approvingAgentAtSend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "ApprovingAgentAtSend" ;
    rdfs:comment "The agent whose approval authorized this specific transmission, frozen at send time." .

effortless-ntwf:approvingRoleAtSend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:string ;
    rdfs:label "ApprovingRoleAtSend" ;
    rdfs:comment "The role that agent held when they approved, frozen at send time." .

effortless-ntwf:approvalDecidedAtSend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ApprovalDecidedAtSend" ;
    rdfs:comment "When the relied-upon approval was granted, frozen at send time." .

effortless-ntwf:approvalPrecededSend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "ApprovalPrecededSend" ;
    rdfs:comment "TRUE when the approval we relied on was granted before the message went out." .
    # calculated: calculated

effortless-ntwf:hasFrozenApprovalEvidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasFrozenApprovalEvidence" ;
    rdfs:comment "TRUE when this delivery carries a complete frozen record of who authorized it and when." .
    # calculated: calculated

effortless-ntwf:provenanceIsLiveDerived a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "ProvenanceIsLiveDerived" ;
    rdfs:comment "TRUE when we have no frozen evidence and the only available answer comes from recomputing against today's template state." .
    # calculated: calculated

effortless-ntwf:currentLastApprovalAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:dateTime ;
    rdfs:label "CurrentLastApprovalAt" ;
    rdfs:comment "The template's most recent approval time as it stands NOW, for comparison against what was approved at send." .
    # calculated: lookup

effortless-ntwf:templateReapprovedSinceSend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "TemplateReapprovedSinceSend" ;
    rdfs:comment "TRUE when the template has picked up a newer approval since this message was transmitted." .
    # calculated: calculated

effortless-ntwf:isUnprovableApprovalClaim a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnprovableApprovalClaim" ;
    rdfs:comment "TRUE when we assert this send was approved, hold no frozen evidence, and the template has been re-approved since. The claim cannot be substantiated from the record." .
    # calculated: calculated

effortless-ntwf:reminderSentAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ReminderSentAt" ;
    rdfs:comment "When I sent a follow-up reminder about this unacknowledged message. Empty when I never did." .

effortless-ntwf:reminderCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:integer ;
    rdfs:label "ReminderCount" ;
    rdfs:comment "How many reminders I have sent for this delivery." .

effortless-ntwf:hasSentReminder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasSentReminder" ;
    rdfs:comment "TRUE when at least one reminder went out for this delivery." .
    # calculated: calculated

effortless-ntwf:acknowledgementIsOutstanding a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "AcknowledgementIsOutstanding" ;
    rdfs:comment "TRUE when a message actually reached someone, carried an acknowledgement obligation, and has not been acknowledged." .
    # calculated: calculated

effortless-ntwf:outstandingAgeDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:integer ;
    rdfs:label "OutstandingAgeDays" ;
    rdfs:comment "How long this acknowledgement has been outstanding." .
    # calculated: calculated

effortless-ntwf:isUnchasedAcknowledgement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnchasedAcknowledgement" ;
    rdfs:comment "TRUE when an acknowledgement has been outstanding for more than 7 days and I have never sent a reminder." .
    # calculated: calculated

effortless-ntwf:isExhaustedFollowUp a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExhaustedFollowUp" ;
    rdfs:comment "TRUE when I have sent three or more reminders and still have no acknowledgement -- the point at which this stops being my work and becomes a human escalation." .
    # calculated: calculated

effortless-ntwf:needsHumanEscalation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageDeliveries ;
    rdfs:range xsd:boolean ;
    rdfs:label "NeedsHumanEscalation" ;
    rdfs:comment "TRUE when follow-up is exhausted and no exception has been invoked to close out the obligation." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension IRI; per-recipient delivery events are not a PKO 2.0.0 native class." .

# === Class: MessageTemplates ===
effortless-ntwf:MessageTemplates a owl:Class ;
    rdfs:label "MessageTemplates" ;
    rdfs:comment "Approved channel templates projected from the canonical rulebook without becoming a second source of policy meaning." .

effortless-ntwf:messageTemplateId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "MessageTemplateId" ;
    rdfs:comment "Stored logical identifier for one MessageTemplates row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the MessageTemplates row." .
    # calculated: calculated

effortless-ntwf:communicationPolicy a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range effortless-ntwf:CommunicationPolicies ;
    rdfs:label "CommunicationPolicy" ;
    rdfs:comment "Channel policy governing the template." .

effortless-ntwf:resource a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Resources ;
    rdfs:label "Resource" ;
    rdfs:comment "Template resource." .

effortless-ntwf:subjectTemplate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "SubjectTemplate" ;
    rdfs:comment "Subject template where supported." .

effortless-ntwf:bodyTemplate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "BodyTemplate" ;
    rdfs:comment "Body template." .

effortless-ntwf:locale a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "Locale" ;
    rdfs:comment "Locale or language tag." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Draft, Approved, Retired, or Superseded." .

effortless-ntwf:policyMaxMessageLength a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:integer ;
    rdfs:label "PolicyMaxMessageLength" ;
    rdfs:comment "Per-segment character limit inherited from the governing channel policy." .
    # calculated: lookup

effortless-ntwf:policyMaxSegments a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:integer ;
    rdfs:label "PolicyMaxSegments" ;
    rdfs:comment "Maximum permitted segment count from the governing channel policy." .
    # calculated: lookup

effortless-ntwf:bodyTemplateLength a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:integer ;
    rdfs:label "BodyTemplateLength" ;
    rdfs:comment "Character length of the raw template body before variable substitution." .
    # calculated: calculated

effortless-ntwf:isTemplateOverLength a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTemplateOverLength" ;
    rdfs:comment "TRUE when the template body alone already exceeds the single-segment limit before any variables are substituted in." .
    # calculated: calculated

effortless-ntwf:validApprovalCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "ValidApprovalCount" ;
    rdfs:comment "Number of properly-authorized approvals on record for this template." .
    # calculated: aggregation

effortless-ntwf:hasValidApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasValidApproval" ;
    rdfs:comment "TRUE when at least one properly-authorized approval exists for this template." .
    # calculated: calculated

effortless-ntwf:isClaimingUnbackedApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsClaimingUnbackedApproval" ;
    rdfs:comment "TRUE when a template's Status says Approved but no properly-authorized approval record backs it. The phantom-approval witness." .
    # calculated: calculated

effortless-ntwf:currentBodyHash a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentBodyHash" ;
    rdfs:comment "Digest of the template's current body text, maintained whenever the body is edited." .

effortless-ntwf:lastApprovedBodyHash a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "LastApprovedBodyHash" ;
    rdfs:comment "Digest of the body text as it stood at the most recent valid approval." .
    # calculated: lookup

effortless-ntwf:lastValidApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "LastValidApproval" ;
    rdfs:comment "The TemplateApprovals id of the approval this template is currently sendable under. Deliberately a raw identifier, not a relationship: TemplateApprovals already points at MessageTemplates, so declaring an FK back would make the two tables mutually dependent and the rulebook is required to stay acyclic. The value is still resolved by INDEX/MATCH in LastApprovedBodyHash." .

effortless-ntwf:hasBodyDrifted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasBodyDrifted" ;
    rdfs:comment "TRUE when the template body no longer matches what was approved." .
    # calculated: calculated

effortless-ntwf:isSendableUnderApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSendableUnderApproval" ;
    rdfs:comment "TRUE only when the template is marked Approved, has a properly-authorized approval, AND its body still matches what was approved." .
    # calculated: calculated

effortless-ntwf:driftedSendCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "DriftedSendCount" ;
    rdfs:comment "How many messages went out from this template while it was not validly sendable." .
    # calculated: aggregation

effortless-ntwf:unansweredDeliveryCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "UnansweredDeliveryCount" ;
    rdfs:comment "How many transmitted messages from this template drew no acknowledgement." .
    # calculated: aggregation

effortless-ntwf:transmittedDeliveryCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:string ;
    rdfs:label "TransmittedDeliveryCount" ;
    rdfs:comment "How many deliveries using this template were actually transmitted." .
    # calculated: aggregation

effortless-ntwf:templateDrawsNoResponse a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:boolean ;
    rdfs:label "TemplateDrawsNoResponse" ;
    rdfs:comment "TRUE when every transmitted message from this template went unacknowledged." .
    # calculated: calculated

effortless-ntwf:lastApprovalAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MessageTemplates ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastApprovalAt" ;
    rdfs:comment "When this template's currently-governing approval was decided." .
    # calculated: lookup

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Resource class IRI." .

# === Class: ObservedTransitions ===
effortless-ntwf:ObservedTransitions a owl:Class ;
    rdfs:label "ObservedTransitions" ;
    rdfs:comment "The proxy above cannot tell a walked fallback from a happy-path step that happens to share an endpoint. PKO models Transition as a first-class thing; its execution counterpart is missing. Without a table that records WHICH transition a step execution arrived by, 'has this fallback ever been walked' is permanently unanswerable rather than merely unanswered. This is an extension (urn:effortless:pko-extension#ObservedTransition), not a native PKO term." .

effortless-ntwf:observedTransitionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedTransitions ;
    rdfs:range xsd:string ;
    rdfs:label "ObservedTransitionId" ;
    rdfs:comment "Stored logical identifier for one ObservedTransitions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:procedureExecution a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureExecutions ;
    rdfs:label "ProcedureExecution" ;
    rdfs:comment "The procedure execution during which this transition was traversed." .

effortless-ntwf:stepTransition a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ObservedTransitions ;
    rdfs:range effortless-ntwf:StepTransitions ;
    rdfs:label "StepTransition" ;
    rdfs:comment "The specification-level transition that was actually taken." .

effortless-ntwf:arrivingStepExecution a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ObservedTransitions ;
    rdfs:range effortless-ntwf:StepExecutions ;
    rdfs:label "ArrivingStepExecution" ;
    rdfs:comment "The step execution that this traversal produced." .

effortless-ntwf:observedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ObservedAt" ;
    rdfs:comment "When the traversal occurred." .

effortless-ntwf:triggerReason a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ObservedTransitions ;
    rdfs:range xsd:string ;
    rdfs:label "TriggerReason" ;
    rdfs:comment "Why this path rather than the default was taken." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: OntologyProfiles ===
effortless-ntwf:OntologyProfiles a owl:Class ;
    rdfs:label "OntologyProfiles" ;
    rdfs:comment "Versioned ontology and vocabulary dependencies. PKO mappings always identify the exact profile and version." .

effortless-ntwf:ontologyProfileId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OntologyProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "OntologyProfileId" ;
    rdfs:comment "Stored logical identifier for one OntologyProfiles row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the OntologyProfiles row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Human-readable ontology or vocabulary name." .

effortless-ntwf:version a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OntologyProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "Version" ;
    rdfs:comment "Referenced release or specification version." .

effortless-ntwf:versionIri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OntologyProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "VersionIri" ;
    rdfs:comment "Exact version IRI or normative specification URI." .

effortless-ntwf:namespaceIri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OntologyProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "NamespaceIri" ;
    rdfs:comment "Namespace used for class/property IRIs." .

effortless-ntwf:license a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OntologyProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "License" ;
    rdfs:comment "License or standards body attribution." .

effortless-ntwf:scope a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OntologyProfiles ;
    rdfs:range xsd:string ;
    rdfs:label "Scope" ;
    rdfs:comment "How the profile is used in this rulebook." .

# === Class: OperationalBindings ===
effortless-ntwf:OperationalBindings a owl:Class ;
    rdfs:label "OperationalBindings" ;
    rdfs:comment "Live bindings between procedural semantics and operational data/resources. Explicit ERB-PKO extension using DCAT/DCMI/PROV identifiers." .

effortless-ntwf:operationalBindingId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:string ;
    rdfs:label "OperationalBindingId" ;
    rdfs:comment "Stored logical identifier for one OperationalBindings row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the OperationalBindings row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version using the binding." .

effortless-ntwf:step a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Steps ;
    rdfs:label "Step" ;
    rdfs:comment "Step using the binding." .

effortless-ntwf:resource a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Resources ;
    rdfs:label "Resource" ;
    rdfs:comment "Bound operational resource." .

effortless-ntwf:accessMode a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:string ;
    rdfs:label "AccessMode" ;
    rdfs:comment "Read, Write, ReadWrite, Subscribe, or Publish." .

effortless-ntwf:recordOrSchemaKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:string ;
    rdfs:label "RecordOrSchemaKey" ;
    rdfs:comment "Operational record, table, event, or schema key." .

effortless-ntwf:lastObservedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LastObservedAt" ;
    rdfs:comment "Most recent successful observation." .

effortless-ntwf:freshnessSlaMinutes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:integer ;
    rdfs:label "FreshnessSlaMinutes" ;
    rdfs:comment "Maximum allowed data age." .

effortless-ntwf:isAuthoritative a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAuthoritative" ;
    rdfs:comment "TRUE when the binding is authoritative for the represented fact." .

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:ageMinutes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:integer ;
    rdfs:label "AgeMinutes" ;
    rdfs:comment "Current observed age." .
    # calculated: calculated

effortless-ntwf:isFresh a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFresh" ;
    rdfs:comment "TRUE when within freshness SLA." .
    # calculated: calculated

effortless-ntwf:staleBindingStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:string ;
    rdfs:label "StaleBindingStepKey" ;
    rdfs:comment "Echoes the bound Step id only when the binding is outside its freshness SLA." .
    # calculated: calculated

effortless-ntwf:authoritativeStaleStepKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:string ;
    rdfs:label "AuthoritativeStaleStepKey" ;
    rdfs:comment "Echoes the bound Step id only when an AUTHORITATIVE binding is stale." .
    # calculated: calculated

effortless-ntwf:isStaleAndAuthoritative a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStaleAndAuthoritative" ;
    rdfs:comment "TRUE when an authoritative binding has aged past its freshness SLA." .
    # calculated: calculated

effortless-ntwf:stepWhenStale a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:string ;
    rdfs:label "StepWhenStale" ;
    rdfs:comment "Echoes the step id when this authoritative binding is stale, blank otherwise." .
    # calculated: calculated

effortless-ntwf:resourceIsApproved a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:boolean ;
    rdfs:label "ResourceIsApproved" ;
    rdfs:comment "Whether the resource behind this binding is an approved source." .
    # calculated: lookup

effortless-ntwf:isUsableForDrafting a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUsableForDrafting" ;
    rdfs:comment "TRUE when this binding points at an approved source that is still inside its freshness SLA." .
    # calculated: calculated

effortless-ntwf:stepWhenUnusable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OperationalBindings ;
    rdfs:range xsd:string ;
    rdfs:label "StepWhenUnusable" ;
    rdfs:comment "Echoes the step id when this binding is NOT usable for drafting, blank otherwise." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Extension class IRI." .

# === Class: Organizations ===
effortless-ntwf:Organizations a owl:Class ;
    rdfs:label "Organizations" ;
    rdfs:comment "Organizations that own, adopt, govern, or execute procedures. Maps to prov:Organization." .

effortless-ntwf:organizationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Organizations ;
    rdfs:range xsd:string ;
    rdfs:label "OrganizationId" ;
    rdfs:comment "Stored logical identifier for one Organizations row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the Organizations row." .
    # calculated: calculated

effortless-ntwf:displayName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DisplayName" ;
    rdfs:comment "Organization's human-readable name." .

effortless-ntwf:organizationType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Organizations ;
    rdfs:range xsd:string ;
    rdfs:label "OrganizationType" ;
    rdfs:comment "Type such as Company, Department, Vendor, or Regulator." .

effortless-ntwf:externalIdentifier a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Organizations ;
    rdfs:range xsd:string ;
    rdfs:label "ExternalIdentifier" ;
    rdfs:comment "Identifier in an operational directory or master-data system." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact RDF class IRI for the organization." .

# === Class: PrincipalAssignments ===
effortless-ntwf:PrincipalAssignments a owl:Class ;
    rdfs:label "PrincipalAssignments" ;
    rdfs:comment "Which principals a user may act as. The authorization half of sign-in: a verified email proves who you are, this table decides what you may become. A user with two assignments picks one at sign-in, and the choice is verified here rather than accepted from the client." .

effortless-ntwf:principalAssignmentId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:PrincipalAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "PrincipalAssignmentId" ;
    rdfs:comment "Stored logical identifier, e.g. 'pa-maria-finance-analyst'." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias." .
    # calculated: calculated

effortless-ntwf:appUser a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:AppUsers ;
    rdfs:label "AppUser" ;
    rdfs:comment "Sign-in identity being granted." .

effortless-ntwf:principal a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:AccessPrincipals ;
    rdfs:label "Principal" ;
    rdfs:comment "Principal the user may act as." .

effortless-ntwf:isDefault a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:PrincipalAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDefault" ;
    rdfs:comment "True for the principal selected when the user does not name one." .

effortless-ntwf:grantedRationale a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:PrincipalAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "GrantedRationale" ;
    rdfs:comment "Why this user may act as this principal." .

effortless-ntwf:principalIsAdmin a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "PrincipalIsAdmin" ;
    rdfs:comment "Whether the assigned principal is an administrator." .
    # calculated: lookup

effortless-ntwf:userOrganization a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:PrincipalAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "UserOrganization" ;
    rdfs:comment "Organization of the signing-in user." .
    # calculated: lookup

effortless-ntwf:principalOrganization a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:PrincipalAssignments ;
    rdfs:range xsd:string ;
    rdfs:label "PrincipalOrganization" ;
    rdfs:comment "Organization of the principal being assumed." .
    # calculated: lookup

effortless-ntwf:isCrossOrganizationGrant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:PrincipalAssignments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCrossOrganizationGrant" ;
    rdfs:comment "True when a user is allowed to act as a principal in a different organization. Legitimate for shared-service roles, but it crosses the tenancy boundary and should be deliberate rather than accidental." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Semantic type IRI." .

# === Class: ProcedureExecutions ===
effortless-ntwf:ProcedureExecutions a owl:Class ;
    rdfs:label "ProcedureExecutions" ;
    rdfs:comment "Concrete enactments of procedure specifications. Maps to pko:ProcedureExecution and remains separate from ProcedureVersions." .

effortless-ntwf:procedureExecutionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ProcedureExecutionId" ;
    rdfs:comment "Stored logical identifier for one ProcedureExecutions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the ProcedureExecutions row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Exact procedure specification executed; maps to pko:hasExecutedProcedure." .

effortless-ntwf:executionStatus a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ExecutionStatus" ;
    rdfs:comment "PKO execution status: InProgress, Completed, Paused, or Cancelled." .

effortless-ntwf:startedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "StartedAt" ;
    rdfs:comment "Execution start; maps to prov:startedAtTime." .

effortless-ntwf:endedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "EndedAt" ;
    rdfs:comment "Execution end; maps to prov:endedAtTime." .

effortless-ntwf:executedByAgent a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ExecutedByAgent" ;
    rdfs:comment "Agent accountable for the overall execution; maps to pko:wasExecutedBy." .

effortless-ntwf:context a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "Context" ;
    rdfs:comment "Execution-specific scope or target." .

effortless-ntwf:operationalRecordUri a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "OperationalRecordUri" ;
    rdfs:comment "Identifier in the operational execution system." .

effortless-ntwf:expectedStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ExpectedStepCount" ;
    rdfs:comment "How many steps this execution was supposed to perform." .
    # calculated: lookup

effortless-ntwf:completedStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "CompletedStepCount" ;
    rdfs:comment "How many steps of this execution actually reached Completed." .
    # calculated: aggregation

effortless-ntwf:controlBreachCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ControlBreachCount" ;
    rdfs:comment "Total step executions in this run that carry at least one control breach." .
    # calculated: aggregation

effortless-ntwf:lateStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "LateStepCount" ;
    rdfs:comment "How many steps in this execution ran long." .
    # calculated: aggregation

effortless-ntwf:isStructurallyComplete a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStructurallyComplete" ;
    rdfs:comment "TRUE when every specified step of the procedure version reached Completed in this execution." .
    # calculated: calculated

effortless-ntwf:divergedFromSpecification a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "DivergedFromSpecification" ;
    rdfs:comment "TRUE when the execution either skipped specified steps or carried at least one control breach." .
    # calculated: calculated

effortless-ntwf:allBlockingControlsEvaluated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "AllBlockingControlsEvaluated" ;
    rdfs:comment "TRUE when every blocking requirement bound to every step of this execution received a satisfaction record." .
    # calculated: calculated

effortless-ntwf:unevaluatedBlockingTotal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UnevaluatedBlockingTotal" ;
    rdfs:comment "How many step executions in this run left at least one blocking control unevaluated." .
    # calculated: aggregation

effortless-ntwf:separationOfDutiesHeld a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "SeparationOfDutiesHeld" ;
    rdfs:comment "TRUE when no agent both prepared and approved within this execution." .
    # calculated: calculated

effortless-ntwf:separationViolationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "SeparationViolationCount" ;
    rdfs:comment "Number of segregation-of-duties violations in this execution." .
    # calculated: aggregation

effortless-ntwf:isAttestationReady a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAttestationReady" ;
    rdfs:comment "TRUE only when every step completed, no control breached, every blocking control was actually evaluated, and segregation of duties held." .
    # calculated: calculated

effortless-ntwf:attestationBlockerSummary a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "AttestationBlockerSummary" ;
    rdfs:comment "Names the highest-severity reason the attestation cannot be signed, or empty when it can." .
    # calculated: calculated

effortless-ntwf:executedVersionIsFit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ExecutedVersionIsFit" ;
    rdfs:comment "Whether the procedure version this execution ran against is currently fit to execute." .
    # calculated: lookup

effortless-ntwf:signedAgainstUnfitVersion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "SignedAgainstUnfitVersion" ;
    rdfs:comment "TRUE when a completed execution was run against a procedure version the organization no longer stands behind." .
    # calculated: calculated

effortless-ntwf:assertedOnlyControlCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "AssertedOnlyControlCount" ;
    rdfs:comment "How many blocking controls in this execution passed on human assertion alone." .
    # calculated: aggregation

effortless-ntwf:assuranceIsMostlyAsserted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "AssuranceIsMostlyAsserted" ;
    rdfs:comment "TRUE when any blocking control in this execution passed without a computed witness behind it." .
    # calculated: calculated

effortless-ntwf:unreachableHandlingFailureCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UnreachableHandlingFailureCount" ;
    rdfs:comment "Number of deliveries in this execution where unreachable handling was wrong -- either fabricated acknowledgement or no exception invoked." .
    # calculated: aggregation

effortless-ntwf:retentionBreachCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "RetentionBreachCount" ;
    rdfs:comment "Number of transmitted messages in this execution whose text we no longer hold despite an active retention obligation." .
    # calculated: aggregation

effortless-ntwf:clearedLegalReviewCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ClearedLegalReviewCount" ;
    rdfs:comment "How many passed legal reviews exist for this execution." .
    # calculated: aggregation

effortless-ntwf:hasClearedLegalReview a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasClearedLegalReview" ;
    rdfs:comment "TRUE when legal review has passed for this execution." .
    # calculated: calculated

effortless-ntwf:abandonedFailureCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "AbandonedFailureCount" ;
    rdfs:comment "Number of failed deliveries in this run that nobody picked up." .
    # calculated: aggregation

effortless-ntwf:deliveredCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "DeliveredCount" ;
    rdfs:comment "Number of confirmed-delivered messages in this run." .
    # calculated: aggregation

effortless-ntwf:totalDeliveryAttemptCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "TotalDeliveryAttemptCount" ;
    rdfs:comment "Total delivery records of any status for this run." .
    # calculated: aggregation

effortless-ntwf:hasAbandonedFailures a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasAbandonedFailures" ;
    rdfs:comment "TRUE when this run has any untriaged delivery failure." .
    # calculated: calculated

effortless-ntwf:mishandledRefusalCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "MishandledRefusalCount" ;
    rdfs:comment "Number of gate refusals in this run that were either overridden or silently dropped." .
    # calculated: aggregation

effortless-ntwf:uncleanStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UncleanStepCount" ;
    rdfs:comment "Number of step executions in this run that were not clean." .
    # calculated: aggregation

effortless-ntwf:ranClean a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "RanClean" ;
    rdfs:comment "TRUE when every step execution in this run was clean." .
    # calculated: calculated

effortless-ntwf:countOfApprovalExecutions a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfApprovalExecutions" ;
    rdfs:comment "How many human approval gates were executed in this run." .
    # calculated: aggregation

effortless-ntwf:hasHumanApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasHumanApproval" ;
    rdfs:comment "TRUE when at least one human approval gate was executed in this run." .
    # calculated: calculated

effortless-ntwf:countOfDeliveryExecutions a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfDeliveryExecutions" ;
    rdfs:comment "How many times the send step ran in this execution." .
    # calculated: aggregation

effortless-ntwf:hasDelivered a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasDelivered" ;
    rdfs:comment "TRUE when this run has sent communications to employees." .
    # calculated: calculated

effortless-ntwf:deliveredWithoutApproval a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "DeliveredWithoutApproval" ;
    rdfs:comment "TRUE when a run sent employee communications without executing a human approval gate." .
    # calculated: calculated

effortless-ntwf:invalidApprovalCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "InvalidApprovalCount" ;
    rdfs:comment "Number of approval-type requirements in this run that are incomplete or non-human-evaluated." .
    # calculated: aggregation

effortless-ntwf:approvalChainIsComplete a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ApprovalChainIsComplete" ;
    rdfs:comment "TRUE when every approval-type requirement in this run is fully satisfied by a human." .
    # calculated: calculated

effortless-ntwf:vacuouslyCleanStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "VacuouslyCleanStepCount" ;
    rdfs:comment "How many steps in this run were clean only because nothing checked them." .
    # calculated: aggregation

effortless-ntwf:preparationStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "PreparationStepCount" ;
    rdfs:comment "How many preparation steps this execution actually ran." .
    # calculated: aggregation

effortless-ntwf:approvalStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ApprovalStepCount" ;
    rdfs:comment "How many approval steps this execution actually ran." .
    # calculated: aggregation

effortless-ntwf:separationWasTestable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "SeparationWasTestable" ;
    rdfs:comment "TRUE when this execution contained both a preparation step and an approval step, so segregation of duties had an opportunity to fail." .
    # calculated: calculated

effortless-ntwf:separationHeldUnderTest a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "SeparationHeldUnderTest" ;
    rdfs:comment "TRUE only when segregation of duties both could have failed and did not." .
    # calculated: calculated

effortless-ntwf:separationIsVacuouslyGreen a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "SeparationIsVacuouslyGreen" ;
    rdfs:comment "TRUE when the segregation control reports as held on a run where it could not have failed." .
    # calculated: calculated

effortless-ntwf:separationAssuranceNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "SeparationAssuranceNote" ;
    rdfs:comment "The sentence that goes into the control narrative for this execution." .
    # calculated: calculated

effortless-ntwf:ungovernedDivergenceCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UngovernedDivergenceCount" ;
    rdfs:comment "How many steps in this run departed from spec with nothing authorising the departure." .
    # calculated: aggregation

effortless-ntwf:divergenceWasFullyGoverned a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "DivergenceWasFullyGoverned" ;
    rdfs:comment "TRUE when this run departed from specification and every departure was authorised." .
    # calculated: calculated

effortless-ntwf:computedlyWitnessedControlCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ComputedlyWitnessedControlCount" ;
    rdfs:comment "How many blocking controls in this run were cleared by something computed." .
    # calculated: aggregation

effortless-ntwf:evaluatedControlCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "EvaluatedControlCount" ;
    rdfs:comment "Total blocking controls actually evaluated in this run, computed and asserted together." .
    # calculated: calculated

effortless-ntwf:computedAssuranceRatio a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ComputedAssuranceRatio" ;
    rdfs:comment "The fraction of evaluated blocking controls in this run that rest on a computed witness rather than a human assertion." .
    # calculated: calculated

effortless-ntwf:interestedPartyAssertionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "InterestedPartyAssertionCount" ;
    rdfs:comment "How many controls in this run were cleared by assertion from someone with an interest in the outcome." .
    # calculated: aggregation

effortless-ntwf:assuranceGrade a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "AssuranceGrade" ;
    rdfs:comment "Names the quality of the assurance behind this execution, worst case first." .
    # calculated: calculated

effortless-ntwf:attestationWouldBeWeaklyBased a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "AttestationWouldBeWeaklyBased" ;
    rdfs:comment "TRUE when the model says I may sign, but the basis for that permission is mostly or partly unwitnessed assertion." .
    # calculated: calculated

effortless-ntwf:independentHumanObservationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "IndependentHumanObservationCount" ;
    rdfs:comment "How many verifications in this run were independently observed by a human with evidence attached." .
    # calculated: aggregation

effortless-ntwf:hasAnyIndependentObservation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasAnyIndependentObservation" ;
    rdfs:comment "TRUE when at least one verification in this run was independently observed by a human." .
    # calculated: calculated

effortless-ntwf:selfAttestedApprovalCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "SelfAttestedApprovalCount" ;
    rdfs:comment "How many approval steps in this run rested on self-attestation." .
    # calculated: aggregation

effortless-ntwf:assuranceChainIsCircular a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "AssuranceChainIsCircular" ;
    rdfs:comment "TRUE when every approval in this run rests on self-attestation and no independent human observation exists anywhere in it." .
    # calculated: calculated

effortless-ntwf:latestAttestationInstant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:dateTime ;
    rdfs:label "LatestAttestationInstant" ;
    rdfs:comment "The most recent signature instant for this execution." .
    # calculated: aggregation

effortless-ntwf:hasBeenAttested a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasBeenAttested" ;
    rdfs:comment "TRUE when someone has signed for this execution." .
    # calculated: calculated

effortless-ntwf:attestationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "AttestationCount" ;
    rdfs:comment "How many signatures exist against this execution." .
    # calculated: aggregation

effortless-ntwf:postAttestationScoreCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "PostAttestationScoreCount" ;
    rdfs:comment "How many controls were scored after this execution was signed." .
    # calculated: aggregation

effortless-ntwf:basisChangedAfterSignature a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "BasisChangedAfterSignature" ;
    rdfs:comment "TRUE when controls this attestation depended on were scored after the signature was given." .
    # calculated: calculated

effortless-ntwf:requiresReAttestation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "RequiresReAttestation" ;
    rdfs:comment "TRUE when the basis changed after signature AND the execution no longer reads as attestable." .
    # calculated: calculated

effortless-ntwf:intendedRecipientCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "IntendedRecipientCount" ;
    rdfs:comment "How many sends this campaign proposed to make." .
    # calculated: aggregation

effortless-ntwf:reachedRecipientCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "ReachedRecipientCount" ;
    rdfs:comment "How many of those sends actually left our systems." .
    # calculated: aggregation

effortless-ntwf:silentlyDroppedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "SilentlyDroppedCount" ;
    rdfs:comment "How many intended recipients disappeared from this campaign with no record." .
    # calculated: aggregation

effortless-ntwf:deliveryYieldPercent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "DeliveryYieldPercent" ;
    rdfs:comment "Percentage of intended recipients who actually received the communication." .
    # calculated: calculated

effortless-ntwf:campaignSilentlyLostAudience a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "CampaignSilentlyLostAudience" ;
    rdfs:comment "TRUE when a campaign lost intended recipients without producing any record of the loss." .
    # calculated: calculated

effortless-ntwf:unrecordedRefusalCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "UnrecordedRefusalCount" ;
    rdfs:comment "How many sends this execution refused without recording the refusal anywhere." .
    # calculated: aggregation

effortless-ntwf:hasUnrecordedRefusals a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnrecordedRefusals" ;
    rdfs:comment "TRUE when this run contains at least one refusal that left no trace anywhere." .
    # calculated: calculated

effortless-ntwf:independentlyConfirmedIntentCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:string ;
    rdfs:label "IndependentlyConfirmedIntentCount" ;
    rdfs:comment "How many of this execution's send decisions were corroborated by a delivery record." .
    # calculated: aggregation

effortless-ntwf:sendDecisionsAreEntirelySelfWitnessed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureExecutions ;
    rdfs:range xsd:boolean ;
    rdfs:label "SendDecisionsAreEntirelySelfWitnessed" ;
    rdfs:comment "TRUE when no send decision in this run was confirmed by anything other than the pipeline itself." .
    # calculated: calculated

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: ProcedureResources ===
effortless-ntwf:ProcedureResources a owl:Class ;
    rdfs:label "ProcedureResources" ;
    rdfs:comment "Links versioned procedures to supporting resources using PKO/dcterms provenance relations." .

effortless-ntwf:procedureResourceId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureResources ;
    rdfs:range xsd:string ;
    rdfs:label "ProcedureResourceId" ;
    rdfs:comment "Stored logical identifier for one ProcedureResources row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the ProcedureResources row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version." .

effortless-ntwf:resource a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Resources ;
    rdfs:label "Resource" ;
    rdfs:comment "Referenced or source resource." .

effortless-ntwf:relation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureResources ;
    rdfs:range xsd:string ;
    rdfs:label "Relation" ;
    rdfs:comment "wasExtractedFrom, references, generated, used, or another declared relation." .

effortless-ntwf:relationIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RelationIri" ;
    rdfs:comment "Exact semantic property IRI for the relation." .
    # calculated: calculated

# === Class: ProcedureStatusChanges ===
effortless-ntwf:ProcedureStatusChanges a owl:Class ;
    rdfs:label "ProcedureStatusChanges" ;
    rdfs:comment "Lifecycle events that move a procedure version between PKO statuses. Maps to pko:ChangeOfStatus, fromStatus, toStatus, and prov:atTime." .

effortless-ntwf:procedureStatusChangeId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureStatusChanges ;
    rdfs:range xsd:string ;
    rdfs:label "ProcedureStatusChangeId" ;
    rdfs:comment "Stored logical identifier for one ProcedureStatusChanges row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the ProcedureStatusChanges row." .
    # calculated: calculated

effortless-ntwf:procedureVersion a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "ProcedureVersion" ;
    rdfs:comment "Procedure version whose status changed." .

effortless-ntwf:fromStatus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureStatusChanges ;
    rdfs:range xsd:string ;
    rdfs:label "FromStatus" ;
    rdfs:comment "Previous PKO status." .

effortless-ntwf:toStatus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureStatusChanges ;
    rdfs:range xsd:string ;
    rdfs:label "ToStatus" ;
    rdfs:comment "New PKO status." .

effortless-ntwf:changedAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureStatusChanges ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ChangedAt" ;
    rdfs:comment "Time of change; maps to prov:atTime." .

effortless-ntwf:changedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ProcedureStatusChanges ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ChangedByAgent" ;
    rdfs:comment "Agent responsible for the change." .

effortless-ntwf:motivation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureStatusChanges ;
    rdfs:range xsd:string ;
    rdfs:label "Motivation" ;
    rdfs:comment "Reason for changing status." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact PKO class IRI." .

# === Class: ProcedureTypes ===
effortless-ntwf:ProcedureTypes a owl:Class ;
    rdfs:label "ProcedureTypes" ;
    rdfs:comment "Controlled values used by pko:hasProcedureType." .

effortless-ntwf:procedureTypeId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureTypes ;
    rdfs:range xsd:string ;
    rdfs:label "ProcedureTypeId" ;
    rdfs:comment "Stored logical identifier for one ProcedureTypes row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the ProcedureTypes row." .
    # calculated: calculated

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" ;
    rdfs:comment "Procedure type label." .

effortless-ntwf:definition a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Definition" ;
    rdfs:comment "Definition and scope of the procedure type." .

effortless-ntwf:semanticTypeIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SemanticTypeIri" ;
    rdfs:comment "Exact class IRI for procedure types." .

# === Class: ProcedureVersionLinks ===
effortless-ntwf:ProcedureVersionLinks a owl:Class ;
    rdfs:label "ProcedureVersionLinks" ;
    rdfs:comment "Directed links between versioned procedures. Maps to dcat:previousVersion/dcat:hasVersion and pko:nextVersion." .

effortless-ntwf:procedureVersionLinkId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersionLinks ;
    rdfs:range xsd:string ;
    rdfs:label "ProcedureVersionLinkId" ;
    rdfs:comment "Stored logical identifier for one ProcedureVersionLinks row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the ProcedureVersionLinks row." .
    # calculated: calculated

effortless-ntwf:previousProcedureVersion a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersionLinks ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "PreviousProcedureVersion" ;
    rdfs:comment "Earlier version." .

effortless-ntwf:nextProcedureVersion a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersionLinks ;
    rdfs:range effortless-ntwf:ProcedureVersions ;
    rdfs:label "NextProcedureVersion" ;
    rdfs:comment "Later version." .

effortless-ntwf:relationIri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RelationIri" ;
    rdfs:comment "Exact version relation IRI." .

effortless-ntwf:changeSummary a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersionLinks ;
    rdfs:range xsd:string ;
    rdfs:label "ChangeSummary" ;
    rdfs:comment "Summary of semantic change across the edge." .

effortless-ntwf:supersededVersionKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersionLinks ;
    rdfs:range xsd:string ;
    rdfs:label "SupersededVersionKey" ;
    rdfs:comment "Echoes the superseded (previous) version id for rows that express a next-version relation. Supersession is carried by RelationIri here, not by a separate link-kind column." .
    # calculated: calculated

# === Class: ProcedureVersions ===
effortless-ntwf:ProcedureVersions a owl:Class ;
    rdfs:label "ProcedureVersions" ;
    rdfs:comment "Versioned procedure specifications. Maps to pko:Procedure plus DCAT version relations and PKO versionNumber/newVersionMotivation/changelogDescription." .

effortless-ntwf:procedureVersionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "ProcedureVersionId" ;
    rdfs:comment "Stored logical identifier for one ProcedureVersions row." .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable calculated display alias for the ProcedureVersions row." .
    # calculated: calculated

effortless-ntwf:procedure a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range effortless-ntwf:Procedures ;
    rdfs:label "Procedure" ;
    rdfs:comment "Abstract procedure of which this is a version." .

effortless-ntwf:versionNumber a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "VersionNumber" ;
    rdfs:comment "Version number; maps to pko:versionNumber." .

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" ;
    rdfs:comment "Version-specific title." .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "PKO procedure status individual: Draft, Validation, Approval, Approved, Deprecated, or Archived." .

effortless-ntwf:issuedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "IssuedAt" ;
    rdfs:comment "Issue timestamp; maps to dcterms:issued." .

effortless-ntwf:modifiedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ModifiedAt" ;
    rdfs:comment "Last semantic modification; maps to dcterms:modified." .

effortless-ntwf:createdByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "CreatedByAgent" ;
    rdfs:comment "Agent that created the version; maps to dcterms:creator." .

effortless-ntwf:modifiedByAgent a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range effortless-ntwf:Agents ;
    rdfs:label "ModifiedByAgent" ;
    rdfs:comment "Agent that last modified the version; maps to pko:wasModifiedBy." .

effortless-ntwf:newVersionMotivation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "NewVersionMotivation" ;
    rdfs:comment "Reason for the new version; maps to pko:newVersionMotivation." .

effortless-ntwf:changelogDescription a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "ChangelogDescription" ;
    rdfs:comment "Semantic change description; maps to pko:changelogDescription." .

effortless-ntwf:isCurrent a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrent" ;
    rdfs:comment "TRUE when this is the current version." .

effortless-ntwf:countOfSteps a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfSteps" ;
    rdfs:comment "Number of steps in this version." .
    # calculated: aggregation

effortless-ntwf:countOfOpenKnowledgeGaps a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfOpenKnowledgeGaps" ;
    rdfs:comment "Open knowledge gaps for this version." .
    # calculated: aggregation

effortless-ntwf:isReadyForExecution a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReadyForExecution" ;
    rdfs:comment "TRUE when approved, populated, and free of blocking knowledge gaps." .
    # calculated: calculated

effortless-ntwf:specifiedStepCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "SpecifiedStepCount" ;
    rdfs:comment "How many steps the specification defines for this version." .
    # calculated: aggregation

effortless-ntwf:overdueReviewCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "OverdueReviewCount" ;
    rdfs:comment "How many reviews of this procedure version are past due." .
    # calculated: aggregation

effortless-ntwf:openChangeRequestCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "OpenChangeRequestCount" ;
    rdfs:comment "How many change requests are open against this version." .
    # calculated: aggregation

effortless-ntwf:openHighSeverityGapCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "OpenHighSeverityGapCount" ;
    rdfs:comment "How many high-severity knowledge gaps are open against this version." .
    # calculated: aggregation

effortless-ntwf:isFitToExecute a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFitToExecute" ;
    rdfs:comment "TRUE when this version is approved, current on review, and carries no open change request or high-severity gap." .
    # calculated: calculated

effortless-ntwf:stewardReviewCadenceDays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "StewardReviewCadenceDays" ;
    rdfs:comment "The review cadence promised by this version's stewardship assignment, in days. Summed because a version has at most one active steward; this is the hop that lets ReviewEvents resolve the promise via a primary-key match." .
    # calculated: aggregation

effortless-ntwf:countOfStewardshipAssignments a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfStewardshipAssignments" ;
    rdfs:comment "How many stewardship assignments of any vintage point at this version." .
    # calculated: aggregation

effortless-ntwf:hasAnySteward a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasAnySteward" ;
    rdfs:comment "TRUE if any stewardship assignment has ever named this version." .
    # calculated: calculated

effortless-ntwf:isLive a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLive" ;
    rdfs:comment "TRUE when this version is in a state where somebody could execute it." .
    # calculated: calculated

effortless-ntwf:isUnstewarded a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnstewarded" ;
    rdfs:comment "TRUE when no stewardship assignment names this version." .
    # calculated: calculated

effortless-ntwf:isLiveAndUnstewarded a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveAndUnstewarded" ;
    rdfs:comment "TRUE when an executable version has nobody accountable for keeping it healthy." .
    # calculated: calculated

effortless-ntwf:countOfOpenBlockingGaps a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfOpenBlockingGaps" ;
    rdfs:comment "How many open blocking gaps stand against this version." .
    # calculated: aggregation

effortless-ntwf:hasOpenBlockingGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOpenBlockingGap" ;
    rdfs:comment "TRUE when at least one open blocking gap stands against this version." .
    # calculated: calculated

effortless-ntwf:isLiveWithBlockingGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveWithBlockingGap" ;
    rdfs:comment "TRUE when an executable version carries an unresolved blocking knowledge gap." .
    # calculated: calculated

effortless-ntwf:shouldNotBeExecutable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ShouldNotBeExecutable" ;
    rdfs:comment "TRUE when the model says this version is ready to execute while a blocking gap is open against it." .
    # calculated: calculated

effortless-ntwf:countOfUnapprovedRelianceFragments a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfUnapprovedRelianceFragments" ;
    rdfs:comment "How many unapproved claims this version is relying on." .
    # calculated: aggregation

effortless-ntwf:runsOnUnapprovedKnowledge a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "RunsOnUnapprovedKnowledge" ;
    rdfs:comment "TRUE when this version depends on at least one claim the knowledge authority has not approved." .
    # calculated: calculated

effortless-ntwf:countOfOverdueGaps a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfOverdueGaps" ;
    rdfs:comment "How many acknowledged unknowns against this version have outlived their tolerance." .
    # calculated: aggregation

effortless-ntwf:countOfChangeRequests a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfChangeRequests" ;
    rdfs:comment "How many change requests have ever been raised against this version." .
    # calculated: aggregation

effortless-ntwf:countOfReviewEvents a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfReviewEvents" ;
    rdfs:comment "How many review events have ever been recorded against this version." .
    # calculated: aggregation

effortless-ntwf:hasGovernanceRecord a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasGovernanceRecord" ;
    rdfs:comment "TRUE when at least one change request or review event exists for this version." .
    # calculated: calculated

effortless-ntwf:evaluationContext a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:EvaluationContexts ;
    rdfs:label "EvaluationContext" ;
    rdfs:comment "The evaluation context this row's time-dependent witnesses are judged under." .

effortless-ntwf:asOfInstant a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "AsOfInstant" ;
    rdfs:comment "The evaluation instant this row's time-dependent witnesses are judged against." .
    # calculated: lookup

effortless-ntwf:daysSinceModified a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceModified" ;
    rdfs:comment "Days since this version's content was last changed." .
    # calculated: calculated

effortless-ntwf:daysSinceLastReview a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "DaysSinceLastReview" ;
    rdfs:comment "Days since the most recent review of this version." .
    # calculated: aggregation

effortless-ntwf:wasModifiedSinceLastReview a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "WasModifiedSinceLastReview" ;
    rdfs:comment "TRUE when the version was edited more recently than it was reviewed." .
    # calculated: calculated

effortless-ntwf:modifierIsAuthority a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "ModifierIsAuthority" ;
    rdfs:comment "The kind of agent that last modified this version." .
    # calculated: lookup

effortless-ntwf:hasUnwitnessedChange a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnwitnessedChange" ;
    rdfs:comment "TRUE when a live version's current content postdates every review it has had." .
    # calculated: calculated

effortless-ntwf:countOfStaleFragments a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfStaleFragments" ;
