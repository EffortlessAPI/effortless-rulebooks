effortless-ntwf:unrehearsedControlEntryCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "UnrehearsedControlEntryCount" ;
    rdfs:comment "How many unrehearsed control entries exist in this procedure version." .
    # calculated: aggregation

effortless-ntwf:hasUnrehearsedControlEntry a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasUnrehearsedControlEntry" ;
    rdfs:comment "Whether this live version has at least one blocking control that is only reachable by a path nobody has ever walked." .
    # calculated: calculated

effortless-ntwf:isLiveWithUnrehearsedControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiveWithUnrehearsedControl" ;
    rdfs:comment "A version that is live for execution while carrying at least one never-rehearsed blocking control entry." .
    # calculated: calculated

effortless-ntwf:cadenceBreachCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:string ;
    rdfs:label "CadenceBreachCount" ;
    rdfs:comment "How many review events on this version are past their promised cadence." .
    # calculated: aggregation

effortless-ntwf:isInCadenceBreach a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInCadenceBreach" ;
    rdfs:comment "Whether this version currently has at least one review event past the cadence its steward promised." .
    # calculated: calculated

effortless-ntwf:hasDecisionInFlight a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ProcedureVersions ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasDecisionInFlight" ;
    rdfs:comment "Whether this version has at least one change request that is still open." .
    # calculated: calculated

effortless-ntwf:isUnremediatedCadenceBreach a owl:DatatypeProperty ;
