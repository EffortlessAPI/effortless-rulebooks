                BIND(CONCAT("/admin/open-questions/", COALESCE(COALESCE(?open_question_id__key, IF(isIRI(?open_question_id), REPLACE(STR(?open_question_id), "^.*[#/]", ""), STR(?open_question_id))), "")) AS ?_result)
            }
