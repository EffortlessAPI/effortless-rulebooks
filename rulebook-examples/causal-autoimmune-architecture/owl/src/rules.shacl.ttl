    OPTIONAL { $this effortless-ntwf:diseaseDomainConceptId ?disease_domain_concept_id . OPTIONAL { ?disease_domain_concept_id erb:key ?disease_domain_concept_id__key . } }
                BIND(CONCAT("/admin/disease-concepts/", COALESCE(COALESCE(?disease_domain_concept_id__key, IF(isIRI(?disease_domain_concept_id), REPLACE(STR(?disease_domain_concept_id), "^.*[#/]", ""), STR(?disease_domain_concept_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DiseaseDomainConcepts_IsDeeplyModeled a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DiseaseDomainConcepts ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DiseaseDomainConcepts_IsDeeplyModeled" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isDeeplyModeled ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DiseaseDomainConcepts .
    OPTIONAL { $this effortless-ntwf:modelingStatus ?modeling_status . OPTIONAL { ?modeling_status erb:key ?modeling_status__key . } }
                BIND(IF(COALESCE((COALESCE(?modeling_status__key, COALESCE(IF(isIRI(?modeling_status), REPLACE(STR(?modeling_status), "^.*[#/]", ""), STR(?modeling_status)), "")) = "deep-dag"), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DiseaseDomainConcepts_IsSchemaModeled a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DiseaseDomainConcepts ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DiseaseDomainConcepts_IsSchemaModeled" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isSchemaModeled ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DiseaseDomainConcepts .
    OPTIONAL { $this effortless-ntwf:modelingStatus ?modeling_status . OPTIONAL { ?modeling_status erb:key ?modeling_status__key . } }
                BIND(IF(COALESCE((COALESCE((COALESCE(?modeling_status__key, COALESCE(IF(isIRI(?modeling_status), REPLACE(STR(?modeling_status), "^.*[#/]", ""), STR(?modeling_status)), "")) = "deep-dag"), false) || COALESCE((COALESCE(?modeling_status__key, COALESCE(IF(isIRI(?modeling_status), REPLACE(STR(?modeling_status), "^.*[#/]", ""), STR(?modeling_status)), "")) = "schema"), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for DiseaseStages ===
effortless-ntwf-shapes:DiseaseStages_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DiseaseStages ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DiseaseStages_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DiseaseStages .
    OPTIONAL { $this effortless-ntwf:autoimmuneDiseaseDiseaseLabel ?autoimmune_disease_disease_label . OPTIONAL { ?autoimmune_disease_disease_label erb:key ?autoimmune_disease_disease_label__key . } }
    OPTIONAL { $this effortless-ntwf:stageLabel ?stage_label . OPTIONAL { ?stage_label erb:key ?stage_label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?autoimmune_disease_disease_label__key, IF(isIRI(?autoimmune_disease_disease_label), REPLACE(STR(?autoimmune_disease_disease_label), "^.*[#/]", ""), STR(?autoimmune_disease_disease_label))), ""), " — ", COALESCE(COALESCE(?stage_label__key, IF(isIRI(?stage_label), REPLACE(STR(?stage_label), "^.*[#/]", ""), STR(?stage_label))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DiseaseStages_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DiseaseStages ;
