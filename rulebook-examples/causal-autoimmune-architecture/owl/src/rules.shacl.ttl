            }
            WHERE {
    $this a effortless-ntwf:VariantTypes .
    OPTIONAL { $this effortless-ntwf:variantTypeId ?variant_type_id . OPTIONAL { ?variant_type_id erb:key ?variant_type_id__key . } }
                BIND(CONCAT("/variant-types/", COALESCE(COALESCE(?variant_type_id__key, IF(isIRI(?variant_type_id), REPLACE(STR(?variant_type_id), "^.*[#/]", ""), STR(?variant_type_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:VariantTypes_CountOfGenomicVariants a sh:NodeShape ;
    sh:targetClass effortless-ntwf:VariantTypes ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_VariantTypes_CountOfGenomicVariants" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countOfGenomicVariants ?_result .
            }
            WHERE {
    $this a effortless-ntwf:VariantTypes .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:VariantTypes .
                    ?child a effortless-ntwf:GenomicVariants .
                    ?child effortless-ntwf:variantType ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:variantTypeId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Cardinality: single-valued forward FK properties ===
effortless-ntwf-shapes:MachineStatesCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:MachineStates ;
    sh:property [ sh:path effortless-ntwf:stateMachine ; sh:maxCount 1 ] .

effortless-ntwf-shapes:SerologyObservationsCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:property [ sh:path effortless-ntwf:individual ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:priorObservation ; sh:maxCount 1 ] .

effortless-ntwf-shapes:StateTransitionRulesCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateTransitionRules ;
    sh:property [ sh:path effortless-ntwf:fromState ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:stateMachine ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:toState ; sh:maxCount 1 ] .

effortless-ntwf-shapes:StateTransitionsCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateTransitions ;
    sh:property [ sh:path effortless-ntwf:stateMachine ; sh:maxCount 1 ] .

effortless-ntwf-shapes:SubjectStateInstancesCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SubjectStateInstances ;
    sh:property [ sh:path effortless-ntwf:enteredViaTransition ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:priorInstance ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:stateMachine ; sh:maxCount 1 ] .

