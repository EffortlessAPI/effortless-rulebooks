            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StateTransitions .
    OPTIONAL { $this effortless-ntwf:stateTransitionId ?state_transition_id . OPTIONAL { ?state_transition_id erb:key ?state_transition_id__key . } }
                BIND(CONCAT("/admin/state-machine/transitions/", COALESCE(COALESCE(?state_transition_id__key, IF(isIRI(?state_transition_id), REPLACE(STR(?state_transition_id), "^.*[#/]", ""), STR(?state_transition_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StateTransitions_IsForward a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateTransitions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StateTransitions_IsForward" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isForward ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StateTransitions .
    OPTIONAL { $this effortless-ntwf:toStateKey ?to_state_key . OPTIONAL { ?to_state_key erb:key ?to_state_key__key . } }
                BIND((!(COALESCE((COALESCE(?to_state_key__key, COALESCE(IF(isIRI(?to_state_key), REPLACE(STR(?to_state_key), "^.*[#/]", ""), STR(?to_state_key)), "")) = "Intake"), false))) AS ?_result)
            }
        """ ;
    ] .

