                BIND(IF(COALESCE(?individual_has_predicted_treatment_response, false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_TreatmentResponseDecidingFactor a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 14 ;
    sh:rule [
        a sh:SPARQLRule ;
