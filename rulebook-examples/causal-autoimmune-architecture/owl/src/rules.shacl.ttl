    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/stages/", COALESCE(COALESCE(?disease_stage_id__key, IF(isIRI(?disease_stage_id), REPLACE(STR(?disease_stage_id), "^.*[#/]", ""), STR(?disease_stage_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DiseaseStages_AutoimmuneDiseaseDiseaseLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DiseaseStages ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
