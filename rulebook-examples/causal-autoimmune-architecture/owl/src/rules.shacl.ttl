            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:predictedSeverityValue ?predicted_severity_value . }
                BIND(IF(COALESCE((COALESCE(?predicted_severity_value, 0) > 7), false), "Severe", IF(COALESCE((COALESCE(?predicted_severity_value, 0) >= 4), false), "Moderate", "Mild")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IsSeverityActionable a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 12 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IsSeverityActionable" ;
