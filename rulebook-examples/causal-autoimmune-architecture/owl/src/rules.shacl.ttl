effortless-ntwf-shapes:RoutingAndNavigation_Depth a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoutingAndNavigation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoutingAndNavigation_Depth" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:depth ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoutingAndNavigation .
    OPTIONAL { $this effortless-ntwf:parentRouteKey ?parent_route_key . OPTIONAL { ?parent_route_key erb:key ?parent_route_key__key . } }
    OPTIONAL { $this effortless-ntwf:routeKey ?route_key . }
                BIND(ROUND(IF(COALESCE((COALESCE(?parent_route_key__key, COALESCE(IF(isIRI(?parent_route_key), REPLACE(STR(?parent_route_key), "^.*[#/]", ""), STR(?parent_route_key)), "")) = ""), false), 0, (STRLEN(STR(?route_key)) - STRLEN(STR(REPLACE(?route_key, "\\\\.", "")))))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:RoutingAndNavigation_FullPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoutingAndNavigation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoutingAndNavigation_FullPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:fullPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoutingAndNavigation .
    OPTIONAL { $this effortless-ntwf:route ?route . }
                BIND(?route AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:RoutingAndNavigation_HandlerBaseName a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoutingAndNavigation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoutingAndNavigation_HandlerBaseName" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:handlerBaseName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoutingAndNavigation .
    OPTIONAL { $this effortless-ntwf:routeKey ?route_key . }
                BIND(REPLACE(REPLACE(?route_key, "\\\\.", " "), "-", " ") AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:RoutingAndNavigation_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:RoutingAndNavigation ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoutingAndNavigation_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:RoutingAndNavigation .
    OPTIONAL { $this effortless-ntwf:routingAndNavigationId ?routing_and_navigation_id . OPTIONAL { ?routing_and_navigation_id erb:key ?routing_and_navigation_id__key . } }
                BIND(CONCAT("/admin/routing/", COALESCE(COALESCE(?routing_and_navigation_id__key, IF(isIRI(?routing_and_navigation_id), REPLACE(STR(?routing_and_navigation_id), "^.*[#/]", ""), STR(?routing_and_navigation_id))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for SerologyObservations ===
effortless-ntwf-shapes:SerologyObservations_PriorAntiDsDnaIU a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_PriorAntiDsDnaIU" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:priorAntiDsDnaIU ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
                OPTIONAL { $this effortless-ntwf:priorObservation ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:SerologyObservations . OPTIONAL { ?j1 effortless-ntwf:antiDsDnaIU ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_PriorC3 a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_PriorC3" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:priorC3 ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
                OPTIONAL { $this effortless-ntwf:priorObservation ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:SerologyObservations . OPTIONAL { ?j1 effortless-ntwf:complementC3 ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_PriorC4 a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_PriorC4" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:priorC4 ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
                OPTIONAL { $this effortless-ntwf:priorObservation ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:SerologyObservations . OPTIONAL { ?j1 effortless-ntwf:complementC4 ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_AntiDsDnaTrend a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_AntiDsDnaTrend" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:antiDsDnaTrend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
    OPTIONAL { $this effortless-ntwf:antiDsDnaIU ?anti_ds_dna_iu . }
    OPTIONAL { $this effortless-ntwf:priorAntiDsDnaIU ?prior_anti_ds_dna_iu . }
                BIND(IF(COALESCE((!BOUND(?prior_anti_ds_dna_iu) || STR(?prior_anti_ds_dna_iu) = ""), false), "Stable", IF(COALESCE((COALESCE(?anti_ds_dna_iu, 0) > COALESCE((?prior_anti_ds_dna_iu * 1.25), 0)), false), "Rising", IF(COALESCE((COALESCE(?anti_ds_dna_iu, 0) < COALESCE((?prior_anti_ds_dna_iu * 0.8), 0)), false), "Falling", "Stable"))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_ComplementTrend a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_ComplementTrend" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:complementTrend ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
    OPTIONAL { $this effortless-ntwf:complementC3 ?complement_c3 . }
    OPTIONAL { $this effortless-ntwf:complementC4 ?complement_c4 . }
    OPTIONAL { $this effortless-ntwf:priorC3 ?prior_c3 . }
    OPTIONAL { $this effortless-ntwf:priorC4 ?prior_c4 . }
                BIND(IF(COALESCE((!BOUND(?prior_c3) || STR(?prior_c3) = ""), false), "Stable", IF(COALESCE(COALESCE(((?complement_c3 + ?complement_c4) < ((?prior_c3 + ?prior_c4) * 0.85)), false), false), "Falling", IF(COALESCE(COALESCE(((?complement_c3 + ?complement_c4) > ((?prior_c3 + ?prior_c4) * 1.15)), false), false), "Rising", "Stable"))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_IsPreNephriticSignaturePanel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_IsPreNephriticSignaturePanel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isPreNephriticSignaturePanel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
    OPTIONAL { $this effortless-ntwf:antiDsDnaTrend ?anti_ds_dna_trend . OPTIONAL { ?anti_ds_dna_trend erb:key ?anti_ds_dna_trend__key . } }
    OPTIONAL { $this effortless-ntwf:complementTrend ?complement_trend . OPTIONAL { ?complement_trend erb:key ?complement_trend__key . } }
                BIND(IF(COALESCE((COALESCE((COALESCE(?anti_ds_dna_trend__key, COALESCE(IF(isIRI(?anti_ds_dna_trend), REPLACE(STR(?anti_ds_dna_trend), "^.*[#/]", ""), STR(?anti_ds_dna_trend)), "")) = "Rising"), false) && COALESCE((COALESCE(?complement_trend__key, COALESCE(IF(isIRI(?complement_trend), REPLACE(STR(?complement_trend), "^.*[#/]", ""), STR(?complement_trend)), "")) = "Falling"), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_IsSignificantProteinuria a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_IsSignificantProteinuria" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isSignificantProteinuria ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
    OPTIONAL { $this effortless-ntwf:proteinuriaGPerDay ?proteinuria_g_per_day . }
                BIND(IF(COALESCE((COALESCE(?proteinuria_g_per_day, 0) >= 0.5), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_IsNephroticRangeProteinuria a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_IsNephroticRangeProteinuria" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isNephroticRangeProteinuria ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
    OPTIONAL { $this effortless-ntwf:proteinuriaGPerDay ?proteinuria_g_per_day . }
                BIND(IF(COALESCE((COALESCE(?proteinuria_g_per_day, 0) >= 3.0), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_SledaiRenalPoints a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_SledaiRenalPoints" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:sledaiRenalPoints ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
    OPTIONAL { $this effortless-ntwf:hasActiveUrinarySediment ?has_active_urinary_sediment . }
    OPTIONAL { $this effortless-ntwf:isNephroticRangeProteinuria ?is_nephrotic_range_proteinuria . }
    OPTIONAL { $this effortless-ntwf:isSignificantProteinuria ?is_significant_proteinuria . }
                BIND(IF(COALESCE((COALESCE(?is_nephrotic_range_proteinuria, false) || COALESCE(?has_active_urinary_sediment, false)), false), 8, IF(COALESCE(?is_significant_proteinuria, false), 4, 0)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_SledaiSerologyPoints a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_SledaiSerologyPoints" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:sledaiSerologyPoints ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
    OPTIONAL { $this effortless-ntwf:antiDsDnaTrend ?anti_ds_dna_trend . OPTIONAL { ?anti_ds_dna_trend erb:key ?anti_ds_dna_trend__key . } }
    OPTIONAL { $this effortless-ntwf:complementTrend ?complement_trend . OPTIONAL { ?complement_trend erb:key ?complement_trend__key . } }
                BIND(IF(COALESCE((COALESCE((COALESCE(?complement_trend__key, COALESCE(IF(isIRI(?complement_trend), REPLACE(STR(?complement_trend), "^.*[#/]", ""), STR(?complement_trend)), "")) = "Falling"), false) && COALESCE((COALESCE(?anti_ds_dna_trend__key, COALESCE(IF(isIRI(?anti_ds_dna_trend), REPLACE(STR(?anti_ds_dna_trend), "^.*[#/]", ""), STR(?anti_ds_dna_trend)), "")) = "Rising"), false)), false), 4, IF(COALESCE((COALESCE((COALESCE(?complement_trend__key, COALESCE(IF(isIRI(?complement_trend), REPLACE(STR(?complement_trend), "^.*[#/]", ""), STR(?complement_trend)), "")) = "Falling"), false) || COALESCE((COALESCE(?anti_ds_dna_trend__key, COALESCE(IF(isIRI(?anti_ds_dna_trend), REPLACE(STR(?anti_ds_dna_trend), "^.*[#/]", ""), STR(?anti_ds_dna_trend)), "")) = "Rising"), false)), false), 2, 0)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_SledaiScore a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_SledaiScore" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:sledaiScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
    OPTIONAL { $this effortless-ntwf:sledaiRenalPoints ?sledai_renal_points . }
    OPTIONAL { $this effortless-ntwf:sledaiSerologyPoints ?sledai_serology_points . }
                BIND((?sledai_renal_points + ?sledai_serology_points) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_ProgressionStateKey a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_ProgressionStateKey" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:progressionStateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
    OPTIONAL { $this effortless-ntwf:antiDsDnaTrend ?anti_ds_dna_trend . OPTIONAL { ?anti_ds_dna_trend erb:key ?anti_ds_dna_trend__key . } }
    OPTIONAL { $this effortless-ntwf:complementTrend ?complement_trend . OPTIONAL { ?complement_trend erb:key ?complement_trend__key . } }
    OPTIONAL { $this effortless-ntwf:hasActiveUrinarySediment ?has_active_urinary_sediment . }
    OPTIONAL { $this effortless-ntwf:isNephroticRangeProteinuria ?is_nephrotic_range_proteinuria . }
    OPTIONAL { $this effortless-ntwf:isSignificantProteinuria ?is_significant_proteinuria . }
    OPTIONAL { $this effortless-ntwf:proteinuriaGPerDay ?proteinuria_g_per_day . }
                BIND(IF(COALESCE((COALESCE(?is_nephrotic_range_proteinuria, false) || COALESCE(?has_active_urinary_sediment, false)), false), "BiopsyIndicated", IF(COALESCE((COALESCE(?proteinuria_g_per_day, 0) >= 1.0), false), "RenalFlareRisk", IF(COALESCE(?is_significant_proteinuria, false), "EarlyNephritis", IF(COALESCE((COALESCE((COALESCE(?anti_ds_dna_trend__key, COALESCE(IF(isIRI(?anti_ds_dna_trend), REPLACE(STR(?anti_ds_dna_trend), "^.*[#/]", ""), STR(?anti_ds_dna_trend)), "")) = "Rising"), false) && COALESCE((COALESCE(?complement_trend__key, COALESCE(IF(isIRI(?complement_trend), REPLACE(STR(?complement_trend), "^.*[#/]", ""), STR(?complement_trend)), "")) = "Falling"), false)), false), "SerologicActive", "PresymptomaticAutoimmunity")))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_ProgressionStateOrder a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_ProgressionStateOrder" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:progressionStateOrder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
    OPTIONAL { $this effortless-ntwf:progressionStateKey ?progression_state_key . OPTIONAL { ?progression_state_key erb:key ?progression_state_key__key . } }
                BIND(IF(COALESCE((COALESCE(?progression_state_key__key, COALESCE(IF(isIRI(?progression_state_key), REPLACE(STR(?progression_state_key), "^.*[#/]", ""), STR(?progression_state_key)), "")) = "BiopsyIndicated"), false), 5, IF(COALESCE((COALESCE(?progression_state_key__key, COALESCE(IF(isIRI(?progression_state_key), REPLACE(STR(?progression_state_key), "^.*[#/]", ""), STR(?progression_state_key)), "")) = "RenalFlareRisk"), false), 4, IF(COALESCE((COALESCE(?progression_state_key__key, COALESCE(IF(isIRI(?progression_state_key), REPLACE(STR(?progression_state_key), "^.*[#/]", ""), STR(?progression_state_key)), "")) = "EarlyNephritis"), false), 3, IF(COALESCE((COALESCE(?progression_state_key__key, COALESCE(IF(isIRI(?progression_state_key), REPLACE(STR(?progression_state_key), "^.*[#/]", ""), STR(?progression_state_key)), "")) = "SerologicActive"), false), 2, 1)))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
    OPTIONAL { $this effortless-ntwf:serologyObservationId ?serology_observation_id . }
                BIND(?serology_observation_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SerologyObservations_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SerologyObservations ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SerologyObservations_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SerologyObservations .
    OPTIONAL { $this effortless-ntwf:serologyObservationId ?serology_observation_id . OPTIONAL { ?serology_observation_id erb:key ?serology_observation_id__key . } }
                BIND(CONCAT("/admin/serology/", COALESCE(COALESCE(?serology_observation_id__key, IF(isIRI(?serology_observation_id), REPLACE(STR(?serology_observation_id), "^.*[#/]", ""), STR(?serology_observation_id))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for StateMachines ===
effortless-ntwf-shapes:StateMachines_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateMachines ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StateMachines_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StateMachines .
    OPTIONAL { $this effortless-ntwf:stateMachineId ?state_machine_id . }
                BIND(?state_machine_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StateMachines_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateMachines ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StateMachines_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StateMachines .
    OPTIONAL { $this effortless-ntwf:stateMachineId ?state_machine_id . OPTIONAL { ?state_machine_id erb:key ?state_machine_id__key . } }
                BIND(CONCAT("/admin/state-machine/", COALESCE(COALESCE(?state_machine_id__key, IF(isIRI(?state_machine_id), REPLACE(STR(?state_machine_id), "^.*[#/]", ""), STR(?state_machine_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StateMachines_StateCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateMachines ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StateMachines_StateCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:stateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StateMachines .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:StateMachines .
                    ?child a effortless-ntwf:MachineStates .
                    ?child effortless-ntwf:stateMachine $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StateMachines_TransitionRuleCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateMachines ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StateMachines_TransitionRuleCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:transitionRuleCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StateMachines .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:StateMachines .
                    ?child a effortless-ntwf:StateTransitionRules .
                    ?child effortless-ntwf:stateMachine $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for StateTransitionRules ===
effortless-ntwf-shapes:StateTransitionRules_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateTransitionRules ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StateTransitionRules_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StateTransitionRules .
    OPTIONAL { $this effortless-ntwf:stateTransitionRuleId ?state_transition_rule_id . }
                BIND(?state_transition_rule_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StateTransitionRules_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateTransitionRules ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StateTransitionRules_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StateTransitionRules .
    OPTIONAL { $this effortless-ntwf:stateTransitionRuleId ?state_transition_rule_id . OPTIONAL { ?state_transition_rule_id erb:key ?state_transition_rule_id__key . } }
                BIND(CONCAT("/admin/state-machine/rules/", COALESCE(COALESCE(?state_transition_rule_id__key, IF(isIRI(?state_transition_rule_id), REPLACE(STR(?state_transition_rule_id), "^.*[#/]", ""), STR(?state_transition_rule_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StateTransitionRules_FromStateKey a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateTransitionRules ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StateTransitionRules_FromStateKey" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:fromStateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StateTransitionRules .
                OPTIONAL { $this effortless-ntwf:fromState ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:MachineStates . OPTIONAL { ?j1 effortless-ntwf:stateKey ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StateTransitionRules_ToStateKey a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateTransitionRules ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StateTransitionRules_ToStateKey" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:toStateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StateTransitionRules .
                OPTIONAL { $this effortless-ntwf:toState ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:MachineStates . OPTIONAL { ?j1 effortless-ntwf:stateKey ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StateTransitionRules_IsForwardEdge a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateTransitionRules ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StateTransitionRules_IsForwardEdge" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isForwardEdge ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StateTransitionRules .
    OPTIONAL { $this effortless-ntwf:fromStateKey ?from_state_key . }
    OPTIONAL { $this effortless-ntwf:toStateKey ?to_state_key . }
                BIND((!(COALESCE(COALESCE((?to_state_key = ?from_state_key), ((!BOUND(?to_state_key) || STR(?to_state_key) = "") && (!BOUND(?from_state_key) || STR(?from_state_key) = ""))), false))) AS ?_result)
            }
        """ ;
    ] .

# === Rules for StateTransitions ===
effortless-ntwf-shapes:StateTransitions_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateTransitions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StateTransitions_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StateTransitions .
    OPTIONAL { $this effortless-ntwf:stateTransitionId ?state_transition_id . }
                BIND(?state_transition_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StateTransitions_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StateTransitions ;
    sh:order 1 ;
