            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:individualHasCrypticRelatedness ?individual_has_cryptic_relatedness . }
    OPTIONAL { $this effortless-ntwf:restsOnConfirmedMechanism ?rests_on_confirmed_mechanism . }
                BIND(IF(COALESCE((COALESCE((!(COALESCE(?rests_on_confirmed_mechanism, false))), false) || COALESCE(?individual_has_cryptic_relatedness, false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IsFalsifiabilityBacked a sh:NodeShape ;
