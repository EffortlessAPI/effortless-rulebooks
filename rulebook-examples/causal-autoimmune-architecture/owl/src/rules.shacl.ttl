                BIND(CONCAT("/admin/state-machine/instances/", COALESCE(COALESCE(?subject_state_instance_id__key, IF(isIRI(?subject_state_instance_id), REPLACE(STR(?subject_state_instance_id), "^.*[#/]", ""), STR(?subject_state_instance_id))), "")) AS ?_result)
            }
