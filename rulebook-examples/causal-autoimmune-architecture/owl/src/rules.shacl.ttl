            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?individual . }
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:countCrossAncestryConfirmedNodes ?j3 . } }
                BIND(IF((COALESCE(IF(isIRI(?individual), REPLACE(STR(?individual), "^.*[#/]", ""), STR(?individual)), "") = ""), 0, ?j3) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IndividualHasCrypticRelatedness a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IndividualHasCrypticRelatedness" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualHasCrypticRelatedness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?individual . }
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:hasCrypticRelatednessFlag ?j3 . } }
                BIND(IF((COALESCE(IF(isIRI(?individual), REPLACE(STR(?individual), "^.*[#/]", ""), STR(?individual)), "") = ""), false, ?j3) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IndividualMaxSeverityScore a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IndividualMaxSeverityScore" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualMaxSeverityScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?individual . }
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:maxSeverityScore ?j3 . } }
                BIND(IF((COALESCE(IF(isIRI(?individual), REPLACE(STR(?individual), "^.*[#/]", ""), STR(?individual)), "") = ""), 0, ?j3) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IndividualHasHighSeverityPhenotype a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IndividualHasHighSeverityPhenotype" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualHasHighSeverityPhenotype ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?individual . }
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:hasHighSeverityPhenotype ?j3 . } }
                BIND(IF((COALESCE(IF(isIRI(?individual), REPLACE(STR(?individual), "^.*[#/]", ""), STR(?individual)), "") = ""), false, ?j3) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IndividualHasPredictedTreatmentResponse a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 12 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IndividualHasPredictedTreatmentResponse" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualHasPredictedTreatmentResponse ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?individual . }
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:hasPredictedTreatmentResponse ?j3 . } }
                BIND(IF((COALESCE(IF(isIRI(?individual), REPLACE(STR(?individual), "^.*[#/]", ""), STR(?individual)), "") = ""), false, ?j3) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_PredictedValue a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_PredictedValue" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:predictedValue ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:individualCausalMass ?individual_causal_mass . }
    OPTIONAL { $this effortless-ntwf:individualConfirmedNodeCount ?individual_confirmed_node_count . }
                BIND(IF(COALESCE((COALESCE(((2 * ?individual_causal_mass) + (1.5 * ?individual_confirmed_node_count)), 0) > 10), false), 10, ((2 * ?individual_causal_mass) + (1.5 * ?individual_confirmed_node_count))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_CountBins a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_CountBins" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countBins ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:IndividualPredictions .
                    ?child a effortless-ntwf:CalibrationBins .
                    ?child effortless-ntwf:individualPrediction ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualPredictionId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_CountWellCalibratedBins a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_CountWellCalibratedBins" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countWellCalibratedBins ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:IndividualPredictions .
                    ?child a effortless-ntwf:CalibrationBins .
                    ?child effortless-ntwf:individualPrediction ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualPredictionId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:isWellCalibratedBin ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_SumBinAbsError a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_SumBinAbsError" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:sumBinAbsError ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:IndividualPredictions .
                    ?child a effortless-ntwf:CalibrationBins .
                    ?child effortless-ntwf:individualPrediction ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualPredictionId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:binAbsError ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_MeanBinAbsError a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_MeanBinAbsError" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:meanBinAbsError ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:countBins ?count_bins . }
    OPTIONAL { $this effortless-ntwf:sumBinAbsError ?sum_bin_abs_error . }
                BIND(IF(COALESCE((COALESCE(?count_bins, 0) > 0), false), xsd:double(?sum_bin_abs_error / ?count_bins), 1) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_WellCalibratedFraction a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_WellCalibratedFraction" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:wellCalibratedFraction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:countBins ?count_bins . }
    OPTIONAL { $this effortless-ntwf:countWellCalibratedBins ?count_well_calibrated_bins . }
                BIND(IF(COALESCE((COALESCE(?count_bins, 0) > 0), false), xsd:double(?count_well_calibrated_bins / ?count_bins), 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_CalibratedUncertainty a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_CalibratedUncertainty" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:calibratedUncertainty ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:meanBinAbsError ?mean_bin_abs_error . }
    OPTIONAL { $this effortless-ntwf:wellCalibratedFraction ?well_calibrated_fraction . }
                BIND((IF(COALESCE((COALESCE((1 - ?mean_bin_abs_error), 0) < 0), false), 0, (1 - ?mean_bin_abs_error)) * ?well_calibrated_fraction) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_RestsOnConfirmedMechanism a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 10 ;
    sh:rule [
