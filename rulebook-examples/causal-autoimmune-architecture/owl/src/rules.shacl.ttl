effortless-ntwf-shapes:EpistaticInteractions_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EpistaticInteractions ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EpistaticInteractions_ParentPath" ;
