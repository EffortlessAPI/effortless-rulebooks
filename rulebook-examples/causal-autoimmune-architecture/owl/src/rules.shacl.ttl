            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isCellBasedTherapy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InterventionTargets .
    OPTIONAL { $this effortless-ntwf:therapyClass ?therapy_class . OPTIONAL { ?therapy_class erb:key ?therapy_class__key . } }
                BIND(IF(COALESCE((COALESCE(?therapy_class__key, COALESCE(IF(isIRI(?therapy_class), REPLACE(STR(?therapy_class), "^.*[#/]", ""), STR(?therapy_class)), "")) = "Cell-based"), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for MachineStates ===
effortless-ntwf-shapes:MachineStates_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:MachineStates ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineStates_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MachineStates .
    OPTIONAL { $this effortless-ntwf:machineStateId ?machine_state_id . }
                BIND(?machine_state_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:MachineStates_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:MachineStates ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineStates_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MachineStates .
    OPTIONAL { $this effortless-ntwf:machineStateId ?machine_state_id . OPTIONAL { ?machine_state_id erb:key ?machine_state_id__key . } }
                BIND(CONCAT("/admin/state-machine/states/", COALESCE(COALESCE(?machine_state_id__key, IF(isIRI(?machine_state_id), REPLACE(STR(?machine_state_id), "^.*[#/]", ""), STR(?machine_state_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:MachineStates_ReachableStateCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:MachineStates ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_MachineStates_ReachableStateCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:reachableStateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:MachineStates .
                OPTIONAL {
                    SELECT $this (COUNT(*) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:MachineStates .
                        $this effortless-ntwf:progression+ ?b .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for NegativeControlTests ===
effortless-ntwf-shapes:NegativeControlTests_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:NegativeControlTests ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_NegativeControlTests_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:NegativeControlTests .
    OPTIONAL { $this effortless-ntwf:controlLabel ?control_label . }
                BIND(?control_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:NegativeControlTests_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:NegativeControlTests ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_NegativeControlTests_ParentPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:NegativeControlTests .
                OPTIONAL { $this effortless-ntwf:causalMechanism ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:CausalMechanisms . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:NegativeControlTests_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:NegativeControlTests ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_NegativeControlTests_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:NegativeControlTests .
    OPTIONAL { $this effortless-ntwf:negativeControlTestId ?negative_control_test_id . OPTIONAL { ?negative_control_test_id erb:key ?negative_control_test_id__key . } }
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/neg-controls/", COALESCE(COALESCE(?negative_control_test_id__key, IF(isIRI(?negative_control_test_id), REPLACE(STR(?negative_control_test_id), "^.*[#/]", ""), STR(?negative_control_test_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:NegativeControlTests_IsSurvived a sh:NodeShape ;
    sh:targetClass effortless-ntwf:NegativeControlTests ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_NegativeControlTests_IsSurvived" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isSurvived ?_result .
            }
            WHERE {
    $this a effortless-ntwf:NegativeControlTests .
    OPTIONAL { $this effortless-ntwf:nullThreshold ?null_threshold . }
    OPTIONAL { $this effortless-ntwf:permutationEffectSize ?permutation_effect_size . }
                BIND(IF(COALESCE((COALESCE(?permutation_effect_size, 0) <= COALESCE(?null_threshold, 0)), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for NonGoals ===
