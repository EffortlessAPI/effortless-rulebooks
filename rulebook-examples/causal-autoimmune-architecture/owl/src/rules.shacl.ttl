effortless-ntwf-shapes:GenomicVariants_VariantTypeLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:GenomicVariants ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GenomicVariants_VariantTypeLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:variantTypeLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GenomicVariants .
                OPTIONAL { $this effortless-ntwf:variantType ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:VariantTypes . OPTIONAL { ?j1 effortless-ntwf:typeLabel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:GenomicVariants_VariantClassIsRare a sh:NodeShape ;
    sh:targetClass effortless-ntwf:GenomicVariants ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GenomicVariants_VariantClassIsRare" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:variantClassIsRare ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GenomicVariants .
                OPTIONAL { $this effortless-ntwf:variantType ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:VariantTypes . OPTIONAL { ?j1 effortless-ntwf:isRareVariantClass ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:GenomicVariants_IndividualAncestryLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:GenomicVariants ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GenomicVariants_IndividualAncestryLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualAncestryLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GenomicVariants .
                OPTIONAL { $this effortless-ntwf:individual_GenomicVariants ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:ancestryLabel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:GenomicVariants_IsRareVariant a sh:NodeShape ;
    sh:targetClass effortless-ntwf:GenomicVariants ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GenomicVariants_IsRareVariant" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isRareVariant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GenomicVariants .
    OPTIONAL { $this effortless-ntwf:alleleFrequency ?allele_frequency . }
                BIND(IF(COALESCE((COALESCE(?allele_frequency, 0) < 0.01), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:GenomicVariants_IsCausalCandidate a sh:NodeShape ;
    sh:targetClass effortless-ntwf:GenomicVariants ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GenomicVariants_IsCausalCandidate" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isCausalCandidate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GenomicVariants .
    OPTIONAL { $this effortless-ntwf:hasAlleleSpecificExpression ?has_allele_specific_expression . }
    OPTIONAL { $this effortless-ntwf:isRareVariant ?is_rare_variant . }
    OPTIONAL { $this effortless-ntwf:variantClassIsRare ?variant_class_is_rare . }
                BIND(IF(COALESCE((COALESCE((COALESCE(?is_rare_variant, false) || COALESCE(?variant_class_is_rare, false)), false) && COALESCE(?has_allele_specific_expression, false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for GlossaryTerms ===
effortless-ntwf-shapes:GlossaryTerms_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:GlossaryTerms ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GlossaryTerms_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GlossaryTerms .
    OPTIONAL { $this effortless-ntwf:term ?term . }
                BIND(?term AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:GlossaryTerms_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:GlossaryTerms ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GlossaryTerms_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:GlossaryTerms .
    OPTIONAL { $this effortless-ntwf:glossaryTermId ?glossary_term_id . OPTIONAL { ?glossary_term_id erb:key ?glossary_term_id__key . } }
                BIND(CONCAT("/admin/glossary/", COALESCE(COALESCE(?glossary_term_id__key, IF(isIRI(?glossary_term_id), REPLACE(STR(?glossary_term_id), "^.*[#/]", ""), STR(?glossary_term_id))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for IndividualPredictions ===
effortless-ntwf-shapes:IndividualPredictions_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:predictionLabel ?prediction_label . }
                BIND(?prediction_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_ParentPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:individualPredictionId ?individual_prediction_id . OPTIONAL { ?individual_prediction_id erb:key ?individual_prediction_id__key . } }
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/predictions/", COALESCE(COALESCE(?individual_prediction_id__key, IF(isIRI(?individual_prediction_id), REPLACE(STR(?individual_prediction_id), "^.*[#/]", ""), STR(?individual_prediction_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IndividualAncestryLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IndividualAncestryLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualAncestryLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:ancestryLabel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IsAncestryHoldout a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IsAncestryHoldout" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isAncestryHoldout ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:isAncestryAbsentFromTraining ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IndividualCausalMass a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IndividualCausalMass" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualCausalMass ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?individual . }
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:sumConfirmedCausalConfidence ?j3 . } }
                BIND(IF((COALESCE(IF(isIRI(?individual), REPLACE(STR(?individual), "^.*[#/]", ""), STR(?individual)), "") = ""), 0, ?j3) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IndividualConfirmedNodeCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IndividualConfirmedNodeCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualConfirmedNodeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?individual . }
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:countConfirmedCausalNodes ?j3 . } }
                BIND(IF((COALESCE(IF(isIRI(?individual), REPLACE(STR(?individual), "^.*[#/]", ""), STR(?individual)), "") = ""), 0, ?j3) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IndividualCrossAncestryNodeCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IndividualCrossAncestryNodeCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
