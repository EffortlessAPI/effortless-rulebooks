    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:isAncestryHoldout ?is_ancestry_holdout . }
    OPTIONAL { $this effortless-ntwf:isTransportableToAbsentAncestry ?is_transportable_to_absent_ancestry . }
                BIND(IF(COALESCE(?is_ancestry_holdout, false), ?is_transportable_to_absent_ancestry, true) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_TransportGateStatus a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 13 ;
