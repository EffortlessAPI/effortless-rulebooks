                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DiseaseStages_IsPresymptomatic a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DiseaseStages ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DiseaseStages_IsPresymptomatic" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isPresymptomatic ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DiseaseStages .
    OPTIONAL { $this effortless-ntwf:stageLabel ?stage_label . OPTIONAL { ?stage_label erb:key ?stage_label__key . } }
                BIND(IF(COALESCE((COALESCE(?stage_label__key, COALESCE(IF(isIRI(?stage_label), REPLACE(STR(?stage_label), "^.*[#/]", ""), STR(?stage_label)), "")) = "Presymptomatic"), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for EffortlessLoops ===
effortless-ntwf-shapes:EffortlessLoops_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EffortlessLoops ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EffortlessLoops_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EffortlessLoops .
    OPTIONAL { $this effortless-ntwf:loopNumber ?loop_number . OPTIONAL { ?loop_number erb:key ?loop_number__key . } }
    OPTIONAL { $this effortless-ntwf:title ?title . OPTIONAL { ?title erb:key ?title__key . } }
                BIND(CONCAT("Loop ", COALESCE(COALESCE(?loop_number__key, IF(isIRI(?loop_number), REPLACE(STR(?loop_number), "^.*[#/]", ""), STR(?loop_number))), ""), " — ", COALESCE(COALESCE(?title__key, IF(isIRI(?title), REPLACE(STR(?title), "^.*[#/]", ""), STR(?title))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EffortlessLoops_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EffortlessLoops ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EffortlessLoops_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EffortlessLoops .
    OPTIONAL { $this effortless-ntwf:effortlessLoopId ?effortless_loop_id . OPTIONAL { ?effortless_loop_id erb:key ?effortless_loop_id__key . } }
                BIND(CONCAT("/admin/effortless-loops/", COALESCE(COALESCE(?effortless_loop_id__key, IF(isIRI(?effortless_loop_id), REPLACE(STR(?effortless_loop_id), "^.*[#/]", ""), STR(?effortless_loop_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EffortlessLoops_Completedness a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EffortlessLoops ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EffortlessLoops_Completedness" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:completedness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EffortlessLoops .
    OPTIONAL { $this effortless-ntwf:status ?status . }
                BIND(?status AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EffortlessLoops_IsInCurrentPlan a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EffortlessLoops ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EffortlessLoops_IsInCurrentPlan" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isInCurrentPlan ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EffortlessLoops .
    OPTIONAL { $this effortless-ntwf:status ?status . OPTIONAL { ?status erb:key ?status__key . } }
                BIND(IF(COALESCE((COALESCE(?status__key, COALESCE(IF(isIRI(?status), REPLACE(STR(?status), "^.*[#/]", ""), STR(?status)), "")) = "done"), false), false, true) AS ?_result)
            }
        """ ;
    ] .

# === Rules for EnvironmentalExposures ===
effortless-ntwf-shapes:EnvironmentalExposures_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EnvironmentalExposures ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EnvironmentalExposures_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EnvironmentalExposures .
    OPTIONAL { $this effortless-ntwf:exposureLabel ?exposure_label . }
                BIND(?exposure_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EnvironmentalExposures_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EnvironmentalExposures ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EnvironmentalExposures_ParentPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EnvironmentalExposures .
                OPTIONAL { $this effortless-ntwf:individual_EnvironmentalExposures ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EnvironmentalExposures_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EnvironmentalExposures ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EnvironmentalExposures_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EnvironmentalExposures .
    OPTIONAL { $this effortless-ntwf:environmentalExposureId ?environmental_exposure_id . OPTIONAL { ?environmental_exposure_id erb:key ?environmental_exposure_id__key . } }
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/exposures/", COALESCE(COALESCE(?environmental_exposure_id__key, IF(isIRI(?environmental_exposure_id), REPLACE(STR(?environmental_exposure_id), "^.*[#/]", ""), STR(?environmental_exposure_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EnvironmentalExposures_IndividualAncestryLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EnvironmentalExposures ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EnvironmentalExposures_IndividualAncestryLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualAncestryLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EnvironmentalExposures .
                OPTIONAL { $this effortless-ntwf:individual_EnvironmentalExposures ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:ancestryLabel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EnvironmentalExposures_IsHighExposure a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EnvironmentalExposures ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EnvironmentalExposures_IsHighExposure" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isHighExposure ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EnvironmentalExposures .
    OPTIONAL { $this effortless-ntwf:exposureLevel ?exposure_level . }
                BIND(IF(COALESCE((COALESCE(?exposure_level, 0) > 5), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for EpistaticInteractions ===
