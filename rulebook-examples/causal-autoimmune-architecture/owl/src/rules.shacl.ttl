            }
            WHERE {
    $this a effortless-ntwf:EpistaticInteractions .
    OPTIONAL { $this effortless-ntwf:epistasisScore ?epistasis_score . }
                BIND(IF(COALESCE((COALESCE(?epistasis_score, 0) > 0.5), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for EvidenceItems ===
effortless-ntwf-shapes:EvidenceItems_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EvidenceItems ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EvidenceItems_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EvidenceItems .
    OPTIONAL { $this effortless-ntwf:evidenceLabel ?evidence_label . }
                BIND(?evidence_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EvidenceItems_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EvidenceItems ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EvidenceItems_ParentPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EvidenceItems .
                OPTIONAL { $this effortless-ntwf:causalMechanism ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:CausalMechanisms . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EvidenceItems_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EvidenceItems ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EvidenceItems_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EvidenceItems .
    OPTIONAL { $this effortless-ntwf:evidenceItemId ?evidence_item_id . OPTIONAL { ?evidence_item_id erb:key ?evidence_item_id__key . } }
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/evidence/", COALESCE(COALESCE(?evidence_item_id__key, IF(isIRI(?evidence_item_id), REPLACE(STR(?evidence_item_id), "^.*[#/]", ""), STR(?evidence_item_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EvidenceItems_AssayIsHighQuality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EvidenceItems ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EvidenceItems_AssayIsHighQuality" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:assayIsHighQuality ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EvidenceItems .
                OPTIONAL { $this effortless-ntwf:omicsAssay ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:OmicsAssays . OPTIONAL { ?j1 effortless-ntwf:isHighQualityAssay ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EvidenceItems_ZStat a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EvidenceItems ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EvidenceItems_ZStat" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:zStat ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EvidenceItems .
    OPTIONAL { $this effortless-ntwf:effectSize ?effect_size . }
    OPTIONAL { $this effortless-ntwf:standardError ?standard_error . }
                BIND(IF(COALESCE((COALESCE(?standard_error, 0) > 0), false), xsd:double(?effect_size / ?standard_error), 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EvidenceItems_IsConfoundControlled a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EvidenceItems ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EvidenceItems_IsConfoundControlled" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isConfoundControlled ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EvidenceItems .
    OPTIONAL { $this effortless-ntwf:isAdjustedForAncestryPCs ?is_adjusted_for_ancestry_p_cs . }
    OPTIONAL { $this effortless-ntwf:isAdjustedForBatch ?is_adjusted_for_batch . }
                BIND(IF(COALESCE((COALESCE(?is_adjusted_for_ancestry_p_cs, false) && COALESCE(?is_adjusted_for_batch, false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EvidenceItems_IsQualifiedEvidence a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EvidenceItems ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EvidenceItems_IsQualifiedEvidence" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isQualifiedEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EvidenceItems .
    OPTIONAL { $this effortless-ntwf:assayIsHighQuality ?assay_is_high_quality . }
    OPTIONAL { $this effortless-ntwf:isConfoundControlled ?is_confound_controlled . }
    OPTIONAL { $this effortless-ntwf:isNegativeControlArm ?is_negative_control_arm . }
    OPTIONAL { $this effortless-ntwf:zStat ?z_stat . }
                BIND(IF(COALESCE((COALESCE(?assay_is_high_quality, false) && COALESCE((!(COALESCE(?is_negative_control_arm, false))), false) && COALESCE((COALESCE(?z_stat, 0) >= 2), false) && COALESCE(?is_confound_controlled, false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Features ===
effortless-ntwf-shapes:Features_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Features ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Features_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Features .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Features_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Features ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Features_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Features .
    OPTIONAL { $this effortless-ntwf:featureId ?feature_id . OPTIONAL { ?feature_id erb:key ?feature_id__key . } }
                BIND(CONCAT("/admin/features/", COALESCE(COALESCE(?feature_id__key, IF(isIRI(?feature_id), REPLACE(STR(?feature_id), "^.*[#/]", ""), STR(?feature_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Features_MetaLine a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Features ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Features_MetaLine" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:metaLine ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Features .
    OPTIONAL { $this effortless-ntwf:category ?category . OPTIONAL { ?category erb:key ?category__key . } }
    OPTIONAL { $this effortless-ntwf:priority ?priority . OPTIONAL { ?priority erb:key ?priority__key . } }
    OPTIONAL { $this effortless-ntwf:refCount ?ref_count . OPTIONAL { ?ref_count erb:key ?ref_count__key . } }
                BIND(CONCAT("**Category:** ", COALESCE(COALESCE(?category__key, IF(isIRI(?category), REPLACE(STR(?category), "^.*[#/]", ""), STR(?category))), ""), " - **Priority:** ", COALESCE(COALESCE(?priority__key, IF(isIRI(?priority), REPLACE(STR(?priority), "^.*[#/]", ""), STR(?priority))), ""), " - **Challenge refs:** ", COALESCE(COALESCE(?ref_count__key, IF(isIRI(?ref_count), REPLACE(STR(?ref_count), "^.*[#/]", ""), STR(?ref_count))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for FederatedDatasets ===
effortless-ntwf-shapes:FederatedDatasets_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FederatedDatasets ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FederatedDatasets_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FederatedDatasets .
    OPTIONAL { $this effortless-ntwf:nodeLabel ?node_label . }
                BIND(?node_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:FederatedDatasets_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FederatedDatasets ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FederatedDatasets_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FederatedDatasets .
    OPTIONAL { $this effortless-ntwf:federatedDatasetId ?federated_dataset_id . OPTIONAL { ?federated_dataset_id erb:key ?federated_dataset_id__key . } }
                BIND(CONCAT("/datasets/", COALESCE(COALESCE(?federated_dataset_id__key, IF(isIRI(?federated_dataset_id), REPLACE(STR(?federated_dataset_id), "^.*[#/]", ""), STR(?federated_dataset_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:FederatedDatasets_CountOfIndividuals a sh:NodeShape ;
    sh:targetClass effortless-ntwf:FederatedDatasets ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_FederatedDatasets_CountOfIndividuals" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countOfIndividuals ?_result .
            }
            WHERE {
    $this a effortless-ntwf:FederatedDatasets .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:FederatedDatasets .
                    ?child a effortless-ntwf:Individuals .
                    ?child effortless-ntwf:federatedDataset ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:federatedDatasetId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

