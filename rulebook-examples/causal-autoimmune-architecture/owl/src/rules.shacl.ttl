            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DiseaseStages .
                OPTIONAL { $this effortless-ntwf:autoimmuneDisease ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:AutoimmuneDiseases . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DiseaseStages_RelativePath a sh:NodeShape ;
