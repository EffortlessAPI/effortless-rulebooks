    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:calibratedUncertainty ?calibrated_uncertainty . }
    OPTIONAL { $this effortless-ntwf:hasSpuriousCorrelationFlag ?has_spurious_correlation_flag . }
                BIND(IF(COALESCE((COALESCE((COALESCE(?calibrated_uncertainty, 0) >= 0.7), false) && COALESCE((!(COALESCE(?has_spurious_correlation_flag, false))), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_PatientStratificationTier a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
