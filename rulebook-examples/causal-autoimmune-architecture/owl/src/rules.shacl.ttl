    OPTIONAL { $this effortless-ntwf:restsOnConfirmedMechanism ?rests_on_confirmed_mechanism . }
                BIND(IF(COALESCE(?is_treatment_response_actionable, false), "EffectiveOnConfirmedMechanism", IF(COALESCE(?rests_on_confirmed_mechanism, false), "NoEffectiveTreatmentOnMechanism", "NoConfirmedMechanism")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IsClinicallyActionable a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 14 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IsClinicallyActionable" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isClinicallyActionable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:isAncestryTransportSafe ?is_ancestry_transport_safe . }
    OPTIONAL { $this effortless-ntwf:isFalsifiabilityBacked ?is_falsifiability_backed . }
    OPTIONAL { $this effortless-ntwf:isHighConfidencePrediction ?is_high_confidence_prediction . }
    OPTIONAL { $this effortless-ntwf:predictedValue ?predicted_value . }
                BIND(IF(COALESCE((COALESCE(?is_high_confidence_prediction, false) && COALESCE(?is_falsifiability_backed, false) && COALESCE(?is_ancestry_transport_safe, false) && COALESCE((COALESCE(?predicted_value, 0) > 0), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_LifecycleStateKey a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 14 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_LifecycleStateKey" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:lifecycleStateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:calibratedUncertainty ?calibrated_uncertainty . }
    OPTIONAL { $this effortless-ntwf:individualHasCrypticRelatedness ?individual_has_cryptic_relatedness . }
    OPTIONAL { $this effortless-ntwf:isAncestryTransportSafe ?is_ancestry_transport_safe . }
    OPTIONAL { $this effortless-ntwf:isFalsifiabilityBacked ?is_falsifiability_backed . }
    OPTIONAL { $this effortless-ntwf:isHighConfidencePrediction ?is_high_confidence_prediction . }
    OPTIONAL { $this effortless-ntwf:predictedValue ?predicted_value . }
    OPTIONAL { $this effortless-ntwf:restsOnConfirmedMechanism ?rests_on_confirmed_mechanism . }
                BIND(IF(COALESCE((COALESCE(?is_high_confidence_prediction, false) && COALESCE(?is_falsifiability_backed, false) && COALESCE(?is_ancestry_transport_safe, false) && COALESCE((COALESCE(?predicted_value, 0) > 0), false)), false), "Actionable", IF(COALESCE((COALESCE((!(COALESCE(?rests_on_confirmed_mechanism, false))), false) || COALESCE((!(COALESCE(?is_falsifiability_backed, false))), false)), false), "NotActionable", IF(COALESCE(?individual_has_cryptic_relatedness, false), "NotActionable", IF(COALESCE((COALESCE(?calibrated_uncertainty, 0) < 0.7), false), "NotActionable", IF(COALESCE((!(COALESCE(?is_ancestry_transport_safe, false))), false), "NotActionable", "Actionable"))))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_DecidingGate a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 15 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_DecidingGate" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:decidingGate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:calibratedUncertainty ?calibrated_uncertainty . }
    OPTIONAL { $this effortless-ntwf:individualHasCrypticRelatedness ?individual_has_cryptic_relatedness . }
    OPTIONAL { $this effortless-ntwf:isAncestryTransportSafe ?is_ancestry_transport_safe . }
    OPTIONAL { $this effortless-ntwf:isClinicallyActionable ?is_clinically_actionable . }
    OPTIONAL { $this effortless-ntwf:restsOnConfirmedMechanism ?rests_on_confirmed_mechanism . }
                BIND(IF(COALESCE(?is_clinically_actionable, false), "AllGatesPass", IF(COALESCE((!(COALESCE(?rests_on_confirmed_mechanism, false))), false), "NoValidatedMechanism", IF(COALESCE(?individual_has_cryptic_relatedness, false), "CrypticRelatedness", IF(COALESCE((COALESCE(?calibrated_uncertainty, 0) < 0.7), false), "Calibration", IF(COALESCE((!(COALESCE(?is_ancestry_transport_safe, false))), false), "AncestryTransport", "Undetermined"))))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IndividualTargetPathway a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IndividualTargetPathway" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualTargetPathway ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:targetPathway ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IndividualProgressionStateKey a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IndividualProgressionStateKey" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualProgressionStateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:nephritisProgressionStateKey ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IndividualIsDiseaseProgressing a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IndividualIsDiseaseProgressing" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualIsDiseaseProgressing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
                OPTIONAL { $this effortless-ntwf:individual_IndividualPredictions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:isDiseaseProgressing ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_RecommendedTreatmentLine a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_RecommendedTreatmentLine" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:recommendedTreatmentLine ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:individualProgressionStateKey ?individual_progression_state_key . OPTIONAL { ?individual_progression_state_key erb:key ?individual_progression_state_key__key . } }
    OPTIONAL { $this effortless-ntwf:individualTargetPathway ?individual_target_pathway . OPTIONAL { ?individual_target_pathway erb:key ?individual_target_pathway__key . } }
    OPTIONAL { $this effortless-ntwf:restsOnConfirmedMechanism ?rests_on_confirmed_mechanism . }
                BIND(IF(COALESCE((!(COALESCE(?rests_on_confirmed_mechanism, false))), false), "No targeted line — mechanism unconfirmed", IF(COALESCE((COALESCE((COALESCE(?individual_progression_state_key__key, COALESCE(IF(isIRI(?individual_progression_state_key), REPLACE(STR(?individual_progression_state_key), "^.*[#/]", ""), STR(?individual_progression_state_key)), "")) = "RenalFlareRisk"), false) || COALESCE((COALESCE(?individual_progression_state_key__key, COALESCE(IF(isIRI(?individual_progression_state_key), REPLACE(STR(?individual_progression_state_key), "^.*[#/]", ""), STR(?individual_progression_state_key)), "")) = "BiopsyIndicated"), false)), false), "Mycophenolate (induction)", IF(COALESCE((COALESCE(?individual_target_pathway__key, COALESCE(IF(isIRI(?individual_target_pathway), REPLACE(STR(?individual_target_pathway), "^.*[#/]", ""), STR(?individual_target_pathway)), "")) = "type-I-IFN"), false), "Anifrolumab", IF(COALESCE((COALESCE(?individual_target_pathway__key, COALESCE(IF(isIRI(?individual_target_pathway), REPLACE(STR(?individual_target_pathway), "^.*[#/]", ""), STR(?individual_target_pathway)), "")) = "B-cell/autoantibody"), false), "Belimumab", IF(COALESCE((COALESCE(?individual_target_pathway__key, COALESCE(IF(isIRI(?individual_target_pathway), REPLACE(STR(?individual_target_pathway), "^.*[#/]", ""), STR(?individual_target_pathway)), "")) = "IL-17/23"), false), "Secukinumab", "Standard-of-care (no mechanism-matched targeted line)"))))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_TreatmentLineDecidingFactor a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_TreatmentLineDecidingFactor" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:treatmentLineDecidingFactor ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:individualProgressionStateKey ?individual_progression_state_key . OPTIONAL { ?individual_progression_state_key erb:key ?individual_progression_state_key__key . } }
    OPTIONAL { $this effortless-ntwf:individualTargetPathway ?individual_target_pathway . OPTIONAL { ?individual_target_pathway erb:key ?individual_target_pathway__key . } }
    OPTIONAL { $this effortless-ntwf:restsOnConfirmedMechanism ?rests_on_confirmed_mechanism . }
                BIND(IF(COALESCE((!(COALESCE(?rests_on_confirmed_mechanism, false))), false), "MechanismUnconfirmed", IF(COALESCE((COALESCE((COALESCE(?individual_progression_state_key__key, COALESCE(IF(isIRI(?individual_progression_state_key), REPLACE(STR(?individual_progression_state_key), "^.*[#/]", ""), STR(?individual_progression_state_key)), "")) = "RenalFlareRisk"), false) || COALESCE((COALESCE(?individual_progression_state_key__key, COALESCE(IF(isIRI(?individual_progression_state_key), REPLACE(STR(?individual_progression_state_key), "^.*[#/]", ""), STR(?individual_progression_state_key)), "")) = "BiopsyIndicated"), false)), false), "ActiveNephritis-Induction", IF(COALESCE((COALESCE(?individual_target_pathway__key, COALESCE(IF(isIRI(?individual_target_pathway), REPLACE(STR(?individual_target_pathway), "^.*[#/]", ""), STR(?individual_target_pathway)), "")) = "type-I-IFN"), false), "IFNSignature-Anifrolumab", IF(COALESCE((COALESCE(?individual_target_pathway__key, COALESCE(IF(isIRI(?individual_target_pathway), REPLACE(STR(?individual_target_pathway), "^.*[#/]", ""), STR(?individual_target_pathway)), "")) = "B-cell/autoantibody"), false), "AutoantibodyDriven-Belimumab", IF(COALESCE((COALESCE(?individual_target_pathway__key, COALESCE(IF(isIRI(?individual_target_pathway), REPLACE(STR(?individual_target_pathway), "^.*[#/]", ""), STR(?individual_target_pathway)), "")) = "IL-17/23"), false), "IL17Axis-Secukinumab", "NoMechanismMatch"))))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_ProgressionVsActionabilityDisagree a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 15 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_ProgressionVsActionabilityDisagree" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:progressionVsActionabilityDisagree ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:individualIsDiseaseProgressing ?individual_is_disease_progressing . }
    OPTIONAL { $this effortless-ntwf:isClinicallyActionable ?is_clinically_actionable . }
                BIND(IF(COALESCE((COALESCE(?individual_is_disease_progressing, false) && COALESCE((!(COALESCE(?is_clinically_actionable, false))), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Individuals ===
effortless-ntwf-shapes:Individuals_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:familyName ?family_name . OPTIONAL { ?family_name erb:key ?family_name__key . } }
    OPTIONAL { $this effortless-ntwf:givenName ?given_name . OPTIONAL { ?given_name erb:key ?given_name__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?given_name__key, IF(isIRI(?given_name), REPLACE(STR(?given_name), "^.*[#/]", ""), STR(?given_name))), ""), " ", COALESCE(COALESCE(?family_name__key, IF(isIRI(?family_name), REPLACE(STR(?family_name), "^.*[#/]", ""), STR(?family_name))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_Slug a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_Slug" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:slug ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:familyName ?family_name . OPTIONAL { ?family_name erb:key ?family_name__key . } }
    OPTIONAL { $this effortless-ntwf:givenName ?given_name . OPTIONAL { ?given_name erb:key ?given_name__key . } }
                BIND(REPLACE(LCASE(CONCAT(COALESCE(COALESCE(?family_name__key, IF(isIRI(?family_name), REPLACE(STR(?family_name), "^.*[#/]", ""), STR(?family_name))), ""), "-", COALESCE(COALESCE(?given_name__key, IF(isIRI(?given_name), REPLACE(STR(?given_name), "^.*[#/]", ""), STR(?given_name))), ""))), " ", "-") AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:slug ?slug . OPTIONAL { ?slug erb:key ?slug__key . } }
                BIND(CONCAT("/intake/new-patient/", COALESCE(COALESCE(?slug__key, IF(isIRI(?slug), REPLACE(STR(?slug), "^.*[#/]", ""), STR(?slug))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_FederatedDatasetNodeLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_FederatedDatasetNodeLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:federatedDatasetNodeLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL { $this effortless-ntwf:federatedDataset ?federated_dataset . }
                OPTIONAL { $this effortless-ntwf:federatedDataset ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:FederatedDatasets . OPTIONAL { ?j1 effortless-ntwf:nodeLabel ?j3 . } }
                BIND(IF((COALESCE(IF(isIRI(?federated_dataset), REPLACE(STR(?federated_dataset), "^.*[#/]", ""), STR(?federated_dataset)), "") = ""), "", ?j3) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_CountOfGenomicVariants a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CountOfGenomicVariants" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countOfGenomicVariants ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:GenomicVariants .
                    ?child effortless-ntwf:individual_GenomicVariants ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_CountOfCausalMechanisms a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CountOfCausalMechanisms" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countOfCausalMechanisms ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:CausalMechanisms .
                    ?child effortless-ntwf:individual_CausalMechanisms ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_CountOfEpistaticInteractions a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CountOfEpistaticInteractions" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countOfEpistaticInteractions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:EpistaticInteractions .
                    ?child effortless-ntwf:individual_EpistaticInteractions ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_RareVariantBurdenScore a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_RareVariantBurdenScore" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:rareVariantBurdenScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:ageYears ?age_years . }
    OPTIONAL { $this effortless-ntwf:countOfGenomicVariants ?count_of_genomic_variants . }
                BIND(IF(COALESCE((COALESCE(?age_years, 0) > 0), false), xsd:double(?count_of_genomic_variants / ?age_years), 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_CausalArchitectureScore a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CausalArchitectureScore" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:causalArchitectureScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:countOfCausalMechanisms ?count_of_causal_mechanisms . }
    OPTIONAL { $this effortless-ntwf:countOfEpistaticInteractions ?count_of_epistatic_interactions . }
    OPTIONAL { $this effortless-ntwf:rareVariantBurdenScore ?rare_variant_burden_score . }
                BIND((((?count_of_causal_mechanisms * 10) + (?count_of_epistatic_interactions * 5)) + ?rare_variant_burden_score) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_IsDevelopmentWindow a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_IsDevelopmentWindow" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isDevelopmentWindow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:ageYears ?age_years . }
                BIND(IF(COALESCE((COALESCE(?age_years, 0) <= 25), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_IsAgingWindow a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_IsAgingWindow" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isAgingWindow ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:ageYears ?age_years . }
                BIND(IF(COALESCE((COALESCE(?age_years, 0) >= 60), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_CountConfirmedCausalNodes a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CountConfirmedCausalNodes" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countConfirmedCausalNodes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:CausalMechanisms .
                    ?child effortless-ntwf:individual_CausalMechanisms ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:isCausalArchitectureNode ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_SumConfirmedCausalConfidence a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_SumConfirmedCausalConfidence" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:sumConfirmedCausalConfidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:CausalMechanisms .
                    ?child effortless-ntwf:individual_CausalMechanisms ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:isCausalArchitectureNode ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child effortless-ntwf:causalConfidence ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_CountCrossAncestryConfirmedNodes a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CountCrossAncestryConfirmedNodes" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countCrossAncestryConfirmedNodes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:CausalMechanisms .
                    ?child effortless-ntwf:individual_CausalMechanisms ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:isAncestryTransportable ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_MaxSeverityScore a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_MaxSeverityScore" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:maxSeverityScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:ClinicalPhenotypes .
                    ?child effortless-ntwf:individual_ClinicalPhenotypes ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:severityScore ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_CountHighSeverityPhenotypes a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CountHighSeverityPhenotypes" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countHighSeverityPhenotypes ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:ClinicalPhenotypes .
                    ?child effortless-ntwf:individual_ClinicalPhenotypes ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:isHighSeverity ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_HasHighSeverityPhenotype a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_HasHighSeverityPhenotype" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:hasHighSeverityPhenotype ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:countHighSeverityPhenotypes ?count_high_severity_phenotypes . }
                BIND(IF(COALESCE((COALESCE(?count_high_severity_phenotypes, 0) >= 1), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_CountPredictedTreatmentResponses a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CountPredictedTreatmentResponses" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countPredictedTreatmentResponses ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:Treatments .
                    ?child effortless-ntwf:individual_Treatments ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:isTreatmentResponsePredicted ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_HasPredictedTreatmentResponse a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_HasPredictedTreatmentResponse" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:hasPredictedTreatmentResponse ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:countPredictedTreatmentResponses ?count_predicted_treatment_responses . }
                BIND(IF(COALESCE((COALESCE(?count_predicted_treatment_responses, 0) >= 1), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_CountSerologyPanels a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CountSerologyPanels" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:countSerologyPanels ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:SerologyObservations .
                    ?child effortless-ntwf:individual $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_CountPreNephriticSignaturePanels a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CountPreNephriticSignaturePanels" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countPreNephriticSignaturePanels ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:SerologyObservations .
                    ?child effortless-ntwf:individual $this .
                    OPTIONAL { ?child effortless-ntwf:isPreNephriticSignaturePanel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_IsInPreNephriticSignatureCluster a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_IsInPreNephriticSignatureCluster" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isInPreNephriticSignatureCluster ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:countPreNephriticSignaturePanels ?count_pre_nephritic_signature_panels . }
                BIND(IF(COALESCE((COALESCE(?count_pre_nephritic_signature_panels, 0) >= 1), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_SignatureStrength a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_SignatureStrength" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:signatureStrength ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:countPreNephriticSignaturePanels ?count_pre_nephritic_signature_panels . }
                BIND(IF(COALESCE((COALESCE(?count_pre_nephritic_signature_panels, 0) >= 2), false), 2, IF(COALESCE((COALESCE(?count_pre_nephritic_signature_panels, 0) >= 1), false), 1, 0)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_MaxProgressionStateOrder a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_MaxProgressionStateOrder" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:maxProgressionStateOrder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:SerologyObservations .
                    ?child effortless-ntwf:individual $this .
                    OPTIONAL { ?child effortless-ntwf:progressionStateOrder ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_LatestSledaiScore a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_LatestSledaiScore" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:latestSledaiScore ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:SerologyObservations .
                    ?child effortless-ntwf:individual $this .
                    OPTIONAL { ?child effortless-ntwf:sledaiScore ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_NephritisProgressionStateKey a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_NephritisProgressionStateKey" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:nephritisProgressionStateKey ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:maxProgressionStateOrder ?max_progression_state_order . }
                BIND(IF(COALESCE((COALESCE(?max_progression_state_order, 0) >= 5), false), "BiopsyIndicated", IF(COALESCE((COALESCE(?max_progression_state_order, 0) >= 4), false), "RenalFlareRisk", IF(COALESCE((COALESCE(?max_progression_state_order, 0) >= 3), false), "EarlyNephritis", IF(COALESCE((COALESCE(?max_progression_state_order, 0) >= 2), false), "SerologicActive", "PresymptomaticAutoimmunity")))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_ActivityTier a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_ActivityTier" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:activityTier ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:latestSledaiScore ?latest_sledai_score . }
                BIND(IF(COALESCE((COALESCE(?latest_sledai_score, 0) >= 12), false), "High / flare", IF(COALESCE((COALESCE(?latest_sledai_score, 0) >= 6), false), "Moderate", IF(COALESCE((COALESCE(?latest_sledai_score, 0) >= 1), false), "Mild", "Quiescent"))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_IsHighDiseaseActivity a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_IsHighDiseaseActivity" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isHighDiseaseActivity ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:latestSledaiScore ?latest_sledai_score . }
                BIND(IF(COALESCE((COALESCE(?latest_sledai_score, 0) >= 12), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_IsDiseaseProgressing a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_IsDiseaseProgressing" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isDiseaseProgressing ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:nephritisProgressionStateKey ?nephritis_progression_state_key . OPTIONAL { ?nephritis_progression_state_key erb:key ?nephritis_progression_state_key__key . } }
                BIND(IF(COALESCE((COALESCE((COALESCE(?nephritis_progression_state_key__key, COALESCE(IF(isIRI(?nephritis_progression_state_key), REPLACE(STR(?nephritis_progression_state_key), "^.*[#/]", ""), STR(?nephritis_progression_state_key)), "")) = "EarlyNephritis"), false) || COALESCE((COALESCE(?nephritis_progression_state_key__key, COALESCE(IF(isIRI(?nephritis_progression_state_key), REPLACE(STR(?nephritis_progression_state_key), "^.*[#/]", ""), STR(?nephritis_progression_state_key)), "")) = "RenalFlareRisk"), false) || COALESCE((COALESCE(?nephritis_progression_state_key__key, COALESCE(IF(isIRI(?nephritis_progression_state_key), REPLACE(STR(?nephritis_progression_state_key), "^.*[#/]", ""), STR(?nephritis_progression_state_key)), "")) = "BiopsyIndicated"), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_TargetPathwayCode a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_TargetPathwayCode" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:targetPathwayCode ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:Individuals .
                    ?child a effortless-ntwf:CausalMechanisms .
                    ?child effortless-ntwf:individual_CausalMechanisms ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:individualId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:targetPathwayCode ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_TargetPathway a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_TargetPathway" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:targetPathway ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:targetPathwayCode ?target_pathway_code . }
                BIND(IF(COALESCE((COALESCE(?target_pathway_code, 0) = 1), false), "type-I-IFN", IF(COALESCE((COALESCE(?target_pathway_code, 0) = 2), false), "B-cell/autoantibody", IF(COALESCE((COALESCE(?target_pathway_code, 0) = 3), false), "T-cell-costim", IF(COALESCE((COALESCE(?target_pathway_code, 0) = 4), false), "IL-17/23", "")))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_CurrentProgressionStateId a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CurrentProgressionStateId" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:currentProgressionStateId ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
    OPTIONAL { $this effortless-ntwf:nephritisProgressionStateKey ?nephritis_progression_state_key . }
                BIND(CONCAT("lupus-nephritis-progression--", COALESCE(IF(isIRI(LCASE(?nephritis_progression_state_key)), REPLACE(STR(LCASE(?nephritis_progression_state_key)), "^.*[#/]", ""), STR(LCASE(?nephritis_progression_state_key))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Individuals_ReachableStatesAhead a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Individuals ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_ReachableStatesAhead" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:reachableStatesAhead ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Individuals .
                OPTIONAL { $this effortless-ntwf:currentProgressionStateId ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:MachineStates . OPTIONAL { ?j1 effortless-ntwf:reachableStateCount ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .

# === Rules for InferenceKinds ===
effortless-ntwf-shapes:InferenceKinds_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InferenceKinds ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InferenceKinds_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InferenceKinds .
    OPTIONAL { $this effortless-ntwf:title ?title . }
                BIND(?title AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:InferenceKinds_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InferenceKinds ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InferenceKinds_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InferenceKinds .
    OPTIONAL { $this effortless-ntwf:inferenceKindId ?inference_kind_id . OPTIONAL { ?inference_kind_id erb:key ?inference_kind_id__key . } }
                BIND(CONCAT("/admin/inference-kinds/", COALESCE(COALESCE(?inference_kind_id__key, IF(isIRI(?inference_kind_id), REPLACE(STR(?inference_kind_id), "^.*[#/]", ""), STR(?inference_kind_id))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for InterventionTargets ===
effortless-ntwf-shapes:InterventionTargets_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InterventionTargets ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InterventionTargets_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InterventionTargets .
    OPTIONAL { $this effortless-ntwf:targetLabel ?target_label . }
                BIND(?target_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:InterventionTargets_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InterventionTargets ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InterventionTargets_ParentPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InterventionTargets .
                OPTIONAL { $this effortless-ntwf:causalMechanism ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:CausalMechanisms . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:InterventionTargets_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InterventionTargets ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InterventionTargets_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InterventionTargets .
    OPTIONAL { $this effortless-ntwf:interventionTargetId ?intervention_target_id . OPTIONAL { ?intervention_target_id erb:key ?intervention_target_id__key . } }
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/targets/", COALESCE(COALESCE(?intervention_target_id__key, IF(isIRI(?intervention_target_id), REPLACE(STR(?intervention_target_id), "^.*[#/]", ""), STR(?intervention_target_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:InterventionTargets_CausalMechanismLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InterventionTargets ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InterventionTargets_CausalMechanismLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:causalMechanismLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InterventionTargets .
                OPTIONAL { $this effortless-ntwf:causalMechanism ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:CausalMechanisms . OPTIONAL { ?j1 effortless-ntwf:mechanismLabel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:InterventionTargets_IsGeneBasedTherapy a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InterventionTargets ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InterventionTargets_IsGeneBasedTherapy" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isGeneBasedTherapy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InterventionTargets .
    OPTIONAL { $this effortless-ntwf:therapyClass ?therapy_class . OPTIONAL { ?therapy_class erb:key ?therapy_class__key . } }
                BIND(IF(COALESCE((COALESCE(?therapy_class__key, COALESCE(IF(isIRI(?therapy_class), REPLACE(STR(?therapy_class), "^.*[#/]", ""), STR(?therapy_class)), "")) = "Gene-based"), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:InterventionTargets_IsCellBasedTherapy a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InterventionTargets ;
