            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Tissues .
    OPTIONAL { $this effortless-ntwf:tissueLabel ?tissue_label . }
                BIND(?tissue_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Tissues_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Tissues ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Tissues_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Tissues .
    OPTIONAL { $this effortless-ntwf:tissueId ?tissue_id . OPTIONAL { ?tissue_id erb:key ?tissue_id__key . } }
                BIND(CONCAT("/tissues/", COALESCE(COALESCE(?tissue_id__key, IF(isIRI(?tissue_id), REPLACE(STR(?tissue_id), "^.*[#/]", ""), STR(?tissue_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Tissues_CountOfOmicsAssays a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Tissues ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Tissues_CountOfOmicsAssays" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countOfOmicsAssays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Tissues .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Tissues .
                    ?child a effortless-ntwf:OmicsAssays .
                    ?child effortless-ntwf:tissue ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:tissueId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Treatments ===
effortless-ntwf-shapes:Treatments_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Treatments_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Treatments .
    OPTIONAL { $this effortless-ntwf:treatmentLabel ?treatment_label . }
                BIND(?treatment_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Treatments_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Treatments_ParentPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Treatments .
                OPTIONAL { $this effortless-ntwf:individual_Treatments ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Treatments_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Treatments_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Treatments .
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
    OPTIONAL { $this effortless-ntwf:treatmentId ?treatment_id . OPTIONAL { ?treatment_id erb:key ?treatment_id__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/treatments/", COALESCE(COALESCE(?treatment_id__key, IF(isIRI(?treatment_id), REPLACE(STR(?treatment_id), "^.*[#/]", ""), STR(?treatment_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Treatments_AutoimmuneDiseaseLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Treatments_AutoimmuneDiseaseLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:autoimmuneDiseaseLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Treatments .
                OPTIONAL { $this effortless-ntwf:autoimmuneDisease ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:AutoimmuneDiseases . OPTIONAL { ?j1 effortless-ntwf:diseaseLabel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Treatments_IsEffectiveTreatment a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Treatments_IsEffectiveTreatment" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isEffectiveTreatment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Treatments .
    OPTIONAL { $this effortless-ntwf:hasAdverseEffect ?has_adverse_effect . }
    OPTIONAL { $this effortless-ntwf:treatmentResponse ?treatment_response . OPTIONAL { ?treatment_response erb:key ?treatment_response__key . } }
                BIND(IF(COALESCE((COALESCE((COALESCE((COALESCE(?treatment_response__key, COALESCE(IF(isIRI(?treatment_response), REPLACE(STR(?treatment_response), "^.*[#/]", ""), STR(?treatment_response)), "")) = "Complete"), false) || COALESCE((COALESCE(?treatment_response__key, COALESCE(IF(isIRI(?treatment_response), REPLACE(STR(?treatment_response), "^.*[#/]", ""), STR(?treatment_response)), "")) = "Partial"), false)), false) && COALESCE((!(COALESCE(?has_adverse_effect, false))), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Treatments_IsMechanismMatched a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Treatments_IsMechanismMatched" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isMechanismMatched ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Treatments .
                OPTIONAL { $this effortless-ntwf:targetsMechanism ?targets_mechanism . }
                OPTIONAL { $this effortless-ntwf:targetsMechanism ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:CausalMechanisms . OPTIONAL { ?j1 effortless-ntwf:isCausalArchitectureNode ?j3 . } }
                BIND(IF((COALESCE(IF(isIRI(?targets_mechanism), REPLACE(STR(?targets_mechanism), "^.*[#/]", ""), STR(?targets_mechanism)), "") = ""), false, ?j3) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Treatments_IsTreatmentResponsePredicted a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Treatments_IsTreatmentResponsePredicted" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isTreatmentResponsePredicted ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Treatments .
    OPTIONAL { $this effortless-ntwf:isEffectiveTreatment ?is_effective_treatment . }
    OPTIONAL { $this effortless-ntwf:isMechanismMatched ?is_mechanism_matched . }
                BIND(IF(COALESCE((COALESCE(?is_effective_treatment, false) && COALESCE(?is_mechanism_matched, false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Treatments_TreatmentResponseDecidingFactor a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Treatments_TreatmentResponseDecidingFactor" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:treatmentResponseDecidingFactor ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Treatments .
    OPTIONAL { $this effortless-ntwf:hasAdverseEffect ?has_adverse_effect . }
    OPTIONAL { $this effortless-ntwf:isMechanismMatched ?is_mechanism_matched . }
    OPTIONAL { $this effortless-ntwf:isTreatmentResponsePredicted ?is_treatment_response_predicted . }
    OPTIONAL { $this effortless-ntwf:treatmentResponse ?treatment_response . OPTIONAL { ?treatment_response erb:key ?treatment_response__key . } }
                BIND(IF(COALESCE(?is_treatment_response_predicted, false), "EffectiveOnConfirmedMechanism", IF(COALESCE((!(COALESCE(?is_mechanism_matched, false))), false), "NoConfirmedMechanism", IF(COALESCE(?has_adverse_effect, false), "AdverseEffect", IF(COALESCE((COALESCE((COALESCE(?treatment_response__key, COALESCE(IF(isIRI(?treatment_response), REPLACE(STR(?treatment_response), "^.*[#/]", ""), STR(?treatment_response)), "")) = "None"), false) || COALESCE((COALESCE(?treatment_response__key, COALESCE(IF(isIRI(?treatment_response), REPLACE(STR(?treatment_response), "^.*[#/]", ""), STR(?treatment_response)), "")) = "Adverse"), false)), false), "NoResponse", "Undetermined")))) AS ?_result)
            }
        """ ;
    ] .

