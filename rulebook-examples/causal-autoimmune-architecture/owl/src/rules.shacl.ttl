@prefix effortless-ntwf: <https://w3id.org/effortless-ntwf#> .
@prefix effortless-ntwf-shapes: <https://w3id.org/effortless-ntwf/shapes#> .
@prefix erb: <https://effortlessapi.com/ns/erb#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# === Rules for AutoimmuneDiseases ===
effortless-ntwf-shapes:AutoimmuneDiseases_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AutoimmuneDiseases ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AutoimmuneDiseases_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AutoimmuneDiseases .
    OPTIONAL { $this effortless-ntwf:diseaseLabel ?disease_label . }
                BIND(?disease_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:AutoimmuneDiseases_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AutoimmuneDiseases ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AutoimmuneDiseases_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AutoimmuneDiseases .
    OPTIONAL { $this effortless-ntwf:autoimmuneDiseaseId ?autoimmune_disease_id . OPTIONAL { ?autoimmune_disease_id erb:key ?autoimmune_disease_id__key . } }
                BIND(CONCAT("/diseases/", COALESCE(COALESCE(?autoimmune_disease_id__key, IF(isIRI(?autoimmune_disease_id), REPLACE(STR(?autoimmune_disease_id), "^.*[#/]", ""), STR(?autoimmune_disease_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:AutoimmuneDiseases_CountOfDiseaseStages a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AutoimmuneDiseases ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AutoimmuneDiseases_CountOfDiseaseStages" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countOfDiseaseStages ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AutoimmuneDiseases .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:AutoimmuneDiseases .
                    ?child a effortless-ntwf:DiseaseStages .
                    ?child effortless-ntwf:autoimmuneDisease ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:autoimmuneDiseaseId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:AutoimmuneDiseases_CountOfInterventionTargets a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AutoimmuneDiseases ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AutoimmuneDiseases_CountOfInterventionTargets" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countOfInterventionTargets ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AutoimmuneDiseases .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:AutoimmuneDiseases .
                    ?child a effortless-ntwf:InterventionTargets .
                    ?child effortless-ntwf:autoimmuneDisease ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:autoimmuneDiseaseId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Axioms ===
effortless-ntwf-shapes:Axioms_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Axioms ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Axioms_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Axioms .
    OPTIONAL { $this effortless-ntwf:statement ?statement . }
                BIND(?statement AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Axioms_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Axioms ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Axioms_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Axioms .
    OPTIONAL { $this effortless-ntwf:axiomId ?axiom_id . OPTIONAL { ?axiom_id erb:key ?axiom_id__key . } }
                BIND(CONCAT("/admin/axioms/", COALESCE(COALESCE(?axiom_id__key, IF(isIRI(?axiom_id), REPLACE(STR(?axiom_id), "^.*[#/]", ""), STR(?axiom_id))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for CalibrationBins ===
effortless-ntwf-shapes:CalibrationBins_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CalibrationBins ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CalibrationBins_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CalibrationBins .
    OPTIONAL { $this effortless-ntwf:binLabel ?bin_label . }
                BIND(?bin_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CalibrationBins_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CalibrationBins ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CalibrationBins_ParentPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CalibrationBins .
                OPTIONAL { $this effortless-ntwf:individualPrediction ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:IndividualPredictions . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CalibrationBins_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CalibrationBins ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CalibrationBins_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CalibrationBins .
    OPTIONAL { $this effortless-ntwf:calibrationBinId ?calibration_bin_id . OPTIONAL { ?calibration_bin_id erb:key ?calibration_bin_id__key . } }
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/bins/", COALESCE(COALESCE(?calibration_bin_id__key, IF(isIRI(?calibration_bin_id), REPLACE(STR(?calibration_bin_id), "^.*[#/]", ""), STR(?calibration_bin_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CalibrationBins_BinAbsError a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CalibrationBins ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CalibrationBins_BinAbsError" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:binAbsError ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CalibrationBins .
    OPTIONAL { $this effortless-ntwf:observedEventRate ?observed_event_rate . }
    OPTIONAL { $this effortless-ntwf:predictedProbabilityBand ?predicted_probability_band . }
                BIND(IF(COALESCE((COALESCE(?predicted_probability_band, 0) >= COALESCE(?observed_event_rate, 0)), false), (?predicted_probability_band - ?observed_event_rate), (?observed_event_rate - ?predicted_probability_band)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CalibrationBins_IsWellCalibratedBin a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CalibrationBins ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CalibrationBins_IsWellCalibratedBin" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isWellCalibratedBin ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CalibrationBins .
    OPTIONAL { $this effortless-ntwf:binAbsError ?bin_abs_error . }
    OPTIONAL { $this effortless-ntwf:coverageCount ?coverage_count . }
                BIND(IF(COALESCE((COALESCE((COALESCE(?coverage_count, 0) >= 20), false) && COALESCE((COALESCE(?bin_abs_error, 0) <= 0.1), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for CausalMechanisms ===
effortless-ntwf-shapes:CausalMechanisms_TargetPathwayCode a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_TargetPathwayCode" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:targetPathwayCode ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
    OPTIONAL { $this effortless-ntwf:targetPathway ?target_pathway . OPTIONAL { ?target_pathway erb:key ?target_pathway__key . } }
                BIND(IF(COALESCE((COALESCE(?target_pathway__key, COALESCE(IF(isIRI(?target_pathway), REPLACE(STR(?target_pathway), "^.*[#/]", ""), STR(?target_pathway)), "")) = "type-I-IFN"), false), 1, IF(COALESCE((COALESCE(?target_pathway__key, COALESCE(IF(isIRI(?target_pathway), REPLACE(STR(?target_pathway), "^.*[#/]", ""), STR(?target_pathway)), "")) = "B-cell/autoantibody"), false), 2, IF(COALESCE((COALESCE(?target_pathway__key, COALESCE(IF(isIRI(?target_pathway), REPLACE(STR(?target_pathway), "^.*[#/]", ""), STR(?target_pathway)), "")) = "T-cell-costim"), false), 3, IF(COALESCE((COALESCE(?target_pathway__key, COALESCE(IF(isIRI(?target_pathway), REPLACE(STR(?target_pathway), "^.*[#/]", ""), STR(?target_pathway)), "")) = "IL-17/23"), false), 4, 0)))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
    OPTIONAL { $this effortless-ntwf:mechanismLabel ?mechanism_label . }
                BIND(?mechanism_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_ParentPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
                OPTIONAL { $this effortless-ntwf:individual_CausalMechanisms ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
    OPTIONAL { $this effortless-ntwf:causalMechanismId ?causal_mechanism_id . OPTIONAL { ?causal_mechanism_id erb:key ?causal_mechanism_id__key . } }
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/mechanisms/", COALESCE(COALESCE(?causal_mechanism_id__key, IF(isIRI(?causal_mechanism_id), REPLACE(STR(?causal_mechanism_id), "^.*[#/]", ""), STR(?causal_mechanism_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_IndividualAncestryLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_IndividualAncestryLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:individualAncestryLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
                OPTIONAL { $this effortless-ntwf:individual_CausalMechanisms ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:ancestryLabel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_CountQualifiedEvidence a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_CountQualifiedEvidence" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countQualifiedEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:CausalMechanisms .
                    ?child a effortless-ntwf:EvidenceItems .
                    ?child effortless-ntwf:causalMechanism ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:causalMechanismId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:isQualifiedEvidence ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_CountModalitiesSupporting a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_CountModalitiesSupporting" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countModalitiesSupporting ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:CausalMechanisms .
                    ?child a effortless-ntwf:EvidenceItems .
                    ?child effortless-ntwf:causalMechanism ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:causalMechanismId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:isCrossModality ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child effortless-ntwf:isQualifiedEvidence ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER(BOUND(?c4) && ?c4 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_CountInterventionTargets a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_CountInterventionTargets" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countInterventionTargets ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:CausalMechanisms .
                    ?child a effortless-ntwf:InterventionTargets .
                    ?child effortless-ntwf:causalMechanism ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:causalMechanismId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_IsExperimentallyFalsifiable a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_IsExperimentallyFalsifiable" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isExperimentallyFalsifiable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
    OPTIONAL { $this effortless-ntwf:countInterventionTargets ?count_intervention_targets . }
    OPTIONAL { $this effortless-ntwf:countQualifiedEvidence ?count_qualified_evidence . }
                BIND(IF(COALESCE((COALESCE((COALESCE(?count_intervention_targets, 0) >= 1), false) && COALESCE((COALESCE(?count_qualified_evidence, 0) >= 1), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_CountReplications a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_CountReplications" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countReplications ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:CausalMechanisms .
                    ?child a effortless-ntwf:CohortReplications .
                    ?child effortless-ntwf:causalMechanism ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:causalMechanismId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_CountConcordantReplications a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_CountConcordantReplications" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countConcordantReplications ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:CausalMechanisms .
                    ?child a effortless-ntwf:CohortReplications .
                    ?child effortless-ntwf:causalMechanism ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:causalMechanismId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:replicatedAtNominalSig ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_CountCrossAncestryConcordant a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_CountCrossAncestryConcordant" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countCrossAncestryConcordant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:CausalMechanisms .
                    ?child a effortless-ntwf:CohortReplications .
                    ?child effortless-ntwf:causalMechanism ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:causalMechanismId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:isCrossAncestryConcordant ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_ReplicationFraction a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_ReplicationFraction" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:replicationFraction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
    OPTIONAL { $this effortless-ntwf:countConcordantReplications ?count_concordant_replications . }
    OPTIONAL { $this effortless-ntwf:countReplications ?count_replications . }
                BIND(IF(COALESCE((COALESCE(?count_replications, 0) > 0), false), xsd:double(?count_concordant_replications / ?count_replications), 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_ReplicatesAcrossCohorts a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_ReplicatesAcrossCohorts" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:replicatesAcrossCohorts ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
    OPTIONAL { $this effortless-ntwf:countConcordantReplications ?count_concordant_replications . }
    OPTIONAL { $this effortless-ntwf:countReplications ?count_replications . }
                BIND(IF(COALESCE((COALESCE((COALESCE(?count_replications, 0) >= 2), false) && COALESCE((COALESCE(?count_concordant_replications, 0) >= 2), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_CountNegControlTests a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_CountNegControlTests" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countNegControlTests ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:CausalMechanisms .
                    ?child a effortless-ntwf:NegativeControlTests .
                    ?child effortless-ntwf:causalMechanism ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:causalMechanismId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_CountNegControlSurvived a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_CountNegControlSurvived" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countNegControlSurvived ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:CausalMechanisms .
                    ?child a effortless-ntwf:NegativeControlTests .
                    ?child effortless-ntwf:causalMechanism ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:causalMechanismId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:isSurvived ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_SurvivesNegativeControls a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_SurvivesNegativeControls" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:survivesNegativeControls ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
    OPTIONAL { $this effortless-ntwf:countNegControlSurvived ?count_neg_control_survived . }
    OPTIONAL { $this effortless-ntwf:countNegControlTests ?count_neg_control_tests . }
                BIND(IF(COALESCE((COALESCE((COALESCE(?count_neg_control_tests, 0) >= 1), false) && COALESCE((COALESCE(?count_neg_control_survived, 0) = COALESCE(?count_neg_control_tests, 0)), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_IsSpuriousDerived a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_IsSpuriousDerived" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isSpuriousDerived ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
    OPTIONAL { $this effortless-ntwf:countModalitiesSupporting ?count_modalities_supporting . }
    OPTIONAL { $this effortless-ntwf:hasPleiotropy ?has_pleiotropy . }
    OPTIONAL { $this effortless-ntwf:replicatesAcrossCohorts ?replicates_across_cohorts . }
    OPTIONAL { $this effortless-ntwf:survivesNegativeControls ?survives_negative_controls . }
                BIND(IF(COALESCE((COALESCE((!(COALESCE(?replicates_across_cohorts, false))), false) || COALESCE((!(COALESCE(?survives_negative_controls, false))), false) || COALESCE((COALESCE(?count_modalities_supporting, 0) < 2), false) || COALESCE(?has_pleiotropy, false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_CausalConfidence a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_CausalConfidence" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:causalConfidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
    OPTIONAL { $this effortless-ntwf:countModalitiesSupporting ?count_modalities_supporting . }
    OPTIONAL { $this effortless-ntwf:countQualifiedEvidence ?count_qualified_evidence . }
    OPTIONAL { $this effortless-ntwf:replicationFraction ?replication_fraction . }
    OPTIONAL { $this effortless-ntwf:survivesNegativeControls ?survives_negative_controls . }
                BIND(IF(COALESCE((COALESCE(((((0.3 * IF(COALESCE((COALESCE(?count_qualified_evidence, 0) >= 4), false), 1, xsd:double(?count_qualified_evidence / 4))) + (0.2 * IF(COALESCE((COALESCE(?count_modalities_supporting, 0) >= 3), false), 1, xsd:double(?count_modalities_supporting / 3)))) + (0.3 * ?replication_fraction)) + (0.2 * IF(COALESCE(?survives_negative_controls, false), 1, 0))), 0) > 1), false), 1, ((((0.3 * IF(COALESCE((COALESCE(?count_qualified_evidence, 0) >= 4), false), 1, xsd:double(?count_qualified_evidence / 4))) + (0.2 * IF(COALESCE((COALESCE(?count_modalities_supporting, 0) >= 3), false), 1, xsd:double(?count_modalities_supporting / 3)))) + (0.3 * ?replication_fraction)) + (0.2 * IF(COALESCE(?survives_negative_controls, false), 1, 0)))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_VariantIsCausalCandidate a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_VariantIsCausalCandidate" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:variantIsCausalCandidate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
                OPTIONAL { $this effortless-ntwf:genomicVariant ?genomic_variant . }
                OPTIONAL { $this effortless-ntwf:genomicVariant ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:GenomicVariants . OPTIONAL { ?j1 effortless-ntwf:isCausalCandidate ?j3 . } }
                BIND(IF((COALESCE(IF(isIRI(?genomic_variant), REPLACE(STR(?genomic_variant), "^.*[#/]", ""), STR(?genomic_variant)), "") = ""), false, ?j3) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_IsCausalArchitectureNode a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_IsCausalArchitectureNode" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isCausalArchitectureNode ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
    OPTIONAL { $this effortless-ntwf:causalConfidence ?causal_confidence . }
    OPTIONAL { $this effortless-ntwf:environmentalExposure ?environmental_exposure . OPTIONAL { ?environmental_exposure erb:key ?environmental_exposure__key . } }
    OPTIONAL { $this effortless-ntwf:isExperimentallyFalsifiable ?is_experimentally_falsifiable . }
    OPTIONAL { $this effortless-ntwf:isSpuriousDerived ?is_spurious_derived . }
    OPTIONAL { $this effortless-ntwf:variantIsCausalCandidate ?variant_is_causal_candidate . }
                BIND(IF(COALESCE((COALESCE((COALESCE(?causal_confidence, 0) >= 0.7), false) && COALESCE(?is_experimentally_falsifiable, false) && COALESCE((!(COALESCE(?is_spurious_derived, false))), false) && COALESCE((COALESCE(?variant_is_causal_candidate, false) || COALESCE((COALESCE(?environmental_exposure__key, COALESCE(IF(isIRI(?environmental_exposure), REPLACE(STR(?environmental_exposure), "^.*[#/]", ""), STR(?environmental_exposure)), "")) != ""), false)), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CausalMechanisms_IsAncestryTransportable a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CausalMechanisms ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CausalMechanisms_IsAncestryTransportable" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isAncestryTransportable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CausalMechanisms .
    OPTIONAL { $this effortless-ntwf:countCrossAncestryConcordant ?count_cross_ancestry_concordant . }
    OPTIONAL { $this effortless-ntwf:isCausalArchitectureNode ?is_causal_architecture_node . }
                BIND(IF(COALESCE((COALESCE(?is_causal_architecture_node, false) && COALESCE((COALESCE(?count_cross_ancestry_concordant, 0) >= 1), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ClinicalPhenotypes ===
effortless-ntwf-shapes:ClinicalPhenotypes_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ClinicalPhenotypes ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClinicalPhenotypes_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClinicalPhenotypes .
    OPTIONAL { $this effortless-ntwf:phenotypeLabel ?phenotype_label . }
                BIND(?phenotype_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ClinicalPhenotypes_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ClinicalPhenotypes ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClinicalPhenotypes_ParentPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClinicalPhenotypes .
                OPTIONAL { $this effortless-ntwf:individual_ClinicalPhenotypes ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ClinicalPhenotypes_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ClinicalPhenotypes ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClinicalPhenotypes_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClinicalPhenotypes .
    OPTIONAL { $this effortless-ntwf:clinicalPhenotypeId ?clinical_phenotype_id . OPTIONAL { ?clinical_phenotype_id erb:key ?clinical_phenotype_id__key . } }
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/phenotypes/", COALESCE(COALESCE(?clinical_phenotype_id__key, IF(isIRI(?clinical_phenotype_id), REPLACE(STR(?clinical_phenotype_id), "^.*[#/]", ""), STR(?clinical_phenotype_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ClinicalPhenotypes_DiseaseStageLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ClinicalPhenotypes ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClinicalPhenotypes_DiseaseStageLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:diseaseStageLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClinicalPhenotypes .
                OPTIONAL { $this effortless-ntwf:diseaseStage ?disease_stage . }
                OPTIONAL { $this effortless-ntwf:diseaseStage ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:DiseaseStages . OPTIONAL { ?j1 effortless-ntwf:stageLabel ?j3 . } }
                BIND(IF((COALESCE(IF(isIRI(?disease_stage), REPLACE(STR(?disease_stage), "^.*[#/]", ""), STR(?disease_stage)), "") = ""), "", ?j3) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ClinicalPhenotypes_IsHighSeverity a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ClinicalPhenotypes ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClinicalPhenotypes_IsHighSeverity" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isHighSeverity ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClinicalPhenotypes .
    OPTIONAL { $this effortless-ntwf:severityScore ?severity_score . }
                BIND(IF(COALESCE((COALESCE(?severity_score, 0) > 7), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ClinicalPhenotypes_IsPresymptomaticPhenotype a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ClinicalPhenotypes ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ClinicalPhenotypes_IsPresymptomaticPhenotype" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isPresymptomaticPhenotype ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ClinicalPhenotypes .
    OPTIONAL { $this effortless-ntwf:diseaseStageLabel ?disease_stage_label . OPTIONAL { ?disease_stage_label erb:key ?disease_stage_label__key . } }
                BIND(IF(COALESCE((COALESCE(?disease_stage_label__key, COALESCE(IF(isIRI(?disease_stage_label), REPLACE(STR(?disease_stage_label), "^.*[#/]", ""), STR(?disease_stage_label)), "")) = "Presymptomatic"), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for CohortReplications ===
effortless-ntwf-shapes:CohortReplications_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CohortReplications ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CohortReplications_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CohortReplications .
    OPTIONAL { $this effortless-ntwf:replicationLabel ?replication_label . }
                BIND(?replication_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CohortReplications_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CohortReplications ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CohortReplications_ParentPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CohortReplications .
                OPTIONAL { $this effortless-ntwf:causalMechanism ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:CausalMechanisms . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CohortReplications_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CohortReplications ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CohortReplications_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CohortReplications .
    OPTIONAL { $this effortless-ntwf:cohortReplicationId ?cohort_replication_id . OPTIONAL { ?cohort_replication_id erb:key ?cohort_replication_id__key . } }
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/replications/", COALESCE(COALESCE(?cohort_replication_id__key, IF(isIRI(?cohort_replication_id), REPLACE(STR(?cohort_replication_id), "^.*[#/]", ""), STR(?cohort_replication_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CohortReplications_ReplicatedAtNominalSig a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CohortReplications ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CohortReplications_ReplicatedAtNominalSig" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:replicatedAtNominalSig ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CohortReplications .
    OPTIONAL { $this effortless-ntwf:replicationEffectSign ?replication_effect_sign . }
    OPTIONAL { $this effortless-ntwf:replicationPValue ?replication_p_value . }
                BIND(IF(COALESCE((COALESCE((COALESCE(?replication_p_value, 0) <= 0.05), false) && COALESCE((COALESCE(?replication_effect_sign, 0) = 1), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CohortReplications_MechanismPrimaryAncestry a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CohortReplications ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CohortReplications_MechanismPrimaryAncestry" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:mechanismPrimaryAncestry ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CohortReplications .
                OPTIONAL { $this effortless-ntwf:causalMechanism ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:CausalMechanisms . OPTIONAL { ?j1 effortless-ntwf:individualAncestryLabel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CohortReplications_IsDifferentAncestryReplication a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CohortReplications ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CohortReplications_IsDifferentAncestryReplication" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isDifferentAncestryReplication ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CohortReplications .
    OPTIONAL { $this effortless-ntwf:mechanismPrimaryAncestry ?mechanism_primary_ancestry . }
    OPTIONAL { $this effortless-ntwf:replicationAncestryLabel ?replication_ancestry_label . }
                BIND(IF(COALESCE(COALESCE((?replication_ancestry_label = ?mechanism_primary_ancestry), ((!BOUND(?replication_ancestry_label) || STR(?replication_ancestry_label) = "") && (!BOUND(?mechanism_primary_ancestry) || STR(?mechanism_primary_ancestry) = ""))), false), false, true) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CohortReplications_IsCrossAncestryConcordant a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CohortReplications ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CohortReplications_IsCrossAncestryConcordant" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isCrossAncestryConcordant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CohortReplications .
    OPTIONAL { $this effortless-ntwf:isDifferentAncestryReplication ?is_different_ancestry_replication . }
    OPTIONAL { $this effortless-ntwf:replicatedAtNominalSig ?replicated_at_nominal_sig . }
                BIND(IF(COALESCE((COALESCE(?replicated_at_nominal_sig, false) && COALESCE(?is_different_ancestry_replication, false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for CounterfactualTrajectories ===
effortless-ntwf-shapes:CounterfactualTrajectories_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CounterfactualTrajectories ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CounterfactualTrajectories_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CounterfactualTrajectories .
    OPTIONAL { $this effortless-ntwf:trajectoryLabel ?trajectory_label . }
                BIND(?trajectory_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CounterfactualTrajectories_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CounterfactualTrajectories ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CounterfactualTrajectories_ParentPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CounterfactualTrajectories .
                OPTIONAL { $this effortless-ntwf:individual_CounterfactualTrajectories ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CounterfactualTrajectories_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CounterfactualTrajectories ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CounterfactualTrajectories_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CounterfactualTrajectories .
    OPTIONAL { $this effortless-ntwf:counterfactualTrajectoryId ?counterfactual_trajectory_id . OPTIONAL { ?counterfactual_trajectory_id erb:key ?counterfactual_trajectory_id__key . } }
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/trajectories/", COALESCE(COALESCE(?counterfactual_trajectory_id__key, IF(isIRI(?counterfactual_trajectory_id), REPLACE(STR(?counterfactual_trajectory_id), "^.*[#/]", ""), STR(?counterfactual_trajectory_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CounterfactualTrajectories_AutoimmuneDiseaseLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CounterfactualTrajectories ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CounterfactualTrajectories_AutoimmuneDiseaseLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:autoimmuneDiseaseLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CounterfactualTrajectories .
                OPTIONAL { $this effortless-ntwf:autoimmuneDisease ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:AutoimmuneDiseases . OPTIONAL { ?j1 effortless-ntwf:diseaseLabel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CounterfactualTrajectories_IsWorseningTrajectory a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CounterfactualTrajectories ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CounterfactualTrajectories_IsWorseningTrajectory" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isWorseningTrajectory ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CounterfactualTrajectories .
    OPTIONAL { $this effortless-ntwf:projectedSeverity ?projected_severity . }
                BIND(IF(COALESCE((COALESCE(?projected_severity, 0) > 7), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for DiseaseDomainConcepts ===
effortless-ntwf-shapes:DiseaseDomainConcepts_Name a sh:NodeShape ;
