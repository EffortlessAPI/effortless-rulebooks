            CONSTRUCT {
                $this effortless-ntwf:patientStratificationTier ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:predictedValue ?predicted_value . }
                BIND(IF(COALESCE((COALESCE(?predicted_value, 0) >= 7), false), "High-Risk Pathway", IF(COALESCE((COALESCE(?predicted_value, 0) >= 4), false), "Moderate-Risk Pathway", "Low-Risk Pathway")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_PredictedSeverityValue a sh:NodeShape ;
