            CONSTRUCT {
                $this effortless-ntwf:isSeverityActionable ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:hasSpuriousCorrelationFlag ?has_spurious_correlation_flag . }
    OPTIONAL { $this effortless-ntwf:individualHasHighSeverityPhenotype ?individual_has_high_severity_phenotype . }
    OPTIONAL { $this effortless-ntwf:restsOnConfirmedMechanism ?rests_on_confirmed_mechanism . }
                BIND(IF(COALESCE((COALESCE(?individual_has_high_severity_phenotype, false) && COALESCE(?rests_on_confirmed_mechanism, false) && COALESCE((!(COALESCE(?has_spurious_correlation_flag, false))), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_SeverityDecidingFactor a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 13 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_SeverityDecidingFactor" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:severityDecidingFactor ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IndividualPredictions .
    OPTIONAL { $this effortless-ntwf:hasSpuriousCorrelationFlag ?has_spurious_correlation_flag . }
    OPTIONAL { $this effortless-ntwf:individualHasHighSeverityPhenotype ?individual_has_high_severity_phenotype . }
    OPTIONAL { $this effortless-ntwf:isSeverityActionable ?is_severity_actionable . }
    OPTIONAL { $this effortless-ntwf:restsOnConfirmedMechanism ?rests_on_confirmed_mechanism . }
                BIND(IF(COALESCE(?is_severity_actionable, false), "HighSeverityOnConfirmedMechanism", IF(COALESCE((!(COALESCE(?individual_has_high_severity_phenotype, false))), false), "NotHighSeverity", IF(COALESCE((!(COALESCE(?rests_on_confirmed_mechanism, false))), false), "NoValidatedMechanism", IF(COALESCE(?has_spurious_correlation_flag, false), "SpuriousFlag", "Undetermined")))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IsTreatmentResponseActionable a sh:NodeShape ;
