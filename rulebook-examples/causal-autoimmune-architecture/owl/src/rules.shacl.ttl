# === Rules for OmicsAssays ===
effortless-ntwf-shapes:OmicsAssays_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OmicsAssays ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OmicsAssays_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OmicsAssays .
    OPTIONAL { $this effortless-ntwf:assayLabel ?assay_label . }
                BIND(?assay_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:OmicsAssays_ParentPath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OmicsAssays ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OmicsAssays_ParentPath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:parentPath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OmicsAssays .
                OPTIONAL { $this effortless-ntwf:individual_OmicsAssays ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:OmicsAssays_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OmicsAssays ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OmicsAssays_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OmicsAssays .
    OPTIONAL { $this effortless-ntwf:omicsAssayId ?omics_assay_id . OPTIONAL { ?omics_assay_id erb:key ?omics_assay_id__key . } }
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/assays/", COALESCE(COALESCE(?omics_assay_id__key, IF(isIRI(?omics_assay_id), REPLACE(STR(?omics_assay_id), "^.*[#/]", ""), STR(?omics_assay_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:OmicsAssays_ModalityLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OmicsAssays ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OmicsAssays_ModalityLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:modalityLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OmicsAssays .
                OPTIONAL { $this effortless-ntwf:omicsModality ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:OmicsModalities . OPTIONAL { ?j1 effortless-ntwf:modalityLabel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:OmicsAssays_TissueLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OmicsAssays ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OmicsAssays_TissueLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:tissueLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OmicsAssays .
                OPTIONAL { $this effortless-ntwf:tissue ?tissue . }
                OPTIONAL { $this effortless-ntwf:tissue ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Tissues . OPTIONAL { ?j1 effortless-ntwf:tissueLabel ?j3 . } }
                BIND(IF((COALESCE(IF(isIRI(?tissue), REPLACE(STR(?tissue), "^.*[#/]", ""), STR(?tissue)), "") = ""), "Missing Tissue", ?j3) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:OmicsAssays_HasBatchEffectRisk a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OmicsAssays ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OmicsAssays_HasBatchEffectRisk" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:hasBatchEffectRisk ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OmicsAssays .
    OPTIONAL { $this effortless-ntwf:measurementErrorScore ?measurement_error_score . }
                BIND(IF(COALESCE((COALESCE(?measurement_error_score, 0) > 0.3), false), true, false) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:OmicsAssays_IsHighQualityAssay a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OmicsAssays ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OmicsAssays_IsHighQualityAssay" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isHighQualityAssay ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OmicsAssays .
    OPTIONAL { $this effortless-ntwf:hasBatchEffectRisk ?has_batch_effect_risk . }
    OPTIONAL { $this effortless-ntwf:measurementErrorScore ?measurement_error_score . }
                BIND(IF(COALESCE((COALESCE((!(COALESCE(?has_batch_effect_risk, false))), false) && COALESCE((COALESCE(?measurement_error_score, 0) < 0.15), false)), false), true, false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for OmicsModalities ===
effortless-ntwf-shapes:OmicsModalities_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OmicsModalities ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OmicsModalities_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OmicsModalities .
    OPTIONAL { $this effortless-ntwf:modalityLabel ?modality_label . }
                BIND(?modality_label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:OmicsModalities_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OmicsModalities ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OmicsModalities_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OmicsModalities .
    OPTIONAL { $this effortless-ntwf:omicsModalityId ?omics_modality_id . OPTIONAL { ?omics_modality_id erb:key ?omics_modality_id__key . } }
                BIND(CONCAT("/omics-modalities/", COALESCE(COALESCE(?omics_modality_id__key, IF(isIRI(?omics_modality_id), REPLACE(STR(?omics_modality_id), "^.*[#/]", ""), STR(?omics_modality_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:OmicsModalities_CountOfOmicsAssays a sh:NodeShape ;
    sh:targetClass effortless-ntwf:OmicsModalities ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_OmicsModalities_CountOfOmicsAssays" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:countOfOmicsAssays ?_result .
            }
            WHERE {
    $this a effortless-ntwf:OmicsModalities .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:OmicsModalities .
                    ?child a effortless-ntwf:OmicsAssays .
                    ?child effortless-ntwf:omicsModality ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:omicsModalityId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for OpenQuestions ===
