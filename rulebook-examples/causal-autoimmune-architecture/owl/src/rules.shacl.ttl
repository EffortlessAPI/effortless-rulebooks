                BIND(CONCAT("/admin/tests-for-success/", COALESCE(COALESCE(?test_for_success_id__key, IF(isIRI(?test_for_success_id), REPLACE(STR(?test_for_success_id), "^.*[#/]", ""), STR(?test_for_success_id))), "")) AS ?_result)
            }
