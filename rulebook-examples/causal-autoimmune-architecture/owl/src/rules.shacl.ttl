    $this a effortless-ntwf:EpistaticInteractions .
                OPTIONAL { $this effortless-ntwf:individual_EpistaticInteractions ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a effortless-ntwf:Individuals . OPTIONAL { ?j1 effortless-ntwf:relativePath ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EpistaticInteractions_RelativePath a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EpistaticInteractions ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EpistaticInteractions_RelativePath" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:relativePath ?_result .
            }
            WHERE {
    $this a effortless-ntwf:EpistaticInteractions .
    OPTIONAL { $this effortless-ntwf:epistaticInteractionId ?epistatic_interaction_id . OPTIONAL { ?epistatic_interaction_id erb:key ?epistatic_interaction_id__key . } }
    OPTIONAL { $this effortless-ntwf:parentPath ?parent_path . OPTIONAL { ?parent_path erb:key ?parent_path__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_path__key, IF(isIRI(?parent_path), REPLACE(STR(?parent_path), "^.*[#/]", ""), STR(?parent_path))), ""), "/epistasis/", COALESCE(COALESCE(?epistatic_interaction_id__key, IF(isIRI(?epistatic_interaction_id), REPLACE(STR(?epistatic_interaction_id), "^.*[#/]", ""), STR(?epistatic_interaction_id))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:EpistaticInteractions_IsHighOrderEpistasis a sh:NodeShape ;
    sh:targetClass effortless-ntwf:EpistaticInteractions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_EpistaticInteractions_IsHighOrderEpistasis" ;
