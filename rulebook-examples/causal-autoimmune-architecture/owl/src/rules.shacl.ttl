    OPTIONAL { $this effortless-ntwf:isTransportableToAbsentAncestry ?is_transportable_to_absent_ancestry . }
                BIND(IF(COALESCE((!(COALESCE(?is_ancestry_holdout, false))), false), "NotApplicable", IF(COALESCE(?is_transportable_to_absent_ancestry, false), "PASS-tested", "FAIL")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IndividualPredictions_IsHighConfidencePrediction a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IndividualPredictions ;
    sh:order 12 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IndividualPredictions_IsHighConfidencePrediction" ;
