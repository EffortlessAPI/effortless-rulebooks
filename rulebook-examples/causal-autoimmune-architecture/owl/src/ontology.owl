effortless-ntwf:transitionRuleCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StateMachines ;
    rdfs:range xsd:decimal ;
    rdfs:label "TransitionRuleCount" ;
    rdfs:comment "Count of StateTransitionRules in this machine." .

effortless-ntwf:transportGateStatus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:string ;
    rdfs:label "TransportGateStatus" ;
    rdfs:comment "RENDER ONLY (does NOT feed the keystone): honest three-state view of the transport gate so a vacuous in-training pass is never shown as evidentiary. NotApplicable = in-training ancestry (gate did not bite); PASS-tested = holdout with a confirmed cross-ancestry transport; FAIL = holdout without one. Sits beside IsAncestryTransportSafe (which the keystone still reads) purely to keep the writeup from implying transport evidence it never used." .

effortless-ntwf:treatmentId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Treatments ;
    rdfs:range xsd:string ;
    rdfs:label "TreatmentId" ;
    rdfs:comment "Stable identifier for each treatment record." .

effortless-ntwf:treatmentLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Treatments ;
    rdfs:range xsd:string ;
    rdfs:label "TreatmentLabel" ;
    rdfs:comment "Therapy name." .

effortless-ntwf:treatmentLineDecidingFactor a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:string ;
    rdfs:label "TreatmentLineDecidingFactor" ;
    rdfs:comment "The single deciding reason for the recommended line (mirrors DecidingGate style)." .

effortless-ntwf:treatmentResponse a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Treatments ;
    rdfs:range xsd:string ;
    rdfs:label "TreatmentResponse" ;
    rdfs:comment "Response category: Complete, Partial, None, Adverse." .

effortless-ntwf:treatmentResponseDecidingFactor a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "TreatmentResponseDecidingFactor" .

effortless-ntwf:treatments a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Treatments ;
    rdfs:label "Treatments" .

effortless-ntwf:triggerEndpoint a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StateTransitionRules ;
    rdfs:range xsd:string ;
    rdfs:label "TriggerEndpoint" ;
    rdfs:comment "API endpoint whose action fires this transition." .

effortless-ntwf:triggeredByRole a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "TriggeredByRole" .

