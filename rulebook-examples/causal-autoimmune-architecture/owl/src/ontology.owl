    rdfs:range xsd:dateTime ;
    rdfs:label "MeasurementDate" ;
    rdfs:comment "Date of phenotype assessment." .

effortless-ntwf:measurementErrorScore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OmicsAssays ;
    rdfs:range xsd:decimal ;
    rdfs:label "MeasurementErrorScore" ;
    rdfs:comment "Estimated measurement error (0-1)." .

effortless-ntwf:mechanismLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CausalMechanisms ;
    rdfs:range xsd:string ;
    rdfs:label "MechanismLabel" ;
