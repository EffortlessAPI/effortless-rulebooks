effortless-ntwf:metaLine a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Features ;
    rdfs:range xsd:string ;
    rdfs:label "MetaLine" ;
    rdfs:comment "One-line meta summary for the catalog (category - priority - ref count)." .

effortless-ntwf:modalityLabel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ModalityLabel" .

effortless-ntwf:modelingStatus a owl:DatatypeProperty ;
