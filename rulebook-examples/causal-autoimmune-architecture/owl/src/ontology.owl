    rdfs:comment "Description of hypothetical scenario." .

effortless-ntwf:transitionAt a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StateTransitions ;
    rdfs:range xsd:string ;
    rdfs:label "TransitionAt" ;
