    rdfs:range xsd:string ;
    rdfs:label "MechanismPrimaryAncestry" ;
    rdfs:comment "Ancestry of the individual the mechanism was discovered in." .

effortless-ntwf:mechanismType a owl:DatatypeProperty ;
