    rdfs:label "Individual" ;
    rdfs:comment "Exposed individual." .

effortless-ntwf:individual_EpistaticInteractions a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EpistaticInteractions ;
    rdfs:range xsd:string ;
    rdfs:label "Individual" ;
    rdfs:comment "Individual exhibiting interaction." .

effortless-ntwf:individual_GenomicVariants a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GenomicVariants ;
    rdfs:range xsd:string ;
    rdfs:label "Individual" ;
    rdfs:comment "Individual carrying this variant." .

effortless-ntwf:individual_IndividualPredictions a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:string ;
    rdfs:label "Individual" ;
    rdfs:comment "Individual predicted." .

effortless-ntwf:individual_OmicsAssays a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OmicsAssays ;
    rdfs:range xsd:string ;
    rdfs:label "Individual" ;
    rdfs:comment "Individual assayed." .

effortless-ntwf:individual_Treatments a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Treatments ;
    rdfs:range xsd:string ;
    rdfs:label "Individual" ;
    rdfs:comment "Treated individual." .

effortless-ntwf:individuals a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:FederatedDatasets ;
    rdfs:range effortless-ntwf:Individuals ;
    rdfs:label "Individuals" ;
    rdfs:comment "Individuals linked to this federated dataset." .

effortless-ntwf:inferenceKindId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InferenceKinds ;
    rdfs:range xsd:string ;
    rdfs:label "InferenceKindId" ;
    rdfs:comment "Stable identifier." .

effortless-ntwf:intakeClinicianCRUD a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:string ;
    rdfs:label "IntakeClinicianCRUD" ;
    rdfs:comment "IntakeClinician CRUD grant for this route (contains C/R/U/D). Empty = no access." .

effortless-ntwf:intakeClinicianCanCreate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IntakeClinicianCanCreate" ;
    rdfs:comment "Derived: IntakeClinicianCRUD contains 'C'." .

effortless-ntwf:intakeClinicianCanDelete a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IntakeClinicianCanDelete" ;
    rdfs:comment "Derived: IntakeClinicianCRUD contains 'D'." .

effortless-ntwf:intakeClinicianCanRead a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IntakeClinicianCanRead" ;
    rdfs:comment "Derived: IntakeClinicianCRUD contains 'R'." .

effortless-ntwf:intakeClinicianCanUpdate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IntakeClinicianCanUpdate" ;
    rdfs:comment "Derived: IntakeClinicianCRUD contains 'U'." .

effortless-ntwf:interactionLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EpistaticInteractions ;
    rdfs:range xsd:string ;
    rdfs:label "InteractionLabel" ;
    rdfs:comment "Human-readable interaction label." .

effortless-ntwf:interventionApplied a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CounterfactualTrajectories ;
    rdfs:range xsd:string ;
    rdfs:label "InterventionApplied" ;
    rdfs:comment "Hypothetical intervention (empty = no treatment)." .

effortless-ntwf:interventionTargetId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InterventionTargets ;
    rdfs:range xsd:string ;
    rdfs:label "InterventionTargetId" ;
    rdfs:comment "Stable identifier for each intervention target." .

effortless-ntwf:interventionTargets a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:InterventionTargets ;
    rdfs:label "InterventionTargets" .

effortless-ntwf:isAdjustedForAncestryPCs a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvidenceItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAdjustedForAncestryPCs" ;
    rdfs:comment "OBSERVATION: TRUE if the analysis adjusted for ancestry principal components." .

effortless-ntwf:isAdjustedForBatch a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvidenceItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAdjustedForBatch" ;
    rdfs:comment "OBSERVATION: TRUE if the analysis adjusted for batch." .

effortless-ntwf:isAgingWindow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAgingWindow" ;
    rdfs:comment "True when age falls in aging window (60+)." .

effortless-ntwf:isAncestryAbsentFromTraining a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAncestryAbsentFromTraining" ;
    rdfs:comment "True when individual ancestry was absent from primary training data." .

effortless-ntwf:isAncestryHoldout a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAncestryHoldout" ;
    rdfs:comment "True when individual ancestry absent from training." .

effortless-ntwf:isAncestryTransportSafe a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAncestryTransportSafe" ;
    rdfs:comment "Derived: holdout requires measured transport; in-training is vacuously safe." .

effortless-ntwf:isAncestryTransportable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CausalMechanisms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAncestryTransportable" ;
    rdfs:comment "Derived: a confirmed node whose effect replicated in >=1 different ancestry (measured invariance)." .

effortless-ntwf:isCausalArchitectureNode a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CausalMechanisms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCausalArchitectureNode" ;
    rdfs:comment "Derived: a confirmed causal edge - confident, falsifiable, non-spurious, and grounded in a candidate variant or a real exposure." .

effortless-ntwf:isCausalCandidate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GenomicVariants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCausalCandidate" ;
    rdfs:comment "Derived: rare (by frequency or class) AND shows allele-specific expression." .

effortless-ntwf:isCellBasedTherapy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InterventionTargets ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCellBasedTherapy" ;
    rdfs:comment "True when therapy class is cell-based." .

effortless-ntwf:isClinicallyActionable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsClinicallyActionable" ;
    rdfs:comment "KEYSTONE: TRUE only when the prediction is high-confidence (calibrated + not spurious), falsifiability-backed, ancestry-transport-safe, and rests on a non-null derived magnitude." .

effortless-ntwf:isComplexDisease a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AutoimmuneDiseases ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsComplexDisease" ;
    rdfs:comment "True when the disease is a multifactorial complex disease beyond simple monogenic traits." .

effortless-ntwf:isConfoundControlled a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvidenceItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConfoundControlled" ;
    rdfs:comment "Derived: both ancestry-PC and batch adjustment present." .

effortless-ntwf:isCrossAncestryConcordant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CohortReplications ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCrossAncestryConcordant" ;
    rdfs:comment "Derived: replicated at significance AND in a different ancestry (the transportability atom)." .

effortless-ntwf:isCrossModality a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvidenceItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCrossModality" ;
    rdfs:comment "OBSERVATION: TRUE if this signal comes from a different omics modality than the mechanism's primary one." .

effortless-ntwf:isCurrent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubjectStateInstances ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrent" ;
    rdfs:comment "TRUE when ExitedAt IS NULL — the subject's active state." .

effortless-ntwf:isDeeplyModeled a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiseaseDomainConcepts ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDeeplyModeled" ;
    rdfs:comment "TRUE when this concept carries a witnessed inference DAG (status = deep-dag)." .

effortless-ntwf:isDevelopmentWindow a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDevelopmentWindow" ;
    rdfs:comment "True when age falls in developmental effects window (0-25)." .

effortless-ntwf:isDifferentAncestryReplication a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CohortReplications ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDifferentAncestryReplication" ;
    rdfs:comment "Derived: the re-test ran in a different ancestry than discovery." .

effortless-ntwf:isDiseaseProgressing a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDiseaseProgressing" ;
    rdfs:comment "TRUE when the disease-state simulator places the patient in an active/worsening renal state (independent of the actionability gate)." .

effortless-ntwf:isDynamic a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDynamic" ;
    rdfs:comment "True if the route template contains :params." .

effortless-ntwf:isEffectiveTreatment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Treatments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEffectiveTreatment" ;
    rdfs:comment "True for Complete or Partial response without adverse effects." .

effortless-ntwf:isExperimentallyFalsifiable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CausalMechanisms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsExperimentallyFalsifiable" ;
    rdfs:comment "Derived: a measurable qualified effect exists AND a named intervention can perturb it." .

effortless-ntwf:isFalsifiabilityBacked a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsFalsifiabilityBacked" ;
    rdfs:comment "Derived: inherits falsifiability - every confirmed node required IsExperimentallyFalsifiable." .

effortless-ntwf:isForward a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StateTransitions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsForward" ;
    rdfs:comment "TRUE when ToStateKey is not the machine's initial state." .

effortless-ntwf:isForwardEdge a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StateTransitionRules ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsForwardEdge" ;
    rdfs:comment "TRUE when the edge advances to a different state (all edges here)." .

effortless-ntwf:isGeneBasedTherapy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InterventionTargets ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGeneBasedTherapy" ;
    rdfs:comment "True when therapy class is gene-based." .

effortless-ntwf:isHighConfidencePrediction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHighConfidencePrediction" ;
    rdfs:comment "Derived: calibrated AND not spurious." .

effortless-ntwf:isHighDiseaseActivity a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHighDiseaseActivity" ;
    rdfs:comment "TRUE when peak SLEDAI >= 12." .

effortless-ntwf:isHighExposure a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EnvironmentalExposures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHighExposure" ;
    rdfs:comment "True when exposure level exceeds threshold." .

effortless-ntwf:isHighOrderEpistasis a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EpistaticInteractions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHighOrderEpistasis" ;
    rdfs:comment "True when epistasis score exceeds 0.5." .

effortless-ntwf:isHighQualityAssay a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OmicsAssays ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHighQualityAssay" ;
    rdfs:comment "2nd-order quality flag." .

effortless-ntwf:isHighSeverity a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClinicalPhenotypes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsHighSeverity" ;
    rdfs:comment "True when severity exceeds 7." .

effortless-ntwf:isInCurrentPlan a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EffortlessLoops ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInCurrentPlan" ;
    rdfs:comment "TRUE for the current \"next\" loop and anything still planned/backlog (not done)." .

effortless-ntwf:isInPreNephriticSignatureCluster a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInPreNephriticSignatureCluster" ;
    rdfs:comment "DERIVED cluster membership: TRUE when this individual's own raw serology series ever showed the pre-nephritic signature. The discovery 'this serology signature precedes nephritis' becomes a reproducible, witnessed corpus-level cluster — not a label anyone assigned." .

effortless-ntwf:isInitial a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MachineStates ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInitial" ;
    rdfs:comment "TRUE if this is the machine's entry state." .

effortless-ntwf:isLongDwell a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubjectStateInstances ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLongDwell" ;
    rdfs:comment "TRUE when DwellDays >= 90 (a season)." .

effortless-ntwf:isMaternalEffect a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EnvironmentalExposures ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMaternalEffect" ;
    rdfs:comment "True when exposure reflects maternal developmental effects." .

effortless-ntwf:isMechanismMatched a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Treatments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsMechanismMatched" ;
    rdfs:comment "True when the treatment's target mechanism is a CONFIRMED causal-architecture node (empty-guarded). This is the 'mechanism match'." .

effortless-ntwf:isNegativeControlArm a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvidenceItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNegativeControlArm" ;
    rdfs:comment "OBSERVATION: TRUE if this row is a measured control arm rather than support." .

effortless-ntwf:isNephroticRangeProteinuria a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNephroticRangeProteinuria" ;
    rdfs:comment "proteinuria >= 3.0 g/day." .

effortless-ntwf:isPreNephriticSignaturePanel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPreNephriticSignaturePanel" ;
    rdfs:comment "The pre-nephritic serology signature at THIS panel: rising anti-dsDNA + falling complement (the serological trajectory that precedes/tracks overt renal involvement). Emergent from the raw series, not a label anyone assigned. (Proteinuria is the OUTCOME the signature precedes, so it is deliberately NOT part of the signal.)" .

effortless-ntwf:isPresymptomatic a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiseaseStages ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPresymptomatic" ;
    rdfs:comment "True when stage is presymptomatic diagnosis window." .

effortless-ntwf:isPresymptomaticPhenotype a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClinicalPhenotypes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPresymptomaticPhenotype" ;
    rdfs:comment "True when stage is presymptomatic." .

effortless-ntwf:isPrivacyPreserving a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FederatedDatasets ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsPrivacyPreserving" ;
    rdfs:comment "True when node uses privacy-preserving federated learning." .

effortless-ntwf:isQualifiedEvidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvidenceItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsQualifiedEvidence" ;
    rdfs:comment "Derived: clean assay, real support arm, signal-to-noise >= 2, confound-controlled." .

effortless-ntwf:isRareVariant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GenomicVariants ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRareVariant" ;
    rdfs:comment "True when allele frequency below 0.01." .

effortless-ntwf:isRareVariantClass a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:VariantTypes ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsRareVariantClass" ;
    rdfs:comment "True when this type contributes to rare-variant burden scoring." .

effortless-ntwf:isResolved a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OpenQuestions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsResolved" ;
    rdfs:comment "TRUE when decided." .

effortless-ntwf:isSchemaModeled a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiseaseDomainConcepts ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSchemaModeled" ;
    rdfs:comment "TRUE when first-class schema/data (deep-dag or schema)." .

effortless-ntwf:isSeverityActionable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSeverityActionable" ;
    rdfs:comment "Derived: a high-severity phenotype on a confirmed, non-spurious mechanism. Chained to the onset gates so severity can never be actionable on a debunked mechanism." .

effortless-ntwf:isSignificantProteinuria a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSignificantProteinuria" ;
    rdfs:comment "proteinuria >= 0.5 g/day." .

effortless-ntwf:isSingleCell a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OmicsModalities ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSingleCell" ;
    rdfs:comment "True for single-cell or spatial assays resolving cellular states." .

effortless-ntwf:isSpuriousDerived a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CausalMechanisms ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSpuriousDerived" ;
    rdfs:comment "Derived: spurious unless replicated, survives controls, has >=2 modalities, and is not purely pleiotropic." .

effortless-ntwf:isSurvived a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:NegativeControlTests ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSurvived" ;
    rdfs:comment "Derived: signal collapses under the control (within the null band), as a true causal effect should." .

effortless-ntwf:isSyntheticLeaf a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvidenceItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSyntheticLeaf" ;
    rdfs:comment "TRUST BOUNDARY (raw leaf, read by nothing downstream): TRUE marks this row as an LLM-produced synthetic-but-transparent test result rather than a real measured observation. Surfaces in the writeup so legible-reasoning-over-synthetic-evidence is never misread as solved science. The case is invented; this flag says so out loud at the cell level." .

effortless-ntwf:isTerminal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MachineStates ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTerminal" ;
    rdfs:comment "TRUE if this is a terminal/end state." .

effortless-ntwf:isTransportableToAbsentAncestry a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTransportableToAbsentAncestry" ;
    rdfs:comment "Derived: a holdout individual is transportable only with >=1 cross-ancestry-replicated node and no spurious flag." .

effortless-ntwf:isTreatmentResponseActionable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTreatmentResponseActionable" ;
    rdfs:comment "Derived: the individual has a treatment predicted to respond (effective therapy on a confirmed mechanism). The third prediction type — independent of onset/severity." .

effortless-ntwf:isTreatmentResponsePredicted a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Treatments ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsTreatmentResponsePredicted" ;
    rdfs:comment "Derived: the treatment is effective AND targets a confirmed mechanism. A drug aimed at a debunked mechanism, or one that didn't respond / was adverse, is NOT predicted." .

effortless-ntwf:isValidated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InterventionTargets ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsValidated" ;
    rdfs:comment "True when target is validated for clinical trials." .

effortless-ntwf:isWellCalibratedBin a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CalibrationBins ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWellCalibratedBin" ;
    rdfs:comment "Derived: enough held-out coverage AND small reliability gap." .

effortless-ntwf:isWorseningTrajectory a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CounterfactualTrajectories ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsWorseningTrajectory" ;
    rdfs:comment "True when projected severity exceeds 7." .

effortless-ntwf:latestSledaiScore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:decimal ;
    rdfs:label "LatestSledaiScore" ;
    rdfs:comment "Peak SLEDAI activity score across this individual's panels (derived)." .

effortless-ntwf:lifecycleStateKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:string ;
    rdfs:label "LifecycleStateKey" ;
    rdfs:comment "DERIVED current lifecycle state (never entered): the single deciding gate determines whether the case lands on Actionable or NotActionable. Subject-state column of the diagnosis-lifecycle machine." .

effortless-ntwf:lineOrdinal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TherapyOptions ;
    rdfs:range xsd:decimal ;
    rdfs:label "LineOrdinal" ;
    rdfs:comment "Treatment-line ordinal (1=first-line/induction)." .

effortless-ntwf:loopNumber a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EffortlessLoops ;
    rdfs:range xsd:string ;
    rdfs:label "LoopNumber" ;
    rdfs:comment "Display number (0, 0.5, 1...)." .

effortless-ntwf:machineStateId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MachineStates ;
    rdfs:range xsd:string ;
    rdfs:label "MachineStateId" ;
