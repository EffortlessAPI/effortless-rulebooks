    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:string ;
    rdfs:label "NavLevel" ;
    rdfs:comment "Hierarchy level: top / sub / leaf." .

effortless-ntwf:negativeControlTestId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:NegativeControlTests ;
