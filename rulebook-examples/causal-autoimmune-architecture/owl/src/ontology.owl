    rdfs:comment "Stable identifier for each omics modality." .

effortless-ntwf:openQuestionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OpenQuestions ;
    rdfs:range xsd:string ;
    rdfs:label "OpenQuestionId" ;
    rdfs:comment "Stable identifier." .

effortless-ntwf:orderIndex a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MachineStates ;
    rdfs:range xsd:decimal ;
    rdfs:label "OrderIndex" ;
    rdfs:comment "Sort order of this state within the machine." .

effortless-ntwf:parentPath a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ParentPath" .

effortless-ntwf:parentRouteKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:string ;
    rdfs:label "ParentRouteKey" ;
    rdfs:comment "RouteKey of the parent nav node (empty for top-level). Self-referential recursion." .

effortless-ntwf:patientStratificationTier a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:string ;
    rdfs:label "PatientStratificationTier" ;
    rdfs:comment "Derived risk tier from the derived PredictedValue." .

effortless-ntwf:permutationEffectSize a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:NegativeControlTests ;
    rdfs:range xsd:decimal ;
    rdfs:label "PermutationEffectSize" ;
    rdfs:comment "OBSERVATION: (absolute) effect measured under the null/permuted control." .

effortless-ntwf:phenotypeLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClinicalPhenotypes ;
    rdfs:range xsd:string ;
    rdfs:label "PhenotypeLabel" ;
    rdfs:comment "Phenotype name." .

effortless-ntwf:pinToTop a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:boolean ;
    rdfs:label "PinToTop" ;
    rdfs:comment "Pin to the top of its nav level, before SortOrder." .

effortless-ntwf:predictedProbabilityBand a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CalibrationBins ;
    rdfs:range xsd:decimal ;
    rdfs:label "PredictedProbabilityBand" ;
    rdfs:comment "OBSERVATION: predicted-probability midpoint of this bin (0-1)." .

effortless-ntwf:predictedSeverityValue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:decimal ;
    rdfs:label "PredictedSeverityValue" ;
    rdfs:comment "Derived severity prediction grounded in the individual's max clinical SeverityScore." .

effortless-ntwf:predictedValue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:decimal ;
    rdfs:label "PredictedValue" ;
    rdfs:comment "Derived risk magnitude (0-10), a monotone function of validated causal mass only - rides mechanism, not ancestry correlation." .

effortless-ntwf:predictionLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:string ;
    rdfs:label "PredictionLabel" ;
    rdfs:comment "Prediction type label." .

effortless-ntwf:predictionType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:string ;
    rdfs:label "PredictionType" ;
    rdfs:comment "Onset, Severity, TreatmentResponse, or AdverseEffect." .

effortless-ntwf:preferredWhen a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TherapyOptions ;
    rdfs:range xsd:string ;
    rdfs:label "PreferredWhen" ;
    rdfs:comment "Clinical context where preferred." .

effortless-ntwf:primaryTable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:string ;
    rdfs:label "PrimaryTable" ;
    rdfs:comment "Backing table name." .

effortless-ntwf:primaryVariant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EpistaticInteractions ;
    rdfs:range xsd:string ;
    rdfs:label "PrimaryVariant" ;
    rdfs:comment "First variant in interaction." .

effortless-ntwf:primaryView a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:string ;
    rdfs:label "PrimaryView" ;
    rdfs:comment "Backing vw_* view." .

effortless-ntwf:priorAntiDsDnaIU a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:decimal ;
    rdfs:label "PriorAntiDsDnaIU" ;
    rdfs:comment "Prior panel's dsDNA via PriorObservation FK, for trend." .

effortless-ntwf:priorC3 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:decimal ;
    rdfs:label "PriorC3" ;
    rdfs:comment "Prior C3 via PriorObservation FK." .

effortless-ntwf:priorC4 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:decimal ;
    rdfs:label "PriorC4" ;
    rdfs:comment "Prior C4 via PriorObservation FK." .

effortless-ntwf:priorInstance a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:SubjectStateInstances ;
    rdfs:range effortless-ntwf:SubjectStateInstances ;
    rdfs:label "PriorInstance" ;
    rdfs:comment "Self-FK: previous occupancy in this subject's chain. NULL for initial." .

effortless-ntwf:priorObservation a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range effortless-ntwf:SerologyObservations ;
    rdfs:label "PriorObservation" ;
    rdfs:comment "Self-FK -> the prior panel in this individual's series (seq-1). NULL for the first." .

effortless-ntwf:priority a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Features ;
    rdfs:range xsd:string ;
    rdfs:label "Priority" ;
    rdfs:comment "Load-bearing | Supporting | Roadmap." .

# effortless-ntwf:progression holds the edges whose transitive closure the rulebook counts
effortless-ntwf:progression a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "Progression" .

effortless-ntwf:progressionStateKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:string ;
    rdfs:label "ProgressionStateKey" ;
    rdfs:comment "Disease state IMPLIED by THIS panel (derived purely from raw leaves)." .

effortless-ntwf:progressionStateOrder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:decimal ;
    rdfs:label "ProgressionStateOrder" ;
    rdfs:comment "Numeric severity order of THIS panel's implied state (0..5). Lets the individual's current state be a MAXIFS over panels (highest state reached)." .

effortless-ntwf:progressionVsActionabilityDisagree a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:boolean ;
    rdfs:label "ProgressionVsActionabilityDisagree" ;
    rdfs:comment "THE COUNTER-EXAMPLE FLAG: TRUE when disease is progressing (simulator) but the prediction is NOT clinically actionable (gate). Proves the two layers are independent." .

effortless-ntwf:projectedSeverity a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CounterfactualTrajectories ;
    rdfs:range xsd:decimal ;
    rdfs:label "ProjectedSeverity" ;
    rdfs:comment "Projected severity under counterfactual (0-10)." .

effortless-ntwf:proteinuriaGPerDay a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:decimal ;
    rdfs:label "ProteinuriaGPerDay" ;
    rdfs:comment "urine protein g/day (RAW lab)." .

effortless-ntwf:question a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OpenQuestions ;
    rdfs:range xsd:string ;
    rdfs:label "Question" ;
    rdfs:comment "The open question." .

effortless-ntwf:rareVariantBurdenScore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:decimal ;
    rdfs:label "RareVariantBurdenScore" ;
    rdfs:comment "2nd-order score from rare variant count normalized by age." .

effortless-ntwf:rationale a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Axioms ;
    rdfs:range xsd:string ;
    rdfs:label "Rationale" ;
    rdfs:comment "Why this must hold / what it defends against." .

effortless-ntwf:reachableStateCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MachineStates ;
    rdfs:range xsd:integer ;
    rdfs:label "ReachableStateCount" ;
    rdfs:comment "Number of states reachable FROM this state via the transitive closure of the transition edges (rollup over vw_state_transition_rules_closure where from_id = this state). This is a graph-reachability fact the linear severity rank CANNOT reproduce: both Quiescent (the remission sink) and BiopsyIndicated (the terminal progression state) have 0 reachable-ahead, though they sit at opposite ends of the order — the count is non-monotonic in OrderIndex because the machine BRANCHES (remission). The closure is load-bearing here: delete it and this field is uncomputable." .

effortless-ntwf:reachableStatesAhead a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "ReachableStatesAhead" ;
    rdfs:comment "How many disease states are still reachable ahead of THIS patient from their current state, via the transition closure (looks up MachineStates.ReachableStateCount for CurrentProgressionStateId). A closure-derived prognostic horizon: Diego at BiopsyIndicated has 0 ahead (terminal); a Presymptomatic patient has 5. NOT derivable from the severity rank alone (the count is non-monotonic in rank because the machine branches into remission)." .

effortless-ntwf:reason a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StateTransitions ;
    rdfs:range xsd:string ;
    rdfs:label "Reason" ;
    rdfs:comment "Why the transition happened (free text)." .

effortless-ntwf:recommendedTreatmentLine a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:string ;
    rdfs:label "RecommendedTreatmentLine" ;
    rdfs:comment "DERIVED treatment-line recommendation from confirmed-mechanism TargetPathway + disease state. The audit's MMF/belimumab/anifrolumab example." .

effortless-ntwf:refCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Features ;
    rdfs:range xsd:decimal ;
    rdfs:label "RefCount" ;
    rdfs:comment "Number of challenge refs (carried as raw for display; the hbars engine can't count a JSON string)." .

effortless-ntwf:region a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:FederatedDatasets ;
    rdfs:range xsd:string ;
    rdfs:label "Region" ;
    rdfs:comment "Geographic region; shifting environments may alter exposure profiles." .

effortless-ntwf:relatedDisease a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiseaseDomainConcepts ;
    rdfs:range xsd:string ;
    rdfs:label "RelatedDisease" ;
    rdfs:comment "Disease this concept belongs to (SLE/RA/PsA/* for cross-cutting). Convention string, not a FK." .

effortless-ntwf:relatedHarnessFile a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestsForSuccess ;
    rdfs:range xsd:string ;
    rdfs:label "RelatedHarnessFile" ;
    rdfs:comment "Harness file that realizes it, if any." .

effortless-ntwf:relativePath a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RelativePath" .

effortless-ntwf:replicatedAtNominalSig a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CohortReplications ;
    rdfs:range xsd:boolean ;
    rdfs:label "ReplicatedAtNominalSig" ;
    rdfs:comment "Derived: reproduced the predicted (positive) sign at nominal significance." .

effortless-ntwf:replicatesAcrossCohorts a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CausalMechanisms ;
    rdfs:range xsd:boolean ;
    rdfs:label "ReplicatesAcrossCohorts" ;
    rdfs:comment "Derived: >=2 independent re-tests and >=2 concordant." .

effortless-ntwf:replicationAncestryLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CohortReplications ;
    rdfs:range xsd:string ;
    rdfs:label "ReplicationAncestryLabel" ;
    rdfs:comment "OBSERVATION: ancestry of the cohort the re-test ran in." .

effortless-ntwf:replicationEffectSign a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CohortReplications ;
    rdfs:range xsd:integer ;
    rdfs:label "ReplicationEffectSign" ;
    rdfs:comment "OBSERVATION: sign of the re-estimated effect (+1 / -1 / 0)." .

effortless-ntwf:replicationFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CausalMechanisms ;
    rdfs:range xsd:decimal ;
    rdfs:label "ReplicationFraction" ;
    rdfs:comment "Derived: fraction of re-tests that were concordant (guarded division)." .

effortless-ntwf:replicationLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CohortReplications ;
    rdfs:range xsd:string ;
    rdfs:label "ReplicationLabel" ;
    rdfs:comment "Human label." .

effortless-ntwf:replicationPValue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CohortReplications ;
    rdfs:range xsd:decimal ;
    rdfs:label "ReplicationPValue" ;
    rdfs:comment "OBSERVATION: p-value of the re-test." .

effortless-ntwf:representsAssayModality a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvidenceItems ;
    rdfs:range xsd:string ;
    rdfs:label "RepresentsAssayModality" ;
    rdfs:comment "PROVENANCE STUB (raw leaf, read by nothing downstream): which real assay/modality this synthetic leaf stands in for (e.g. 'cis-eQTL, whole-blood RNA-seq'). Documents where real evidence would attach if this case were instrumented." .

effortless-ntwf:resolution a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OpenQuestions ;
    rdfs:range xsd:string ;
    rdfs:label "Resolution" ;
    rdfs:comment "The decision, once made." .

effortless-ntwf:restsOnConfirmedMechanism a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:boolean ;
    rdfs:label "RestsOnConfirmedMechanism" ;
    rdfs:comment "Derived: grounded in >=1 validated mechanism." .

effortless-ntwf:roleVisibility a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:string ;
    rdfs:label "RoleVisibility" ;
    rdfs:comment "CSV of roles that can see this nav item: admin,intake-clinician,diagnosing-doctor,external-llm." .

effortless-ntwf:route a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:string ;
    rdfs:label "Route" ;
    rdfs:comment "URL template, role/workflow-prefixed with :params, e.g. /intake/case/:caseId." .

effortless-ntwf:routeKey a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:string ;
    rdfs:label "RouteKey" ;
    rdfs:comment "Stable dot-delimited slug, e.g. diagnosis.case.mechanism." .

effortless-ntwf:routingAndNavigationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:string ;
    rdfs:label "RoutingAndNavigationId" ;
    rdfs:comment "Slug PK for this nav node, e.g. nav-intake-case." .

effortless-ntwf:ruleCommitMsg a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EffortlessLoops ;
    rdfs:range xsd:string ;
    rdfs:label "RuleCommitMsg" ;
    rdfs:comment "The rule commit message (or \"none — app-only loop\")." .

effortless-ntwf:ruleRefs a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StateTransitionRules ;
    rdfs:range xsd:string ;
    rdfs:label "RuleRefs" ;
    rdfs:comment "CSV of business-rule / gate codes the guard enforces." .

effortless-ntwf:secondaryVariant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EpistaticInteractions ;
    rdfs:range xsd:string ;
    rdfs:label "SecondaryVariant" ;
    rdfs:comment "Second variant in interaction." .

effortless-ntwf:sequenceIndex a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "SequenceIndex" .

effortless-ntwf:serologyObservationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:string ;
    rdfs:label "SerologyObservationId" ;
    rdfs:comment "Slug PK: sero-{ind}-{seq}." .

effortless-ntwf:severityDecidingFactor a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:string ;
    rdfs:label "SeverityDecidingFactor" ;
    rdfs:comment "Why severity is/ isn't actionable — the single deciding reason." .

effortless-ntwf:severityScore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClinicalPhenotypes ;
    rdfs:range xsd:decimal ;
    rdfs:label "SeverityScore" ;
