effortless-ntwf:omicsAssayId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OmicsAssays ;
    rdfs:range xsd:string ;
    rdfs:label "OmicsAssayId" ;
    rdfs:comment "Stable identifier for each omics assay." .

effortless-ntwf:omicsAssays a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:OmicsAssays ;
    rdfs:label "OmicsAssays" .

effortless-ntwf:omicsModality a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OmicsAssays ;
    rdfs:range xsd:string ;
    rdfs:label "OmicsModality" ;
    rdfs:comment "Omics modality used." .

effortless-ntwf:omicsModalityId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OmicsModalities ;
