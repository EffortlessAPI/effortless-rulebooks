effortless-ntwf:individualTargetPathway a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:string ;
    rdfs:label "IndividualTargetPathway" ;
    rdfs:comment "TargetPathway resolved on the individual (decoded from the mechanism)." .

effortless-ntwf:individual_CausalMechanisms a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CausalMechanisms ;
    rdfs:range xsd:string ;
    rdfs:label "Individual" ;
    rdfs:comment "Individual for whom mechanism is inferred." .

effortless-ntwf:individual_ClinicalPhenotypes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClinicalPhenotypes ;
    rdfs:range xsd:string ;
    rdfs:label "Individual" ;
    rdfs:comment "Individual measured." .

effortless-ntwf:individual_CounterfactualTrajectories a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CounterfactualTrajectories ;
    rdfs:range xsd:string ;
    rdfs:label "Individual" ;
    rdfs:comment "Individual whose trajectory is modeled." .

effortless-ntwf:individual_EnvironmentalExposures a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EnvironmentalExposures ;
