@prefix effortless-ntwf: <https://w3id.org/effortless-ntwf#> .
@prefix erb: <https://effortlessapi.com/ns/erb#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/effortless-ntwf> a owl:Ontology ;
    rdfs:label "Causal Autoimmune Architecture Platform" ;
    dcterms:title "Causal Autoimmune Architecture Platform" ;
    dcterms:description "Rulebook for inferring the complete causal architecture of heterogeneous autoimmune disease from multi-omic cohort data, producing falsifiable mechanisms and ancestry-equitable predictions with calibrated uncertainty." ;
    rdfs:comment "Generated by Effortless (rulebook-to-owl) from causal-autoimmune-architecture-platform-rulebook.json. The rulebook is the source: change it there, not here." ;
    rdfs:comment "ERB build parameters: erbBlankLogic=coerce, erbDateDiff=calendar, erbDateTimeText=iso8601, erbTimezone=UTC, erbWholeNumber=by-field-type" .

dcterms:description a owl:AnnotationProperty .
dcterms:title a owl:AnnotationProperty .

# The key of the row an individual was made from, verbatim (its IRI is only a slug of it).
erb:key a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "key" .

# === Class: AutoimmuneDiseases ===
effortless-ntwf:AutoimmuneDiseases a owl:Class ;
    rdfs:label "AutoimmuneDiseases" ;
    rdfs:comment "Target heterogeneous autoimmune disease definitions tracked across development, aging, tissues, and disease stages." .

# === Class: Axioms ===
effortless-ntwf:Axioms a owl:Class ;
    rdfs:label "Axioms" ;
    rdfs:comment "Non-negotiable invariants the platform must obey. Load-bearing constraints, not per-loop work. Captured from the gauntlet conversation." .

# === Class: CalibrationBins ===
effortless-ntwf:CalibrationBins a owl:Class ;
    rdfs:label "CalibrationBins" ;
    rdfs:comment "Per-prediction reliability-curve bins, seeded from the held-out coverage of this individual's own ancestry x disease. Calibration is an aggregation over these rows." .

# === Class: CausalMechanisms ===
effortless-ntwf:CausalMechanisms a owl:Class ;
    rdfs:label "CausalMechanisms" ;
    rdfs:comment "Inferred causal mechanisms linking variants, exposures, and molecular state to clinical phenotypes; must be experimentally falsifiable." .

# === Class: ClinicalPhenotypes ===
effortless-ntwf:ClinicalPhenotypes a owl:Class ;
    rdfs:label "ClinicalPhenotypes" ;
    rdfs:comment "Clinical phenotypes including severity, immune dysfunction markers, and feedback from disease progression." .

# === Class: CohortReplications ===
effortless-ntwf:CohortReplications a owl:Class ;
    rdfs:label "CohortReplications" ;
    rdfs:comment "One re-test of a causal mechanism in another federated cohort. Replication and cross-ancestry transport are aggregations over these rows." .

# === Class: CounterfactualTrajectories ===
effortless-ntwf:CounterfactualTrajectories a owl:Class ;
    rdfs:label "CounterfactualTrajectories" ;
    rdfs:comment "Counterfactual disease trajectories inferred without randomized perturbation data." .

# === Class: DiseaseDomainConcepts ===
effortless-ntwf:DiseaseDomainConcepts a owl:Class ;
    rdfs:label "DiseaseDomainConcepts" ;
    rdfs:comment "v2 vocabulary completeness: every disease-domain concept the v1 audit named, with its modeling status and the challenge-stressor TYPE it instantiates. Makes the coverage claim checkable by grep, not by trust." .

# === Class: DiseaseStages ===
effortless-ntwf:DiseaseStages a owl:Class ;
    rdfs:label "DiseaseStages" ;
    rdfs:comment "Ordered disease stages capturing presymptomatic, active, remission, and treatment-refractory phases along disease progression." .

# === Class: EffortlessLoops ===
effortless-ntwf:EffortlessLoops a owl:Class ;
    rdfs:label "EffortlessLoops" ;
    rdfs:comment "The ordered Effortless loops that build this platform, as data. The derived plan (EFFORTLESS_LOOPS.md, via json-hbars-transform) is generated from these rows; completed ([DONE]) loops are pruned at publish so only current/roadmap work shows in the plan." .

# === Class: EnvironmentalExposures ===
effortless-ntwf:EnvironmentalExposures a owl:Class ;
    rdfs:label "EnvironmentalExposures" ;
    rdfs:comment "Longitudinal environmental exposures contributing to gene-environment-microbiome interactions and shifting environments." .

# === Class: EpistaticInteractions ===
effortless-ntwf:EpistaticInteractions a owl:Class ;
    rdfs:label "EpistaticInteractions" ;
    rdfs:comment "Higher-order epistasis and pleiotropy interactions between genomic variants." .

# === Class: EvidenceItems ===
effortless-ntwf:EvidenceItems a owl:Class ;
    rdfs:label "EvidenceItems" ;
    rdfs:comment "One observed support signal for a causal mechanism, measured by one omics assay. Mechanism confidence is an aggregation over these rows." .

# === Class: Features ===
effortless-ntwf:Features a owl:Class ;
    rdfs:label "Features" ;
    rdfs:comment "Catalog of buildable capabilities the platform has / allows for. Coarser grain than loops. Each row carries challenge provenance (ChallengeRefs: exact quoted text + file/line/col into THE-ORIGINAL-CHALLENGE.md, for UI hover tips), a Category, a Priority, and a free-form Markdown ChallengeNotes comment. Source of truth for the DERIVED PLATFORM_FEATURES.md. AssignedLoop links a feature to the loop that delivers it (nullable until scheduled)." .

# === Class: FederatedDatasets ===
effortless-ntwf:FederatedDatasets a owl:Class ;
    rdfs:label "FederatedDatasets" ;
    rdfs:comment "Privacy-preserving federated datasets contributing cohort partitions without centralizing raw genomes." .

# === Class: GenomicVariants ===
effortless-ntwf:GenomicVariants a owl:Class ;
    rdfs:label "GenomicVariants" ;
    rdfs:comment "Genomic variant calls per individual spanning regulatory, coding, structural, HLA haplotypes, de novo mutations, somatic mosaicism, and mitochondrial variation." .

# === Class: GlossaryTerms ===
effortless-ntwf:GlossaryTerms a owl:Class ;
    rdfs:label "GlossaryTerms" ;
    rdfs:comment "Vocabulary coined in the gauntlet conversation, so the framing is shared and stable across sessions." .

# === Class: IndividualPredictions ===
effortless-ntwf:IndividualPredictions a owl:Class ;
    rdfs:label "IndividualPredictions" ;
    rdfs:comment "Predictions of disease onset, severity, treatment response, and adverse effects with calibrated uncertainty for ancestry-equitable risk prediction." .

# === Class: Individuals ===
effortless-ntwf:Individuals a owl:Class ;
    rdfs:label "Individuals" ;
    rdfs:comment "Ancestrally diverse cohort participants whose phased genomes, omics profiles, exposures, and clinical phenotypes feed causal architecture inference." .

# === Class: InferenceKinds ===
effortless-ntwf:InferenceKinds a owl:Class ;
    rdfs:label "InferenceKinds" ;
    rdfs:comment "Families of derivation the platform performs - the KINDS of inference in the DAG (lookups, aggregations, higher-order gates, state machines, transitive closure, predicate-gated narrative, cross-substrate conformance), independent of any one feature. Lets PLATFORM_FEATURES.md open with a short overview of the reasoning machinery before the per-feature catalog. Grounded in field types that actually exist in this rulebook; Maturity is Live unless an upstream step is still in flight." .

# === Class: InterventionTargets ===
effortless-ntwf:InterventionTargets a owl:Class ;
    rdfs:label "InterventionTargets" ;
    rdfs:comment "Validated intervention targets for gene-based and cell-based therapies derived from falsifiable causal mechanisms." .

# === Class: MachineStates ===
effortless-ntwf:MachineStates a owl:Class ;
    rdfs:label "MachineStates" ;
    rdfs:comment "Legal states of each machine." .

# === Class: NegativeControlTests ===
effortless-ntwf:NegativeControlTests a owl:Class ;
    rdfs:label "NegativeControlTests" ;
    rdfs:comment "One stratification / permutation control on a causal mechanism. A true causal signal collapses under the control." .

# === Class: NonGoals ===
effortless-ntwf:NonGoals a owl:Class ;
    rdfs:label "NonGoals" ;
    rdfs:comment "Explicit out-of-scope statements — the positive twin of the anti-hallucination ledger. Stops scope creep." .

# === Class: OmicsAssays ===
effortless-ntwf:OmicsAssays a owl:Class ;
    rdfs:label "OmicsAssays" ;
    rdfs:comment "Omics assay instances linking individuals to modalities and tissues; captures batch effects, measurement error, and missing tissues." .

# === Class: OmicsModalities ===
effortless-ntwf:OmicsModalities a owl:Class ;
    rdfs:label "OmicsModalities" ;
    rdfs:comment "Registry of omics assay modalities: RNA-seq, ATAC-seq, proteomics, metabolomics, methylomes, chromatin-conformation, immune-receptor repertoires, microbiomes, and long-read genomes." .

# === Class: OpenQuestions ===
effortless-ntwf:OpenQuestions a owl:Class ;
    rdfs:label "OpenQuestions" ;
    rdfs:comment "Decisions still pending, captured so they are not silently re-litigated in a later session." .

# === Class: RoutingAndNavigation ===
effortless-ntwf:RoutingAndNavigation a owl:Class ;
    rdfs:label "RoutingAndNavigation" ;
    rdfs:comment "Role-based navigation: open-ended parent->child->leaf routes with computed paths. Each route has a template (/intake/case/:caseId); entities carry RelativePath that substitutes their own id/slug. Roles: admin, intake-clinician, diagnosing-doctor, external-llm." .

# === Class: SerologyObservations ===
effortless-ntwf:SerologyObservations a owl:Class ;
    rdfs:label "SerologyObservations" ;
    rdfs:comment "RAW longitudinal serology panels (the lab/LLM layer) + derived trend, SLEDAI sub-scores, and the disease state IMPLIED by each panel. The leaves that drive the lupus-nephritis progression machine." .

# === Class: StateMachines ===
effortless-ntwf:StateMachines a owl:Class ;
    rdfs:label "StateMachines" ;
    rdfs:comment "State-machine definitions." .

# === Class: StateTransitionRules ===
effortless-ntwf:StateTransitionRules a owl:Class ;
    rdfs:label "StateTransitionRules" ;
    rdfs:comment "Legal edges (guards) of each machine." .

# === Class: StateTransitions ===
effortless-ntwf:StateTransitions a owl:Class ;
    rdfs:label "StateTransitions" ;
    rdfs:comment "Instance-level transition log (the witnessed history)." .

# === Class: SubjectStateInstances ===
effortless-ntwf:SubjectStateInstances a owl:Class ;
    rdfs:label "SubjectStateInstances" ;
    rdfs:comment "Per-subject state occupancy records; current state has blank ExitedAt." .

# === Class: TestsForSuccess ===
effortless-ntwf:TestsForSuccess a owl:Class ;
    rdfs:label "TestsForSuccess" ;
    rdfs:comment "Falsifiable conditions that prove the axioms hold. The human-readable index of what each demonstration shows; many are realized in the witnessed harness." .

# === Class: TherapyOptions ===
effortless-ntwf:TherapyOptions a owl:Class ;
    rdfs:label "TherapyOptions" ;
    rdfs:comment "Therapy lookup for the treatment-line-selection DAG (MMF/belimumab/anifrolumab/secukinumab)." .

# === Class: Tissues ===
effortless-ntwf:Tissues a owl:Class ;
    rdfs:label "Tissues" ;
    rdfs:comment "Anatomical tissues where omics assays resolve cell-state-specific effects; includes cases of missing tissues." .

# === Class: Treatments ===
effortless-ntwf:Treatments a owl:Class ;
    rdfs:label "Treatments" ;
    rdfs:comment "Treatment histories capturing treatment-induced changes, treatment response, and adverse effects." .

# === Class: VariantTypes ===
effortless-ntwf:VariantTypes a owl:Class ;
    rdfs:label "VariantTypes" ;
    rdfs:comment "Classification of genomic variant mechanisms: regulatory, coding, repeat expansions, mobile-element insertions, HLA haplotypes, structural variants, de novo mutations, somatic mosaicism, mitochondrial variation." .

effortless-ntwf:activityTier a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:string ;
    rdfs:label "ActivityTier" ;
    rdfs:comment "Derived disease-activity tier from peak SLEDAI score." .

effortless-ntwf:adminCRUD a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:string ;
    rdfs:label "AdminCRUD" ;
    rdfs:comment "Admin CRUD grant for this route (contains C/R/U/D). Empty = no access." .

effortless-ntwf:adminCanCreate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:boolean ;
    rdfs:label "AdminCanCreate" ;
    rdfs:comment "Derived: AdminCRUD contains 'C'." .

effortless-ntwf:adminCanDelete a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:boolean ;
    rdfs:label "AdminCanDelete" ;
    rdfs:comment "Derived: AdminCRUD contains 'D'." .

effortless-ntwf:adminCanRead a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:boolean ;
    rdfs:label "AdminCanRead" ;
    rdfs:comment "Derived: AdminCRUD contains 'R'." .

effortless-ntwf:adminCanUpdate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:RoutingAndNavigation ;
    rdfs:range xsd:boolean ;
    rdfs:label "AdminCanUpdate" ;
    rdfs:comment "Derived: AdminCRUD contains 'U'." .

effortless-ntwf:ageYears a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "AgeYears" ;
    rdfs:comment "Age in years spanning development and aging windows." .

effortless-ntwf:alleleFrequency a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:GenomicVariants ;
    rdfs:range xsd:decimal ;
    rdfs:label "AlleleFrequency" ;
    rdfs:comment "Population allele frequency for rare-variant burden." .

effortless-ntwf:ancestryLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:string ;
    rdfs:label "AncestryLabel" ;
    rdfs:comment "Ancestry label for population stratification and ancestry-equitable risk prediction." .

effortless-ntwf:antiDsDnaIU a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:decimal ;
    rdfs:label "AntiDsDnaIU" ;
    rdfs:comment "anti-dsDNA titre IU/mL (RAW lab)." .

effortless-ntwf:antiDsDnaTrend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:string ;
    rdfs:label "AntiDsDnaTrend" ;
    rdfs:comment "Rising/Falling/Stable vs prior panel (derived from raw)." .

effortless-ntwf:assayIsHighQuality a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EvidenceItems ;
    rdfs:range xsd:boolean ;
    rdfs:label "AssayIsHighQuality" ;
    rdfs:comment "Whether the supporting assay passed quality control." .

effortless-ntwf:assayLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OmicsAssays ;
    rdfs:range xsd:string ;
    rdfs:label "AssayLabel" ;
    rdfs:comment "Human-readable assay label." .

effortless-ntwf:assignedLoop a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Features ;
    rdfs:range xsd:string ;
    rdfs:label "AssignedLoop" ;
    rdfs:comment "FK -> EffortlessLoops.EffortlessLoopId; empty if unscheduled." .

effortless-ntwf:autoimmuneDisease a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AutoimmuneDisease" .

effortless-ntwf:autoimmuneDiseaseDiseaseLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiseaseStages ;
    rdfs:range xsd:string ;
    rdfs:label "AutoimmuneDiseaseDiseaseLabel" ;
    rdfs:comment "Lookup of parent disease label." .

effortless-ntwf:autoimmuneDiseaseId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AutoimmuneDiseases ;
    rdfs:range xsd:string ;
    rdfs:label "AutoimmuneDiseaseId" ;
    rdfs:comment "Stable identifier for each autoimmune disease (e.g. sle, ra, t1d)." .

effortless-ntwf:autoimmuneDiseaseLabel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "AutoimmuneDiseaseLabel" .

effortless-ntwf:axiomId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Axioms ;
    rdfs:range xsd:string ;
    rdfs:label "AxiomId" ;
    rdfs:comment "Stable identifier for the axiom." .

effortless-ntwf:batchId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OmicsAssays ;
    rdfs:range xsd:string ;
    rdfs:label "BatchId" ;
    rdfs:comment "Sequencing batch for batch effects control." .

effortless-ntwf:binAbsError a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CalibrationBins ;
    rdfs:range xsd:decimal ;
    rdfs:label "BinAbsError" ;
    rdfs:comment "Derived: absolute gap between predicted band and observed rate." .

effortless-ntwf:binLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CalibrationBins ;
    rdfs:range xsd:string ;
    rdfs:label "BinLabel" ;
    rdfs:comment "Human label." .

effortless-ntwf:calibratedUncertainty a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:decimal ;
    rdfs:label "CalibratedUncertainty" ;
    rdfs:comment "Derived reliability (HIGH = trustworthy): (1 - mean gap) scaled by well-covered-bin fraction; 0 for uncovered predictions." .

effortless-ntwf:calibrationBinId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CalibrationBins ;
    rdfs:range xsd:string ;
    rdfs:label "CalibrationBinId" ;
    rdfs:comment "Stable id for this bin." .

effortless-ntwf:calibrationBins a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range effortless-ntwf:CalibrationBins ;
    rdfs:label "CalibrationBins" ;
    rdfs:comment "Reliability bins for this prediction." .

effortless-ntwf:caseNarrative a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:string ;
    rdfs:label "CaseNarrative" ;
    rdfs:comment "PANEL 1 of the witness (raw leaf, read by nothing downstream): the natural-language intake case the LLM was handed. Every raw observation below is extracted from THIS text; each leaf's SourceQuote points back into it so the extraction is human-checkable independently of the verdict. Synthetic but transparent — invented case, literature-aligned loci/thresholds." .

effortless-ntwf:category a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Category" .

effortless-ntwf:causalArchitectureScore a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:decimal ;
    rdfs:label "CausalArchitectureScore" ;
    rdfs:comment "3rd-order composite of causal mechanisms and epistasis density." .

effortless-ntwf:causalConfidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CausalMechanisms ;
    rdfs:range xsd:decimal ;
    rdfs:label "CausalConfidence" ;
    rdfs:comment "Derived bounded blend of qualified-evidence count, modality breadth, replication rate, and control survival." .

effortless-ntwf:causalMechanism a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CausalMechanism" .

effortless-ntwf:causalMechanismId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CausalMechanisms ;
    rdfs:range xsd:string ;
    rdfs:label "CausalMechanismId" ;
    rdfs:comment "Stable identifier for each causal mechanism hypothesis." .

effortless-ntwf:causalMechanismLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InterventionTargets ;
    rdfs:range xsd:string ;
    rdfs:label "CausalMechanismLabel" ;
    rdfs:comment "Mechanism label lookup." .

effortless-ntwf:causalMechanisms a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range effortless-ntwf:CausalMechanisms ;
    rdfs:label "CausalMechanisms" ;
    rdfs:comment "Inferred causal mechanisms." .

effortless-ntwf:challengeNotes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Features ;
    rdfs:range xsd:string ;
    rdfs:label "ChallengeNotes" ;
    rdfs:comment "Free-form Markdown comment: which challenge elements this relates to (directly or indirectly) and how it is load-bearing or illustrative." .

effortless-ntwf:challengeRefs a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Features ;
    rdfs:range xsd:string ;
    rdfs:label "ChallengeRefs" ;
    rdfs:comment "JSON array of provenance pointers into THE-ORIGINAL-CHALLENGE.md. Each: {file,line,col,len,quote,section,relation}. col is the 0-based char offset within the line; len is the quote length; section is prompt|payoff|audit|response; relation is direct|indirect. Drives UI hover tips that highlight the exact span." .

effortless-ntwf:challengeRefsRendered a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Features ;
    rdfs:range xsd:string ;
    rdfs:label "ChallengeRefsRendered" ;
    rdfs:comment "Pre-flattened Markdown bullet list of ChallengeRefs, so the dumb hbars template can print it verbatim (the engine has no loop-over-JSON helper)." .

effortless-ntwf:challengeStressorType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiseaseDomainConcepts ;
    rdfs:range xsd:string ;
    rdfs:label "ChallengeStressorType" ;
    rdfs:comment "Which TYPE of original-challenge stressor this concept instantiates (for the reconcile map)." .

effortless-ntwf:claim a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TestsForSuccess ;
    rdfs:range xsd:string ;
    rdfs:label "Claim" ;
    rdfs:comment "The success condition, stated falsifiably." .

effortless-ntwf:clinicalPhenotypeId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ClinicalPhenotypes ;
    rdfs:range xsd:string ;
    rdfs:label "ClinicalPhenotypeId" ;
    rdfs:comment "Stable identifier for each phenotype measurement." .

effortless-ntwf:clinicalPhenotypes a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ClinicalPhenotypes ;
    rdfs:label "ClinicalPhenotypes" .

effortless-ntwf:cohortReplicationId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CohortReplications ;
    rdfs:range xsd:string ;
    rdfs:label "CohortReplicationId" ;
    rdfs:comment "Stable id for this replication attempt." .

effortless-ntwf:cohortReplications a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:CohortReplications ;
    rdfs:label "CohortReplications" .

effortless-ntwf:complementC3 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:decimal ;
    rdfs:label "ComplementC3" ;
    rdfs:comment "C3 mg/dL (RAW lab)." .

effortless-ntwf:complementC4 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:decimal ;
    rdfs:label "ComplementC4" ;
    rdfs:comment "C4 mg/dL (RAW lab)." .

effortless-ntwf:complementTrend a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SerologyObservations ;
    rdfs:range xsd:string ;
    rdfs:label "ComplementTrend" ;
    rdfs:comment "Rising/Falling/Stable on C3+C4 vs prior (derived)." .

effortless-ntwf:completedness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:EffortlessLoops ;
    rdfs:range xsd:string ;
    rdfs:label "Completedness" ;
    rdfs:comment "Normalized status used by the derived plan to decide placement." .

effortless-ntwf:conceptLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiseaseDomainConcepts ;
    rdfs:range xsd:string ;
    rdfs:label "ConceptLabel" ;
    rdfs:comment "Human-readable concept name (the audit's missing word)." .

effortless-ntwf:context a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:OpenQuestions ;
    rdfs:range xsd:string ;
    rdfs:label "Context" ;
    rdfs:comment "Why it is open / what it affects." .

effortless-ntwf:controlLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:NegativeControlTests ;
    rdfs:range xsd:string ;
    rdfs:label "ControlLabel" ;
    rdfs:comment "Human label." .

effortless-ntwf:countBins a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IndividualPredictions ;
    rdfs:range xsd:integer ;
    rdfs:label "CountBins" ;
    rdfs:comment "Total reliability bins for this prediction." .

effortless-ntwf:countConcordantReplications a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CausalMechanisms ;
    rdfs:range xsd:integer ;
    rdfs:label "CountConcordantReplications" ;
    rdfs:comment "Re-tests reproducing the predicted sign at significance." .

effortless-ntwf:countConfirmedCausalNodes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "CountConfirmedCausalNodes" ;
    rdfs:comment "Count of this individual's confirmed causal-architecture nodes." .

effortless-ntwf:countCrossAncestryConcordant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CausalMechanisms ;
    rdfs:range xsd:integer ;
    rdfs:label "CountCrossAncestryConcordant" ;
    rdfs:comment "Concordant re-tests that ran in a DIFFERENT ancestry (the transportability measurement)." .

effortless-ntwf:countCrossAncestryConfirmedNodes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "CountCrossAncestryConfirmedNodes" ;
    rdfs:comment "Confirmed nodes that also showed cross-ancestry replication." .

effortless-ntwf:countHighSeverityPhenotypes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Individuals ;
    rdfs:range xsd:integer ;
