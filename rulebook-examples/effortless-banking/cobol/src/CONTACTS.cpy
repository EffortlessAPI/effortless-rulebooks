       *> CONTACTS - record layout of Contacts (generated by rulebook-to-cobol).
       *> Use: COPY CONTACTS REPLACING ==:P:== BY ==<prefix>== under a level
       *> 01-10 group. Record length: 667 bytes.
       *> A NULL field has <name>-NI = "Y"; text is <name>-LEN bytes of <name>;
       *> booleans are "Y"/"N"; numbers are packed decimal.
       *> Name (calculated, string)
           15 :P:-NAME-NI PIC X.
           15 :P:-NAME-LEN PIC S9(4) COMP.
           15 :P:-NAME PIC X(194).
       *> Business (relationship, string)
           15 :P:-BUSINESS-LEN PIC S9(4) COMP.
           15 :P:-BUSINESS PIC X(64).
       *> FullName (raw, string)
           15 :P:-FULL-NAME-LEN PIC S9(4) COMP.
           15 :P:-FULL-NAME PIC X(64).
       *> Title (raw, string)
           15 :P:-TITLE-LEN PIC S9(4) COMP.
           15 :P:-TITLE PIC X(64).
       *> Email (raw, string)
           15 :P:-EMAIL-NI PIC X.
           15 :P:-EMAIL-LEN PIC S9(4) COMP.
           15 :P:-EMAIL PIC X(64).
       *> Phone (raw, string)
           15 :P:-PHONE-NI PIC X.
           15 :P:-PHONE-LEN PIC S9(4) COMP.
           15 :P:-PHONE PIC X(64).
       *> ContactType (raw, string)
           15 :P:-CONTACT-TYPE-LEN PIC S9(4) COMP.
           15 :P:-CONTACT-TYPE PIC X(64).
       *> IsAuthorizedSigner (raw, bool)
           15 :P:-IS-AUTHORIZED-SIGNER PIC X.
       *> BusinessLabel (lookup, string)
           15 :P:-BUSINESS-LABEL-NI PIC X.
           15 :P:-BUSINESS-LABEL-LEN PIC S9(4) COMP.
           15 :P:-BUSINESS-LABEL PIC X(64).
       *> IsOfficer (calculated, bool)
           15 :P:-IS-OFFICER-NI PIC X.
           15 :P:-IS-OFFICER PIC X.
       *> IsApClerk (calculated, bool)
           15 :P:-IS-AP-CLERK-NI PIC X.
           15 :P:-IS-AP-CLERK PIC X.
