       *> LOANS - record layout of Loans (generated by rulebook-to-cobol).
       *> Use: COPY LOANS REPLACING ==:P:== BY ==<prefix>== under a level
       *> 01-10 group. Record length: 979 bytes.
       *> A NULL field has <name>-NI = "Y"; text is <name>-LEN bytes of <name>;
       *> booleans are "Y"/"N"; numbers are packed decimal.
       *> Name (calculated, string)
           15 :P:-NAME-NI PIC X.
           15 :P:-NAME-LEN PIC S9(4) COMP.
           15 :P:-NAME PIC X(64).
       *> LoanNumber (raw, string)
           15 :P:-LOAN-NUMBER-LEN PIC S9(4) COMP.
           15 :P:-LOAN-NUMBER PIC X(64).
       *> Business (relationship, string)
           15 :P:-BUSINESS-LEN PIC S9(4) COMP.
           15 :P:-BUSINESS PIC X(64).
       *> OriginatingRm (relationship, string)
           15 :P:-ORIGINATING-RM-LEN PIC S9(4) COMP.
           15 :P:-ORIGINATING-RM PIC X(64).
       *> Underwriter (relationship, string)
           15 :P:-UNDERWRITER-LEN PIC S9(4) COMP.
           15 :P:-UNDERWRITER PIC X(64).
       *> LoanPurpose (raw, string)
           15 :P:-LOAN-PURPOSE-LEN PIC S9(4) COMP.
           15 :P:-LOAN-PURPOSE PIC X(64).
       *> PrincipalUsd (raw, float)
           15 :P:-PRINCIPAL-USD PIC S9(11)V9(2) COMP-3.
       *> RatePct (raw, float)
           15 :P:-RATE-PCT PIC S9(9)V9(2) COMP-3.
       *> TermMonths (raw, int)
           15 :P:-TERM-MONTHS PIC S9(9) COMP-3.
       *> UnderwritingStage (raw, string)
           15 :P:-UNDERWRITING-STAGE-LEN PIC S9(4) COMP.
           15 :P:-UNDERWRITING-STAGE PIC X(64).
       *> RiskRating (raw, int)
           15 :P:-RISK-RATING PIC S9(9) COMP-3.
       *> RiskRatingLabel (raw, string)
           15 :P:-RISK-RATING-LABEL-LEN PIC S9(4) COMP.
           15 :P:-RISK-RATING-LABEL PIC X(64).
       *> Dscr (raw, float)
           15 :P:-DSCR-NI PIC X.
           15 :P:-DSCR PIC S9(9)V9(2) COMP-3.
       *> Ltv (raw, float)
           15 :P:-LTV-NI PIC X.
           15 :P:-LTV PIC S9(9)V9(2) COMP-3.
       *> GlobalCashFlowUsd (raw, float)
           15 :P:-GLOBAL-CASH-FLOW-USD-NI PIC X.
           15 :P:-GLOBAL-CASH-FLOW-USD PIC S9(11)V9(2) COMP-3.
       *> OriginatedAt (raw, string)
           15 :P:-ORIGINATED-AT-LEN PIC S9(4) COMP.
           15 :P:-ORIGINATED-AT PIC X(64).
       *> FundedAt (raw, string)
           15 :P:-FUNDED-AT-NI PIC X.
           15 :P:-FUNDED-AT-LEN PIC S9(4) COMP.
           15 :P:-FUNDED-AT PIC X(64).
       *> BusinessLabel (lookup, string)
           15 :P:-BUSINESS-LABEL-NI PIC X.
           15 :P:-BUSINESS-LABEL-LEN PIC S9(4) COMP.
           15 :P:-BUSINESS-LABEL PIC X(64).
       *> BusinessNaicsCode (lookup, string)
           15 :P:-BUSINESS-NAICS-CODE-NI PIC X.
           15 :P:-BUSINESS-NAICS-CODE-LEN PIC S9(4) COMP.
           15 :P:-BUSINESS-NAICS-CODE PIC X(64).
       *> OriginatingRmLabel (lookup, string)
           15 :P:-ORIGINATING-RM-LABEL-NI PIC X.
           15 :P:-ORIGINATING-RM-LABEL-LEN PIC S9(4) COMP.
           15 :P:-ORIGINATING-RM-LABEL PIC X(64).
       *> UnderwriterIsAdmin (lookup, bool)
           15 :P:-UNDERWRITER-IS-ADMIN-NI PIC X.
           15 :P:-UNDERWRITER-IS-ADMIN PIC X.
       *> IsFunded (calculated, bool)
           15 :P:-IS-FUNDED-NI PIC X.
           15 :P:-IS-FUNDED PIC X.
       *> IsClassifiedAsset (calculated, bool)
           15 :P:-IS-CLASSIFIED-ASSET-NI PIC X.
           15 :P:-IS-CLASSIFIED-ASSET PIC X.
       *> DscrInBand (calculated, bool)
           15 :P:-DSCR-IN-BAND-NI PIC X.
           15 :P:-DSCR-IN-BAND PIC X.
       *> LtvInBand (calculated, bool)
           15 :P:-LTV-IN-BAND-NI PIC X.
           15 :P:-LTV-IN-BAND PIC X.
       *> SegregationOfDutiesOk (calculated, bool)
           15 :P:-SEGREGATION-OF-DUTIES-NI PIC X.
           15 :P:-SEGREGATION-OF-DUTIES PIC X.
       *> CountOfCovenants (aggregation, int)
           15 :P:-COUNT-OF-COVENANTS-NI PIC X.
           15 :P:-COUNT-OF-COVENANTS PIC S9(18) COMP-3.
       *> CountOfBreachedCovenants (aggregation, int)
           15 :P:-COUNT-OF-BREACHED-COVE-NI PIC X.
           15 :P:-COUNT-OF-BREACHED-COVE PIC S9(18) COMP-3.
       *> CountOfRiskRatingHistory (aggregation, int)
           15 :P:-COUNT-OF-RISK-RATING-H-NI PIC X.
           15 :P:-COUNT-OF-RISK-RATING-H PIC S9(18) COMP-3.
       *> CountOfDocuments (aggregation, int)
           15 :P:-COUNT-OF-DOCUMENTS-NI PIC X.
           15 :P:-COUNT-OF-DOCUMENTS PIC S9(18) COMP-3.
       *> HasBreachedCovenant (calculated, bool)
           15 :P:-HAS-BREACHED-COVENANT-NI PIC X.
           15 :P:-HAS-BREACHED-COVENANT PIC X.
       *> OnWatchlist (calculated, bool)
           15 :P:-ON-WATCHLIST-NI PIC X.
           15 :P:-ON-WATCHLIST PIC X.
       *> HealthScore (calculated, int)
           15 :P:-HEALTH-SCORE-NI PIC X.
           15 :P:-HEALTH-SCORE PIC S9(18) COMP-3.
