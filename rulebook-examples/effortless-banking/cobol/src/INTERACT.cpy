       *> INTERACT - record layout of Interactions (generated by rulebook-to-cobol).
       *> Use: COPY INTERACT REPLACING ==:P:== BY ==<prefix>== under a level
       *> 01-10 group. Record length: 1064 bytes.
       *> A NULL field has <name>-NI = "Y"; text is <name>-LEN bytes of <name>;
       *> booleans are "Y"/"N"; numbers are packed decimal.
       *> Name (calculated, string)
           15 :P:-NAME-NI PIC X.
           15 :P:-NAME-LEN PIC S9(4) COMP.
           15 :P:-NAME PIC X(259).
       *> Business (relationship, string)
           15 :P:-BUSINESS-LEN PIC S9(4) COMP.
           15 :P:-BUSINESS PIC X(64).
       *> User (relationship, string)
           15 :P:-USER-NI PIC X.
           15 :P:-USER-LEN PIC S9(4) COMP.
           15 :P:-USER PIC X(64).
       *> InteractionType (raw, string)
           15 :P:-INTERACTION-TYPE-LEN PIC S9(4) COMP.
           15 :P:-INTERACTION-TYPE PIC X(64).
       *> Subject (raw, string)
           15 :P:-SUBJECT-LEN PIC S9(4) COMP.
           15 :P:-SUBJECT PIC X(64).
       *> Body (raw, string)
           15 :P:-BODY-NI PIC X.
           15 :P:-BODY-LEN PIC S9(4) COMP.
           15 :P:-BODY PIC X(192).
       *> InteractionDate (raw, string)
           15 :P:-INTERACTION-DATE-LEN PIC S9(4) COMP.
           15 :P:-INTERACTION-DATE PIC X(64).
       *> DueDate (raw, string)
           15 :P:-DUE-DATE-NI PIC X.
           15 :P:-DUE-DATE-LEN PIC S9(4) COMP.
           15 :P:-DUE-DATE PIC X(64).
       *> Source (raw, string)
           15 :P:-SOURCE-NI PIC X.
           15 :P:-SOURCE-LEN PIC S9(4) COMP.
           15 :P:-SOURCE PIC X(64).
       *> BusinessLabel (lookup, string)
           15 :P:-BUSINESS-LABEL-NI PIC X.
           15 :P:-BUSINESS-LABEL-LEN PIC S9(4) COMP.
           15 :P:-BUSINESS-LABEL PIC X(64).
       *> UserLabel (lookup, string)
           15 :P:-USER-LABEL-NI PIC X.
           15 :P:-USER-LABEL-LEN PIC S9(4) COMP.
           15 :P:-USER-LABEL PIC X(64).
       *> IsSystemEvent (calculated, bool)
           15 :P:-IS-SYSTEM-EVENT-NI PIC X.
           15 :P:-IS-SYSTEM-EVENT PIC X.
       *> IsTask (calculated, bool)
           15 :P:-IS-TASK-NI PIC X.
           15 :P:-IS-TASK PIC X.
       *> FromCustomer (calculated, bool)
           15 :P:-FROM-CUSTOMER-NI PIC X.
           15 :P:-FROM-CUSTOMER PIC X.
       *> IsCovenantEvent (calculated, bool)
           15 :P:-IS-COVENANT-EVENT-NI PIC X.
           15 :P:-IS-COVENANT-EVENT PIC X.
