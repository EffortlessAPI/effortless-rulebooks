       PROCEDURE DIVISION.
       MAIN-PARA.
           MOVE 0 TO WS-DD-ELAPSED
           PERFORM LOAD-ALL
           PERFORM BLANK-ROWS
           MOVE 84 TO WS-MAX-PASSES
           MOVE 0 TO WS-PASS
           MOVE 0 TO WS-SETTLED
           PERFORM UNTIL WS-SETTLED = 1
               ADD 1 TO WS-PASS
               IF WS-PASS > WS-MAX-PASSES
                   MOVE "the dataset did not settle: the field dependencies are cyclic" TO WS-ERR-MSG
                   PERFORM RT-FATAL
               END-IF
               MOVE 0 TO WS-CHANGED
               PERFORM PASS-ALL
               IF WS-CHANGED = 0
                   MOVE 1 TO WS-SETTLED
               END-IF
           END-PERFORM
           MOVE 1 TO WS-REPORT
           PERFORM PASS-ALL
           MOVE 0 TO WS-REPORT
           PERFORM EMIT-ALL
           DISPLAY "COBOL substrate: settled after " WS-PASS " passes; " WS-ERR-COUNT " field error(s)" UPON SYSERR
           MOVE 0 TO RETURN-CODE
           STOP RUN
       .
       PASS-ALL.
           PERFORM AG01-009
           PERFORM AG01-010
           PERFORM AG01-011
           PERFORM VARYING R01 FROM 2 BY 1 UNTIL R01 > N01 + 1
               PERFORM CALC-01
           END-PERFORM
           PERFORM LK02-011
           PERFORM AG02-015
           PERFORM AG02-016
           PERFORM AG02-017
           PERFORM AG02-018
           PERFORM AG02-019
           PERFORM AG02-020
           PERFORM AG02-021
           PERFORM AG02-022
           PERFORM AG02-023
           PERFORM AG02-025
           PERFORM VARYING R02 FROM 2 BY 1 UNTIL R02 > N02 + 1
               PERFORM CALC-02
           END-PERFORM
           PERFORM LK03-009
           PERFORM VARYING R03 FROM 2 BY 1 UNTIL R03 > N03 + 1
               PERFORM CALC-03
           END-PERFORM
           PERFORM LK04-009
           PERFORM VARYING R04 FROM 2 BY 1 UNTIL R04 > N04 + 1
               PERFORM CALC-04
           END-PERFORM
           PERFORM LK05-010
           PERFORM VARYING R05 FROM 2 BY 1 UNTIL R05 > N05 + 1
               PERFORM CALC-05
           END-PERFORM
           PERFORM LK06-018
           PERFORM LK06-019
           PERFORM LK06-020
           PERFORM LK06-021
           PERFORM AG06-027
           PERFORM AG06-028
           PERFORM AG06-029
           PERFORM AG06-030
           PERFORM VARYING R06 FROM 2 BY 1 UNTIL R06 > N06 + 1
               PERFORM CALC-06
           END-PERFORM
           PERFORM LK07-009
           PERFORM LK07-010
           PERFORM VARYING R07 FROM 2 BY 1 UNTIL R07 > N07 + 1
               PERFORM CALC-07
           END-PERFORM
           PERFORM LK08-008
           PERFORM LK08-009
           PERFORM VARYING R08 FROM 2 BY 1 UNTIL R08 > N08 + 1
               PERFORM CALC-08
           END-PERFORM
           PERFORM LK09-010
           PERFORM LK09-011
           PERFORM LK09-012
           PERFORM VARYING R09 FROM 2 BY 1 UNTIL R09 > N09 + 1
               PERFORM CALC-09
           END-PERFORM
           PERFORM LK10-010
           PERFORM LK10-011
           PERFORM VARYING R10 FROM 2 BY 1 UNTIL R10 > N10 + 1
               PERFORM CALC-10
           END-PERFORM
           PERFORM VARYING R11 FROM 2 BY 1 UNTIL R11 > N11 + 1
               PERFORM CALC-11
           END-PERFORM
           PERFORM VARYING R12 FROM 2 BY 1 UNTIL R12 > N12 + 1
               PERFORM CALC-12
           END-PERFORM
           CONTINUE
       .
       LOAD-ALL.
           OPEN INPUT IN-FILE
           MOVE 1 TO WS-REPORT
           MOVE 0 TO WS-EOF
           PERFORM UNTIL WS-EOF = 1
               READ IN-FILE
               AT END
               MOVE 1 TO WS-EOF
               NOT AT END
               PERFORM LOAD-LINE
           END-READ
           END-PERFORM
           CLOSE IN-FILE
           MOVE 0 TO WS-REPORT
       .
       LOAD-LINE.
           MOVE IN-LEN TO WS-LINE-L
           IF IN-LEN > 0
               MOVE IN-REC(1:IN-LEN) TO WS-LINE(1:IN-LEN)
           END-IF
           MOVE 1 TO WS-LINE-POS
           IF WS-LINE-L = 0
               EXIT PARAGRAPH
           END-IF
