       *> BUSINESS - record layout of Businesses (generated by rulebook-to-cobol).
       *> Use: COPY BUSINESS REPLACING ==:P:== BY ==<prefix>== under a level
       *> 01-10 group. Record length: 847 bytes.
       *> A NULL field has <name>-NI = "Y"; text is <name>-LEN bytes of <name>;
       *> booleans are "Y"/"N"; numbers are packed decimal.
       *> Name (calculated, string)
           15 :P:-NAME-NI PIC X.
           15 :P:-NAME-LEN PIC S9(4) COMP.
           15 :P:-NAME PIC X(64).
       *> LegalName (raw, string)
           15 :P:-LEGAL-NAME-LEN PIC S9(4) COMP.
           15 :P:-LEGAL-NAME PIC X(64).
       *> BusinessStructure (raw, string)
           15 :P:-BUSINESS-STRUCTURE-LEN PIC S9(4) COMP.
           15 :P:-BUSINESS-STRUCTURE PIC X(64).
       *> NaicsCode (raw, string)
           15 :P:-NAICS-CODE-LEN PIC S9(4) COMP.
           15 :P:-NAICS-CODE PIC X(64).
       *> NaicsDescription (raw, string)
           15 :P:-NAICS-DESCRIPTION-NI PIC X.
           15 :P:-NAICS-DESCRIPTION-LEN PIC S9(4) COMP.
           15 :P:-NAICS-DESCRIPTION PIC X(86).
       *> AnnualRevenueUsd (raw, float)
           15 :P:-ANNUAL-REVENUE-USD-NI PIC X.
           15 :P:-ANNUAL-REVENUE-USD PIC S9(12)V9(2) COMP-3.
       *> Status (raw, string)
           15 :P:-STATUS-LEN PIC S9(4) COMP.
           15 :P:-STATUS PIC X(64).
       *> OnboardedAt (raw, string)
           15 :P:-ONBOARDED-AT-NI PIC X.
           15 :P:-ONBOARDED-AT-LEN PIC S9(4) COMP.
           15 :P:-ONBOARDED-AT PIC X(64).
       *> RelationshipManager (relationship, string)
           15 :P:-RELATIONSHIP-MANAGER-LEN PIC S9(4) COMP.
           15 :P:-RELATIONSHIP-MANAGER PIC X(64).
       *> ReferralSource (relationship, string)
           15 :P:-REFERRAL-SOURCE-NI PIC X.
           15 :P:-REFERRAL-SOURCE-LEN PIC S9(4) COMP.
           15 :P:-REFERRAL-SOURCE PIC X(64).
       *> RelationshipManagerLabel (lookup, string)
           15 :P:-RELATIONSHIP-MANAGER-L-NI PIC X.
           15 :P:-RELATIONSHIP-MANAGER-L-LEN PIC S9(4) COMP.
           15 :P:-RELATIONSHIP-MANAGER-L PIC X(64).
       *> IsCustomer (calculated, bool)
           15 :P:-IS-CUSTOMER-NI PIC X.
           15 :P:-IS-CUSTOMER PIC X.
       *> IsProspect (calculated, bool)
           15 :P:-IS-PROSPECT-NI PIC X.
           15 :P:-IS-PROSPECT PIC X.
       *> WasReferred (calculated, bool)
           15 :P:-WAS-REFERRED-NI PIC X.
           15 :P:-WAS-REFERRED PIC X.
       *> CountOfBeneficialOwners (aggregation, int)
           15 :P:-COUNT-OF-BENEFICIAL-OW-NI PIC X.
           15 :P:-COUNT-OF-BENEFICIAL-OW PIC S9(18) COMP-3.
       *> CountOfContacts (aggregation, int)
           15 :P:-COUNT-OF-CONTACTS-NI PIC X.
           15 :P:-COUNT-OF-CONTACTS PIC S9(18) COMP-3.
       *> CountOfAccounts (aggregation, int)
           15 :P:-COUNT-OF-ACCOUNTS-NI PIC X.
           15 :P:-COUNT-OF-ACCOUNTS PIC S9(18) COMP-3.
