       *> DOCUMENT - record layout of Documents (generated by rulebook-to-cobol).
       *> Use: COPY DOCUMENT REPLACING ==:P:== BY ==<prefix>== under a level
       *> 01-10 group. Record length: 764 bytes.
       *> A NULL field has <name>-NI = "Y"; text is <name>-LEN bytes of <name>;
       *> booleans are "Y"/"N"; numbers are packed decimal.
       *> Name (calculated, string)
           15 :P:-NAME-NI PIC X.
           15 :P:-NAME-LEN PIC S9(4) COMP.
           15 :P:-NAME PIC X(68).
       *> Business (relationship, string)
           15 :P:-BUSINESS-NI PIC X.
           15 :P:-BUSINESS-LEN PIC S9(4) COMP.
           15 :P:-BUSINESS PIC X(64).
       *> Loan (relationship, string)
           15 :P:-LOAN-NI PIC X.
           15 :P:-LOAN-LEN PIC S9(4) COMP.
           15 :P:-LOAN PIC X(64).
       *> UploadedByUser (relationship, string)
           15 :P:-UPLOADED-BY-USER-NI PIC X.
           15 :P:-UPLOADED-BY-USER-LEN PIC S9(4) COMP.
           15 :P:-UPLOADED-BY-USER PIC X(64).
       *> Filename (raw, string)
           15 :P:-FILENAME-LEN PIC S9(4) COMP.
           15 :P:-FILENAME PIC X(68).
       *> DocumentType (raw, string)
           15 :P:-DOCUMENT-TYPE-LEN PIC S9(4) COMP.
           15 :P:-DOCUMENT-TYPE PIC X(64).
       *> OcrIndexed (raw, bool)
           15 :P:-OCR-INDEXED PIC X.
       *> UploadedVia (raw, string)
           15 :P:-UPLOADED-VIA-NI PIC X.
           15 :P:-UPLOADED-VIA-LEN PIC S9(4) COMP.
           15 :P:-UPLOADED-VIA PIC X(64).
       *> UploadedAt (raw, string)
           15 :P:-UPLOADED-AT-LEN PIC S9(4) COMP.
           15 :P:-UPLOADED-AT PIC X(64).
       *> BusinessLabel (lookup, string)
           15 :P:-BUSINESS-LABEL-NI PIC X.
           15 :P:-BUSINESS-LABEL-LEN PIC S9(4) COMP.
           15 :P:-BUSINESS-LABEL PIC X(64).
       *> LoanLabel (lookup, string)
           15 :P:-LOAN-LABEL-NI PIC X.
           15 :P:-LOAN-LABEL-LEN PIC S9(4) COMP.
           15 :P:-LOAN-LABEL PIC X(64).
       *> UploadedByUserLabel (lookup, string)
           15 :P:-UPLOADED-BY-USER-LABEL-NI PIC X.
           15 :P:-UPLOADED-BY-USER-LABEL-LEN PIC S9(4) COMP.
           15 :P:-UPLOADED-BY-USER-LABEL PIC X(64).
       *> AttachedTo (calculated, string)
           15 :P:-ATTACHED-TO-NI PIC X.
           15 :P:-ATTACHED-TO-LEN PIC S9(4) COMP.
           15 :P:-ATTACHED-TO PIC X(16).
       *> FromCustomerPortal (calculated, bool)
           15 :P:-FROM-CUSTOMER-PORTAL-NI PIC X.
           15 :P:-FROM-CUSTOMER-PORTAL PIC X.
