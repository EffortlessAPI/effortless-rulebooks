                   MOVE WS-IXK(1:69) TO SR-K
                   MOVE Q06 TO SR-R
                   RELEASE ERB-SORT-REC
               END-IF
           END-PERFORM
           .
       IXO15.
           MOVE 0 TO IX15-N
           MOVE 0 TO WS-SORT-EOF
           PERFORM UNTIL WS-SORT-EOF = 1
               RETURN ERB-SORT
                   AT END
                   MOVE 1 TO WS-SORT-EOF
                   NOT AT END
                   ADD 1 TO IX15-N
                   MOVE SR-K(1:69) TO IX15-K(IX15-N)
                   MOVE SR-R TO IX15-R(IX15-N)
               END-RETURN
           END-PERFORM
           .
       IXF15.
           MOVE 1 TO WS-IXLO
           COMPUTE WS-IXHI = IX15-N + 1
           PERFORM UNTIL WS-IXLO >= WS-IXHI
               COMPUTE WS-IXMID = (WS-IXLO + WS-IXHI) / 2
               IF IX15-K(WS-IXMID) < WS-IXK(1:69)
                   COMPUTE WS-IXLO = WS-IXMID + 1
               ELSE
                   MOVE WS-IXMID TO WS-IXHI
               END-IF
           END-PERFORM
           MOVE WS-IXLO TO WS-IXLB
           COMPUTE WS-IXHI = IX15-N + 1
           PERFORM UNTIL WS-IXLO >= WS-IXHI
               COMPUTE WS-IXMID = (WS-IXLO + WS-IXHI) / 2
               IF IX15-K(WS-IXMID) > WS-IXK(1:69)
                   MOVE WS-IXMID TO WS-IXHI
               ELSE
                   COMPUTE WS-IXLO = WS-IXMID + 1
               END-IF
           END-PERFORM
           .
       COPY ERBRTPR.
