//ERBJOB   JOB (ACCT),'ERB RULES',CLASS=A,MSGCLASS=X
//* Run the rules over one fixed-length file per entity.
//         SET HLQ=YOUR.HLQ
//RUN      EXEC PGM=ERBBATCH
//STEPLIB  DD DSN=&HLQ..ERB.LOADLIB,DISP=SHR
//SYSOUT   DD SYSOUT=*
//ERBPARM  DD *
CHARSET=S
/*
//* Users
//ERBI01   DD DSN=&HLQ..ERB.USERS.IN,DISP=SHR
//ERBO01   DD DSN=&HLQ..ERB.USERS.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=306)
//* Businesses
//ERBI02   DD DSN=&HLQ..ERB.BUSINESS.IN,DISP=SHR
//ERBO02   DD DSN=&HLQ..ERB.BUSINESS.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=847)
//* BeneficialOwners
//ERBI03   DD DSN=&HLQ..ERB.BENEFICI.IN,DISP=SHR
//ERBO03   DD DSN=&HLQ..ERB.BENEFICI.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=544)
//* Contacts
//ERBI04   DD DSN=&HLQ..ERB.CONTACTS.IN,DISP=SHR
//ERBO04   DD DSN=&HLQ..ERB.CONTACTS.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=667)
//* Accounts
//ERBI05   DD DSN=&HLQ..ERB.ACCOUNTS.IN,DISP=SHR
//ERBO05   DD DSN=&HLQ..ERB.ACCOUNTS.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=551)
//* Loans
//ERBI06   DD DSN=&HLQ..ERB.LOANS.IN,DISP=SHR
//ERBO06   DD DSN=&HLQ..ERB.LOANS.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=979)
//* Covenants
//ERBI07   DD DSN=&HLQ..ERB.COVENANT.IN,DISP=SHR
//ERBO07   DD DSN=&HLQ..ERB.COVENANT.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=674)
//* RiskRatingHistory
//ERBI08   DD DSN=&HLQ..ERB.RISKRATI.IN,DISP=SHR
//ERBO08   DD DSN=&HLQ..ERB.RISKRATI.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=701)
//* Documents
//ERBI09   DD DSN=&HLQ..ERB.DOCUMENT.IN,DISP=SHR
//ERBO09   DD DSN=&HLQ..ERB.DOCUMENT.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=764)
//* Interactions
//ERBI10   DD DSN=&HLQ..ERB.INTERACT.IN,DISP=SHR
//ERBO10   DD DSN=&HLQ..ERB.INTERACT.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=1064)
//* Constraints
//ERBI11   DD DSN=&HLQ..ERB.CONSTRAI.IN,DISP=SHR
//ERBO11   DD DSN=&HLQ..ERB.CONSTRAI.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=1105)
//* __meta__
//ERBI12   DD DSN=&HLQ..ERB.META.IN,DISP=SHR
//ERBO12   DD DSN=&HLQ..ERB.META.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=4591)
