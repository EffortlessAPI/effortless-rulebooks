//ERBCOMP  JOB (ACCT),'ERB COMPILE',CLASS=A,MSGCLASS=X
//* Compile and link the rules module and the batch driver with
//* Enterprise COBOL 6. ARITH(EXTEND): values carry 30 digits.
//* SYSLIB holds the copybooks: ERBCTL ERBRTWS ERBRTPR and one per entity.
//         SET HLQ=YOUR.HLQ
//RULES    EXEC IGYWCL,PARM.COBOL='ARITH(EXTEND),NODYNAM'
//COBOL.SYSIN  DD DSN=&HLQ..ERB.SOURCE(ERBRULES),DISP=SHR
//COBOL.SYSLIB DD DSN=&HLQ..ERB.COPYLIB,DISP=SHR
//LKED.SYSLMOD DD DSN=&HLQ..ERB.LOADLIB(ERBRULES),DISP=SHR
//BATCH    EXEC IGYWCL,PARM.COBOL='ARITH(EXTEND),NODYNAM'
//COBOL.SYSIN  DD DSN=&HLQ..ERB.SOURCE(ERBBATCH),DISP=SHR
//COBOL.SYSLIB DD DSN=&HLQ..ERB.COPYLIB,DISP=SHR
//LKED.SYSLIB  DD
//             DD DSN=&HLQ..ERB.LOADLIB,DISP=SHR
//LKED.SYSLMOD DD DSN=&HLQ..ERB.LOADLIB(ERBBATCH),DISP=SHR
