effortless-ntwf:expansionWave3DiscoveryNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:string ;
    rdfs:label "ExpansionWave3DiscoveryNote" ;
