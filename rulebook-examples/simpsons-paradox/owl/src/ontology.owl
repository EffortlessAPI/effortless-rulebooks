    rdfs:domain effortless-ntwf:ConfounderDistortionTimeline ;
    rdfs:range xsd:integer ;
    rdfs:label "IdentityEarliestDecade" ;
    rdfs:comment "Earliest ValidTimeDecade present in this table for this ConfounderIdentity." .

effortless-ntwf:identityEarliestTypeDFraction a owl:DatatypeProperty ;
