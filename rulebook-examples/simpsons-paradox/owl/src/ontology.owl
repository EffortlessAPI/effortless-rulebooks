effortless-ntwf:isConfirmed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiscoveryFindings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConfirmed" ;
    rdfs:comment "TRUE when the witnessed metric satisfies the pre-registered ExpectedOutcome." .

effortless-ntwf:isConfounder a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariables ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConfounder" ;
    rdfs:comment "TRUE when AffectsTreatmentAssignment AND AffectsOutcome AND CausalRole = 'confounder'. A confounder is the classic driver of Simpson's Paradox." .

effortless-ntwf:isControlStudy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Studies ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsControlStudy" ;
    rdfs:comment "TRUE if this study is a control (no Simpson's paradox expected/found); FALSE for the main Simpson's Paradox corpus." .

effortless-ntwf:isDataReady a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDataReady" ;
    rdfs:comment "TRUE when stratified data is downloaded or available from published tables." .

effortless-ntwf:isGreen a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsGreen" ;
    rdfs:comment "TRUE when FailCount = 0." .

effortless-ntwf:isImported a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsImported" ;
    rdfs:comment "TRUE when already in corpus." .

effortless-ntwf:isLatentOnlyFlip a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLatentOnlyFlip" ;
    rdfs:comment "TRUE when allocation sweep crosses zero but observed allocation shows no sign flip — latent-only reversal." .

effortless-ntwf:isOriginal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AllocationSweep ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsOriginal" ;
    rdfs:comment "TRUE for the row closest to the actual original study allocation." .

effortless-ntwf:isParadoxExplained a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsParadoxExplained" ;
    rdfs:comment "TRUE when IsReversal is present AND at least one confirmed confounder exists in the study." .

effortless-ntwf:isReadyToEncode a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReadyToEncode" ;
    rdfs:comment "TRUE when candidate has citation, proposed id, and stratum variable — ready for an import session." .

effortless-ntwf:isReversal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsReversal" ;
    rdfs:comment "TRUE when the equal-weight pooled signal (WeightedStratumGapSum) and the actual pooled signal (SignedPooledGap) point in opposite directions — allocation has flipped the direction of the aggregate conclusion. This is Simpson's Paradox as a derived fact." .

effortless-ntwf:isSignFlip a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSignFlip" .

effortless-ntwf:isStratumUnanimous a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStratumUnanimous" ;
    rdfs:comment "TRUE when one treatment wins every stratum (StrataWonByA = StratumCount OR StrataWonByB = StratumCount). Maps A/B policy split: unanimous → stratify-immediately geometry; heterogeneous → investigate-confounder." .

effortless-ntwf:isSweepFragile a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSweepFragile" ;
    rdfs:comment "Type-D study that is pooled-safe but ultra-fragile under allocation reweighting: signal_purity=1, allocation_distortion=0, sweep_pooled_gap_range>0.3, allocation_fragility>=10." .

effortless-ntwf:isSynthetic a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Studies ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSynthetic" ;
    rdfs:comment "TRUE for constructed/counterfactual studies; FALSE for real published studies. Filters the corpus for empirical claims." .

effortless-ntwf:isUnderRepresented a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DomainExpansionTargets ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUnderRepresented" ;
    rdfs:comment "TRUE when projected count still below target." .

effortless-ntwf:isValidIngestionCell a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CaseCells ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsValidIngestionCell" ;
    rdfs:comment "TRUE when Cases>=0, Successes>=0, and Successes<=Cases (loop-92: a stratum-treatment combination can legitimately have zero observed cases in real source data -- e.g. rdatasets-mtcars-engine has zero 8-cylinder straight-engine cars -- so Cases=0 is a valid ingestion cell, not a defect)." .

effortless-ntwf:justification a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MaterializedEntities ;
    rdfs:range xsd:string ;
    rdfs:label "Justification" ;
    rdfs:comment "The measured cost or evidence that justified materializing this entity instead of leaving it as a live calculated/aggregation field." .

effortless-ntwf:keyClaim a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ResearchTraditions ;
    rdfs:range xsd:string ;
    rdfs:label "KeyClaim" ;
    rdfs:comment "The tradition's signature thesis or resolution strategy." .

effortless-ntwf:keyContribution a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Researchers ;
    rdfs:range xsd:string ;
    rdfs:label "KeyContribution" ;
    rdfs:comment "One-sentence description of their specific contribution to the paradox literature." .

effortless-ntwf:keyFields a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UIScreens ;
    rdfs:range xsd:string ;
    rdfs:label "KeyFields" ;
    rdfs:comment "Comma-separated list of the most important fields displayed on this screen." .

effortless-ntwf:latentFlipCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "LatentFlipCount" .

effortless-ntwf:latentFlipPotential a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:boolean ;
    rdfs:label "LatentFlipPotential" ;
    rdfs:comment "TRUE when DistortionType=D but PooledGapCrossesZero=TRUE — SAFE at observed allocation but flip-capable under counterfactual reweighting." .

effortless-ntwf:latentFractionAmongTypeD a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "LatentFractionAmongTypeD" .

effortless-ntwf:latentTypeDCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "LatentTypeDCount" ;
    rdfs:comment "Type-D studies with LatentFlipPotential=TRUE." .

effortless-ntwf:latentTypeDFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "LatentTypeDFraction" ;
    rdfs:comment "Fraction of Type-D studies with latent flip potential." .

effortless-ntwf:legacyDomainAlias a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DomainExpansionTargets ;
    rdfs:range xsd:string ;
    rdfs:label "LegacyDomainAlias" ;
    rdfs:comment "Studies.Domain slug for legacy imported corpus rows." .

effortless-ntwf:legacyStudiesDomain a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusDomains ;
    rdfs:range xsd:string ;
    rdfs:label "LegacyStudiesDomain" ;
    rdfs:comment "Studies.Domain alias for counting already-imported corpus rows." .

effortless-ntwf:legalHighImbalanceSignFlipRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "LegalHighImbalanceSignFlipRate" ;
    rdfs:comment "Sign-flip rate among high-imbalance legal studies." .

effortless-ntwf:linkedStudyId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:string ;
    rdfs:label "LinkedStudyId" ;
    rdfs:comment "Studies.StudyId when IngestionStatus=imported." .

effortless-ntwf:liveStatusConfirmed a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:boolean ;
    rdfs:label "LiveStatusConfirmed" ;
    rdfs:comment "Lookup: DiscoveryFindings.IsConfirmed via ValidatingHypothesis — the current pass/fail state of the hypothesis backing this conclusion, recomputed on every build from live corpus data. NULL when ValidatingHypothesis is not set (no live check exists for this conclusion)." .

effortless-ntwf:liveStatusObservedMetric a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "LiveStatusObservedMetric" ;
    rdfs:comment "Lookup: DiscoveryFindings.ObservedMetric via ValidatingHypothesis — the current observed values for the hypothesis backing this conclusion, so a reader can see exactly why it currently passes or fails." .

effortless-ntwf:loopCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "LoopCount" .

effortless-ntwf:loopId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Loops ;
    rdfs:range xsd:string ;
    rdfs:label "LoopId" ;
    rdfs:comment "Unique identifier: loop-01 through loop-10." .

effortless-ntwf:manifestFlipCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "ManifestFlipCount" .

effortless-ntwf:manifestFlipRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "ManifestFlipRate" .

effortless-ntwf:mapId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariableIdentityMaps ;
    rdfs:range xsd:string ;
    rdfs:label "MapId" ;
    rdfs:comment "Unique slug." .

effortless-ntwf:mappedStratumVariableCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "MappedStratumVariableCount" ;
    rdfs:comment "Stratum variables with an identity map row." .

effortless-ntwf:materializedEntityId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MaterializedEntities ;
    rdfs:range xsd:string ;
    rdfs:label "MaterializedEntityId" ;
    rdfs:comment "Unique slug (e.g. mat-sweep-study-summary)." .

effortless-ntwf:maxStratumGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "MaxStratumGap" ;
    rdfs:comment "MAXIFS(StratumSummaries.AbsStratumGap) over rows where Study matches and TreatmentLabel='A' — the largest within-stratum rate gap for this study. Live aggregation; replaces the former hand-written _erb_tr_metrics cache column of the same name." .

effortless-ntwf:maxStratumImbalance a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "MaxStratumImbalance" ;
    rdfs:comment "MAXIFS(StratumSummaries.AbsAllocationBias) over rows where Study matches and TreatmentLabel='A' — the largest allocation-share skew any single stratum shows for this study. Live aggregation; replaces the former hand-written _erb_tr_metrics cache column of the same name." .

effortless-ntwf:maxStudySweepCorrectedGapRange a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "MaxStudySweepCorrectedGapRange" ;
    rdfs:comment "MAX(SweepStudySummary.SweepCorrectedGapRange) — must stay below 0.0001 for CorrectedGap invariance theorem." .

effortless-ntwf:meanAllocationDistortion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConfounderDistortionTimeline ;
    rdfs:range xsd:decimal ;
    rdfs:label "MeanAllocationDistortion" ;
    rdfs:comment "SumAllocationDistortion / StudyCount." .

effortless-ntwf:meanSignalPurity a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConfounderDistortionTimeline ;
    rdfs:range xsd:decimal ;
    rdfs:label "MeanSignalPurity" ;
    rdfs:comment "SumSignalPurity / StudyCount." .

effortless-ntwf:mechanicalCheck a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "MechanicalCheck" .

effortless-ntwf:mechanismClass a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "MechanismClass" .

effortless-ntwf:mechanismNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariables ;
    rdfs:range xsd:string ;
    rdfs:label "MechanismNote" ;
    rdfs:comment "Plain-language description of how this variable creates the confounding: why it affects both assignment and outcome." .

effortless-ntwf:mediatorRiskCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "MediatorRiskCount" ;
    rdfs:comment "Count of StratumVariables in this study whose ConditioningRisk is mediator or collider — the hazardous conditioning types." .

effortless-ntwf:medicineStudyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "MedicineStudyCount" ;
    rdfs:comment "Real published studies in the medicine domain. Retyped loop-90 (see RealStudyCount)." .

effortless-ntwf:methodologyId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Methodology ;
    rdfs:range xsd:string ;
    rdfs:label "MethodologyId" ;
    rdfs:comment "Unique slug (e.g. method-01-cmcc, method-02-dag-first)." .

effortless-ntwf:mockDataNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Loops ;
    rdfs:range xsd:string ;
    rdfs:label "MockDataNote" ;
    rdfs:comment "What the seed data is designed to show." .

effortless-ntwf:modelSummaryId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:string ;
    rdfs:label "ModelSummaryId" ;
    rdfs:comment "Unique identifier for this model instance." .

effortless-ntwf:nFixedA a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "NFixedA" .

effortless-ntwf:nFixedB a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "NFixedB" .

effortless-ntwf:nSweepA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AllocationSweep ;
    rdfs:range xsd:decimal ;
    rdfs:label "NSweepA" ;
    rdfs:comment "Cases in the sweep stratum assigned to treatment A = ROUND(NSweepStratumTotal * AllocFractionA)." .

effortless-ntwf:nSweepB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AllocationSweep ;
    rdfs:range xsd:decimal ;
    rdfs:label "NSweepB" ;
    rdfs:comment "Cases in the sweep stratum assigned to treatment B = NSweepStratumTotal - NSweepA." .

effortless-ntwf:nSweepStratumTotal a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "NSweepStratumTotal" .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" .

effortless-ntwf:naturalLanguage a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "NaturalLanguage" .

effortless-ntwf:newConcept a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Loops ;
    rdfs:range xsd:string ;
    rdfs:label "NewConcept" ;
    rdfs:comment "The new first-class domain concept introduced this loop." .

effortless-ntwf:nextSuggestion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Loops ;
    rdfs:range xsd:string ;
    rdfs:label "NextSuggestion" ;
    rdfs:comment "Suggestion for the next loop, written after witnessing the DAG at this loop's end." .

effortless-ntwf:nonReversalCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "NonReversalCount" ;
    rdfs:comment "Number of studies with IsReversal=FALSE." .

effortless-ntwf:observedDistortionType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:string ;
    rdfs:label "ObservedDistortionType" ;
    rdfs:comment "Actual DistortionType from TreatmentRankings when imported." .

effortless-ntwf:observedMetric a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiscoveryFindings ;
    rdfs:range xsd:string ;
    rdfs:label "ObservedMetric" ;
    rdfs:comment "Witnessed metric value from ModelSummary for this hypothesis." .

effortless-ntwf:observedSignFlipType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:boolean ;
    rdfs:label "ObservedSignFlipType" ;
    rdfs:comment "TRUE when observed DistortionType is A or B (imported rows only)." .

effortless-ntwf:openQuestion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ResearchTraditions ;
    rdfs:range xsd:string ;
    rdfs:label "OpenQuestion" ;
    rdfs:comment "What this tradition leaves unresolved or contested." .

effortless-ntwf:originalAllocFractionA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SweepStudyConfig ;
    rdfs:range xsd:decimal ;
    rdfs:label "OriginalAllocFractionA" ;
    rdfs:comment "Observed fraction of sweep-stratum cases assigned to treatment A." .

effortless-ntwf:otherDomainStudyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "OtherDomainStudyCount" ;
    rdfs:comment "Real published studies outside medicine and epidemiology (sports, legal, education, social-science). Retyped loop-90 (see RealStudyCount)." .

effortless-ntwf:owlLocalName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateConformanceFields ;
    rdfs:range xsd:string ;
    rdfs:label "OwlLocalName" ;
    rdfs:comment "camelCase OWL property local name." .

effortless-ntwf:paradoxConfirmation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:string ;
    rdfs:label "ParadoxConfirmation" ;
    rdfs:comment "confirmed | plausible | pending | not_applicable" .

effortless-ntwf:paradoxStrength a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "ParadoxStrength" ;
    rdfs:comment "Scalar severity of the paradox: PooledGap × (StrataWonByLoser / StratumCount). Zero when no strata go against the pooled winner. Positive for partial paradoxes. Maximum when every stratum contradicts the pooled result." .

effortless-ntwf:paramAllocationBias a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:decimal ;
    rdfs:label "ParamAllocationBias" ;
    rdfs:comment "b — allocation bias in stratum 1: extra fraction of stratum-1 cases assigned to treatment A above 50/50. Range 0.00–0.95." .

effortless-ntwf:paramStratumFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:decimal ;
    rdfs:label "ParamStratumFraction" ;
    rdfs:comment "w — fraction of total cases in the hard (stratum-1) subgroup. Range 0.30–0.75 in this grid." .

effortless-ntwf:paramStratumGap1 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:decimal ;
    rdfs:label "ParamStratumGap1" ;
    rdfs:comment "g1 — signed treatment advantage (rate_A − rate_B) in the hard stratum. Positive means A wins stratum 1." .

effortless-ntwf:paramStratumGap2 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:decimal ;
    rdfs:label "ParamStratumGap2" ;
    rdfs:comment "g2 — signed treatment advantage in the easy stratum. Negative g2 enables type-B (partial reversal) cells." .

effortless-ntwf:passCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:integer ;
    rdfs:label "PassCount" ;
    rdfs:comment "Rows where the invariant holds. Populated by 05b-customize-data.sql from a live query against vw_treatment_rankings." .

effortless-ntwf:pendingImportCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "PendingImportCount" ;
    rdfs:comment "Candidate studies queued." .

effortless-ntwf:perStratumWinner a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:string ;
    rdfs:label "PerStratumWinner" ;
    rdfs:comment "The treatment that wins in every stratum — 'A' if StrataWonByA = StratumCount, 'B' if StrataWonByB = StratumCount, else 'none' (no unanimous per-stratum winner)." .

effortless-ntwf:pgColumn a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateConformanceFields ;
    rdfs:range xsd:string ;
    rdfs:label "PgColumn" ;
    rdfs:comment "snake_case vw_* column." .

effortless-ntwf:phase a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Methodology ;
    rdfs:range xsd:string ;
    rdfs:label "Phase" ;
    rdfs:comment "Broad phase: axiom | decomposition | derivation | hydration | validation | taxonomy | conclusion" .

effortless-ntwf:phaseAllocationDistortion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:decimal ;
    rdfs:label "PhaseAllocationDistortion" ;
    rdfs:comment "|PhaseCorrectedGap − PhaseSignedPooledGap|." .

effortless-ntwf:phaseCorrectedGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:decimal ;
    rdfs:label "PhaseCorrectedGap" ;
    rdfs:comment "Allocation-free equal-weight gap = w×g1 + (1−w)×g2." .

effortless-ntwf:phaseDiagramComplete a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:boolean ;
    rdfs:label "PhaseDiagramComplete" ;
    rdfs:comment "TRUE when all five DistortionType cells are populated in the synthetic phase grid. Refreshed from vw_phase_diagram_summary by 05b." .

effortless-ntwf:phaseDiagramId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:PhaseDiagramSummary ;
    rdfs:range xsd:string ;
    rdfs:label "PhaseDiagramId" ;
    rdfs:comment "Unique identifier for this phase diagram instance." .

effortless-ntwf:phaseDistortionType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:string ;
    rdfs:label "PhaseDistortionType" ;
    rdfs:comment "Five-type geometric classification at this parameter point." .

effortless-ntwf:phaseId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:string ;
    rdfs:label "PhaseId" ;
    rdfs:comment "Unique grid-point identifier encoding (w, g1, g2, b) coordinates." .

effortless-ntwf:phaseIsSignFlip a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:boolean ;
    rdfs:label "PhaseIsSignFlip" ;
    rdfs:comment "TRUE when equal-weight and pooled gaps have opposite signs." .

effortless-ntwf:phaseNA1 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:decimal ;
    rdfs:label "PhaseNA1" ;
    rdfs:comment "Treatment-A cases in stratum 1." .

effortless-ntwf:phaseNA2 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:decimal ;
    rdfs:label "PhaseNA2" ;
    rdfs:comment "Treatment-A cases in stratum 2." .

effortless-ntwf:phaseNB1 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:decimal ;
    rdfs:label "PhaseNB1" ;
    rdfs:comment "Treatment-B cases in stratum 1." .

effortless-ntwf:phaseNB2 a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:decimal ;
    rdfs:label "PhaseNB2" ;
    rdfs:comment "Treatment-B cases in stratum 2." .

effortless-ntwf:phasePointCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:PhaseDiagramSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "PhasePointCount" ;
    rdfs:comment "Total grid points in SyntheticPhase (sum of type counts). Refreshed from vw_synthetic_phase by 05b-customize-data.sql." .

effortless-ntwf:phasePooledRateA a owl:DatatypeProperty ;
