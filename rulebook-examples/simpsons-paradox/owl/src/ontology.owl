effortless-ntwf:falsePositiveExplainedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "FalsePositiveExplainedCount" ;
    rdfs:comment "IsParadoxExplained=TRUE rows that are not confounder manifest sign-flips — must be 0 for explained↔confounder theorem." .

effortless-ntwf:fieldId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateConformanceFields ;
    rdfs:range xsd:string ;
    rdfs:label "FieldId" ;
    rdfs:comment "Unique slug." .

effortless-ntwf:fieldName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "FieldName" .

effortless-ntwf:filterExpression a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "FilterExpression" ;
