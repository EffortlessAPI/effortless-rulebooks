effortless-ntwf:findingId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiscoveryFindings ;
    rdfs:range xsd:string ;
    rdfs:label "FindingId" ;
    rdfs:comment "Unique slug; one row per hypothesis." .

effortless-ntwf:fixedRateA a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "FixedRateA" .

effortless-ntwf:fixedRateB a owl:DatatypeProperty ;
