    rdfs:comment "PhaseStrataWonByLoser / 2 for this 2-stratum template." .

effortless-ntwf:phaseS1Total a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SyntheticPhase ;
    rdfs:range xsd:decimal ;
    rdfs:label "PhaseS1Total" ;
