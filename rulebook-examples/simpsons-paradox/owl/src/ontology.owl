@prefix effortless-ntwf: <https://w3id.org/effortless-ntwf#> .
@prefix erb: <https://effortlessapi.com/ns/erb#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/effortless-ntwf> a owl:Ontology ;
    rdfs:label "simpsons-paradox" ;
    dcterms:title "simpsons-paradox" ;
    dcterms:description "Digital mirror of the Simpson's Paradox domain. The entities are Studies, Treatments, Strata, and CaseCells (raw patient counts). SuccessRates, TreatmentSummaries, and TreatmentRankings are derived. The paradox falls out of the DAG as an emergent derived fact — it is never modeled directly." ;
    rdfs:comment "Generated by Effortless (rulebook-to-owl) from simpsons-paradox-rulebook.json. The rulebook is the source: change it there, not here." ;
    rdfs:comment "ERB build parameters: erbBlankLogic=coerce, erbDateDiff=calendar, erbDateTimeText=iso8601, erbTimezone=UTC, erbWholeNumber=by-field-type" .

dcterms:description a owl:AnnotationProperty .
dcterms:title a owl:AnnotationProperty .

# The key of the row an individual was made from, verbatim (its IRI is only a slug of it).
erb:key a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "key" .

# === Class: AllocationSweep ===
effortless-ntwf:AllocationSweep a owl:Class ;
    rdfs:label "AllocationSweep" ;
    rdfs:comment "Table: AllocationSweep — parametric sweep of treatment-A allocation fraction within each study's most confounded stratum (see SweepStudyConfig). Ten fractions from 0.05 to 0.95 per study. SweepCorrectedGap is invariant; SweepPooledGap wanders." .

# === Class: CandidateStudyCatalog ===
effortless-ntwf:CandidateStudyCatalog a owl:Class ;
    rdfs:label "CandidateStudyCatalog" ;
    rdfs:comment "Table: CandidateStudyCatalog — curated backlog of published Simpson's-paradox-eligible studies. Tracks import status, expected distortion type, and encoding metadata before CaseCells exist." .

# === Class: CaseCells ===
effortless-ntwf:CaseCells a owl:Class ;
    rdfs:label "CaseCells" ;
    rdfs:comment "Table: CaseCells — the raw leaves of the DAG. One row per (study, stratum, treatment) combination recording the aggregate count of successes and total cases. Every derived fact in the model traces back to these numbers. Nothing above this row is a raw input." .

# === Class: Conclusions ===
effortless-ntwf:Conclusions a owl:Class ;
    rdfs:label "Conclusions" ;
    rdfs:comment "Table: Conclusions — the substantive epistemic findings that this model has produced or is designed to produce. Each row is one conclusion: a claim about the domain, about the instrument, or about the methodology that is either already witnessed or is the target of a planned loop." .

# === Class: ConfounderDistortionTimeline ===
effortless-ntwf:ConfounderDistortionTimeline a owl:Class ;
    rdfs:label "ConfounderDistortionTimeline" ;
    rdfs:comment "Table: ConfounderDistortionTimeline -- derived geometry at the (ConfounderIdentity x ValidTimeDecade) grain. Each row aggregates the studies whose real-world cohort period (valid-time, not publication year) falls in that decade and that carry the given confounder archetype, tracking whether the corpus drifts toward clean Type-D (non-reversing, zero-allocation-distortion) outcomes over time and whether that drift is confounder-specific. Principled materialization per CLAUDE.md (N-way join over a sealed, bounded study set) -- refreshed via refresh_confounder_distortion_timeline(), same pattern as IdentityClusterSummaries/IdentityDomainCells." .

# === Class: ConfounderIdentities ===
effortless-ntwf:ConfounderIdentities a owl:Class ;
    rdfs:label "ConfounderIdentities" ;
    rdfs:comment "Table: ConfounderIdentities — canonical cross-study archetypes for stratum variables. Each identity names a reusable confounding mechanism accountable across the corpus (loop-80)." .

# === Class: CorpusBalance ===
effortless-ntwf:CorpusBalance a owl:Class ;
    rdfs:label "CorpusBalance" .

# === Class: CorpusCatalogSummary ===
effortless-ntwf:CorpusCatalogSummary a owl:Class ;
    rdfs:label "CorpusCatalogSummary" ;
    rdfs:comment "Table: CorpusCatalogSummary — one row witnessing import-backlog readiness for bulk encoding sessions." .

# === Class: CorpusDomains ===
effortless-ntwf:CorpusDomains a owl:Class ;
    rdfs:label "CorpusDomains" ;
    rdfs:comment "Table: CorpusDomains — canonical expansion-domain slugs from corpus-expansion-plan.md (loop-67)." .

# === Class: DiscoveryFindings ===
effortless-ntwf:DiscoveryFindings a owl:Class ;
    rdfs:label "DiscoveryFindings" ;
    rdfs:comment "Table: DiscoveryFindings — witnessed outcomes for each pre-registered DiscoveryHypothesis. IsConfirmed is computed live from ModelSummary aggregates." .

# === Class: DiscoveryHypotheses ===
effortless-ntwf:DiscoveryHypotheses a owl:Class ;
    rdfs:label "DiscoveryHypotheses" ;
    rdfs:comment "Table: DiscoveryHypotheses — pre-registered empirical claims tested against the corpus at loop-61. Each row states an expected pattern before querying the DAG." .

# === Class: DomainExpansionTargets ===
effortless-ntwf:DomainExpansionTargets a owl:Class ;
    rdfs:label "DomainExpansionTargets" ;
    rdfs:comment "Table: DomainExpansionTargets — per-domain corpus growth targets for bulk import prioritisation." .

# === Class: IdentityClusterSummaries ===
effortless-ntwf:IdentityClusterSummaries a owl:Class ;
    rdfs:label "IdentityClusterSummaries" ;
    rdfs:comment "Table: IdentityClusterSummaries — witnessed geometry rollup per ConfounderIdentity (manifest flip, latent-D, avg distortion) — loop-80 open-question substrate." .

# === Class: IdentityDomainCells ===
effortless-ntwf:IdentityDomainCells a owl:Class ;
    rdfs:label "IdentityDomainCells" .

# === Class: IngestionProtocol ===
effortless-ntwf:IngestionProtocol a owl:Class ;
    rdfs:label "IngestionProtocol" ;
    rdfs:comment "Table: IngestionProtocol — the minimal formal contract for adding a new 2×K study to the corpus." .

# === Class: IngestionSummary ===
effortless-ntwf:IngestionSummary a owl:Class ;
    rdfs:label "IngestionSummary" ;
    rdfs:comment "Table: IngestionSummary — witnesses that the current corpus satisfies the IngestionProtocol contract." .

# === Class: InstrumentSpec ===
effortless-ntwf:InstrumentSpec a owl:Class ;
    rdfs:label "InstrumentSpec" ;
    rdfs:comment "Table: InstrumentSpec — the complete specification of the Simpson's Paradox classification instrument. One row per component: required input fields, derived coordinates, classification outputs, and adapter requirements. Every row is machine-verifiable against the 238-study corpus. This table is the distillation of loops 1–25 into a reusable tool." .

# === Class: InvariantChecks ===
effortless-ntwf:InvariantChecks a owl:Class ;
    rdfs:label "InvariantChecks" ;
    rdfs:comment "Table: InvariantChecks — one row per algebraic invariant across the 40-study validation corpus. PassCount and FailCount are populated by run_invariant_checks() in 05b-customize-data.sql. Any critical FailCount > 0 breaks the build." .

# === Class: Loops ===
effortless-ntwf:Loops a owl:Class ;
    rdfs:label "Loops" ;
    rdfs:comment "Table: Loops — build history and forward plan, carried as a first-class entity inside the model. Each row documents what new concept is introduced, what was witnessed, and (for planned rows) the next empirical question. Loops 62–67 are the corpus-scale research sweep + catalog expansion. Loops 68+ are the expansion encode waves: pre-register in DiscoveryHypotheses, encode via StudyImportTemplate, LoopReview at end of each turn before committing vocabulary." .

# === Class: MaterializedEntities ===
effortless-ntwf:MaterializedEntities a owl:Class ;
    rdfs:label "MaterializedEntities" ;
    rdfs:comment "Table: MaterializedEntities — governance record of every entity in this rulebook whose fields are principled materializations rather than live-calculated (per project CLAUDE.md: allowed only when the computation is genuinely expensive AND its upstream is sealed/stable, expressed as data in the rulebook itself, never as an ad-hoc application cache). Each row names the entity, the refresh contract, the refresh function that implements it, and the measured cost that justified materializing it. If this table's row for an entity were deleted, the entity's fields should still be regeneratable identically from the SSoT + the refresh function — that is the test for whether a materialization here is principled." .

# === Class: Methodology ===
effortless-ntwf:Methodology a owl:Class ;
    rdfs:label "Methodology" ;
    rdfs:comment "Table: Methodology — the first-principles process used to build this domain model. Each row documents one methodological axiom or step. Together these rows let a reader (or an LLM) reconstruct why the model is shaped the way it is, and re-apply the same process to a new domain." .

# === Class: ModelSummary ===
effortless-ntwf:ModelSummary a owl:Class ;
    rdfs:label "ModelSummary" ;
    rdfs:comment "Table: ModelSummary — one row describing the epistemic coverage of this entire model instance. Aggregates across all TreatmentRankings to witness how many studies were examined, how many showed a full reversal, how many were explained, and the average paradox strength. The model holds a mirror to itself." .

# === Class: PhaseDiagramSummary ===
effortless-ntwf:PhaseDiagramSummary a owl:Class ;
    rdfs:label "PhaseDiagramSummary" ;
    rdfs:comment "Table: PhaseDiagramSummary — one row summarising the SyntheticPhase grid. Witnesses that all five DistortionType cells (A, B, C+, C-, D) are nonempty in parameter space." .

# === Class: ResearchTraditions ===
effortless-ntwf:ResearchTraditions a owl:Class ;
    rdfs:label "ResearchTraditions" ;
    rdfs:comment "Table: ResearchTraditions — the six scholarly lineages that have engaged with Simpson's Paradox. Each row is a named intellectual tradition, not a specific paper or result." .

# === Class: Researchers ===
effortless-ntwf:Researchers a owl:Class ;
    rdfs:label "Researchers" ;
    rdfs:comment "Table: Researchers — individuals who have made named, verified contributions to understanding Simpson's Paradox. Linked to ResearchTraditions by TraditionId." .

# === Class: Strata ===
effortless-ntwf:Strata a owl:Class ;
    rdfs:label "Strata" ;
    rdfs:comment "Table: Strata — the subdivisions of patients within a study by the value of the confounding variable (e.g. stone size). Each stratum belongs to one study." .

# === Class: StratumSummaries ===
effortless-ntwf:StratumSummaries a owl:Class ;
    rdfs:label "StratumSummaries" ;
    rdfs:comment "Table: StratumSummaries — one row per (study, stratum, treatment). Computes the success rate WITHIN each stratum for each treatment. This is the stratified view that contradicts the pooled conclusion when a Simpson's Paradox reversal is present. Each row belongs to both a Stratum and a Treatment in the same Study." .

# === Class: StratumVariableIdentityMaps ===
effortless-ntwf:StratumVariableIdentityMaps a owl:Class ;
    rdfs:label "StratumVariableIdentityMaps" ;
    rdfs:comment "Table: StratumVariableIdentityMaps — many-to-one map from per-study StratumVariables to canonical ConfounderIdentities (loop-80)." .

# === Class: StratumVariables ===
effortless-ntwf:StratumVariables a owl:Class ;
    rdfs:label "StratumVariables" ;
    rdfs:comment "Table: StratumVariables — one row per study, naming the variable that defines the strata and describing its causal role. A confounder affects both treatment assignment AND outcome; a mediator is downstream of treatment; a contested variable is one where the causal role is disputed. IsConfounder is derived from these two boolean flags." .

# === Class: Studies ===
effortless-ntwf:Studies a owl:Class ;
    rdfs:label "Studies" ;
    rdfs:comment "Table: Studies — a clinical or empirical study comparing two or more treatments for a condition, with patient cases stratified by a confounding variable. The top-level entity in the domain." .

# === Class: StudyImportTemplate ===
effortless-ntwf:StudyImportTemplate a owl:Class ;
    rdfs:label "StudyImportTemplate" ;
    rdfs:comment "Table: StudyImportTemplate — mechanical checklist of rulebook rows to create when importing one catalog candidate." .

# === Class: SubstrateConformanceFields ===
effortless-ntwf:SubstrateConformanceFields a owl:Class ;
    rdfs:label "SubstrateConformanceFields" ;
    rdfs:comment "Table: SubstrateConformanceFields — cross-substrate OWL-SHACL vs Postgres compare manifest for owl/reason.py. Rows with AssertFromPostgres=TRUE are asserted as leaf facts before SHACL fixpoint (OWL transpiler lacks CONSTRUCT for nested IF chains)." .

# === Class: SweepStudyConfig ===
effortless-ntwf:SweepStudyConfig a owl:Class ;
    rdfs:label "SweepStudyConfig" ;
    rdfs:comment "Table: SweepStudyConfig — per-study allocation-sweep parameters derived from CaseCells. Picks the highest-allocation-bias stratum to sweep; holds all other strata fixed." .

# === Class: SweepStudySummary ===
effortless-ntwf:SweepStudySummary a owl:Class ;
    rdfs:label "SweepStudySummary" .

# === Class: SyntheticPhase ===
effortless-ntwf:SyntheticPhase a owl:Class ;
    rdfs:label "SyntheticPhase" ;
    rdfs:comment "Table: SyntheticPhase — a parametric grid of canonical 2×2 synthetic studies at controlled (ParamStratumFraction, ParamStratumGap1, ParamStratumGap2, ParamAllocationBias) coordinates. Stratum 1 is the hard stratum (base rate 0.45); stratum 2 is easy (base rate 0.75). Each row constructs cell counts from the parameters and derives PhaseDistortionType using the same geometric classification as TreatmentRankings. This maps the A/B/C+/C-/D phase boundaries algebraically — independent of empirical corpus data." .

# === Class: TreatmentRankings ===
effortless-ntwf:TreatmentRankings a owl:Class ;
    rdfs:label "TreatmentRankings" ;
    rdfs:comment "Table: TreatmentRankings — one row per treatment-pair comparison within a study. Derives the pooled winner, the per-stratum winner, and the IsReversal boolean. The paradox emerges here as a derived fact: IsReversal is true when the pooled winner and the per-stratum winner disagree." .

# === Class: Treatments ===
effortless-ntwf:Treatments a owl:Class ;
    rdfs:label "Treatments" ;
    rdfs:comment "Table: Treatments — the interventions being compared within a study. Each treatment belongs to one study." .

# === Class: UIComponents ===
effortless-ntwf:UIComponents a owl:Class ;
    rdfs:label "UIComponents" ;
    rdfs:comment "Table: UIComponents — the reusable visual building blocks used across UIScreens. Each row defines one component: what it renders, which entity it reads, and what props it requires. A developer can implement the full UI by composing these components onto the screens defined in UIScreens." .

# === Class: UIScreens ===
effortless-ntwf:UIScreens a owl:Class ;
    rdfs:label "UIScreens" ;
    rdfs:comment "Table: UIScreens — the canonical screens that comprise the Simpson's Paradox Explorer UI. Each row defines one screen: its purpose, its primary data source (which rulebook view it reads), and the user action it supports. A developer can reconstruct the full UI from this table without any prior knowledge of the application." .

effortless-ntwf:absAllocationBias a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "AbsAllocationBias" ;
    rdfs:comment "ABS(AllocationBias). MAXIFS-friendly unsigned magnitude so TreatmentRankings.MaxStratumImbalance can compute live via MAXIFS instead of a hand-written cache." .

effortless-ntwf:absStratumGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "AbsStratumGap" ;
    rdfs:comment "ABS(StratumGap). MAXIFS-friendly unsigned magnitude so TreatmentRankings.MaxStratumGap can compute live via MAXIFS instead of a hand-written cache." .

effortless-ntwf:activePeriod a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Researchers ;
    rdfs:range xsd:string ;
    rdfs:label "ActivePeriod" ;
    rdfs:comment "Approximate years of relevant work, e.g. \"1899\"." .

effortless-ntwf:adapterNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InstrumentSpec ;
    rdfs:range xsd:string ;
    rdfs:label "AdapterNote" ;
    rdfs:comment "What a researcher must supply or verify to satisfy this component when hydrating a new study." .

effortless-ntwf:adjustmentAppropriate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:boolean ;
    rdfs:label "AdjustmentAppropriate" ;
    rdfs:comment "TRUE only when it is epistemically safe to act on CorrectedGap as the causal treatment effect estimate: no mediator/collider conditioning risk AND causal claim is established (not contested or geometric-only). FALSE for the birth-weight paradox (mediator), berkeley-1973 (contested), and synthetic/degenerate studies (geometric-only)." .

effortless-ntwf:adjustmentRationale a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:string ;
    rdfs:label "AdjustmentRationale" ;
    rdfs:comment "Human-authored note explaining why AdjustmentAppropriate is TRUE or FALSE for this study. Covers mediator/collider hazards, contested causal roles, and cases where geometric correction is valid but causal interpretation is uncertain." .

effortless-ntwf:affectsOutcome a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariables ;
    rdfs:range xsd:boolean ;
    rdfs:label "AffectsOutcome" ;
    rdfs:comment "TRUE if this variable causally influences the outcome independently of treatment. Required for confounding." .

effortless-ntwf:affectsTreatmentAssignment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariables ;
    rdfs:range xsd:boolean ;
    rdfs:label "AffectsTreatmentAssignment" ;
    rdfs:comment "TRUE if this variable causally influences which treatment a patient receives. Required for confounding." .

effortless-ntwf:affiliation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Researchers ;
    rdfs:range xsd:string ;
    rdfs:label "Affiliation" ;
    rdfs:comment "Primary institutional affiliation for the relevant work." .

effortless-ntwf:ageDriftDirection a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:string ;
    rdfs:label "AgeDriftDirection" ;
    rdfs:comment "loop-92: ConfounderDistortionTimeline.DriftDirection for id-age-composition (demographic-composition archetype), valid-time Type-D drift. Overridden in 02b-customize-functions.sql: native transpiler mistranslates LOOKUP(constant, Table[NonPKColumn], Table[TargetColumn]) into a lookup keyed on the table's PK instead of the specified match column." .

effortless-ntwf:ageIdentityLatentFractionAmongTypeD a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "AgeIdentityLatentFractionAmongTypeD" ;
    rdfs:comment "Type-D latent fraction for id-age-composition cluster (loop-81)." .

effortless-ntwf:ageIdentityManifestFlipRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "AgeIdentityManifestFlipRate" ;
    rdfs:comment "Manifest flip rate for id-age-composition cluster (loop-81)." .

effortless-ntwf:ageIdentityStudyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "AgeIdentityStudyCount" ;
    rdfs:comment "Real-study count in id-age-composition cluster (loop-81)." .

effortless-ntwf:algebraicStatement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "AlgebraicStatement" ;
    rdfs:comment "The mathematical assertion in compact symbolic form." .

effortless-ntwf:allCellsValid a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IngestionSummary ;
    rdfs:range xsd:boolean ;
    rdfs:label "AllCellsValid" ;
    rdfs:comment "Every cell passes validity predicate." .

effortless-ntwf:allFiveTypesPresent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:PhaseDiagramSummary ;
    rdfs:range xsd:boolean ;
    rdfs:label "AllFiveTypesPresent" ;
    rdfs:comment "TRUE when every DistortionType cell has at least one grid point." .

effortless-ntwf:allRealStudiesCompliant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IngestionSummary ;
    rdfs:range xsd:boolean ;
    rdfs:label "AllRealStudiesCompliant" ;
    rdfs:comment "All real studies fully compliant." .

effortless-ntwf:allStudiesStructural a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IngestionSummary ;
    rdfs:range xsd:boolean ;
    rdfs:label "AllStudiesStructural" ;
    rdfs:comment "All studies structurally valid." .

effortless-ntwf:allocFractionA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AllocationSweep ;
    rdfs:range xsd:decimal ;
    rdfs:label "AllocFractionA" ;
    rdfs:comment "Fraction of the sweep-stratum cases assigned to treatment A. Ranges from 0.05 to 0.95. The sweep stratum is the one whose allocation was most confounded in the original study." .

effortless-ntwf:allocationBias a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "AllocationBias" ;
    rdfs:comment "AllocationFractionA minus AllocationFractionB: how much more of treatment A (relative to B) is concentrated in this stratum. Positive = A is over-allocated here; negative = B is over-allocated here. When AllocationBias is large and negative in a low-success stratum, treatment A is under-represented in the hard cases — making A look worse in the pooled view than it is in any stratum. This is the confounder's fingerprint as a signed number." .

effortless-ntwf:allocationDirection a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:string ;
    rdfs:label "AllocationDirection" ;
    rdfs:comment "Whether the allocation is reversing, amplifying, or compressing the true treatment signal (CorrectedGap). 'reversal': allocation changed the sign of the pooled gap relative to CorrectedGap — worst case; pooled winner is wrong (types A and B). 'amplification': allocation inflated the pooled gap beyond CorrectedGap in the same direction — pooled winner is correct but effect size is overstated (type C+). 'compression': allocation shrank the pooled gap below CorrectedGap in the same direction — pooled winner is correct but effect size is understated (type C-). 'neutral': allocation had negligible effect on the pooled gap (type D). Policy consequences: reversal → wrong decision; amplification → overconfidence; compression → underconfidence / premature abandonment; neutral → trustworthy." .

effortless-ntwf:allocationDistortion a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "AllocationDistortion" .

effortless-ntwf:allocationDistortionWitness a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AllocationSweep ;
    rdfs:range xsd:decimal ;
    rdfs:label "AllocationDistortionWitness" ;
    rdfs:comment "SweepPooledGap minus SweepCorrectedGap. The allocation distortion: how much the pooled signal has been inflated or deflated by differential stratum allocation. Zero only when allocation is balanced." .

effortless-ntwf:allocationFractionA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "AllocationFractionA" ;
    rdfs:comment "Fraction of treatment A's total cases that land in this stratum: TreatmentACasesHere / TreatmentATotalCases. Equivalent to TreatmentExposureFraction for A." .

effortless-ntwf:allocationFractionB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "AllocationFractionB" ;
    rdfs:comment "Fraction of treatment B's total cases that land in this stratum: TreatmentBCasesHere / TreatmentBTotalCases." .

effortless-ntwf:allocationFragility a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "AllocationFragility" ;
    rdfs:comment "SweepPooledGapRange divided by |PooledGap|. High values mean small observed effect but wide counterfactual wander. Fixed loop-90: this rulebook's IF(x=\"\",\"\",...) blank-on-degenerate idiom transpiles to a bare ''::numeric cast that errors at runtime the moment a live row genuinely has PooledGap=0 (surfaced only once _erb_tr_metrics, which masked this row, was eliminated). Returns 0 for the degenerate case instead — see TreatmentRankings.DistortionRatio for the same fix pattern." .

effortless-ntwf:annotationCommitDate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariables ;
    rdfs:range xsd:string ;
    rdfs:label "AnnotationCommitDate" ;
    rdfs:comment "ISO date (YYYY-MM-DD) of AnnotationCommitHash." .

effortless-ntwf:annotationCommitHash a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariables ;
    rdfs:range xsd:string ;
    rdfs:label "AnnotationCommitHash" ;
    rdfs:comment "Full git SHA of the commit that first introduced this row's CausalRole/MechanismNote — derived via `git log -S` pickaxe search on this row's StratumVariableId (loop-98 audit-trail backfill). Real repo history, not a hand-entered label." .

effortless-ntwf:annotationCommitSubject a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariables ;
    rdfs:range xsd:string ;
    rdfs:label "AnnotationCommitSubject" ;
    rdfs:comment "Git commit subject line of AnnotationCommitHash — the loop/change that landed this row's causal-role judgment call." .

effortless-ntwf:armSizeRatio a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "ArmSizeRatio" ;
    rdfs:comment "TotalCasesA / (TotalCasesA + TotalCasesB) — the share of total cases allocated to TreatmentA. Promoted loop-90 (see DistortionRatio for why the empty-string zero-denominator idiom is unsafe on a numeric field). Returns 0 for the degenerate zero-case-count edge (never occurs in this corpus, kept for defensive symmetry with DistortionRatio)." .

effortless-ntwf:assertFromPostgres a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SubstrateConformanceFields ;
    rdfs:range xsd:boolean ;
    rdfs:label "AssertFromPostgres" ;
    rdfs:comment "TRUE when OWL cannot derive this field yet and Postgres value is asserted before SHACL fixpoint." .

effortless-ntwf:assertionExpression a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "AssertionExpression" ;
    rdfs:comment "The per-row condition that must be TRUE for every row in scope." .

effortless-ntwf:avgAllocationDistortion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IdentityClusterSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "AvgAllocationDistortion" ;
    rdfs:comment "Mean allocation distortion in cluster." .

effortless-ntwf:avgParadoxStrength a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "AvgParadoxStrength" ;
    rdfs:comment "Average ParadoxStrength across all studies: TotalParadoxStrength / StudyCount. A scalar summary of how paradox-rich this dataset is." .

effortless-ntwf:avgPooledGapLatentD a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "AvgPooledGapLatentD" ;
    rdfs:comment "Average PooledGap among Type-D studies with latent flip potential. Fixed loop-90 (see SumPooledGapLatentD for why the sum is split into its own field)." .

effortless-ntwf:avgPooledGapStableD a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "AvgPooledGapStableD" ;
    rdfs:comment "Average PooledGap among allocation-stable Type-D studies. Fixed loop-90 (see SumPooledGapLatentD)." .

effortless-ntwf:avgSignalPurity a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "AvgSignalPurity" ;
    rdfs:comment "Average SignalPurity across all TreatmentRankings. Below 0.5 means allocation noise exceeds true signal on average — the corpus is predominantly misleading at the pooled level. Above 0.5 means the corpus is predominantly trustworthy. Fixed loop-90: COUNTIFS(...,\"<>\")/SUMIFS(...,\"<>\") mistranslate to a literal '<>' string-equality filter (a known transpiler bug), always returning 0/NULL; replaced with SUM/COUNT, both of which transpile correctly." .

effortless-ntwf:avgSignalPurityNonReversal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "AvgSignalPurityNonReversal" ;
    rdfs:comment "Average SignalPurity across non-reversal studies (type C+, C-, D). Theorem predicts this must be >= 0.5 except edge cases. Retyped loop-90 (see RealStudyCount); rewritten from SUMIFS/COUNTIFS division to AVERAGEIFS (see AvgSignalPurityReversal)." .

effortless-ntwf:avgSignalPurityReversal a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "AvgSignalPurityReversal" ;
    rdfs:comment "Average SignalPurity across reversal studies (type A and B). Theorem predicts this must be < 0.5. Retyped loop-90 (see RealStudyCount); rewritten from SUMIFS/COUNTIFS division to AVERAGEIFS because the SUMIFS/COUNTIFS division form transpiled with a mangled cross-table alias." .

effortless-ntwf:balanceId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusBalance ;
    rdfs:range xsd:string ;
    rdfs:label "BalanceId" ;
    rdfs:comment "Primary key (singleton: 'corpus-balance')" .

effortless-ntwf:blockedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusCatalogSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "BlockedCount" ;
    rdfs:comment "Duplicate or blocked rows." .

effortless-ntwf:cAmplificationCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "CAmplificationCount" ;
    rdfs:comment "Number of studies classified as type C+ (allocation-amplified): pooled winner is correct but pooled gap overstates true advantage. Causes researcher overconfidence — may accept higher cost/risk than true effect warrants." .

effortless-ntwf:cCompressionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "CCompressionCount" ;
    rdfs:comment "Number of studies classified as type C- (allocation-compressed): pooled winner is correct but pooled gap understates true advantage. Causes researcher underconfidence — effective treatment may be prematurely abandoned." .

effortless-ntwf:cMinusAvgDistortion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "CMinusAvgDistortion" ;
    rdfs:comment "Mean AllocationDistortion among Type-C- studies." .

effortless-ntwf:cPlusAvgDistortion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "CPlusAvgDistortion" ;
    rdfs:comment "Mean AllocationDistortion among Type-C+ studies." .

effortless-ntwf:candidateCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusCatalogSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "CandidateCount" ;
    rdfs:comment "Rows queued for import." .

effortless-ntwf:candidateId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:string ;
    rdfs:label "CandidateId" ;
    rdfs:comment "Unique slug for this catalog entry." .

effortless-ntwf:candidateQueuedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DomainExpansionTargets ;
    rdfs:range xsd:integer ;
    rdfs:label "CandidateQueuedCount" ;
    rdfs:comment "Catalog candidates in this domain." .

effortless-ntwf:canonicalStudyDistortionType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Researchers ;
    rdfs:range xsd:string ;
    rdfs:label "CanonicalStudyDistortionType" ;
    rdfs:comment "Lookup: TreatmentRankings.DistortionType for the canonical study — the geometric type of paradox this researcher's work exemplifies." .

effortless-ntwf:canonicalStudyId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Researchers ;
    rdfs:range xsd:string ;
    rdfs:label "CanonicalStudyId" ;
    rdfs:comment "FK → Studies.StudyId. The study in this model that best illustrates this researcher's specific contribution to the Simpson's Paradox literature." .

effortless-ntwf:canonicalStudyPolicyImplication a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Researchers ;
    rdfs:range xsd:string ;
    rdfs:label "CanonicalStudyPolicyImplication" ;
    rdfs:comment "Lookup: TreatmentRankings.CorrectedPolicyImplication for the canonical study." .

effortless-ntwf:canonicalStudyTitle a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Researchers ;
    rdfs:range xsd:string ;
    rdfs:label "CanonicalStudyTitle" ;
    rdfs:comment "Lookup: Studies.Title via CanonicalStudyId." .

effortless-ntwf:caseCellId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CaseCells ;
    rdfs:range xsd:string ;
    rdfs:label "CaseCellId" ;
    rdfs:comment "Unique slug (e.g. kidney-1986-small-A)." .

effortless-ntwf:cases a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CaseCells ;
    rdfs:range xsd:integer ;
    rdfs:label "Cases" ;
    rdfs:comment "Total number of patients in this cell. RAW INPUT — never derived." .

effortless-ntwf:catalogEntryCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "CatalogEntryCount" ;
    rdfs:comment "Total catalog rows." .

effortless-ntwf:catalogPredictionWitnessNote a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CatalogPredictionWitnessNote" .

effortless-ntwf:catalogSummaryId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusCatalogSummary ;
    rdfs:range xsd:string ;
    rdfs:label "CatalogSummaryId" ;
    rdfs:comment "Unique identifier." .

effortless-ntwf:catalogWitnessNote a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CatalogWitnessNote" .

effortless-ntwf:category a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "Category" ;
    rdfs:comment "domain | instrument | methodology | open-question | corpus-theorem" .

effortless-ntwf:causalClaimStatus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:string ;
    rdfs:label "CausalClaimStatus" ;
    rdfs:comment "The epistemic status of the causal interpretation for this study. Values: established (all stratum variables are confirmed confounders with known mechanisms), contested (at least one stratum variable has a disputed causal role — e.g. Berkeley 1973 where department choice may be endogenous), geometric-only (no stratum variable has an established causal role — the distortion is a geometric fact, not a causal claim). Derived from StratumVariables.CausalRole and ConditioningRisk." .

effortless-ntwf:causalRole a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CausalRole" .

effortless-ntwf:causalRoleEverRevised a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariables ;
    rdfs:range xsd:boolean ;
    rdfs:label "CausalRoleEverRevised" ;
    rdfs:comment "TRUE if this row's CausalRole value differs across any two points in its git history (a real reclassification); FALSE if the value has been identical since AnnotationCommitHash. Computed once at loop-97 backfill via full-history diff, not re-derived live — re-run the backfill script after any future CausalRole edit to keep this accurate." .

effortless-ntwf:cautionTierCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "CautionTierCount" ;
    rdfs:comment "Studies where TreatmentRankings.ScreeningTier = CAUTION — pooled sign holds but magnitude is distorted (DistortionType C+ or C-)." .

effortless-ntwf:cellCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Studies ;
    rdfs:range xsd:integer ;
    rdfs:label "CellCount" ;
    rdfs:comment "Number of CaseCell rows for this study." .

effortless-ntwf:cellId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CellId" .

effortless-ntwf:cellSuccessRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CaseCells ;
    rdfs:range xsd:decimal ;
    rdfs:label "CellSuccessRate" ;
    rdfs:comment "Success rate within this cell: Successes / Cases. The first derived fact in the DAG. Fixed loop-90: this rulebook's IF(x=0,\"\",...) idiom transpiles to a bare ''::numeric cast that errors at runtime for the one CaseCells row with Cases=0 (surfaced only once _erb_tr_metrics stopped masking it). Returns 0 for the degenerate zero-cases cell instead." .

effortless-ntwf:challengesResearcher a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "ChallengesResearcher" ;
    rdfs:comment "FK → Researchers.ResearcherId. A researcher whose position this conclusion refutes or qualifies (e.g. conc-03 refutes Blyth's unanimity criterion as the primary definition)." .

effortless-ntwf:challengesResearcherName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "ChallengesResearcherName" ;
    rdfs:comment "Lookup: Researchers.Name via ChallengesResearcher." .

effortless-ntwf:citation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:string ;
    rdfs:label "Citation" ;
    rdfs:comment "Primary publication citation." .

effortless-ntwf:colliderIdentityManifestFlipRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "ColliderIdentityManifestFlipRate" ;
    rdfs:comment "Manifest flip rate for collider-proxy identity." .

effortless-ntwf:colliderSelectionCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "ColliderSelectionCount" ;
    rdfs:comment "Studies tagged collider or selection on StratumVariables." .

effortless-ntwf:colliderSelectionLatentOnlyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "ColliderSelectionLatentOnlyCount" ;
    rdfs:comment "Latent-only flips among collider/selection studies." .

effortless-ntwf:colliderSelectionManifestCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "ColliderSelectionManifestCount" ;
    rdfs:comment "Manifest sign-flips among collider/selection studies." .

effortless-ntwf:commitDate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Loops ;
    rdfs:range xsd:string ;
    rdfs:label "CommitDate" ;
    rdfs:comment "ISO date (YYYY-MM-DD) of the commit where this loop landed." .

effortless-ntwf:commitHash a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Loops ;
    rdfs:range xsd:string ;
    rdfs:label "CommitHash" ;
    rdfs:comment "Full git SHA where this loop row first landed in effortless-rulebook.json — the replay anchor for this turn of the Effortless loop." .

effortless-ntwf:commitMessage a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Loops ;
    rdfs:range xsd:string ;
    rdfs:label "CommitMessage" ;
    rdfs:comment "Git commit subject line for this loop's landing commit." .

effortless-ntwf:commitShort a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Loops ;
    rdfs:range xsd:string ;
    rdfs:label "CommitShort" ;
    rdfs:comment "First 7 characters of CommitHash for display and git checkout." .

effortless-ntwf:componentId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UIComponents ;
    rdfs:range xsd:string ;
    rdfs:label "ComponentId" ;
    rdfs:comment "Unique slug (e.g. comp-01-distortion-badge)." .

effortless-ntwf:componentName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UIComponents ;
    rdfs:range xsd:string ;
    rdfs:label "ComponentName" ;
    rdfs:comment "Code-level component name (PascalCase, e.g. DistortionBadge)." .

effortless-ntwf:componentType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InstrumentSpec ;
    rdfs:range xsd:string ;
    rdfs:label "ComponentType" ;
    rdfs:comment "input | derived | classification | adapter-requirement" .

effortless-ntwf:conclusionId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "ConclusionId" ;
    rdfs:comment "Unique slug (e.g. conc-01-paradox-is-derived)." .

effortless-ntwf:conditioningRisk a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariables ;
    rdfs:range xsd:string ;
    rdfs:label "ConditioningRisk" ;
    rdfs:comment "The causal hazard posed by conditioning on this variable. Values: confounder (safe to condition — removes bias), mediator (conditioning blocks the causal path of interest — harmful), collider (conditioning opens a spurious backdoor — harmful), proxy (conditioning on a noisy proxy of the true confounder — risky), none (no conditioning risk identified). NULL means unclassified." .

effortless-ntwf:confidenceLevel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Researchers ;
    rdfs:range xsd:string ;
    rdfs:label "ConfidenceLevel" ;
    rdfs:comment "high | medium | unverified — matches deep-research vote outcome." .

effortless-ntwf:configId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SweepStudyConfig ;
    rdfs:range xsd:string ;
    rdfs:label "ConfigId" ;
    rdfs:comment "Unique slug; mirrors StudyId." .

effortless-ntwf:confirmedCausalRoleCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "ConfirmedCausalRoleCount" ;
    rdfs:comment "Count of StratumVariables in this study whose CausalRole is \"confounder\" — includes variables that confound the outcome regardless of whether allocation was balanced." .

effortless-ntwf:confounderIdentity a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:ConfounderIdentities ;
    rdfs:label "ConfounderIdentity" .

effortless-ntwf:confounderIdentityCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "ConfounderIdentityCount" ;
    rdfs:comment "Canonical ConfounderIdentity archetypes in ontology (loop-80)." .

effortless-ntwf:confounderIdentityId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConfounderIdentities ;
    rdfs:range xsd:string ;
    rdfs:label "ConfounderIdentityId" ;
    rdfs:comment "Unique slug (e.g. id-age-composition)." .

effortless-ntwf:confounderLatentOnlyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "ConfounderLatentOnlyCount" ;
    rdfs:comment "Latent-only flip count among confounder-labeled studies." .

effortless-ntwf:confounderSignFlipCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "ConfounderSignFlipCount" ;
    rdfs:comment "Sign-flip count among confounder-labeled studies." .

effortless-ntwf:confoundersInStudy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "ConfoundersInStudy" ;
    rdfs:comment "Count of StratumVariables in this study whose IsConfounder = TRUE. When > 0, the paradox has a causal explanation." .

effortless-ntwf:confoundingVariable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Studies ;
    rdfs:range xsd:string ;
    rdfs:label "ConfoundingVariable" ;
    rdfs:comment "Lookup: StratumVariables.VariableName for this study — the named stratifying variable." .

effortless-ntwf:contestedOrMediatorExplainedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "ContestedOrMediatorExplainedCount" ;
    rdfs:comment "Count of contested or mediator sign-flip rows where IsParadoxExplained=TRUE (should be zero)." .

effortless-ntwf:contestedStratumCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "ContestedStratumCount" ;
    rdfs:comment "Count of StratumVariables in this study whose CausalRole is contested — the causal interpretation is disputed." .

effortless-ntwf:controlDomain a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Studies ;
    rdfs:range xsd:string ;
    rdfs:label "ControlDomain" ;
    rdfs:comment "Domain slug for control studies (e.g. medicine-rct, education-higher). NULL for non-control studies." .

effortless-ntwf:controlFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusBalance ;
    rdfs:range xsd:decimal ;
    rdfs:label "ControlFraction" ;
    rdfs:comment "ControlStudyCount / TotalStudyCount. Fixed loop-90 (see TotalStudyCount); returns 0 for the degenerate empty-corpus edge instead of \"\" (see TreatmentRankings.DistortionRatio for why IF(x=0,\"\",...) is unsafe on a numeric-typed field)." .

effortless-ntwf:controlStudyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusBalance ;
    rdfs:range xsd:integer ;
    rdfs:label "ControlStudyCount" ;
    rdfs:comment "Studies where IsControlStudy=TRUE. Fixed loop-90 (see TotalStudyCount)." .

effortless-ntwf:coreConcern a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ResearchTraditions ;
    rdfs:range xsd:string ;
    rdfs:label "CoreConcern" ;
    rdfs:comment "The central question this tradition asks about the paradox." .

effortless-ntwf:corpusCellCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IngestionSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "CorpusCellCount" ;
    rdfs:comment "Total CaseCell rows. Fixed loop-90 (see ProtocolItemCount)." .

effortless-ntwf:corpusPassesIngestionContract a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:boolean ;
    rdfs:label "CorpusPassesIngestionContract" ;
    rdfs:comment "Lookup: IngestionSummary.IngestionContractPasses." .

effortless-ntwf:corpusPatternSupersededFailCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "CorpusPatternSupersededFailCount" ;
    rdfs:comment "Count of DiscoveryFindings rows for the 6 superseded-pattern hypotheses (H-econ-zero, H-domain-dist, H-catalog-flip-prediction, H-domain-flip-geometry-controlled, H-econ-encoding-selection, H-domain-profiles-stable) where IsConfirmed=FALSE. Six separate COUNTIFS summed with '+' because this rulebook's formula vocabulary has no IN-list/pipe-delimited OR criterion for COUNTIFS (loop-90 native promotion of the former 02b hand function)." .

effortless-ntwf:correctedGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "CorrectedGap" ;
    rdfs:comment "The allocation-corrected treatment gap: WeightedStratumGapSum, i.e. what SignedPooledGap would be if allocation were equal across strata. Positive means A is favoured in the corrected world; negative means B is favoured." .

effortless-ntwf:correctedGapConstant a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SweepStudySummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "CorrectedGapConstant" ;
    rdfs:comment "Principled materialization (refresh_sweep_study_summary(), 03b/05b customize SQL). The allocation-free corrected gap for this study = MINIFS(AllocationSweep[SweepCorrectedGap], AllocationSweep[StudyId], SweepStudyId). Upstream (AllocationSweep, SweepStudyConfig) is sealed/stable per build; recomputing this per-row via nested calc_* calls was measured to fan out to 22.5s for a 242-study corpus scan with zero memoization — materialized here instead of left as a live calculated field. See MaterializedEntities." .

effortless-ntwf:correctedGapInvariantFailCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "CorrectedGapInvariantFailCount" ;
    rdfs:comment "Count of SweepStudySummary rows where SweepCorrectedGapRange >= 0.0001." .

effortless-ntwf:correctedPolicyImplication a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:string ;
    rdfs:label "CorrectedPolicyImplication" ;
    rdfs:comment "The allocation-aware researcher action: what to do when the corrected verdict is available. Derived from DistortionType and CorrectedWinner together, making the instrument self-consistent with Reversal Recovery (loop-27). Type A (full sign-flip, unanimous per-stratum reversal): CorrectedWinner is the true signal — 'use-corrected-winner'. The pooled analysis was directionally wrong; act on CorrectedWinner, not PooledWinner. Type B (partial sign-flip, non-unanimous): CorrectedWinner points against the pooled signal but strata disagree among themselves — 'use-corrected-winner-with-caution'. Trust the corrected direction but acknowledge residual uncertainty. Type C (compression, no sign flip): PooledWinner is directionally correct; the distortion is in the magnitude, not the direction — 'check-allocation-bias'. Same as PolicyImplication. Type D (neutral): allocation is not materially distorting the signal — 'pooled-analysis-trustworthy'. Same as PolicyImplication. For Types C and D, CorrectedPolicyImplication and PolicyImplication always agree; for Types A and B, CorrectedPolicyImplication supersedes PolicyImplication with the allocation-corrected verdict." .

effortless-ntwf:correctedVsPooledAgreement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:boolean ;
    rdfs:label "CorrectedVsPooledAgreement" ;
    rdfs:comment "TRUE when the allocation-corrected winner matches the pooled winner. FALSE when removing allocation bias would change which treatment appears to win — the machine-readable definition of a reversal recovery." .

effortless-ntwf:correctedWinner a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "CorrectedWinner" .

effortless-ntwf:crossZeroCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "CrossZeroCount" ;
    rdfs:comment "Studies whose pooled gap crosses zero under allocation sweep." .

effortless-ntwf:currentImportedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DomainExpansionTargets ;
    rdfs:range xsd:integer ;
    rdfs:label "CurrentImportedCount" ;
    rdfs:comment "Real studies in corpus matching LegacyDomainAlias (or Domain when no alias)." .

effortless-ntwf:dangerTierCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "DangerTierCount" ;
    rdfs:comment "Studies where TreatmentRankings.ScreeningTier = DANGER — pooled sign is wrong (DistortionType A or B)." .

effortless-ntwf:dataAcquisitionStatus a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:string ;
    rdfs:label "DataAcquisitionStatus" ;
    rdfs:comment "not_started | downloaded | manual_only | blocked" .

effortless-ntwf:dataReadyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusCatalogSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "DataReadyCount" ;
    rdfs:comment "Candidates with IsDataReady=TRUE." .

effortless-ntwf:dataSourceNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:string ;
    rdfs:label "DataSourceNote" ;
    rdfs:comment "Where to find cell counts and encoding notes." .

effortless-ntwf:dataType a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DataType" .

effortless-ntwf:description a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Description" .

effortless-ntwf:discoveryWitnessNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:string ;
    rdfs:label "DiscoveryWitnessNote" ;
    rdfs:comment "Research sweep synthesis rollup (loops 61–66)." .

effortless-ntwf:displayName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DisplayName" .

effortless-ntwf:distortionOnlyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "DistortionOnlyCount" ;
    rdfs:comment "Number of studies with real allocation distortion but no sign flip: TypeCCount. The pooled winner is correct but the effect size is biased. Distinct from ZeroStrengthCount, which conflates Type-C (real distortion) with Type-D (neutral)." .

effortless-ntwf:distortionRatio a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "DistortionRatio" ;
    rdfs:comment "SignedPooledGap / WeightedStratumGapSum. Promoted loop-90 from a 03b-customize-views.sql presentation-layer bolt-on to a first-class rulebook field. The IF(x=0,\"\",...) blank-on-zero-denominator idiom used elsewhere in this rulebook is unsafe here: NULLIF is not a supported transpiler function, and the transpiler's translation of the \"\" branch for a numeric-typed field is a bare ''::numeric cast that errors at runtime the moment a live row actually hits it (4 of 242 TreatmentRankings rows have WeightedStratumGapSum=0). Returns 0 in that case instead — WeightedStratumGapSum=0 means there is no equal-weight baseline signal to compare against, so a 0 ratio (no distortion multiplier) is the defensible convention, not a guess." .

effortless-ntwf:distortionTaxonomyCoverage a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:string ;
    rdfs:label "DistortionTaxonomyCoverage" ;
    rdfs:comment "Human-readable summary of the four-type distribution: e.g. 'A:2 B:1 C:1 D:0'. The model's self-portrait of its own distortion geometry." .

effortless-ntwf:distortionType a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "DistortionType" .

effortless-ntwf:distortionTypeLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SweepStudySummary ;
    rdfs:range xsd:string ;
    rdfs:label "DistortionTypeLabel" ;
    rdfs:comment "DistortionType for this study (A, B, C, or D) — provides context for what the sweep should show." .

effortless-ntwf:domain a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Domain" .

effortless-ntwf:domainCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IdentityClusterSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "DomainCount" ;
    rdfs:comment "Distinct Studies.Domain values in cluster." .

effortless-ntwf:domainDiversityNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:string ;
    rdfs:label "DomainDiversityNote" ;
    rdfs:comment "Human-readable domain breakdown. Witnesses corpus diversity — a prerequisite for cross-domain SignalPurity claims. Retyped loop-90 (see RealStudyCount); TEXT(...,\"0%\") is not a supported transpiler function, replaced with ROUND(x*100,0) + literal '%'." .

effortless-ntwf:domainFlipGapSurvivesGeometryControl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:boolean ;
    rdfs:label "DomainFlipGapSurvivesGeometryControl" ;
    rdfs:comment "TRUE when the economics-vs-epidemiology sign-flip-rate gap for H-domain-flip-geometry-controlled survives after restricting to high-imbalance studies (loop-90 native promotion of the former 02b hand function)." .

effortless-ntwf:domainId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusDomains ;
    rdfs:range xsd:string ;
    rdfs:label "DomainId" ;
    rdfs:comment "Unique slug (matches CandidateStudyCatalog.Domain for expansion wave)." .

effortless-ntwf:domainQuestion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Loops ;
    rdfs:range xsd:string ;
    rdfs:label "DomainQuestion" ;
    rdfs:comment "The natural-language question this loop's concept answers FROM the domain data." .

effortless-ntwf:domainTargetId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DomainExpansionTargets ;
    rdfs:range xsd:string ;
    rdfs:label "DomainTargetId" ;
    rdfs:comment "Unique slug." .

effortless-ntwf:driftDirection a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConfounderDistortionTimeline ;
    rdfs:range xsd:string ;
    rdfs:label "DriftDirection" ;
    rdfs:comment "rising | falling | flat | single-decade -- compares this ConfounderIdentity's earliest-decade TypeDFraction to its latest-decade TypeDFraction across the whole table (same value on every row for a given ConfounderIdentity by construction)." .

effortless-ntwf:economicsExpectedAMismatchRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "EconomicsExpectedAMismatchRate" ;
    rdfs:comment "Fraction of expansion-wave-1 economics Expected-A imports observed as Type D." .

effortless-ntwf:economicsHighImbalanceSignFlipCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "EconomicsHighImbalanceSignFlipCount" ;
    rdfs:comment "Sign-flip count among economics studies with max_stratum_imbalance >= threshold." .

effortless-ntwf:economicsSignFlipCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "EconomicsSignFlipCount" ;
    rdfs:comment "Sign-flip count in economics domain." .

effortless-ntwf:economicsSignFlipRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "EconomicsSignFlipRate" ;
    rdfs:comment "Manifest sign-flip rate among economics studies." .

effortless-ntwf:economicsStudyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "EconomicsStudyCount" ;
    rdfs:comment "Real economics studies in corpus." .

effortless-ntwf:educationAvgDistortion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "EducationAvgDistortion" ;
    rdfs:comment "Mean AllocationDistortion in education studies." .

effortless-ntwf:educationLatentDCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "EducationLatentDCount" ;
    rdfs:comment "Education Type-D studies with LatentFlipPotential." .

effortless-ntwf:educationLatentFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "EducationLatentFraction" ;
    rdfs:comment "Fraction of education Type-D studies with LatentFlipPotential=TRUE." .

effortless-ntwf:educationTypeDCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "EducationTypeDCount" ;
    rdfs:comment "Type-D studies in education domain." .

effortless-ntwf:encodePipelineReadyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusCatalogSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "EncodePipelineReadyCount" ;
    rdfs:comment "Candidates both data-ready and encode-ready." .

effortless-ntwf:entityTable a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MaterializedEntities ;
    rdfs:range xsd:string ;
    rdfs:label "EntityTable" ;
    rdfs:comment "The rulebook table whose fields are materialized (e.g. SweepStudySummary)." .

effortless-ntwf:epidemiologyAvgDistortion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "EpidemiologyAvgDistortion" ;
    rdfs:comment "Mean AllocationDistortion in epidemiology studies." .

effortless-ntwf:epidemiologyHighImbalanceSignFlipRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "EpidemiologyHighImbalanceSignFlipRate" ;
    rdfs:comment "Sign-flip rate among high-imbalance epidemiology studies." .

effortless-ntwf:epidemiologyStudyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "EpidemiologyStudyCount" ;
    rdfs:comment "Real published studies in the epidemiology domain. Retyped loop-90 (see RealStudyCount)." .

effortless-ntwf:epistemicTier a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiscoveryHypotheses ;
    rdfs:range xsd:string ;
    rdfs:label "EpistemicTier" ;
    rdfs:comment "consistency-check (definition-linked regression) | corpus-hypothesis (contingent corpus pattern)" .

effortless-ntwf:era a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ResearchTraditions ;
    rdfs:range xsd:string ;
    rdfs:label "Era" ;
