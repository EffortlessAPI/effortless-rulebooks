effortless-ntwf:identityLatestTypeDFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConfounderDistortionTimeline ;
    rdfs:range xsd:decimal ;
    rdfs:label "IdentityLatestTypeDFraction" ;
    rdfs:comment "TypeDFraction of this ConfounderIdentity's latest decade cell -- the end point for the drift comparison." .

effortless-ntwf:identityMapCoverageRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "IdentityMapCoverageRate" ;
    rdfs:comment "Fraction of real-study StratumVariables with a ConfounderIdentity map (loop-81 customize SQL)." .

