effortless-ntwf:phaseWitnessNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:PhaseDiagramSummary ;
    rdfs:range xsd:string ;
    rdfs:label "PhaseWitnessNote" ;
    rdfs:comment "PASS/FAIL summary for taxonomy completeness." .

effortless-ntwf:pioneeringResearcher a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Methodology ;
    rdfs:range xsd:string ;
    rdfs:label "PioneeringResearcher" ;
    rdfs:comment "FK → Researchers.ResearcherId. The researcher most associated with developing or popularising this methodological principle in the Simpson's Paradox context." .

effortless-ntwf:pioneeringResearcherAffiliation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Methodology ;
    rdfs:range xsd:string ;
    rdfs:label "PioneeringResearcherAffiliation" ;
    rdfs:comment "Lookup: Researchers.Affiliation via PioneeringResearcher." .

effortless-ntwf:pioneeringResearcherName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Methodology ;
    rdfs:range xsd:string ;
    rdfs:label "PioneeringResearcherName" ;
    rdfs:comment "Lookup: Researchers.Name via PioneeringResearcher." .

effortless-ntwf:planSourceSection a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusDomains ;
    rdfs:range xsd:string ;
    rdfs:label "PlanSourceSection" ;
    rdfs:comment "Section heading in corpus-expansion-plan.md." .

effortless-ntwf:policyDefault a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConfounderIdentities ;
    rdfs:range xsd:string ;
    rdfs:label "PolicyDefault" ;
    rdfs:comment "Default analytic policy for this confounding archetype." .

effortless-ntwf:policyImplication a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "PolicyImplication" .

effortless-ntwf:pooledGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "PooledGap" ;
    rdfs:comment "Absolute difference between the two pooled rates: |PooledRateA - PooledRateB|. The size of the aggregate misleading signal." .

effortless-ntwf:pooledGapCrossesZero a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "PooledGapCrossesZero" .

effortless-ntwf:pooledRateA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "PooledRateA" ;
    rdfs:comment "Pooled success rate for TreatmentA: TotalSuccessesA / TotalCasesA." .

effortless-ntwf:pooledRateB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "PooledRateB" ;
    rdfs:comment "Pooled success rate for TreatmentB: TotalSuccessesB / TotalCasesB." .

effortless-ntwf:pooledRateFromWeightsA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "PooledRateFromWeightsA" ;
    rdfs:comment "Pooled rate for TreatmentA reconstructed as a weighted average of stratum rates: SUM(WeightedStratumRate) across all stratum rows for TreatmentA. Must match PooledRateA — this witnesses the mechanism equation: the pooled rate IS a weighted average of stratum rates, weighted by StratumFraction." .

effortless-ntwf:pooledRateFromWeightsB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "PooledRateFromWeightsB" ;
    rdfs:comment "Pooled rate for TreatmentB reconstructed as a weighted average. Must match PooledRateB. If it does, the mechanism equation is verified: reversal is purely a consequence of differential weighting." .

effortless-ntwf:pooledSuccessRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Treatments ;
    rdfs:range xsd:decimal ;
    rdfs:label "PooledSuccessRate" ;
    rdfs:comment "Pooled (across all strata) success rate for this treatment: TotalSuccesses / TotalCases." .

effortless-ntwf:pooledWinner a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:string ;
    rdfs:label "PooledWinner" ;
    rdfs:comment "Which treatment wins when strata are ignored. Returns tie when pooled rates are equal within floating-point tolerance." .

effortless-ntwf:primaryConclusion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UIScreens ;
    rdfs:range xsd:string ;
    rdfs:label "PrimaryConclusion" ;
    rdfs:comment "FK → Conclusions.ConclusionId. The conclusion this screen most directly visualises or communicates to the user." .

effortless-ntwf:primaryConclusionEvidence a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UIScreens ;
    rdfs:range xsd:string ;
    rdfs:label "PrimaryConclusionEvidence" ;
    rdfs:comment "Lookup: Conclusions.Evidence via PrimaryConclusion." .

effortless-ntwf:primaryConclusionTitle a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UIScreens ;
    rdfs:range xsd:string ;
    rdfs:label "PrimaryConclusionTitle" ;
    rdfs:comment "Lookup: Conclusions.Title via PrimaryConclusion." .

effortless-ntwf:primaryEntity a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "PrimaryEntity" .

effortless-ntwf:primaryResearcherAffiliation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Studies ;
    rdfs:range xsd:string ;
    rdfs:label "PrimaryResearcherAffiliation" ;
    rdfs:comment "Lookup: Researchers.Affiliation via PrimaryResearcherId." .

effortless-ntwf:primaryResearcherId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Studies ;
    rdfs:range xsd:string ;
    rdfs:label "PrimaryResearcherId" ;
    rdfs:comment "FK → Researchers.ResearcherId. The researcher most associated with first surfacing or canonically citing this study in the Simpson's Paradox literature." .

effortless-ntwf:primaryResearcherName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Studies ;
    rdfs:range xsd:string ;
    rdfs:label "PrimaryResearcherName" ;
    rdfs:comment "Lookup: Researchers.Name via PrimaryResearcherId." .

effortless-ntwf:primaryVenue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ResearchTraditions ;
    rdfs:range xsd:string ;
    rdfs:label "PrimaryVenue" ;
    rdfs:comment "Where this tradition publishes (journal, conference, book series)." .

effortless-ntwf:priority a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:integer ;
    rdfs:label "Priority" ;
    rdfs:comment "1=high priority encode next; 5=blocked/duplicate." .

effortless-ntwf:projectedCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DomainExpansionTargets ;
    rdfs:range xsd:integer ;
    rdfs:label "ProjectedCount" ;
    rdfs:comment "Current + queued candidates." .

effortless-ntwf:proposedStudyId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:string ;
    rdfs:label "ProposedStudyId" ;
    rdfs:comment "Stable slug to assign in Studies when imported." .

effortless-ntwf:protectsConclusion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "ProtectsConclusion" ;
    rdfs:comment "FK → Conclusions.ConclusionId. The conclusion whose witness depends on this invariant holding. If this invariant fails, that conclusion is undermined." .

effortless-ntwf:protectsConclusionCategory a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "ProtectsConclusionCategory" ;
    rdfs:comment "Lookup: Conclusions.Category via ProtectsConclusion." .

effortless-ntwf:protectsConclusionTitle a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "ProtectsConclusionTitle" ;
    rdfs:comment "Lookup: Conclusions.Title via ProtectsConclusion." .

effortless-ntwf:protocolId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IngestionProtocol ;
    rdfs:range xsd:string ;
    rdfs:label "ProtocolId" ;
    rdfs:comment "Unique slug for this contract item." .

effortless-ntwf:protocolItemCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IngestionSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "ProtocolItemCount" ;
    rdfs:comment "Total contract items. Fixed loop-90: COUNTIFS(...,\"<>\") mistranslates to a literal '<>' string-equality filter (a known transpiler bug) instead of IS NOT NULL, always returning 0; replaced with bare COUNT(), which transpiles correctly." .

effortless-ntwf:publicationYear a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "PublicationYear" .

effortless-ntwf:purityTrapFlag a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:boolean ;
    rdfs:label "PurityTrapFlag" ;
    rdfs:comment "TRUE when SignalPurity >= 0.90 AND the study's confounder identity has PolicyDefault IN ('do-not-condition','do-not-naively-adjust'). Marks the purity trap: data appears cleanest where naive stratification is most harmful." .

effortless-ntwf:purpose a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UIScreens ;
    rdfs:range xsd:string ;
    rdfs:label "Purpose" ;
    rdfs:comment "One sentence: what a user can learn or do on this screen." .

effortless-ntwf:readyToEncodeCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "ReadyToEncodeCount" .

effortless-ntwf:realFullyCompliantCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IngestionSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "RealFullyCompliantCount" ;
    rdfs:comment "Real studies with IngestionCompliance=all." .

effortless-ntwf:realStudyCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "RealStudyCount" .

effortless-ntwf:refreshContract a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MaterializedEntities ;
    rdfs:range xsd:string ;
    rdfs:label "RefreshContract" ;
    rdfs:comment "eager-on-write | on-demand | scheduled — when the refresh function is invoked relative to writes on the upstream data." .

effortless-ntwf:refreshFunction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MaterializedEntities ;
    rdfs:range xsd:string ;
    rdfs:label "RefreshFunction" ;
    rdfs:comment "The SQL function (in the customize-* override files) that recomputes this entity's materialized fields from its upstream SSoT tables." .

effortless-ntwf:registeredInLoop a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiscoveryHypotheses ;
    rdfs:range xsd:string ;
    rdfs:label "RegisteredInLoop" ;
    rdfs:comment "LoopId where this hypothesis was registered." .

effortless-ntwf:relationToHannanPearl a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Researchers ;
    rdfs:range xsd:string ;
    rdfs:label "RelationToHannanPearl" ;
    rdfs:comment "How this researcher's line of work relates to or differs from Hannan (aggregation bias) and Pearl (DAG/do-calculus)." .

effortless-ntwf:reportTier a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "ReportTier" ;
    rdfs:comment "critical | supporting | transient — controls how much space this conclusion gets in the generated PDF/summary report. critical = full section with evidence + chart; supporting = 1-2 line bullet; transient = folded into a single compact list." .

effortless-ntwf:requiredFields a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "RequiredFields" .

effortless-ntwf:requirementStatement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IngestionProtocol ;
    rdfs:range xsd:string ;
    rdfs:label "RequirementStatement" ;
    rdfs:comment "Plain-English statement of the requirement." .

effortless-ntwf:researcherAffiliation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "ResearcherAffiliation" ;
    rdfs:comment "Lookup: Researchers.Affiliation via ResearcherId." .

effortless-ntwf:researcherCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ResearchTraditions ;
    rdfs:range xsd:integer ;
    rdfs:label "ResearcherCount" ;
    rdfs:comment "Count of researchers in this tradition." .

effortless-ntwf:researcherId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ResearcherId" .

effortless-ntwf:researcherName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "ResearcherName" ;
    rdfs:comment "Lookup: Researchers.Name via ResearcherId." .

effortless-ntwf:reversalCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "ReversalCount" ;
    rdfs:comment "Number of studies with IsReversal=TRUE (sign-flip / allocation-driven reversal)." .

effortless-ntwf:reversalIntensity a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "ReversalIntensity" ;
    rdfs:comment "StrataWonByLoser / StratumCount: the fraction of strata that go against the pooled winner. Zero for no paradox, 1.0 for full reversal, between 0 and 1 for partial. This is the allocation-side measure of how deeply the confounding has penetrated the stratified view." .

effortless-ntwf:reversalMechanism a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:string ;
    rdfs:label "ReversalMechanism" ;
    rdfs:comment "Plain-language reversal mechanism from expansion plan." .

effortless-ntwf:route a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UIScreens ;
    rdfs:range xsd:string ;
    rdfs:label "Route" ;
    rdfs:comment "URL path pattern (e.g. /, /study/:studyId, /compare)." .

effortless-ntwf:rowDescription a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StudyImportTemplate ;
    rdfs:range xsd:string ;
    rdfs:label "RowDescription" ;
    rdfs:comment "What rows to create." .

effortless-ntwf:ruleType a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IngestionProtocol ;
    rdfs:range xsd:string ;
    rdfs:label "RuleType" ;
    rdfs:comment "required-input | structural | inclusion | exclusion | adapter-metadata" .

effortless-ntwf:safeTierCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "SafeTierCount" ;
    rdfs:comment "Studies where TreatmentRankings.ScreeningTier = SAFE — pooling is trustworthy (DistortionType D)." .

effortless-ntwf:screenId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UIScreens ;
    rdfs:range xsd:string ;
    rdfs:label "ScreenId" ;
    rdfs:comment "Unique slug (e.g. screen-01-study-list)." .

effortless-ntwf:screeningTier a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:string ;
    rdfs:label "ScreeningTier" ;
    rdfs:comment "DANGER when DistortionType is A or B, CAUTION when C+/C-, SAFE when D. Promoted loop-90 (see DistortionRatio)." .

effortless-ntwf:selectionFrailtyManifestFlipCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "SelectionFrailtyManifestFlipCount" ;
    rdfs:comment "Manifest flip count for selection-frailty identity." .

effortless-ntwf:selectionFrailtyStudyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "SelectionFrailtyStudyCount" ;
    rdfs:comment "Study count for selection-frailty identity cluster." .

effortless-ntwf:severity a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "Severity" ;
    rdfs:comment "critical | warning — critical means any FailCount > 0 is a build-breaking bug." .

effortless-ntwf:severityDriftDirection a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:string ;
    rdfs:label "SeverityDriftDirection" ;
    rdfs:comment "loop-92: ConfounderDistortionTimeline.DriftDirection for id-disease-severity (severity-case-mix archetype), valid-time Type-D drift. Overridden in 02b-customize-functions.sql: native transpiler mistranslates LOOKUP(constant, Table[NonPKColumn], Table[TargetColumn]) into a lookup keyed on the table's PK instead of the specified match column." .

effortless-ntwf:severityEpiManifestFlipCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "SeverityEpiManifestFlipCount" ;
    rdfs:comment "Severity identity manifest flip count in epidemiology domain." .

effortless-ntwf:severityIdentityLatentFractionAmongTypeD a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "SeverityIdentityLatentFractionAmongTypeD" ;
    rdfs:comment "Type-D latent fraction for id-disease-severity cluster (loop-81)." .

effortless-ntwf:severityMedicineManifestFlipRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "SeverityMedicineManifestFlipRate" ;
    rdfs:comment "Severity identity manifest flip rate in medicine domain." .

effortless-ntwf:signFlipCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConfounderDistortionTimeline ;
    rdfs:range xsd:integer ;
    rdfs:label "SignFlipCount" ;
    rdfs:comment "Of those, count with TreatmentRankings.IsSignFlip = TRUE." .

effortless-ntwf:signFlipFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConfounderDistortionTimeline ;
    rdfs:range xsd:decimal ;
    rdfs:label "SignFlipFraction" ;
    rdfs:comment "SignFlipCount / StudyCount." .

effortless-ntwf:signFlipPredictionEligibleCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusCatalogSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "SignFlipPredictionEligibleCount" ;
    rdfs:comment "Imported rows where ExpectedDistortionType was A or B." .

effortless-ntwf:signFlipPredictionMatch a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:boolean ;
    rdfs:label "SignFlipPredictionMatch" ;
    rdfs:comment "TRUE when Expected A∪B and observed is A∪B — weaker flip-type prediction test." .

effortless-ntwf:signFlipPredictionMatchCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusCatalogSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "SignFlipPredictionMatchCount" ;
    rdfs:comment "Expected A∪B rows where observed type is also A∪B." .

effortless-ntwf:signFlipPredictionMatchRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "SignFlipPredictionMatchRate" .

effortless-ntwf:signFlipSignalPurityMax a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "SignFlipSignalPurityMax" ;
    rdfs:comment "Maximum SignalPurity among sign-flip studies. Must stay below 0.5 for the signal-purity theorem." .

effortless-ntwf:signalPurity a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "SignalPurity" .

effortless-ntwf:signalPurityGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "SignalPurityGap" ;
    rdfs:comment "Separation between reversal and non-reversal average SignalPurity. The larger this gap, the more discriminating the threshold at 0.5. Retyped loop-90 (see RealStudyCount)." .

effortless-ntwf:signatureWork a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Researchers ;
    rdfs:range xsd:string ;
    rdfs:label "SignatureWork" ;
    rdfs:comment "The canonical paper or book most associated with their contribution." .

effortless-ntwf:signedPooledGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "SignedPooledGap" ;
    rdfs:comment "Signed difference between pooled rates: PooledRateA minus PooledRateB. Positive = A wins pooled; negative = B wins pooled. Unlike PooledGap (which is absolute), this preserves direction — essential for detecting sign flips between the equal-weight and actual pooled signals." .

effortless-ntwf:simpsonStudyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusBalance ;
    rdfs:range xsd:integer ;
    rdfs:label "SimpsonStudyCount" ;
    rdfs:comment "Studies where IsControlStudy=FALSE. Fixed loop-90 (see TotalStudyCount)." .

effortless-ntwf:situationalDriftDirection a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:string ;
    rdfs:label "SituationalDriftDirection" ;
    rdfs:comment "loop-92: ConfounderDistortionTimeline.DriftDirection for id-situational-context (sports-situation archetype), valid-time Type-D drift. Overridden in 02b-customize-functions.sql: native transpiler mistranslates LOOKUP(constant, Table[NonPKColumn], Table[TargetColumn]) into a lookup keyed on the table's PK instead of the specified match column." .

effortless-ntwf:socioeconomicDriftDirection a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:string ;
    rdfs:label "SocioeconomicDriftDirection" ;
    rdfs:comment "loop-92: ConfounderDistortionTimeline.DriftDirection for id-socioeconomic-status (ses-income archetype), valid-time Type-D drift. Overridden in 02b-customize-functions.sql: native transpiler mistranslates LOOKUP(constant, Table[NonPKColumn], Table[TargetColumn]) into a lookup keyed on the table's PK instead of the specified match column." .

effortless-ntwf:sortOrder a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "SortOrder" .

effortless-ntwf:source a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Studies ;
    rdfs:range xsd:string ;
    rdfs:label "Source" ;
    rdfs:comment "Citation or description of the original data source." .

effortless-ntwf:sourceTable a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SourceTable" .

effortless-ntwf:sourceUrl a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SourceUrl" .

effortless-ntwf:specId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InstrumentSpec ;
    rdfs:range xsd:string ;
    rdfs:label "SpecId" ;
    rdfs:comment "Unique identifier for this instrument component." .

effortless-ntwf:sportsHighImbalanceSignFlipRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "SportsHighImbalanceSignFlipRate" ;
    rdfs:comment "Sign-flip rate among high-imbalance sports studies." .

effortless-ntwf:sportsLatentDCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "SportsLatentDCount" ;
    rdfs:comment "Sports Type-D studies with LatentFlipPotential." .

effortless-ntwf:sportsLatentFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "SportsLatentFraction" ;
    rdfs:comment "Fraction of sports Type-D studies with LatentFlipPotential=TRUE." .

effortless-ntwf:sportsTypeDCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "SportsTypeDCount" ;
    rdfs:comment "Type-D studies in sports domain." .

effortless-ntwf:sqlAssertion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "SqlAssertion" ;
    rdfs:comment "The SQL WHERE clause (without WHERE keyword) that counts PASSING rows from vw_treatment_rankings for this invariant. Used by run_invariant_checks() to evaluate each assertion dynamically from the rulebook table." .

effortless-ntwf:sqlFilter a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "SqlFilter" ;
    rdfs:comment "Optional SQL WHERE clause that selects the universe of rows in scope for this invariant (e.g. distortion_type = 'D'). Empty string means all rows." .

effortless-ntwf:stableTypeDCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "StableTypeDCount" ;
    rdfs:comment "Type-D studies without latent flip potential (allocation-stable at observed and counterfactual sweep)." .

effortless-ntwf:statement a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Statement" .

effortless-ntwf:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Status" .

effortless-ntwf:statusLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:string ;
    rdfs:label "StatusLabel" ;
    rdfs:comment "PASS or FAIL(n) summary for display." .

effortless-ntwf:strataWonByA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "StrataWonByA" ;
    rdfs:comment "Number of strata where A wins: count StratumSummaries rows whose TreatmentLabel=TreatmentA AND StratumWinner=TreatmentA. These are the one-per-stratum sentinel rows." .

effortless-ntwf:strataWonByB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "StrataWonByB" ;
    rdfs:comment "Number of strata where B wins: count StratumSummaries rows whose TreatmentLabel=TreatmentA AND StratumWinner=TreatmentB." .

effortless-ntwf:strataWonByLoser a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "StrataWonByLoser" ;
    rdfs:comment "Number of strata won by the pooled loser — the counter-signal. For full reversals this equals StratumCount; for partial paradoxes it is between 0 and StratumCount." .

effortless-ntwf:stratumCases a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "StratumCases" ;
    rdfs:comment "Total cases in this (stratum, treatment) cell for this study." .

effortless-ntwf:stratumCasesA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "StratumCasesA" ;
    rdfs:comment "Cases for treatment A in this (study, stratum)." .

effortless-ntwf:stratumCasesB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "StratumCasesB" ;
    rdfs:comment "Cases for treatment B in this (study, stratum)." .

effortless-ntwf:stratumCausalRole a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:string ;
    rdfs:label "StratumCausalRole" ;
    rdfs:comment "Lookup: StratumVariables.CausalRole for this study — confounder, mediator, collider, selection, contested, etc." .

effortless-ntwf:stratumCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "StratumCount" ;
    rdfs:comment "Number of strata in this study. Counted from StratumSummaries filtered to TreatmentA rows (one row per stratum)." .

effortless-ntwf:stratumCountEstimate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:integer ;
    rdfs:label "StratumCountEstimate" ;
    rdfs:comment "Expected number of strata (minimum 2)." .

effortless-ntwf:stratumFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "StratumFraction" ;
    rdfs:comment "Fraction of the study's total cases that fall in this stratum: StratumTotalCases / StudyTotalCases. The weight the confounder assigns to each stratum. A large StratumFraction on a low-success stratum pulls the pooled rate down; when that stratum is also over-allocated to one treatment, it creates the reversal." .

effortless-ntwf:stratumGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "StratumGap" ;
    rdfs:comment "Signed rate difference within this stratum: StratumRateA minus StratumRateB. Positive = A wins here; negative = B wins here; zero = tied. When every stratum has StratumGap > 0 but the pooled gap is negative, the contradiction IS Simpson's Paradox made arithmetically visible in one column. Multiply StratumGap × StratumFraction and sum across strata to get the equal-weight pooled gap (the signal allocation would produce without confounding)." .

effortless-ntwf:stratumId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Strata ;
    rdfs:range xsd:string ;
    rdfs:label "StratumId" ;
    rdfs:comment "Unique slug (e.g. kidney-1986-small, kidney-1986-large)." .

effortless-ntwf:stratumLabel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "StratumLabel" .

effortless-ntwf:stratumRateA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "StratumRateA" ;
    rdfs:comment "Success rate for treatment A in this stratum." .

effortless-ntwf:stratumRateB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "StratumRateB" ;
    rdfs:comment "Success rate for treatment B in this stratum." .

effortless-ntwf:stratumSuccessRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "StratumSuccessRate" ;
    rdfs:comment "Success rate within this stratum for this treatment: StratumSuccesses / StratumCases. The true per-stratum picture." .

effortless-ntwf:stratumSuccesses a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "StratumSuccesses" ;
    rdfs:comment "Total successes in this (stratum, treatment) cell for this study." .

effortless-ntwf:stratumSuccessesA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "StratumSuccessesA" ;
    rdfs:comment "Successes for treatment A in this (study, stratum) — used to determine the per-stratum winner." .

effortless-ntwf:stratumSuccessesB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "StratumSuccessesB" ;
    rdfs:comment "Successes for treatment B in this (study, stratum)." .

effortless-ntwf:stratumSummaryId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:string ;
    rdfs:label "StratumSummaryId" ;
    rdfs:comment "Unique slug (e.g. kidney-1986-small-A)." .

effortless-ntwf:stratumTotalCases a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "StratumTotalCases" ;
    rdfs:comment "Total cases in this stratum across both treatments (A + B combined). Numerator for StratumFraction." .

effortless-ntwf:stratumVariable a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:StratumVariableIdentityMaps ;
    rdfs:range effortless-ntwf:StratumVariables ;
    rdfs:label "StratumVariable" ;
    rdfs:comment "FK → StratumVariables." .

effortless-ntwf:stratumVariableId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariables ;
    rdfs:range xsd:string ;
    rdfs:label "StratumVariableId" ;
    rdfs:comment "Unique slug (e.g. kidney-1986-stone-size)." .

effortless-ntwf:stratumVariableName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:string ;
    rdfs:label "StratumVariableName" ;
    rdfs:comment "Pre-registered stratifying variable name for encoding." .

effortless-ntwf:stratumWinner a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:string ;
    rdfs:label "StratumWinner" ;
    rdfs:comment "Which treatment wins in this stratum: 'A' if StratumRateA > StratumRateB, else 'B'. Used by TreatmentRankings to detect paradox." .

effortless-ntwf:structuralCompliantCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IngestionSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "StructuralCompliantCount" ;
    rdfs:comment "Studies with IngestionCellParity." .

effortless-ntwf:study a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Studies ;
    rdfs:label "Study" .

effortless-ntwf:studyCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "StudyCount" .

effortless-ntwf:studyDomain a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:string ;
    rdfs:label "StudyDomain" ;
    rdfs:comment "Lookup: Studies.Domain via Study." .

effortless-ntwf:studyId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "StudyId" .

effortless-ntwf:studyTotalCases a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "StudyTotalCases" ;
    rdfs:comment "Total cases across ALL strata and ALL treatments in this study. The denominator for StratumFraction." .

effortless-ntwf:successes a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CaseCells ;
    rdfs:range xsd:integer ;
    rdfs:label "Successes" ;
    rdfs:comment "Number of patients in this cell who had a successful outcome. RAW INPUT — never derived." .

effortless-ntwf:sumAllocationDistortion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConfounderDistortionTimeline ;
    rdfs:range xsd:decimal ;
    rdfs:label "SumAllocationDistortion" ;
    rdfs:comment "Sum of TreatmentRankings.AllocationDistortion across cell studies (numerator for MeanAllocationDistortion)." .

effortless-ntwf:sumPooledGapLatentD a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "SumPooledGapLatentD" ;
    rdfs:comment "SUM(PooledGap) among Type-D studies with latent flip potential — a bare, unwrapped SUMIFS split out as its own field because nesting a cross-table SUMIFS/AVERAGEIFS as an operand inside another IF/division expression transpiles with a mangled WHERE-clause column alias (e.g. rankings_latent_flip_potential) that errors at runtime; a bare top-level SUMIFS transpiles correctly (loop-90)." .

effortless-ntwf:sumPooledGapStableD a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "SumPooledGapStableD" ;
    rdfs:comment "SUM(PooledGap) among allocation-stable Type-D studies — split out as a bare field for the same reason as SumPooledGapLatentD." .

effortless-ntwf:sumSignalPurity a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConfounderDistortionTimeline ;
    rdfs:range xsd:decimal ;
    rdfs:label "SumSignalPurity" ;
    rdfs:comment "Sum of TreatmentRankings.SignalPurity across cell studies (numerator for MeanSignalPurity; summed rather than pre-averaged so the aggregate survives refresh re-runs without drift)." .

effortless-ntwf:supportingConclusion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ResearchTraditions ;
    rdfs:range xsd:string ;
    rdfs:label "SupportingConclusion" ;
    rdfs:comment "FK → Conclusions.ConclusionId. The conclusion in this model that most directly validates or advances this tradition's central claim about Simpson's Paradox." .

effortless-ntwf:supportingConclusionCategory a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ResearchTraditions ;
    rdfs:range xsd:string ;
    rdfs:label "SupportingConclusionCategory" ;
    rdfs:comment "Lookup: Conclusions.Category via SupportingConclusion." .

effortless-ntwf:supportingConclusionTitle a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ResearchTraditions ;
    rdfs:range xsd:string ;
    rdfs:label "SupportingConclusionTitle" ;
    rdfs:comment "Lookup: Conclusions.Title via SupportingConclusion." .

effortless-ntwf:sweepCorrectedGap a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "SweepCorrectedGap" .

effortless-ntwf:sweepCorrectedGapMax a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "SweepCorrectedGapMax" .

effortless-ntwf:sweepCorrectedGapMin a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "SweepCorrectedGapMin" .

effortless-ntwf:sweepCorrectedGapRange a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "SweepCorrectedGapRange" .

effortless-ntwf:sweepFragileCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "SweepFragileCount" ;
    rdfs:comment "Count of TreatmentRankings with IsSweepFragile=TRUE." .

effortless-ntwf:sweepId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AllocationSweep ;
    rdfs:range xsd:string ;
    rdfs:label "SweepId" ;
    rdfs:comment "Unique row identifier: <study>-f<pct> where pct is AllocFractionA*100." .

effortless-ntwf:sweepPooledGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AllocationSweep ;
    rdfs:range xsd:decimal ;
    rdfs:label "SweepPooledGap" ;
    rdfs:comment "SweepPooledRateA minus SweepPooledRateB. Wanders as AllocFractionA varies because pooled rates mix stratum sizes unequally. Crosses zero at some allocation (the paradox reversal point)." .

effortless-ntwf:sweepPooledGapMax a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SweepStudySummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "SweepPooledGapMax" ;
    rdfs:comment "Principled materialization (refresh_sweep_study_summary()). Maximum SweepPooledGap across all allocation fractions for this study = MAXIFS(AllocationSweep[SweepPooledGap], AllocationSweep[StudyId], SweepStudyId). See CorrectedGapConstant for why this is materialized rather than calculated." .

effortless-ntwf:sweepPooledGapMin a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SweepStudySummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "SweepPooledGapMin" ;
    rdfs:comment "Principled materialization (refresh_sweep_study_summary()). Minimum SweepPooledGap across all allocation fractions for this study = MINIFS(AllocationSweep[SweepPooledGap], AllocationSweep[StudyId], SweepStudyId). See CorrectedGapConstant for why this is materialized rather than calculated." .

effortless-ntwf:sweepPooledGapRange a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "SweepPooledGapRange" .

effortless-ntwf:sweepPooledRateA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AllocationSweep ;
    rdfs:range xsd:decimal ;
    rdfs:label "SweepPooledRateA" ;
    rdfs:comment "Pooled success rate for treatment A = (NSweepA * SweepRateA + NFixedA * FixedRateA) / (NSweepA + NFixedA). Changes as AllocFractionA varies." .

effortless-ntwf:sweepPooledRateB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:AllocationSweep ;
    rdfs:range xsd:decimal ;
    rdfs:label "SweepPooledRateB" ;
    rdfs:comment "Pooled success rate for treatment B = (NSweepB * SweepRateB + NFixedB * FixedRateB) / (NSweepB + NFixedB). Changes as AllocFractionA varies." .

effortless-ntwf:sweepRateA a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "SweepRateA" .

effortless-ntwf:sweepRateB a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "SweepRateB" .

effortless-ntwf:sweepStratumLabel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "SweepStratumLabel" .

effortless-ntwf:sweepStudyId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:SweepStudySummary ;
    rdfs:range xsd:string ;
    rdfs:label "SweepStudyId" ;
    rdfs:comment "FK to Studies.StudyId. One row per study in the AllocationSweep." .

effortless-ntwf:symmetryDeparture a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "SymmetryDeparture" ;
    rdfs:comment "ABS(ArmSizeRatio - 0.5) — how far the case allocation departs from a balanced 50/50 split. Promoted loop-90 (see DistortionRatio)." .

effortless-ntwf:syntheticPhaseCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "SyntheticPhaseCount" ;
    rdfs:comment "Number of parameter grid points in SyntheticPhase. Refreshed from vw_phase_diagram_summary by 05b-customize-data.sql." .

effortless-ntwf:targetLoop a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "TargetLoop" ;
    rdfs:comment "LoopId that is designed to witness this conclusion (if status=planned)." .

effortless-ntwf:targetMinCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DomainExpansionTargets ;
    rdfs:range xsd:integer ;
    rdfs:label "TargetMinCount" ;
    rdfs:comment "Minimum real studies desired in this domain." .

effortless-ntwf:targetTable a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "TargetTable" .

effortless-ntwf:templateStepId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StudyImportTemplate ;
    rdfs:range xsd:string ;
    rdfs:label "TemplateStepId" ;
    rdfs:comment "Unique slug." .

effortless-ntwf:theoremCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "TheoremCount" ;
    rdfs:comment "Count of witnessed Conclusions with Category=corpus-theorem (portfolio rollup for loop-76; category renamed from theorem in loop-91)." .

effortless-ntwf:thresholdMargin a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "ThresholdMargin" ;
    rdfs:comment "ReversalIntensity minus 0.5: positive when more than half the strata go against the pooled winner (reversal is robust), zero at the tipping point (exactly half), negative when fewer than half oppose the pooled winner (reversal is fragile or absent). A study with ThresholdMargin > 0 is robustly paradoxical; one with ThresholdMargin < 0 has a weak or absent paradox." .

effortless-ntwf:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Title" .

effortless-ntwf:totalCases a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "TotalCases" .

effortless-ntwf:totalCasesA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "TotalCasesA" ;
    rdfs:comment "Total cases for TreatmentA across all strata in this study." .

effortless-ntwf:totalCasesB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "TotalCasesB" ;
    rdfs:comment "Total cases for TreatmentB across all strata." .

effortless-ntwf:totalCasesForTreatment a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CaseCells ;
    rdfs:range xsd:integer ;
    rdfs:label "TotalCasesForTreatment" ;
    rdfs:comment "Total cases across ALL strata for this treatment in this study — the denominator for TreatmentExposureFraction." .

effortless-ntwf:totalCatalogEntries a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusCatalogSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "TotalCatalogEntries" ;
    rdfs:comment "All catalog rows. Fixed loop-90 (see IngestionSummary.ProtocolItemCount for why COUNTIFS(...,\"<>\") is unsafe)." .

effortless-ntwf:totalParadoxStrength a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "TotalParadoxStrength" ;
    rdfs:comment "Sum of ParadoxStrength across all studies. Used to compute average." .

effortless-ntwf:totalStudyCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusBalance ;
    rdfs:range xsd:integer ;
    rdfs:label "TotalStudyCount" ;
    rdfs:comment "Total studies in corpus (Simpson + control). Fixed loop-90: was authored with COUNTA/bareword refs and an uppercase Formula key, which the transpiler cannot parse. COUNTIFS(...,\"<>\") also mistranslates (known transpiler bug: literal '<>' string instead of IS NOT NULL), so this is expressed as SimpsonStudyCount + ControlStudyCount instead." .

effortless-ntwf:totalSuccesses a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Treatments ;
    rdfs:range xsd:integer ;
    rdfs:label "TotalSuccesses" ;
    rdfs:comment "Total successes for this treatment across all strata." .

effortless-ntwf:totalSuccessesA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "TotalSuccessesA" ;
    rdfs:comment "Total successes for TreatmentA across all strata." .

effortless-ntwf:totalSuccessesB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "TotalSuccessesB" ;
    rdfs:comment "Total successes for TreatmentB across all strata." .

effortless-ntwf:traditionCoreConern a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "TraditionCoreConern" .

effortless-ntwf:traditionEra a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Researchers ;
    rdfs:range xsd:string ;
    rdfs:label "TraditionEra" ;
    rdfs:comment "Lookup: ResearchTraditions.Era via TraditionId." .

effortless-ntwf:traditionId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "TraditionId" .

effortless-ntwf:traditionKeyClaimSummary a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "TraditionKeyClaimSummary" .

effortless-ntwf:traditionName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "TraditionName" .

effortless-ntwf:traditionPrimaryVenue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Methodology ;
    rdfs:range xsd:string ;
    rdfs:label "TraditionPrimaryVenue" ;
    rdfs:comment "Lookup: ResearchTraditions.PrimaryVenue via TraditionId." .

effortless-ntwf:treatmentA a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:string ;
    rdfs:label "TreatmentA" ;
    rdfs:comment "Label for the first treatment in the comparison (matches Treatments.TreatmentLabel)." .

effortless-ntwf:treatmentACasesHere a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "TreatmentACasesHere" ;
    rdfs:comment "Cases for treatment A in this stratum — used to compute TreatmentA's allocation fraction in this stratum." .

effortless-ntwf:treatmentATotalCases a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "TreatmentATotalCases" ;
    rdfs:comment "Total cases for treatment A across all strata in this study — denominator for AllocationFractionA." .

effortless-ntwf:treatmentB a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:string ;
    rdfs:label "TreatmentB" ;
    rdfs:comment "Label for the second treatment in the comparison." .

effortless-ntwf:treatmentBCasesHere a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "TreatmentBCasesHere" ;
    rdfs:comment "Cases for treatment B in this stratum — used to compute TreatmentB's allocation fraction in this stratum." .

effortless-ntwf:treatmentBTotalCases a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:integer ;
    rdfs:label "TreatmentBTotalCases" ;
    rdfs:comment "Total cases for treatment B across all strata in this study — denominator for AllocationFractionB." .

effortless-ntwf:treatmentExposureFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CaseCells ;
    rdfs:range xsd:decimal ;
    rdfs:label "TreatmentExposureFraction" ;
    rdfs:comment "Fraction of this treatment's total cases that fall in this stratum: Cases / TotalCasesForTreatment. High imbalance across strata is the mechanism of confounding — when treatments are allocated very differently across strata, the pooled rate conflates treatment effect with stratum difficulty." .

effortless-ntwf:treatmentId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Treatments ;
    rdfs:range xsd:string ;
    rdfs:label "TreatmentId" ;
    rdfs:comment "Unique slug (e.g. kidney-1986-A, kidney-1986-B)." .

effortless-ntwf:treatmentLabel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "TreatmentLabel" .

effortless-ntwf:treatmentRankingId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:string ;
    rdfs:label "TreatmentRankingId" ;
    rdfs:comment "Unique slug (e.g. kidney-1986-A-vs-B)." .

effortless-ntwf:typeACount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "TypeACount" ;
    rdfs:comment "Studies classified as Type-A: sign flip AND full reversal (ReversalIntensity=1). The canonical Simpson's Paradox — allocation distortion reverses the pooled winner." .

effortless-ntwf:typeAFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "TypeAFraction" ;
    rdfs:comment "Fraction of studies that are Type-A (full canonical reversals). TypeACount / StudyCount." .

effortless-ntwf:typeBCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "TypeBCount" ;
    rdfs:comment "Studies classified as Type-B: sign flip but partial reversal (ReversalIntensity<1). Allocation distortion creates a sign flip but the pooled signal partially reflects per-stratum reality." .

effortless-ntwf:typeCMinusCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "TypeCMinusCount" ;
    rdfs:comment "Studies classified as Type-C-: sign flip with attenuation. Pooled effect understates or masks the true per-stratum effect." .

effortless-ntwf:typeCPlusCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "TypeCPlusCount" ;
    rdfs:comment "Studies classified as Type-C+: sign flip with amplification (ReversalIntensity>1). Pooled effect overstates the true per-stratum effect." .

effortless-ntwf:typeDAvgDistortion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "TypeDAvgDistortion" ;
    rdfs:comment "Mean AllocationDistortion among Type-D studies." .

effortless-ntwf:typeDCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "TypeDCount" .

effortless-ntwf:typeDFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ConfounderDistortionTimeline ;
    rdfs:range xsd:decimal ;
    rdfs:label "TypeDFraction" ;
    rdfs:comment "TypeDCount / StudyCount." .

effortless-ntwf:typePredictionMatch a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CandidateStudyCatalog ;
    rdfs:range xsd:boolean ;
    rdfs:label "TypePredictionMatch" ;
    rdfs:comment "TRUE when observed type matches expected (imported rows only)." .

effortless-ntwf:typePredictionMatchCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "TypePredictionMatchCount" .

effortless-ntwf:typePredictionMatchRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "TypePredictionMatchRate" .

effortless-ntwf:typePredictionMismatchCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "TypePredictionMismatchCount" .

effortless-ntwf:unanimousSignFlipCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "UnanimousSignFlipCount" ;
    rdfs:comment "Sign-flip studies with unanimous stratum direction (IsSignFlip AND IsStratumUnanimous)." .

effortless-ntwf:unexplainedConfounderSignFlipCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "UnexplainedConfounderSignFlipCount" ;
    rdfs:comment "Confounder sign-flips with IsParadoxExplained=FALSE — must be 0 for explained↔confounder theorem." .

effortless-ntwf:universeCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:InvariantChecks ;
    rdfs:range xsd:integer ;
    rdfs:label "UniverseCount" ;
    rdfs:comment "Total rows in scope (PassCount + FailCount)." .

effortless-ntwf:unknownCausalRoleCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:integer ;
    rdfs:label "UnknownCausalRoleCount" ;
    rdfs:comment "Count of StratumVariables in this study whose CausalRole is unknown — no causal account has been established." .

effortless-ntwf:unmappedStratumVariableCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "UnmappedStratumVariableCount" ;
    rdfs:comment "Stratum variables lacking identity map (should be 0)." .

effortless-ntwf:upstreamTables a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:MaterializedEntities ;
    rdfs:range xsd:string ;
    rdfs:label "UpstreamTables" ;
    rdfs:comment "Comma-separated list of the tables this materialization is derived from — its sealed/stable upstream." .

effortless-ntwf:usedOnScreens a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UIComponents ;
    rdfs:range xsd:string ;
    rdfs:label "UsedOnScreens" ;
    rdfs:comment "Comma-separated ScreenIds where this component appears." .

effortless-ntwf:userAction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UIScreens ;
    rdfs:range xsd:string ;
    rdfs:label "UserAction" ;
    rdfs:comment "Primary user action available on this screen (e.g. select a study, drill into a stratum)." .

effortless-ntwf:validCellCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IngestionSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "ValidCellCount" ;
    rdfs:comment "Valid CaseCells." .

effortless-ntwf:validTimeDecade a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "ValidTimeDecade" .

effortless-ntwf:validTimeEnd a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Studies ;
    rdfs:range xsd:integer ;
    rdfs:label "ValidTimeEnd" ;
    rdfs:comment "Last year of the real-world cohort period this study's data covers (valid-time, not publication year). Defaults to PublicationYear when the true cohort window is not independently known." .

effortless-ntwf:validTimeMidpoint a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Studies ;
    rdfs:range xsd:decimal ;
    rdfs:label "ValidTimeMidpoint" ;
    rdfs:comment "Midpoint year of the valid-time cohort window, used to bucket studies by when their underlying data actually occurred rather than when the paper was published." .

effortless-ntwf:validTimeStart a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Studies ;
    rdfs:range xsd:integer ;
    rdfs:label "ValidTimeStart" ;
    rdfs:comment "First year of the real-world cohort period this study's data covers (valid-time, not publication year). Defaults to PublicationYear when the true cohort window is not independently known." .

effortless-ntwf:validatingHypothesis a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "ValidatingHypothesis" ;
    rdfs:comment "FK → DiscoveryHypotheses.HypothesisId. The pre-registered hypothesis whose live DiscoveryFindings.IsConfirmed value is the current-truth check for this conclusion — set on theorem/corpus-theorem conclusions so a report can distinguish a conclusion's archived prose (may say 'Proved') from its live status (may since be contradicted by corpus growth). Null when no single hypothesis tests this exact claim." .

effortless-ntwf:variableName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariables ;
    rdfs:range xsd:string ;
    rdfs:label "VariableName" ;
    rdfs:comment "The name of the stratifying variable (e.g. stone_size, department, age_group)." .

effortless-ntwf:variableNameNormalized a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumVariableIdentityMaps ;
    rdfs:range xsd:string ;
    rdfs:label "VariableNameNormalized" ;
    rdfs:comment "Lowercase normalized variable token for dedup audit." .

effortless-ntwf:verifiedByDeepResearch a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "VerifiedByDeepResearch" .

effortless-ntwf:visualSpec a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:UIComponents ;
    rdfs:range xsd:string ;
    rdfs:label "VisualSpec" ;
    rdfs:comment "Plain-English description of the visual output: shape, color coding, interactivity." .

effortless-ntwf:weightedStratumGap a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "WeightedStratumGap" ;
    rdfs:comment "StratumGap × StratumFraction: the contribution of this stratum's treatment-rate difference to the equal-weight pooled gap. Summing WeightedStratumGap across all TreatmentA rows for a study gives WeightedStratumGapSum — the pooled gap the study would show under balanced allocation. This is the per-stratum building block of the sign-flip test." .

effortless-ntwf:weightedStratumGapSum a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:TreatmentRankings ;
    rdfs:range xsd:decimal ;
    rdfs:label "WeightedStratumGapSum" ;
    rdfs:comment "Sum of WeightedStratumGap (= StratumGap × StratumFraction) across all StratumSummaries rows where TreatmentLabel = TreatmentA for this study. This is the equal-weight pooled gap — the gap the pooled analysis would produce if allocation were perfectly balanced across strata. When this has the opposite sign to SignedPooledGap, the allocation has not merely compressed the signal: it has flipped it entirely." .

effortless-ntwf:weightedStratumRate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:StratumSummaries ;
    rdfs:range xsd:decimal ;
    rdfs:label "WeightedStratumRate" ;
    rdfs:comment "StratumFraction × StratumSuccessRate. The contribution of this (stratum, treatment) row to the study-level pooled rate. Summing WeightedStratumRate across all strata for a given treatment reconstructs that treatment's pooled rate from stratum weights — witnessing the mechanism equation." .

effortless-ntwf:whyItMatters a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Methodology ;
    rdfs:range xsd:string ;
    rdfs:label "WhyItMatters" ;
    rdfs:comment "Why this step or principle is load-bearing for this model — what breaks if you skip it." .

effortless-ntwf:witnessedInLoop a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessedInLoop" .

effortless-ntwf:witnessedInLoopCommitDate a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessedInLoopCommitDate" ;
    rdfs:comment "Lookup: Loops.CommitDate via WitnessedInLoop." .

effortless-ntwf:witnessedInLoopCommitHash a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessedInLoopCommitHash" ;
    rdfs:comment "Lookup: Loops.CommitHash via WitnessedInLoop — git checkout this SHA to replay the instrument state when this conclusion was first witnessed." .

effortless-ntwf:witnessedInLoopCommitShort a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessedInLoopCommitShort" ;
    rdfs:comment "Lookup: Loops.CommitShort via WitnessedInLoop." .

effortless-ntwf:witnessedInLoopGitTag a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessedInLoopGitTag" ;
    rdfs:comment "Lookup: Loops.GitTag via WitnessedInLoop — preferred replay entry point when a milestone tag exists." .

effortless-ntwf:witnessedInLoopTitle a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Conclusions ;
    rdfs:range xsd:string ;
    rdfs:label "WitnessedInLoopTitle" ;
    rdfs:comment "Lookup: Loops.Title via WitnessedInLoop." .

