    rdfs:label "Formula" ;
    rdfs:comment "The ERB formula or derivation rule for this component." .

effortless-ntwf:gapCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DomainExpansionTargets ;
    rdfs:range xsd:integer ;
    rdfs:label "GapCount" ;
    rdfs:comment "Studies still needed to hit target after queued imports." .

effortless-ntwf:geographicDriftDirection a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:string ;
    rdfs:label "GeographicDriftDirection" ;
    rdfs:comment "loop-92: ConfounderDistortionTimeline.DriftDirection for id-geographic-composition (geography archetype), valid-time Type-D drift. Overridden in 02b-customize-functions.sql: native transpiler mistranslates LOOKUP(constant, Table[NonPKColumn], Table[TargetColumn]) into a lookup keyed on the table's PK instead of the specified match column." .

effortless-ntwf:geographicTypeDFraction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "GeographicTypeDFraction" ;
    rdfs:comment "Type-D fraction for geographic-composition identity." .

effortless-ntwf:gitTag a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Loops ;
    rdfs:range xsd:string ;
    rdfs:label "GitTag" ;
    rdfs:comment "Optional milestone tag pointing at this loop's landing commit (sp-loop-milestone-*). Used for discovery replay without memorizing SHAs." .

effortless-ntwf:highImbalanceSignFlipThreshold a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:decimal ;
    rdfs:label "HighImbalanceSignFlipThreshold" ;
    rdfs:comment "max_stratum_imbalance cutoff for geometry-controlled domain screening (loop-66). Set from corpus median by customize SQL." .

effortless-ntwf:highPriorityCount a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:CorpusCatalogSummary ;
    rdfs:range xsd:integer ;
    rdfs:label "HighPriorityCount" ;
    rdfs:comment "Candidates with Priority <= 2." .

effortless-ntwf:hypothesisId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "HypothesisId" .

effortless-ntwf:hypothesisStatement a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DiscoveryFindings ;
    rdfs:range xsd:string ;
    rdfs:label "HypothesisStatement" ;
    rdfs:comment "Lookup: DiscoveryHypotheses.Statement." .

effortless-ntwf:identityClusterId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:IdentityClusterSummaries ;
    rdfs:range xsd:string ;
    rdfs:label "IdentityClusterId" ;
    rdfs:comment "Unique slug; one row per ConfounderIdentity cluster." .

effortless-ntwf:identityClusterWitnessNote a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:ModelSummary ;
    rdfs:range xsd:string ;
