            CONSTRUCT {
                $this effortless-ntwf:evidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DiscoveryFindings .
    OPTIONAL { $this effortless-ntwf:isConfirmed ?is_confirmed . }
    OPTIONAL { $this effortless-ntwf:observedMetric ?observed_metric . OPTIONAL { ?observed_metric erb:key ?observed_metric__key . } }
                BIND(IF(COALESCE((COALESCE(?is_confirmed, false) = true), false), CONCAT("PASS: ", COALESCE(COALESCE(?observed_metric__key, IF(isIRI(?observed_metric), REPLACE(STR(?observed_metric), "^.*[#/]", ""), STR(?observed_metric))), "")), IF(COALESCE((COALESCE(?is_confirmed, false) = false), false), CONCAT("FAIL: ", COALESCE(COALESCE(?observed_metric__key, IF(isIRI(?observed_metric), REPLACE(STR(?observed_metric), "^.*[#/]", ""), STR(?observed_metric))), "")), "")) AS ?_result)
            }
        """ ;
    ] .
# Rule for ObservedMetric - parse error: Expected TokenType.RPAREN, got TokenType.EOF at position 8286

# === Rules for DiscoveryHypotheses ===
effortless-ntwf-shapes:DiscoveryHypotheses_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DiscoveryHypotheses ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DiscoveryHypotheses_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DiscoveryHypotheses .
    OPTIONAL { $this effortless-ntwf:hypothesisId ?hypothesis_id . }
                BIND(?hypothesis_id AS ?_result)
            }
        """ ;
    ] .

# === Rules for DomainExpansionTargets ===
effortless-ntwf-shapes:DomainExpansionTargets_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DomainExpansionTargets ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DomainExpansionTargets_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DomainExpansionTargets .
    OPTIONAL { $this effortless-ntwf:domainTargetId ?domain_target_id . }
                BIND(?domain_target_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DomainExpansionTargets_CurrentImportedCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DomainExpansionTargets ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DomainExpansionTargets_CurrentImportedCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:currentImportedCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DomainExpansionTargets .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:DomainExpansionTargets .
                    ?child a effortless-ntwf:Studies .
                    OPTIONAL { ?child effortless-ntwf:domain ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { $this effortless-ntwf:domain ?domain . }
                    OPTIONAL { $this effortless-ntwf:legacyDomainAlias ?legacy_domain_alias . OPTIONAL { ?legacy_domain_alias erb:key ?legacy_domain_alias__key . } }
                    BIND(IF(COALESCE((COALESCE(?legacy_domain_alias__key, COALESCE(IF(isIRI(?legacy_domain_alias), REPLACE(STR(?legacy_domain_alias), "^.*[#/]", ""), STR(?legacy_domain_alias)), "")) != ""), false), ?legacy_domain_alias, ?domain) AS ?p0)
                    OPTIONAL { ?p0 erb:key ?p0__key . }
                    OPTIONAL { ?child effortless-ntwf:isSynthetic ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?c0__key, STR(?c0)) = COALESCE(?p0__key, STR(?p0)))
                    FILTER(BOUND(?c2) && ?c2 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DomainExpansionTargets_CandidateQueuedCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DomainExpansionTargets ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DomainExpansionTargets_CandidateQueuedCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:candidateQueuedCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DomainExpansionTargets .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:DomainExpansionTargets .
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    ?child effortless-ntwf:domain ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:domain ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:ingestionStatus ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "candidate"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DomainExpansionTargets_ProjectedCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DomainExpansionTargets ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DomainExpansionTargets_ProjectedCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:projectedCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DomainExpansionTargets .
    OPTIONAL { $this effortless-ntwf:candidateQueuedCount ?candidate_queued_count . }
    OPTIONAL { $this effortless-ntwf:currentImportedCount ?current_imported_count . }
                BIND(ROUND((?current_imported_count + ?candidate_queued_count)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DomainExpansionTargets_GapCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DomainExpansionTargets ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DomainExpansionTargets_GapCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:gapCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DomainExpansionTargets .
    OPTIONAL { $this effortless-ntwf:projectedCount ?projected_count . }
    OPTIONAL { $this effortless-ntwf:targetMinCount ?target_min_count . }
                BIND(ROUND(IF((0) > ((?target_min_count - ?projected_count)), (0), ((?target_min_count - ?projected_count)))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DomainExpansionTargets_IsUnderRepresented a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DomainExpansionTargets ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DomainExpansionTargets_IsUnderRepresented" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isUnderRepresented ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DomainExpansionTargets .
    OPTIONAL { $this effortless-ntwf:projectedCount ?projected_count . }
    OPTIONAL { $this effortless-ntwf:targetMinCount ?target_min_count . }
                BIND((COALESCE(?projected_count, 0) < COALESCE(?target_min_count, 0)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for IdentityClusterSummaries ===
effortless-ntwf-shapes:IdentityClusterSummaries_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IdentityClusterSummaries ;
