    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:StratumVariables .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:causalRole ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "confounder"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_MediatorRiskCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_MediatorRiskCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:mediatorRiskCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:StratumVariables .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:conditioningRisk ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "mediator"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_lhs)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg2) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:StratumVariables .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:conditioningRisk ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "collider"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg2, 0) AS ?_rhs)
    BIND(?_lhs + ?_rhs AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_ContestedStratumCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_ContestedStratumCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:contestedStratumCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:StratumVariables .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:causalRole ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "contested"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_UnknownCausalRoleCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_UnknownCausalRoleCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:unknownCausalRoleCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:StratumVariables .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:causalRole ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "unknown"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_CausalClaimStatus a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_CausalClaimStatus" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:causalClaimStatus ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:confirmedCausalRoleCount ?confirmed_causal_role_count . }
    OPTIONAL { $this effortless-ntwf:contestedStratumCount ?contested_stratum_count . }
    OPTIONAL { $this effortless-ntwf:unknownCausalRoleCount ?unknown_causal_role_count . }
                BIND(IF(COALESCE((COALESCE(?contested_stratum_count, 0) > 0), false), "contested", IF(COALESCE((COALESCE(?unknown_causal_role_count, 0) > 0), false), "geometric-only", IF(COALESCE((COALESCE(?confirmed_causal_role_count, 0) > 0), false), "established", "geometric-only"))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_AdjustmentAppropriate a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_AdjustmentAppropriate" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:adjustmentAppropriate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:causalClaimStatus ?causal_claim_status . OPTIONAL { ?causal_claim_status erb:key ?causal_claim_status__key . } }
    OPTIONAL { $this effortless-ntwf:mediatorRiskCount ?mediator_risk_count . }
                BIND((COALESCE((COALESCE(?mediator_risk_count, 0) = 0), false) && COALESCE((COALESCE(?causal_claim_status__key, COALESCE(IF(isIRI(?causal_claim_status), REPLACE(STR(?causal_claim_status), "^.*[#/]", ""), STR(?causal_claim_status)), "")) = "established"), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_DistortionRatio a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_DistortionRatio" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:distortionRatio ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:signedPooledGap ?signed_pooled_gap . }
    OPTIONAL { $this effortless-ntwf:weightedStratumGapSum ?weighted_stratum_gap_sum . }
                BIND(IF(COALESCE((COALESCE(?weighted_stratum_gap_sum, 0) = 0), false), 0, xsd:double(?signed_pooled_gap / ?weighted_stratum_gap_sum)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_ScreeningTier a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_ScreeningTier" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:screeningTier ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:distortionType ?distortion_type . OPTIONAL { ?distortion_type erb:key ?distortion_type__key . } }
                BIND(IF(COALESCE((COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "A"), false) || COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "B"), false)), false), "DANGER", IF(COALESCE((COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "C+"), false) || COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "C-"), false)), false), "CAUTION", IF(COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "D"), false), "SAFE", ""))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_ArmSizeRatio a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_ArmSizeRatio" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:armSizeRatio ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:totalCasesA ?total_cases_a . }
    OPTIONAL { $this effortless-ntwf:totalCasesB ?total_cases_b . }
                BIND(IF(COALESCE((COALESCE((?total_cases_a + ?total_cases_b), 0) = 0), false), 0, xsd:double(?total_cases_a / (?total_cases_a + ?total_cases_b))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_SymmetryDeparture a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_SymmetryDeparture" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:symmetryDeparture ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:armSizeRatio ?arm_size_ratio . }
                BIND(ABS((?arm_size_ratio - 0.5)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Treatments ===
effortless-ntwf-shapes:Treatments_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Treatments_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Treatments .
    OPTIONAL { $this effortless-ntwf:treatmentId ?treatment_id . }
                BIND(?treatment_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Treatments_TotalCases a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Treatments_TotalCases" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:totalCases ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Treatments .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:Treatments .
                    ?child a effortless-ntwf:CaseCells .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentLabel ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:cases ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Treatments_TotalSuccesses a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Treatments_TotalSuccesses" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:totalSuccesses ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Treatments .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:Treatments .
                    ?child a effortless-ntwf:CaseCells .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentLabel ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:successes ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Treatments_PooledSuccessRate a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Treatments_PooledSuccessRate" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:pooledSuccessRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Treatments .
    OPTIONAL { $this effortless-ntwf:totalCases ?total_cases . }
    OPTIONAL { $this effortless-ntwf:totalSuccesses ?total_successes . }
                BIND(IF(COALESCE((COALESCE(?total_cases, 0) = 0), false), "", xsd:double(?total_successes / ?total_cases)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for UIComponents ===
effortless-ntwf-shapes:UIComponents_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:UIComponents ;
