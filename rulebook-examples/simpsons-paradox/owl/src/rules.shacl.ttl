        """ ;
    ] .
effortless-ntwf-shapes:IngestionSummary_AllRealStudiesCompliant a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IngestionSummary ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IngestionSummary_AllRealStudiesCompliant" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:allRealStudiesCompliant ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IngestionSummary .
    OPTIONAL { $this effortless-ntwf:realFullyCompliantCount ?real_fully_compliant_count . }
    OPTIONAL { $this effortless-ntwf:realStudyCount ?real_study_count . }
                BIND((COALESCE(?real_fully_compliant_count, 0) = COALESCE(?real_study_count, 0)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IngestionSummary_IngestionContractPasses a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IngestionSummary ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IngestionSummary_IngestionContractPasses" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:ingestionContractPasses ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IngestionSummary .
    OPTIONAL { $this effortless-ntwf:allCellsValid ?all_cells_valid . }
    OPTIONAL { $this effortless-ntwf:allRealStudiesCompliant ?all_real_studies_compliant . }
    OPTIONAL { $this effortless-ntwf:allStudiesStructural ?all_studies_structural . }
                BIND((COALESCE(?all_cells_valid, false) && COALESCE(?all_studies_structural, false) && COALESCE(?all_real_studies_compliant, false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IngestionSummary_IngestionWitnessNote a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IngestionSummary ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IngestionSummary_IngestionWitnessNote" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:ingestionWitnessNote ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IngestionSummary .
    OPTIONAL { $this effortless-ntwf:corpusCellCount ?corpus_cell_count . OPTIONAL { ?corpus_cell_count erb:key ?corpus_cell_count__key . } }
    OPTIONAL { $this effortless-ntwf:ingestionContractPasses ?ingestion_contract_passes . }
    OPTIONAL { $this effortless-ntwf:protocolItemCount ?protocol_item_count . OPTIONAL { ?protocol_item_count erb:key ?protocol_item_count__key . } }
    OPTIONAL { $this effortless-ntwf:realFullyCompliantCount ?real_fully_compliant_count . OPTIONAL { ?real_fully_compliant_count erb:key ?real_fully_compliant_count__key . } }
    OPTIONAL { $this effortless-ntwf:realStudyCount ?real_study_count . OPTIONAL { ?real_study_count erb:key ?real_study_count__key . } }
                BIND(IF(COALESCE(?ingestion_contract_passes, false), CONCAT("PASS: ", COALESCE(COALESCE(?protocol_item_count__key, IF(isIRI(?protocol_item_count), REPLACE(STR(?protocol_item_count), "^.*[#/]", ""), STR(?protocol_item_count))), ""), " contract items; ", COALESCE(COALESCE(?corpus_cell_count__key, IF(isIRI(?corpus_cell_count), REPLACE(STR(?corpus_cell_count), "^.*[#/]", ""), STR(?corpus_cell_count))), ""), " cells valid; ", COALESCE(COALESCE(?real_fully_compliant_count__key, IF(isIRI(?real_fully_compliant_count), REPLACE(STR(?real_fully_compliant_count), "^.*[#/]", ""), STR(?real_fully_compliant_count))), ""), "/", COALESCE(COALESCE(?real_study_count__key, IF(isIRI(?real_study_count), REPLACE(STR(?real_study_count), "^.*[#/]", ""), STR(?real_study_count))), ""), " real studies fully compliant"), "FAIL: ingestion contract violated") AS ?_result)
            }
        """ ;
    ] .

# === Rules for InstrumentSpec ===
effortless-ntwf-shapes:InstrumentSpec_Name a sh:NodeShape ;
