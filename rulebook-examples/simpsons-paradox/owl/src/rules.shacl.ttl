    OPTIONAL { $this effortless-ntwf:allocationBias ?allocation_bias . OPTIONAL { ?allocation_bias erb:key ?allocation_bias__key . } }
                BIND(IF(COALESCE((COALESCE(COALESCE(?allocation_bias__key, COALESCE(IF(isIRI(?allocation_bias), REPLACE(STR(?allocation_bias), "^.*[#/]", ""), STR(?allocation_bias)), "")), 0) = ""), false), "", ABS(?allocation_bias)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumSummaries_AbsStratumGap a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 4 ;
    sh:rule [
