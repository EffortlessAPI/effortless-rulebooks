# === Rules for InvariantChecks ===
effortless-ntwf-shapes:InvariantChecks_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InvariantChecks ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InvariantChecks_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InvariantChecks .
    OPTIONAL { $this effortless-ntwf:invariantCheckId ?invariant_check_id . }
                BIND(?invariant_check_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:InvariantChecks_UniverseCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InvariantChecks ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InvariantChecks_UniverseCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:universeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InvariantChecks .
    OPTIONAL { $this effortless-ntwf:failCount ?fail_count . }
    OPTIONAL { $this effortless-ntwf:passCount ?pass_count . }
                BIND(ROUND((?pass_count + ?fail_count)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:InvariantChecks_IsGreen a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InvariantChecks ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InvariantChecks_IsGreen" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isGreen ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InvariantChecks .
    OPTIONAL { $this effortless-ntwf:failCount ?fail_count . }
                BIND((COALESCE(?fail_count, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:InvariantChecks_StatusLabel a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InvariantChecks ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InvariantChecks_StatusLabel" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:statusLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InvariantChecks .
    OPTIONAL { $this effortless-ntwf:failCount ?fail_count . OPTIONAL { ?fail_count erb:key ?fail_count__key . } }
    OPTIONAL { $this effortless-ntwf:isGreen ?is_green . }
                BIND(IF(COALESCE(?is_green, false), "PASS", CONCAT("FAIL(", COALESCE(COALESCE(?fail_count__key, IF(isIRI(?fail_count), REPLACE(STR(?fail_count), "^.*[#/]", ""), STR(?fail_count))), ""), ")")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:InvariantChecks_TraditionName a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InvariantChecks ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_InvariantChecks_TraditionName" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:traditionName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:InvariantChecks .
                OPTIONAL { $this effortless-ntwf:traditionId ?tradition_id . }
                OPTIONAL { ?j0 a effortless-ntwf:ResearchTraditions ; effortless-ntwf:traditionId ?j1 ; effortless-ntwf:name ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?tradition_id), "^.*[#/]", "")) || (?j0 = ?tradition_id)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:InvariantChecks_TraditionKeyClaimSummary a sh:NodeShape ;
    sh:targetClass effortless-ntwf:InvariantChecks ;
