                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:isSignFlip ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:stratumCausalRole ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child effortless-ntwf:isParadoxExplained ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "confounder"))
                    FILTER(BOUND(?c4) && ?c4 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_TheoremCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_TheoremCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:theoremCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:Conclusions .
                    OPTIONAL { ?child effortless-ntwf:category ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:status ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "corpus-theorem"))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "witnessed"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_EducationLatentFraction a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_EducationLatentFraction" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:educationLatentFraction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg3) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:studyDomain ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:distortionType ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "education"))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "D"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg3, 0) AS ?_guard_count)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:studyDomain ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:distortionType ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child effortless-ntwf:isLatentOnlyFlip ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "education"))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "D"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_lhs)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg2) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:studyDomain ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:distortionType ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "education"))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "D"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg2, 0) AS ?_rhs)
    BIND(IF(BOUND(?_rhs) && ?_rhs != 0, ?_lhs / ?_rhs, 0.0) AS ?_guarded)
    BIND(IF(BOUND(?_guard_count) && ?_guard_count = 0, "", ?_guarded) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_SportsLatentFraction a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_SportsLatentFraction" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:sportsLatentFraction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg3) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:studyDomain ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:distortionType ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "sports"))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "D"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg3, 0) AS ?_guard_count)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:studyDomain ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:distortionType ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child effortless-ntwf:isLatentOnlyFlip ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "sports"))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "D"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_lhs)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg2) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:studyDomain ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:distortionType ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "sports"))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "D"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg2, 0) AS ?_rhs)
    BIND(IF(BOUND(?_rhs) && ?_rhs != 0, ?_lhs / ?_rhs, 0.0) AS ?_guarded)
    BIND(IF(BOUND(?_guard_count) && ?_guard_count = 0, "", ?_guarded) AS ?_result)
            }
        """ ;
    ] .
