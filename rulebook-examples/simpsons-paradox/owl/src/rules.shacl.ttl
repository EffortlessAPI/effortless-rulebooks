            WHERE {
    $this a effortless-ntwf:SweepStudySummary .
                OPTIONAL { $this effortless-ntwf:sweepStudyId ?sweep_study_id . }
                OPTIONAL { ?j0 a effortless-ntwf:SweepStudyConfig ; effortless-ntwf:studyId ?j1 ; effortless-ntwf:sweepStratumLabel ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?sweep_study_id), "^.*[#/]", "")) || (?j0 = ?sweep_study_id)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .

# === Rules for SyntheticPhase ===
effortless-ntwf-shapes:SyntheticPhase_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:phaseId ?phase_id . }
                BIND(?phase_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseS1Total a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseS1Total" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:phaseS1Total ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:paramStratumFraction ?param_stratum_fraction . }
                BIND(ROUND((200 * ?param_stratum_fraction)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseNA1 a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseNA1" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:phaseNA1 ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:paramAllocationBias ?param_allocation_bias . }
    OPTIONAL { $this effortless-ntwf:phaseS1Total ?phase_s1_total . }
                BIND(ROUND((?phase_s1_total * (0.5 + xsd:double(?param_allocation_bias / 2)))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseNB1 a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseNB1" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:phaseNB1 ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:phaseNA1 ?phase_na1 . }
    OPTIONAL { $this effortless-ntwf:phaseS1Total ?phase_s1_total . }
                BIND((?phase_s1_total - ?phase_na1) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseNA2 a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseNA2" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:phaseNA2 ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:phaseNA1 ?phase_na1 . }
                BIND((100 - ?phase_na1) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseNB2 a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseNB2" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:phaseNB2 ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:phaseNB1 ?phase_nb1 . }
                BIND((100 - ?phase_nb1) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseRateA1 a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseRateA1" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:phaseRateA1 ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:paramStratumGap1 ?param_stratum_gap1 . }
                BIND((0.45 + xsd:double(?param_stratum_gap1 / 2)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseRateB1 a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseRateB1" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:phaseRateB1 ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:paramStratumGap1 ?param_stratum_gap1 . }
                BIND((0.45 - xsd:double(?param_stratum_gap1 / 2)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseRateA2 a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseRateA2" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:phaseRateA2 ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:paramStratumGap2 ?param_stratum_gap2 . }
                BIND((0.75 + xsd:double(?param_stratum_gap2 / 2)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseRateB2 a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseRateB2" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:phaseRateB2 ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:paramStratumGap2 ?param_stratum_gap2 . }
                BIND((0.75 - xsd:double(?param_stratum_gap2 / 2)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhasePooledRateA a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhasePooledRateA" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:phasePooledRateA ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:phaseNA1 ?phase_na1 . }
    OPTIONAL { $this effortless-ntwf:phaseNA2 ?phase_na2 . }
    OPTIONAL { $this effortless-ntwf:phaseRateA1 ?phase_rate_a1 . }
    OPTIONAL { $this effortless-ntwf:phaseRateA2 ?phase_rate_a2 . }
                BIND(xsd:double(((?phase_na1 * ?phase_rate_a1) + (?phase_na2 * ?phase_rate_a2)) / 100) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhasePooledRateB a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhasePooledRateB" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:phasePooledRateB ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:phaseNB1 ?phase_nb1 . }
    OPTIONAL { $this effortless-ntwf:phaseNB2 ?phase_nb2 . }
    OPTIONAL { $this effortless-ntwf:phaseRateB1 ?phase_rate_b1 . }
    OPTIONAL { $this effortless-ntwf:phaseRateB2 ?phase_rate_b2 . }
                BIND(xsd:double(((?phase_nb1 * ?phase_rate_b1) + (?phase_nb2 * ?phase_rate_b2)) / 100) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseSignedPooledGap a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseSignedPooledGap" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:phaseSignedPooledGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:phasePooledRateA ?phase_pooled_rate_a . }
    OPTIONAL { $this effortless-ntwf:phasePooledRateB ?phase_pooled_rate_b . }
                BIND((?phase_pooled_rate_a - ?phase_pooled_rate_b) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseCorrectedGap a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseCorrectedGap" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:phaseCorrectedGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:paramStratumFraction ?param_stratum_fraction . }
    OPTIONAL { $this effortless-ntwf:paramStratumGap1 ?param_stratum_gap1 . }
    OPTIONAL { $this effortless-ntwf:paramStratumGap2 ?param_stratum_gap2 . }
                BIND(((?param_stratum_fraction * ?param_stratum_gap1) + ((1 - ?param_stratum_fraction) * ?param_stratum_gap2)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseStrataWonByLoser a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseStrataWonByLoser" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:phaseStrataWonByLoser ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:paramStratumGap1 ?param_stratum_gap1 . }
    OPTIONAL { $this effortless-ntwf:paramStratumGap2 ?param_stratum_gap2 . }
    OPTIONAL { $this effortless-ntwf:phaseSignedPooledGap ?phase_signed_pooled_gap . }
                BIND(IF(COALESCE((COALESCE(?phase_signed_pooled_gap, 0) > 0), false), (IF(COALESCE((COALESCE(?param_stratum_gap1, 0) < 0), false), 1, 0) + IF(COALESCE((COALESCE(?param_stratum_gap2, 0) < 0), false), 1, 0)), (IF(COALESCE((COALESCE(?param_stratum_gap1, 0) > 0), false), 1, 0) + IF(COALESCE((COALESCE(?param_stratum_gap2, 0) > 0), false), 1, 0))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseReversalIntensity a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseReversalIntensity" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:phaseReversalIntensity ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:phaseStrataWonByLoser ?phase_strata_won_by_loser . }
                BIND(xsd:double(?phase_strata_won_by_loser / 2) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseIsSignFlip a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseIsSignFlip" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:phaseIsSignFlip ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:phaseCorrectedGap ?phase_corrected_gap . }
    OPTIONAL { $this effortless-ntwf:phaseSignedPooledGap ?phase_signed_pooled_gap . }
                BIND(IF(COALESCE((COALESCE(?phase_corrected_gap, 0) > 0), false), (COALESCE(?phase_signed_pooled_gap, 0) < 0), (COALESCE(?phase_signed_pooled_gap, 0) > 0)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseAllocationDistortion a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseAllocationDistortion" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:phaseAllocationDistortion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:phaseCorrectedGap ?phase_corrected_gap . }
    OPTIONAL { $this effortless-ntwf:phaseSignedPooledGap ?phase_signed_pooled_gap . }
                BIND(ABS((?phase_corrected_gap - ?phase_signed_pooled_gap)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SyntheticPhase_PhaseDistortionType a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SyntheticPhase ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SyntheticPhase_PhaseDistortionType" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:phaseDistortionType ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SyntheticPhase .
    OPTIONAL { $this effortless-ntwf:phaseAllocationDistortion ?phase_allocation_distortion . }
    OPTIONAL { $this effortless-ntwf:phaseCorrectedGap ?phase_corrected_gap . }
    OPTIONAL { $this effortless-ntwf:phaseIsSignFlip ?phase_is_sign_flip . }
    OPTIONAL { $this effortless-ntwf:phaseReversalIntensity ?phase_reversal_intensity . }
    OPTIONAL { $this effortless-ntwf:phaseSignedPooledGap ?phase_signed_pooled_gap . }
                BIND(IF(COALESCE((COALESCE(?phase_is_sign_flip, false) && COALESCE((COALESCE(?phase_reversal_intensity, 0) = 1), false)), false), "A", IF(COALESCE((COALESCE(?phase_is_sign_flip, false) && COALESCE((COALESCE(?phase_reversal_intensity, 0) < 1), false)), false), "B", IF(COALESCE((COALESCE((!(COALESCE(?phase_is_sign_flip, false))), false) && COALESCE((COALESCE(?phase_allocation_distortion, 0) > 0.01), false) && COALESCE(COALESCE((ABS(?phase_signed_pooled_gap) > (ABS(?phase_corrected_gap) + 0.001)), false), false)), false), "C+", IF(COALESCE((COALESCE((!(COALESCE(?phase_is_sign_flip, false))), false) && COALESCE((COALESCE(?phase_allocation_distortion, 0) > 0.01), false) && COALESCE(COALESCE((ABS(?phase_signed_pooled_gap) < (ABS(?phase_corrected_gap) - 0.001)), false), false)), false), "C-", "D")))) AS ?_result)
            }
        """ ;
    ] .

# === Rules for TreatmentRankings ===
effortless-ntwf-shapes:TreatmentRankings_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:treatmentRankingId ?treatment_ranking_id . }
                BIND(?treatment_ranking_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_TotalCasesA a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_TotalCasesA" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:totalCasesA ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:CaseCells .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentA ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:cases ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_TotalSuccessesA a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_TotalSuccessesA" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:totalSuccessesA ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:CaseCells .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentA ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:successes ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_PooledRateA a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_PooledRateA" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:pooledRateA ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:totalCasesA ?total_cases_a . }
    OPTIONAL { $this effortless-ntwf:totalSuccessesA ?total_successes_a . }
                BIND(IF(COALESCE((COALESCE(?total_cases_a, 0) = 0), false), "", xsd:double(?total_successes_a / ?total_cases_a)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_TotalCasesB a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_TotalCasesB" ;
