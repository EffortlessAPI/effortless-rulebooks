                    OPTIONAL { ?child effortless-ntwf:stratumCausalRole ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "selection"))
                    } GROUP BY $this
