    OPTIONAL { $this effortless-ntwf:pooledGapCrossesZero ?pooled_gap_crosses_zero . }
                BIND(IF(COALESCE((!BOUND(?pooled_gap_crosses_zero)), false), "", (COALESCE((COALESCE(?pooled_gap_crosses_zero, false) = true), false) && COALESCE((COALESCE(?is_sign_flip, false) = false), false))) AS ?_result)
            }
        """ ;
