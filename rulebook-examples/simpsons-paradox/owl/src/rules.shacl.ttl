                OPTIONAL { ?j0 a effortless-ntwf:TreatmentRankings ; effortless-ntwf:study ?j1 ; effortless-ntwf:distortionType ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?sweep_study_id), "^.*[#/]", "")) || (?j0 = ?sweep_study_id)) }
                BIND(?j2 AS ?_result)
