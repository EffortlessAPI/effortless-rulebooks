# === Rules for Strata ===
effortless-ntwf-shapes:Strata_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Strata ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Strata_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Strata .
    OPTIONAL { $this effortless-ntwf:stratumId ?stratum_id . }
                BIND(?stratum_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Strata_TotalCases a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Strata ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Strata_TotalCases" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:totalCases ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Strata .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:Strata .
                    ?child a effortless-ntwf:CaseCells .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:stratumLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:stratumLabel ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:cases ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for StratumSummaries ===
effortless-ntwf-shapes:StratumSummaries_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumSummaries_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumSummaries .
    OPTIONAL { $this effortless-ntwf:stratumSummaryId ?stratum_summary_id . }
                BIND(?stratum_summary_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumSummaries_StratumSuccesses a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumSummaries_StratumSuccesses" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stratumSuccesses ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumSummaries .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:StratumSummaries .
                    ?child a effortless-ntwf:CaseCells .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:stratumLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:stratumLabel ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentLabel ?p4 . OPTIONAL { ?p4 erb:key ?p4__key . } }
                    OPTIONAL { ?child effortless-ntwf:successes ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    FILTER(COALESCE(?c4__key, STR(?c4)) = COALESCE(?p4__key, STR(?p4)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumSummaries_StratumCases a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumSummaries_StratumCases" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stratumCases ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumSummaries .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:StratumSummaries .
                    ?child a effortless-ntwf:CaseCells .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:stratumLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:stratumLabel ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentLabel ?p4 . OPTIONAL { ?p4 erb:key ?p4__key . } }
                    OPTIONAL { ?child effortless-ntwf:cases ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    FILTER(COALESCE(?c4__key, STR(?c4)) = COALESCE(?p4__key, STR(?p4)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumSummaries_StratumSuccessRate a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumSummaries_StratumSuccessRate" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stratumSuccessRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumSummaries .
    OPTIONAL { $this effortless-ntwf:stratumCases ?stratum_cases . }
    OPTIONAL { $this effortless-ntwf:stratumSuccesses ?stratum_successes . }
                BIND(IF(COALESCE((COALESCE(?stratum_cases, 0) = 0), false), "", xsd:double(?stratum_successes / ?stratum_cases)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumSummaries_StratumSuccessesA a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumSummaries_StratumSuccessesA" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:stratumSuccessesA ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumSummaries .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:StratumSummaries .
                    ?child a effortless-ntwf:CaseCells .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:stratumLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:stratumLabel ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    OPTIONAL { ?child effortless-ntwf:successes ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    FILTER((COALESCE(?c4__key, STR(?c4)) = "A"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
