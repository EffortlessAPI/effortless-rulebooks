effortless-ntwf-shapes:ModelSummary_DiscoveryWitnessNote a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 13 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_DiscoveryWitnessNote" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:discoveryWitnessNote ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
    OPTIONAL { $this effortless-ntwf:confounderIdentityCount ?confounder_identity_count . OPTIONAL { ?confounder_identity_count erb:key ?confounder_identity_count__key . } }
    OPTIONAL { $this effortless-ntwf:latentTypeDFraction ?latent_type_d_fraction . OPTIONAL { ?latent_type_d_fraction erb:key ?latent_type_d_fraction__key . } }
    OPTIONAL { $this effortless-ntwf:signFlipSignalPurityMax ?sign_flip_signal_purity_max . OPTIONAL { ?sign_flip_signal_purity_max erb:key ?sign_flip_signal_purity_max__key . } }
    OPTIONAL { $this effortless-ntwf:typePredictionMatchRate ?type_prediction_match_rate . OPTIONAL { ?type_prediction_match_rate erb:key ?type_prediction_match_rate__key . } }
                BIND(CONCAT("sweep: latentD=", COALESCE(COALESCE(?latent_type_d_fraction__key, IF(isIRI(?latent_type_d_fraction), REPLACE(STR(?latent_type_d_fraction), "^.*[#/]", ""), STR(?latent_type_d_fraction))), ""), " purityMax=", COALESCE(COALESCE(?sign_flip_signal_purity_max__key, IF(isIRI(?sign_flip_signal_purity_max), REPLACE(STR(?sign_flip_signal_purity_max), "^.*[#/]", ""), STR(?sign_flip_signal_purity_max))), ""), " catalogExact=", COALESCE(COALESCE(?type_prediction_match_rate__key, IF(isIRI(?type_prediction_match_rate), REPLACE(STR(?type_prediction_match_rate), "^.*[#/]", ""), STR(?type_prediction_match_rate))), ""), " identities=", COALESCE(COALESCE(?confounder_identity_count__key, IF(isIRI(?confounder_identity_count), REPLACE(STR(?confounder_identity_count), "^.*[#/]", ""), STR(?confounder_identity_count))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_TypePredictionMatchCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_TypePredictionMatchCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:typePredictionMatchCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL { ?j0 a effortless-ntwf:CorpusCatalogSummary ; effortless-ntwf:catalogSummaryId ?j1 ; effortless-ntwf:typePredictionMatchCount ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR("catalog-v1"), "^.*[#/]", "")) || (?j0 = "catalog-v1")) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_TypePredictionMismatchCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_TypePredictionMismatchCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:typePredictionMismatchCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL { ?j0 a effortless-ntwf:CorpusCatalogSummary ; effortless-ntwf:catalogSummaryId ?j1 ; effortless-ntwf:typePredictionMismatchCount ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR("catalog-v1"), "^.*[#/]", "")) || (?j0 = "catalog-v1")) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
