effortless-ntwf-shapes:ModelSummary_DomainDiversityNote a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_DomainDiversityNote" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:domainDiversityNote ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
    OPTIONAL { $this effortless-ntwf:economicsSignFlipRate ?economics_sign_flip_rate . }
    OPTIONAL { $this effortless-ntwf:educationLatentFraction ?education_latent_fraction . }
    OPTIONAL { $this effortless-ntwf:expansionWave2StudyCount ?expansion_wave2_study_count . OPTIONAL { ?expansion_wave2_study_count erb:key ?expansion_wave2_study_count__key . } }
    OPTIONAL { $this effortless-ntwf:realStudyCount ?real_study_count . OPTIONAL { ?real_study_count erb:key ?real_study_count__key . } }
    OPTIONAL { $this effortless-ntwf:sportsLatentFraction ?sports_latent_fraction . }
                BIND(CONCAT("real=", COALESCE(COALESCE(?real_study_count__key, IF(isIRI(?real_study_count), REPLACE(STR(?real_study_count), "^.*[#/]", ""), STR(?real_study_count))), ""), " studies; wave2=", COALESCE(COALESCE(?expansion_wave2_study_count__key, IF(isIRI(?expansion_wave2_study_count), REPLACE(STR(?expansion_wave2_study_count), "^.*[#/]", ""), STR(?expansion_wave2_study_count))), ""), "; eduLatent=", COALESCE(IF(isIRI((ROUND((?education_latent_fraction * 100) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double))), REPLACE(STR((ROUND((?education_latent_fraction * 100) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double))), "^.*[#/]", ""), STR((ROUND((?education_latent_fraction * 100) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double)))), ""), "%; sportsLatent=", COALESCE(IF(isIRI((ROUND((?sports_latent_fraction * 100) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double))), REPLACE(STR((ROUND((?sports_latent_fraction * 100) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double))), "^.*[#/]", ""), STR((ROUND((?sports_latent_fraction * 100) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double)))), ""), "%; econFlipRate=", COALESCE(IF(isIRI((ROUND((?economics_sign_flip_rate * 100) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double))), REPLACE(STR((ROUND((?economics_sign_flip_rate * 100) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double))), "^.*[#/]", ""), STR((ROUND((?economics_sign_flip_rate * 100) * STRDT(CONCAT("1e", STR(0)), xsd:double)) / STRDT(CONCAT("1e", STR(0)), xsd:double)))), ""), "%") AS ?_result)
            }
        """ ;
    ] .
