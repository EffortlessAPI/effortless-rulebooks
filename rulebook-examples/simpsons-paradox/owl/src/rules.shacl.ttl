            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UIComponents .
    OPTIONAL { $this effortless-ntwf:componentId ?component_id . }
                BIND(?component_id AS ?_result)
            }
        """ ;
    ] .

# === Rules for UIScreens ===
effortless-ntwf-shapes:UIScreens_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:UIScreens ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UIScreens_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UIScreens .
    OPTIONAL { $this effortless-ntwf:screenId ?screen_id . }
                BIND(?screen_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:UIScreens_TraditionName a sh:NodeShape ;
    sh:targetClass effortless-ntwf:UIScreens ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UIScreens_TraditionName" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:traditionName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UIScreens .
                OPTIONAL { $this effortless-ntwf:traditionId ?tradition_id . }
                OPTIONAL { ?j0 a effortless-ntwf:ResearchTraditions ; effortless-ntwf:traditionId ?j1 ; effortless-ntwf:name ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?tradition_id), "^.*[#/]", "")) || (?j0 = ?tradition_id)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:UIScreens_TraditionCoreConern a sh:NodeShape ;
    sh:targetClass effortless-ntwf:UIScreens ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UIScreens_TraditionCoreConern" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:traditionCoreConern ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UIScreens .
                OPTIONAL { $this effortless-ntwf:traditionId ?tradition_id . }
                OPTIONAL { ?j0 a effortless-ntwf:ResearchTraditions ; effortless-ntwf:traditionId ?j1 ; effortless-ntwf:coreConcern ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?tradition_id), "^.*[#/]", "")) || (?j0 = ?tradition_id)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:UIScreens_PrimaryConclusionTitle a sh:NodeShape ;
    sh:targetClass effortless-ntwf:UIScreens ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UIScreens_PrimaryConclusionTitle" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:primaryConclusionTitle ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UIScreens .
                OPTIONAL { $this effortless-ntwf:primaryConclusion ?primary_conclusion . }
                OPTIONAL { ?j0 a effortless-ntwf:Conclusions ; effortless-ntwf:conclusionId ?j1 ; effortless-ntwf:title ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?primary_conclusion), "^.*[#/]", "")) || (?j0 = ?primary_conclusion)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:UIScreens_PrimaryConclusionEvidence a sh:NodeShape ;
    sh:targetClass effortless-ntwf:UIScreens ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_UIScreens_PrimaryConclusionEvidence" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:primaryConclusionEvidence ?_result .
            }
            WHERE {
    $this a effortless-ntwf:UIScreens .
                OPTIONAL { $this effortless-ntwf:primaryConclusion ?primary_conclusion . }
                OPTIONAL { ?j0 a effortless-ntwf:Conclusions ; effortless-ntwf:conclusionId ?j1 ; effortless-ntwf:evidence ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?primary_conclusion), "^.*[#/]", "")) || (?j0 = ?primary_conclusion)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .

# === Cardinality: single-valued forward FK properties ===
effortless-ntwf-shapes:CaseCellsCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CaseCells ;
    sh:property [ sh:path effortless-ntwf:study ; sh:maxCount 1 ] .

effortless-ntwf-shapes:ConfounderDistortionTimelineCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConfounderDistortionTimeline ;
    sh:property [ sh:path effortless-ntwf:confounderIdentity ; sh:maxCount 1 ] .

effortless-ntwf-shapes:IdentityClusterSummariesCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IdentityClusterSummaries ;
    sh:property [ sh:path effortless-ntwf:confounderIdentity ; sh:maxCount 1 ] .

effortless-ntwf-shapes:IdentityDomainCellsCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IdentityDomainCells ;
    sh:property [ sh:path effortless-ntwf:confounderIdentity ; sh:maxCount 1 ] .

effortless-ntwf-shapes:StrataCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Strata ;
    sh:property [ sh:path effortless-ntwf:study ; sh:maxCount 1 ] .

effortless-ntwf-shapes:StratumSummariesCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:property [ sh:path effortless-ntwf:study ; sh:maxCount 1 ] .

effortless-ntwf-shapes:StratumVariableIdentityMapsCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumVariableIdentityMaps ;
    sh:property [ sh:path effortless-ntwf:confounderIdentity ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:stratumVariable ; sh:maxCount 1 ] .

effortless-ntwf-shapes:StratumVariablesCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumVariables ;
    sh:property [ sh:path effortless-ntwf:study ; sh:maxCount 1 ] .

effortless-ntwf-shapes:TreatmentRankingsCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:property [ sh:path effortless-ntwf:study ; sh:maxCount 1 ] .

effortless-ntwf-shapes:TreatmentsCardinality a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Treatments ;
    sh:property [ sh:path effortless-ntwf:study ; sh:maxCount 1 ] .

# Generated 403 SHACL rules