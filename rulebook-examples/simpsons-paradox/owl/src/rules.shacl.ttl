effortless-ntwf-shapes:TreatmentRankings_CorrectedWinner a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_CorrectedWinner" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:correctedWinner ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:correctedGap ?corrected_gap . OPTIONAL { ?corrected_gap erb:key ?corrected_gap__key . } }
    OPTIONAL { $this effortless-ntwf:treatmentA ?treatment_a . }
    OPTIONAL { $this effortless-ntwf:treatmentB ?treatment_b . }
                BIND(IF(COALESCE((COALESCE(COALESCE(?corrected_gap__key, COALESCE(IF(isIRI(?corrected_gap), REPLACE(STR(?corrected_gap), "^.*[#/]", ""), STR(?corrected_gap)), "")), 0) = ""), false), "", IF(COALESCE((COALESCE(ABS(?corrected_gap), 0) < 0.0001), false), "tie", IF(COALESCE((COALESCE(?corrected_gap, 0) > 0), false), ?treatment_a, IF(COALESCE((COALESCE(?corrected_gap, 0) < 0), false), ?treatment_b, "tie")))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_CorrectedVsPooledAgreement a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_CorrectedVsPooledAgreement" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:correctedVsPooledAgreement ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:correctedWinner ?corrected_winner . OPTIONAL { ?corrected_winner erb:key ?corrected_winner__key . } }
    OPTIONAL { $this effortless-ntwf:pooledWinner ?pooled_winner . }
                BIND(IF(COALESCE((COALESCE(?corrected_winner__key, COALESCE(IF(isIRI(?corrected_winner), REPLACE(STR(?corrected_winner), "^.*[#/]", ""), STR(?corrected_winner)), "")) = ""), false), "", COALESCE((?corrected_winner = ?pooled_winner), ((!BOUND(?corrected_winner) || STR(?corrected_winner) = "") && (!BOUND(?pooled_winner) || STR(?pooled_winner) = "")))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_CorrectedPolicyImplication a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_CorrectedPolicyImplication" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
