effortless-ntwf-shapes:ModelSummary_CPlusAvgDistortion a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_CPlusAvgDistortion" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:cPlusAvgDistortion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (AVG(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:distortionType ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:allocationDistortion ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "C+"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
