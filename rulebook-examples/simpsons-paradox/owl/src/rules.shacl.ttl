                    OPTIONAL { ?child effortless-ntwf:isImported ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    OPTIONAL { ?child effortless-ntwf:expectedDistortionType ?c6 . OPTIONAL { ?c6 erb:key ?c6__key . } }
                    OPTIONAL { ?child effortless-ntwf:observedDistortionType ?c8 . OPTIONAL { ?c8 erb:key ?c8__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "expansion-wave-1"))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "economics"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    FILTER((COALESCE(?c6__key, STR(?c6)) = "A"))
                    FILTER((COALESCE(?c8__key, STR(?c8)) = "D"))
