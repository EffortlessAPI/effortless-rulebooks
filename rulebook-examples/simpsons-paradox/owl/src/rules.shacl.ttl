    OPTIONAL { $this effortless-ntwf:mappedStratumVariableCount ?mapped_stratum_variable_count . }
    OPTIONAL { $this effortless-ntwf:realStudyCount ?real_study_count . }
                BIND(IF(COALESCE((COALESCE(?real_study_count, 0) = 0), false), "", xsd:double(?mapped_stratum_variable_count / ?real_study_count)) AS ?_result)
            }
        """ ;
    ] .
