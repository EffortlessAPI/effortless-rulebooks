    $this a effortless-ntwf:CorpusCatalogSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    OPTIONAL { ?child effortless-ntwf:ingestionStatus ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "blocked"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_ReadyToEncodeCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_ReadyToEncodeCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:readyToEncodeCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    OPTIONAL { ?child effortless-ntwf:isReadyToEncode ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_HighPriorityCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_HighPriorityCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:highPriorityCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    OPTIONAL { ?child effortless-ntwf:ingestionStatus ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:priority ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "candidate"))
                    FILTER(?c2 = 1)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_lhs)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg2) WHERE {
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    OPTIONAL { ?child effortless-ntwf:ingestionStatus ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:priority ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "candidate"))
                    FILTER(?c2 = 2)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg2, 0) AS ?_rhs)
    BIND(?_lhs + ?_rhs AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_ImportSessionReady a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_ImportSessionReady" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:importSessionReady ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
    OPTIONAL { $this effortless-ntwf:candidateCount ?candidate_count . }
    OPTIONAL { $this effortless-ntwf:readyToEncodeCount ?ready_to_encode_count . }
                BIND((COALESCE((COALESCE(?candidate_count, 0) >= 20), false) && COALESCE((COALESCE(?ready_to_encode_count, 0) >= 15), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_TypePredictionMatchCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_TypePredictionMatchCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:typePredictionMatchCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    OPTIONAL { ?child effortless-ntwf:typePredictionMatch ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_TypePredictionMismatchCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_TypePredictionMismatchCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:typePredictionMismatchCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    OPTIONAL { ?child effortless-ntwf:isImported ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:typePredictionMatch ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    FILTER(BOUND(?c2) && ?c2 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_SignFlipPredictionEligibleCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_SignFlipPredictionEligibleCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:signFlipPredictionEligibleCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    OPTIONAL { ?child effortless-ntwf:isImported ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:expectedSignFlip ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_SignFlipPredictionMatchCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_SignFlipPredictionMatchCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:signFlipPredictionMatchCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    OPTIONAL { ?child effortless-ntwf:signFlipPredictionMatch ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_TypePredictionMatchRate a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_TypePredictionMatchRate" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:typePredictionMatchRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
    OPTIONAL { $this effortless-ntwf:importedCount ?imported_count . }
    OPTIONAL { $this effortless-ntwf:typePredictionMatchCount ?type_prediction_match_count . }
                BIND(IF(COALESCE((COALESCE(?imported_count, 0) = 0), false), "", xsd:double(?type_prediction_match_count / ?imported_count)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_SignFlipPredictionMatchRate a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 12 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_SignFlipPredictionMatchRate" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:signFlipPredictionMatchRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
    OPTIONAL { $this effortless-ntwf:signFlipPredictionEligibleCount ?sign_flip_prediction_eligible_count . }
    OPTIONAL { $this effortless-ntwf:signFlipPredictionMatchCount ?sign_flip_prediction_match_count . }
                BIND(IF(COALESCE((COALESCE(?sign_flip_prediction_eligible_count, 0) = 0), false), "", xsd:double(?sign_flip_prediction_match_count / ?sign_flip_prediction_eligible_count)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_CatalogWitnessNote a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_CatalogWitnessNote" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:catalogWitnessNote ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
    OPTIONAL { $this effortless-ntwf:candidateCount ?candidate_count . OPTIONAL { ?candidate_count erb:key ?candidate_count__key . } }
    OPTIONAL { $this effortless-ntwf:dataReadyCount ?data_ready_count . OPTIONAL { ?data_ready_count erb:key ?data_ready_count__key . } }
    OPTIONAL { $this effortless-ntwf:importSessionReady ?import_session_ready . }
    OPTIONAL { $this effortless-ntwf:readyToEncodeCount ?ready_to_encode_count . OPTIONAL { ?ready_to_encode_count erb:key ?ready_to_encode_count__key . } }
                BIND(IF(COALESCE(?import_session_ready, false), CONCAT("READY: ", COALESCE(COALESCE(?ready_to_encode_count__key, IF(isIRI(?ready_to_encode_count), REPLACE(STR(?ready_to_encode_count), "^.*[#/]", ""), STR(?ready_to_encode_count))), ""), " encode-ready (", COALESCE(COALESCE(?data_ready_count__key, IF(isIRI(?data_ready_count), REPLACE(STR(?data_ready_count), "^.*[#/]", ""), STR(?data_ready_count))), ""), " data-ready) of ", COALESCE(COALESCE(?candidate_count__key, IF(isIRI(?candidate_count), REPLACE(STR(?candidate_count), "^.*[#/]", ""), STR(?candidate_count))), ""), " candidates"), CONCAT("BUILDING: ", COALESCE(COALESCE(?candidate_count__key, IF(isIRI(?candidate_count), REPLACE(STR(?candidate_count), "^.*[#/]", ""), STR(?candidate_count))), ""), " candidates — ", COALESCE(COALESCE(?data_ready_count__key, IF(isIRI(?data_ready_count), REPLACE(STR(?data_ready_count), "^.*[#/]", ""), STR(?data_ready_count))), ""), " data-ready, ", COALESCE(COALESCE(?ready_to_encode_count__key, IF(isIRI(?ready_to_encode_count), REPLACE(STR(?ready_to_encode_count), "^.*[#/]", ""), STR(?ready_to_encode_count))), ""), " encode-ready")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_CatalogPredictionWitnessNote a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 13 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_CatalogPredictionWitnessNote" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:catalogPredictionWitnessNote ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
    OPTIONAL { $this effortless-ntwf:importedCount ?imported_count . OPTIONAL { ?imported_count erb:key ?imported_count__key . } }
    OPTIONAL { $this effortless-ntwf:signFlipPredictionEligibleCount ?sign_flip_prediction_eligible_count . OPTIONAL { ?sign_flip_prediction_eligible_count erb:key ?sign_flip_prediction_eligible_count__key . } }
    OPTIONAL { $this effortless-ntwf:signFlipPredictionMatchCount ?sign_flip_prediction_match_count . OPTIONAL { ?sign_flip_prediction_match_count erb:key ?sign_flip_prediction_match_count__key . } }
    OPTIONAL { $this effortless-ntwf:signFlipPredictionMatchRate ?sign_flip_prediction_match_rate . }
    OPTIONAL { $this effortless-ntwf:typePredictionMatchCount ?type_prediction_match_count . OPTIONAL { ?type_prediction_match_count erb:key ?type_prediction_match_count__key . } }
    OPTIONAL { $this effortless-ntwf:typePredictionMatchRate ?type_prediction_match_rate . }
                BIND(CONCAT("exact=", COALESCE(COALESCE(?type_prediction_match_count__key, IF(isIRI(?type_prediction_match_count), REPLACE(STR(?type_prediction_match_count), "^.*[#/]", ""), STR(?type_prediction_match_count))), ""), "/", COALESCE(COALESCE(?imported_count__key, IF(isIRI(?imported_count), REPLACE(STR(?imported_count), "^.*[#/]", ""), STR(?imported_count))), ""), " (", COALESCE(IF(isIRI((ROUND((?type_prediction_match_rate * 100) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))), REPLACE(STR((ROUND((?type_prediction_match_rate * 100) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))), "^.*[#/]", ""), STR((ROUND((?type_prediction_match_rate * 100) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double)))), ""), "%); flipPred=", COALESCE(COALESCE(?sign_flip_prediction_match_count__key, IF(isIRI(?sign_flip_prediction_match_count), REPLACE(STR(?sign_flip_prediction_match_count), "^.*[#/]", ""), STR(?sign_flip_prediction_match_count))), ""), "/", COALESCE(COALESCE(?sign_flip_prediction_eligible_count__key, IF(isIRI(?sign_flip_prediction_eligible_count), REPLACE(STR(?sign_flip_prediction_eligible_count), "^.*[#/]", ""), STR(?sign_flip_prediction_eligible_count))), ""), " (", COALESCE(IF(isIRI((ROUND((?sign_flip_prediction_match_rate * 100) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))), REPLACE(STR((ROUND((?sign_flip_prediction_match_rate * 100) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double))), "^.*[#/]", ""), STR((ROUND((?sign_flip_prediction_match_rate * 100) * STRDT(CONCAT("1e", STR(1)), xsd:double)) / STRDT(CONCAT("1e", STR(1)), xsd:double)))), ""), "%)") AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_DataReadyCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_DataReadyCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:dataReadyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    OPTIONAL { ?child effortless-ntwf:isDataReady ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:ingestionStatus ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "candidate"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_EncodePipelineReadyCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_EncodePipelineReadyCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:encodePipelineReadyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    OPTIONAL { ?child effortless-ntwf:isReadyToEncode ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:isDataReady ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusCatalogSummary_ExpansionCandidateCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusCatalogSummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusCatalogSummary_ExpansionCandidateCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:expansionCandidateCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusCatalogSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    OPTIONAL { ?child effortless-ntwf:expansionWave ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "expansion-wave-1"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for CorpusDomains ===
effortless-ntwf-shapes:CorpusDomains_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusDomains ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusDomains_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusDomains .
    OPTIONAL { $this effortless-ntwf:domainId ?domain_id . }
                BIND(?domain_id AS ?_result)
            }
        """ ;
    ] .

# === Rules for DiscoveryFindings ===
effortless-ntwf-shapes:DiscoveryFindings_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DiscoveryFindings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DiscoveryFindings_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DiscoveryFindings .
    OPTIONAL { $this effortless-ntwf:findingId ?finding_id . }
                BIND(?finding_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DiscoveryFindings_HypothesisStatement a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DiscoveryFindings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DiscoveryFindings_HypothesisStatement" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:hypothesisStatement ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DiscoveryFindings .
                OPTIONAL { $this effortless-ntwf:hypothesisId ?hypothesis_id . }
                OPTIONAL { ?j0 a effortless-ntwf:DiscoveryHypotheses ; effortless-ntwf:hypothesisId ?j1 ; effortless-ntwf:statement ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?hypothesis_id), "^.*[#/]", "")) || (?j0 = ?hypothesis_id)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:DiscoveryFindings_IsConfirmed a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DiscoveryFindings ;
    sh:order 14 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DiscoveryFindings_IsConfirmed" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isConfirmed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DiscoveryFindings .
                OPTIONAL { $this effortless-ntwf:hypothesisId ?hypothesis_id . }
                OPTIONAL { ?j0 a effortless-ntwf:ModelSummary ; effortless-ntwf:modelSummaryId ?j1 ; effortless-ntwf:latentTypeDFraction ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR("simpsons-paradox-v1"), "^.*[#/]", "")) || (?j0 = "simpsons-paradox-v1")) }
                OPTIONAL { ?j3 a effortless-ntwf:ModelSummary ; effortless-ntwf:modelSummaryId ?j4 ; effortless-ntwf:signFlipSignalPurityMax ?j5 . FILTER((REPLACE(STR(?j4), "^.*[#/]", "") = REPLACE(STR("simpsons-paradox-v1"), "^.*[#/]", "")) || (?j3 = "simpsons-paradox-v1")) }
                OPTIONAL { ?j6 a effortless-ntwf:ModelSummary ; effortless-ntwf:modelSummaryId ?j7 ; effortless-ntwf:avgPooledGapStableD ?j8 . FILTER((REPLACE(STR(?j7), "^.*[#/]", "") = REPLACE(STR("simpsons-paradox-v1"), "^.*[#/]", "")) || (?j6 = "simpsons-paradox-v1")) }
                OPTIONAL { ?j9 a effortless-ntwf:ModelSummary ; effortless-ntwf:modelSummaryId ?j10 ; effortless-ntwf:avgPooledGapLatentD ?j11 . FILTER((REPLACE(STR(?j10), "^.*[#/]", "") = REPLACE(STR("simpsons-paradox-v1"), "^.*[#/]", "")) || (?j9 = "simpsons-paradox-v1")) }
                OPTIONAL { ?j12 a effortless-ntwf:ModelSummary ; effortless-ntwf:modelSummaryId ?j13 ; effortless-ntwf:economicsSignFlipCount ?j14 . FILTER((REPLACE(STR(?j13), "^.*[#/]", "") = REPLACE(STR("simpsons-paradox-v1"), "^.*[#/]", "")) || (?j12 = "simpsons-paradox-v1")) }
                OPTIONAL { ?j15 a effortless-ntwf:ModelSummary ; effortless-ntwf:modelSummaryId ?j16 ; effortless-ntwf:epidemiologyAvgDistortion ?j17 . FILTER((REPLACE(STR(?j16), "^.*[#/]", "") = REPLACE(STR("simpsons-paradox-v1"), "^.*[#/]", "")) || (?j15 = "simpsons-paradox-v1")) }
                OPTIONAL { ?j18 a effortless-ntwf:ModelSummary ; effortless-ntwf:modelSummaryId ?j19 ; effortless-ntwf:educationAvgDistortion ?j20 . FILTER((REPLACE(STR(?j19), "^.*[#/]", "") = REPLACE(STR("simpsons-paradox-v1"), "^.*[#/]", "")) || (?j18 = "simpsons-paradox-v1")) }
                OPTIONAL { ?j21 a effortless-ntwf:ModelSummary ; effortless-ntwf:modelSummaryId ?j22 ; effortless-ntwf:confounderSignFlipCount ?j23 . FILTER((REPLACE(STR(?j22), "^.*[#/]", "") = REPLACE(STR("simpsons-paradox-v1"), "^.*[#/]", "")) || (?j21 = "simpsons-paradox-v1")) }
                OPTIONAL { ?j24 a effortless-ntwf:ModelSummary ; effortless-ntwf:modelSummaryId ?j25 ; effortless-ntwf:colliderSelectionManifestCount ?j26 . FILTER((REPLACE(STR(?j25), "^.*[#/]", "") = REPLACE(STR("simpsons-paradox-v1"), "^.*[#/]", "")) || (?j24 = "simpsons-paradox-v1")) }
