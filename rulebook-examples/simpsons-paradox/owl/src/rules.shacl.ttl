                BIND(IF(COALESCE((COALESCE(COALESCE(?stratum_gap__key, COALESCE(IF(isIRI(?stratum_gap), REPLACE(STR(?stratum_gap), "^.*[#/]", ""), STR(?stratum_gap)), "")), 0) = ""), false), "", ABS(?stratum_gap)) AS ?_result)
