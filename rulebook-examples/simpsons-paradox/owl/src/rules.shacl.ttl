effortless-ntwf-shapes:ModelSummary_DistortionTaxonomyCoverage a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_DistortionTaxonomyCoverage" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:distortionTaxonomyCoverage ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
    OPTIONAL { $this effortless-ntwf:cAmplificationCount ?c_amplification_count . OPTIONAL { ?c_amplification_count erb:key ?c_amplification_count__key . } }
    OPTIONAL { $this effortless-ntwf:cCompressionCount ?c_compression_count . OPTIONAL { ?c_compression_count erb:key ?c_compression_count__key . } }
    OPTIONAL { $this effortless-ntwf:typeACount ?type_a_count . OPTIONAL { ?type_a_count erb:key ?type_a_count__key . } }
    OPTIONAL { $this effortless-ntwf:typeBCount ?type_b_count . OPTIONAL { ?type_b_count erb:key ?type_b_count__key . } }
    OPTIONAL { $this effortless-ntwf:typeDCount ?type_d_count . OPTIONAL { ?type_d_count erb:key ?type_d_count__key . } }
                BIND(CONCAT("A:", COALESCE(COALESCE(?type_a_count__key, IF(isIRI(?type_a_count), REPLACE(STR(?type_a_count), "^.*[#/]", ""), STR(?type_a_count))), ""), " B:", COALESCE(COALESCE(?type_b_count__key, IF(isIRI(?type_b_count), REPLACE(STR(?type_b_count), "^.*[#/]", ""), STR(?type_b_count))), ""), " C+:", COALESCE(COALESCE(?c_amplification_count__key, IF(isIRI(?c_amplification_count), REPLACE(STR(?c_amplification_count), "^.*[#/]", ""), STR(?c_amplification_count))), ""), " C-:", COALESCE(COALESCE(?c_compression_count__key, IF(isIRI(?c_compression_count), REPLACE(STR(?c_compression_count), "^.*[#/]", ""), STR(?c_compression_count))), ""), " D:", COALESCE(COALESCE(?type_d_count__key, IF(isIRI(?type_d_count), REPLACE(STR(?type_d_count), "^.*[#/]", ""), STR(?type_d_count))), "")) AS ?_result)
            }
        """ ;
    ] .
