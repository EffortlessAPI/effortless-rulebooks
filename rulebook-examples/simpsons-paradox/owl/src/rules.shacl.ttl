effortless-ntwf-shapes:TreatmentRankings_AllocationFragility a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_AllocationFragility" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:allocationFragility ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:pooledGap ?pooled_gap . OPTIONAL { ?pooled_gap erb:key ?pooled_gap__key . } }
    OPTIONAL { $this effortless-ntwf:sweepPooledGapRange ?sweep_pooled_gap_range . OPTIONAL { ?sweep_pooled_gap_range erb:key ?sweep_pooled_gap_range__key . } }
                BIND(IF(COALESCE((COALESCE((COALESCE(COALESCE(?sweep_pooled_gap_range__key, COALESCE(IF(isIRI(?sweep_pooled_gap_range), REPLACE(STR(?sweep_pooled_gap_range), "^.*[#/]", ""), STR(?sweep_pooled_gap_range)), "")), 0) = ""), false) || COALESCE((COALESCE(COALESCE(?pooled_gap__key, COALESCE(IF(isIRI(?pooled_gap), REPLACE(STR(?pooled_gap), "^.*[#/]", ""), STR(?pooled_gap)), "")), 0) = ""), false) || COALESCE((COALESCE(?pooled_gap, 0) = 0), false)), false), 0, xsd:double(?sweep_pooled_gap_range / ABS(?pooled_gap))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_MaxStratumImbalance a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_MaxStratumImbalance" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:maxStratumImbalance ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:StratumSummaries .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child effortless-ntwf:absAllocationBias ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "A"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_MaxStratumGap a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 5 ;
