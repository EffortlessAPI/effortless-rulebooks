# === Rules for StratumVariableIdentityMaps ===
effortless-ntwf-shapes:StratumVariableIdentityMaps_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumVariableIdentityMaps ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumVariableIdentityMaps_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumVariableIdentityMaps .
    OPTIONAL { $this effortless-ntwf:mapId ?map_id . }
                BIND(?map_id AS ?_result)
            }
        """ ;
    ] .

# === Rules for StratumVariables ===
effortless-ntwf-shapes:StratumVariables_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumVariables ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumVariables_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumVariables .
    OPTIONAL { $this effortless-ntwf:stratumVariableId ?stratum_variable_id . }
                BIND(?stratum_variable_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumVariables_IsConfounder a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumVariables ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumVariables_IsConfounder" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isConfounder ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumVariables .
    OPTIONAL { $this effortless-ntwf:affectsOutcome ?affects_outcome . }
    OPTIONAL { $this effortless-ntwf:affectsTreatmentAssignment ?affects_treatment_assignment . }
    OPTIONAL { $this effortless-ntwf:causalRole ?causal_role . OPTIONAL { ?causal_role erb:key ?causal_role__key . } }
                BIND((COALESCE(?affects_treatment_assignment, false) && COALESCE(?affects_outcome, false) && COALESCE((COALESCE(?causal_role__key, COALESCE(IF(isIRI(?causal_role), REPLACE(STR(?causal_role), "^.*[#/]", ""), STR(?causal_role)), "")) = "confounder"), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumVariables_ConfounderIdentity a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumVariables ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumVariables_ConfounderIdentity" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:confounderIdentity ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumVariables .
                OPTIONAL { $this effortless-ntwf:stratumVariableId ?stratum_variable_id . }
                OPTIONAL { ?j0 a effortless-ntwf:StratumVariableIdentityMaps ; effortless-ntwf:stratumVariable ?j1 ; effortless-ntwf:confounderIdentity ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?stratum_variable_id), "^.*[#/]", "")) || (?j0 = ?stratum_variable_id)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .

# === Rules for Studies ===
effortless-ntwf-shapes:Studies_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Studies ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Studies_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Studies .
    OPTIONAL { $this effortless-ntwf:studyId ?study_id . }
                BIND(?study_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Studies_TotalCases a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Studies ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Studies_TotalCases" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:totalCases ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Studies .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:Studies .
                    ?child a effortless-ntwf:CaseCells .
                    ?child effortless-ntwf:study $this .
                    OPTIONAL { ?child effortless-ntwf:cases ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Studies_CellCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Studies ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Studies_CellCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:cellCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Studies .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Studies .
                    ?child a effortless-ntwf:CaseCells .
                    ?child effortless-ntwf:study $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Studies_TraditionName a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Studies ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Studies_TraditionName" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:traditionName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Studies .
                OPTIONAL { $this effortless-ntwf:traditionId ?tradition_id . }
                OPTIONAL { ?j0 a effortless-ntwf:ResearchTraditions ; effortless-ntwf:traditionId ?j1 ; effortless-ntwf:name ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?tradition_id), "^.*[#/]", "")) || (?j0 = ?tradition_id)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
