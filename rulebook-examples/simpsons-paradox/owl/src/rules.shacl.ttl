effortless-ntwf-shapes:ModelSummary_ExpansionWave1EconomicsExpectedACount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_ExpansionWave1EconomicsExpectedACount" ;
