                    ?child a effortless-ntwf:Studies .
                    OPTIONAL { ?child effortless-ntwf:isSynthetic ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:isControlStudy ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c0) && ?c0 = false)
                    FILTER(BOUND(?c2) && ?c2 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IngestionSummary_RealFullyCompliantCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IngestionSummary ;
    sh:order 4 ;
    sh:rule [
