            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (MIN(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MIN(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:AllocationSweep .
                    OPTIONAL { ?child effortless-ntwf:studyId ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:sweepCorrectedGap ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "kidney-1986"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_SweepCorrectedGapRange a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_SweepCorrectedGapRange" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:sweepCorrectedGapRange ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
    OPTIONAL { $this effortless-ntwf:sweepCorrectedGapMax ?sweep_corrected_gap_max . OPTIONAL { ?sweep_corrected_gap_max erb:key ?sweep_corrected_gap_max__key . } }
    OPTIONAL { $this effortless-ntwf:sweepCorrectedGapMin ?sweep_corrected_gap_min . }
                BIND(IF(COALESCE((COALESCE(COALESCE(?sweep_corrected_gap_max__key, COALESCE(IF(isIRI(?sweep_corrected_gap_max), REPLACE(STR(?sweep_corrected_gap_max), "^.*[#/]", ""), STR(?sweep_corrected_gap_max)), "")), 0) = ""), false), "", (?sweep_corrected_gap_max - ?sweep_corrected_gap_min)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_SweepPooledGapRange a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_SweepPooledGapRange" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:sweepPooledGapRange ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:AllocationSweep .
                    OPTIONAL { ?child effortless-ntwf:studyId ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:sweepPooledGap ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "kidney-1986"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_lhs)
                OPTIONAL {
                    SELECT $this (MIN(?cval) AS ?_agg2) WHERE {
                        SELECT $this ?child (MIN(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:AllocationSweep .
                    OPTIONAL { ?child effortless-ntwf:studyId ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:sweepPooledGap ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "kidney-1986"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg2 AS ?_rhs)
    BIND(?_lhs - ?_rhs AS ?_result)
            }
        """ ;
    ] .
