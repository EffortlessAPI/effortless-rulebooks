            }
            WHERE {
    $this a effortless-ntwf:AllocationSweep .
                OPTIONAL { $this effortless-ntwf:studyId ?study_id . }
                OPTIONAL { ?j0 a effortless-ntwf:SweepStudyConfig ; effortless-ntwf:studyId ?j1 ; effortless-ntwf:fixedRateA ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?study_id), "^.*[#/]", "")) || (?j0 = ?study_id)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:AllocationSweep_FixedRateB a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AllocationSweep ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AllocationSweep_FixedRateB" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:fixedRateB ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AllocationSweep .
                OPTIONAL { $this effortless-ntwf:studyId ?study_id . }
                OPTIONAL { ?j0 a effortless-ntwf:SweepStudyConfig ; effortless-ntwf:studyId ?j1 ; effortless-ntwf:fixedRateB ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?study_id), "^.*[#/]", "")) || (?j0 = ?study_id)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:AllocationSweep_SweepPooledRateA a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AllocationSweep ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AllocationSweep_SweepPooledRateA" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:sweepPooledRateA ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AllocationSweep .
    OPTIONAL { $this effortless-ntwf:fixedRateA ?fixed_rate_a . }
    OPTIONAL { $this effortless-ntwf:nFixedA ?n_fixed_a . }
    OPTIONAL { $this effortless-ntwf:nSweepA ?n_sweep_a . }
    OPTIONAL { $this effortless-ntwf:sweepRateA ?sweep_rate_a . }
                BIND(IF(COALESCE((COALESCE((?n_sweep_a + ?n_fixed_a), 0) = 0), false), "", xsd:double(((?n_sweep_a * ?sweep_rate_a) + (?n_fixed_a * ?fixed_rate_a)) / (?n_sweep_a + ?n_fixed_a))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:AllocationSweep_SweepPooledRateB a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AllocationSweep ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AllocationSweep_SweepPooledRateB" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:sweepPooledRateB ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AllocationSweep .
    OPTIONAL { $this effortless-ntwf:fixedRateB ?fixed_rate_b . }
    OPTIONAL { $this effortless-ntwf:nFixedB ?n_fixed_b . }
    OPTIONAL { $this effortless-ntwf:nSweepB ?n_sweep_b . }
    OPTIONAL { $this effortless-ntwf:sweepRateB ?sweep_rate_b . }
                BIND(IF(COALESCE((COALESCE((?n_sweep_b + ?n_fixed_b), 0) = 0), false), "", xsd:double(((?n_sweep_b * ?sweep_rate_b) + (?n_fixed_b * ?fixed_rate_b)) / (?n_sweep_b + ?n_fixed_b))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:AllocationSweep_SweepPooledGap a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AllocationSweep ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AllocationSweep_SweepPooledGap" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:sweepPooledGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AllocationSweep .
    OPTIONAL { $this effortless-ntwf:sweepPooledRateA ?sweep_pooled_rate_a . OPTIONAL { ?sweep_pooled_rate_a erb:key ?sweep_pooled_rate_a__key . } }
    OPTIONAL { $this effortless-ntwf:sweepPooledRateB ?sweep_pooled_rate_b . }
                BIND(IF(COALESCE((COALESCE(COALESCE(?sweep_pooled_rate_a__key, COALESCE(IF(isIRI(?sweep_pooled_rate_a), REPLACE(STR(?sweep_pooled_rate_a), "^.*[#/]", ""), STR(?sweep_pooled_rate_a)), "")), 0) = ""), false), "", (?sweep_pooled_rate_a - ?sweep_pooled_rate_b)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:AllocationSweep_SweepCorrectedGap a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AllocationSweep ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AllocationSweep_SweepCorrectedGap" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:sweepCorrectedGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AllocationSweep .
                OPTIONAL { $this effortless-ntwf:studyId ?study_id . }
                OPTIONAL { ?j0 a effortless-ntwf:SweepStudyConfig ; effortless-ntwf:studyId ?j1 ; effortless-ntwf:sweepCorrectedGap ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?study_id), "^.*[#/]", "")) || (?j0 = ?study_id)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:AllocationSweep_AllocationDistortionWitness a sh:NodeShape ;
    sh:targetClass effortless-ntwf:AllocationSweep ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_AllocationSweep_AllocationDistortionWitness" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:allocationDistortionWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:AllocationSweep .
    OPTIONAL { $this effortless-ntwf:sweepCorrectedGap ?sweep_corrected_gap . }
    OPTIONAL { $this effortless-ntwf:sweepPooledGap ?sweep_pooled_gap . OPTIONAL { ?sweep_pooled_gap erb:key ?sweep_pooled_gap__key . } }
                BIND(IF(COALESCE((COALESCE(COALESCE(?sweep_pooled_gap__key, COALESCE(IF(isIRI(?sweep_pooled_gap), REPLACE(STR(?sweep_pooled_gap), "^.*[#/]", ""), STR(?sweep_pooled_gap)), "")), 0) = ""), false), "", (?sweep_pooled_gap - ?sweep_corrected_gap)) AS ?_result)
            }
        """ ;
    ] .
# Rule for IsOriginal - parse error: unsupported lookup sub-expression: FuncCall

# === Rules for CandidateStudyCatalog ===
effortless-ntwf-shapes:CandidateStudyCatalog_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CandidateStudyCatalog ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CandidateStudyCatalog_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CandidateStudyCatalog .
    OPTIONAL { $this effortless-ntwf:candidateId ?candidate_id . }
                BIND(?candidate_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CandidateStudyCatalog_IsReadyToEncode a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CandidateStudyCatalog ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CandidateStudyCatalog_IsReadyToEncode" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isReadyToEncode ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CandidateStudyCatalog .
    OPTIONAL { $this effortless-ntwf:citation ?citation . OPTIONAL { ?citation erb:key ?citation__key . } }
    OPTIONAL { $this effortless-ntwf:ingestionStatus ?ingestion_status . OPTIONAL { ?ingestion_status erb:key ?ingestion_status__key . } }
    OPTIONAL { $this effortless-ntwf:proposedStudyId ?proposed_study_id . OPTIONAL { ?proposed_study_id erb:key ?proposed_study_id__key . } }
    OPTIONAL { $this effortless-ntwf:stratumVariableName ?stratum_variable_name . OPTIONAL { ?stratum_variable_name erb:key ?stratum_variable_name__key . } }
                BIND((COALESCE((COALESCE(?ingestion_status__key, COALESCE(IF(isIRI(?ingestion_status), REPLACE(STR(?ingestion_status), "^.*[#/]", ""), STR(?ingestion_status)), "")) = "candidate"), false) && COALESCE((COALESCE(?proposed_study_id__key, COALESCE(IF(isIRI(?proposed_study_id), REPLACE(STR(?proposed_study_id), "^.*[#/]", ""), STR(?proposed_study_id)), "")) != ""), false) && COALESCE((COALESCE(?citation__key, COALESCE(IF(isIRI(?citation), REPLACE(STR(?citation), "^.*[#/]", ""), STR(?citation)), "")) != ""), false) && COALESCE((COALESCE(?stratum_variable_name__key, COALESCE(IF(isIRI(?stratum_variable_name), REPLACE(STR(?stratum_variable_name), "^.*[#/]", ""), STR(?stratum_variable_name)), "")) != ""), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CandidateStudyCatalog_IsImported a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CandidateStudyCatalog ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CandidateStudyCatalog_IsImported" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isImported ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CandidateStudyCatalog .
    OPTIONAL { $this effortless-ntwf:ingestionStatus ?ingestion_status . OPTIONAL { ?ingestion_status erb:key ?ingestion_status__key . } }
                BIND((COALESCE(?ingestion_status__key, COALESCE(IF(isIRI(?ingestion_status), REPLACE(STR(?ingestion_status), "^.*[#/]", ""), STR(?ingestion_status)), "")) = "imported") AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CandidateStudyCatalog_ObservedDistortionType a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CandidateStudyCatalog ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CandidateStudyCatalog_ObservedDistortionType" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:observedDistortionType ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CandidateStudyCatalog .
                OPTIONAL { $this effortless-ntwf:linkedStudyId ?linked_study_id . }
                OPTIONAL { ?j0 a effortless-ntwf:TreatmentRankings ; effortless-ntwf:study ?j1 ; effortless-ntwf:distortionType ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?linked_study_id), "^.*[#/]", "")) || (?j0 = ?linked_study_id)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CandidateStudyCatalog_TypePredictionMatch a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CandidateStudyCatalog ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CandidateStudyCatalog_TypePredictionMatch" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:typePredictionMatch ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CandidateStudyCatalog .
    OPTIONAL { $this effortless-ntwf:expectedDistortionType ?expected_distortion_type . }
    OPTIONAL { $this effortless-ntwf:isImported ?is_imported . }
    OPTIONAL { $this effortless-ntwf:observedDistortionType ?observed_distortion_type . }
                BIND(IF(COALESCE(?is_imported, false), COALESCE((?observed_distortion_type = ?expected_distortion_type), ((!BOUND(?observed_distortion_type) || STR(?observed_distortion_type) = "") && (!BOUND(?expected_distortion_type) || STR(?expected_distortion_type) = ""))), "") AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CandidateStudyCatalog_ExpectedSignFlip a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CandidateStudyCatalog ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CandidateStudyCatalog_ExpectedSignFlip" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:expectedSignFlip ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CandidateStudyCatalog .
    OPTIONAL { $this effortless-ntwf:expectedDistortionType ?expected_distortion_type . OPTIONAL { ?expected_distortion_type erb:key ?expected_distortion_type__key . } }
                BIND((COALESCE((COALESCE(?expected_distortion_type__key, COALESCE(IF(isIRI(?expected_distortion_type), REPLACE(STR(?expected_distortion_type), "^.*[#/]", ""), STR(?expected_distortion_type)), "")) = "A"), false) || COALESCE((COALESCE(?expected_distortion_type__key, COALESCE(IF(isIRI(?expected_distortion_type), REPLACE(STR(?expected_distortion_type), "^.*[#/]", ""), STR(?expected_distortion_type)), "")) = "B"), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CandidateStudyCatalog_ObservedSignFlipType a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CandidateStudyCatalog ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CandidateStudyCatalog_ObservedSignFlipType" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:observedSignFlipType ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CandidateStudyCatalog .
    OPTIONAL { $this effortless-ntwf:isImported ?is_imported . }
    OPTIONAL { $this effortless-ntwf:observedDistortionType ?observed_distortion_type . OPTIONAL { ?observed_distortion_type erb:key ?observed_distortion_type__key . } }
                BIND(IF(COALESCE(?is_imported, false), (COALESCE((COALESCE(?observed_distortion_type__key, COALESCE(IF(isIRI(?observed_distortion_type), REPLACE(STR(?observed_distortion_type), "^.*[#/]", ""), STR(?observed_distortion_type)), "")) = "A"), false) || COALESCE((COALESCE(?observed_distortion_type__key, COALESCE(IF(isIRI(?observed_distortion_type), REPLACE(STR(?observed_distortion_type), "^.*[#/]", ""), STR(?observed_distortion_type)), "")) = "B"), false)), "") AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CandidateStudyCatalog_SignFlipPredictionMatch a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CandidateStudyCatalog ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CandidateStudyCatalog_SignFlipPredictionMatch" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:signFlipPredictionMatch ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CandidateStudyCatalog .
    OPTIONAL { $this effortless-ntwf:expectedSignFlip ?expected_sign_flip . }
    OPTIONAL { $this effortless-ntwf:isImported ?is_imported . }
    OPTIONAL { $this effortless-ntwf:observedSignFlipType ?observed_sign_flip_type . }
                BIND(IF(COALESCE((COALESCE(?is_imported, false) && COALESCE(?expected_sign_flip, false)), false), ?observed_sign_flip_type, "") AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CandidateStudyCatalog_IsDataReady a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CandidateStudyCatalog ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CandidateStudyCatalog_IsDataReady" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isDataReady ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CandidateStudyCatalog .
    OPTIONAL { $this effortless-ntwf:dataAcquisitionStatus ?data_acquisition_status . OPTIONAL { ?data_acquisition_status erb:key ?data_acquisition_status__key . } }
                BIND((COALESCE((COALESCE(?data_acquisition_status__key, COALESCE(IF(isIRI(?data_acquisition_status), REPLACE(STR(?data_acquisition_status), "^.*[#/]", ""), STR(?data_acquisition_status)), "")) = "downloaded"), false) || COALESCE((COALESCE(?data_acquisition_status__key, COALESCE(IF(isIRI(?data_acquisition_status), REPLACE(STR(?data_acquisition_status), "^.*[#/]", ""), STR(?data_acquisition_status)), "")) = "manual_only"), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for CaseCells ===
effortless-ntwf-shapes:CaseCells_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CaseCells ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CaseCells_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CaseCells .
    OPTIONAL { $this effortless-ntwf:caseCellId ?case_cell_id . }
                BIND(?case_cell_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CaseCells_CellSuccessRate a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CaseCells ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CaseCells_CellSuccessRate" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:cellSuccessRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CaseCells .
    OPTIONAL { $this effortless-ntwf:cases ?cases . }
    OPTIONAL { $this effortless-ntwf:successes ?successes . }
                BIND(IF(COALESCE((COALESCE(?cases, 0) = 0), false), 0, xsd:double(?successes / ?cases)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CaseCells_TotalCasesForTreatment a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CaseCells ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CaseCells_TotalCasesForTreatment" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:totalCasesForTreatment ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CaseCells .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:CaseCells .
                    ?child a effortless-ntwf:CaseCells .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentLabel ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:cases ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CaseCells_TreatmentExposureFraction a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CaseCells ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CaseCells_TreatmentExposureFraction" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:treatmentExposureFraction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CaseCells .
    OPTIONAL { $this effortless-ntwf:cases ?cases . }
    OPTIONAL { $this effortless-ntwf:totalCasesForTreatment ?total_cases_for_treatment . }
                BIND(IF(COALESCE((COALESCE(?total_cases_for_treatment, 0) = 0), false), "", xsd:double(?cases / ?total_cases_for_treatment)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CaseCells_IsValidIngestionCell a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CaseCells ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CaseCells_IsValidIngestionCell" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isValidIngestionCell ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CaseCells .
    OPTIONAL { $this effortless-ntwf:cases ?cases . }
    OPTIONAL { $this effortless-ntwf:successes ?successes . }
                BIND((COALESCE((COALESCE(?cases, 0) >= 0), false) && COALESCE((COALESCE(?successes, 0) >= 0), false) && COALESCE((COALESCE(?successes, 0) <= COALESCE(?cases, 0)), false)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Conclusions ===
effortless-ntwf-shapes:Conclusions_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Conclusions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Conclusions_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Conclusions .
    OPTIONAL { $this effortless-ntwf:conclusionId ?conclusion_id . }
                BIND(?conclusion_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Conclusions_LiveStatusConfirmed a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Conclusions ;
    sh:order 15 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Conclusions_LiveStatusConfirmed" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:liveStatusConfirmed ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Conclusions .
                OPTIONAL { $this effortless-ntwf:validatingHypothesis ?validating_hypothesis . }
                OPTIONAL { ?j0 a effortless-ntwf:DiscoveryFindings ; effortless-ntwf:hypothesisId ?j1 ; effortless-ntwf:isConfirmed ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?validating_hypothesis), "^.*[#/]", "")) || (?j0 = ?validating_hypothesis)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
