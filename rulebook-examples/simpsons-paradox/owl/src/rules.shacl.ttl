effortless-ntwf-shapes:StratumSummaries_WeightedStratumRate a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumSummaries_WeightedStratumRate" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:weightedStratumRate ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumSummaries .
    OPTIONAL { $this effortless-ntwf:stratumFraction ?stratum_fraction . OPTIONAL { ?stratum_fraction erb:key ?stratum_fraction__key . } }
    OPTIONAL { $this effortless-ntwf:stratumSuccessRate ?stratum_success_rate . }
                BIND(IF(COALESCE((COALESCE(COALESCE(?stratum_fraction__key, COALESCE(IF(isIRI(?stratum_fraction), REPLACE(STR(?stratum_fraction), "^.*[#/]", ""), STR(?stratum_fraction)), "")), 0) = ""), false), "", (?stratum_fraction * ?stratum_success_rate)) AS ?_result)
            }
        """ ;
    ] .
