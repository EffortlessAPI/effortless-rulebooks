effortless-ntwf-shapes:ModelSummary_DomainFlipGapSurvivesGeometryControl a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_DomainFlipGapSurvivesGeometryControl" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:domainFlipGapSurvivesGeometryControl ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
    OPTIONAL { $this effortless-ntwf:economicsHighImbalanceSignFlipCount ?economics_high_imbalance_sign_flip_count . }
    OPTIONAL { $this effortless-ntwf:epidemiologyHighImbalanceSignFlipRate ?epidemiology_high_imbalance_sign_flip_rate . }
                BIND((COALESCE((COALESCE(?economics_high_imbalance_sign_flip_count, 0) = 0), false) && COALESCE((COALESCE(?epidemiology_high_imbalance_sign_flip_rate, 0) > 0.15), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_CorpusPatternSupersededFailCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 15 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_CorpusPatternSupersededFailCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:corpusPatternSupersededFailCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:DiscoveryFindings .
                    OPTIONAL { ?child effortless-ntwf:hypothesisId ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:isConfirmed ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "H-econ-zero"))
                    FILTER(BOUND(?c2) && ?c2 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_lhs)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg2) WHERE {
                    ?child a effortless-ntwf:DiscoveryFindings .
                    OPTIONAL { ?child effortless-ntwf:hypothesisId ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:isConfirmed ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "H-domain-dist"))
                    FILTER(BOUND(?c2) && ?c2 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg2, 0) AS ?_rhs)
    BIND(?_lhs + ?_rhs AS ?_lhs)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg3) WHERE {
                    ?child a effortless-ntwf:DiscoveryFindings .
                    OPTIONAL { ?child effortless-ntwf:hypothesisId ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:isConfirmed ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "H-catalog-flip-prediction"))
                    FILTER(BOUND(?c2) && ?c2 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg3, 0) AS ?_rhs)
    BIND(?_lhs + ?_rhs AS ?_lhs)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg4) WHERE {
                    ?child a effortless-ntwf:DiscoveryFindings .
                    OPTIONAL { ?child effortless-ntwf:hypothesisId ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:isConfirmed ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "H-domain-flip-geometry-controlled"))
                    FILTER(BOUND(?c2) && ?c2 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg4, 0) AS ?_rhs)
    BIND(?_lhs + ?_rhs AS ?_lhs)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg5) WHERE {
                    ?child a effortless-ntwf:DiscoveryFindings .
                    OPTIONAL { ?child effortless-ntwf:hypothesisId ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:isConfirmed ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "H-econ-encoding-selection"))
                    FILTER(BOUND(?c2) && ?c2 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg5, 0) AS ?_rhs)
    BIND(?_lhs + ?_rhs AS ?_lhs)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg6) WHERE {
                    ?child a effortless-ntwf:DiscoveryFindings .
                    OPTIONAL { ?child effortless-ntwf:hypothesisId ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:isConfirmed ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "H-domain-profiles-stable"))
                    FILTER(BOUND(?c2) && ?c2 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg6, 0) AS ?_rhs)
    BIND(?_lhs + ?_rhs AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_ExpansionWave3DiscoveryNote a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 16 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_ExpansionWave3DiscoveryNote" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:expansionWave3DiscoveryNote ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
    OPTIONAL { $this effortless-ntwf:corpusPatternSupersededFailCount ?corpus_pattern_superseded_fail_count . OPTIONAL { ?corpus_pattern_superseded_fail_count erb:key ?corpus_pattern_superseded_fail_count__key . } }
    OPTIONAL { $this effortless-ntwf:economicsSignFlipCount ?economics_sign_flip_count . OPTIONAL { ?economics_sign_flip_count erb:key ?economics_sign_flip_count__key . } }
    OPTIONAL { $this effortless-ntwf:signFlipPredictionMatchRate ?sign_flip_prediction_match_rate . OPTIONAL { ?sign_flip_prediction_match_rate erb:key ?sign_flip_prediction_match_rate__key . } }
    OPTIONAL { $this effortless-ntwf:theoremCount ?theorem_count . OPTIONAL { ?theorem_count erb:key ?theorem_count__key . } }
    OPTIONAL { $this effortless-ntwf:typePredictionMatchRate ?type_prediction_match_rate . OPTIONAL { ?type_prediction_match_rate erb:key ?type_prediction_match_rate__key . } }
                BIND(CONCAT("superseded=", COALESCE(COALESCE(?corpus_pattern_superseded_fail_count__key, IF(isIRI(?corpus_pattern_superseded_fail_count), REPLACE(STR(?corpus_pattern_superseded_fail_count), "^.*[#/]", ""), STR(?corpus_pattern_superseded_fail_count))), ""), "; econFlips=", COALESCE(COALESCE(?economics_sign_flip_count__key, IF(isIRI(?economics_sign_flip_count), REPLACE(STR(?economics_sign_flip_count), "^.*[#/]", ""), STR(?economics_sign_flip_count))), ""), "; flipPred=", COALESCE(COALESCE(?sign_flip_prediction_match_rate__key, IF(isIRI(?sign_flip_prediction_match_rate), REPLACE(STR(?sign_flip_prediction_match_rate), "^.*[#/]", ""), STR(?sign_flip_prediction_match_rate))), ""), "; catalogExact=", COALESCE(COALESCE(?type_prediction_match_rate__key, IF(isIRI(?type_prediction_match_rate), REPLACE(STR(?type_prediction_match_rate), "^.*[#/]", ""), STR(?type_prediction_match_rate))), ""), "; theorems=", COALESCE(COALESCE(?theorem_count__key, IF(isIRI(?theorem_count), REPLACE(STR(?theorem_count), "^.*[#/]", ""), STR(?theorem_count))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for PhaseDiagramSummary ===
effortless-ntwf-shapes:PhaseDiagramSummary_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:PhaseDiagramSummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PhaseDiagramSummary_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PhaseDiagramSummary .
    OPTIONAL { $this effortless-ntwf:phaseDiagramId ?phase_diagram_id . }
                BIND(?phase_diagram_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:PhaseDiagramSummary_PhasePointCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:PhaseDiagramSummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PhaseDiagramSummary_PhasePointCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:phasePointCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PhaseDiagramSummary .
    OPTIONAL { $this effortless-ntwf:phaseTypeACount ?phase_type_a_count . }
    OPTIONAL { $this effortless-ntwf:phaseTypeBCount ?phase_type_b_count . }
    OPTIONAL { $this effortless-ntwf:phaseTypeCMinusCount ?phase_type_c_minus_count . }
    OPTIONAL { $this effortless-ntwf:phaseTypeCPlusCount ?phase_type_c_plus_count . }
    OPTIONAL { $this effortless-ntwf:phaseTypeDCount ?phase_type_d_count . }
                BIND(ROUND(((((?phase_type_a_count + ?phase_type_b_count) + ?phase_type_c_plus_count) + ?phase_type_c_minus_count) + ?phase_type_d_count)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:PhaseDiagramSummary_AllFiveTypesPresent a sh:NodeShape ;
    sh:targetClass effortless-ntwf:PhaseDiagramSummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PhaseDiagramSummary_AllFiveTypesPresent" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:allFiveTypesPresent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PhaseDiagramSummary .
    OPTIONAL { $this effortless-ntwf:phaseTypeACount ?phase_type_a_count . }
    OPTIONAL { $this effortless-ntwf:phaseTypeBCount ?phase_type_b_count . }
    OPTIONAL { $this effortless-ntwf:phaseTypeCMinusCount ?phase_type_c_minus_count . }
    OPTIONAL { $this effortless-ntwf:phaseTypeCPlusCount ?phase_type_c_plus_count . }
    OPTIONAL { $this effortless-ntwf:phaseTypeDCount ?phase_type_d_count . }
                BIND((COALESCE((COALESCE(?phase_type_a_count, 0) > 0), false) && COALESCE((COALESCE(?phase_type_b_count, 0) > 0), false) && COALESCE((COALESCE(?phase_type_c_plus_count, 0) > 0), false) && COALESCE((COALESCE(?phase_type_c_minus_count, 0) > 0), false) && COALESCE((COALESCE(?phase_type_d_count, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:PhaseDiagramSummary_PhaseTaxonomyWitness a sh:NodeShape ;
    sh:targetClass effortless-ntwf:PhaseDiagramSummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PhaseDiagramSummary_PhaseTaxonomyWitness" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:phaseTaxonomyWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PhaseDiagramSummary .
    OPTIONAL { $this effortless-ntwf:phaseTypeACount ?phase_type_a_count . OPTIONAL { ?phase_type_a_count erb:key ?phase_type_a_count__key . } }
    OPTIONAL { $this effortless-ntwf:phaseTypeBCount ?phase_type_b_count . OPTIONAL { ?phase_type_b_count erb:key ?phase_type_b_count__key . } }
    OPTIONAL { $this effortless-ntwf:phaseTypeCMinusCount ?phase_type_c_minus_count . OPTIONAL { ?phase_type_c_minus_count erb:key ?phase_type_c_minus_count__key . } }
    OPTIONAL { $this effortless-ntwf:phaseTypeCPlusCount ?phase_type_c_plus_count . OPTIONAL { ?phase_type_c_plus_count erb:key ?phase_type_c_plus_count__key . } }
    OPTIONAL { $this effortless-ntwf:phaseTypeDCount ?phase_type_d_count . OPTIONAL { ?phase_type_d_count erb:key ?phase_type_d_count__key . } }
                BIND(CONCAT("A:", COALESCE(COALESCE(?phase_type_a_count__key, IF(isIRI(?phase_type_a_count), REPLACE(STR(?phase_type_a_count), "^.*[#/]", ""), STR(?phase_type_a_count))), ""), " B:", COALESCE(COALESCE(?phase_type_b_count__key, IF(isIRI(?phase_type_b_count), REPLACE(STR(?phase_type_b_count), "^.*[#/]", ""), STR(?phase_type_b_count))), ""), " C+:", COALESCE(COALESCE(?phase_type_c_plus_count__key, IF(isIRI(?phase_type_c_plus_count), REPLACE(STR(?phase_type_c_plus_count), "^.*[#/]", ""), STR(?phase_type_c_plus_count))), ""), " C-:", COALESCE(COALESCE(?phase_type_c_minus_count__key, IF(isIRI(?phase_type_c_minus_count), REPLACE(STR(?phase_type_c_minus_count), "^.*[#/]", ""), STR(?phase_type_c_minus_count))), ""), " D:", COALESCE(COALESCE(?phase_type_d_count__key, IF(isIRI(?phase_type_d_count), REPLACE(STR(?phase_type_d_count), "^.*[#/]", ""), STR(?phase_type_d_count))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:PhaseDiagramSummary_PhaseWitnessNote a sh:NodeShape ;
    sh:targetClass effortless-ntwf:PhaseDiagramSummary ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_PhaseDiagramSummary_PhaseWitnessNote" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:phaseWitnessNote ?_result .
            }
            WHERE {
    $this a effortless-ntwf:PhaseDiagramSummary .
    OPTIONAL { $this effortless-ntwf:allFiveTypesPresent ?all_five_types_present . }
                BIND(IF(COALESCE(?all_five_types_present, false), "PASS: all five distortion types populated in parameter space", "FAIL: missing distortion type in grid") AS ?_result)
            }
        """ ;
    ] .

# === Rules for ResearchTraditions ===
effortless-ntwf-shapes:ResearchTraditions_IllustratedByStudyTitle a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ResearchTraditions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ResearchTraditions_IllustratedByStudyTitle" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:illustratedByStudyTitle ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ResearchTraditions .
                OPTIONAL { $this effortless-ntwf:illustratedByStudy ?illustrated_by_study . }
                OPTIONAL { ?j0 a effortless-ntwf:Studies ; effortless-ntwf:studyId ?j1 ; effortless-ntwf:title ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?illustrated_by_study), "^.*[#/]", "")) || (?j0 = ?illustrated_by_study)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
