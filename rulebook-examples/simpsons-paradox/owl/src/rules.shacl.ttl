                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child effortless-ntwf:cases ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "B"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumSummaries_AllocationFractionA a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumSummaries_AllocationFractionA" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:allocationFractionA ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumSummaries .
    OPTIONAL { $this effortless-ntwf:treatmentACasesHere ?treatment_a_cases_here . }
    OPTIONAL { $this effortless-ntwf:treatmentATotalCases ?treatment_a_total_cases . }
                BIND(IF(COALESCE((COALESCE(?treatment_a_total_cases, 0) = 0), false), "", xsd:double(?treatment_a_cases_here / ?treatment_a_total_cases)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumSummaries_AllocationFractionB a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumSummaries_AllocationFractionB" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:allocationFractionB ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumSummaries .
    OPTIONAL { $this effortless-ntwf:treatmentBCasesHere ?treatment_b_cases_here . }
    OPTIONAL { $this effortless-ntwf:treatmentBTotalCases ?treatment_b_total_cases . }
                BIND(IF(COALESCE((COALESCE(?treatment_b_total_cases, 0) = 0), false), "", xsd:double(?treatment_b_cases_here / ?treatment_b_total_cases)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumSummaries_AllocationBias a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumSummaries_AllocationBias" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:allocationBias ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumSummaries .
    OPTIONAL { $this effortless-ntwf:allocationFractionA ?allocation_fraction_a . OPTIONAL { ?allocation_fraction_a erb:key ?allocation_fraction_a__key . } }
    OPTIONAL { $this effortless-ntwf:allocationFractionB ?allocation_fraction_b . }
                BIND(IF(COALESCE((COALESCE(COALESCE(?allocation_fraction_a__key, COALESCE(IF(isIRI(?allocation_fraction_a), REPLACE(STR(?allocation_fraction_a), "^.*[#/]", ""), STR(?allocation_fraction_a)), "")), 0) = ""), false), "", (?allocation_fraction_a - ?allocation_fraction_b)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumSummaries_StratumGap a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumSummaries_StratumGap" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:stratumGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumSummaries .
    OPTIONAL { $this effortless-ntwf:stratumRateA ?stratum_rate_a . OPTIONAL { ?stratum_rate_a erb:key ?stratum_rate_a__key . } }
    OPTIONAL { $this effortless-ntwf:stratumRateB ?stratum_rate_b . }
                BIND(IF(COALESCE((COALESCE(COALESCE(?stratum_rate_a__key, COALESCE(IF(isIRI(?stratum_rate_a), REPLACE(STR(?stratum_rate_a), "^.*[#/]", ""), STR(?stratum_rate_a)), "")), 0) = ""), false), "", (?stratum_rate_a - ?stratum_rate_b)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumSummaries_WeightedStratumGap a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_StratumSummaries_WeightedStratumGap" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:weightedStratumGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:StratumSummaries .
    OPTIONAL { $this effortless-ntwf:stratumFraction ?stratum_fraction . }
    OPTIONAL { $this effortless-ntwf:stratumGap ?stratum_gap . OPTIONAL { ?stratum_gap erb:key ?stratum_gap__key . } }
                BIND(IF(COALESCE((COALESCE(COALESCE(?stratum_gap__key, COALESCE(IF(isIRI(?stratum_gap), REPLACE(STR(?stratum_gap), "^.*[#/]", ""), STR(?stratum_gap)), "")), 0) = ""), false), "", (?stratum_gap * ?stratum_fraction)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:StratumSummaries_AbsAllocationBias a sh:NodeShape ;
    sh:targetClass effortless-ntwf:StratumSummaries ;
    sh:order 4 ;
    sh:rule [
