effortless-ntwf-shapes:TreatmentRankings_IsSweepFragile a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_IsSweepFragile" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isSweepFragile ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:allocationDistortion ?allocation_distortion . }
    OPTIONAL { $this effortless-ntwf:allocationFragility ?allocation_fragility . }
    OPTIONAL { $this effortless-ntwf:distortionType ?distortion_type . OPTIONAL { ?distortion_type erb:key ?distortion_type__key . } }
    OPTIONAL { $this effortless-ntwf:signalPurity ?signal_purity . }
    OPTIONAL { $this effortless-ntwf:sweepPooledGapRange ?sweep_pooled_gap_range . }
                BIND((COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "D"), false) && COALESCE((COALESCE(?signal_purity, 0) = 1), false) && COALESCE((COALESCE(?allocation_distortion, 0) = 0), false) && COALESCE((COALESCE(?sweep_pooled_gap_range, 0) > 0.3), false) && COALESCE((COALESCE(?allocation_fragility, 0) >= 10), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_StudyDomain a sh:NodeShape ;
