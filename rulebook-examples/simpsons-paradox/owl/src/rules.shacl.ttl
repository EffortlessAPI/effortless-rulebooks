effortless-ntwf-shapes:ModelSummary_EconomicsExpectedAMismatchRate a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_EconomicsExpectedAMismatchRate" ;
        sh:construct """
