                OPTIONAL { ?j0 a effortless-ntwf:Loops ; effortless-ntwf:loopId ?j1 ; effortless-ntwf:commitDate ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?witnessed_in_loop), "^.*[#/]", "")) || (?j0 = ?witnessed_in_loop)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Conclusions_WitnessedInLoopGitTag a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Conclusions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Conclusions_WitnessedInLoopGitTag" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:witnessedInLoopGitTag ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Conclusions .
                OPTIONAL { $this effortless-ntwf:witnessedInLoop ?witnessed_in_loop . }
                OPTIONAL { ?j0 a effortless-ntwf:Loops ; effortless-ntwf:loopId ?j1 ; effortless-ntwf:gitTag ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?witnessed_in_loop), "^.*[#/]", "")) || (?j0 = ?witnessed_in_loop)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Conclusions_InvariantProtectingCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Conclusions ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Conclusions_InvariantProtectingCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:invariantProtectingCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Conclusions .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Conclusions .
                    ?child a effortless-ntwf:InvariantChecks .
                    ?child effortless-ntwf:protectsConclusion ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:conclusionId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ConfounderDistortionTimeline ===
effortless-ntwf-shapes:ConfounderDistortionTimeline_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConfounderDistortionTimeline ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConfounderDistortionTimeline_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConfounderDistortionTimeline .
    OPTIONAL { $this effortless-ntwf:cellId ?cell_id . }
                BIND(?cell_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ConfounderDistortionTimeline_TypeDFraction a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConfounderDistortionTimeline ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConfounderDistortionTimeline_TypeDFraction" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:typeDFraction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConfounderDistortionTimeline .
    OPTIONAL { $this effortless-ntwf:studyCount ?study_count . OPTIONAL { ?study_count erb:key ?study_count__key . } }
    OPTIONAL { $this effortless-ntwf:typeDCount ?type_d_count . }
                BIND(IF(COALESCE((COALESCE((COALESCE(COALESCE(?study_count__key, COALESCE(IF(isIRI(?study_count), REPLACE(STR(?study_count), "^.*[#/]", ""), STR(?study_count)), "")), 0) = ""), false) || COALESCE((COALESCE(?study_count, 0) = 0), false)), false), "", xsd:double(?type_d_count / ?study_count)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ConfounderDistortionTimeline_SignFlipFraction a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConfounderDistortionTimeline ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConfounderDistortionTimeline_SignFlipFraction" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:signFlipFraction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConfounderDistortionTimeline .
    OPTIONAL { $this effortless-ntwf:signFlipCount ?sign_flip_count . }
    OPTIONAL { $this effortless-ntwf:studyCount ?study_count . OPTIONAL { ?study_count erb:key ?study_count__key . } }
                BIND(IF(COALESCE((COALESCE((COALESCE(COALESCE(?study_count__key, COALESCE(IF(isIRI(?study_count), REPLACE(STR(?study_count), "^.*[#/]", ""), STR(?study_count)), "")), 0) = ""), false) || COALESCE((COALESCE(?study_count, 0) = 0), false)), false), "", xsd:double(?sign_flip_count / ?study_count)) AS ?_result)
            }
        """ ;
    ] .
