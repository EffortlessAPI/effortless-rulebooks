effortless-ntwf-shapes:ModelSummary_CorrectedGapInvariantFailCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_CorrectedGapInvariantFailCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:correctedGapInvariantFailCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:SweepStudySummary .
                    OPTIONAL { ?child effortless-ntwf:sweepCorrectedGapRange ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER((BOUND(?c0) && xsd:double(STR(?c0)) >= 0.0001))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_FalsePositiveExplainedCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_FalsePositiveExplainedCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:falsePositiveExplainedCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:isParadoxExplained ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:isSignFlip ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    FILTER(BOUND(?c2) && ?c2 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_lhs)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg2) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:isParadoxExplained ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:isSignFlip ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child effortless-ntwf:stratumCausalRole ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER((COALESCE(?c4__key, STR(?c4)) != "confounder"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg2, 0) AS ?_rhs)
    BIND(?_lhs + ?_rhs AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_UnexplainedConfounderSignFlipCount a sh:NodeShape ;
