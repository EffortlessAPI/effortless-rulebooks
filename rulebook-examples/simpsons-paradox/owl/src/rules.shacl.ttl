                    OPTIONAL { ?child effortless-ntwf:ingestionCellParity ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IngestionSummary_AllStudiesStructural a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IngestionSummary ;
    sh:order 4 ;
