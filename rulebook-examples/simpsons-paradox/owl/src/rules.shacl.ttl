effortless-ntwf-shapes:ModelSummary_AvgSignalPurity a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_AvgSignalPurity" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:avgSignalPurity ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (SUM(?v) AS ?_agg1) WHERE {
                        ?child a effortless-ntwf:TreatmentRankings .
                        OPTIONAL { ?child effortless-ntwf:signalPurity ?raw . }
                        BIND(IF(BOUND(?raw), xsd:double(STR(?raw)), 0.0) AS ?v)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_lhs)
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg2) WHERE {
                        ?child a effortless-ntwf:TreatmentRankings .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg2, 0) AS ?_rhs)
    BIND(IF(BOUND(?_rhs) && ?_rhs != 0, ?_lhs / ?_rhs, 0.0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_SweepCorrectedGapMax a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_SweepCorrectedGapMax" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:sweepCorrectedGapMax ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:AllocationSweep .
                    OPTIONAL { ?child effortless-ntwf:studyId ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:sweepCorrectedGap ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "kidney-1986"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_SweepCorrectedGapMin a sh:NodeShape ;
