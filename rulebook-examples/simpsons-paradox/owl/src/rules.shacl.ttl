# Rule for StudyCount - parse error: Expected TokenType.LPAREN, got TokenType.COMMA at position 63

# === Rules for CorpusBalance ===
effortless-ntwf-shapes:CorpusBalance_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusBalance ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusBalance_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusBalance .
    OPTIONAL { $this effortless-ntwf:balanceId ?balance_id . }
                BIND(?balance_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusBalance_TotalStudyCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusBalance ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusBalance_TotalStudyCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:totalStudyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusBalance .
    OPTIONAL { $this effortless-ntwf:controlStudyCount ?control_study_count . }
    OPTIONAL { $this effortless-ntwf:simpsonStudyCount ?simpson_study_count . }
                BIND(ROUND((?simpson_study_count + ?control_study_count)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusBalance_SimpsonStudyCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusBalance ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusBalance_SimpsonStudyCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:simpsonStudyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusBalance .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:Studies .
                    OPTIONAL { ?child effortless-ntwf:isControlStudy ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER(BOUND(?c0) && ?c0 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusBalance_ControlStudyCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusBalance ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusBalance_ControlStudyCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:controlStudyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusBalance .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:Studies .
                    OPTIONAL { ?child effortless-ntwf:isControlStudy ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:CorpusBalance_ControlFraction a sh:NodeShape ;
    sh:targetClass effortless-ntwf:CorpusBalance ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_CorpusBalance_ControlFraction" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:controlFraction ?_result .
            }
            WHERE {
    $this a effortless-ntwf:CorpusBalance .
    OPTIONAL { $this effortless-ntwf:controlStudyCount ?control_study_count . }
    OPTIONAL { $this effortless-ntwf:totalStudyCount ?total_study_count . }
                BIND(IF(COALESCE((COALESCE(?total_study_count, 0) = 0), false), 0, xsd:double(?control_study_count / ?total_study_count)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for CorpusCatalogSummary ===
effortless-ntwf-shapes:CorpusCatalogSummary_Name a sh:NodeShape ;
