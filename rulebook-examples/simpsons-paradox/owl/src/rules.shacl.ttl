                    OPTIONAL { ?child effortless-ntwf:ingestionStatus ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "imported"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
