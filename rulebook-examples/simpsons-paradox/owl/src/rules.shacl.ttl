effortless-ntwf-shapes:ConfounderDistortionTimeline_IdentityDisplayName a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConfounderDistortionTimeline ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConfounderDistortionTimeline_IdentityDisplayName" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:identityDisplayName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConfounderDistortionTimeline .
                OPTIONAL { $this effortless-ntwf:confounderIdentity ?confounder_identity . }
                OPTIONAL { ?j0 a effortless-ntwf:ConfounderIdentities ; effortless-ntwf:confounderIdentityId ?j1 ; effortless-ntwf:displayName ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?confounder_identity), "^.*[#/]", "")) || (?j0 = ?confounder_identity)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ConfounderDistortionTimeline_MechanismClass a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConfounderDistortionTimeline ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConfounderDistortionTimeline_MechanismClass" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:mechanismClass ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConfounderDistortionTimeline .
                OPTIONAL { $this effortless-ntwf:confounderIdentity ?confounder_identity . }
                OPTIONAL { ?j0 a effortless-ntwf:ConfounderIdentities ; effortless-ntwf:confounderIdentityId ?j1 ; effortless-ntwf:mechanismClass ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?confounder_identity), "^.*[#/]", "")) || (?j0 = ?confounder_identity)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ConfounderDistortionTimeline_IdentityEarliestDecade a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConfounderDistortionTimeline ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConfounderDistortionTimeline_IdentityEarliestDecade" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:identityEarliestDecade ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConfounderDistortionTimeline .
                OPTIONAL {
                    SELECT $this (MIN(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MIN(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:ConfounderDistortionTimeline .
                    ?child a effortless-ntwf:ConfounderDistortionTimeline .
                    ?child effortless-ntwf:confounderIdentity ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:confounderIdentity ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:validTimeDecade ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ConfounderDistortionTimeline_IdentityLatestDecade a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConfounderDistortionTimeline ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConfounderDistortionTimeline_IdentityLatestDecade" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:identityLatestDecade ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConfounderDistortionTimeline .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:ConfounderDistortionTimeline .
                    ?child a effortless-ntwf:ConfounderDistortionTimeline .
                    ?child effortless-ntwf:confounderIdentity ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:confounderIdentity ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:validTimeDecade ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ConfounderDistortionTimeline_DriftDirection a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ConfounderDistortionTimeline ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ConfounderDistortionTimeline_DriftDirection" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:driftDirection ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ConfounderDistortionTimeline .
    OPTIONAL { $this effortless-ntwf:identityEarliestDecade ?identity_earliest_decade . }
    OPTIONAL { $this effortless-ntwf:identityEarliestTypeDFraction ?identity_earliest_type_d_fraction . OPTIONAL { ?identity_earliest_type_d_fraction erb:key ?identity_earliest_type_d_fraction__key . } }
    OPTIONAL { $this effortless-ntwf:identityLatestDecade ?identity_latest_decade . }
    OPTIONAL { $this effortless-ntwf:identityLatestTypeDFraction ?identity_latest_type_d_fraction . OPTIONAL { ?identity_latest_type_d_fraction erb:key ?identity_latest_type_d_fraction__key . } }
                BIND(IF(COALESCE((COALESCE(?identity_earliest_decade, 0) = COALESCE(?identity_latest_decade, 0)), false), "single-decade", IF(COALESCE((COALESCE((COALESCE(COALESCE(?identity_earliest_type_d_fraction__key, COALESCE(IF(isIRI(?identity_earliest_type_d_fraction), REPLACE(STR(?identity_earliest_type_d_fraction), "^.*[#/]", ""), STR(?identity_earliest_type_d_fraction)), "")), 0) = ""), false) || COALESCE((COALESCE(COALESCE(?identity_latest_type_d_fraction__key, COALESCE(IF(isIRI(?identity_latest_type_d_fraction), REPLACE(STR(?identity_latest_type_d_fraction), "^.*[#/]", ""), STR(?identity_latest_type_d_fraction)), "")), 0) = ""), false)), false), "", IF(COALESCE((COALESCE(?identity_latest_type_d_fraction, 0) > COALESCE((?identity_earliest_type_d_fraction + 0.05), 0)), false), "rising", IF(COALESCE((COALESCE(?identity_latest_type_d_fraction, 0) < COALESCE((?identity_earliest_type_d_fraction - 0.05), 0)), false), "falling", "flat")))) AS ?_result)
            }
        """ ;
    ] .
# Rule for IdentityEarliestTypeDFraction - parse error: unsupported lookup sub-expression: FuncCall
# Rule for IdentityLatestTypeDFraction - parse error: unsupported lookup sub-expression: FuncCall

# === Rules for ConfounderIdentities ===
