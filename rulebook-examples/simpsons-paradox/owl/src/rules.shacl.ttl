            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:expansionWave1EconomicsExpectedACount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:CandidateStudyCatalog .
                    OPTIONAL { ?child effortless-ntwf:expansionWave ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:domain ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child effortless-ntwf:isImported ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    OPTIONAL { ?child effortless-ntwf:expectedDistortionType ?c6 . OPTIONAL { ?c6 erb:key ?c6__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "expansion-wave-1"))
                    FILTER((COALESCE(?c2__key, STR(?c2)) = "economics"))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    FILTER((COALESCE(?c6__key, STR(?c6)) = "A"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_ExpansionWave1EconomicsExpectedADCount a sh:NodeShape ;
