effortless-ntwf-shapes:TreatmentRankings_IsLatentOnlyFlip a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_IsLatentOnlyFlip" ;
