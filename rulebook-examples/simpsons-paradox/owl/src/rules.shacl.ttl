    OPTIONAL { $this effortless-ntwf:sumAllocationDistortion ?sum_allocation_distortion . }
                BIND(IF(COALESCE((COALESCE((COALESCE(COALESCE(?study_count__key, COALESCE(IF(isIRI(?study_count), REPLACE(STR(?study_count), "^.*[#/]", ""), STR(?study_count)), "")), 0) = ""), false) || COALESCE((COALESCE(?study_count, 0) = 0), false)), false), "", xsd:double(?sum_allocation_distortion / ?study_count)) AS ?_result)
            }
