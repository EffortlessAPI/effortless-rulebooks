effortless-ntwf-shapes:SweepStudySummary_InvariantWitness a sh:NodeShape ;
    sh:targetClass effortless-ntwf:SweepStudySummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_SweepStudySummary_InvariantWitness" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:invariantWitness ?_result .
            }
            WHERE {
    $this a effortless-ntwf:SweepStudySummary .
    OPTIONAL { $this effortless-ntwf:sweepCorrectedGapRange ?sweep_corrected_gap_range . }
                BIND(IF(COALESCE((COALESCE(?sweep_corrected_gap_range, 0) < 0.0001), false), "PASS: CorrectedGap invariant across allocation sweep", "FAIL: CorrectedGap varies — formula error") AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:SweepStudySummary_SweepStratumLabel a sh:NodeShape ;
