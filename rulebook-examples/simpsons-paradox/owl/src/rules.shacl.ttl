            CONSTRUCT {
                $this effortless-ntwf:pioneeringResearcherName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Methodology .
                OPTIONAL { $this effortless-ntwf:pioneeringResearcher ?pioneering_researcher . }
                OPTIONAL { ?j0 a effortless-ntwf:Researchers ; effortless-ntwf:researcherId ?j1 ; effortless-ntwf:name ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?pioneering_researcher), "^.*[#/]", "")) || (?j0 = ?pioneering_researcher)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Methodology_PioneeringResearcherAffiliation a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Methodology ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Methodology_PioneeringResearcherAffiliation" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:pioneeringResearcherAffiliation ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Methodology .
                OPTIONAL { $this effortless-ntwf:pioneeringResearcher ?pioneering_researcher . }
                OPTIONAL { ?j0 a effortless-ntwf:Researchers ; effortless-ntwf:researcherId ?j1 ; effortless-ntwf:affiliation ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR(?pioneering_researcher), "^.*[#/]", "")) || (?j0 = ?pioneering_researcher)) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:Methodology_LoopCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Methodology ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Methodology_LoopCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:loopCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Methodology .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:Methodology .
                    ?child a effortless-ntwf:Loops .
                    ?child effortless-ntwf:traditionId ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:traditionId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

# === Rules for ModelSummary ===
effortless-ntwf-shapes:ModelSummary_Name a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_Name" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
    OPTIONAL { $this effortless-ntwf:modelSummaryId ?model_summary_id . }
                BIND(?model_summary_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_ReversalCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_ReversalCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:reversalCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:isReversal ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_NonReversalCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_NonReversalCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:nonReversalCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:isReversal ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER(BOUND(?c0) && ?c0 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_StudyCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_StudyCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:studyCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
    OPTIONAL { $this effortless-ntwf:nonReversalCount ?non_reversal_count . }
    OPTIONAL { $this effortless-ntwf:reversalCount ?reversal_count . }
                BIND(ROUND((?reversal_count + ?non_reversal_count)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_ExplainedCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_ExplainedCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:explainedCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:isParadoxExplained ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:ModelSummary_TotalParadoxStrength a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_TotalParadoxStrength" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:totalParadoxStrength ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:treatmentA ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:paradoxStrength ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "A"))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
