effortless-ntwf-shapes:IngestionSummary_CorpusCellCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IngestionSummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IngestionSummary_CorpusCellCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:corpusCellCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IngestionSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        ?child a effortless-ntwf:CaseCells .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IngestionSummary_ValidCellCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IngestionSummary ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IngestionSummary_ValidCellCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:validCellCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:IngestionSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:CaseCells .
                    OPTIONAL { ?child effortless-ntwf:isValidIngestionCell ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:IngestionSummary_AllCellsValid a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IngestionSummary ;
