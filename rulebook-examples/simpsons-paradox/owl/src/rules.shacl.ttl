    OPTIONAL { $this effortless-ntwf:pooledGapCrossesZero ?pooled_gap_crosses_zero . }
                BIND(IF(COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = ""), false), "", (COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "D"), false) && COALESCE((COALESCE(?pooled_gap_crosses_zero, false) = true), false))) AS ?_result)
