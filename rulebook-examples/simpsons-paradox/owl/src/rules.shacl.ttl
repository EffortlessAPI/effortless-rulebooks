    $this a effortless-ntwf:IngestionSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:Studies .
                    OPTIONAL { ?child effortless-ntwf:ingestionCompliance ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "all"))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
