effortless-ntwf-shapes:IngestionSummary_RealStudyCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:IngestionSummary ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_IngestionSummary_RealStudyCount" ;
