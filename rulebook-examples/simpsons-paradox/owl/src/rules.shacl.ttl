                OPTIONAL { ?j3 a effortless-ntwf:IdentityClusterSummaries ; effortless-ntwf:identityClusterId ?j4 ; effortless-ntwf:typeDCount ?j5 . FILTER((REPLACE(STR(?j4), "^.*[#/]", "") = REPLACE(STR("cluster-id-geographic-composition"), "^.*[#/]", "")) || (?j3 = "cluster-id-geographic-composition")) }
                OPTIONAL { ?j6 a effortless-ntwf:IdentityClusterSummaries ; effortless-ntwf:identityClusterId ?j7 ; effortless-ntwf:studyCount ?j8 . FILTER((REPLACE(STR(?j7), "^.*[#/]", "") = REPLACE(STR("cluster-id-geographic-composition"), "^.*[#/]", "")) || (?j6 = "cluster-id-geographic-composition")) }
                BIND(IF((?j2 = 0), "", xsd:double(?j5 / ?j8)) AS ?_result)
            }
        """ ;
    ] .
