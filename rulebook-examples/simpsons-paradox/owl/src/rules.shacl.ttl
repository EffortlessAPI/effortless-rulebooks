                    OPTIONAL { ?child effortless-ntwf:distortionType ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:latentFlipPotential ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER((COALESCE(?c0__key, STR(?c0)) = "D"))
                    FILTER(BOUND(?c2) && ?c2 = false)
