    OPTIONAL { $this effortless-ntwf:stratumCount ?stratum_count . }
                BIND(IF(COALESCE((COALESCE(?stratum_count, 0) = 0), false), "", (?reversal_intensity - 0.5)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_SignedPooledGap a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_SignedPooledGap" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:signedPooledGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:pooledRateA ?pooled_rate_a . OPTIONAL { ?pooled_rate_a erb:key ?pooled_rate_a__key . } }
    OPTIONAL { $this effortless-ntwf:pooledRateB ?pooled_rate_b . }
                BIND(IF(COALESCE((COALESCE(COALESCE(?pooled_rate_a__key, COALESCE(IF(isIRI(?pooled_rate_a), REPLACE(STR(?pooled_rate_a), "^.*[#/]", ""), STR(?pooled_rate_a)), "")), 0) = ""), false), "", (?pooled_rate_a - ?pooled_rate_b)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_WeightedStratumGapSum a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_WeightedStratumGapSum" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:weightedStratumGapSum ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:StratumSummaries .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentA ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:weightedStratumGap ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_IsSignFlip a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_IsSignFlip" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:isSignFlip ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:signedPooledGap ?signed_pooled_gap . }
    OPTIONAL { $this effortless-ntwf:weightedStratumGapSum ?weighted_stratum_gap_sum . OPTIONAL { ?weighted_stratum_gap_sum erb:key ?weighted_stratum_gap_sum__key . } }
                BIND(IF(COALESCE((COALESCE(COALESCE(?weighted_stratum_gap_sum__key, COALESCE(IF(isIRI(?weighted_stratum_gap_sum), REPLACE(STR(?weighted_stratum_gap_sum), "^.*[#/]", ""), STR(?weighted_stratum_gap_sum)), "")), 0) = ""), false), "", IF(COALESCE((COALESCE(?weighted_stratum_gap_sum, 0) > 0), false), (COALESCE(?signed_pooled_gap, 0) < 0), (COALESCE(?signed_pooled_gap, 0) > 0))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_AllocationDistortion a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_AllocationDistortion" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:allocationDistortion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:signedPooledGap ?signed_pooled_gap . }
    OPTIONAL { $this effortless-ntwf:weightedStratumGapSum ?weighted_stratum_gap_sum . OPTIONAL { ?weighted_stratum_gap_sum erb:key ?weighted_stratum_gap_sum__key . } }
                BIND(IF(COALESCE((COALESCE(COALESCE(?weighted_stratum_gap_sum__key, COALESCE(IF(isIRI(?weighted_stratum_gap_sum), REPLACE(STR(?weighted_stratum_gap_sum), "^.*[#/]", ""), STR(?weighted_stratum_gap_sum)), "")), 0) = ""), false), "", ABS((?weighted_stratum_gap_sum - ?signed_pooled_gap))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_DistortionType a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_DistortionType" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:distortionType ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:allocationDistortion ?allocation_distortion . OPTIONAL { ?allocation_distortion erb:key ?allocation_distortion__key . } }
    OPTIONAL { $this effortless-ntwf:correctedGap ?corrected_gap . }
    OPTIONAL { $this effortless-ntwf:isSignFlip ?is_sign_flip . }
    OPTIONAL { $this effortless-ntwf:isStratumUnanimous ?is_stratum_unanimous . }
    OPTIONAL { $this effortless-ntwf:signedPooledGap ?signed_pooled_gap . }
                BIND(IF(COALESCE((COALESCE(COALESCE(?allocation_distortion__key, COALESCE(IF(isIRI(?allocation_distortion), REPLACE(STR(?allocation_distortion), "^.*[#/]", ""), STR(?allocation_distortion)), "")), 0) = ""), false), "", IF(COALESCE(?is_sign_flip, false), IF(COALESCE(?is_stratum_unanimous, false), "A", "B"), IF(COALESCE((COALESCE((!(COALESCE(?is_sign_flip, false))), false) && COALESCE((COALESCE(?allocation_distortion, 0) > 0.01), false) && COALESCE(COALESCE((ABS(?signed_pooled_gap) > (ABS(?corrected_gap) + 0.001)), false), false)), false), "C+", IF(COALESCE((COALESCE((!(COALESCE(?is_sign_flip, false))), false) && COALESCE((COALESCE(?allocation_distortion, 0) > 0.01), false) && COALESCE(COALESCE((ABS(?signed_pooled_gap) < (ABS(?corrected_gap) - 0.001)), false), false)), false), "C-", "D")))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_PolicyImplication a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_PolicyImplication" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:policyImplication ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:distortionType ?distortion_type . OPTIONAL { ?distortion_type erb:key ?distortion_type__key . } }
                BIND(IF(COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = ""), false), "", IF(COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "A"), false), "stratify-immediately", IF(COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "B"), false), "investigate-confounder", IF(COALESCE((COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "C+"), false) || COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "C-"), false)), false), "check-allocation-bias", "pooled-analysis-trustworthy")))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_CorrectedGap a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_CorrectedGap" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:correctedGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:weightedStratumGapSum ?weighted_stratum_gap_sum . }
                BIND(?weighted_stratum_gap_sum AS ?_result)
            }
        """ ;
