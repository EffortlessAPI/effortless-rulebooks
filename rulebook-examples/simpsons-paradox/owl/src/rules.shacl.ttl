            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL { ?j0 a effortless-ntwf:IdentityClusterSummaries ; effortless-ntwf:identityClusterId ?j1 ; effortless-ntwf:studyCount ?j2 . FILTER((REPLACE(STR(?j1), "^.*[#/]", "") = REPLACE(STR("cluster-id-selection-frailty"), "^.*[#/]", "")) || (?j0 = "cluster-id-selection-frailty")) }
                BIND(?j2 AS ?_result)
            }
        """ ;
    ] .
