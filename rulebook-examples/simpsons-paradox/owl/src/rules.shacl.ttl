effortless-ntwf-shapes:ModelSummary_ContestedOrMediatorExplainedCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:ModelSummary ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ModelSummary_ContestedOrMediatorExplainedCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:contestedOrMediatorExplainedCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:ModelSummary .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                    ?child a effortless-ntwf:TreatmentRankings .
                    OPTIONAL { ?child effortless-ntwf:isSignFlip ?c0 . OPTIONAL { ?c0 erb:key ?c0__key . } }
                    OPTIONAL { ?child effortless-ntwf:isParadoxExplained ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child effortless-ntwf:adjustmentAppropriate ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER(BOUND(?c0) && ?c0 = true)
                    FILTER(BOUND(?c2) && ?c2 = true)
                    FILTER(BOUND(?c4) && ?c4 = false)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
