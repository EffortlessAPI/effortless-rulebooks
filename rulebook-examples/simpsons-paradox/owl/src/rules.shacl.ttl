    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:distortionType ?distortion_type . OPTIONAL { ?distortion_type erb:key ?distortion_type__key . } }
                BIND(IF(COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = ""), false), "", IF(COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "A"), false), "use-corrected-winner", IF(COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "B"), false), "use-corrected-winner-with-caution", IF(COALESCE((COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "C+"), false) || COALESCE((COALESCE(?distortion_type__key, COALESCE(IF(isIRI(?distortion_type), REPLACE(STR(?distortion_type), "^.*[#/]", ""), STR(?distortion_type)), "")) = "C-"), false)), false), "check-allocation-bias", "pooled-analysis-trustworthy")))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_AllocationDirection a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_AllocationDirection" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:allocationDirection ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:correctedGap ?corrected_gap . OPTIONAL { ?corrected_gap erb:key ?corrected_gap__key . } }
    OPTIONAL { $this effortless-ntwf:isSignFlip ?is_sign_flip . }
    OPTIONAL { $this effortless-ntwf:signedPooledGap ?signed_pooled_gap . }
                BIND(IF(COALESCE((COALESCE(COALESCE(?corrected_gap__key, COALESCE(IF(isIRI(?corrected_gap), REPLACE(STR(?corrected_gap), "^.*[#/]", ""), STR(?corrected_gap)), "")), 0) = ""), false), "", IF(COALESCE(?is_sign_flip, false), "reversal", IF(COALESCE(COALESCE((ABS(?signed_pooled_gap) > (ABS(?corrected_gap) + 0.001)), false), false), "amplification", IF(COALESCE(COALESCE((ABS(?signed_pooled_gap) < (ABS(?corrected_gap) - 0.001)), false), false), "compression", "neutral")))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_SignalPurity a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_SignalPurity" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:signalPurity ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:allocationDistortion ?allocation_distortion . }
    OPTIONAL { $this effortless-ntwf:correctedGap ?corrected_gap . OPTIONAL { ?corrected_gap erb:key ?corrected_gap__key . } }
                BIND(IF(COALESCE((COALESCE(COALESCE(?corrected_gap__key, COALESCE(IF(isIRI(?corrected_gap), REPLACE(STR(?corrected_gap), "^.*[#/]", ""), STR(?corrected_gap)), "")), 0) = ""), false), "", IF(COALESCE((COALESCE((ABS(?corrected_gap) + ?allocation_distortion), 0) = 0), false), 1, xsd:double(ABS(?corrected_gap) / (ABS(?corrected_gap) + ?allocation_distortion)))) AS ?_result)
            }
        """ ;
    ] .
