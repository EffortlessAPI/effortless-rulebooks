effortless-ntwf-shapes:TreatmentRankings_PooledRateB a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_PooledRateB" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:pooledRateB ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:totalCasesB ?total_cases_b . }
    OPTIONAL { $this effortless-ntwf:totalSuccessesB ?total_successes_b . }
                BIND(IF(COALESCE((COALESCE(?total_cases_b, 0) = 0), false), "", xsd:double(?total_successes_b / ?total_cases_b)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_PooledWinner a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_PooledWinner" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:pooledWinner ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:pooledRateA ?pooled_rate_a . OPTIONAL { ?pooled_rate_a erb:key ?pooled_rate_a__key . } }
    OPTIONAL { $this effortless-ntwf:pooledRateB ?pooled_rate_b . OPTIONAL { ?pooled_rate_b erb:key ?pooled_rate_b__key . } }
    OPTIONAL { $this effortless-ntwf:treatmentA ?treatment_a . }
    OPTIONAL { $this effortless-ntwf:treatmentB ?treatment_b . }
                BIND(IF(COALESCE((COALESCE((COALESCE(COALESCE(?pooled_rate_a__key, COALESCE(IF(isIRI(?pooled_rate_a), REPLACE(STR(?pooled_rate_a), "^.*[#/]", ""), STR(?pooled_rate_a)), "")), 0) = ""), false) || COALESCE((COALESCE(COALESCE(?pooled_rate_b__key, COALESCE(IF(isIRI(?pooled_rate_b), REPLACE(STR(?pooled_rate_b), "^.*[#/]", ""), STR(?pooled_rate_b)), "")), 0) = ""), false)), false), "", IF(COALESCE((COALESCE(ABS((?pooled_rate_a - ?pooled_rate_b)), 0) < 1e-07), false), "tie", IF(COALESCE((COALESCE(?pooled_rate_a, 0) > COALESCE(?pooled_rate_b, 0)), false), ?treatment_a, ?treatment_b))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_StratumCount a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_StratumCount" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:stratumCount ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:StratumSummaries .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentA ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_StrataWonByA a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_StrataWonByA" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:strataWonByA ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:StratumSummaries .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentA ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:stratumWinner ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentA ?p4 . OPTIONAL { ?p4 erb:key ?p4__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    FILTER(COALESCE(?c4__key, STR(?c4)) = COALESCE(?p4__key, STR(?p4)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_StrataWonByB a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_StrataWonByB" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:strataWonByB ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:StratumSummaries .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentA ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:stratumWinner ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentB ?p4 . OPTIONAL { ?p4 erb:key ?p4__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    FILTER(COALESCE(?c4__key, STR(?c4)) = COALESCE(?p4__key, STR(?p4)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_PerStratumWinner a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_PerStratumWinner" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:perStratumWinner ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:strataWonByA ?strata_won_by_a . }
    OPTIONAL { $this effortless-ntwf:strataWonByB ?strata_won_by_b . }
    OPTIONAL { $this effortless-ntwf:stratumCount ?stratum_count . }
    OPTIONAL { $this effortless-ntwf:treatmentA ?treatment_a . }
    OPTIONAL { $this effortless-ntwf:treatmentB ?treatment_b . }
                BIND(IF(COALESCE((COALESCE(?strata_won_by_a, 0) = COALESCE(?stratum_count, 0)), false), ?treatment_a, IF(COALESCE((COALESCE(?strata_won_by_b, 0) = COALESCE(?stratum_count, 0)), false), ?treatment_b, "none")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_IsStratumUnanimous a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_IsStratumUnanimous" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isStratumUnanimous ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:strataWonByA ?strata_won_by_a . }
    OPTIONAL { $this effortless-ntwf:strataWonByB ?strata_won_by_b . }
    OPTIONAL { $this effortless-ntwf:stratumCount ?stratum_count . }
                BIND((COALESCE((COALESCE(?strata_won_by_a, 0) = COALESCE(?stratum_count, 0)), false) || COALESCE((COALESCE(?strata_won_by_b, 0) = COALESCE(?stratum_count, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_IsReversal a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_IsReversal" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isReversal ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:isSignFlip ?is_sign_flip . }
                BIND(IF(COALESCE((!BOUND(?is_sign_flip)), false), "", ?is_sign_flip) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_ConfoundersInStudy a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_ConfoundersInStudy" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:confoundersInStudy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:StratumVariables .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:isConfounder ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_IsParadoxExplained a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_IsParadoxExplained" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:isParadoxExplained ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:confoundersInStudy ?confounders_in_study . }
    OPTIONAL { $this effortless-ntwf:isReversal ?is_reversal . }
                BIND((COALESCE(?is_reversal, false) && COALESCE((COALESCE(?confounders_in_study, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_PooledGap a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_PooledGap" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this effortless-ntwf:pooledGap ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:pooledRateA ?pooled_rate_a . OPTIONAL { ?pooled_rate_a erb:key ?pooled_rate_a__key . } }
    OPTIONAL { $this effortless-ntwf:pooledRateB ?pooled_rate_b . }
                BIND(IF(COALESCE((COALESCE(COALESCE(?pooled_rate_a__key, COALESCE(IF(isIRI(?pooled_rate_a), REPLACE(STR(?pooled_rate_a), "^.*[#/]", ""), STR(?pooled_rate_a)), "")), 0) = ""), false), "", ABS((?pooled_rate_a - ?pooled_rate_b))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_StrataWonByLoser a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_StrataWonByLoser" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            CONSTRUCT {
                $this effortless-ntwf:strataWonByLoser ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:pooledWinner ?pooled_winner . }
    OPTIONAL { $this effortless-ntwf:strataWonByA ?strata_won_by_a . }
    OPTIONAL { $this effortless-ntwf:strataWonByB ?strata_won_by_b . }
    OPTIONAL { $this effortless-ntwf:treatmentA ?treatment_a . }
                BIND(ROUND(IF(COALESCE(COALESCE((?pooled_winner = ?treatment_a), ((!BOUND(?pooled_winner) || STR(?pooled_winner) = "") && (!BOUND(?treatment_a) || STR(?treatment_a) = ""))), false), ?strata_won_by_b, ?strata_won_by_a)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_ParadoxStrength a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_ParadoxStrength" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:paradoxStrength ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
    OPTIONAL { $this effortless-ntwf:pooledGap ?pooled_gap . }
    OPTIONAL { $this effortless-ntwf:strataWonByLoser ?strata_won_by_loser . }
    OPTIONAL { $this effortless-ntwf:stratumCount ?stratum_count . }
                BIND(IF(COALESCE((COALESCE(?stratum_count, 0) = 0), false), "", (?pooled_gap * xsd:double(?strata_won_by_loser / ?stratum_count))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_PooledRateFromWeightsA a sh:NodeShape ;
    sh:targetClass effortless-ntwf:TreatmentRankings ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_TreatmentRankings_PooledRateFromWeightsA" ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-ntwf:pooledRateFromWeightsA ?_result .
            }
            WHERE {
    $this a effortless-ntwf:TreatmentRankings .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a effortless-ntwf:TreatmentRankings .
                    ?child a effortless-ntwf:StratumSummaries .
                    ?child effortless-ntwf:study ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this effortless-ntwf:study ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child effortless-ntwf:treatmentLabel ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this effortless-ntwf:treatmentA ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child effortless-ntwf:weightedStratumRate ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf-shapes:TreatmentRankings_PooledRateFromWeightsB a sh:NodeShape ;
