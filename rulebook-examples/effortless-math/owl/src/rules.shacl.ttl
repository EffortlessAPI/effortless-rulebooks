@prefix effortless-math: <https://example.org/effortless-math#> .
@prefix effortless-math-shapes: <https://example.org/effortless-math/shapes#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# === Rules for ArtifactRegistry ===
effortless-math-shapes:ArtifactRegistry_Name a sh:NodeShape ;
    sh:targetClass effortless-math:ArtifactRegistry ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArtifactRegistry_Name" ;
        sh:construct """
            PREFIX effortless-math: <https://example.org/effortless-math#>
            CONSTRUCT {
                $this effortless-math:name ?_result .
            }
            WHERE {
    $this a effortless-math:ArtifactRegistry .
    OPTIONAL { $this effortless-math:artifactId ?artifact_id . }
                BIND(?artifact_id AS ?_result)
            }
        """ ;
    ] .

