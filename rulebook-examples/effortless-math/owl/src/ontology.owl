@prefix effortless-math: <https://example.org/effortless-math#> .
@prefix erb: <https://effortlessapi.com/ns/erb#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://example.org/effortless-math> a owl:Ontology ;
    rdfs:label "effortless-math" ;
    dcterms:title "effortless-math" ;
    dcterms:description "Executable theorem network starter. Fermat's Last Theorem is the deeply modeled flagship domain; seven foundation theorems begin as first-class provider contracts with imported universal content." ;
    rdfs:comment "Generated by Effortless (rulebook-to-owl) from effortless-math-rulebook.json. The rulebook is the source: change it there, not here." ;
    rdfs:comment "This namespace is a placeholder derived from the rulebook's name. To publish under your own, add a row to the rulebook's __meta__ table: MetaKey ontology_iri, StringValue your IRI." ;
    rdfs:comment "ERB build parameters: erbBlankLogic=coerce, erbDateDiff=calendar, erbDateTimeText=iso8601, erbTimezone=UTC, erbWholeNumber=by-field-type" .

dcterms:description a owl:AnnotationProperty .
dcterms:title a owl:AnnotationProperty .

# The key of the row an individual was made from, verbatim (its IRI is only a slug of it).
erb:key a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "key" .

# === Class: ArtifactRegistry ===
effortless-math:ArtifactRegistry a owl:Class ;
    rdfs:label "ArtifactRegistry" ;
    rdfs:comment "Table: ArtifactRegistry — immutable source artifacts and content hashes for the migration." .

# === Class: Conclusions ===
effortless-math:Conclusions a owl:Class ;
    rdfs:label "Conclusions" ;
    rdfs:comment "Table: Conclusions — high-level claims earned by the migration starter itself." .

# === Class: Domains ===
effortless-math:Domains a owl:Class ;
    rdfs:label "Domains" ;
    rdfs:comment "Table: Domains — mathematical domains in the global theorem network." .

# === Class: FoundationKernels ===
effortless-math:FoundationKernels a owl:Class ;
    rdfs:label "FoundationKernels" ;
    rdfs:comment "Table: FoundationKernels — the seven v21 provider frontiers." .

# === Class: InvariantChecks ===
effortless-math:InvariantChecks a owl:Class ;
    rdfs:label "InvariantChecks" ;
    rdfs:comment "Table: InvariantChecks — imported v21 invariant ledger. Any FAIL row must fail the build." .

# === Class: LegacyParentAudits ===
effortless-math:LegacyParentAudits a owl:Class ;
    rdfs:label "LegacyParentAudits" ;
    rdfs:comment "Table: LegacyParentAudits — the final-nine parent-to-kernel compression from v21." .

# === Class: Loops ===
effortless-math:Loops a owl:Class ;
    rdfs:label "Loops" ;
    rdfs:comment "Table: Loops — all 571 historical and conceptual build loops from Fermat Witness Lab v21." .

# === Class: MigrationMappings ===
effortless-math:MigrationMappings a owl:Class ;
    rdfs:label "MigrationMappings" ;
    rdfs:comment "Table: MigrationMappings — explicit mapping from v21 SQLite concepts to the new theorem-network rulebook." .

# === Class: ProjectRoadmap ===
effortless-math:ProjectRoadmap a owl:Class ;
    rdfs:label "ProjectRoadmap" ;
    rdfs:comment "Table: ProjectRoadmap — integration sequence and acceptance criteria." .

# === Class: ProofFacts ===
effortless-math:ProofFacts a owl:Class ;
    rdfs:label "ProofFacts" ;
    rdfs:comment "Table: ProofFacts — the current v21 contradiction trace, one derived fact per row." .

# === Class: ProofStatuses ===
effortless-math:ProofStatuses a owl:Class ;
    rdfs:label "ProofStatuses" ;
    rdfs:comment "Table: ProofStatuses — controlled proof-state vocabulary. Parent removal and full internalization are deliberately distinct." .

# === Class: Sources ===
effortless-math:Sources a owl:Class ;
    rdfs:label "Sources" ;
    rdfs:comment "Table: Sources — provenance catalog from v21." .

# === Class: TheoremDependencies ===
effortless-math:TheoremDependencies a owl:Class ;
    rdfs:label "TheoremDependencies" ;
    rdfs:comment "Table: TheoremDependencies — typed provider/consumer edges between theorem contracts." .

# === Class: Theorems ===
effortless-math:Theorems a owl:Class ;
    rdfs:label "Theorems" ;
    rdfs:comment "Table: Theorems — one row per application theorem or provider theorem." .

# === Class: TrustBoundaries ===
effortless-math:TrustBoundaries a owl:Class ;
    rdfs:label "TrustBoundaries" ;
    rdfs:comment "Table: TrustBoundaries — explicit statement of what each theorem still trusts externally." .

