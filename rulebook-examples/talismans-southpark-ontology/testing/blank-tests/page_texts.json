  {
    "page_text_id": "intro",
    "text": "An ontology defines kinds of things, their properties and rules. This knowledge graph uses those definitions to connect facts about South Park. Stan\u2019s school facts can change while Stan stays the same person.",
    "name": null
  },
  {
    "page_text_id": "intro-rulebook",
    "text": "This version runs no reasoner in the browser. Every fact, rule switch and conclusion on the page is a row or a formula in one rulebook, and the engine you pick below computes it: Postgres views, generated TypeScript, or the generated OWL and SHACL rules.",
    "name": null
  },
