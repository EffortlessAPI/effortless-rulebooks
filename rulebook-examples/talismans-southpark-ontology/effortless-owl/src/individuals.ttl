# === Individuals: PageTexts ===

talismans-south-park-ontology-explainer:page-title a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "page-title" ;
    talismans-south-park-ontology-explainer:pageTextId "page-title" ;
    talismans-south-park-ontology-explainer:text "South Park Ontology Explainer, on one rulebook" .

talismans-south-park-ontology-explainer:byline-prefix a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "byline-prefix" ;
    talismans-south-park-ontology-explainer:pageTextId "byline-prefix" ;
    talismans-south-park-ontology-explainer:text "A rulebook rebuild of the explainer by" .

talismans-south-park-ontology-explainer:byline-author a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "byline-author" ;
    talismans-south-park-ontology-explainer:pageTextId "byline-author" ;
    talismans-south-park-ontology-explainer:text "Jessica Talisman" .

talismans-south-park-ontology-explainer:byline-author-url a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "byline-author-url" ;
    talismans-south-park-ontology-explainer:pageTextId "byline-author-url" ;
    talismans-south-park-ontology-explainer:text "https://substack.com/@jessicatalisman" .

talismans-south-park-ontology-explainer:byline-suffix a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "byline-suffix" ;
    talismans-south-park-ontology-explainer:pageTextId "byline-suffix" ;
    talismans-south-park-ontology-explainer:text "· Intentional Arrangement" .

talismans-south-park-ontology-explainer:title a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "title" ;
    talismans-south-park-ontology-explainer:pageTextId "title" ;
    talismans-south-park-ontology-explainer:text "South Park facts form a knowledge graph" .

talismans-south-park-ontology-explainer:intro a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "intro" ;
    talismans-south-park-ontology-explainer:pageTextId "intro" ;
    talismans-south-park-ontology-explainer:text "An ontology defines kinds of things, their properties and rules. This knowledge graph uses those definitions to connect facts about South Park. Stan’s school facts can change while Stan stays the same person." .

talismans-south-park-ontology-explainer:intro-rulebook a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "intro-rulebook" ;
    talismans-south-park-ontology-explainer:pageTextId "intro-rulebook" ;
    talismans-south-park-ontology-explainer:text "This version runs no reasoner in the browser. Every fact, rule switch and conclusion on the page is a row or a formula in one rulebook, and the engine you pick below computes it: Postgres views, generated TypeScript, or the generated OWL and SHACL rules." .

talismans-south-park-ontology-explainer:link-article a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "link-article" ;
    talismans-south-park-ontology-explainer:pageTextId "link-article" ;
    talismans-south-park-ontology-explainer:text "Read the article" .

talismans-south-park-ontology-explainer:link-article-url a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "link-article-url" ;
    talismans-south-park-ontology-explainer:pageTextId "link-article-url" ;
    talismans-south-park-ontology-explainer:text "https://jessicatalisman.substack.com/p/what-is-an-ontology" .

talismans-south-park-ontology-explainer:link-original a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "link-original" ;
    talismans-south-park-ontology-explainer:pageTextId "link-original" ;
    talismans-south-park-ontology-explainer:text "Open the original explainer" .

talismans-south-park-ontology-explainer:link-original-url a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "link-original-url" ;
    talismans-south-park-ontology-explainer:pageTextId "link-original-url" ;
    talismans-south-park-ontology-explainer:text "https://southpark-ontology-explainer.jessica-tali-7056.chatgpt.site/" .

talismans-south-park-ontology-explainer:key-stated a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "key-stated" ;
    talismans-south-park-ontology-explainer:pageTextId "key-stated" ;
    talismans-south-park-ontology-explainer:text "a fact we stated" .

talismans-south-park-ontology-explainer:key-conclusion a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "key-conclusion" ;
    talismans-south-park-ontology-explainer:pageTextId "key-conclusion" ;
    talismans-south-park-ontology-explainer:text "a conclusion from a rule" .

talismans-south-park-ontology-explainer:key-class a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "key-class" ;
    talismans-south-park-ontology-explainer:pageTextId "key-class" ;
    talismans-south-park-ontology-explainer:text "a class" .

talismans-south-park-ontology-explainer:key-individual a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "key-individual" ;
    talismans-south-park-ontology-explainer:pageTextId "key-individual" ;
    talismans-south-park-ontology-explainer:text "an individual or value" .

talismans-south-park-ontology-explainer:key-help a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "key-help" ;
    talismans-south-park-ontology-explainer:pageTextId "key-help" ;
    talismans-south-park-ontology-explainer:text "Drag a circle to move it. Tap a circle or a line to read its facts and sources." .

talismans-south-park-ontology-explainer:image-note a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "image-note" ;
    talismans-south-park-ontology-explainer:pageTextId "image-note" ;
    talismans-south-park-ontology-explainer:text "Character portraits and South Park Elementary are Fandom images, linked from the rulebook’s Things table. Dashed circles mark classes; solid circles show individual things or values." .

talismans-south-park-ontology-explainer:statements-heading a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "statements-heading" ;
    talismans-south-park-ontology-explainer:pageTextId "statements-heading" ;
    talismans-south-park-ontology-explainer:text "Statements connect things and values" .

talismans-south-park-ontology-explainer:statements-hint a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "statements-hint" ;
    talismans-south-park-ontology-explainer:pageTextId "statements-hint" ;
    talismans-south-park-ontology-explainer:text "Each statement has three parts, called a triple. The subject identifies what we describe. The predicate tells how it is connected to the object. The object is the related thing or value. Select a fact to show it." .

talismans-south-park-ontology-explainer:scenario-heading a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "scenario-heading" ;
    talismans-south-park-ontology-explainer:pageTextId "scenario-heading" ;
    talismans-south-park-ontology-explainer:text "Stan can change while his identity stays the same" .

talismans-south-park-ontology-explainer:scenario-hint a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "scenario-hint" ;
    talismans-south-park-ontology-explainer:pageTextId "scenario-hint" ;
    talismans-south-park-ontology-explainer:text "The grade-5 and leaving-school buttons imagine future changes so you can see how the model responds. They do not report events from the show. Stan is allowed to graduate. The database does not get a vote." .

talismans-south-park-ontology-explainer:rules-heading a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "rules-heading" ;
    talismans-south-park-ontology-explainer:pageTextId "rules-heading" ;
    talismans-south-park-ontology-explainer:text "Rules add facts to the graph" .

talismans-south-park-ontology-explainer:rules-hint a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "rules-hint" ;
    talismans-south-park-ontology-explainer:pageTextId "rules-hint" ;
    talismans-south-park-ontology-explainer:text "An inference is a new conclusion from facts and a rule. Reasoning means following rules step by step to reach or check conclusions. Here the rulebook does that work: each rule is a switch, and every conclusion is a formula." .

talismans-south-park-ontology-explainer:conclusions-heading a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "conclusions-heading" ;
    talismans-south-park-ontology-explainer:pageTextId "conclusions-heading" ;
    talismans-south-park-ontology-explainer:text "Rules produce new conclusions" .

talismans-south-park-ontology-explainer:add-heading a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "add-heading" ;
    talismans-south-park-ontology-explainer:pageTextId "add-heading" ;
    talismans-south-park-ontology-explainer:text "Your statements extend the graph" .

talismans-south-park-ontology-explainer:add-hint a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "add-hint" ;
    talismans-south-park-ontology-explainer:pageTextId "add-hint" ;
    talismans-south-park-ontology-explainer:text "Try Sharon, is parent of, Stan. Then try Sharon, is parent of, Randy with the disjoint rule on." .

talismans-south-park-ontology-explainer:label-subject a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "label-subject" ;
    talismans-south-park-ontology-explainer:pageTextId "label-subject" ;
    talismans-south-park-ontology-explainer:text "Subject" .

talismans-south-park-ontology-explainer:label-predicate a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "label-predicate" ;
    talismans-south-park-ontology-explainer:pageTextId "label-predicate" ;
    talismans-south-park-ontology-explainer:text "Predicate / property" .

talismans-south-park-ontology-explainer:label-object a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "label-object" ;
    talismans-south-park-ontology-explainer:pageTextId "label-object" ;
    talismans-south-park-ontology-explainer:text "Object or value" .

talismans-south-park-ontology-explainer:add-button a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "add-button" ;
    talismans-south-park-ontology-explainer:pageTextId "add-button" ;
    talismans-south-park-ontology-explainer:text "Add fact" .

talismans-south-park-ontology-explainer:grade-input-note a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "grade-input-note" ;
    talismans-south-park-ontology-explainer:pageTextId "grade-input-note" ;
    talismans-south-park-ontology-explainer:text "For has grade level, enter an integer (a number with no fractional part), such as 4 or 5. This form checks integer input as an application check. For has role, enter text such as Student. A new grade or role replaces that person’s previous active value in this page’s current record. Uncheck a role fact to clear it." .

talismans-south-park-ontology-explainer:integer-error a talismans-south-park-ontology-explainer:PageTexts ;
