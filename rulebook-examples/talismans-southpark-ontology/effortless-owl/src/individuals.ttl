    erb:key "editor-starting" ;
    talismans-south-park-ontology-explainer:pageTextId "editor-starting" ;
    talismans-south-park-ontology-explainer:text "Starting it ({seconds} s). This page goes to the editor as soon as it answers; the first start takes a few minutes." .

talismans-south-park-ontology-explainer:editor-failed a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "editor-failed" ;
    talismans-south-park-ontology-explainer:pageTextId "editor-failed" ;
    talismans-south-park-ontology-explainer:text "The rulebook editor did not start. What its launcher said:" .

talismans-south-park-ontology-explainer:editor-retry a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "editor-retry" ;
    talismans-south-park-ontology-explainer:pageTextId "editor-retry" ;
    talismans-south-park-ontology-explainer:text "Try again" .

talismans-south-park-ontology-explainer:file-taken-concept a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "file-taken-concept" ;
    talismans-south-park-ontology-explainer:pageTextId "file-taken-concept" ;
    talismans-south-park-ontology-explainer:text "Rulebook v{number}: {file} was saved from outside this app (its rulebook editor, or by hand) and has been taken into the ontology." .

talismans-south-park-ontology-explainer:file-taken-hub a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "file-taken-hub" ;
    talismans-south-park-ontology-explainer:pageTextId "file-taken-hub" ;
    talismans-south-park-ontology-explainer:text "Rulebook v{number}: {file} was saved from outside this app (its rulebook editor, or by hand) and has been loaded." .

talismans-south-park-ontology-explainer:file-refused-hub a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "file-refused-hub" ;
    talismans-south-park-ontology-explainer:pageTextId "file-refused-hub" ;
    talismans-south-park-ontology-explainer:text "{file} changed on disk and could not be loaded: {reason}" .

talismans-south-park-ontology-explainer:file-held-start a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "file-held-start" ;
    talismans-south-park-ontology-explainer:pageTextId "file-held-start" ;
    talismans-south-park-ontology-explainer:text "It already said something other than the rulebook when this app started, so there is no telling which of the two files is the newer." .

talismans-south-park-ontology-explainer:file-held-base a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "file-held-base" ;
    talismans-south-park-ontology-explainer:pageTextId "file-held-base" ;
    talismans-south-park-ontology-explainer:text "It was saved from rulebook v{base} and the rulebook is now v{number}, so loading it would undo what was saved since." .

talismans-south-park-ontology-explainer:file-held-refused a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "file-held-refused" ;
    talismans-south-park-ontology-explainer:pageTextId "file-held-refused" ;
    talismans-south-park-ontology-explainer:text "It could not be loaded: {reason}" .

talismans-south-park-ontology-explainer:file-waiting-unsaved a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "file-waiting-unsaved" ;
    talismans-south-park-ontology-explainer:pageTextId "file-waiting-unsaved" ;
    talismans-south-park-ontology-explainer:text "There are unsaved changes here, so it was not loaded by itself." .

talismans-south-park-ontology-explainer:files-both-changed a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "files-both-changed" ;
    talismans-south-park-ontology-explainer:pageTextId "files-both-changed" ;
    talismans-south-park-ontology-explainer:text "Both rulebook files changed on disk, and there is no telling which is the newer. Discard changes reloads the rulebook file; the concept form loads or overwrites the concept rulebook file." .

talismans-south-park-ontology-explainer:jsonfile-heading-ontology a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "jsonfile-heading-ontology" ;
    talismans-south-park-ontology-explainer:pageTextId "jsonfile-heading-ontology" ;
    talismans-south-park-ontology-explainer:text "The rulebook file" .

talismans-south-park-ontology-explainer:jsonfile-heading-concept a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "jsonfile-heading-concept" ;
    talismans-south-park-ontology-explainer:pageTextId "jsonfile-heading-concept" ;
    talismans-south-park-ontology-explainer:text "The concept rulebook file" .

talismans-south-park-ontology-explainer:jsonfile-heading-concept-live a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "jsonfile-heading-concept-live" ;
    talismans-south-park-ontology-explainer:pageTextId "jsonfile-heading-concept-live" ;
    talismans-south-park-ontology-explainer:text "The concept rulebook of the rows here" .

talismans-south-park-ontology-explainer:jsonfile-about a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "jsonfile-about" ;
    talismans-south-park-ontology-explainer:pageTextId "jsonfile-about" ;
    talismans-south-park-ontology-explainer:text "The file as it is saved: standard JSON with one field or one row of a table per line, so one changed row is one changed line." .

talismans-south-park-ontology-explainer:jsonfile-about-live a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "jsonfile-about-live" ;
    talismans-south-park-ontology-explainer:pageTextId "jsonfile-about-live" ;
    talismans-south-park-ontology-explainer:text "The concept rulebook as the rows here make it now, unsaved changes included, laid out the way its file is saved: one field or one row of a table per line." .

talismans-south-park-ontology-explainer:jsonfile-jump a talismans-south-park-ontology-explainer:PageTexts ;
