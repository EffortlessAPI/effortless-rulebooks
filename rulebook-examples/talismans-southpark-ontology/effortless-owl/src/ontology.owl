    rdfs:label "RuleId" ;
    rdfs:comment "Key of the rule." .

talismans-south-park-ontology-explainer:rulebookToolId a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:RulebookTools ;
    rdfs:range xsd:string ;
    rdfs:label "RulebookToolId" ;
    rdfs:comment "Key of the tool." .

talismans-south-park-ontology-explainer:scenario a owl:ObjectProperty ;
    rdfs:range talismans-south-park-ontology-explainer:Scenarios ;
    rdfs:label "Scenario" .

talismans-south-park-ontology-explainer:scenarioFactChangeId a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:ScenarioFactChanges ;
    rdfs:range xsd:string ;
    rdfs:label "ScenarioFactChangeId" ;
    rdfs:comment "Key of the change." .

talismans-south-park-ontology-explainer:scenarioId a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Scenarios ;
    rdfs:range xsd:string ;
    rdfs:label "ScenarioId" ;
    rdfs:comment "Key of the button." .

talismans-south-park-ontology-explainer:scenarioRuleSettingId a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:ScenarioRuleSettings ;
    rdfs:range xsd:string ;
    rdfs:label "ScenarioRuleSettingId" ;
    rdfs:comment "Key of the setting." .

talismans-south-park-ontology-explainer:second a owl:ObjectProperty ;
    rdfs:label "Second" .

talismans-south-park-ontology-explainer:secondHolds a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:DisjointChecks ;
    rdfs:range xsd:boolean ;
    rdfs:label "SecondHolds" ;
    rdfs:comment "Order 16. Whether the second link holds." .

talismans-south-park-ontology-explainer:secondHoldsBeforeChain a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:boolean ;
    rdfs:label "SecondHoldsBeforeChain" ;
    rdfs:comment "Order 8. Whether the second premise holds before the chain." .

talismans-south-park-ontology-explainer:secondIsInEffect a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:boolean ;
    rdfs:label "SecondIsInEffect" ;
    rdfs:comment "Order 4. Whether the second premise is in effect." .

talismans-south-park-ontology-explainer:secondSnapPosition a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:decimal ;
    rdfs:label "SecondSnapPosition" ;
    rdfs:comment "Order 9. Where the reasoner meets the second premise." .

talismans-south-park-ontology-explainer:secondWords a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "SecondWords" ;
    rdfs:comment "Order 3. The second premise as the card quotes it." .

talismans-south-park-ontology-explainer:snapPosition a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:decimal ;
    rdfs:label "SnapPosition" ;
    rdfs:comment "Order 8. Where the page's reasoner meets this fact as a premise: a stated fact at its list position, a fact concluded by the inverse or symmetric rule after every stated fact, in the order it was concluded; 0 for a fact that does not hold yet, so a link to no fact reads the same on every engine." .

talismans-south-park-ontology-explainer:sortOrder a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "SortOrder" .

talismans-south-park-ontology-explainer:source a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:string ;
    rdfs:label "Source" ;
    rdfs:comment "Order 2. Where a listed fact came from." .

talismans-south-park-ontology-explainer:statementId a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:string ;
