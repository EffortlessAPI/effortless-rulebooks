    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:string ;
    rdfs:label "SubjectNodeKey" ;
    rdfs:comment "Order 1. The graph node this fact starts from." .

talismans-south-park-ontology-explainer:subjectNodeKind a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:string ;
    rdfs:label "SubjectNodeKind" ;
    rdfs:comment "Order 19. How the graph draws the subject." .

talismans-south-park-ontology-explainer:subjectPropertyKey a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:string ;
    rdfs:label "SubjectPropertyKey" ;
    rdfs:comment "Order 1. Groups the values one subject has for one property." .

talismans-south-park-ontology-explainer:substrate a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Engines ;
    rdfs:range xsd:string ;
    rdfs:label "Substrate" ;
    rdfs:comment "The conformance harness's name for this substrate." .

