    rdfs:range xsd:string ;
    rdfs:label "PropertyRangeClass" ;
    rdfs:comment "Order 1. The property's range class." .

talismans-south-park-ontology-explainer:rangeClass a owl:ObjectProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range talismans-south-park-ontology-explainer:Things ;
    rdfs:label "RangeClass" ;
    rdfs:comment "The class the range rule gives this property's object." .

talismans-south-park-ontology-explainer:recordKind a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range xsd:string ;
    rdfs:label "RecordKind" ;
    rdfs:comment "The word the current-record summary uses for this property's values: role, grade or school." .

talismans-south-park-ontology-explainer:recordOrder a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range xsd:integer ;
    rdfs:label "RecordOrder" ;
    rdfs:comment "Position of this property in the current-record summary." .

talismans-south-park-ontology-explainer:round a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "Round" ;
    rdfs:comment "Order 5. The reasoner's round: 1 when every premise is a stated fact, 2 when the property chain reads a concluded fact." .

talismans-south-park-ontology-explainer:rule a owl:ObjectProperty ;
    rdfs:range talismans-south-park-ontology-explainer:Rules ;
    rdfs:label "Rule" .

talismans-south-park-ontology-explainer:ruleEnabled a owl:DatatypeProperty ;
