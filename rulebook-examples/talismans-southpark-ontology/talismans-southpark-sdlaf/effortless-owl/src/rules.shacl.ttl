                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a south-park-ontology-in-sdlaf:Reasoning .
                    ?child a south-park-ontology-in-sdlaf:Parenthoods .
                    ?child south-park-ontology-in-sdlaf:reasoning $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Reasoning_CountOfStatedMarriages a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Reasoning ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Reasoning_CountOfStatedMarriages" ;
