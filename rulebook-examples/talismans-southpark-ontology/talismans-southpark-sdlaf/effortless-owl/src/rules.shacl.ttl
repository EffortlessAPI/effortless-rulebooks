south-park-ontology-in-sdlaf-shapes:Individuals_StatedFactCount a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Individuals ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_StatedFactCount" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:statedFactCount ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Individuals .
    OPTIONAL { $this south-park-ontology-in-sdlaf:hasAge ?has_age . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:hasAttends ?has_attends . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:isAssertedPerson ?is_asserted_person . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:isAssertedSchool ?is_asserted_school . }
                BIND(ROUND((((IF(COALESCE(?is_asserted_person, false), 1, 0) + IF(COALESCE(?is_asserted_school, false), 1, 0)) + IF(COALESCE(?has_age, false), 1, 0)) + IF(COALESCE(?has_attends, false), 1, 0))) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Individuals_CountOfGradeLevelsOn a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CountOfGradeLevelsOn" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:countOfGradeLevelsOn ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Individuals .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a south-park-ontology-in-sdlaf:Individuals .
                    ?child a south-park-ontology-in-sdlaf:GradeLevelRecords .
                    ?child south-park-ontology-in-sdlaf:individual $this .
                    OPTIONAL { ?child south-park-ontology-in-sdlaf:isOn ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Individuals_LatestGradeLevelSeq a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_LatestGradeLevelSeq" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:latestGradeLevelSeq ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Individuals .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a south-park-ontology-in-sdlaf:Individuals .
                    ?child a south-park-ontology-in-sdlaf:GradeLevelRecords .
                    ?child south-park-ontology-in-sdlaf:individual $this .
                    OPTIONAL { ?child south-park-ontology-in-sdlaf:isOn ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child south-park-ontology-in-sdlaf:statedSeq ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER(BOUND(?c2) && ?c2 = true)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Individuals_HasGradeLevel a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Individuals ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_HasGradeLevel" ;
