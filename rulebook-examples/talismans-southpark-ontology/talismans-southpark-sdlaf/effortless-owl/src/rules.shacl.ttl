south-park-ontology-in-sdlaf-shapes:Individuals_HasAge a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Individuals ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_HasAge" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:hasAge ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Individuals .
    OPTIONAL { $this south-park-ontology-in-sdlaf:age ?age . OPTIONAL { ?age erb:key ?age__key . } }
                BIND((COALESCE(COALESCE(?age__key, COALESCE(IF(isIRI(?age), REPLACE(STR(?age), "^.*[#/]", ""), STR(?age)), "")), 0) != "") AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Individuals_HasAttends a sh:NodeShape ;
