# === Rules for Marriages ===
south-park-ontology-in-sdlaf-shapes:Marriages_Name a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Marriages ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Marriages_Name" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:name ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Marriages .
    OPTIONAL { $this south-park-ontology-in-sdlaf:partnerALabel ?partner_a_label . OPTIONAL { ?partner_a_label erb:key ?partner_a_label__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:partnerBLabel ?partner_b_label . OPTIONAL { ?partner_b_label erb:key ?partner_b_label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?partner_a_label__key, IF(isIRI(?partner_a_label), REPLACE(STR(?partner_a_label), "^.*[#/]", ""), STR(?partner_a_label))), ""), " is spouse of ", COALESCE(COALESCE(?partner_b_label__key, IF(isIRI(?partner_b_label), REPLACE(STR(?partner_b_label), "^.*[#/]", ""), STR(?partner_b_label))), "")) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Marriages_PartnerALabel a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Marriages ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Marriages_PartnerALabel" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:partnerALabel ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Marriages .
                OPTIONAL { $this south-park-ontology-in-sdlaf:partnerA ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Individuals . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Marriages_PartnerBLabel a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Marriages ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Marriages_PartnerBLabel" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:partnerBLabel ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Marriages .
                OPTIONAL { $this south-park-ontology-in-sdlaf:partnerB ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Individuals . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
