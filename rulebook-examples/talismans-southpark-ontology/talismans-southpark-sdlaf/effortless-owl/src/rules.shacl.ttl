south-park-ontology-in-sdlaf-shapes:Reasoning_CountOfConclusions a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Reasoning ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Reasoning_CountOfConclusions" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:countOfConclusions ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Reasoning .
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfChildOfConclusions ?count_of_child_of_conclusions . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfGrandparentConclusions ?count_of_grandparent_conclusions . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfMirroredFriendships ?count_of_mirrored_friendships . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfMirroredMarriages ?count_of_mirrored_marriages . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfPersonConclusions ?count_of_person_conclusions . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfSchoolConclusions ?count_of_school_conclusions . }
                BIND(ROUND((((((?count_of_child_of_conclusions + ?count_of_mirrored_marriages) + ?count_of_mirrored_friendships) + ?count_of_grandparent_conclusions) + ?count_of_person_conclusions) + ?count_of_school_conclusions)) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Reasoning_CountOfContradictions a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Reasoning ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Reasoning_CountOfContradictions" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:countOfContradictions ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Reasoning .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a south-park-ontology-in-sdlaf:Reasoning .
                    ?child a south-park-ontology-in-sdlaf:Parenthoods .
                    ?child south-park-ontology-in-sdlaf:reasoning $this .
                    OPTIONAL { ?child south-park-ontology-in-sdlaf:isContradiction ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Reasoning_IsConsistent a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Reasoning ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Reasoning_IsConsistent" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:isConsistent ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Reasoning .
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfContradictions ?count_of_contradictions . }
                BIND((COALESCE(?count_of_contradictions, 0) = 0) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Reasoning_Summary a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Reasoning ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Reasoning_Summary" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:summary ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Reasoning .
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfConclusions ?count_of_conclusions . OPTIONAL { ?count_of_conclusions erb:key ?count_of_conclusions__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfContradictions ?count_of_contradictions . OPTIONAL { ?count_of_contradictions erb:key ?count_of_contradictions__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfStatedFacts ?count_of_stated_facts . OPTIONAL { ?count_of_stated_facts erb:key ?count_of_stated_facts__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?count_of_stated_facts__key, IF(isIRI(?count_of_stated_facts), REPLACE(STR(?count_of_stated_facts), "^.*[#/]", ""), STR(?count_of_stated_facts))), ""), " stated facts, ", COALESCE(COALESCE(?count_of_conclusions__key, IF(isIRI(?count_of_conclusions), REPLACE(STR(?count_of_conclusions), "^.*[#/]", ""), STR(?count_of_conclusions))), ""), " conclusions, ", COALESCE(COALESCE(?count_of_contradictions__key, IF(isIRI(?count_of_contradictions), REPLACE(STR(?count_of_contradictions), "^.*[#/]", ""), STR(?count_of_contradictions))), ""), " contradictions") AS ?_result)
            }
        """ ;
    ] .

# === Rules for RoleRecords ===
south-park-ontology-in-sdlaf-shapes:RoleRecords_Name a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:RoleRecords ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleRecords_Name" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:name ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:RoleRecords .
    OPTIONAL { $this south-park-ontology-in-sdlaf:individualLabel ?individual_label . OPTIONAL { ?individual_label erb:key ?individual_label__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:role ?role . OPTIONAL { ?role erb:key ?role__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?individual_label__key, IF(isIRI(?individual_label), REPLACE(STR(?individual_label), "^.*[#/]", ""), STR(?individual_label))), ""), " has role ", COALESCE(COALESCE(?role__key, IF(isIRI(?role), REPLACE(STR(?role), "^.*[#/]", ""), STR(?role))), "")) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:RoleRecords_IndividualLabel a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:RoleRecords ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleRecords_IndividualLabel" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:individualLabel ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:RoleRecords .
                OPTIONAL { $this south-park-ontology-in-sdlaf:individual ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Individuals . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:RoleRecords_IndividualLatestSeq a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:RoleRecords ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_RoleRecords_IndividualLatestSeq" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:individualLatestSeq ?_result .
            }
            WHERE {
