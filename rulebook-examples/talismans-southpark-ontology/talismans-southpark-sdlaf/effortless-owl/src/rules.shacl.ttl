            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:name ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Parenthoods .
    OPTIONAL { $this south-park-ontology-in-sdlaf:childLabel ?child_label . OPTIONAL { ?child_label erb:key ?child_label__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:parentLabel ?parent_label . OPTIONAL { ?parent_label erb:key ?parent_label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?parent_label__key, IF(isIRI(?parent_label), REPLACE(STR(?parent_label), "^.*[#/]", ""), STR(?parent_label))), ""), " is parent of ", COALESCE(COALESCE(?child_label__key, IF(isIRI(?child_label), REPLACE(STR(?child_label), "^.*[#/]", ""), STR(?child_label))), "")) AS ?_result)
            }
        """ ;
