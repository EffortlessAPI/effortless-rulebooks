            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:currentGradeLevelRecord ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Individuals .
    OPTIONAL { $this south-park-ontology-in-sdlaf:hasGradeLevel ?has_grade_level . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:individualId ?individual_id . OPTIONAL { ?individual_id erb:key ?individual_id__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:latestGradeLevelSeq ?latest_grade_level_seq . OPTIONAL { ?latest_grade_level_seq erb:key ?latest_grade_level_seq__key . } }
                BIND(IF(COALESCE(?has_grade_level, false), CONCAT(COALESCE(COALESCE(?individual_id__key, IF(isIRI(?individual_id), REPLACE(STR(?individual_id), "^.*[#/]", ""), STR(?individual_id))), ""), "|grade|", COALESCE(COALESCE(?latest_grade_level_seq__key, IF(isIRI(?latest_grade_level_seq), REPLACE(STR(?latest_grade_level_seq), "^.*[#/]", ""), STR(?latest_grade_level_seq))), "")), "") AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Individuals_GradeLevel a sh:NodeShape ;
