            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:holds ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Grandparenthoods .
    OPTIONAL { $this south-park-ontology-in-sdlaf:chainIsOn ?chain_is_on . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:links ?links . }
                BIND(IF(COALESCE((COALESCE(?links, false) && COALESCE(?chain_is_on, false)), false), true, "") AS ?_result)
            }
        """ ;
    ] .

