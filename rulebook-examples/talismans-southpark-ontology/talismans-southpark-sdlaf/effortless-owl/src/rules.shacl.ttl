    OPTIONAL { $this south-park-ontology-in-sdlaf:individualLatestSeq ?individual_latest_seq . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:isOn ?is_on . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:statedSeq ?stated_seq . }
                BIND((COALESCE(?is_on, false) && COALESCE((COALESCE(?stated_seq, 0) = COALESCE(?individual_latest_seq, 0)), false)) AS ?_result)
            }
