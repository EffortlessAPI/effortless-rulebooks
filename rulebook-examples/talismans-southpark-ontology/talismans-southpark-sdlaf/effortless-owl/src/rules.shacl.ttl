    OPTIONAL { $this south-park-ontology-in-sdlaf:parentLabel ?parent_label . OPTIONAL { ?parent_label erb:key ?parent_label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?child_label__key, IF(isIRI(?child_label), REPLACE(STR(?child_label), "^.*[#/]", ""), STR(?child_label))), ""), " is child of ", COALESCE(COALESCE(?parent_label__key, IF(isIRI(?parent_label), REPLACE(STR(?parent_label), "^.*[#/]", ""), STR(?parent_label))), "")) AS ?_result)
            }
