    OPTIONAL { $this south-park-ontology-in-sdlaf:roleRecordId ?role_record_id . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:statedSeq ?stated_seq . OPTIONAL { ?stated_seq erb:key ?stated_seq__key . } }
                BIND(COALESCE((?role_record_id = CONCAT(COALESCE(COALESCE(?individual__key, IF(isIRI(?individual), REPLACE(STR(?individual), "^.*[#/]", ""), STR(?individual))), ""), "|role|", COALESCE(COALESCE(?stated_seq__key, IF(isIRI(?stated_seq), REPLACE(STR(?stated_seq), "^.*[#/]", ""), STR(?stated_seq))), ""))), false) AS ?_result)
            }
        """ ;
