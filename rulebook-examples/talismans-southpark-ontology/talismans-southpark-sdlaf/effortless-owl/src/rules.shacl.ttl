# === Rules for Reasoning ===
south-park-ontology-in-sdlaf-shapes:Reasoning_Name a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Reasoning ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Reasoning_Name" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:name ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Reasoning .
    OPTIONAL { $this south-park-ontology-in-sdlaf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Reasoning_CountOfIndividuals a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Reasoning ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Reasoning_CountOfIndividuals" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:countOfIndividuals ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Reasoning .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a south-park-ontology-in-sdlaf:Reasoning .
                    ?child a south-park-ontology-in-sdlaf:Individuals .
                    ?child south-park-ontology-in-sdlaf:reasoning $this .
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
