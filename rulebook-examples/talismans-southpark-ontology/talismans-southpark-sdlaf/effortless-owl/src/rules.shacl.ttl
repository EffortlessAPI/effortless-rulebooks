            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:hasGradeLevel ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Individuals .
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfGradeLevelsOn ?count_of_grade_levels_on . }
                BIND((COALESCE(?count_of_grade_levels_on, 0) > 0) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Individuals_CurrentGradeLevelRecord a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Individuals ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_CurrentGradeLevelRecord" ;
