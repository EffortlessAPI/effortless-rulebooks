                OPTIONAL { $this south-park-ontology-in-sdlaf:individual ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Individuals . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:latestRoleSeq ?j3 . } }
                BIND(?j3 AS ?_result)
