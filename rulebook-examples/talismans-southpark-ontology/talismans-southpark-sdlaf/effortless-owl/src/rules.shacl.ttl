            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:mirrorSentence ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Marriages .
    OPTIONAL { $this south-park-ontology-in-sdlaf:partnerALabel ?partner_a_label . OPTIONAL { ?partner_a_label erb:key ?partner_a_label__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:partnerBLabel ?partner_b_label . OPTIONAL { ?partner_b_label erb:key ?partner_b_label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?partner_b_label__key, IF(isIRI(?partner_b_label), REPLACE(STR(?partner_b_label), "^.*[#/]", ""), STR(?partner_b_label))), ""), " is spouse of ", COALESCE(COALESCE(?partner_a_label__key, IF(isIRI(?partner_a_label), REPLACE(STR(?partner_a_label), "^.*[#/]", ""), STR(?partner_a_label))), "")) AS ?_result)
            }
        """ ;
    ] .

