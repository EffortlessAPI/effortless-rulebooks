south-park-ontology-in-sdlaf-shapes:Reasoning_CountOfStatedIndividualFacts a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Reasoning ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Reasoning_CountOfStatedIndividualFacts" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:countOfStatedIndividualFacts ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Reasoning .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a south-park-ontology-in-sdlaf:Reasoning .
                    ?child a south-park-ontology-in-sdlaf:Individuals .
                    ?child south-park-ontology-in-sdlaf:reasoning $this .
                    OPTIONAL { ?child south-park-ontology-in-sdlaf:statedFactCount ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Reasoning_CountOfCurrentGradeLevels a sh:NodeShape ;
