                    ?child a south-park-ontology-in-sdlaf:Grandparenthoods .
                    ?child south-park-ontology-in-sdlaf:grandparent ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this south-park-ontology-in-sdlaf:individualId ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child south-park-ontology-in-sdlaf:holds ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
