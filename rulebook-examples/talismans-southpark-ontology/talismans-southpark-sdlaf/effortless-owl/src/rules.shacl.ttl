south-park-ontology-in-sdlaf-shapes:Parenthoods_SpouseAsStatedCount a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Parenthoods ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Parenthoods_SpouseAsStatedCount" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:spouseAsStatedCount ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Parenthoods .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a south-park-ontology-in-sdlaf:Parenthoods .
                    ?child a south-park-ontology-in-sdlaf:Marriages .
                    ?child south-park-ontology-in-sdlaf:partnerA ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this south-park-ontology-in-sdlaf:parent ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child south-park-ontology-in-sdlaf:partnerB ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this south-park-ontology-in-sdlaf:child ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Parenthoods_SpouseAsMirroredCount a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Parenthoods ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Parenthoods_SpouseAsMirroredCount" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:spouseAsMirroredCount ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Parenthoods .
                OPTIONAL {
                    SELECT $this (COUNT(?child) AS ?_agg1) WHERE {
                        $this a south-park-ontology-in-sdlaf:Parenthoods .
                    ?child a south-park-ontology-in-sdlaf:Marriages .
                    ?child south-park-ontology-in-sdlaf:partnerA ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this south-park-ontology-in-sdlaf:child ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child south-park-ontology-in-sdlaf:partnerB ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { $this south-park-ontology-in-sdlaf:parent ?p2 . OPTIONAL { ?p2 erb:key ?p2__key . } }
                    OPTIONAL { ?child south-park-ontology-in-sdlaf:mirrorHolds ?c4 . OPTIONAL { ?c4 erb:key ?c4__key . } }
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                    FILTER(COALESCE(?c2__key, STR(?c2)) = COALESCE(?p2__key, STR(?p2)))
                    FILTER(BOUND(?c4) && ?c4 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Parenthoods_IsContradiction a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Parenthoods ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Parenthoods_IsContradiction" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:isContradiction ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Parenthoods .
    OPTIONAL { $this south-park-ontology-in-sdlaf:disjointIsOn ?disjoint_is_on . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:spouseAsMirroredCount ?spouse_as_mirrored_count . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:spouseAsStatedCount ?spouse_as_stated_count . }
                BIND(IF(COALESCE((COALESCE(?disjoint_is_on, false) && COALESCE((COALESCE((?spouse_as_stated_count + ?spouse_as_mirrored_count), 0) > 0), false)), false), true, "") AS ?_result)
            }
        """ ;
    ] .

