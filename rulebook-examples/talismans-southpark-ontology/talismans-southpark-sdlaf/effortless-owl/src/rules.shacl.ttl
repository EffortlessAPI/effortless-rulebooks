            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:grandparentLabel ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Grandparenthoods .
                OPTIONAL { $this south-park-ontology-in-sdlaf:upperLink ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Parenthoods . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:parentLabel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
