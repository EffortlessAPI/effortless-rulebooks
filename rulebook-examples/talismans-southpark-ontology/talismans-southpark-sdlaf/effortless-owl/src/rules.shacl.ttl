                    ?child south-park-ontology-in-sdlaf:child $this .
                    OPTIONAL { ?child south-park-ontology-in-sdlaf:childOfHolds ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    FILTER(BOUND(?c2) && ?c2 = true)
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Individuals_GrandchildCount a sh:NodeShape ;
