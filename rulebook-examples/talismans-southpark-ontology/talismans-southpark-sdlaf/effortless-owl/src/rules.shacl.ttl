@prefix south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#> .
@prefix south-park-ontology-in-sdlaf-shapes: <https://example.org/south-park-ontology-in-sdlaf/shapes#> .
@prefix erb: <https://effortlessapi.com/ns/erb#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# === Rules for Friendships ===
south-park-ontology-in-sdlaf-shapes:Friendships_Name a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Friendships ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Friendships_Name" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:name ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Friendships .
    OPTIONAL { $this south-park-ontology-in-sdlaf:friendALabel ?friend_a_label . OPTIONAL { ?friend_a_label erb:key ?friend_a_label__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:friendBLabel ?friend_b_label . OPTIONAL { ?friend_b_label erb:key ?friend_b_label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?friend_a_label__key, IF(isIRI(?friend_a_label), REPLACE(STR(?friend_a_label), "^.*[#/]", ""), STR(?friend_a_label))), ""), " is friend of ", COALESCE(COALESCE(?friend_b_label__key, IF(isIRI(?friend_b_label), REPLACE(STR(?friend_b_label), "^.*[#/]", ""), STR(?friend_b_label))), "")) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Friendships_FriendALabel a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Friendships ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Friendships_FriendALabel" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:friendALabel ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Friendships .
                OPTIONAL { $this south-park-ontology-in-sdlaf:friendA ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Individuals . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Friendships_FriendBLabel a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Friendships ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Friendships_FriendBLabel" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:friendBLabel ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Friendships .
                OPTIONAL { $this south-park-ontology-in-sdlaf:friendB ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Individuals . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Friendships_SymmetricIsOn a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Friendships ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Friendships_SymmetricIsOn" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:symmetricIsOn ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Friendships .
                OPTIONAL { $this south-park-ontology-in-sdlaf:reasoning ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Reasoning . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:symmetricIsOn ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Friendships_MirrorHolds a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Friendships ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Friendships_MirrorHolds" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:mirrorHolds ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Friendships .
    OPTIONAL { $this south-park-ontology-in-sdlaf:symmetricIsOn ?symmetric_is_on . }
                BIND(IF(COALESCE(?symmetric_is_on, false), true, "") AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Friendships_MirrorSentence a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Friendships ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Friendships_MirrorSentence" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:mirrorSentence ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Friendships .
    OPTIONAL { $this south-park-ontology-in-sdlaf:friendALabel ?friend_a_label . OPTIONAL { ?friend_a_label erb:key ?friend_a_label__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:friendBLabel ?friend_b_label . OPTIONAL { ?friend_b_label erb:key ?friend_b_label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?friend_b_label__key, IF(isIRI(?friend_b_label), REPLACE(STR(?friend_b_label), "^.*[#/]", ""), STR(?friend_b_label))), ""), " is friend of ", COALESCE(COALESCE(?friend_a_label__key, IF(isIRI(?friend_a_label), REPLACE(STR(?friend_a_label), "^.*[#/]", ""), STR(?friend_a_label))), "")) AS ?_result)
            }
        """ ;
    ] .

# === Rules for GradeLevelRecords ===
south-park-ontology-in-sdlaf-shapes:GradeLevelRecords_Name a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:GradeLevelRecords ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GradeLevelRecords_Name" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:name ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:GradeLevelRecords .
    OPTIONAL { $this south-park-ontology-in-sdlaf:gradeLevel ?grade_level . OPTIONAL { ?grade_level erb:key ?grade_level__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:individualLabel ?individual_label . OPTIONAL { ?individual_label erb:key ?individual_label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?individual_label__key, IF(isIRI(?individual_label), REPLACE(STR(?individual_label), "^.*[#/]", ""), STR(?individual_label))), ""), " has grade level ", COALESCE(COALESCE(?grade_level__key, IF(isIRI(?grade_level), REPLACE(STR(?grade_level), "^.*[#/]", ""), STR(?grade_level))), "")) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:GradeLevelRecords_IndividualLabel a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:GradeLevelRecords ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GradeLevelRecords_IndividualLabel" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:individualLabel ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:GradeLevelRecords .
                OPTIONAL { $this south-park-ontology-in-sdlaf:individual ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Individuals . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:GradeLevelRecords_IndividualLatestSeq a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:GradeLevelRecords ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GradeLevelRecords_IndividualLatestSeq" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:individualLatestSeq ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:GradeLevelRecords .
                OPTIONAL { $this south-park-ontology-in-sdlaf:individual ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Individuals . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:latestGradeLevelSeq ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:GradeLevelRecords_IsCurrent a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:GradeLevelRecords ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GradeLevelRecords_IsCurrent" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:isCurrent ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:GradeLevelRecords .
    OPTIONAL { $this south-park-ontology-in-sdlaf:individualLatestSeq ?individual_latest_seq . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:isOn ?is_on . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:statedSeq ?stated_seq . }
                BIND((COALESCE(?is_on, false) && COALESCE((COALESCE(?stated_seq, 0) = COALESCE(?individual_latest_seq, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:GradeLevelRecords_KeyIsCanonical a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:GradeLevelRecords ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_GradeLevelRecords_KeyIsCanonical" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:keyIsCanonical ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:GradeLevelRecords .
    OPTIONAL { $this south-park-ontology-in-sdlaf:gradeLevelRecordId ?grade_level_record_id . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:individual ?individual . OPTIONAL { ?individual erb:key ?individual__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:statedSeq ?stated_seq . OPTIONAL { ?stated_seq erb:key ?stated_seq__key . } }
                BIND(COALESCE((?grade_level_record_id = CONCAT(COALESCE(COALESCE(?individual__key, IF(isIRI(?individual), REPLACE(STR(?individual), "^.*[#/]", ""), STR(?individual))), ""), "|grade|", COALESCE(COALESCE(?stated_seq__key, IF(isIRI(?stated_seq), REPLACE(STR(?stated_seq), "^.*[#/]", ""), STR(?stated_seq))), ""))), false) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Grandparenthoods ===
south-park-ontology-in-sdlaf-shapes:Grandparenthoods_Name a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Grandparenthoods ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Grandparenthoods_Name" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:name ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Grandparenthoods .
    OPTIONAL { $this south-park-ontology-in-sdlaf:grandchildLabel ?grandchild_label . OPTIONAL { ?grandchild_label erb:key ?grandchild_label__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:grandparentLabel ?grandparent_label . OPTIONAL { ?grandparent_label erb:key ?grandparent_label__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:links ?links . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:lowerLink ?lower_link . OPTIONAL { ?lower_link erb:key ?lower_link__key . } }
    OPTIONAL { $this south-park-ontology-in-sdlaf:upperLink ?upper_link . OPTIONAL { ?upper_link erb:key ?upper_link__key . } }
                BIND(IF(COALESCE(?links, false), CONCAT(COALESCE(COALESCE(?grandparent_label__key, IF(isIRI(?grandparent_label), REPLACE(STR(?grandparent_label), "^.*[#/]", ""), STR(?grandparent_label))), ""), " is grandparent of ", COALESCE(COALESCE(?grandchild_label__key, IF(isIRI(?grandchild_label), REPLACE(STR(?grandchild_label), "^.*[#/]", ""), STR(?grandchild_label))), "")), CONCAT("(", COALESCE(COALESCE(?upper_link__key, IF(isIRI(?upper_link), REPLACE(STR(?upper_link), "^.*[#/]", ""), STR(?upper_link))), ""), " does not lead to ", COALESCE(COALESCE(?lower_link__key, IF(isIRI(?lower_link), REPLACE(STR(?lower_link), "^.*[#/]", ""), STR(?lower_link))), ""), ")")) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Grandparenthoods_Grandparent a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Grandparenthoods ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Grandparenthoods_Grandparent" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:grandparent ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Grandparenthoods .
                OPTIONAL { $this south-park-ontology-in-sdlaf:upperLink ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Parenthoods . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:parent ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
