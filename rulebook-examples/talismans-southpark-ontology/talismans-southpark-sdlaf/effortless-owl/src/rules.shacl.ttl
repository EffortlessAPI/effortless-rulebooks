            WHERE {
    $this a south-park-ontology-in-sdlaf:Individuals .
    OPTIONAL { $this south-park-ontology-in-sdlaf:domainRangeIsOn ?domain_range_is_on . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:hasPersonEvidence ?has_person_evidence . }
                BIND((COALESCE(?domain_range_is_on, false) && COALESCE(?has_person_evidence, false)) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Individuals_IsPerson a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Individuals ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Individuals_IsPerson" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:isPerson ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Individuals .
    OPTIONAL { $this south-park-ontology-in-sdlaf:isAssertedPerson ?is_asserted_person . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:isPersonByDomain ?is_person_by_domain . }
                BIND(IF(COALESCE((COALESCE(?is_asserted_person, false) || COALESCE(?is_person_by_domain, false)), false), true, "") AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Individuals_IsPersonConcluded a sh:NodeShape ;
