south-park-ontology-in-sdlaf-shapes:Grandparenthoods_GrandchildLabel a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Grandparenthoods ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Grandparenthoods_GrandchildLabel" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:grandchildLabel ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Grandparenthoods .
                OPTIONAL { $this south-park-ontology-in-sdlaf:lowerLink ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Parenthoods . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:childLabel ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Grandparenthoods_Links a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Grandparenthoods ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Grandparenthoods_Links" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:links ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Grandparenthoods .
    OPTIONAL { $this south-park-ontology-in-sdlaf:lowerParent ?lower_parent . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:upperChild ?upper_child . }
                BIND(COALESCE((?upper_child = ?lower_parent), ((!BOUND(?upper_child) || STR(?upper_child) = "") && (!BOUND(?lower_parent) || STR(?lower_parent) = ""))) AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Grandparenthoods_ChainIsOn a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Grandparenthoods ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Grandparenthoods_ChainIsOn" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:chainIsOn ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Grandparenthoods .
                OPTIONAL { $this south-park-ontology-in-sdlaf:reasoning ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a south-park-ontology-in-sdlaf:Reasoning . OPTIONAL { ?j1 south-park-ontology-in-sdlaf:chainIsOn ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
south-park-ontology-in-sdlaf-shapes:Grandparenthoods_Holds a sh:NodeShape ;
