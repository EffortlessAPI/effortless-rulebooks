south-park-ontology-in-sdlaf-shapes:Reasoning_CountOfStatedFacts a sh:NodeShape ;
    sh:targetClass south-park-ontology-in-sdlaf:Reasoning ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Reasoning_CountOfStatedFacts" ;
        sh:construct """
            PREFIX south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#>
            CONSTRUCT {
                $this south-park-ontology-in-sdlaf:countOfStatedFacts ?_result .
            }
            WHERE {
    $this a south-park-ontology-in-sdlaf:Reasoning .
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfCurrentGradeLevels ?count_of_current_grade_levels . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfCurrentRoles ?count_of_current_roles . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfStatedFriendships ?count_of_stated_friendships . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfStatedIndividualFacts ?count_of_stated_individual_facts . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfStatedMarriages ?count_of_stated_marriages . }
    OPTIONAL { $this south-park-ontology-in-sdlaf:countOfStatedParenthoods ?count_of_stated_parenthoods . }
                BIND(ROUND((((((?count_of_stated_parenthoods + ?count_of_stated_marriages) + ?count_of_stated_friendships) + ?count_of_stated_individual_facts) + ?count_of_current_grade_levels) + ?count_of_current_roles)) AS ?_result)
            }
        """ ;
    ] .
