@prefix south-park-ontology-in-sdlaf: <https://example.org/south-park-ontology-in-sdlaf#> .
@prefix erb: <https://effortlessapi.com/ns/erb#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://example.org/south-park-ontology-in-sdlaf> a owl:Ontology ;
    rdfs:label "South Park ontology, in SDLAF" ;
    dcterms:title "South Park ontology, in SDLAF" ;
    dcterms:description "Jessica Talisman's South Park ontology as an ordinary rulebook: her ten stated facts are rows and columns of the tables they are about (people, parenthoods, marriages, friendships, grade and role records), and each of her five rules is a field: the inverse is the parenthood read from the child's end, the symmetric rule a link with no direction counted from both ends, the property chain a lookup through two parenthoods, domain and range a formula and a count on each individual, disjointness a check on each parenthood. Every rule is switched by the one Reasoning row. Nothing is a generic subject-property-object store: Schema, Data, Lookups, Aggregations and Formulas only." ;
    rdfs:comment "Generated by Effortless (rulebook-to-owl) from south-park-ontology-in-sdlaf-rulebook.json. The rulebook is the source: change it there, not here." ;
    rdfs:comment "This namespace is a placeholder derived from the rulebook's name. To publish under your own, add a row to the rulebook's __meta__ table: MetaKey ontology_iri, StringValue your IRI." ;
    rdfs:comment "ERB build parameters: erbBlankLogic=coerce, erbDateDiff=calendar, erbDateTimeText=iso8601, erbTimezone=UTC, erbWholeNumber=by-field-type" .

dcterms:description a owl:AnnotationProperty .
dcterms:title a owl:AnnotationProperty .

# The key of the row an individual was made from, verbatim (its IRI is only a slug of it).
erb:key a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "key" .

# === Class: Friendships ===
south-park-ontology-in-sdlaf:Friendships a owl:Class ;
    rdfs:label "Friendships" ;
    rdfs:comment "One row per stated isFriendOf fact, read both ways by the symmetric rule, like a marriage." .

# === Class: GradeLevelRecords ===
south-park-ontology-in-sdlaf:GradeLevelRecords a owl:Class ;
    rdfs:label "GradeLevelRecords" ;
    rdfs:comment "Every grade level stated for an individual, kept when a later one replaces it: her page keeps one current grade, the latest switched on. The current value is time (which was stated last), not a flag." .

# === Class: Grandparenthoods ===
south-park-ontology-in-sdlaf:Grandparenthoods a owl:Class ;
    rdfs:label "Grandparenthoods" ;
    rdfs:comment "The property chain isParentOf then isParentOf, as rows: every ordered pair of parenthoods is a candidate, and it holds when the first one's child is the second one's parent. A formula cannot add a row, so the candidates are data (every pair, decided by nothing about the family) and whether one holds is a formula." .

# === Class: Individuals ===
south-park-ontology-in-sdlaf:Individuals a owl:Class ;
    rdfs:label "Individuals" ;
    rdfs:comment "Every individual of the world (owl:Thing). What is said about one individual alone is a column of its row: its age, the place it attends, whether it is asserted to be a Person or a School. Its current grade level and role come from their records. Class membership is a formula, not a table, because it is concluded: no one stated that South Park Elementary is a School." .

# === Class: Marriages ===
south-park-ontology-in-sdlaf:Marriages a owl:Class ;
    rdfs:label "Marriages" ;
    rdfs:comment "One row per stated isSpouseOf fact. A marriage has no direction: the symmetric rule is the same row counted from its second partner's end." .

# === Class: Parenthoods ===
south-park-ontology-in-sdlaf:Parenthoods a owl:Class ;
    rdfs:label "Parenthoods" ;
    rdfs:comment "One row per stated isParentOf fact. A person has many children and a child more than one parent, so the link is its own entity with two links to Individuals. The inverse rule's isChildOf is not stored: it is this row read from the child's end." .

# === Class: Portraits ===
south-park-ontology-in-sdlaf:Portraits a owl:Class ;
    rdfs:label "Portraits" ;
    rdfs:comment "The picture of each individual, linked from its Fandom page (never downloaded)." .

# === Class: Reasoning ===
south-park-ontology-in-sdlaf:Reasoning a owl:Class ;
    rdfs:label "Reasoning" ;
    rdfs:comment "The one world the rules reason over, and the switch of each of her five rules. Every table links here, so each rule's switch is one lookup away from the field it gates, and every count of the world rolls up here." .

# === Class: RoleRecords ===
south-park-ontology-in-sdlaf:RoleRecords a owl:Class ;
    rdfs:label "RoleRecords" ;
    rdfs:comment "Every role stated for an individual; the latest one switched on is in effect, like a grade level." .

south-park-ontology-in-sdlaf:age a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "Age" ;
    rdfs:comment "Stated: hasAge." .

south-park-ontology-in-sdlaf:ancestorCount a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "AncestorCount" ;
    rdfs:comment "Order 1. Everyone above this individual through one or more parenthoods." .

# south-park-ontology-in-sdlaf:ancestry holds the edges whose transitive closure the rulebook counts
south-park-ontology-in-sdlaf:ancestry a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "Ancestry" .

south-park-ontology-in-sdlaf:attendedByCount a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "AttendedByCount" ;
    rdfs:comment "Order 1. Individuals that attend this one." .

south-park-ontology-in-sdlaf:attends a owl:ObjectProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range south-park-ontology-in-sdlaf:Individuals ;
    rdfs:label "Attends" ;
    rdfs:comment "Stated: the place this individual attends (attends). Its range is School." .

south-park-ontology-in-sdlaf:attendsLabel a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:string ;
    rdfs:label "AttendsLabel" ;
    rdfs:comment "Order 1. The name of the place attended." .

south-park-ontology-in-sdlaf:chainIsOn a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "ChainIsOn" .

south-park-ontology-in-sdlaf:child a owl:ObjectProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Parenthoods ;
    rdfs:range south-park-ontology-in-sdlaf:Individuals ;
    rdfs:label "Child" ;
    rdfs:comment "The child (the object of isParentOf)." .

south-park-ontology-in-sdlaf:childCount a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "ChildCount" ;
    rdfs:comment "Order 1. Children: parenthoods where this individual is the parent (isParentOf)." .

south-park-ontology-in-sdlaf:childLabel a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Parenthoods ;
    rdfs:range xsd:string ;
    rdfs:label "ChildLabel" ;
    rdfs:comment "Order 1. The child's name." .

south-park-ontology-in-sdlaf:childOfFactCount a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "ChildOfFactCount" ;
    rdfs:comment "Order 2. isChildOf facts about this individual: its parenthoods read from its end, when the inverse rule is on." .

south-park-ontology-in-sdlaf:childOfHolds a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Parenthoods ;
    rdfs:range xsd:boolean ;
    rdfs:label "ChildOfHolds" ;
    rdfs:comment "Order 2. The inverse rule concludes the child is child of the parent. Open world: true, or not known." .

south-park-ontology-in-sdlaf:childOfSentence a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Parenthoods ;
    rdfs:range xsd:string ;
    rdfs:label "ChildOfSentence" ;
    rdfs:comment "Order 2. The inverse fact in words." .

south-park-ontology-in-sdlaf:countOfChildOfConclusions a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfChildOfConclusions" ;
    rdfs:comment "Order 2. isChildOf facts the inverse rule concludes: one per parenthood." .

south-park-ontology-in-sdlaf:countOfConclusions a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfConclusions" ;
    rdfs:comment "Order 5. Every fact the rules conclude that no one stated." .

south-park-ontology-in-sdlaf:countOfContradictions a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfContradictions" ;
    rdfs:comment "Order 4. Parenthoods the disjoint rule flags: the parent is also the child's spouse." .

south-park-ontology-in-sdlaf:countOfCurrentGradeLevels a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfCurrentGradeLevels" ;
    rdfs:comment "Order 3. Grade level facts in effect: each person's current grade." .

south-park-ontology-in-sdlaf:countOfCurrentRoles a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfCurrentRoles" ;
    rdfs:comment "Order 3. Role facts in effect: each person's current role." .

south-park-ontology-in-sdlaf:countOfGradeLevelsOn a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfGradeLevelsOn" ;
    rdfs:comment "Order 1. Grade level records switched on for this individual." .

south-park-ontology-in-sdlaf:countOfGrandparentConclusions a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfGrandparentConclusions" ;
    rdfs:comment "Order 4. isGrandparentOf facts the property chain concludes." .

south-park-ontology-in-sdlaf:countOfIndividuals a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfIndividuals" ;
    rdfs:comment "Order 1. Every individual of the world." .

south-park-ontology-in-sdlaf:countOfMirroredFriendships a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfMirroredFriendships" ;
    rdfs:comment "Order 2. isFriendOf facts the symmetric rule concludes: one per friendship, read from its second friend." .

south-park-ontology-in-sdlaf:countOfMirroredMarriages a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfMirroredMarriages" ;
    rdfs:comment "Order 2. isSpouseOf facts the symmetric rule concludes: one per marriage, read from its second partner." .

south-park-ontology-in-sdlaf:countOfPeople a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfPeople" ;
    rdfs:comment "Order 3. Individuals that are a Person, asserted or concluded." .

south-park-ontology-in-sdlaf:countOfPersonConclusions a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfPersonConclusions" ;
    rdfs:comment "Order 3. Individuals the domain rule makes a Person that no one asserted was one." .

south-park-ontology-in-sdlaf:countOfRolesOn a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfRolesOn" ;
    rdfs:comment "Order 1. Role records switched on for this individual." .

south-park-ontology-in-sdlaf:countOfSchoolConclusions a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfSchoolConclusions" ;
    rdfs:comment "Order 3. Individuals the range rule makes a School that no one asserted was one." .

south-park-ontology-in-sdlaf:countOfSchools a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfSchools" ;
    rdfs:comment "Order 3. Individuals that are a School, asserted or concluded." .

south-park-ontology-in-sdlaf:countOfStatedFacts a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfStatedFacts" ;
    rdfs:comment "Order 4. Every stated fact in effect, wherever it is held." .

south-park-ontology-in-sdlaf:countOfStatedFriendships a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfStatedFriendships" ;
    rdfs:comment "Order 1. Stated isFriendOf facts: one per Friendships row." .

south-park-ontology-in-sdlaf:countOfStatedIndividualFacts a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfStatedIndividualFacts" ;
    rdfs:comment "Order 3. Stated facts held as columns of an individual: attends, has age and is a." .

south-park-ontology-in-sdlaf:countOfStatedMarriages a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfStatedMarriages" ;
    rdfs:comment "Order 1. Stated isSpouseOf facts: one per Marriages row." .

south-park-ontology-in-sdlaf:countOfStatedParenthoods a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfStatedParenthoods" ;
    rdfs:comment "Order 1. Stated isParentOf facts: one per Parenthoods row." .

south-park-ontology-in-sdlaf:crop a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Portraits ;
    rdfs:range xsd:string ;
    rdfs:label "Crop" ;
    rdfs:comment "The crop as an SVG viewBox: x y width height." .

south-park-ontology-in-sdlaf:currentGradeLevelRecord a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentGradeLevelRecord" ;
    rdfs:comment "Order 3. Key of the grade level record in effect." .

south-park-ontology-in-sdlaf:currentRoleRecord a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:string ;
    rdfs:label "CurrentRoleRecord" ;
    rdfs:comment "Order 3. Key of the role record in effect." .

south-park-ontology-in-sdlaf:descendantCount a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "DescendantCount" ;
    rdfs:comment "Order 1. Everyone below this individual through one or more parenthoods: the transitive closure, which her page does not draw." .

south-park-ontology-in-sdlaf:disjointIsOn a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "DisjointIsOn" .

south-park-ontology-in-sdlaf:displayName a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Portraits ;
    rdfs:range xsd:string ;
    rdfs:label "DisplayName" ;
    rdfs:comment "The name on the portrait's Fandom page." .

south-park-ontology-in-sdlaf:domainRangeIsOn a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "DomainRangeIsOn" .

south-park-ontology-in-sdlaf:friendA a owl:ObjectProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Friendships ;
    rdfs:range south-park-ontology-in-sdlaf:Individuals ;
    rdfs:label "FriendA" ;
    rdfs:comment "The friend the stated fact names first." .

south-park-ontology-in-sdlaf:friendALabel a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Friendships ;
    rdfs:range xsd:string ;
    rdfs:label "FriendALabel" ;
    rdfs:comment "Order 1. The frienda's name." .

south-park-ontology-in-sdlaf:friendB a owl:ObjectProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Friendships ;
    rdfs:range south-park-ontology-in-sdlaf:Individuals ;
    rdfs:label "FriendB" ;
    rdfs:comment "The friend the stated fact names second." .

south-park-ontology-in-sdlaf:friendBLabel a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Friendships ;
    rdfs:range xsd:string ;
    rdfs:label "FriendBLabel" ;
    rdfs:comment "Order 1. The friendb's name." .

south-park-ontology-in-sdlaf:friendCount a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "FriendCount" ;
    rdfs:comment "Order 4. Friends: isFriendOf facts about this individual, stated or mirrored." .

south-park-ontology-in-sdlaf:friendshipId a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Friendships ;
    rdfs:range xsd:string ;
    rdfs:label "FriendshipId" ;
    rdfs:comment "Key of the fact: subject|property|object, as her page names it." .

south-park-ontology-in-sdlaf:gradeLevel a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "GradeLevel" .

south-park-ontology-in-sdlaf:gradeLevelRecordId a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:GradeLevelRecords ;
    rdfs:range xsd:string ;
    rdfs:label "GradeLevelRecordId" ;
    rdfs:comment "Key: individual|grade|when it was stated." .

south-park-ontology-in-sdlaf:grandchild a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Grandparenthoods ;
    rdfs:range xsd:string ;
    rdfs:label "Grandchild" ;
    rdfs:comment "Order 1. The lower link's child." .

south-park-ontology-in-sdlaf:grandchildCount a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "GrandchildCount" ;
    rdfs:comment "Order 5. Grandchildren the property chain concludes (isGrandparentOf)." .

south-park-ontology-in-sdlaf:grandchildLabel a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Grandparenthoods ;
    rdfs:range xsd:string ;
    rdfs:label "GrandchildLabel" ;
    rdfs:comment "Order 2. The grandchild's name." .

south-park-ontology-in-sdlaf:grandparent a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Grandparenthoods ;
    rdfs:range xsd:string ;
    rdfs:label "Grandparent" ;
    rdfs:comment "Order 1. The upper link's parent." .

south-park-ontology-in-sdlaf:grandparentCount a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:integer ;
    rdfs:label "GrandparentCount" ;
    rdfs:comment "Order 5. Grandparents the property chain concludes, read from the grandchild's end." .

south-park-ontology-in-sdlaf:grandparentLabel a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Grandparenthoods ;
    rdfs:range xsd:string ;
    rdfs:label "GrandparentLabel" ;
    rdfs:comment "Order 2. The grandparent's name." .

south-park-ontology-in-sdlaf:grandparenthoodId a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Grandparenthoods ;
    rdfs:range xsd:string ;
    rdfs:label "GrandparenthoodId" ;
    rdfs:comment "Key: the upper parenthood, then the lower one." .

south-park-ontology-in-sdlaf:hasAge a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasAge" ;
    rdfs:comment "Order 1. An age is stated." .

south-park-ontology-in-sdlaf:hasAttends a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasAttends" ;
    rdfs:comment "Order 1. A place attended is stated." .

south-park-ontology-in-sdlaf:hasGradeLevel a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasGradeLevel" ;
    rdfs:comment "Order 2. A grade level is in effect." .

south-park-ontology-in-sdlaf:hasPersonEvidence a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasPersonEvidence" ;
    rdfs:comment "Order 3. Something is stated that only a Person can have: a place attended, a grade level or a role (the domain of attends, hasGradeLevel and hasRole)." .

south-park-ontology-in-sdlaf:hasRole a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasRole" ;
    rdfs:comment "Order 2. A role is in effect." .

south-park-ontology-in-sdlaf:height a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Portraits ;
    rdfs:range xsd:integer ;
    rdfs:label "Height" ;
    rdfs:comment "The original image's height in pixels." .

south-park-ontology-in-sdlaf:holds a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Grandparenthoods ;
    rdfs:range xsd:boolean ;
    rdfs:label "Holds" ;
    rdfs:comment "Order 3. The property chain concludes isGrandparentOf. Open world: true, or not known." .

south-park-ontology-in-sdlaf:image a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Portraits ;
    rdfs:range xsd:string ;
    rdfs:label "Image" ;
    rdfs:comment "The original Fandom image." .

south-park-ontology-in-sdlaf:individual a owl:ObjectProperty ;
    rdfs:range south-park-ontology-in-sdlaf:Individuals ;
    rdfs:label "Individual" .

south-park-ontology-in-sdlaf:individualId a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:string ;
    rdfs:label "IndividualId" ;
    rdfs:comment "Key of the individual." .

south-park-ontology-in-sdlaf:individualLabel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "IndividualLabel" .

south-park-ontology-in-sdlaf:individualLatestSeq a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "IndividualLatestSeq" .

south-park-ontology-in-sdlaf:inverseIsOn a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "InverseIsOn" .

south-park-ontology-in-sdlaf:isAssertedPerson a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAssertedPerson" ;
    rdfs:comment "Stated: this individual is a Person (isA Person)." .

south-park-ontology-in-sdlaf:isAssertedSchool a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Individuals ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsAssertedSchool" ;
    rdfs:comment "Stated: this individual is a School (isA School)." .

south-park-ontology-in-sdlaf:isConsistent a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Reasoning ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConsistent" ;
    rdfs:comment "Order 5. No contradiction the disjoint rule can see." .

south-park-ontology-in-sdlaf:isContradiction a owl:DatatypeProperty ;
    rdfs:domain south-park-ontology-in-sdlaf:Parenthoods ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsContradiction" ;
    rdfs:comment "Order 4. The disjoint rule: the parent is also the child's spouse. Open world: true, or not known." .

south-park-ontology-in-sdlaf:isCurrent a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsCurrent" .

south-park-ontology-in-sdlaf:isOn a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
