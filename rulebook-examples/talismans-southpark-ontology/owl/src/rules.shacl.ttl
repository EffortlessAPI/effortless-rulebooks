    OPTIONAL { $this talismans-south-park-ontology-explainer:sortOrder ?sort_order . }
                BIND((COALESCE((COALESCE(?listed_off_unit, 0) = 1), false) && COALESCE((COALESCE(?sort_order, 0) = COALESCE(?next_fact_sort_order, 0)), false)) AS ?_result)
            }
        """ ;
    ] .
talismans-south-park-ontology-explainer-shapes:Statements_CountOfInverseFirings a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:Statements ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_CountOfInverseFirings" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:countOfInverseFirings ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Statements .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a talismans-south-park-ontology-explainer:Statements .
                    ?child a talismans-south-park-ontology-explainer:Firings .
                    ?child talismans-south-park-ontology-explainer:target $this .
                    OPTIONAL { ?child talismans-south-park-ontology-explainer:inverseFiredUnit ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
