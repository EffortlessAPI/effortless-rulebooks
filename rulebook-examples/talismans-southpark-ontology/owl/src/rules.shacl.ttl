            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:chosenUnit ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Firings .
    OPTIONAL { $this talismans-south-park-ontology-explainer:isChosen ?is_chosen . }
                BIND(ROUND(IF(COALESCE(?is_chosen, false), 1, 0)) AS ?_result)
            }
        """ ;
    ] .
talismans-south-park-ontology-explainer-shapes:Firings_CardText a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:Firings ;
    sh:order 19 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_CardText" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:cardText ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Firings .
    OPTIONAL { $this talismans-south-park-ontology-explainer:firstProperty ?first_property . OPTIONAL { ?first_property erb:key ?first_property__key . } }
    OPTIONAL { $this talismans-south-park-ontology-explainer:firstPropertyDomainClass ?first_property_domain_class . OPTIONAL { ?first_property_domain_class erb:key ?first_property_domain_class__key . } }
    OPTIONAL { $this talismans-south-park-ontology-explainer:firstPropertyRangeClass ?first_property_range_class . OPTIONAL { ?first_property_range_class erb:key ?first_property_range_class__key . } }
    OPTIONAL { $this talismans-south-park-ontology-explainer:firstWords ?first_words . OPTIONAL { ?first_words erb:key ?first_words__key . } }
    OPTIONAL { $this talismans-south-park-ontology-explainer:isChosen ?is_chosen . }
    OPTIONAL { $this talismans-south-park-ontology-explainer:kind ?kind . OPTIONAL { ?kind erb:key ?kind__key . } }
    OPTIONAL { $this talismans-south-park-ontology-explainer:kindWording ?kind_wording . OPTIONAL { ?kind_wording erb:key ?kind_wording__key . } }
    OPTIONAL { $this talismans-south-park-ontology-explainer:secondWords ?second_words . OPTIONAL { ?second_words erb:key ?second_words__key . } }
                BIND(IF(COALESCE(?is_chosen, false), CONCAT("Worked out by the ", COALESCE(COALESCE(?kind_wording__key, IF(isIRI(?kind_wording), REPLACE(STR(?kind_wording), "^.*[#/]", ""), STR(?kind_wording))), ""), " from “", COALESCE(COALESCE(?first_words__key, IF(isIRI(?first_words), REPLACE(STR(?first_words), "^.*[#/]", ""), STR(?first_words))), ""), "”", COALESCE(IF(isIRI(IF(COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "chain"), false), CONCAT(" and “", COALESCE(COALESCE(?second_words__key, IF(isIRI(?second_words), REPLACE(STR(?second_words), "^.*[#/]", ""), STR(?second_words))), ""), "”"), IF(COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "domain"), false), CONCAT(" and “", COALESCE(COALESCE(?first_property__key, IF(isIRI(?first_property), REPLACE(STR(?first_property), "^.*[#/]", ""), STR(?first_property))), ""), " has domain ", COALESCE(COALESCE(?first_property_domain_class__key, IF(isIRI(?first_property_domain_class), REPLACE(STR(?first_property_domain_class), "^.*[#/]", ""), STR(?first_property_domain_class))), ""), "”"), IF(COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "range"), false), CONCAT(" and “", COALESCE(COALESCE(?first_property__key, IF(isIRI(?first_property), REPLACE(STR(?first_property), "^.*[#/]", ""), STR(?first_property))), ""), " has range ", COALESCE(COALESCE(?first_property_range_class__key, IF(isIRI(?first_property_range_class), REPLACE(STR(?first_property_range_class), "^.*[#/]", ""), STR(?first_property_range_class))), ""), "”"), "")))), REPLACE(STR(IF(COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "chain"), false), CONCAT(" and “", COALESCE(COALESCE(?second_words__key, IF(isIRI(?second_words), REPLACE(STR(?second_words), "^.*[#/]", ""), STR(?second_words))), ""), "”"), IF(COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "domain"), false), CONCAT(" and “", COALESCE(COALESCE(?first_property__key, IF(isIRI(?first_property), REPLACE(STR(?first_property), "^.*[#/]", ""), STR(?first_property))), ""), " has domain ", COALESCE(COALESCE(?first_property_domain_class__key, IF(isIRI(?first_property_domain_class), REPLACE(STR(?first_property_domain_class), "^.*[#/]", ""), STR(?first_property_domain_class))), ""), "”"), IF(COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "range"), false), CONCAT(" and “", COALESCE(COALESCE(?first_property__key, IF(isIRI(?first_property), REPLACE(STR(?first_property), "^.*[#/]", ""), STR(?first_property))), ""), " has range ", COALESCE(COALESCE(?first_property_range_class__key, IF(isIRI(?first_property_range_class), REPLACE(STR(?first_property_range_class), "^.*[#/]", ""), STR(?first_property_range_class))), ""), "”"), "")))), "^.*[#/]", ""), STR(IF(COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "chain"), false), CONCAT(" and “", COALESCE(COALESCE(?second_words__key, IF(isIRI(?second_words), REPLACE(STR(?second_words), "^.*[#/]", ""), STR(?second_words))), ""), "”"), IF(COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "domain"), false), CONCAT(" and “", COALESCE(COALESCE(?first_property__key, IF(isIRI(?first_property), REPLACE(STR(?first_property), "^.*[#/]", ""), STR(?first_property))), ""), " has domain ", COALESCE(COALESCE(?first_property_domain_class__key, IF(isIRI(?first_property_domain_class), REPLACE(STR(?first_property_domain_class), "^.*[#/]", ""), STR(?first_property_domain_class))), ""), "”"), IF(COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "range"), false), CONCAT(" and “", COALESCE(COALESCE(?first_property__key, IF(isIRI(?first_property), REPLACE(STR(?first_property), "^.*[#/]", ""), STR(?first_property))), ""), " has range ", COALESCE(COALESCE(?first_property_range_class__key, IF(isIRI(?first_property_range_class), REPLACE(STR(?first_property_range_class), "^.*[#/]", ""), STR(?first_property_range_class))), ""), "”"), ""))))), ""), "."), "") AS ?_result)
            }
        """ ;
    ] .
talismans-south-park-ontology-explainer-shapes:Firings_Name a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:Firings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_Name" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:name ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Firings .
    OPTIONAL { $this talismans-south-park-ontology-explainer:firingId ?firing_id . }
                BIND(?firing_id AS ?_result)
            }
        """ ;
    ] .

# === Rules for Graphs ===
talismans-south-park-ontology-explainer-shapes:Graphs_Name a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:Graphs ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Graphs_Name" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:name ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Graphs .
    OPTIONAL { $this talismans-south-park-ontology-explainer:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
talismans-south-park-ontology-explainer-shapes:Graphs_CountOfStatedFacts a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:Graphs ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Graphs_CountOfStatedFacts" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:countOfStatedFacts ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Graphs .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a talismans-south-park-ontology-explainer:Graphs .
                    ?child a talismans-south-park-ontology-explainer:Statements .
                    ?child talismans-south-park-ontology-explainer:graph $this .
                    OPTIONAL { ?child talismans-south-park-ontology-explainer:inEffectUnit ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .
