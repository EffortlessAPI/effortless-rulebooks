    ] .
talismans-south-park-ontology-explainer-shapes:Graphs_NextFactSortOrder a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:Graphs ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Graphs_NextFactSortOrder" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:nextFactSortOrder ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Graphs .
                OPTIONAL {
                    SELECT $this (MIN(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MIN(?sumval) AS ?cval) WHERE {
                        $this a talismans-south-park-ontology-explainer:Graphs .
                    ?child a talismans-south-park-ontology-explainer:Statements .
                    ?child talismans-south-park-ontology-explainer:graph $this .
                    OPTIONAL { ?child talismans-south-park-ontology-explainer:listedOffUnit ?c2 . OPTIONAL { ?c2 erb:key ?c2__key . } }
                    OPTIONAL { ?child talismans-south-park-ontology-explainer:sortOrder ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER(?c2 = 1)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
talismans-south-park-ontology-explainer-shapes:Graphs_MaxActivationSeq a sh:NodeShape ;
