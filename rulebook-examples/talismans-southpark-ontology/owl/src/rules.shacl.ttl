    $this a talismans-south-park-ontology-explainer:Statements .
    OPTIONAL { $this talismans-south-park-ontology-explainer:activationSeq ?activation_seq . }
    OPTIONAL { $this talismans-south-park-ontology-explainer:isStated ?is_stated . }
    OPTIONAL { $this talismans-south-park-ontology-explainer:latestSiblingActivationSeq ?latest_sibling_activation_seq . }
    OPTIONAL { $this talismans-south-park-ontology-explainer:propertyHasOneCurrentValue ?property_has_one_current_value . }
                BIND((COALESCE(?is_stated, false) && COALESCE((COALESCE((!(COALESCE(?property_has_one_current_value, false))), false) || COALESCE((COALESCE(?activation_seq, 0) = COALESCE(?latest_sibling_activation_seq, 0)), false)), false)) AS ?_result)
            }
        """ ;
    ] .
