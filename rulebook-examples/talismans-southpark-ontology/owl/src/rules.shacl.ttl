    OPTIONAL { $this talismans-south-park-ontology-explainer:countOfInverseFirings ?count_of_inverse_firings . }
    OPTIONAL { $this talismans-south-park-ontology-explainer:countOfSymmetricFirings ?count_of_symmetric_firings . }
    OPTIONAL { $this talismans-south-park-ontology-explainer:isInEffect ?is_in_effect . }
                BIND((COALESCE(?is_in_effect, false) || COALESCE((COALESCE(?count_of_inverse_firings, 0) > 0), false) || COALESCE((COALESCE(?count_of_symmetric_firings, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
talismans-south-park-ontology-explainer-shapes:Statements_CountOfChainFirings a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:Statements ;
