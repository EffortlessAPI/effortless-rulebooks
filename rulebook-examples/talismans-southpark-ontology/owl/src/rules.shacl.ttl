    OPTIONAL { $this talismans-south-park-ontology-explainer:countOfConclusions ?count_of_conclusions . }
    OPTIONAL { $this talismans-south-park-ontology-explainer:noConclusionsText ?no_conclusions_text . }
                BIND(IF(COALESCE((COALESCE(?count_of_conclusions, 0) = 0), false), ?no_conclusions_text, "") AS ?_result)
            }
        """ ;
    ] .
