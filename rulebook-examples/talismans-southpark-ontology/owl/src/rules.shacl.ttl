            WHERE {
    $this a talismans-south-park-ontology-explainer:Scenarios .
                OPTIONAL { $this talismans-south-park-ontology-explainer:graph ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a talismans-south-park-ontology-explainer:Graphs . OPTIONAL { ?j1 talismans-south-park-ontology-explainer:hasFactsToAdd ?j3 . } }
