@prefix talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#> .
@prefix talismans-south-park-ontology-explainer-shapes: <https://example.org/talismans-south-park-ontology-explainer/shapes#> .
@prefix erb: <https://effortlessapi.com/ns/erb#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# === Rules for DisjointChecks ===
talismans-south-park-ontology-explainer-shapes:DisjointChecks_RuleEnabled a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:DisjointChecks ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DisjointChecks_RuleEnabled" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:ruleEnabled ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:DisjointChecks .
                OPTIONAL { $this talismans-south-park-ontology-explainer:rule ?j0 . OPTIONAL { ?j0 erb:key ?j2_of . } BIND(COALESCE(?j2_of, STR(?j0)) AS ?j2) ?j1 erb:key ?j2 ; a talismans-south-park-ontology-explainer:Rules . OPTIONAL { ?j1 talismans-south-park-ontology-explainer:isEnabled ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
talismans-south-park-ontology-explainer-shapes:DisjointChecks_FirstHolds a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:DisjointChecks ;
    sh:order 16 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DisjointChecks_FirstHolds" ;
