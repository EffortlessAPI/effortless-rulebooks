    OPTIONAL { $this talismans-south-park-ontology-explainer:secondSortOrder ?second_sort_order . }
                BIND(ROUND((((?first_sort_order * 100000) + (?kind_sort_order * 1000)) + IF(COALESCE((COALESCE(?second__key, COALESCE(IF(isIRI(?second), REPLACE(STR(?second), "^.*[#/]", ""), STR(?second)), "")) = ""), false), 0, ?second_sort_order))) AS ?_result)
