                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
talismans-south-park-ontology-explainer-shapes:Graphs_NextActivationSeq a sh:NodeShape ;
