    sh:targetClass talismans-south-park-ontology-explainer:Scenarios ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Scenarios_IsAvailable" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:isAvailable ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Scenarios .
    OPTIONAL { $this talismans-south-park-ontology-explainer:factBaseline ?fact_baseline . OPTIONAL { ?fact_baseline erb:key ?fact_baseline__key . } }
    OPTIONAL { $this talismans-south-park-ontology-explainer:graphHasFactsToAdd ?graph_has_facts_to_add . }
                BIND((COALESCE((COALESCE(?fact_baseline__key, COALESCE(IF(isIRI(?fact_baseline), REPLACE(STR(?fact_baseline), "^.*[#/]", ""), STR(?fact_baseline)), "")) != "next"), false) || COALESCE(?graph_has_facts_to_add, false)) AS ?_result)
            }
        """ ;
    ] .

