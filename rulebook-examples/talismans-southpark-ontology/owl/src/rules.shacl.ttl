            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:isChosen ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Firings .
    OPTIONAL { $this talismans-south-park-ontology-explainer:firedUnit ?fired_unit . }
    OPTIONAL { $this talismans-south-park-ontology-explainer:orderKey ?order_key . }
    OPTIONAL { $this talismans-south-park-ontology-explainer:targetFirstFiredOrderKey ?target_first_fired_order_key . }
    OPTIONAL { $this talismans-south-park-ontology-explainer:targetIsConclusion ?target_is_conclusion . }
                BIND((COALESCE((COALESCE(?fired_unit, 0) = 1), false) && COALESCE(?target_is_conclusion, false) && COALESCE((COALESCE(?order_key, 0) = COALESCE(?target_first_fired_order_key, 0)), false)) AS ?_result)
            }
        """ ;
