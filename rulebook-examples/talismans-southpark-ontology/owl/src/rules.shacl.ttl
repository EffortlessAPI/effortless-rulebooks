            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:isConsistent ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Graphs .
    OPTIONAL { $this talismans-south-park-ontology-explainer:countOfViolations ?count_of_violations . }
                BIND((COALESCE(?count_of_violations, 0) = 0) AS ?_result)
            }
