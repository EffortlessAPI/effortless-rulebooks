talismans-south-park-ontology-explainer-shapes:DisjointChecks_ViolationUnit a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:DisjointChecks ;
    sh:order 17 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DisjointChecks_ViolationUnit" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:violationUnit ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:DisjointChecks .
    OPTIONAL { $this talismans-south-park-ontology-explainer:firstHolds ?first_holds . }
    OPTIONAL { $this talismans-south-park-ontology-explainer:ruleEnabled ?rule_enabled . }
    OPTIONAL { $this talismans-south-park-ontology-explainer:secondHolds ?second_holds . }
                BIND(ROUND(IF(COALESCE((COALESCE(?rule_enabled, false) && COALESCE(?first_holds, false) && COALESCE(?second_holds, false)), false), 1, 0)) AS ?_result)
            }
        """ ;
    ] .
talismans-south-park-ontology-explainer-shapes:DisjointChecks_AlarmText a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:DisjointChecks ;
    sh:order 18 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DisjointChecks_AlarmText" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:alarmText ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:DisjointChecks .
    OPTIONAL { $this talismans-south-park-ontology-explainer:objectLabel ?object_label . OPTIONAL { ?object_label erb:key ?object_label__key . } }
    OPTIONAL { $this talismans-south-park-ontology-explainer:subjectLabel ?subject_label . OPTIONAL { ?subject_label erb:key ?subject_label__key . } }
    OPTIONAL { $this talismans-south-park-ontology-explainer:violationUnit ?violation_unit . }
                BIND(IF(COALESCE((COALESCE(?violation_unit, 0) = 1), false), CONCAT("Contradiction found. ", COALESCE(COALESCE(?subject_label__key, IF(isIRI(?subject_label), REPLACE(STR(?subject_label), "^.*[#/]", ""), STR(?subject_label))), ""), " is recorded as both parent and spouse of ", COALESCE(COALESCE(?object_label__key, IF(isIRI(?object_label), REPLACE(STR(?object_label), "^.*[#/]", ""), STR(?object_label))), ""), ". Check those facts and the selected disjoint rule."), "") AS ?_result)
            }
        """ ;
    ] .
talismans-south-park-ontology-explainer-shapes:DisjointChecks_Name a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:DisjointChecks ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DisjointChecks_Name" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:name ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:DisjointChecks .
    OPTIONAL { $this talismans-south-park-ontology-explainer:disjointCheckId ?disjoint_check_id . }
                BIND(?disjoint_check_id AS ?_result)
            }
        """ ;
    ] .

