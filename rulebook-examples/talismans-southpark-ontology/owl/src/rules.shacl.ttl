    OPTIONAL { $this talismans-south-park-ontology-explainer:isListed ?is_listed . }
                BIND(ROUND(IF(COALESCE((COALESCE(?is_listed, false) && COALESCE((!(COALESCE(?is_in_effect, false))), false)), false), 1, 0)) AS ?_result)
