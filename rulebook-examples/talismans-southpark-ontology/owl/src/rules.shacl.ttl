# === Rules for LayoutSlots ===
talismans-south-park-ontology-explainer-shapes:LayoutSlots_Name a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:LayoutSlots ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_LayoutSlots_Name" ;
        sh:construct """
