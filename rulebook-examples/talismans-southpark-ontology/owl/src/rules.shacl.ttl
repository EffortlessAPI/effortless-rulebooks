                    ?child a talismans-south-park-ontology-explainer:Statements .
                    ?child talismans-south-park-ontology-explainer:graph $this .
                    OPTIONAL { ?child talismans-south-park-ontology-explainer:conclusionUnit ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY $this ?child
