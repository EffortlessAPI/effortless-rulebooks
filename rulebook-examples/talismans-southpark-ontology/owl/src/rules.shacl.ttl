            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Statements .
    OPTIONAL { $this talismans-south-park-ontology-explainer:property ?property . OPTIONAL { ?property erb:key ?property__key . } }
    OPTIONAL { $this talismans-south-park-ontology-explainer:subject ?subject . OPTIONAL { ?subject erb:key ?subject__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?subject__key, IF(isIRI(?subject), REPLACE(STR(?subject), "^.*[#/]", ""), STR(?subject))), ""), "|", COALESCE(COALESCE(?property__key, IF(isIRI(?property), REPLACE(STR(?property), "^.*[#/]", ""), STR(?property))), "")) AS ?_result)
            }
        """ ;
    ] .
talismans-south-park-ontology-explainer-shapes:Statements_LatestSiblingActivationSeq a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:Statements ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_LatestSiblingActivationSeq" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            PREFIX erb: <https://effortlessapi.com/ns/erb#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:latestSiblingActivationSeq ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Statements .
                OPTIONAL {
                    SELECT $this (MAX(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a talismans-south-park-ontology-explainer:Statements .
                    ?child a talismans-south-park-ontology-explainer:Statements .
                    ?child talismans-south-park-ontology-explainer:subjectPropertyKey ?backfk . OPTIONAL { ?backfk erb:key ?backfk__key . }
                    $this talismans-south-park-ontology-explainer:subjectPropertyKey ?backpv . OPTIONAL { ?backpv erb:key ?backpv__key . }
                    OPTIONAL { ?child talismans-south-park-ontology-explainer:activationSeq ?sumraw . }
                    BIND(xsd:double(STR(?sumraw)) AS ?sumval)
                    FILTER(COALESCE(?backfk__key, STR(?backfk)) = COALESCE(?backpv__key, STR(?backpv)))
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(?_agg1 AS ?_result)
            }
        """ ;
    ] .
talismans-south-park-ontology-explainer-shapes:Statements_IsInEffect a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:Statements ;
    sh:order 3 ;
