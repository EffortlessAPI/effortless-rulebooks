talismans-south-park-ontology-explainer-shapes:Rules_CountOfFirings a sh:NodeShape ;
    sh:targetClass talismans-south-park-ontology-explainer:Rules ;
    sh:order 15 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Rules_CountOfFirings" ;
        sh:construct """
            PREFIX talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this talismans-south-park-ontology-explainer:countOfFirings ?_result .
            }
            WHERE {
    $this a talismans-south-park-ontology-explainer:Rules .
                OPTIONAL {
                    SELECT $this (SUM(?cval) AS ?_agg1) WHERE {
                        SELECT $this ?child (MAX(?sumval) AS ?cval) WHERE {
                        $this a talismans-south-park-ontology-explainer:Rules .
                    ?child a talismans-south-park-ontology-explainer:Firings .
                    ?child talismans-south-park-ontology-explainer:rule $this .
                    OPTIONAL { ?child talismans-south-park-ontology-explainer:firedUnit ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY $this ?child
                    } GROUP BY $this
                }
                BIND(COALESCE(?_agg1, 0) AS ?_result)
            }
        """ ;
    ] .

