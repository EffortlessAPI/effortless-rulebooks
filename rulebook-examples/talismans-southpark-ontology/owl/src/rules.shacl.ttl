                BIND(CONCAT(COALESCE(COALESCE(?subject_label__key, IF(isIRI(?subject_label), REPLACE(STR(?subject_label), "^.*[#/]", ""), STR(?subject_label))), ""), " ", COALESCE(COALESCE(?property_label__key, IF(isIRI(?property_label), REPLACE(STR(?property_label), "^.*[#/]", ""), STR(?property_label))), ""), " ", COALESCE(IF(isIRI(IF(COALESCE((COALESCE(?object_thing__key, COALESCE(IF(isIRI(?object_thing), REPLACE(STR(?object_thing), "^.*[#/]", ""), STR(?object_thing)), "")) = ""), false), CONCAT(COALESCE(COALESCE(?literal_quote__key, IF(isIRI(?literal_quote), REPLACE(STR(?literal_quote), "^.*[#/]", ""), STR(?literal_quote))), ""), COALESCE(COALESCE(?object_value__key, IF(isIRI(?object_value), REPLACE(STR(?object_value), "^.*[#/]", ""), STR(?object_value))), ""), COALESCE(COALESCE(?literal_quote__key, IF(isIRI(?literal_quote), REPLACE(STR(?literal_quote), "^.*[#/]", ""), STR(?literal_quote))), ""), COALESCE(COALESCE(?literal_type_marker__key, IF(isIRI(?literal_type_marker), REPLACE(STR(?literal_type_marker), "^.*[#/]", ""), STR(?literal_type_marker))), ""), COALESCE(COALESCE(?property_datatype__key, IF(isIRI(?property_datatype), REPLACE(STR(?property_datatype), "^.*[#/]", ""), STR(?property_datatype))), "")), ?object_label)), REPLACE(STR(IF(COALESCE((COALESCE(?object_thing__key, COALESCE(IF(isIRI(?object_thing), REPLACE(STR(?object_thing), "^.*[#/]", ""), STR(?object_thing)), "")) = ""), false), CONCAT(COALESCE(COALESCE(?literal_quote__key, IF(isIRI(?literal_quote), REPLACE(STR(?literal_quote), "^.*[#/]", ""), STR(?literal_quote))), ""), COALESCE(COALESCE(?object_value__key, IF(isIRI(?object_value), REPLACE(STR(?object_value), "^.*[#/]", ""), STR(?object_value))), ""), COALESCE(COALESCE(?literal_quote__key, IF(isIRI(?literal_quote), REPLACE(STR(?literal_quote), "^.*[#/]", ""), STR(?literal_quote))), ""), COALESCE(COALESCE(?literal_type_marker__key, IF(isIRI(?literal_type_marker), REPLACE(STR(?literal_type_marker), "^.*[#/]", ""), STR(?literal_type_marker))), ""), 