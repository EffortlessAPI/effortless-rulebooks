    talismans-south-park-ontology-explainer:pageTextId "add-button" ;
    talismans-south-park-ontology-explainer:text "Add fact" .

talismans-south-park-ontology-explainer:grade-input-note a talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "grade-input-note" ;
    talismans-south-park-ontology-explainer:pageTextId "grade-input-note" ;
    talismans-south-park-ontology-explainer:text "For has grade level, enter an integer (a number with no fractional part), such as 4 or 5. This form checks integer input as an application check. For has role, enter text such as Student. A new grade or role replaces that person’s previous active value in this page’s current record. Uncheck a role fact to clear it." .

talismans-south-park-ontology-explainer:integer-error a talismans-south-park-ontology-explainer:PageTexts ;
