    erb:key "stan-grade-five" ;
    talismans-south-park-ontology-explainer:scenarioId "stan-grade-five" ;
    talismans-south-park-ontology-explainer:graph talismans-south-park-ontology-explainer:south-park ;
    talismans-south-park-ontology-explainer:label "Move Stan to grade 5" ;
    talismans-south-park-ontology-explainer:note "This imagined change updates Stan’s grade to 5. His identifier, Person statement and family links stay the same. His other selected details are unchanged." ;
    talismans-south-park-ontology-explainer:sortOrder 1 ;
    talismans-south-park-ontology-explainer:buttonGroup "stan" ;
    talismans-south-park-ontology-explainer:isPrimary false ;
    talismans-south-park-ontology-explainer:factBaseline "keep" ;
    talismans-south-park-ontology-explainer:clearsSelection true ;
    talismans-south-park-ontology-explainer:clearsFormMessage true .

