@prefix talismans-south-park-ontology-explainer: <https://example.org/talismans-south-park-ontology-explainer#> .
@prefix erb: <https://effortlessapi.com/ns/erb#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://example.org/talismans-south-park-ontology-explainer> a owl:Ontology ;
    rdfs:label "Talisman's South Park ontology explainer" ;
    dcterms:title "Talisman's South Park ontology explainer" ;
    dcterms:description "Jessica Talisman's South Park Ontology Explainer, as a rulebook: the page's ten facts, five rule switches, property wiring, provenance wording and current-value policy are rows, and every conclusion is a formula. The rules apply in three fixed strata (inverse and symmetric, then the property chain, then domain and range); property wiring that feeds an earlier stratum would need repeated rounds." ;
    rdfs:comment "Generated by Effortless (rulebook-to-owl) from talismans-south-park-ontology-explainer-rulebook.json. The rulebook is the source: change it there, not here." ;
    rdfs:comment "This namespace is a placeholder derived from the rulebook's name. To publish under your own, add a row to the rulebook's __meta__ table: MetaKey ontology_iri, StringValue your IRI." ;
    rdfs:comment "ERB build parameters: erbBlankLogic=coerce, erbDateDiff=calendar, erbDateTimeText=iso8601, erbTimezone=UTC, erbWholeNumber=by-field-type" .

dcterms:description a owl:AnnotationProperty .
dcterms:title a owl:AnnotationProperty .

# The key of the row an individual was made from, verbatim (its IRI is only a slug of it).
erb:key a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "key" .

# === Class: DisjointChecks ===
talismans-south-park-ontology-explainer:DisjointChecks a owl:Class ;
    rdfs:label "DisjointChecks" ;
    rdfs:comment "Every pair the disjointness rule watches: the same two people linked by two disjoint properties." .

# === Class: FiringKinds ===
talismans-south-park-ontology-explainer:FiringKinds a owl:Class ;
    rdfs:label "FiringKinds" ;
    rdfs:comment "The ways a rule can apply. Domain and range belong to one rule but are worded apart." .

# === Class: Firings ===
talismans-south-park-ontology-explainer:Firings a owl:Class ;
    rdfs:label "Firings" ;
    rdfs:comment "Every way an enabled rule could conclude a candidate fact from the facts that hold." .

# === Class: Graphs ===
talismans-south-park-ontology-explainer:Graphs a owl:Class ;
    rdfs:label "Graphs" ;
    rdfs:comment "The explainer page as one graph: its wording variables and its totals." .

# === Class: Properties ===
talismans-south-park-ontology-explainer:Properties a owl:Class ;
    rdfs:label "Properties" ;
    rdfs:comment "The ten properties and the wiring every rule reads." .

# === Class: Rules ===
talismans-south-park-ontology-explainer:Rules a owl:Class ;
    rdfs:label "Rules" ;
    rdfs:comment "The five rule switches on the page." .

# === Class: Statements ===
talismans-south-park-ontology-explainer:Statements a owl:Class ;
    rdfs:label "Statements" ;
    rdfs:comment "Every fact the page can state or conclude about the cast. A listed fact appears in the page's fact list; the rest are candidates that only a rule can make hold." .

# === Class: Things ===
talismans-south-park-ontology-explainer:Things a owl:Class ;
    rdfs:label "Things" ;
    rdfs:comment "Every individual and class the page can draw." .

talismans-south-park-ontology-explainer:activationSeq a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "ActivationSeq" ;
    rdfs:comment "When the fact was last switched on, as a running number; decides which value is current." .

talismans-south-park-ontology-explainer:alarmText a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:DisjointChecks ;
    rdfs:range xsd:string ;
    rdfs:label "AlarmText" ;
    rdfs:comment "Order 18. The page's contradiction alert, blank when there is none." .

talismans-south-park-ontology-explainer:builtInSourceText a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "BuiltInSourceText" .

talismans-south-park-ontology-explainer:cardText a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "CardText" ;
    rdfs:comment "Order 19. The conclusion card's provenance line, in the page's wording." .

talismans-south-park-ontology-explainer:chainFiredUnit a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "ChainFiredUnit" ;
    rdfs:comment "Order 9. 1 when the property chain fires here." .

talismans-south-park-ontology-explainer:chainFirst a owl:ObjectProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range talismans-south-park-ontology-explainer:Properties ;
    rdfs:label "ChainFirst" ;
    rdfs:comment "First link of the property chain that derives this property." .

talismans-south-park-ontology-explainer:chainSecond a owl:ObjectProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range talismans-south-park-ontology-explainer:Properties ;
    rdfs:label "ChainSecond" ;
    rdfs:comment "Second link of the property chain that derives this property." .

talismans-south-park-ontology-explainer:chosenUnit a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "ChosenUnit" ;
    rdfs:comment "Order 19. 1 when this application is shown." .

talismans-south-park-ontology-explainer:conclusionUnit a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "ConclusionUnit" ;
    rdfs:comment "Order 17. 1 when the fact is a conclusion." .

talismans-south-park-ontology-explainer:conclusionsMessage a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Graphs ;
    rdfs:range xsd:string ;
    rdfs:label "ConclusionsMessage" ;
    rdfs:comment "Order 19. The empty-state message for the conclusions panel, blank when there are conclusions." .

talismans-south-park-ontology-explainer:countAsObject a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Things ;
    rdfs:range xsd:integer ;
    rdfs:label "CountAsObject" ;
    rdfs:comment "Order 17. Holding facts that point at this thing." .

talismans-south-park-ontology-explainer:countAsPlace a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Things ;
    rdfs:range xsd:integer ;
    rdfs:label "CountAsPlace" ;
    rdfs:comment "Order 17. Holding attends facts whose object is this thing." .

talismans-south-park-ontology-explainer:countAsSubject a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Things ;
    rdfs:range xsd:integer ;
    rdfs:label "CountAsSubject" ;
    rdfs:comment "Order 17. Holding facts about this thing." .

talismans-south-park-ontology-explainer:countOfChainFirings a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfChainFirings" ;
    rdfs:comment "Order 10. Property chain applications that conclude this fact." .

talismans-south-park-ontology-explainer:countOfChildren a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Things ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfChildren" ;
    rdfs:comment "Order 17. People this thing is a parent of, stated or concluded." .

talismans-south-park-ontology-explainer:countOfChosenFirings a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfChosenFirings" ;
    rdfs:comment "Order 20. Rule applications shown as this fact's conclusion card: one for a conclusion, zero otherwise." .

talismans-south-park-ontology-explainer:countOfConclusions a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Graphs ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfConclusions" ;
    rdfs:comment "Order 18. Facts that hold only because an enabled rule concluded them." .

talismans-south-park-ontology-explainer:countOfFactsToAdd a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Graphs ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfFactsToAdd" ;
    rdfs:comment "Order 5. Listed facts that are not in effect; the Add next fact button is enabled while this is above zero." .

talismans-south-park-ontology-explainer:countOfFirings a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Rules ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfFirings" ;
    rdfs:comment "Order 15. Rule applications that fired, counting every derivation." .

talismans-south-park-ontology-explainer:countOfGrandchildren a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Things ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfGrandchildren" ;
    rdfs:comment "Order 17. People this thing is a grandparent of." .

talismans-south-park-ontology-explainer:countOfInverseFirings a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfInverseFirings" ;
    rdfs:comment "Order 6. Inverse rule applications that conclude this fact." .

talismans-south-park-ontology-explainer:countOfStatedFacts a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Graphs ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfStatedFacts" ;
    rdfs:comment "Order 5. Facts that are switched on and in effect." .

talismans-south-park-ontology-explainer:countOfSymmetricFirings a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfSymmetricFirings" ;
    rdfs:comment "Order 6. Symmetric rule applications that conclude this fact." .

talismans-south-park-ontology-explainer:countOfTypeFirings a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfTypeFirings" ;
    rdfs:comment "Order 14. Domain and range applications that conclude this fact." .

talismans-south-park-ontology-explainer:countOfViolations a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Graphs ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfViolations" ;
    rdfs:comment "Order 18. Disjointness checks that found both links between the same pair." .

talismans-south-park-ontology-explainer:datatype a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range xsd:string ;
    rdfs:label "Datatype" ;
    rdfs:comment "The value's XML Schema datatype for a datatype property; blank otherwise." .

talismans-south-park-ontology-explainer:disjointCheckId a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:DisjointChecks ;
    rdfs:range xsd:string ;
    rdfs:label "DisjointCheckId" ;
    rdfs:comment "Key: first fact~second property." .

talismans-south-park-ontology-explainer:disjointWith a owl:ObjectProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range talismans-south-park-ontology-explainer:Properties ;
    rdfs:label "DisjointWith" ;
    rdfs:comment "A property that may not link the same pair, in the same direction, as this one." .

talismans-south-park-ontology-explainer:domainClass a owl:ObjectProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range talismans-south-park-ontology-explainer:Things ;
    rdfs:label "DomainClass" ;
    rdfs:comment "The class the domain rule gives this property's subject." .

talismans-south-park-ontology-explainer:explanation a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Rules ;
    rdfs:range xsd:string ;
    rdfs:label "Explanation" ;
    rdfs:comment "The rule's one-line explanation on the page." .

talismans-south-park-ontology-explainer:firedUnit a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "FiredUnit" ;
    rdfs:comment "Order 14. 1 when this application fires." .

talismans-south-park-ontology-explainer:firingId a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "FiringId" ;
    rdfs:comment "Key: kind:premise(+premise)>conclusion." .

talismans-south-park-ontology-explainer:firingKindId a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:FiringKinds ;
    rdfs:range xsd:string ;
    rdfs:label "FiringKindId" ;
    rdfs:comment "Key of the kind." .

talismans-south-park-ontology-explainer:first a owl:ObjectProperty ;
    rdfs:range talismans-south-park-ontology-explainer:Statements ;
    rdfs:label "First" .

talismans-south-park-ontology-explainer:firstFiredOrderKey a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "FirstFiredOrderKey" ;
    rdfs:comment "Order 15. Order key of the first rule application that concludes this fact, in the page reasoner's order." .

talismans-south-park-ontology-explainer:firstHolds a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:DisjointChecks ;
    rdfs:range xsd:boolean ;
    rdfs:label "FirstHolds" ;
    rdfs:comment "Order 16. Whether the first link holds." .

talismans-south-park-ontology-explainer:firstHoldsBeforeChain a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:boolean ;
    rdfs:label "FirstHoldsBeforeChain" ;
    rdfs:comment "Order 8. Whether the premise holds before the chain." .

talismans-south-park-ontology-explainer:firstHoldsBeforeTyping a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:boolean ;
    rdfs:label "FirstHoldsBeforeTyping" ;
    rdfs:comment "Order 12. Whether the premise holds before typing." .

talismans-south-park-ontology-explainer:firstIsInEffect a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:boolean ;
    rdfs:label "FirstIsInEffect" ;
    rdfs:comment "Order 4. Whether the premise is in effect." .

talismans-south-park-ontology-explainer:firstProperty a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "FirstProperty" ;
    rdfs:comment "Order 1. The premise's property key, as the card's axiom names it." .

talismans-south-park-ontology-explainer:firstPropertyDomainClass a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "FirstPropertyDomainClass" ;
    rdfs:comment "Order 2. The premise property's domain class." .

talismans-south-park-ontology-explainer:firstPropertyRangeClass a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "FirstPropertyRangeClass" ;
    rdfs:comment "Order 2. The premise property's range class." .

talismans-south-park-ontology-explainer:firstSortOrder a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "FirstSortOrder" ;
    rdfs:comment "Order 1. The premise's list position." .

talismans-south-park-ontology-explainer:firstWords a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "FirstWords" ;
    rdfs:comment "Order 3. The premise as the card quotes it." .

talismans-south-park-ontology-explainer:grandparentUnit a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "GrandparentUnit" ;
    rdfs:comment "Order 16. 1 for a holding grandparent link." .

talismans-south-park-ontology-explainer:graph a owl:ObjectProperty ;
    rdfs:range talismans-south-park-ontology-explainer:Graphs ;
    rdfs:label "Graph" .

talismans-south-park-ontology-explainer:graphId a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Graphs ;
    rdfs:range xsd:string ;
    rdfs:label "GraphId" ;
    rdfs:comment "Key of the graph." .

talismans-south-park-ontology-explainer:hasFactsToAdd a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Graphs ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasFactsToAdd" ;
    rdfs:comment "Order 6. True while some listed fact can still be added." .

talismans-south-park-ontology-explainer:hasOneCurrentValue a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range xsd:boolean ;
    rdfs:label "HasOneCurrentValue" ;
    rdfs:comment "The page keeps one current value per person: switching a value on replaces the earlier one." .

talismans-south-park-ontology-explainer:holds a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "Holds" ;
    rdfs:comment "Order 15. True when in effect or concluded by an enabled rule; the graph draws it." .

talismans-south-park-ontology-explainer:holdsBeforeChain a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "HoldsBeforeChain" ;
    rdfs:comment "Order 7. Holds from facts in effect plus the inverse and symmetric rules." .

talismans-south-park-ontology-explainer:holdsBeforeTyping a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "HoldsBeforeTyping" ;
    rdfs:comment "Order 11. Holds before the domain and range rules apply." .

talismans-south-park-ontology-explainer:holdsUnit a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "HoldsUnit" ;
    rdfs:comment "Order 16. 1 when the fact holds." .

talismans-south-park-ontology-explainer:inEffectUnit a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "InEffectUnit" ;
    rdfs:comment "Order 4. 1 when the fact is in effect." .

talismans-south-park-ontology-explainer:inverseFiredUnit a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "InverseFiredUnit" ;
    rdfs:comment "Order 5. 1 when the inverse rule fires here." .

talismans-south-park-ontology-explainer:inverseOf a owl:ObjectProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range talismans-south-park-ontology-explainer:Properties ;
    rdfs:label "InverseOf" ;
    rdfs:comment "The property the inverse rule derives from this one." .

talismans-south-park-ontology-explainer:isBuiltIn a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBuiltIn" ;
    rdfs:comment "One of the page's teaching facts; the reader cannot remove it." .

talismans-south-park-ontology-explainer:isChosen a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsChosen" ;
    rdfs:comment "Order 18. The application the conclusions panel shows for its fact: the first one in the reasoner's order." .

talismans-south-park-ontology-explainer:isConclusion a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConclusion" ;
    rdfs:comment "Order 16. Holds only because a rule concluded it. Drawn dashed." .

talismans-south-park-ontology-explainer:isConsistent a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Graphs ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConsistent" ;
    rdfs:comment "Order 19. True when no enabled disjointness rule is violated." .

talismans-south-park-ontology-explainer:isDetail a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsDetail" ;
    rdfs:comment "One of Stan's detail facts that Show Stan's details switches on." .

talismans-south-park-ontology-explainer:isEnabled a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Rules ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEnabled" ;
    rdfs:comment "The rule's checkbox." .

talismans-south-park-ontology-explainer:isInEffect a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInEffect" ;
    rdfs:comment "Order 3. Switched on and, for a one-value property, the most recently switched-on value. Drawn as a solid line." .

talismans-south-park-ontology-explainer:isInGraph a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Things ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsInGraph" ;
    rdfs:comment "Order 18. True when the graph draws this thing." .

talismans-south-park-ontology-explainer:isListed a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsListed" ;
    rdfs:comment "Shown in the page's fact list." .

talismans-south-park-ontology-explainer:isLiteral a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsLiteral" ;
    rdfs:comment "Order 1. True when the object is a value rather than a thing." .

talismans-south-park-ontology-explainer:isNextToAdd a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsNextToAdd" ;
    rdfs:comment "Order 7. The fact the Add next fact button switches on." .

talismans-south-park-ontology-explainer:isStated a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStated" ;
    rdfs:comment "The fact's checkbox." .

talismans-south-park-ontology-explainer:isSymmetric a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSymmetric" ;
    rdfs:comment "The symmetric rule makes this link true in both directions." .

talismans-south-park-ontology-explainer:isUserAddable a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsUserAddable" ;
    rdfs:comment "Offered in the page's Add fact form." .

talismans-south-park-ontology-explainer:kind a owl:ObjectProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range talismans-south-park-ontology-explainer:FiringKinds ;
    rdfs:label "Kind" ;
    rdfs:comment "How the rule applies." .

talismans-south-park-ontology-explainer:kindSortOrder a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:integer ;
