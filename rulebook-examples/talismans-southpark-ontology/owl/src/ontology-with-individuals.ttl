    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "SymmetricFiredUnit" ;
    rdfs:comment "Order 5. 1 when the symmetric rule fires here." .

talismans-south-park-ontology-explainer:target a owl:ObjectProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range talismans-south-park-ontology-explainer:Statements ;
    rdfs:label "Target" ;
    rdfs:comment "The fact this application concludes." .

talismans-south-park-ontology-explainer:targetFirstFiredOrderKey a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "TargetFirstFiredOrderKey" ;
    rdfs:comment "Order 16. The order key of the concluded fact's first application." .

talismans-south-park-ontology-explainer:targetIsConclusion a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:boolean ;
    rdfs:label "TargetIsConclusion" ;
    rdfs:comment "Order 17. Whether the concluded fact is new." .

talismans-south-park-ontology-explainer:targetName a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "TargetName" ;
    rdfs:comment "Order 4. The concluded fact in words." .

talismans-south-park-ontology-explainer:targetObjectNodeKey a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "TargetObjectNodeKey" ;
    rdfs:comment "Order 3. The concluded fact's object node." .

talismans-south-park-ontology-explainer:targetObjectText a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "TargetObjectText" ;
    rdfs:comment "Order 3. The concluded fact's object." .

talismans-south-park-ontology-explainer:targetPropertyLabel a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "TargetPropertyLabel" ;
    rdfs:comment "Order 2. The concluded fact's property." .

talismans-south-park-ontology-explainer:targetSubjectLabel a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "TargetSubjectLabel" ;
    rdfs:comment "Order 2. The concluded fact's subject." .

talismans-south-park-ontology-explainer:targetSubjectNodeKey a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "TargetSubjectNodeKey" ;
    rdfs:comment "Order 2. The concluded fact's subject node." .

talismans-south-park-ontology-explainer:text a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:PageTexts ;
    rdfs:range xsd:string ;
    rdfs:label "Text" ;
    rdfs:comment "The string." .

talismans-south-park-ontology-explainer:thingId a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Things ;
    rdfs:range xsd:string ;
    rdfs:label "ThingId" ;
    rdfs:comment "Key of the thing; also its local name in the model namespace." .

talismans-south-park-ontology-explainer:typeFiredUnit a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "TypeFiredUnit" ;
    rdfs:comment "Order 13. 1 when the domain or range rule fires here." .

talismans-south-park-ontology-explainer:userSourceText a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "UserSourceText" .

talismans-south-park-ontology-explainer:valueNodeLabel a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Properties ;
    rdfs:range xsd:string ;
    rdfs:label "ValueNodeLabel" ;
    rdfs:comment "The small label under a value node for this property: 'role value' or 'number value'." .

talismans-south-park-ontology-explainer:violationUnit a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:DisjointChecks ;
    rdfs:range xsd:integer ;
    rdfs:label "ViolationUnit" ;
    rdfs:comment "Order 17. 1 when both links hold." .

talismans-south-park-ontology-explainer:wording a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:FiringKinds ;
    rdfs:range xsd:string ;
    rdfs:label "Wording" ;
    rdfs:comment "How a conclusion card names the rule, as in 'Worked out by the inverse rule'." .

talismans-south-park-ontology-explainer:words a owl:DatatypeProperty ;
    rdfs:domain talismans-south-park-ontology-explainer:Statements ;
    rdfs:range xsd:string ;
    rdfs:label "Words" ;
    rdfs:comment "Order 2. The fact as a conclusion card quotes it, with a literal written in Turtle form." .

talismans-south-park-ontology-explainer:x a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "X" .

talismans-south-park-ontology-explainer:y a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "Y" .

