    erb:key "focus-source" ;
    talismans-south-park-ontology-explainer:pageTextId "focus-source" ;
    talismans-south-park-ontology-explainer:text "Source of this fact" .

talismans-south-park-ontology-explainer:fandom-link a owl:NamedIndividual , talismans-south-park-ontology-explainer:PageTexts ;
    erb:key "fandom-link" ;
