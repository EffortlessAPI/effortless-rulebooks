            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:holdsBeforeTyping ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
    OPTIONAL { $this effortless-ntwf:countOfChainFirings ?count_of_chain_firings . }
    OPTIONAL { $this effortless-ntwf:holdsBeforeChain ?holds_before_chain . }
                BIND((COALESCE(?holds_before_chain, false) || COALESCE((COALESCE(?count_of_chain_firings, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Statements_CountOfTypeFiringsShape a sh:NodeShape ;
