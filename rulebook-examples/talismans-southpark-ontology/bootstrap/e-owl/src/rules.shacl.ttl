                OPTIONAL { $this effortless-ntwf:second ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Statements ; effortless-ntwf:statementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:name ?j3 . } }
