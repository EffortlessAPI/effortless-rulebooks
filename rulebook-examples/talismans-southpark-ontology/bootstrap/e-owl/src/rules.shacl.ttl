            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:propertyLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
                OPTIONAL { $this effortless-ntwf:property ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Properties ; effortless-ntwf:propertyId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Statements_ObjectLabelShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_ObjectLabel" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:objectLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
                OPTIONAL { $this effortless-ntwf:objectThing ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Things ; effortless-ntwf:thingId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Statements_NameShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
    OPTIONAL { $this effortless-ntwf:numberValue ?number_value . }
    OPTIONAL { $this effortless-ntwf:objectLabel ?object_label . }
    OPTIONAL { $this effortless-ntwf:objectThing ?object_thing . OPTIONAL { ?object_thing effortless-ntwf:__key ?object_thing__key . } }
    OPTIONAL { $this effortless-ntwf:propertyLabel ?property_label . OPTIONAL { ?property_label effortless-ntwf:__key ?property_label__key . } }
    OPTIONAL { $this effortless-ntwf:subjectLabel ?subject_label . OPTIONAL { ?subject_label effortless-ntwf:__key ?subject_label__key . } }
                BIND(CONCAT(COALESCE(COALESCE(?subject_label__key, IF(isIRI(?subject_label), REPLACE(STR(?subject_label), "^.*[#/]", ""), STR(?subject_label))), ""), " ", COALESCE(COALESCE(?property_label__key, IF(isIRI(?property_label), REPLACE(STR(?property_label), "^.*[#/]", ""), STR(?property_label))), ""), " ", COALESCE(IF(isIRI(IF(COALESCE((COALESCE(?object_thing__key, COALESCE(IF(isIRI(?object_thing), REPLACE(STR(?object_thing), "^.*[#/]", ""), STR(?object_thing)), "")) = ""), false), ?number_value, ?object_label)), REPLACE(STR(IF(COALESCE((COALESCE(?object_thing__key, COALESCE(IF(isIRI(?object_thing), REPLACE(STR(?object_thing), "^.*[#/]", ""), STR(?object_thing)), "")) = ""), false), ?number_value, ?object_label)), "^.*[#/]", ""), STR(IF(COALESCE((COALESCE(?object_thing__key, COALESCE(IF(isIRI(?object_thing), REPLACE(STR(?object_thing), "^.*[#/]", ""), STR(?object_thing)), "")) = ""), false), ?number_value, ?object_label))), "")) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Statements_CountOfInverseFiringsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_CountOfInverseFirings" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfInverseFirings ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:Firings .
                    ?child effortless-ntwf:target $this .
                    OPTIONAL { ?child effortless-ntwf:inverseFiredUnit ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] .
effortless-ntwf:Statements_CountOfSymmetricFiringsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
