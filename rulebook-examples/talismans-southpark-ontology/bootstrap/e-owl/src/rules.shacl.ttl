            WHERE {
    $this a effortless-ntwf:Firings .
                OPTIONAL { $this effortless-ntwf:first ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Statements ; effortless-ntwf:statementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isStated ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Firings_FirstHoldsBeforeChainShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Firings ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_FirstHoldsBeforeChain" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:firstHoldsBeforeChain ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Firings .
                OPTIONAL { $this effortless-ntwf:first ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Statements ; effortless-ntwf:statementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:holdsBeforeChain ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Firings_SecondHoldsBeforeChainShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Firings ;
    sh:order 5 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_SecondHoldsBeforeChain" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:secondHoldsBeforeChain ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Firings .
                OPTIONAL { $this effortless-ntwf:second ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Statements ; effortless-ntwf:statementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:holdsBeforeChain ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Firings_FirstHoldsBeforeTypingShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Firings ;
    sh:order 9 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_FirstHoldsBeforeTyping" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:firstHoldsBeforeTyping ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Firings .
                OPTIONAL { $this effortless-ntwf:first ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Statements ; effortless-ntwf:statementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:holdsBeforeTyping ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Firings_InverseFiredUnitShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Firings ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_InverseFiredUnit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:inverseFiredUnit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Firings .
    OPTIONAL { $this effortless-ntwf:firstIsStated ?first_is_stated . }
    OPTIONAL { $this effortless-ntwf:kind ?kind . OPTIONAL { ?kind effortless-ntwf:__key ?kind__key . } }
    OPTIONAL { $this effortless-ntwf:ruleEnabled ?rule_enabled . }
                BIND(ROUND(IF(COALESCE((COALESCE(?rule_enabled, false) && COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "inverse"), false) && COALESCE(?first_is_stated, false)), false), 1, 0)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Firings_SymmetricFiredUnitShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Firings ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_SymmetricFiredUnit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:symmetricFiredUnit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Firings .
    OPTIONAL { $this effortless-ntwf:firstIsStated ?first_is_stated . }
    OPTIONAL { $this effortless-ntwf:kind ?kind . OPTIONAL { ?kind effortless-ntwf:__key ?kind__key . } }
    OPTIONAL { $this effortless-ntwf:ruleEnabled ?rule_enabled . }
                BIND(ROUND(IF(COALESCE((COALESCE(?rule_enabled, false) && COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "symmetric"), false) && COALESCE(?first_is_stated, false)), false), 1, 0)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Firings_ChainFiredUnitShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Firings ;
    sh:order 6 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_ChainFiredUnit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:chainFiredUnit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Firings .
    OPTIONAL { $this effortless-ntwf:firstHoldsBeforeChain ?first_holds_before_chain . }
    OPTIONAL { $this effortless-ntwf:kind ?kind . OPTIONAL { ?kind effortless-ntwf:__key ?kind__key . } }
    OPTIONAL { $this effortless-ntwf:ruleEnabled ?rule_enabled . }
    OPTIONAL { $this effortless-ntwf:secondHoldsBeforeChain ?second_holds_before_chain . }
                BIND(ROUND(IF(COALESCE((COALESCE(?rule_enabled, false) && COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "chain"), false) && COALESCE(?first_holds_before_chain, false) && COALESCE(?second_holds_before_chain, false)), false), 1, 0)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Firings_TypeFiredUnitShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Firings ;
    sh:order 10 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_TypeFiredUnit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:typeFiredUnit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Firings .
    OPTIONAL { $this effortless-ntwf:firstHoldsBeforeTyping ?first_holds_before_typing . }
    OPTIONAL { $this effortless-ntwf:kind ?kind . OPTIONAL { ?kind effortless-ntwf:__key ?kind__key . } }
    OPTIONAL { $this effortless-ntwf:ruleEnabled ?rule_enabled . }
                BIND(ROUND(IF(COALESCE((COALESCE(?rule_enabled, false) && COALESCE((COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "domain"), false) || COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "range"), false)), false) && COALESCE(?first_holds_before_typing, false)), false), 1, 0)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Firings_FiredUnitShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Firings ;
    sh:order 11 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_FiredUnit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:firedUnit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Firings .
    OPTIONAL { $this effortless-ntwf:chainFiredUnit ?chain_fired_unit . }
    OPTIONAL { $this effortless-ntwf:inverseFiredUnit ?inverse_fired_unit . }
    OPTIONAL { $this effortless-ntwf:symmetricFiredUnit ?symmetric_fired_unit . }
    OPTIONAL { $this effortless-ntwf:typeFiredUnit ?type_fired_unit . }
                BIND(ROUND((((?inverse_fired_unit + ?symmetric_fired_unit) + ?chain_fired_unit) + ?type_fired_unit)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Firings_NameShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Firings ;
    sh:order 12 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Firings .
    OPTIONAL { $this effortless-ntwf:firedUnit ?fired_unit . }
    OPTIONAL { $this effortless-ntwf:firingId ?firing_id . }
    OPTIONAL { $this effortless-ntwf:firstName ?first_name . OPTIONAL { ?first_name effortless-ntwf:__key ?first_name__key . } }
    OPTIONAL { $this effortless-ntwf:kind ?kind . OPTIONAL { ?kind effortless-ntwf:__key ?kind__key . } }
    OPTIONAL { $this effortless-ntwf:ruleLabel ?rule_label . OPTIONAL { ?rule_label effortless-ntwf:__key ?rule_label__key . } }
    OPTIONAL { $this effortless-ntwf:secondName ?second_name . OPTIONAL { ?second_name effortless-ntwf:__key ?second_name__key . } }
    OPTIONAL { $this effortless-ntwf:targetName ?target_name . OPTIONAL { ?target_name effortless-ntwf:__key ?target_name__key . } }
                BIND(IF(COALESCE((COALESCE(?fired_unit, 0) > 0), false), CONCAT(COALESCE(COALESCE(?target_name__key, IF(isIRI(?target_name), REPLACE(STR(?target_name), "^.*[#/]", ""), STR(?target_name))), ""), ": concluded by the ", COALESCE(COALESCE(?rule_label__key, IF(isIRI(?rule_label), REPLACE(STR(?rule_label), "^.*[#/]", ""), STR(?rule_label))), ""), " rule from \'", COALESCE(COALESCE(?first_name__key, IF(isIRI(?first_name), REPLACE(STR(?first_name), "^.*[#/]", ""), STR(?first_name))), ""), "\'", COALESCE(IF(isIRI(IF(COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "chain"), false), CONCAT(" and \'", COALESCE(COALESCE(?second_name__key, IF(isIRI(?second_name), REPLACE(STR(?second_name), "^.*[#/]", ""), STR(?second_name))), ""), "\'"), "")), REPLACE(STR(IF(COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "chain"), false), CONCAT(" and \'", COALESCE(COALESCE(?second_name__key, IF(isIRI(?second_name), REPLACE(STR(?second_name), "^.*[#/]", ""), STR(?second_name))), ""), "\'"), "")), "^.*[#/]", ""), STR(IF(COALESCE((COALESCE(?kind__key, COALESCE(IF(isIRI(?kind), REPLACE(STR(?kind), "^.*[#/]", ""), STR(?kind)), "")) = "chain"), false), CONCAT(" and \'", COALESCE(COALESCE(?second_name__key, IF(isIRI(?second_name), REPLACE(STR(?second_name), "^.*[#/]", ""), STR(?second_name))), ""), "\'"), ""))), "")), ?firing_id) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Graphs ===
effortless-ntwf:Graphs_NameShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Graphs ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Graphs_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Graphs .
    OPTIONAL { $this effortless-ntwf:graphId ?graph_id . }
                BIND(?graph_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Graphs_CountOfStatedFactsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Graphs ;
    sh:order 2 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Graphs_CountOfStatedFacts" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfStatedFacts ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Graphs .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:Statements .
                    ?child effortless-ntwf:graph $this .
                    OPTIONAL { ?child effortless-ntwf:statedUnit ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] .
effortless-ntwf:Graphs_CountOfConclusionsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Graphs ;
    sh:order 15 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Graphs_CountOfConclusions" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfConclusions ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Graphs .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:Statements .
                    ?child effortless-ntwf:graph $this .
                    OPTIONAL { ?child effortless-ntwf:conclusionUnit ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] .
effortless-ntwf:Graphs_CountOfViolationsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Graphs ;
    sh:order 15 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Graphs_CountOfViolations" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfViolations ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Graphs .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:DisjointChecks .
                    ?child effortless-ntwf:graph $this .
                    OPTIONAL { ?child effortless-ntwf:violationUnit ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] .
effortless-ntwf:Graphs_IsConsistentShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Graphs ;
    sh:order 16 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Graphs_IsConsistent" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isConsistent ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Graphs .
    OPTIONAL { $this effortless-ntwf:countOfViolations ?count_of_violations . }
                BIND((COALESCE(?count_of_violations, 0) = 0) AS ?_result)
            }
        """ ;
    ] .

