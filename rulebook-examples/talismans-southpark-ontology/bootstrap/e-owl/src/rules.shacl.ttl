            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ruleLabel ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Firings .
                OPTIONAL { $this effortless-ntwf:rule ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Rules ; effortless-ntwf:ruleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:label ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Firings_TargetNameShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Firings ;
    sh:order 3 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_TargetName" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:targetName ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Firings .
                OPTIONAL { $this effortless-ntwf:target ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Statements ; effortless-ntwf:statementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:name ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
