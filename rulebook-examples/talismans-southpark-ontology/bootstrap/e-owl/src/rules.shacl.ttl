effortless-ntwf:Statements_HoldsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 12 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_Holds" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:holds ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
    OPTIONAL { $this effortless-ntwf:countOfTypeFirings ?count_of_type_firings . }
    OPTIONAL { $this effortless-ntwf:holdsBeforeTyping ?holds_before_typing . }
                BIND((COALESCE(?holds_before_typing, false) || COALESCE((COALESCE(?count_of_type_firings, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Statements_IsConclusionShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 13 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_IsConclusion" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:isConclusion ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
    OPTIONAL { $this effortless-ntwf:holds ?holds . }
    OPTIONAL { $this effortless-ntwf:isStated ?is_stated . }
                BIND((COALESCE(?holds, false) && COALESCE((!(COALESCE(?is_stated, false))), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Statements_WorkedOutByShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 14 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_WorkedOutBy" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:workedOutBy ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
    OPTIONAL { $this effortless-ntwf:countOfChainFirings ?count_of_chain_firings . }
    OPTIONAL { $this effortless-ntwf:countOfInverseFirings ?count_of_inverse_firings . }
    OPTIONAL { $this effortless-ntwf:countOfSymmetricFirings ?count_of_symmetric_firings . }
    OPTIONAL { $this effortless-ntwf:isConclusion ?is_conclusion . }
                BIND(IF(COALESCE((!(COALESCE(?is_conclusion, false))), false), "", IF(COALESCE((COALESCE(?count_of_inverse_firings, 0) > 0), false), "inverse", IF(COALESCE((COALESCE(?count_of_symmetric_firings, 0) > 0), false), "symmetric", IF(COALESCE((COALESCE(?count_of_chain_firings, 0) > 0), false), "property chain", "domain and range")))) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Statements_StatedUnitShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_StatedUnit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:statedUnit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
    OPTIONAL { $this effortless-ntwf:isStated ?is_stated . }
                BIND(ROUND(IF(COALESCE(?is_stated, false), 1, 0)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Statements_ConclusionUnitShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 14 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_ConclusionUnit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:conclusionUnit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
    OPTIONAL { $this effortless-ntwf:isConclusion ?is_conclusion . }
                BIND(ROUND(IF(COALESCE(?is_conclusion, false), 1, 0)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Statements_ParentUnitShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 13 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_ParentUnit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:parentUnit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
    OPTIONAL { $this effortless-ntwf:holds ?holds . }
    OPTIONAL { $this effortless-ntwf:property ?property . OPTIONAL { ?property effortless-ntwf:__key ?property__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?holds, false) && COALESCE((COALESCE(?property__key, COALESCE(IF(isIRI(?property), REPLACE(STR(?property), "^.*[#/]", ""), STR(?property)), "")) = "isParentOf"), false)), false), 1, 0)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Statements_GrandparentUnitShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 13 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_GrandparentUnit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:grandparentUnit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
    OPTIONAL { $this effortless-ntwf:holds ?holds . }
    OPTIONAL { $this effortless-ntwf:property ?property . OPTIONAL { ?property effortless-ntwf:__key ?property__key . } }
                BIND(ROUND(IF(COALESCE((COALESCE(?holds, false) && COALESCE((COALESCE(?property__key, COALESCE(IF(isIRI(?property), REPLACE(STR(?property), "^.*[#/]", ""), STR(?property)), "")) = "isGrandparentOf"), false)), false), 1, 0)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Things ===
effortless-ntwf:Things_NameShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Things ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Things_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Things .
    OPTIONAL { $this effortless-ntwf:label ?label . }
                BIND(?label AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Things_CountOfChildrenShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Things ;
    sh:order 14 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Things_CountOfChildren" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfChildren ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Things .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:Statements .
                    ?child effortless-ntwf:subject $this .
                    OPTIONAL { ?child effortless-ntwf:parentUnit ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] .
effortless-ntwf:Things_CountOfGrandchildrenShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Things ;
    sh:order 14 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Things_CountOfGrandchildren" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfGrandchildren ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Things .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:Statements .
                    ?child effortless-ntwf:subject $this .
                    OPTIONAL { ?child effortless-ntwf:grandparentUnit ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] .

# === Cardinality: single-valued forward FK properties ===
effortless-ntwf:DisjointChecksCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DisjointChecks ;
    sh:property [ sh:path effortless-ntwf:a ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:b ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:graph ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:rule ; sh:maxCount 1 ] .

effortless-ntwf:FiringsCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Firings ;
    sh:property [ sh:path effortless-ntwf:first ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:rule ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:second ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:target ; sh:maxCount 1 ] .

effortless-ntwf:PropertiesCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Properties ;
    sh:property [ sh:path effortless-ntwf:chainFirst ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:chainSecond ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:domainClass ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:rangeClass ; sh:maxCount 1 ] .

effortless-ntwf:StatementsCardinalityShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:property [ sh:path effortless-ntwf:graph ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:objectThing ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:property ; sh:maxCount 1 ] ;
    sh:property [ sh:path effortless-ntwf:subject ; sh:maxCount 1 ] .

