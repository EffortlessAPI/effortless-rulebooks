            CONSTRUCT {
                $this effortless-ntwf:countOfSymmetricFirings ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:Firings .
                    ?child effortless-ntwf:target $this .
                    OPTIONAL { ?child effortless-ntwf:symmetricFiredUnit ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] .
effortless-ntwf:Statements_HoldsBeforeChainShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 4 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_HoldsBeforeChain" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:holdsBeforeChain ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
    OPTIONAL { $this effortless-ntwf:countOfInverseFirings ?count_of_inverse_firings . }
    OPTIONAL { $this effortless-ntwf:countOfSymmetricFirings ?count_of_symmetric_firings . }
    OPTIONAL { $this effortless-ntwf:isStated ?is_stated . }
                BIND((COALESCE(?is_stated, false) || COALESCE((COALESCE(?count_of_inverse_firings, 0) > 0), false) || COALESCE((COALESCE(?count_of_symmetric_firings, 0) > 0), false)) AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:Statements_CountOfChainFiringsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 7 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_CountOfChainFirings" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:countOfChainFirings ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Statements .
                {
                    SELECT (SUM(?cval) AS ?_result) WHERE {
                        SELECT ?child (MAX(?sumval) AS ?cval) WHERE {
                    ?child a effortless-ntwf:Firings .
                    ?child effortless-ntwf:target $this .
                    OPTIONAL { ?child effortless-ntwf:chainFiredUnit ?sumraw . }
                    BIND(IF(BOUND(?sumraw), xsd:double(STR(?sumraw)), 0.0) AS ?sumval)
                        } GROUP BY ?child
                    }
                }
            }
        """ ;
    ] .
effortless-ntwf:Statements_HoldsBeforeTypingShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Statements ;
    sh:order 8 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Statements_HoldsBeforeTyping" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
