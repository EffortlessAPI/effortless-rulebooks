@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix effortless-ntwf: <https://w3id.org/effortless-ntwf#> .

# === Rules for DisjointChecks ===
effortless-ntwf:DisjointChecks_NameShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DisjointChecks ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DisjointChecks_Name" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:name ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DisjointChecks .
    OPTIONAL { $this effortless-ntwf:disjointCheckId ?disjoint_check_id . }
                BIND(?disjoint_check_id AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:DisjointChecks_RuleEnabledShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DisjointChecks ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DisjointChecks_RuleEnabled" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ruleEnabled ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DisjointChecks .
                OPTIONAL { $this effortless-ntwf:rule ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Rules ; effortless-ntwf:ruleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isEnabled ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:DisjointChecks_AHoldsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DisjointChecks ;
    sh:order 13 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DisjointChecks_AHolds" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:aHolds ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DisjointChecks .
                OPTIONAL { $this effortless-ntwf:a ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Statements ; effortless-ntwf:statementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:holds ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:DisjointChecks_BHoldsShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DisjointChecks ;
    sh:order 13 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DisjointChecks_BHolds" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:bHolds ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DisjointChecks .
                OPTIONAL { $this effortless-ntwf:b ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Statements ; effortless-ntwf:statementId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:holds ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
effortless-ntwf:DisjointChecks_ViolationUnitShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:DisjointChecks ;
    sh:order 14 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_DisjointChecks_ViolationUnit" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:violationUnit ?_result .
            }
            WHERE {
    $this a effortless-ntwf:DisjointChecks .
    OPTIONAL { $this effortless-ntwf:aHolds ?a_holds . }
    OPTIONAL { $this effortless-ntwf:bHolds ?b_holds . }
    OPTIONAL { $this effortless-ntwf:ruleEnabled ?rule_enabled . }
                BIND(ROUND(IF(COALESCE((COALESCE(?rule_enabled, false) && COALESCE(?a_holds, false) && COALESCE(?b_holds, false)), false), 1, 0)) AS ?_result)
            }
        """ ;
    ] .

# === Rules for Firings ===
effortless-ntwf:Firings_RuleEnabledShape a sh:NodeShape ;
    sh:targetClass effortless-ntwf:Firings ;
    sh:order 1 ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Firings_RuleEnabled" ;
        sh:prefixes effortless-ntwf: ;
        sh:construct """
            PREFIX effortless-ntwf: <https://w3id.org/effortless-ntwf#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            CONSTRUCT {
                $this effortless-ntwf:ruleEnabled ?_result .
            }
            WHERE {
    $this a effortless-ntwf:Firings .
                OPTIONAL { $this effortless-ntwf:rule ?j0 . }
                OPTIONAL { ?j1 a effortless-ntwf:Rules ; effortless-ntwf:ruleId ?j2 . FILTER( ?j1 = ?j0 || REPLACE(STR(?j2), "^.*[#/]", "") = REPLACE(STR(?j0), "^.*[#/]", "") ) OPTIONAL { ?j1 effortless-ntwf:isEnabled ?j3 . } }
                BIND(?j3 AS ?_result)
            }
        """ ;
    ] .
