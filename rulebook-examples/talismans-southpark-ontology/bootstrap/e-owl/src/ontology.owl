@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix effortless-ntwf: <https://w3id.org/effortless-ntwf#> .

<https://w3id.org/effortless-ntwf#> a owl:Ontology ;
    rdfs:label "NTWF Ontology (Effortless rendering)" ;
    rdfs:comment "Generated by Effortless from south-park-ontology-explainer-rulebook.json. Vocabulary: Jessica Talisman NTWF." ;
    rdfs:comment "ERB build parameters: erbBlankLogic=coerce, erbDateDiff=calendar, erbDateTimeText=iso8601, erbTimezone=UTC, erbWholeNumber=by-field-type" .

# === Class: DisjointChecks ===
effortless-ntwf:DisjointChecks a owl:Class ;
    rdfs:label "DisjointChecks" ;
    rdfs:comment "Two statements that must not both hold." .

effortless-ntwf:disjointCheckId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DisjointChecks ;
    rdfs:range xsd:string ;
    rdfs:label "DisjointCheckId" .

effortless-ntwf:graph a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Graphs ;
    rdfs:label "Graph" .

effortless-ntwf:rule a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Rules ;
    rdfs:label "Rule" .

effortless-ntwf:a a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:DisjointChecks ;
    rdfs:range effortless-ntwf:Statements ;
    rdfs:label "A" .

effortless-ntwf:b a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:DisjointChecks ;
    rdfs:range effortless-ntwf:Statements ;
    rdfs:label "B" .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" .
    # calculated: calculated

effortless-ntwf:ruleEnabled a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "RuleEnabled" .
    # calculated: lookup

effortless-ntwf:aHolds a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DisjointChecks ;
    rdfs:range xsd:boolean ;
    rdfs:label "AHolds" .
    # calculated: lookup

effortless-ntwf:bHolds a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DisjointChecks ;
    rdfs:range xsd:boolean ;
    rdfs:label "BHolds" .
    # calculated: lookup

effortless-ntwf:violationUnit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:DisjointChecks ;
    rdfs:range xsd:integer ;
    rdfs:label "ViolationUnit" .
    # calculated: calculated

# === Class: Firings ===
effortless-ntwf:Firings a owl:Class ;
    rdfs:label "Firings" ;
    rdfs:comment "One way one rule could produce one fact from one or two others." .

effortless-ntwf:firingId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "FiringId" .

effortless-ntwf:rule a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Rules ;
    rdfs:label "Rule" .

effortless-ntwf:kind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Kind" .

effortless-ntwf:target a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range effortless-ntwf:Statements ;
    rdfs:label "Target" .

effortless-ntwf:first a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range effortless-ntwf:Statements ;
    rdfs:label "First" .

effortless-ntwf:second a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range effortless-ntwf:Statements ;
    rdfs:label "Second" ;
    rdfs:comment "Same as First when the rule needs one premise." .

effortless-ntwf:ruleEnabled a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "RuleEnabled" .
    # calculated: lookup

effortless-ntwf:ruleLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "RuleLabel" .
    # calculated: lookup

effortless-ntwf:targetName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "TargetName" .
    # calculated: lookup

effortless-ntwf:firstName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "FirstName" .
    # calculated: lookup

effortless-ntwf:secondName a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:string ;
    rdfs:label "SecondName" .
    # calculated: lookup

effortless-ntwf:firstIsStated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:boolean ;
    rdfs:label "FirstIsStated" .
    # calculated: lookup

effortless-ntwf:firstHoldsBeforeChain a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:boolean ;
    rdfs:label "FirstHoldsBeforeChain" .
    # calculated: lookup

effortless-ntwf:secondHoldsBeforeChain a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:boolean ;
    rdfs:label "SecondHoldsBeforeChain" .
    # calculated: lookup

effortless-ntwf:firstHoldsBeforeTyping a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:boolean ;
    rdfs:label "FirstHoldsBeforeTyping" .
    # calculated: lookup

effortless-ntwf:inverseFiredUnit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "InverseFiredUnit" .
    # calculated: calculated

effortless-ntwf:symmetricFiredUnit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "SymmetricFiredUnit" .
    # calculated: calculated

effortless-ntwf:chainFiredUnit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "ChainFiredUnit" .
    # calculated: calculated

effortless-ntwf:typeFiredUnit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "TypeFiredUnit" .
    # calculated: calculated

effortless-ntwf:firedUnit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Firings ;
    rdfs:range xsd:integer ;
    rdfs:label "FiredUnit" .
    # calculated: calculated

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "The explainer's conclusion card." .
    # calculated: calculated

# === Class: Graphs ===
effortless-ntwf:Graphs a owl:Class ;
    rdfs:label "Graphs" ;
    rdfs:comment "The whole example." .

effortless-ntwf:graphId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Graphs ;
    rdfs:range xsd:string ;
    rdfs:label "GraphId" .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" .
    # calculated: calculated

effortless-ntwf:countOfStatedFacts a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Graphs ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfStatedFacts" .
    # calculated: aggregation

effortless-ntwf:countOfConclusions a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Graphs ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfConclusions" ;
    rdfs:comment "Facts that hold but were never stated." .
    # calculated: aggregation

effortless-ntwf:countOfViolations a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Graphs ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfViolations" .
    # calculated: aggregation

effortless-ntwf:isConsistent a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Graphs ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConsistent" .
    # calculated: calculated

# === Class: Properties ===
effortless-ntwf:Properties a owl:Class ;
    rdfs:label "Properties" ;
    rdfs:comment "A kind of link, with the characteristics the rules use." .

effortless-ntwf:propertyId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Properties ;
    rdfs:range xsd:string ;
    rdfs:label "PropertyId" .

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" .

effortless-ntwf:inverseOf a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Properties ;
    rdfs:range effortless-ntwf:Properties ;
    rdfs:label "InverseOf" .

effortless-ntwf:isSymmetric a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Properties ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsSymmetric" .

effortless-ntwf:chainFirst a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Properties ;
    rdfs:range effortless-ntwf:Properties ;
    rdfs:label "ChainFirst" .

effortless-ntwf:chainSecond a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Properties ;
    rdfs:range effortless-ntwf:Properties ;
    rdfs:label "ChainSecond" .

effortless-ntwf:domainClass a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Properties ;
    rdfs:range effortless-ntwf:Things ;
    rdfs:label "DomainClass" .

effortless-ntwf:rangeClass a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Properties ;
    rdfs:range effortless-ntwf:Things ;
    rdfs:label "RangeClass" .

effortless-ntwf:disjointWith a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Properties ;
    rdfs:range effortless-ntwf:Properties ;
    rdfs:label "DisjointWith" .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" .
    # calculated: calculated

# === Class: Rules ===
effortless-ntwf:Rules a owl:Class ;
    rdfs:label "Rules" ;
    rdfs:comment "The five rules; IsEnabled is the checkbox." .

effortless-ntwf:ruleId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Rules ;
    rdfs:range xsd:string ;
    rdfs:label "RuleId" .

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" .

effortless-ntwf:explanation a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Rules ;
    rdfs:range xsd:string ;
    rdfs:label "Explanation" .

effortless-ntwf:isEnabled a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Rules ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsEnabled" .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" .
    # calculated: calculated

effortless-ntwf:countOfFirings a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Rules ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfFirings" ;
    rdfs:comment "How many times the rule produced a fact." .
    # calculated: aggregation

# === Class: Statements ===
effortless-ntwf:Statements a owl:Class ;
    rdfs:label "Statements" ;
    rdfs:comment "A fact that is stated, or could be concluded: Subject, Property, Object." .

effortless-ntwf:statementId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:string ;
    rdfs:label "StatementId" .

effortless-ntwf:graph a owl:ObjectProperty ;
    rdfs:range effortless-ntwf:Graphs ;
    rdfs:label "Graph" .

effortless-ntwf:subject a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range effortless-ntwf:Things ;
    rdfs:label "Subject" .

effortless-ntwf:property a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range effortless-ntwf:Properties ;
    rdfs:label "Property" .

effortless-ntwf:objectThing a owl:ObjectProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range effortless-ntwf:Things ;
    rdfs:label "ObjectThing" .

effortless-ntwf:numberValue a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "NumberValue" .

effortless-ntwf:isStated a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsStated" ;
    rdfs:comment "Drawn as a solid line in the explainer." .

effortless-ntwf:subjectLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:string ;
    rdfs:label "SubjectLabel" .
    # calculated: lookup

effortless-ntwf:propertyLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:string ;
    rdfs:label "PropertyLabel" .
    # calculated: lookup

effortless-ntwf:objectLabel a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:string ;
    rdfs:label "ObjectLabel" .
    # calculated: lookup

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" .
    # calculated: calculated

effortless-ntwf:countOfInverseFirings a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfInverseFirings" .
    # calculated: aggregation

effortless-ntwf:countOfSymmetricFirings a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfSymmetricFirings" .
    # calculated: aggregation

effortless-ntwf:holdsBeforeChain a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "HoldsBeforeChain" .
    # calculated: calculated

effortless-ntwf:countOfChainFirings a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfChainFirings" .
    # calculated: aggregation

effortless-ntwf:holdsBeforeTyping a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "HoldsBeforeTyping" .
    # calculated: calculated

effortless-ntwf:countOfTypeFirings a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfTypeFirings" .
    # calculated: aggregation

effortless-ntwf:holds a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "Holds" ;
    rdfs:comment "True when stated or concluded by an enabled rule." .
    # calculated: calculated

effortless-ntwf:isConclusion a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsConclusion" ;
    rdfs:comment "Drawn as a dashed line in the explainer." .
    # calculated: calculated

effortless-ntwf:workedOutBy a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:string ;
    rdfs:label "WorkedOutBy" .
    # calculated: calculated

effortless-ntwf:statedUnit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "StatedUnit" .
    # calculated: calculated

effortless-ntwf:conclusionUnit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "ConclusionUnit" .
    # calculated: calculated

effortless-ntwf:parentUnit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "ParentUnit" .
    # calculated: calculated

effortless-ntwf:grandparentUnit a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Statements ;
    rdfs:range xsd:integer ;
    rdfs:label "GrandparentUnit" .
    # calculated: calculated

# === Class: Things ===
effortless-ntwf:Things a owl:Class ;
    rdfs:label "Things" ;
    rdfs:comment "A node in the picture: a person, a place, a class or a role value." .

effortless-ntwf:thingId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Things ;
    rdfs:range xsd:string ;
    rdfs:label "ThingId" .

effortless-ntwf:label a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Label" .

effortless-ntwf:kind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Kind" .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Name" .
    # calculated: calculated

effortless-ntwf:countOfChildren a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Things ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfChildren" ;
    rdfs:comment "Added: a count, which a reasoner alone does not give." .
    # calculated: aggregation

effortless-ntwf:countOfGrandchildren a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:Things ;
    rdfs:range xsd:integer ;
    rdfs:label "CountOfGrandchildren" ;
    rdfs:comment "Added: counts concluded grandchildren." .
    # calculated: aggregation

# === Inverse object-property pairs (reverse direction inferred) ===
effortless-ntwf:chainFirst owl:inverseOf effortless-ntwf:disjointWith .
effortless-ntwf:chainSecond owl:inverseOf effortless-ntwf:disjointWith .
effortless-ntwf:disjointWith owl:inverseOf effortless-ntwf:inverseOf .
