    effortless-ntwf:ruleId "domain-range" ;
    effortless-ntwf:label "Domain and range" ;
    effortless-ntwf:explanation "An attends, has grade level or has role statement implies that its subject is a Person. The place attended is a School. This rule adds no role or grade value." ;
    effortless-ntwf:isEnabled true .

