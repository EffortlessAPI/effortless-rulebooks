      "customer_last_name",
      "customer_full_name",
      "customer_email",
      "amount_paid",
      "balance",
      "is_paid",
      "unpaid_flag",
      "is_recent",
      "recent_total",
      "fcs_subtotal",
      "fcs_unit_count"
    ],
    "record_count": 10
  },
  "payments": {
    "primary_key": "name",
    "computed_columns": [
      "name",
      "order_number",
      "order_date",
      "order_total",
      "order_amount_paid",
      "order_balance",
      "order_is_paid",
      "order_customer",
