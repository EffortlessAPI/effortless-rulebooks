@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix acme-llc: <https://example.org/acme-llc#> .
@prefix erb: <https://effortlessapi.com/ns/erb#> .

# === Individuals: Customers ===

acme-llc:bob-gmail-com a acme-llc:Customers ;
    erb:key "bob-gmail-com" ;
    acme-llc:customerId "bob-gmail-com" ;
    acme-llc:emailAddress "bob@gmail.com" ;
    acme-llc:firstName "Bobby" ;
    acme-llc:lastName "Smith" .

acme-llc:jimmy-gmail-com a acme-llc:Customers ;
    erb:key "jimmy-gmail-com" ;
    acme-llc:customerId "jimmy-gmail-com" ;
    acme-llc:emailAddress "jimmy@gmail.com" ;
    acme-llc:firstName "Jimmy" ;
    acme-llc:lastName "Doe" .

acme-llc:mary-gmail-com a acme-llc:Customers ;
    erb:key "mary-gmail-com" ;
    acme-llc:customerId "mary-gmail-com" ;
    acme-llc:emailAddress "mary@gmail.com" ;
    acme-llc:firstName "Mary" ;
    acme-llc:lastName "Jones" .
