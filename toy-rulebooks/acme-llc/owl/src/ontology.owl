@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix acme-llc: <https://example.org/acme-llc#> .

@prefix erb: <https://effortlessapi.com/ns/erb#> .

<https://example.org/acme-llc> a owl:Ontology ;
    rdfs:label "ACME, LLC" ;
    rdfs:comment "Generated by Effortless (oss-rulebook-to-owl) from acme-llc-rulebook.json. The rulebook is the source: change it there, not here." .

erb:key a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "key" .

# === Class: Customers ===
acme-llc:Customers a owl:Class ;
    rdfs:label "Customers" ;
    rdfs:comment "Table: Customers" .

acme-llc:customerId a owl:DatatypeProperty ;
    rdfs:domain acme-llc:Customers ;
    rdfs:range xsd:string ;
    rdfs:label "CustomerId" .

acme-llc:name a owl:DatatypeProperty ;
    rdfs:domain acme-llc:Customers ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Identifier for the customer." .
    # calculated: calculated

acme-llc:emailAddress a owl:DatatypeProperty ;
    rdfs:domain acme-llc:Customers ;
    rdfs:range xsd:string ;
    rdfs:label "EmailAddress" ;
    rdfs:comment "The customer's email address" .

acme-llc:firstName a owl:DatatypeProperty ;
    rdfs:domain acme-llc:Customers ;
    rdfs:range xsd:string ;
    rdfs:label "FirstName" ;
    rdfs:comment "First Name of the customer - used to make the full name" .

acme-llc:lastName a owl:DatatypeProperty ;
    rdfs:domain acme-llc:Customers ;
    rdfs:range xsd:string ;
    rdfs:label "LastName" ;
    rdfs:comment "Last Name of the customer - used to make the full name" .

acme-llc:fullName a owl:DatatypeProperty ;
    rdfs:domain acme-llc:Customers ;
    rdfs:range xsd:string ;
    rdfs:label "FullName" ;
    rdfs:comment "Full name is computed from the first and last name of the customer" .
    # calculated: calculated
