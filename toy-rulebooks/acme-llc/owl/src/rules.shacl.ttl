@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix acme-llc: <https://example.org/acme-llc#> .

# === Shape with rules for Customers ===
acme-llc:CustomersShape a sh:NodeShape ;
    sh:targetClass acme-llc:Customers ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Customers_Name" ;
        sh:order 0 ;
        sh:prefixes acme-llc: ;
        sh:construct """
            PREFIX acme-llc: <https://example.org/acme-llc#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this acme-llc:name ?_result .
            }
            WHERE {
    $this a acme-llc:Customers .
    OPTIONAL { $this acme-llc:emailAddress ?email_address . }
                BIND(REPLACE(?email_address, "@", "-") AS ?_result)
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_Customers_FullName" ;
        sh:order 0 ;
        sh:prefixes acme-llc: ;
        sh:construct """
            PREFIX acme-llc: <https://example.org/acme-llc#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this acme-llc:fullName ?_result .
            }
            WHERE {
    $this a acme-llc:Customers .
    OPTIONAL { $this acme-llc:firstName ?first_name . }
    OPTIONAL { $this acme-llc:lastName ?last_name . }
                BIND(CONCAT(COALESCE(IF(isIRI(?first_name), REPLACE(STR(?first_name), "^.*[#/]", ""), IF(DATATYPE(?first_name) = xsd:dateTime, CONCAT(SUBSTR(STR(?first_name), 1, 10), " ", SUBSTR(STR(?first_name), 12, 8), IF(TZ(?first_name) = "Z", "+00", IF(STRENDS(TZ(?first_name), ":00"), SUBSTR(TZ(?first_name), 1, 3), TZ(?first_name)))), STR(?first_name))), ""), " ", COALESCE(IF(isIRI(?last_name), REPLACE(STR(?last_name), "^.*[#/]", ""), IF(DATATYPE(?last_name) = xsd:dateTime, CONCAT(SUBSTR(STR(?last_name), 1, 10), " ", SUBSTR(STR(?last_name), 12, 8), IF(TZ(?last_name) = "Z", "+00", IF(STRENDS(TZ(?last_name), ":00"), SUBSTR(TZ(?last_name), 1, 3), TZ(?last_name)))), STR(?last_name))), "")) AS ?_result)
            }
        """ ;
    ] .

# Generated 2 SHACL rules