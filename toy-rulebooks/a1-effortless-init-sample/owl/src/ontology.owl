@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix effortless-ntwf: <https://w3id.org/effortless-ntwf#> .

<https://w3id.org/effortless-ntwf#> a owl:Ontology ;
    rdfs:label "NTWF Ontology (Effortless rendering)" ;
    rdfs:comment "Generated by Effortless from a1-effortless-init-sample-rulebook.json. Vocabulary: Jessica Talisman NTWF." .

# === Class: HelloWhos ===
effortless-ntwf:HelloWhos a owl:Class ;
    rdfs:label "HelloWhos" ;
    rdfs:comment "The smallest complete rulebook: an id, a display name, and a rule that derives a greeting from it." .

effortless-ntwf:helloWhoId a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:HelloWhos ;
    rdfs:range xsd:string ;
    rdfs:label "HelloWhoId" .

effortless-ntwf:name a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:HelloWhos ;
    rdfs:range xsd:string ;
    rdfs:label "Name" .

effortless-ntwf:introduction a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:HelloWhos ;
    rdfs:range xsd:string ;
    rdfs:label "Introduction" .
    # calculated: calculated

effortless-ntwf:isBob a owl:DatatypeProperty ;
    rdfs:domain effortless-ntwf:HelloWhos ;
    rdfs:range xsd:boolean ;
    rdfs:label "IsBob" .
    # calculated: calculated
