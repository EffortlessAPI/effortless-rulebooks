<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the active project's rulebook-to-entity-framework output (DataClasses/ +
    SqlOnAir/DotNet/Lib/DataExtensions.cs) together with Program.cs, and runs the real
    generated SoAEFContext against a throwaway SQLite database. Mirrors the tool's own
    conformance harness (Versioned-Stable-SSoTme-Tools/tools/effortless/
    rulebook-to-entity-framework/conformance/EfConformanceHarness.csproj).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EffortlessEntityFrameworkRunner</RootNamespace>
    <AssemblyName>EffortlessEntityFrameworkRunner</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0169;CS0649;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8622;CS8625;CS8632</NoWarn>
    <!-- take-test.sh always passes -p:EF_TOOL_DIR=<project>/effortless-entity-framework. -->
    <GeneratedSrc>$(EF_TOOL_DIR)</GeneratedSrc>
  </PropertyGroup>

  <Target Name="RequireGeneratedSrc" BeforeTargets="CollectPackageReferences;BeforeBuild">
    <Error Condition="'$(EF_TOOL_DIR)' == ''" Text="EF_TOOL_DIR is not set; pass -p:EF_TOOL_DIR=&lt;project&gt;/effortless-entity-framework" />
    <Error Condition="!Exists('$(GeneratedSrc)/DataClasses/SoAEFContext.cs')" Text="No generated SoAEFContext.cs under $(GeneratedSrc)/DataClasses" />
    <Error Condition="!Exists('$(GeneratedSrc)/SqlOnAir/DotNet/Lib/DataExtensions.cs')" Text="No generated DataExtensions.cs under $(GeneratedSrc)/SqlOnAir/DotNet/Lib" />
    <!-- The tool writes DataClasses/SoAEntityBase.cs with overwrite-Never, so a project first
         built by an older tool version keeps a base class whose context member is `Context`
         while every current getter reads `SoAContext` (hundreds of CS0117 errors). -->
    <Error Condition="Exists('$(GeneratedSrc)/DataClasses/SoAEntityBase.cs') And !$([System.IO.File]::ReadAllText('$(GeneratedSrc)/DataClasses/SoAEntityBase.cs').Contains('SoAContext'))"
           Text="$(GeneratedSrc)/DataClasses/SoAEntityBase.cs is stale: it predates the current rulebook-to-entity-framework (no SoAContext member) and the tool never overwrites it. Delete that file and re-run effortless build in the project." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.6" />
    <!-- The generated SoAEFContext.OnConfiguring calls UseSqlServer inside an
         `if (!IsConfigured)` branch the runner never takes (it passes SQLite options),
         but the call must still compile. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.6" />
  </ItemGroup>

  <!-- Formulas call DataExtensions helpers by bare name (SUBSTITUTE, LEFT, ...). -->
  <ItemGroup>
    <Using Include="SqlOnAir.DotNet.Lib.DataExtensions" Static="true" />
  </ItemGroup>

  <!-- The generated model, globbed so adding/removing rulebook tables needs no wiring here.
       Sync*/Database* helpers are skipped: they target SQL Server/Airtable and compute nothing. -->
  <ItemGroup>
    <Compile Include="$(GeneratedSrc)/DataClasses/**/*.cs" />
    <Compile Include="$(GeneratedSrc)/SqlOnAir/DotNet/Lib/DataExtensions.cs" />
  </ItemGroup>

</Project>
