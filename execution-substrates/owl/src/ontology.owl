@prefix erb: <https://effortlessapi.com/ns/erb#> .

<https://example.org/effortless-math> a owl:Ontology ;
    rdfs:label "effortless-math" ;
    rdfs:comment "Generated by Effortless (oss-rulebook-to-owl) from effortless-math-rulebook.json. The rulebook is the source: change it there, not here." .

erb:key a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "key" .

