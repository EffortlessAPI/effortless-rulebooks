@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix effortless-math: <https://example.org/effortless-math#> .

# === Shape with rules for ArtifactRegistry ===
effortless-math:ArtifactRegistryShape a sh:NodeShape ;
    sh:targetClass effortless-math:ArtifactRegistry ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "rule_ArtifactRegistry_Name" ;
        sh:order 0 ;
        sh:prefixes effortless-math: ;
        sh:construct """
            PREFIX effortless-math: <https://example.org/effortless-math#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            CONSTRUCT {
                $this effortless-math:name ?_result .
            }
            WHERE {
    $this a effortless-math:ArtifactRegistry .
    OPTIONAL { $this effortless-math:artifactId ?artifact_id . }
                BIND(?artifact_id AS ?_result)
            }
        """ ;
    ] .

