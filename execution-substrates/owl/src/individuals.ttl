effortless-ntwf:SendIntents.IsUnrecordedRefusal a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "SendIntents.IsUnrecordedRefusal" ;
    effortless-ntwf:targetTable "SendIntents" ;
    effortless-ntwf:fieldName "IsUnrecordedRefusal" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{IsSilentlyDropped}}, AND(NOT({{HasDurableRefusalRecord}}), NOT({{RefusalCitedAnException}})))" ;
