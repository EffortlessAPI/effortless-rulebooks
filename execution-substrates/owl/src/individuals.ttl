    effortless-ntwf:formula "=IF({{SeparationViolationCount}} > 0, \"Violated: same agent prepared and approved.\", IF({{SeparationIsVacuouslyGreen}}, \"Not tested: this run had no preparation/approval pair.\", \"Held under test.\"))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-ctl-separation-held-or-untested ;
