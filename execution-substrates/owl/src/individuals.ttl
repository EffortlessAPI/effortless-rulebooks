effortless-ntwf:deny-controller-fragment-diagnostics a effortless-ntwf:AccessDenialTests ;
    effortless-ntwf:accessDenialTestId "deny-controller-fragment-diagnostics" ;
    effortless-ntwf:targetPolicy effortless-ntwf:pol-controller-knowledge_fragments-select ;
    effortless-ntwf:principal effortless-ntwf:principal-controller ;
    effortless-ntwf:targetTable effortless-ntwf:KnowledgeFragments ;
    effortless-ntwf:forbiddenRowId "kf-close-fx-time" ;
    effortless-ntwf:expectedVisible false ;
    effortless-ntwf:observedVisible false ;
    effortless-ntwf:lastRunAt "2026-09-13T05:09:43+00:00"^^xsd:dateTime ;
    effortless-ntwf:rationale "Column-granularity withholding. The controller reads knowledge_fragments but is not granted the stewardship diagnostic columns. evidence_has_expired EXISTS on public.vw_knowledge_fragments and must be ABSENT from the controller's view -- selecting it must raise 'column does not exist', not return null." ;
    effortless-ntwf:forbiddenColumn "evidence_has_expired" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AccessDenialTest" .

