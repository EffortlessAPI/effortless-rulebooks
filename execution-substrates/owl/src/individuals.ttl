# === Individuals: AppRoutes ===

effortless-ntwf:cfo-home a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "cfo-home" ;
    effortless-ntwf:routePath "/cfo/attestation" ;
    effortless-ntwf:routeName "Can I Sign?" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:cfo ;
    effortless-ntwf:navGroup effortless-ntwf:attest ;
    effortless-ntwf:navOrder "1" ;
    effortless-ntwf:routeKind "dashboard" ;
    effortless-ntwf:purpose "The one screen I open first. A single verdict for the close I am being asked to attest to, and if the answer is no, the named blocker." ;
    effortless-ntwf:layoutHints "Hero verdict card (green/red) with the IsAttestationReady column and, beneath it, a blocker list. Right rail: assurance grade summary. Nothing below the fold that is not a blocker." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:cfo-blockers a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "cfo-blockers" ;
    effortless-ntwf:routePath "/cfo/attestation/blockers" ;
    effortless-ntwf:routeName "Blockers" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:cfo ;
    effortless-ntwf:navGroup effortless-ntwf:attest ;
    effortless-ntwf:navOrder "2" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "Every reason I cannot sign yet, each one traced to the row that produced it." ;
    effortless-ntwf:layoutHints "Ordered list, most severe first. Each row: the blocking condition, the entity it fires on, and a link into that entity's detail route. Empty state must say 'no blockers' explicitly, never render blank." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:cfo-assurance-grade a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "cfo-assurance-grade" ;
    effortless-ntwf:routePath "/cfo/assurance/grade" ;
    effortless-ntwf:routeName "Assurance Grade" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:cfo ;
    effortless-ntwf:navGroup effortless-ntwf:assurance ;
    effortless-ntwf:navOrder "1" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "When the verdict reads TRUE, what proportion of the controls behind that TRUE were actually demonstrated to work — versus asserted by an interested party, versus never exercised at all." ;
    effortless-ntwf:layoutHints "Three-band stacked bar: demonstrated / asserted / never-exercised. Below it, the per-control table that produced the bands. The headline number is the grade, not the verdict." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:cfo-unwitnessed-controls a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "cfo-unwitnessed-controls" ;
    effortless-ntwf:routePath "/cfo/assurance/unwitnessed" ;
    effortless-ntwf:routeName "Controls Nobody Watches" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:cfo ;
    effortless-ntwf:navGroup effortless-ntwf:assurance ;
    effortless-ntwf:navOrder "2" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "The requirements I am personally attesting to that have no computed witness — and the named human who would answer for each if it failed." ;
    effortless-ntwf:layoutHints "Table: requirement, blocking?, has-witness?, accountable human, their role. Rows with no witness AND blocking are the emphasis. Each row links to the requirement detail." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:cfo-typed-conclusions a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "cfo-typed-conclusions" ;
    effortless-ntwf:routePath "/cfo/assurance/typed-conclusions" ;
    effortless-ntwf:routeName "Typed, Not Computed" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:cfo ;
    effortless-ntwf:navGroup effortless-ntwf:assurance ;
    effortless-ntwf:navOrder "3" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "Every control claim in this model that rests on a human typing a conclusion rather than on something computed." ;
    effortless-ntwf:layoutHints "Two-column split: computed claims vs typed claims, with counts. The typed side is the working list. Each entry shows who typed it and when." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:cfo-witness-chain a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "cfo-witness-chain" ;
    effortless-ntwf:routePath "/cfo/assurance/independence" ;
    effortless-ntwf:routeName "Who Witnessed the Witnesses" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:cfo ;
    effortless-ntwf:navGroup effortless-ntwf:assurance ;
    effortless-ntwf:navOrder "4" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "Across the whole close, is there any independent human observation at all — or is every layer the same handful of people confirming each other?" ;
    effortless-ntwf:layoutHints "Chain/graph view: approvals and verification outcomes as nodes, edges where one person confirms another. Self-witnessed loops highlighted. Sidebar counts independent vs self-witnessed." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:cfo-authority-map a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "cfo-authority-map" ;
    effortless-ntwf:routePath "/cfo/authority/accountability" ;
    effortless-ntwf:routeName "Who Held Authority" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:cfo ;
    effortless-ntwf:navGroup effortless-ntwf:authority ;
    effortless-ntwf:navOrder "1" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "For every approval in this close, the human who was personally accountable — and whether an exception routed authority away from the person who normally holds it." ;
    effortless-ntwf:layoutHints "Table per approval: approver, role held at the time, normal holder, exception invoked?. Rerouted rows flagged. Links to the exception invocation detail." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:cfo-my-approvals a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "cfo-my-approvals" ;
    effortless-ntwf:routePath "/cfo/authority/my-approvals" ;
    effortless-ntwf:routeName "My Own Approvals" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:cfo ;
    effortless-ntwf:navGroup effortless-ntwf:authority ;
    effortless-ntwf:navOrder "2" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "My approval on se-close06 — is there anything behind it other than the fact that I clicked approve?" ;
    effortless-ntwf:layoutHints "Detail card per approval I gave: what was verified, by whom, with what evidence. An approval with nothing behind it is rendered as a warning state, not an empty section." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:cfo-signature-dependencies a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "cfo-signature-dependencies" ;
    effortless-ntwf:routePath "/cfo/attestation/dependencies" ;
    effortless-ntwf:routeName "What My Signature Rests On" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:cfo ;
    effortless-ntwf:navGroup effortless-ntwf:attest ;
    effortless-ntwf:navOrder "3" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "The full set of controls, versions, and evidence records my signature actually depends on — the blast radius of my own name." ;
    effortless-ntwf:layoutHints "Dependency tree rooted at the attestation, expanding into controls, versions, evidence. Each node shows its current state. This is the reference view the change-watch route diffs against." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:cfo-changed-since-signing a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "cfo-changed-since-signing" ;
    effortless-ntwf:routePath "/cfo/attestation/changed-since" ;
    effortless-ntwf:routeName "Changed Since I Signed" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:cfo ;
    effortless-ntwf:navGroup effortless-ntwf:attest ;
    effortless-ntwf:navOrder "4" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "Since the moment I signed, has anything changed that would have altered my decision — specifically touching a control, a version, or an evidence record my signature depended on." ;
    effortless-ntwf:layoutHints "Timeline diff anchored at the signature timestamp. Only changes intersecting the dependency set are shown; unrelated churn is explicitly excluded and the exclusion is stated." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:cfo-restatement a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "cfo-restatement" ;
    effortless-ntwf:routePath "/cfo/assurance/restatement" ;
    effortless-ntwf:routeName "Would It Survive Restatement" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:cfo ;
    effortless-ntwf:navGroup effortless-ntwf:assurance ;
    effortless-ntwf:navOrder "5" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "If I re-run every attestation column against this same data six months from now, will it give the same answer? Name every column whose value depends on when it is read." ;
    effortless-ntwf:layoutHints "Table of attestation columns with a tense-dependent flag, sourced from the EvaluationContexts modelled instant. Time-dependent columns get an explicit warning band at the top." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:cfo-attestation-detail a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "cfo-attestation-detail" ;
    effortless-ntwf:routePath "/cfo/attestation/execution/:executionId" ;
