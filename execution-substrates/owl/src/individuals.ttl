effortless-ntwf:Requirements.AccountableAgent a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "Requirements.AccountableAgent" ;
    effortless-ntwf:targetTable "Requirements" ;
    effortless-ntwf:fieldName "AccountableAgent" ;
    effortless-ntwf:fieldType "lookup" ;
    effortless-ntwf:datatype "string" ;
    effortless-ntwf:formula "=INDEX(Roles!{{CurrentAgent}}, MATCH({{AccountableRole}}, Roles!{{RoleId}}, 0))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-cfo-controls-nobody-is-watching ;
