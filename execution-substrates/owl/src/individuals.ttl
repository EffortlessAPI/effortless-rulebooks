    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND(NOT({{DecidingAgentKind}} = \"Human\"), OR({{MaterialityBand}} = \"Material\", {{MaterialityBand}} = \"Escalated\"))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-variance-ai-human-confirmation-present ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

