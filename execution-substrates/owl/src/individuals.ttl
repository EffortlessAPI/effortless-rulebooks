effortless-ntwf:ChangeRequests.DaysPending a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ChangeRequests.DaysPending" ;
    effortless-ntwf:targetTable "ChangeRequests" ;
    effortless-ntwf:fieldName "DaysPending" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "integer" ;
    effortless-ntwf:formula "=IF({{IsDecided}}, DATETIME_DIFF({{DecidedAt}}, {{RequestedAt}}, \"days\"), DATETIME_DIFF({{AsOfInstant}}, {{RequestedAt}}, \"days\"))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-steward-stalled-change-requests ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ChangeRequests.IsStillPending a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ChangeRequests.IsStillPending" ;
    effortless-ntwf:targetTable "ChangeRequests" ;
    effortless-ntwf:fieldName "IsStillPending" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{IsOpen}}, NOT({{IsDecided}}))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-steward-stalled-change-requests ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

