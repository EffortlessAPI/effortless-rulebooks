effortless-ntwf:RoleAssignments.OverrideRatePercent a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "RoleAssignments.OverrideRatePercent" ;
    effortless-ntwf:targetTable "RoleAssignments" ;
    effortless-ntwf:fieldName "OverrideRatePercent" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "number" ;
    effortless-ntwf:formula "=IF({{DecisionCount}} = 0, 0, ({{OverriddenDecisionCount}} * 100) / {{DecisionCount}})" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-variance-ai-quality-vs-human-baseline ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:RoleAssignments.PredecessorOverrideRatePercent a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "RoleAssignments.PredecessorOverrideRatePercent" ;
    effortless-ntwf:targetTable "RoleAssignments" ;
    effortless-ntwf:fieldName "PredecessorOverrideRatePercent" ;
    effortless-ntwf:fieldType "lookup" ;
    effortless-ntwf:datatype "number" ;
    effortless-ntwf:formula "=INDEX(RoleAssignments!{{OverrideRatePercent}}, MATCH({{SupersedesAssignment}}, RoleAssignments!{{RoleAssignmentId}}, 0))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-variance-ai-quality-vs-human-baseline ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:RoleAssignments.QualityRegressedVsPredecessor a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "RoleAssignments.QualityRegressedVsPredecessor" ;
    effortless-ntwf:targetTable "RoleAssignments" ;
    effortless-ntwf:fieldName "QualityRegressedVsPredecessor" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{SupersedesAssignment}} <> \"\", {{OverrideRatePercent}} > {{PredecessorOverrideRatePercent}})" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-variance-ai-quality-vs-human-baseline ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:RoleAssignments.DepartedRoleKey a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "RoleAssignments.DepartedRoleKey" ;
