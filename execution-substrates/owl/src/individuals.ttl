effortless-ntwf:q-policy-ai-source-approval a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:roleQuestionId "q-policy-ai-source-approval" ;
    effortless-ntwf:askingRole effortless-ntwf:policy-drafting-agent ;
