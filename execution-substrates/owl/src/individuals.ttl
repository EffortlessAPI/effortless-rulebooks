    effortless-ntwf:fieldName "PredecessorHasSufficientSample" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "={{PredecessorDecisionCount}} >= {{MinimumDecisionsForComparison}}" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-variance-comparison-is-statistically-empty ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:RoleAssignments.ComparisonIsEvidentiallySound a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "RoleAssignments.ComparisonIsEvidentiallySound" ;
    effortless-ntwf:targetTable "RoleAssignments" ;
    effortless-ntwf:fieldName "ComparisonIsEvidentiallySound" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{HasSufficientSample}}, {{PredecessorHasSufficientSample}})" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-variance-comparison-is-statistically-empty ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:RoleAssignments.SingleOverrideSwingPercent a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "RoleAssignments.SingleOverrideSwingPercent" ;
    effortless-ntwf:targetTable "RoleAssignments" ;
    effortless-ntwf:fieldName "SingleOverrideSwingPercent" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "number" ;
    effortless-ntwf:formula "=IF({{DecisionCount}} > 0, 100 / {{DecisionCount}}, 0)" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-variance-comparison-is-statistically-empty ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:RoleAssignments.QualityVerdictIsUnsupported a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "RoleAssignments.QualityVerdictIsUnsupported" ;
    effortless-ntwf:targetTable "RoleAssignments" ;
