effortless-ntwf:ChangeRequests.IsOpen a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ChangeRequests.IsOpen" ;
    effortless-ntwf:targetTable "ChangeRequests" ;
    effortless-ntwf:fieldName "IsOpen" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND(OR({{Status}} = \"Draft\", {{Status}} = \"UnderReview\", {{Status}} = \"Approved\"), {{ImplementedAt}} = \"\")" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ChangeRequests.OpenChangeVersionKey a effortless-ntwf:RulebookFields ;
