    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{WasActuallyTransmitted}}, AND({{PolicyRequiresConsent}}, NOT({{RecipientHasSmsConsent}})))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-counsel-sms-without-consent ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

