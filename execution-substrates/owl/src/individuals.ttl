    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{UserOrganization}} <> \"\", {{PrincipalOrganization}} <> \"\", {{UserOrganization}} <> {{PrincipalOrganization}})" ;
