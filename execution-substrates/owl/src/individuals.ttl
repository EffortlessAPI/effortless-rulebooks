effortless-ntwf:MessageDeliveries.QuietWindowWrapsMidnight a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "MessageDeliveries.QuietWindowWrapsMidnight" ;
    effortless-ntwf:targetTable "MessageDeliveries" ;
    effortless-ntwf:fieldName "QuietWindowWrapsMidnight" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "={{PolicyQuietHoursStartHour}} > {{PolicyQuietHoursEndHour}}" ;
