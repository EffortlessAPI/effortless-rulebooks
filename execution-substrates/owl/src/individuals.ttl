    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{IsBlocking}}, NOT({{HasNamedOwner}}))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-cfo-controls-nobody-is-watching ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:Requirements.IsUnwatchedAndUnowned a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "Requirements.IsUnwatchedAndUnowned" ;
    effortless-ntwf:targetTable "Requirements" ;
    effortless-ntwf:fieldName "IsUnwatchedAndUnowned" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{IsBlocking}}, NOT({{HasComputedWitness}}), NOT({{HasNamedOwner}}))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-cfo-controls-nobody-is-watching ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:Requirements.AttestationExposureNote a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "Requirements.AttestationExposureNote" ;
    effortless-ntwf:targetTable "Requirements" ;
    effortless-ntwf:fieldName "AttestationExposureNote" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "string" ;
    effortless-ntwf:formula "=IF(NOT({{IsBlocking}}), \"\", IF({{IsUnwatchedAndUnowned}}, \"Unwatched and unowned: exposure defaults to the signatory.\", IF({{IsOrphanedBlockingControl}}, \"Witnessed but unowned: no named accountability.\", IF(NOT({{HasComputedWitness}}), \"Owned but unwitnessed: rests on human judgement.\", \"\"))))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-cfo-controls-nobody-is-watching ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

