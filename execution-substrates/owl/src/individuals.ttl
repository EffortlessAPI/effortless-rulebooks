effortless-ntwf:AgentDecisionRecords.HasHumanConfirmation a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "AgentDecisionRecords.HasHumanConfirmation" ;
    effortless-ntwf:targetTable "AgentDecisionRecords" ;
