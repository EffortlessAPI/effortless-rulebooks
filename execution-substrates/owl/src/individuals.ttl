    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{HoursUntilWindowOpens}} > 0, DATETIME_DIFF({{AsOfInstant}}, {{EvaluatedAt}}, \"hours\") > {{HoursUntilWindowOpens}})" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-publisher-deferred-not-cancelled ;
