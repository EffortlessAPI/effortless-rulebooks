    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{ReviewerAgentKind}} = \"Human\", {{HumanDisposition}} <> \"\", {{HumanDisposition}} <> \"NotReviewed\")" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-variance-ai-human-confirmation-present ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:AgentDecisionRecords.NeedsHumanConfirmation a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "AgentDecisionRecords.NeedsHumanConfirmation" ;
    effortless-ntwf:targetTable "AgentDecisionRecords" ;
