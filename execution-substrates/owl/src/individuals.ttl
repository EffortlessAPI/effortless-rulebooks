effortless-ntwf:q-policy-ai-no-role-assignment a effortless-ntwf:RoleQuestions ;
    effortless-ntwf:roleQuestionId "q-policy-ai-no-role-assignment" ;
    effortless-ntwf:askingRole effortless-ntwf:policy-drafting-agent ;
