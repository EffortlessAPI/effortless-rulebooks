    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "={{EvaluationSampleSize}} >= {{MinimumSampleForAssurance}}" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-ctl-witness-never-fired ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:Requirements.MinimumSampleForAssurance a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "Requirements.MinimumSampleForAssurance" ;
    effortless-ntwf:targetTable "Requirements" ;
    effortless-ntwf:fieldName "MinimumSampleForAssurance" ;
    effortless-ntwf:fieldType "raw" ;
    effortless-ntwf:datatype "integer" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-ctl-witness-never-fired ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:Requirements.IsUntestedWitness a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "Requirements.IsUntestedWitness" ;
    effortless-ntwf:targetTable "Requirements" ;
    effortless-ntwf:fieldName "IsUntestedWitness" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{WitnessHasNeverFired}}, NOT({{HasMeaningfulSample}}))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-ctl-witness-never-fired ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:Requirements.IsEvidencedHoldingControl a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "Requirements.IsEvidencedHoldingControl" ;
    effortless-ntwf:targetTable "Requirements" ;
    effortless-ntwf:fieldName "IsEvidencedHoldingControl" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{WitnessHasNeverFired}}, {{HasMeaningfulSample}})" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-ctl-witness-never-fired ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:Requirements.ControlAssuranceState a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "Requirements.ControlAssuranceState" ;
    effortless-ntwf:targetTable "Requirements" ;
    effortless-ntwf:fieldName "ControlAssuranceState" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "string" ;
    effortless-ntwf:formula "=IF(NOT({{IsBoundToAnyStep}}), \"Decorative\", IF(NOT({{HasEverBeenEvaluated}}), \"Inoperative\", IF(NOT({{HasComputedWitness}}), \"Asserted\", IF({{WitnessFireCount}} > 0, \"Demonstrated\", IF({{HasMeaningfulSample}}, \"Holding\", \"Untested\")))))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-ctl-witness-never-fired ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:Requirements.UnexercisedBindingCount a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "Requirements.UnexercisedBindingCount" ;
    effortless-ntwf:targetTable "Requirements" ;
    effortless-ntwf:fieldName "UnexercisedBindingCount" ;
    effortless-ntwf:fieldType "aggregation" ;
    effortless-ntwf:datatype "number" ;
    effortless-ntwf:formula "=COUNTIFS(StepRequirements!{{UnexercisedBindingRequirementKey}}, {{RequirementId}})" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-ctl-witness-scope-vs-binding ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:Requirements.WitnessIsPartiallyScoped a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "Requirements.WitnessIsPartiallyScoped" ;
    effortless-ntwf:targetTable "Requirements" ;
    effortless-ntwf:fieldName "WitnessIsPartiallyScoped" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{HasComputedWitness}}, {{UnexercisedBindingCount}} > 0)" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-ctl-witness-scope-vs-binding ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

