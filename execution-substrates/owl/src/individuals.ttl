    effortless-ntwf:fieldType "lookup" ;
    effortless-ntwf:datatype "datetime" ;
    effortless-ntwf:formula "=INDEX(EvaluationContexts!{{AsOfInstant}}, MATCH({{EvaluationContext}}, EvaluationContexts!{{EvaluationContextId}}, 0))" ;
