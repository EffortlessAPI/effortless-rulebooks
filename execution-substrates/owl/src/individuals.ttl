    effortless-ntwf:fieldType "aggregation" ;
    effortless-ntwf:datatype "integer" ;
    effortless-ntwf:formula "=COUNTIFS(KnowledgeGaps!{{ProcedureVersion}}, ProcedureVersions!{{ProcedureVersionId}}, KnowledgeGaps!{{Status}}, \"Open\")" ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ProcedureVersions.IsReadyForExecution a effortless-ntwf:RulebookFields ;
