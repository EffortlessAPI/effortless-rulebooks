    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "={{IntentQuietStartHour}} > {{IntentQuietEndHour}}" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-publisher-may-i-transmit-now ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:SendIntents.IntentIsInsideQuietWindow a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "SendIntents.IntentIsInsideQuietWindow" ;
    effortless-ntwf:targetTable "SendIntents" ;
    effortless-ntwf:fieldName "IntentIsInsideQuietWindow" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=IF({{IntentQuietWindowWraps}}, OR({{ProposedSendAtLocalHour}} >= {{IntentQuietStartHour}}, {{ProposedSendAtLocalHour}} < {{IntentQuietEndHour}}), AND({{ProposedSendAtLocalHour}} >= {{IntentQuietStartHour}}, {{ProposedSendAtLocalHour}} < {{IntentQuietEndHour}}))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-publisher-may-i-transmit-now ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

