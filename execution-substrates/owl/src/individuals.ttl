effortless-ntwf:ProcedureExecutions.IsStructurallyComplete a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ProcedureExecutions.IsStructurallyComplete" ;
    effortless-ntwf:targetTable "ProcedureExecutions" ;
    effortless-ntwf:fieldName "IsStructurallyComplete" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "={{CompletedStepCount}} >= {{ExpectedStepCount}}" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-controller-execution-diverged-from-spec ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ProcedureExecutions.DivergedFromSpecification a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ProcedureExecutions.DivergedFromSpecification" ;
    effortless-ntwf:targetTable "ProcedureExecutions" ;
    effortless-ntwf:fieldName "DivergedFromSpecification" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=OR(NOT({{IsStructurallyComplete}}), {{ControlBreachCount}} > 0)" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-controller-execution-diverged-from-spec ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

