    effortless-ntwf:targetTable "MessageDeliveries" ;
    effortless-ntwf:fieldName "IsInsideQuietWindow" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=IF({{QuietWindowWrapsMidnight}}, OR({{SentAtLocalHour}} >= {{PolicyQuietHoursStartHour}}, {{SentAtLocalHour}} < {{PolicyQuietHoursEndHour}}), AND({{SentAtLocalHour}} >= {{PolicyQuietHoursStartHour}}, {{SentAtLocalHour}} < {{PolicyQuietHoursEndHour}}))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-counsel-quiet-hours-breach ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:MessageDeliveries.IsQuietHoursViolation a effortless-ntwf:RulebookFields ;
