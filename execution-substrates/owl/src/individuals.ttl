    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:cfo ;
    effortless-ntwf:navOrder "0" ;
    effortless-ntwf:routeKind "detail" ;
    effortless-ntwf:purpose "One execution, everything I would be signing for it." ;
    effortless-ntwf:layoutHints "Full-page record: execution header, per-step conformance, control results, evidence links. Reachable from the blocker list and the home verdict." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:controller-home a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "controller-home" ;
    effortless-ntwf:routePath "/controller/controls" ;
    effortless-ntwf:routeName "Control Board" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:controller ;
    effortless-ntwf:navGroup effortless-ntwf:controls ;
    effortless-ntwf:navOrder "1" ;
    effortless-ntwf:routeKind "dashboard" ;
    effortless-ntwf:purpose "Every close control at a glance: which fired, which held, and which are structurally incapable of failing." ;
    effortless-ntwf:layoutHints "Grid of control tiles, each showing bound steps, witness presence, and whether it has ever produced a negative. Inoperative controls are visually distinct, not just sorted lower." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:controller-mute-controls a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "controller-mute-controls" ;
    effortless-ntwf:routePath "/controller/controls/inoperative" ;
    effortless-ntwf:routeName "Inoperative Controls" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:controller ;
    effortless-ntwf:navGroup effortless-ntwf:controls ;
    effortless-ntwf:navOrder "2" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "Which of my blocking close controls are structurally incapable of failing — declared, bound to a step, and yet with no mechanism that could ever produce a negative result." ;
    effortless-ntwf:layoutHints "List with a three-state badge per control: has-witness / witness-ever-fired / could-ever-fire. The third state is the finding. Each row explains WHY it cannot fire." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:controller-witness-scope a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "controller-witness-scope" ;
    effortless-ntwf:routePath "/controller/controls/witness-scope" ;
    effortless-ntwf:routeName "Witness Scope vs Binding" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:controller ;
    effortless-ntwf:navGroup effortless-ntwf:controls ;
    effortless-ntwf:navOrder "3" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "For each control with a witness, is the witness evaluated at the same steps where the control is bound? req-close-evidence is bound to close-03 and close-08 — is its witness scoped to both?" ;
    effortless-ntwf:layoutHints "Two parallel columns per control: steps bound vs steps witnessed, with the set difference called out. A non-empty difference is the finding." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

effortless-ntwf:controller-separation a effortless-ntwf:AppRoutes ;
    effortless-ntwf:appRouteId "controller-separation" ;
    effortless-ntwf:routePath "/controller/controls/separation-of-duties" ;
    effortless-ntwf:routeName "Separation of Duties" ;
    effortless-ntwf:surface "domain" ;
    effortless-ntwf:owningRole effortless-ntwf:controller ;
    effortless-ntwf:navGroup effortless-ntwf:controls ;
    effortless-ntwf:navOrder "4" ;
    effortless-ntwf:routeKind "workspace" ;
    effortless-ntwf:purpose "Did the same agent both prepare and approve any part of this close — computed, not asserted. And could it even have happened, or is the control passing because the structure never gave it the chance to fail?" ;
    effortless-ntwf:layoutHints "Top: the computed verdict. Below: the opportunity analysis — executions where the same agent COULD have held both seats. A pass with zero opportunity is rendered as inconclusive, not green." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#AppRoute" .

