effortless-ntwf:ProcedureVersions.CountOfSteps a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ProcedureVersions.CountOfSteps" ;
    effortless-ntwf:targetTable "ProcedureVersions" ;
    effortless-ntwf:fieldName "CountOfSteps" ;
    effortless-ntwf:fieldType "aggregation" ;
    effortless-ntwf:datatype "integer" ;
    effortless-ntwf:formula "=COUNTIFS(Steps!{{ProcedureVersion}}, ProcedureVersions!{{ProcedureVersionId}})" ;
