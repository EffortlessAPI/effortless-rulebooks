# === Individuals: JwtClaimMappings ===

effortless-ntwf:claim-email a effortless-ntwf:JwtClaimMappings ;
    effortless-ntwf:jwtClaimMappingId "claim-email" ;
    effortless-ntwf:claimName "email" ;
    effortless-ntwf:sqlAccessor "app.jwt_email()" ;
    effortless-ntwf:isReservedClaim true ;
    effortless-ntwf:mapsToPrincipal true ;
    effortless-ntwf:description2 "Verified email address. Magic-links asserts only that the bearer controls this mailbox; everything else about the caller is resolved from it inside this database." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#JwtClaimMapping" .

effortless-ntwf:claim-tenant a effortless-ntwf:JwtClaimMappings ;
    effortless-ntwf:jwtClaimMappingId "claim-tenant" ;
    effortless-ntwf:claimName "tenant_id" ;
    effortless-ntwf:sqlAccessor "app.jwt_tenant_id()" ;
    effortless-ntwf:isReservedClaim true ;
    effortless-ntwf:mapsToPrincipal false ;
    effortless-ntwf:description2 "Magic-links tenant the token was minted for. Pinned so a token from another tenant cannot authenticate here." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#JwtClaimMapping" .

effortless-ntwf:claim-principal a effortless-ntwf:JwtClaimMappings ;
    effortless-ntwf:jwtClaimMappingId "claim-principal" ;
    effortless-ntwf:claimName "principal" ;
    effortless-ntwf:sqlAccessor "app.jwt_principal()" ;
    effortless-ntwf:isReservedClaim false ;
    effortless-ntwf:mapsToPrincipal true ;
    effortless-ntwf:description2 "AccessPrincipals row the caller acts as, resolved from the verified email via vw_agents. Not trusted from the token itself." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#JwtClaimMapping" .

effortless-ntwf:claim-org a effortless-ntwf:JwtClaimMappings ;
    effortless-ntwf:jwtClaimMappingId "claim-org" ;
    effortless-ntwf:claimName "organization" ;
    effortless-ntwf:sqlAccessor "app.jwt_organization()" ;
    effortless-ntwf:isReservedClaim false ;
    effortless-ntwf:mapsToPrincipal false ;
    effortless-ntwf:description2 "Organization the caller belongs to, derived from their principal's domain role. The default tenancy boundary for row predicates." ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#JwtClaimMapping" .

