    effortless-ntwf:fieldType "lookup" ;
    effortless-ntwf:datatype "number" ;
    effortless-ntwf:formula "=INDEX(RoleAssignments!{{DecisionCount}}, MATCH({{SupersedesAssignment}}, RoleAssignments!{{RoleAssignmentId}}, 0))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-variance-comparison-is-statistically-empty ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:RoleAssignments.HasSufficientSample a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "RoleAssignments.HasSufficientSample" ;
    effortless-ntwf:targetTable "RoleAssignments" ;
    effortless-ntwf:fieldName "HasSufficientSample" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "={{DecisionCount}} >= {{MinimumDecisionsForComparison}}" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-variance-comparison-is-statistically-empty ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:RoleAssignments.PredecessorHasSufficientSample a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "RoleAssignments.PredecessorHasSufficientSample" ;
