# === Individuals: Rationales ===

effortless-ntwf:rat-close-separation a effortless-ntwf:Rationales ;
    effortless-ntwf:rationaleId "rat-close-separation" ;
    effortless-ntwf:procedureVersion effortless-ntwf:close-v1.1.0 ;
    effortless-ntwf:step effortless-ntwf:close-05 ;
    effortless-ntwf:title "Why the preparer cannot approve" ;
    effortless-ntwf:statement "Independent review prevents self-certification and makes accountability legible." ;
    effortless-ntwf:status "Approved" ;
    effortless-ntwf:authorityRole effortless-ntwf:controller ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#Rationale" .

effortless-ntwf:rat-close-ai a effortless-ntwf:Rationales ;
    effortless-ntwf:rationaleId "rat-close-ai" ;
    effortless-ntwf:procedureVersion effortless-ntwf:close-v1.1.0 ;
    effortless-ntwf:step effortless-ntwf:close-04 ;
    effortless-ntwf:title "Why AI ranks but does not close variances" ;
    effortless-ntwf:statement "The model accelerates triage; materiality, anomaly context, and acceptance remain human judgments." ;
    effortless-ntwf:status "Approved" ;
    effortless-ntwf:authorityRole effortless-ntwf:controller ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#Rationale" .

effortless-ntwf:rat-policy-ai a effortless-ntwf:Rationales ;
    effortless-ntwf:rationaleId "rat-policy-ai" ;
    effortless-ntwf:procedureVersion effortless-ntwf:policy-v1.0.0 ;
    effortless-ntwf:step effortless-ntwf:policy-03 ;
    effortless-ntwf:title "Why AI may draft but not approve" ;
    effortless-ntwf:statement "Drafting is reversible assistance; legal and organizational commitments require human authority." ;
    effortless-ntwf:status "Approved" ;
    effortless-ntwf:authorityRole effortless-ntwf:hr-policy-owner ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#Rationale" .

effortless-ntwf:rat-policy-multichannel a effortless-ntwf:Rationales ;
    effortless-ntwf:rationaleId "rat-policy-multichannel" ;
    effortless-ntwf:procedureVersion effortless-ntwf:policy-v1.0.0 ;
    effortless-ntwf:step effortless-ntwf:policy-07 ;
    effortless-ntwf:title "Why both email and SMS exist" ;
    effortless-ntwf:statement "Email carries complete policy context; consented SMS provides timely notice and a link without becoming the legal record." ;
    effortless-ntwf:status "Approved" ;
    effortless-ntwf:authorityRole effortless-ntwf:communications-manager ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#Rationale" .

