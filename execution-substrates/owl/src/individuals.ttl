    effortless-ntwf:inventedForQuestion effortless-ntwf:q-cfo-approving-on-unfit-version ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ProcedureExecutions.SignedAgainstUnfitVersion a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ProcedureExecutions.SignedAgainstUnfitVersion" ;
    effortless-ntwf:targetTable "ProcedureExecutions" ;
    effortless-ntwf:fieldName "SignedAgainstUnfitVersion" ;
