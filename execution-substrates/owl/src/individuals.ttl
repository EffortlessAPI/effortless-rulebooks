    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND(NOT({{ComparisonIsEvidentiallySound}}), NOT({{QualityRegressedVsPredecessor}}))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-variance-comparison-is-statistically-empty ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:RoleAssignments.IsUnmeasuredAutomationHandover a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "RoleAssignments.IsUnmeasuredAutomationHandover" ;
    effortless-ntwf:targetTable "RoleAssignments" ;
    effortless-ntwf:fieldName "IsUnmeasuredAutomationHandover" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{IsHumanToNonHumanHandover}}, NOT({{ComparisonIsEvidentiallySound}}))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-variance-comparison-is-statistically-empty ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

