    effortless-ntwf:formula "=IF({{AuthorizationReviewedAt}} <> \"\", DATETIME_DIFF({{AsOfInstant}}, {{AuthorizationReviewedAt}}, \"days\"), DATETIME_DIFF({{AsOfInstant}}, {{ValidFrom}}, \"days\"))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-variance-handover-was-a-decision-somebody-made ;
