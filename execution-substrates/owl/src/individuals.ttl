    effortless-ntwf:fieldName "PrincipalIsAdmin" ;
    effortless-ntwf:fieldType "lookup" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=INDEX(AccessPrincipals!{{IsAdministrator}}, MATCH({{Principal}}, AccessPrincipals!{{AccessPrincipalId}}, 0))" ;
