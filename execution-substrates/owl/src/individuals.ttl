effortless-ntwf:RoleAssignments.PredecessorDecisionCount a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "RoleAssignments.PredecessorDecisionCount" ;
    effortless-ntwf:targetTable "RoleAssignments" ;
