    effortless-ntwf:fieldName "WasActuallyTransmitted" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=OR({{DeliveryStatus}} = \"Sent\", OR({{DeliveryStatus}} = \"Delivered\", {{DeliveryStatus}} = \"Bounced\"))" ;
