effortless-ntwf:ProcedureExecutions.ComputedAssuranceRatio a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ProcedureExecutions.ComputedAssuranceRatio" ;
    effortless-ntwf:targetTable "ProcedureExecutions" ;
    effortless-ntwf:fieldName "ComputedAssuranceRatio" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "number" ;
    effortless-ntwf:formula "=IF({{EvaluatedControlCount}} = 0, 0, {{ComputedlyWitnessedControlCount}} / {{EvaluatedControlCount}})" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-cfo-quality-of-a-green-attestation ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ProcedureExecutions.InterestedPartyAssertionCount a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ProcedureExecutions.InterestedPartyAssertionCount" ;
    effortless-ntwf:targetTable "ProcedureExecutions" ;
    effortless-ntwf:fieldName "InterestedPartyAssertionCount" ;
    effortless-ntwf:fieldType "aggregation" ;
    effortless-ntwf:datatype "number" ;
    effortless-ntwf:formula "=COUNTIFS(RequirementSatisfactions!{{InterestedAssertionExecutionKey}}, {{ProcedureExecutionId}})" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-cfo-quality-of-a-green-attestation ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ProcedureExecutions.AssuranceGrade a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ProcedureExecutions.AssuranceGrade" ;
    effortless-ntwf:targetTable "ProcedureExecutions" ;
    effortless-ntwf:fieldName "AssuranceGrade" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "string" ;
    effortless-ntwf:formula "=IF({{EvaluatedControlCount}} = 0, \"None: no blocking control was evaluated.\", IF({{InterestedPartyAssertionCount}} > 0, \"Weak: at least one control rests on an interested-party assertion.\", IF({{ComputedAssuranceRatio}} < 0.5, \"Thin: most controls rest on human assertion.\", IF({{ComputedAssuranceRatio}} < 1, \"Mixed: computed and asserted controls.\", \"Computed: every evaluated control has a witness.\"))))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-cfo-quality-of-a-green-attestation ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ProcedureExecutions.AttestationWouldBeWeaklyBased a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ProcedureExecutions.AttestationWouldBeWeaklyBased" ;
    effortless-ntwf:targetTable "ProcedureExecutions" ;
    effortless-ntwf:fieldName "AttestationWouldBeWeaklyBased" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{IsAttestationReady}}, OR({{InterestedPartyAssertionCount}} > 0, {{ComputedAssuranceRatio}} < 0.5))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q2-cfo-quality-of-a-green-attestation ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

