    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ProcedureExecutions.IsAttestationReady a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ProcedureExecutions.IsAttestationReady" ;
    effortless-ntwf:targetTable "ProcedureExecutions" ;
    effortless-ntwf:fieldName "IsAttestationReady" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "boolean" ;
    effortless-ntwf:formula "=AND({{IsStructurallyComplete}}, NOT({{DivergedFromSpecification}}), {{AllBlockingControlsEvaluated}}, {{SeparationOfDutiesHeld}})" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-cfo-can-i-sign ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

effortless-ntwf:ProcedureExecutions.AttestationBlockerSummary a effortless-ntwf:RulebookFields ;
    effortless-ntwf:rulebookFieldId "ProcedureExecutions.AttestationBlockerSummary" ;
    effortless-ntwf:targetTable "ProcedureExecutions" ;
    effortless-ntwf:fieldName "AttestationBlockerSummary" ;
    effortless-ntwf:fieldType "calculated" ;
    effortless-ntwf:datatype "string" ;
    effortless-ntwf:formula "=IF({{IsAttestationReady}}, \"\", IF(NOT({{IsStructurallyComplete}}), \"Incomplete: specified steps did not all complete.\", IF({{SeparationViolationCount}} > 0, \"Segregation of duties violated.\", IF({{UnevaluatedBlockingTotal}} > 0, \"Blocking controls were never evaluated.\", \"Control breach recorded on one or more steps.\"))))" ;
    effortless-ntwf:inventedForQuestion effortless-ntwf:q-cfo-can-i-sign ;
    effortless-ntwf:semanticTypeIri "urn:effortless:pko-extension#RulebookField" .

